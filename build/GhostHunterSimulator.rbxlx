			local p1 = (rot * at(0, 2.15, -1.6)).Position
			local p2 = (rot * at(0, 2.7, -2.0)).Position
			rod(p0, p1, 0.34, bark)
			rod(p1, p2, 0.24, bark)
			ball(0.55, CFrame.new(p2), leaf)
