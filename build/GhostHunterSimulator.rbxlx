  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">GHServer</string>
      </Properties>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR server entry. Builds the world, then initialises services in order.
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)

Net.Init()

-- Players pass through each other (busy crate stations), hunters are client-side and non-colliding.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

require(script.Parent.World.Builder).Build()

local Services = script.Parent.Services
local order = {
	"Fx",
	"Remotes",
	"DataService",
	"PlayerInfo",
	"HunterService",
	"DropService",
	"GhostService",
	"ProgressService",
	"EventService",
	"ShopService",
	"StationService",
}
local loaded: { any } = {}
for _, name in order do
	local mod = require(Services:FindFirstChild(name) :: ModuleScript) :: any
	table.insert(loaded, mod)
	if mod.Init then
		mod.Init()
	end
end
for _, mod in loaded do
	if mod.Start then
		mod.Start()
	end
end

-- Studio-only test commands (chat): /ecto <n>, /event, /reset-daily
if RunService:IsStudio() then
	local DataService = require(Services.DataService) :: any
	local EventService = require(Services.EventService) :: any
	local function hook(player: Player)
		player.Chatted:Connect(function(msg)
			local d = DataService.Get(player)
			if not d then
				return
			end
			local n = msg:match("^/ecto%s+(%d+)")
			if n then
				DataService.AddEcto(player, tonumber(n) :: number)
			elseif msg == "/event" then
				EventService.TriggerNow()
			elseif msg == "/reset-daily" then
				d.Daily.Last = 0
				DataService.Changed(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load/save with retries, a session lock (prevents duplication when a player
-- hops servers quickly), autosave, BindToClose and schema migration. Every other service reads
-- and writes data ONLY through DataService.Get(player) on the server.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)

local DataService = {}

export type HunterRecord = { Id: string, Locked: boolean?, T: number? }
export type Data = {
	Version: number,
	Ecto: number,
	TotalEcto: number,
	Hunters: { [string]: HunterRecord },
	NextUid: number,
	Equipped: { string },
	Discovered: { [string]: boolean },
	Zones: { [string]: boolean },
	Upgrades: { [string]: number },
	Daily: { Last: number, Streak: number },
	Boosts: { [string]: number }, -- boost id -> os.time expiry
	FreeCrates: { [string]: number },
	Settings: { Music: boolean, Sfx: boolean, FastReveal: boolean, AutoTarget: boolean },
	Tutorial: number,
	Stats: { Ghosts: number, Crates: number, Events: number, Seconds: number },
	Purchases: { string }, -- recent receipt ids (ring buffer)
}

local function defaults(): Data
	local d: Data = {
		Version = Config.DataSchemaVersion,
		Ecto = 0,
		TotalEcto = 0,
		Hunters = {},
		NextUid = 1,
		Equipped = {},
		Discovered = {},
		Zones = { [Config.Zones[1].Id] = true },
		Upgrades = {},
		Daily = { Last = 0, Streak = 0 },
		Boosts = {},
		FreeCrates = {},
		Settings = { Music = true, Sfx = true, FastReveal = false, AutoTarget = true },
		Tutorial = 1,
		Stats = { Ghosts = 0, Crates = 0, Events = 0, Seconds = 0 },
		Purchases = {},
	}
	for id in Config.Upgrades do
		d.Upgrades[id] = 1
	end
	return d
end

-- Fills missing fields (new features) and upgrades old schemas. Never drops player progress.
local function migrate(raw: any): Data
	local d = defaults()
	if type(raw) ~= "table" then
		return d
	end
	for k, v in raw do
		if (d :: any)[k] ~= nil and type(v) == type((d :: any)[k]) then
			(d :: any)[k] = v
		end
	end
	-- nested defaults
	local base = defaults()
	for k, v in base.Settings do
		if type((d.Settings :: any)[k]) ~= type(v) then
			(d.Settings :: any)[k] = v
		end
	end
	for k, v in base.Stats do
		if type((d.Stats :: any)[k]) ~= "number" then
			(d.Stats :: any)[k] = v
		end
	end
	for k, v in base.Daily do
		if type((d.Daily :: any)[k]) ~= "number" then
			(d.Daily :: any)[k] = v
		end
	end
	for id in Config.Upgrades do
		local lv = d.Upgrades[id]
		d.Upgrades[id] = if type(lv) == "number" then math.clamp(math.floor(lv), 1, #Config.Upgrades[id].Levels) else 1
	end
	d.Zones[Config.Zones[1].Id] = true
	-- drop hunters whose definition was removed, and equipped uids that no longer exist
	for uid, h in d.Hunters do
		if type(h) ~= "table" or not Config.Hunters[h.Id] then
			d.Hunters[uid] = nil
		end
	end
	local eq = {}
	local seen = {}
	for _, uid in d.Equipped do
		if d.Hunters[uid] and not seen[uid] then
			seen[uid] = true
			table.insert(eq, uid)
		end
	end
	d.Equipped = eq
	-- (future) if d.Version < 2 then ... end
	d.Version = Config.DataSchemaVersion
	return d
end

type Profile = {
	Data: Data,
	Key: string,
	Loaded: boolean,
	Dirty: boolean,
	Saving: boolean,
	SyncQueued: boolean,
	JoinedAt: number,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local storeOk = false
local loadedSignal = Instance.new("BindableEvent")
DataService.Loaded = loadedSignal.Event -- (player, data)

local syncRemote: RemoteEvent
local ectoRemote: RemoteEvent
-- Extra values other services add to the client snapshot (crew power, slots, ...).
local decorators: { (Player, any) -> () } = {}

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local delayS = 1
	for attempt = 1, Config.Data.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[Data] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < Config.Data.Retries then
			task.wait(delayS)
			delayS = math.min(delayS * 2, 8)
		end
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

-- Loads with a session lock. Returns data, or nil if the player should be kicked.
local function loadProfile(player: Player): Data?
	if not storeOk or not store then
		return migrate(nil)
	end
	local ds = store :: DataStore
	local key = keyFor(player)
	local jobId = if game.JobId ~= "" then game.JobId else "studio"
	for attempt = 1, 6 do
		local locked = false
		local ok, result = retry("load " .. key, function()
			return ds:UpdateAsync(key, function(old: any)
				old = if type(old) == "table" then old else {}
				local lock = old._lock
				if type(lock) == "table" and lock.job ~= jobId and os.time() - (lock.t or 0) < Config.Data.SessionLockSeconds then
					locked = true
					return nil -- don't write
				end
				old._lock = { job = jobId, t = os.time() }
				return old
			end)
		end)
		if not ok then
			return nil
		end
		if not locked then
			return migrate(result)
		end
		-- Another server still holds the lock (player just hopped). Wait for it to save.
		task.wait(math.min(2 + attempt * 2, 8))
		if not player.Parent then
			return nil
		end
	end
	warn("[Data] session lock never released for " .. key .. "; taking over")
	local ok, result = retry("steal " .. key, function()
		return ds:UpdateAsync(key, function(old: any)
			old = if type(old) == "table" then old else {}
			old._lock = { job = jobId, t = os.time() }
			return old
		end)
	end)
	return if ok then migrate(result) else nil
end

local function saveProfile(player: Player, release: boolean): boolean
	local p = profiles[player]
	if not p or not p.Loaded or not storeOk or not store then
		return true
	end
	if p.Saving then
		-- wait for the in-flight save, then save again so the latest state is written
		local t0 = os.clock()
		while p.Saving and os.clock() - t0 < 20 do
			task.wait(0.2)
		end
	end
	p.Saving = true
	local ds = store :: DataStore
	local jobId = if game.JobId ~= "" then game.JobId else "studio"
	p.Data.Stats.Seconds += math.floor(os.clock() - p.JoinedAt)
	p.JoinedAt = os.clock()
	local snapshot = table.clone(p.Data) :: any
	local ok = retry("save " .. p.Key, function()
		return ds:UpdateAsync(p.Key, function(old: any)
			if type(old) == "table" and type(old._lock) == "table" and old._lock.job ~= jobId then
				-- another server took the session over: never overwrite its newer data
				return nil
			end
			snapshot._lock = if release then nil else { job = jobId, t = os.time() }
			return snapshot
		end)
	end)
	p.Saving = false
	if ok then
		p.Dirty = false
	end
	return ok
end

function DataService.Get(player: Player): Data?
	local p = profiles[player]
	return if p and p.Loaded then p.Data else nil
end

-- Waits (up to timeout) for the player's data.
function DataService.WaitFor(player: Player, timeout: number?): Data?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < (timeout or 30) do
		local d = DataService.Get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return nil
end

function DataService.AddDecorator(fn: (Player, any) -> ())
	table.insert(decorators, fn)
end

local function snapshot(player: Player, d: Data): any
	local s = {
		Ecto = d.Ecto,
		Hunters = d.Hunters,
		Equipped = d.Equipped,
		Discovered = d.Discovered,
		Zones = d.Zones,
		Upgrades = d.Upgrades,
		Daily = d.Daily,
		Boosts = d.Boosts,
		FreeCrates = d.FreeCrates,
		Settings = d.Settings,
		Tutorial = d.Tutorial,
		Stats = d.Stats,
		ServerTime = os.time(),
	}
	for _, fn in decorators do
		fn(player, s)
	end
	return s
end

-- Marks data changed and sends the client a fresh snapshot (batched per frame).
function DataService.Changed(player: Player)
	local p = profiles[player]
	if not p or not p.Loaded then
		return
	end
	p.Dirty = true
	if p.SyncQueued then
		return
	end
	p.SyncQueued = true
	task.defer(function()
		p.SyncQueued = false
		if player.Parent and profiles[player] == p then
			syncRemote:FireClient(player, snapshot(player, p.Data))
		end
	end)
end

-- Currency changes are frequent: send only the number.
function DataService.AddEcto(player: Player, amount: number)
	local p = profiles[player]
	if not p or not p.Loaded or amount ~= amount then
		return
	end
	amount = math.floor(amount)
	p.Data.Ecto = math.max(0, p.Data.Ecto + amount)
	if amount > 0 then
		p.Data.TotalEcto += amount
	end
	p.Dirty = true
	ectoRemote:FireClient(player, p.Data.Ecto)
	player:SetAttribute("Ecto", p.Data.Ecto)
end

-- Atomically spends Ectoplasm. Returns false if the player can't afford it.
function DataService.Spend(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or amount < 0 or d.Ecto < amount then
		return false
	end
	DataService.AddEcto(player, -amount)
	return true
end

function DataService.NewUid(d: Data): string
	local uid = tostring(d.NextUid)
	d.NextUid += 1
	return uid
end

function DataService.Save(player: Player)
	task.spawn(saveProfile, player, false)
end

function DataService.Init()
	syncRemote = Net.Event("Sync")
	ectoRemote = Net.Event("Ecto")
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		store = result
		-- In Studio without "Enable Studio Access to API Services" this read errors.
		local probe = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		storeOk = probe
	end
	if not storeOk then
		warn("[Data] DataStores unavailable (Studio without API access?). Progress will NOT be saved this session.")
	end
end

local function onPlayerAdded(player: Player)
	local p: Profile = {
		Data = defaults(),
		Key = keyFor(player),
		Loaded = false,
		Dirty = false,
		Saving = false,
		SyncQueued = false,
		JoinedAt = os.clock(),
	}
	profiles[player] = p
	local data = loadProfile(player)
	if not player.Parent then
		-- left while loading: release our lock without overwriting data
		if data and storeOk and store then
			local ds = store :: DataStore
			pcall(function()
				ds:UpdateAsync(p.Key, function(old: any)
					if type(old) == "table" then
						old._lock = nil
					end
					return old
				end)
			end)
		end
		profiles[player] = nil
		return
	end
	if not data then
		profiles[player] = nil
		player:Kick("Couldn't load your Ghost Hunter data. Please rejoin in a moment - your progress is safe.")
		return
	end
	p.Data = data
	p.Loaded = true
	player:SetAttribute("Ecto", data.Ecto)
	loadedSignal:Fire(player, data)
	DataService.Changed(player)
end

local function onPlayerRemoving(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	if p.Loaded then
		saveProfile(player, true)
	end
	profiles[player] = nil
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, pl in Players:GetPlayers() do
		task.spawn(onPlayerAdded, pl)
	end
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveSeconds)
			for player, p in profiles do
				if p.Loaded then
					task.spawn(saveProfile, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		local pending = 0
		for player, p in profiles do
			if p.Loaded then
				pending += 1
				task.spawn(function()
					saveProfile(player, true)
					pending -= 1
				end)
			end
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

-- Records a processed receipt id so a purchase is never granted twice.
function DataService.HasPurchase(d: Data, receipt: string): boolean
	return table.find(d.Purchases, receipt) ~= nil
end

function DataService.AddPurchase(d: Data, receipt: string)
	table.insert(d.Purchases, receipt)
	while #d.Purchases > 100 do
		table.remove(d.Purchases, 1)
	end
end

-- Saves now and waits; used by ProcessReceipt.
function DataService.SaveNow(player: Player): boolean
	return saveProfile(player, false)
end

DataService._GenerateId = function(): string
	return HttpService:GenerateGUID(false)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DropService</string>
            <string name="Source"><![CDATA[--!strict
-- Physical Ectoplasm orbs. The SERVER decides where each orb lands, what it is worth and
-- when it is picked up (player's root within their pickup radius). Clients only draw orbs
-- (bounce, glow, magnet flight). Orbs are per player, so nobody can steal another's loot.
-- One loop checks every player's orbs on a short interval; no per-orb connections.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)

local DropService = {}

type Drop = { Id: number, Pos: Vector3, Value: number, Expires: number }
type Bag = { List: { Drop }, NextId: number }

local bags: { [Player]: Bag } = {}
local dropsRemote: RemoteEvent
local collectRemote: RemoteEvent
local rng = Random.new()
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local collectedSignal = Instance.new("BindableEvent")
DropService.Collected = collectedSignal.Event -- (player, amount)

local function groundAt(x: number, y: number, z: number): number
	local filter: { Instance } = {}
	local ghosts = workspace:FindFirstChild("Ghosts")
	if ghosts then
		table.insert(filter, ghosts)
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(filter, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(Vector3.new(x, y + 4, z), Vector3.new(0, -80, 0), rayParams)
	return if hit then hit.Position.Y else 0
end

-- Spawns `total` Ectoplasm split into `count` orbs around `origin` for `player`.
-- scatter = {min, max} studs (defaults from Config.Drops).
function DropService.Spawn(player: Player, origin: Vector3, total: number, count: number, scatter: { number }?)
	local bag = bags[player]
	if not bag then
		return
	end
	local values = Rules.Split(total, math.max(1, count))
	local sMin = if scatter then scatter[1] else Config.Drops.ScatterMin
	local sMax = if scatter then scatter[2] else Config.Drops.ScatterMax
	local expires = os.clock() + Config.Drops.Lifetime
	local out: { { any } } = {}
	for _, v in values do
		-- over the cap: fold value into an existing orb instead of creating a new one
		if #bag.List >= Config.Drops.MaxPerPlayer then
			local d = bag.List[#bag.List]
			d.Value += v
			continue
		end
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber(sMin, sMax)
		local x = origin.X + math.cos(a) * r
		local z = origin.Z + math.sin(a) * r
		-- keep orbs inside the playable area
		x = math.clamp(x, -Config.Layout.HalfWidth + 4, Config.Layout.HalfWidth - 4)
		local y = groundAt(x, origin.Y, z) + 1.1
		local drop: Drop = { Id = bag.NextId, Pos = Vector3.new(x, y, z), Value = v, Expires = expires }
		bag.NextId += 1
		table.insert(bag.List, drop)
		table.insert(out, { drop.Id, drop.Pos, drop.Value } :: { any })
	end
	if #out > 0 then
		dropsRemote:FireClient(player, origin, out)
	end
end

local function pickupTick()
	local t = os.clock()
	for player, bag in bags do
		if #bag.List == 0 then
			continue
		end
		local root = Remotes.Root(player)
		local radius = PlayerInfo.PickupRadius(player) + 1.5 -- latency slack
		local r2 = radius * radius
		local got = 0
		local ids = {}
		local i = 1
		while i <= #bag.List do
			local d = bag.List[i]
			local take = false
			if root then
				local dx = d.Pos.X - root.Position.X
				local dz = d.Pos.Z - root.Position.Z
				take = dx * dx + dz * dz <= r2 and math.abs(d.Pos.Y - root.Position.Y) < 14
			end
			if take then
				got += d.Value
				table.insert(ids, d.Id)
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			elseif t >= d.Expires then
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			else
				i += 1
			end
		end
		if got > 0 then
			DataService.AddEcto(player, got)
			collectRemote:FireClient(player, ids, got)
			collectedSignal:Fire(player, got)
		end
	end
end

function DropService.Init()
	dropsRemote = Net.Event("Drops")
	collectRemote = Net.Event("Collect")
end

function DropService.Start()
	local function add(player: Player)
		bags[player] = { List = {}, NextId = 1 }
	end
	Players.PlayerAdded:Connect(add)
	for _, pl in Players:GetPlayers() do
		add(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		bags[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Drops.PickupTick)
			pickupTick()
		end
	end)
end

return DropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST: a periodic server-wide boss everyone can attack. Spirit scales with the
-- crews in the server; rewards scale with each participant's share of the damage.
-- Client messages (Fx "Boss"): { State = "Warning"|"Active"|"Defeated"|"Escaped", At = serverTime, Uid?, EndsAt? }
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local GhostService = require(script.Parent.GhostService)
local DropService = require(script.Parent.DropService)
local Fx = require(script.Parent.Fx)

local EventService = {}

local current: GhostService.Ghost? = nil
local state = "Idle"
local endsAt = 0
local rng = Random.new()

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function spiritFor(): number
	local sum = 0
	for _, pl in Players:GetPlayers() do
		sum += math.min(HunterService.CrewPower(pl), Config.Event.PowerCap)
	end
	return Config.Event.SpiritBase + Config.Event.SpiritPerPower * sum
end

local function reward(g: GhostService.Ghost)
	local total = 0
	local participants = {}
	for player, dmg in g.Damage do
		if player.Parent and dmg >= g.Max * Config.Event.MinContribution then
			table.insert(participants, player)
			total += dmg
		end
	end
	local arena = Config.Layout.EventArena
	for _, player in participants do
		local d = DataService.Get(player)
		if d then
			local share = Rules.EventShare(g.Damage[player], total, #participants, Config.Event.MinShare, Config.Event.MaxShare)
			local amount = Config.Event.RewardBase * PlayerInfo.ZoneMultiplier(player) * share * PlayerInfo.EctoMultiplier(player)
			amount = math.floor(amount + 0.5)
			-- Ectoplasm shower over the arena
			DropService.Spawn(player, arena.Center + Vector3.new(0, 12, 0), amount, Config.Event.RewardDrops, { 4, arena.Radius - 4 })
			d.Stats.Events += 1
			Fx.Toast(player, "GIANT POLTERGEIST DEFEATED! +" .. Format.Commas(amount) .. " Ectoplasm incoming!", "Good")
		end
	end
end

local function runEvent()
	if state ~= "Idle" then
		return
	end
	local arena = Config.Layout.EventArena
	state = "Warning"
	Fx.All("Boss", { State = "Warning", At = serverNow() + Config.Event.WarningSeconds, Pos = arena.Center })
	task.wait(Config.Event.WarningSeconds)
	if #Players:GetPlayers() == 0 then
		state = "Idle"
		return
	end
	local def = Config.Ghosts[Config.Event.Ghost]
	local g = GhostService.Spawn(def, arena.Center, arena.Radius * 0.35, { Spirit = spiritFor(), Event = true })
	current = g
	state = "Active"
	endsAt = serverNow() + Config.Event.Duration
	g.Model:SetAttribute("EndsAt", endsAt)
	Fx.All("Boss", { State = "Active", Uid = g.Uid, EndsAt = endsAt, Pos = arena.Center })
	while g.Alive and serverNow() < endsAt do
		task.wait(0.5)
	end
	if g.Alive then
		GhostService.Remove(g, nil, false)
		Fx.All("Boss", { State = "Escaped" })
	end
	current = nil
	state = "Idle"
end

function EventService.Init()
	GhostService.Killed:Connect(function(g: GhostService.Ghost, _killer: Player?)
		if g.Event and current == g then
			Fx.All("Boss", { State = "Defeated", Pos = GhostService.Position(g) })
			reward(g)
		end
	end)
	-- late joiners see the current boss
	DataService.Loaded:Connect(function(player)
		if state == "Active" and current then
			Fx.To(player, "Boss", { State = "Active", Uid = current.Uid, EndsAt = endsAt, Pos = Config.Layout.EventArena.Center })
		end
	end)
end

function EventService.Start()
	task.spawn(function()
		task.wait(Config.Event.FirstDelay)
		while true do
			local ok, err = pcall(function()
				runEvent()
			end)
			if not ok then
				warn("[Event] " .. tostring(err))
				state = "Idle"
				current = nil
			end
			task.wait(Config.Event.Interval + rng:NextNumber(-30, 30))
		end
	end)
end

-- Studio/testing helper: start an event now (used by the admin command in Main).
function EventService.TriggerNow()
	task.spawn(runEvent)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Server → client effect/announcement messages over the "Fx" remote.
-- Kinds: Poof, Announce, ZoneUnlocked, Boss, Toast, Upgrade, Daily (see docs/ARCHITECTURE.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("GH").Net)

local Fx = {}
local remote: RemoteEvent

function Fx.Init()
	remote = Net.Event("Fx")
end

function Fx.All(kind: string, data: any?)
	remote:FireAllClients(kind, data)
end

function Fx.To(player: Player, kind: string, data: any?)
	remote:FireClient(player, kind, data)
end

function Fx.Toast(player: Player, text: string, color: string?)
	remote:FireClient(player, "Toast", { Text = text, Color = color })
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">GhostService</string>
            <string name="Source"><![CDATA[--!strict
-- Ghost spawning, wandering, targeting and server-authoritative damage.
--
-- Movement is NOT simulated per frame on the server. Each ghost has a straight wander segment
-- (attributes From, To, T0, Dur in server time); the server evaluates the position only when it
-- needs it (range checks, drops) and every client animates the model locally along the same
-- segment. One loop handles all ghosts, so there is no per-ghost Heartbeat connection.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local GhostRig = require(GH.Rigs.GhostRig)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local DropService = require(script.Parent.DropService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local GhostService = {}

export type Ghost = {
	Uid: number,
	Def: Config.GhostDef,
	Model: Model,
	Spirit: number,
	Max: number,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	NextMove: number,
	Center: Vector3,
	Radius: number,
	Alive: boolean,
	Event: boolean,
	Area: number?, -- index into Config.Layout.GhostAreas (nil for event ghosts)
	Damage: { [Player]: number },
	DirtySpirit: boolean,
}

local ghosts: { [number]: Ghost } = {}
local nextUid = 1
local folder: Folder
local rng = Random.new()

-- Ready = os.clock() when damage may start (hunters need time to run over).
type Target = { Uid: number, Ready: number }
local targets: { [Player]: Target } = {}

local killedSignal = Instance.new("BindableEvent")
GhostService.Killed = killedSignal.Event -- (ghost: Ghost, killer: Player?)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function GhostService.Position(g: Ghost, t: number?): Vector3
	local a = if g.Dur > 0 then math.clamp(((t or now()) - g.T0) / g.Dur, 0, 1) else 1
	return g.From:Lerp(g.To, smooth(a))
end

function GhostService.Get(uid: number): Ghost?
	return ghosts[uid]
end

function GhostService.All(): { [number]: Ghost }
	return ghosts
end

local function randomPoint(center: Vector3, radius: number, hover: number): Vector3
	local a = rng:NextNumber() * math.pi * 2
	local r = math.sqrt(rng:NextNumber()) * radius
	return Vector3.new(center.X + math.cos(a) * r, center.Y + hover, center.Z + math.sin(a) * r)
end

local function setSegment(g: Ghost, to: Vector3)
	local t = now()
	local from = GhostService.Position(g, t)
	g.From = from
	g.To = to
	g.T0 = t
	g.Dur = math.max(0.5, (to - from).Magnitude / math.max(g.Def.Speed, 0.1))
	g.NextMove = t + g.Dur + rng:NextNumber(0.4, g.Def.Wander)
	local m = g.Model
	m:SetAttribute("From", g.From)
	m:SetAttribute("To", g.To)
	m:SetAttribute("T0", g.T0)
	m:SetAttribute("Dur", g.Dur)
end

-- Creates a ghost. `spirit` overrides the config value (event ghost scaling).
export type SpawnOpts = { Spirit: number?, Event: boolean?, Area: number? }

function GhostService.Spawn(def: Config.GhostDef, center: Vector3, radius: number, opts: SpawnOpts?): Ghost
	local o: SpawnOpts = opts or {}
	local uid = nextUid
	nextUid += 1
	local spirit = math.floor(o.Spirit or def.Spirit)
	local pos = randomPoint(center, radius, def.Hover)
	local model = GhostRig.Build(def.Id)
	model.Name = "Ghost_" .. uid
	model:PivotTo(CFrame.new(pos))
	model:SetAttribute("Uid", uid)
	model:SetAttribute("GhostId", def.Id)
	model:SetAttribute("Spirit", spirit)
	model:SetAttribute("MaxSpirit", spirit)
	model:SetAttribute("Zone", def.Zone)
	model:SetAttribute("Event", o.Event == true)
	local g: Ghost = {
		Uid = uid,
		Def = def,
		Model = model,
		Spirit = spirit,
		Max = spirit,
		From = pos,
		To = pos,
		T0 = now(),
		Dur = 0,
		NextMove = 0,
		Center = center,
		Radius = radius,
		Alive = true,
		Event = o.Event == true,
		Area = o.Area,
		Damage = {},
		DirtySpirit = false,
	}
	ghosts[uid] = g
	setSegment(g, pos)
	g.NextMove = now() + rng:NextNumber(0, def.Wander)
	model.Parent = folder
	return g
end

local function rootPos(player: Player): Vector3?
	local root = Remotes.Root(player)
	return if root then root.Position else nil
end

local function setTarget(player: Player, uid: number?)
	local g = uid and ghosts[uid]
	if uid and g then
		-- damage starts once the crew could plausibly have run to the ghost
		local p = rootPos(player)
		local run = if p then (GhostService.Position(g) - p).Magnitude / Config.Combat.HunterRunSpeed else 0
		targets[player] = { Uid = uid, Ready = os.clock() + Config.Combat.EngageDelay + math.min(run, 2) }
		player:SetAttribute("Target", uid)
	else
		targets[player] = nil
		player:SetAttribute("Target", 0)
	end
end

-- Nearest living, non-event ghost in an unlocked zone within `range` of the player.
local function nearestFor(player: Player, range: number): Ghost?
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not d or not p then
		return nil
	end
	local best, bestDist = nil, range
	local t = now()
	for _, g in ghosts do
		if g.Alive and not g.Event and d.Zones[g.Def.Zone] then
			local dist = (GhostService.Position(g, t) - p).Magnitude
			if dist < bestDist then
				best, bestDist = g, dist
			end
		end
	end
	return best
end

-- Removes a ghost. reward=false for escapes/cleanup.
function GhostService.Remove(g: Ghost, killer: Player?, reward: boolean)
	if not g.Alive then
		return
	end
	g.Alive = false
	ghosts[g.Uid] = nil
	local pos = GhostService.Position(g)
	g.Model:SetAttribute("Spirit", 0)
	g.Model:SetAttribute("Dead", true)
	Fx.All("Poof", {
		Uid = g.Uid,
		Pos = pos,
		Scale = g.Def.Scale,
		Color = g.Def.Glow,
		Big = g.Def.Kind ~= "Normal",
		Escaped = not reward,
	})
	task.delay(1.2, function()
		g.Model:Destroy()
	end)

	if reward and not g.Event then
		local minShare = g.Max * Config.Combat.ContributorShare
		for player, dmg in g.Damage do
			if player.Parent and (player == killer or dmg >= minShare) then
				local d = DataService.Get(player)
				if d then
					local base = rng:NextInteger(g.Def.Reward[1], g.Def.Reward[2])
					local total = math.max(1, math.floor(base * PlayerInfo.EctoMultiplier(player) + 0.5))
					DropService.Spawn(player, pos, total, g.Def.Drops, nil)
					d.Stats.Ghosts += 1
				end
			end
		end
	end
	if reward then
		killedSignal:Fire(g, killer)
	end

	-- Hunters on this ghost move on: auto-target the next nearest ghost, or come home.
	for player, tg in targets do
		if tg.Uid == g.Uid then
			local d = DataService.Get(player)
			local nextG = if d and d.Settings.AutoTarget and not g.Event then nearestFor(player, 55) else nil
			setTarget(player, if nextG then nextG.Uid else nil)
		end
	end

	if g.Area then
		local area = Config.Layout.GhostAreas[g.Area]
		task.delay(g.Def.Respawn, function()
			GhostService.Spawn(g.Def, area.Center, area.Radius, { Area = g.Area })
		end)
	end
end

local function onSelect(player: Player, uid: any)
	if not Remotes.Allow(player, "SelectTarget") then
		return
	end
	if uid == nil or uid == 0 then
		setTarget(player, nil)
		return
	end
	if type(uid) ~= "number" then
		return
	end
	local g = ghosts[uid]
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not g or not g.Alive or not d or not p then
		return
	end
	if not d.Zones[g.Def.Zone] then
		Fx.Toast(player, "Unlock " .. (Config.ZoneById[g.Def.Zone] :: Config.ZoneDef).Name .. " first!", "Bad")
		return
	end
	if (GhostService.Position(g) - p).Magnitude > Config.Combat.MaxRange + 15 then
		Fx.Toast(player, "Get closer to that ghost!", "Bad")
		return
	end
	local cur = targets[player]
	if cur and cur.Uid == uid then
		return
	end
	setTarget(player, uid)
end

local function damageTick(dt: number)
	local t = now()
	local clock = os.clock()
	for player, tg in targets do
		local g = ghosts[tg.Uid]
		if not g or not g.Alive or not player.Parent then
			targets[player] = nil
			if player.Parent then
				player:SetAttribute("Target", 0)
			end
			continue
		end
		local p = rootPos(player)
		if not p then
			continue
		end
		local dist = (GhostService.Position(g, t) - p).Magnitude
		if dist > Config.Combat.MaxRange * 1.4 then
			setTarget(player, nil) -- walked away: hunters come home
			continue
		end
		if dist > Config.Combat.MaxRange or clock < tg.Ready then
			continue
		end
		local power = HunterService.CrewPower(player)
		if power <= 0 then
			continue
		end
		local dmg = power * dt
		g.Spirit -= dmg
		g.Damage[player] = (g.Damage[player] or 0) + dmg
		g.DirtySpirit = true
		if g.Spirit <= 0 then
			GhostService.Remove(g, player, true)
		end
	end
	for _, g in ghosts do
		if g.DirtySpirit and g.Alive then
			g.DirtySpirit = false
			g.Model:SetAttribute("Spirit", math.max(0, math.ceil(g.Spirit)))
		end
	end
end

local function moveTick()
	local t = now()
	for _, g in ghosts do
		if g.Alive and t >= g.NextMove then
			setSegment(g, randomPoint(g.Center, g.Radius, g.Def.Hover))
		end
	end
end

function GhostService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Ghosts"
	folder.Parent = workspace
	Net.Event("SelectTarget").OnServerEvent:Connect(onSelect)
end

function GhostService.Start()
	for i, area in Config.Layout.GhostAreas do
		local def = Config.Ghosts[area.Ghost]
		for _ = 1, area.Count do
			GhostService.Spawn(def, area.Center, area.Radius, { Area = i })
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		for _, g in ghosts do
			g.Damage[player] = nil
		end
	end)
	task.spawn(function()
		local tick = Config.Combat.TickSeconds
		local last = os.clock()
		while true do
			task.wait(tick)
			local c = os.clock()
			-- cap dt so a server hitch can't produce a burst of damage
			damageTick(math.min(c - last, tick * 2))
			last = c
			moveTick()
		end
	end)
end

-- Tutorial / UI helper: closest ghost the player can fight.
GhostService.NearestFor = nearestFor

return GhostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">HunterService</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter inventory, equipping and crate opening (server-authoritative rolls).
-- Replicates each player's crew to everyone through player attributes:
--   Crew = "HunterId,HunterId,..." (equipped order), CrewPower = number.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local HunterService = {}

local rng = Random.new()
local STATION_RANGE = 30

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	local r = h and Config.Rarities[h.Rarity]
	return if r then r.Order else 1
end
HunterService.PowerOf = powerOf
HunterService.RarityOrder = rarityOrder

local function countOwned(d: DataService.Data): number
	local n = 0
	for _ in d.Hunters do
		n += 1
	end
	return n
end

function HunterService.CrewPower(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	return Rules.CrewPower(d.Equipped, d.Hunters, powerOf)
end

-- Pushes the crew to attributes (for everyone's visuals) and re-syncs the owner.
function HunterService.Refresh(player: Player)
	local d = DataService.Get(player)
	if not d then
		return
	end
	local ids = {}
	for _, uid in d.Equipped do
		local h = d.Hunters[uid]
		if h then
			table.insert(ids, h.Id)
		end
	end
	player:SetAttribute("Crew", table.concat(ids, ","))
	player:SetAttribute("CrewPower", Rules.CrewPower(d.Equipped, d.Hunters, powerOf))
	DataService.Changed(player)
end

function HunterService.Add(player: Player, hunterId: string): (string?, boolean)
	local d = DataService.Get(player)
	if not d or not Config.Hunters[hunterId] then
		return nil, false
	end
	local uid = DataService.NewUid(d)
	d.Hunters[uid] = { Id = hunterId, Locked = false, T = os.time() }
	local isNew = not d.Discovered[hunterId]
	d.Discovered[hunterId] = true
	return uid, isNew
end

-- A profile with nothing equipped (new player) gets its best hunters equipped.
local function ensureEquipped(player: Player, d: DataService.Data)
	if #d.Equipped == 0 then
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
	end
end

local function crateRoll(player: Player, crate: Config.CrateDef): string
	return Rules.Roll(crate.Pool :: any, rarityOrder, PlayerInfo.LuckMultiplier(player), Config.LuckAffectsFromOrder, rng:NextNumber())
end

-- Opens one crate. `free` = paid by a free-crate token (daily day 7) instead of Ectoplasm.
local function openCrate(player: Player, crateId: any): any
	if type(crateId) ~= "string" then
		return Remotes.Fail("Bad crate")
	end
	local crate = Config.Crates[crateId]
	local d = DataService.Get(player)
	if not crate or not d then
		return Remotes.Fail("Bad crate")
	end
	if not d.Zones[crate.Zone] then
		return Remotes.Fail("Unlock this zone first!")
	end
	local station = Config.Layout.CrateStations[crateId]
	if not station or not Remotes.Near(player, station, STATION_RANGE) then
		return Remotes.Fail("Walk to the crate first!")
	end
	if countOwned(d) >= Config.Inventory.MaxHunters then
		return Remotes.Fail("Hunter storage full! Release some hunters.")
	end
	local usedFree = false
	if (d.FreeCrates[crateId] or 0) > 0 then
		d.FreeCrates[crateId] -= 1
		if d.FreeCrates[crateId] <= 0 then
			d.FreeCrates[crateId] = nil
		end
		usedFree = true
	elseif not DataService.Spend(player, crate.Price) then
		return Remotes.Fail("Not enough Ectoplasm!")
	end
	local hunterId = crateRoll(player, crate)
	local uid, isNew = HunterService.Add(player, hunterId)
	d.Stats.Crates += 1
	local def = Config.Hunters[hunterId]
	local rarity = Config.Rarities[def.Rarity]
	if rarity.Announce then
		Fx.All("Announce", {
			Text = string.format("%s hatched a %s %s!", player.DisplayName, rarity.Name, string.upper(def.Name)),
			Color = def.Rarity,
		})
	end
	DataService.Changed(player)
	return { ok = true, Uid = uid, Hunter = hunterId, IsNew = isNew, Free = usedFree, Crate = crateId }
end

local function validUid(d: DataService.Data, uid: any): boolean
	return type(uid) == "string" and #uid < 20 and d.Hunters[uid] ~= nil
end

function HunterService.Init()
	DataService.AddDecorator(function(player, s)
		s.CrewPower = HunterService.CrewPower(player)
	end)

	Remotes.Register("OpenCrate", "OpenCrate", openCrate)

	Remotes.Register("Equip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		if table.find(d.Equipped, uid) then
			return { ok = true }
		end
		if #d.Equipped >= PlayerInfo.Slots(player) then
			return Remotes.Fail("All slots full! Unequip one first.")
		end
		table.insert(d.Equipped, uid)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("Unequip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		local i = table.find(d.Equipped, uid)
		if not i then
			return { ok = true }
		end
		if #d.Equipped <= 1 then
			return Remotes.Fail("Keep at least one hunter equipped!")
		end
		table.remove(d.Equipped, i)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("EquipBest", "Inventory", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
		HunterService.Refresh(player)
		return { ok = true, Power = HunterService.CrewPower(player) }
	end)

	Remotes.Register("Lock", "Inventory", function(player, uid, locked)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) or type(locked) ~= "boolean" then
			return Remotes.Fail("Unknown hunter")
		end
		d.Hunters[uid].Locked = locked
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Releases (deletes) unlocked, unequipped hunters for a small refund.
	Remotes.Register("Release", "Inventory", function(player, uids)
		local d = DataService.Get(player)
		if not d or type(uids) ~= "table" or #uids == 0 or #uids > Config.Inventory.MaxHunters then
			return Remotes.Fail("Nothing selected")
		end
		local refund = 0
		local released = 0
		local total = countOwned(d)
		for _, uid in uids do
			if total - released <= 1 then
				break
			end
			if validUid(d, uid) and not table.find(d.Equipped, uid) and not d.Hunters[uid].Locked then
				local def = Config.Hunters[d.Hunters[uid].Id]
				local crate = Config.Crates[(Config.ZoneById[def.Zone] :: Config.ZoneDef).Crate]
				refund += math.floor((if crate then crate.Price else 0) * Config.Inventory.ReleaseRefund)
				d.Hunters[uid] = nil
				released += 1
			end
		end
		if released == 0 then
			return Remotes.Fail("Can't release equipped or locked hunters")
		end
		if refund > 0 then
			DataService.AddEcto(player, refund)
		end
		DataService.Changed(player)
		Fx.Toast(player, string.format("Released %d hunter%s (+%s Ectoplasm)", released, if released == 1 then "" else "s", Format.Commas(refund)))
		return { ok = true, Released = released, Refund = refund }
	end)

	DataService.Loaded:Connect(function(player: Player, d: DataService.Data)
		if next(d.Hunters) == nil then
			HunterService.Add(player, Config.StarterHunter)
		end
		ensureEquipped(player, d)
		HunterService.Refresh(player)
	end)
end

function HunterService.Start()
	Players.PlayerRemoving:Connect(function(player)
		PlayerInfo.Forget(player)
	end)
end

return HunterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PlayerInfo</string>
            <string name="Source"><![CDATA[--!strict
-- Derived per-player numbers (slots, multipliers, radius) from data + game passes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)

local PlayerInfo = {}

-- Game passes owned this session (filled by ShopService).
local passes: { [Player]: { [string]: boolean } } = {}

function PlayerInfo.SetPass(player: Player, key: string, owned: boolean)
	passes[player] = passes[player] or {}
	passes[player][key] = owned
end

function PlayerInfo.HasPass(player: Player, key: string): boolean
	local p = passes[player]
	return p ~= nil and p[key] == true
end

function PlayerInfo.Forget(player: Player)
	passes[player] = nil
end

local function passDef(key: string): Config.PassDef?
	for _, p in Config.GamePasses do
		if p.Key == key then
			return p
		end
	end
	return nil
end

function PlayerInfo.Slots(player: Player): number
	local extra = 0
	local def = passDef("ExtraSlots")
	if def and PlayerInfo.HasPass(player, "ExtraSlots") then
		extra = def.Slots or 0
	end
	return Config.Inventory.BaseSlots + extra
end

function PlayerInfo.BoostActive(d: DataService.Data, boost: string): boolean
	local t = d.Boosts[boost]
	return t ~= nil and t > os.time()
end

function PlayerInfo.AddBoost(d: DataService.Data, boost: string, seconds: number)
	local now = os.time()
	local cur = math.max(d.Boosts[boost] or 0, now)
	d.Boosts[boost] = math.min(cur + seconds, now + Config.Boosts.MaxStackSeconds)
end

function PlayerInfo.EctoMultiplier(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 1
	end
	local up = Config.Upgrades.EctoBonus
	local bonus = Rules.UpgradeValue(up.Levels, d.Upgrades.EctoBonus or 1)
	local passMul = 1
	local def = passDef("DoubleEcto")
	if def and PlayerInfo.HasPass(player, "DoubleEcto") then
		passMul = def.Multiplier or 1
	end
	return Rules.EctoMultiplier(bonus, PlayerInfo.BoostActive(d, "Ecto"), Config.Boosts.Ecto.Multiplier, passMul)
end

function PlayerInfo.LuckMultiplier(player: Player): number
	local d = DataService.Get(player)
	if d and PlayerInfo.BoostActive(d, "Luck") then
		return Config.Boosts.Luck.Multiplier
	end
	return 1
end

function PlayerInfo.PickupRadius(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.PickupRadius or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.PickupRadius.Levels, lv)
end

function PlayerInfo.WalkSpeed(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.MoveSpeed or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.MoveSpeed.Levels, lv)
end

-- Index (1-based) of the furthest unlocked zone, used to scale flat rewards.
function PlayerInfo.BestZone(player: Player): number
	local d = DataService.Get(player)
	local best = 1
	if d then
		for i, z in Config.Zones do
			if d.Zones[z.Id] then
				best = math.max(best, i)
			end
		end
	end
	return best
end

function PlayerInfo.ZoneMultiplier(player: Player): number
	local m = Config.Daily.ZoneMultiplier
	return m[math.min(PlayerInfo.BestZone(player), #m)]
end

function PlayerInfo.Init()
	DataService.AddDecorator(function(player, s)
		s.Slots = PlayerInfo.Slots(player)
		s.EctoMultiplier = PlayerInfo.EctoMultiplier(player)
		s.LuckMultiplier = PlayerInfo.LuckMultiplier(player)
		s.PickupRadius = PlayerInfo.PickupRadius(player)
		s.ZoneMultiplier = PlayerInfo.ZoneMultiplier(player)
		local owned = {}
		for _, p in Config.GamePasses do
			owned[p.Key] = PlayerInfo.HasPass(player, p.Key)
		end
		s.Passes = owned
	end)
end

return PlayerInfo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
-- Zone unlocks (+ keeping players out of locked zones), upgrades, daily reward,
-- settings and tutorial progress.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ProgressService = {}

local GATE_RANGE = 40

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function applyWalkSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = PlayerInfo.WalkSpeed(player)
	end
end

-- Daily reward grant (also used by Day 7 crate token).
local function grantReward(player: Player, d: DataService.Data, reward: Config.RewardDef): string
	local mult = PlayerInfo.ZoneMultiplier(player)
	if reward.Amount and reward.Amount > 0 then
		DataService.AddEcto(player, reward.Amount * mult)
	end
	if reward.Boost and reward.Seconds then
		PlayerInfo.AddBoost(d, reward.Boost, reward.Seconds)
	end
	if reward.Crate then
		d.FreeCrates[reward.Crate] = (d.FreeCrates[reward.Crate] or 0) + 1
	end
	if reward.Amount and mult > 1 then
		return (reward.Label:gsub(Format.Commas(reward.Amount), Format.Commas(reward.Amount * mult)))
	end
	return reward.Label
end
ProgressService.GrantReward = grantReward

function ProgressService.Init()
	DataService.AddDecorator(function(_player, s)
		local d = s :: any
		local info = Rules.Daily(os.time(), d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		s.DailyInfo = info
	end)

	Remotes.Register("UnlockZone", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if d.Zones[zone.Id] then
			return { ok = true }
		end
		local prev = Config.Zones[zone.Order - 1]
		if prev and not d.Zones[prev.Id] then
			return Remotes.Fail("Unlock " .. prev.Name .. " first!")
		end
		local gate = Config.Layout.Gates[zone.Id]
		if gate and not Remotes.Near(player, Vector3.new(0, 3, gate.Z), GATE_RANGE) then
			return Remotes.Fail("Walk to the gate first!")
		end
		if not DataService.Spend(player, zone.Cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Zones[zone.Id] = true
		DataService.Changed(player)
		Fx.To(player, "ZoneUnlocked", { Zone = zone.Id })
		return { ok = true }
	end)

	Remotes.Register("BuyUpgrade", "Default", function(player, upgradeId)
		local d = DataService.Get(player)
		local up = type(upgradeId) == "string" and Config.Upgrades[upgradeId] or nil
		if not d or not up then
			return Remotes.Fail("Unknown upgrade")
		end
		local level = d.Upgrades[up.Id] or 1
		local cost = Rules.UpgradeCost(up.Costs, level)
		if not cost then
			return Remotes.Fail("Already maxed!")
		end
		if not DataService.Spend(player, cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Upgrades[up.Id] = level + 1
		if up.Id == "MoveSpeed" then
			applyWalkSpeed(player)
		end
		DataService.Changed(player)
		return { ok = true, Level = level + 1 }
	end)

	Remotes.Register("ClaimDaily", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		local now = os.time()
		local info = Rules.Daily(now, d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		if not info.CanClaim then
			return Remotes.Fail("Come back in " .. Format.Time(info.Wait))
		end
		local reward = Config.Daily.Rewards[info.Day]
		local streak = if info.Day == 1 then 1 else d.Daily.Streak + 1
		d.Daily.Last = now
		d.Daily.Streak = streak
		local label = grantReward(player, d, reward)
		DataService.Changed(player)
		DataService.Save(player)
		return { ok = true, Day = info.Day, Label = label }
	end)

	Remotes.Register("Setting", "Default", function(player, key, value)
		local d = DataService.Get(player)
		if not d or type(key) ~= "string" or type(value) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		if type((d.Settings :: any)[key]) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		(d.Settings :: any)[key] = value
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Tutorial progress is cosmetic (client-driven guidance); only allow moving forward.
	Remotes.Register("Tutorial", "Default", function(player, step)
		local d = DataService.Get(player)
		if not d or type(step) ~= "number" or step ~= step then
			return Remotes.Fail("Bad step")
		end
		step = math.clamp(math.floor(step), 1, #Config.Tutorial.Steps + 1)
		if step > d.Tutorial then
			d.Tutorial = step
			DataService.Changed(player)
		end
		return { ok = true }
	end)
end

-- Server-side guard: anyone standing in a zone they don't own is moved back to the gate.
local function zoneGuardTick()
	for _, player in Players:GetPlayers() do
		local d = DataService.Get(player)
		local root = Remotes.Root(player)
		if not d or not root then
			continue
		end
		local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
		local zone = Config.Zones[idx]
		if zone and not d.Zones[zone.Id] then
			-- find the furthest owned zone and drop them in front of its exit gate
			local safeZ = Config.Layout.Spawn.Z
			for i = idx - 1, 1, -1 do
				local z = Config.Zones[i]
				if d.Zones[z.Id] then
					local nextZone = Config.Zones[i + 1]
					local gate = nextZone and Config.Layout.Gates[nextZone.Id]
					safeZ = if gate then gate.Z - 12 else z.MinZ + 20
					break
				end
			end
			local char = player.Character
			if char then
				char:PivotTo(CFrame.new(math.clamp(root.Position.X, -10, 10), 4, safeZ))
			end
		end
	end
end

function ProgressService.Start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 10)
			if hum then
				applyWalkSpeed(player)
				-- hunters never collide with players: characters go in their own group
				for _, part in char:GetDescendants() do
					if part:IsA("BasePart") then
						part.CollisionGroup = "Players"
					end
				end
				char.DescendantAdded:Connect(function(part)
					if part:IsA("BasePart") then
						part.CollisionGroup = "Players"
					end
				end)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	DataService.Loaded:Connect(function(player)
		applyWalkSpeed(player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			zoneGuardTick()
		end
	end)
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Validated, rate-limited request dispatcher. Clients call
--   Request:InvokeServer(action, ...) -> { ok: boolean, err: string?, ... }
-- Handlers never trust arguments: they type-check everything they receive.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)

local Remotes = {}

type Handler = (Player, ...any) -> any
local handlers: { [string]: { fn: Handler, bucket: string } } = {}
local limiters: { [string]: Rules.Limiter } = {}

local function limiter(bucket: string): Rules.Limiter
	local l = limiters[bucket]
	if not l then
		local def = (Config.RateLimits :: any)[bucket] or Config.RateLimits.Default
		l = Rules.NewLimiter(def.Count, def.Window)
		limiters[bucket] = l
	end
	return l
end

function Remotes.Allow(player: Player, bucket: string): boolean
	return Rules.Allow(limiter(bucket), tostring(player.UserId), os.clock())
end

function Remotes.Register(action: string, bucket: string, fn: Handler)
	assert(not handlers[action], "duplicate action " .. action)
	handlers[action] = { fn = fn, bucket = bucket }
end

function Remotes.Init()
	local rf = Net.Function("Request")
	rf.OnServerInvoke = function(player: Player, action: any, ...: any): any
		if type(action) ~= "string" then
			return { ok = false, err = "Bad request" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, err = "Unknown action" }
		end
		if not Remotes.Allow(player, h.bucket) then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(h.fn, player, ...)
		if not ok then
			warn(string.format("[Remotes] %s from %s errored: %s", action, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		if type(result) ~= "table" then
			return { ok = result == true }
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		local key = tostring(player.UserId)
		for _, l in limiters do
			l.hits[key] = nil
		end
	end)
end

-- Helpers for handlers
function Remotes.Fail(err: string): any
	return { ok = false, err = err }
end

function Remotes.Root(player: Player): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Remotes.Near(player: Player, pos: Vector3, maxDist: number): boolean
	local root = Remotes.Root(player)
	return root ~= nil and (root.Position - pos).Magnitude <= maxDist
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux shop: developer products (Ectoplasm packs, boosts) and game passes.
-- ProcessReceipt is idempotent: receipts are recorded in the profile and saved before
-- returning PurchaseGranted, so a purchase is never lost or granted twice.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ShopService = {}

local function productById(id: number): Config.ProductDef?
	for _, p in Config.Products do
		if p.ProductId == id then
			return p
		end
	end
	return nil
end

local function grantProduct(player: Player, d: DataService.Data, p: Config.ProductDef)
	if p.Kind == "Ecto" and p.Amount then
		DataService.AddEcto(player, p.Amount * PlayerInfo.ZoneMultiplier(player))
	elseif p.Kind == "Boost" and p.Boost and p.Seconds then
		PlayerInfo.AddBoost(d, p.Boost, p.Seconds)
	end
	DataService.Changed(player)
	Fx.Toast(player, "Thanks! " .. p.Name .. " added!", "Good")
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = DataService.WaitFor(player, 20)
	if not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipt = tostring(info.PurchaseId)
	if DataService.HasPurchase(d, receipt) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local p = productById(info.ProductId)
	if not p then
		warn("[Shop] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(player, d, p)
	DataService.AddPurchase(d, receipt)
	if not DataService.SaveNow(player) then
		-- Roblox will retry the receipt later; our record prevents a double grant in this session
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.PassId then
			local ok, owned = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.PassId :: number)
			end)
			PlayerInfo.SetPass(player, pass.Key, ok and owned == true)
		end
	end
	HunterService.Refresh(player)
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.PassId == passId then
				PlayerInfo.SetPass(player, pass.Key, true)
				HunterService.Refresh(player)
				Fx.Toast(player, "Thanks! " .. pass.Name .. " unlocked!", "Good")
			end
		end
	end)

	-- Client asks to buy: server validates the key and prompts (ids never come from the client).
	Remotes.Register("Buy", "Default", function(player, key)
		if type(key) ~= "string" then
			return Remotes.Fail("Bad item")
		end
		for _, p in Config.Products do
			if p.Key == key then
				if not p.ProductId then
					return Remotes.Fail("Coming soon!")
				end
				MarketplaceService:PromptProductPurchase(player, p.ProductId)
				return { ok = true }
			end
		end
		for _, pass in Config.GamePasses do
			if pass.Key == key then
				if not pass.PassId then
					return Remotes.Fail("Coming soon!")
				end
				if PlayerInfo.HasPass(player, pass.Key) then
					return Remotes.Fail("You already own this!")
				end
				MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
				return { ok = true }
			end
		end
		return Remotes.Fail("Bad item")
	end)

	DataService.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
end

function ShopService.Start() end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">StationService</string>
            <string name="Source"><![CDATA[--!strict
-- Dresses the stations the world builder made: crate display models, odds boards and
-- ProximityPrompts (crates, upgrades, gates). Prompts only open client UI; every purchase
-- goes through validated Requests.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local CrateRig = require(GH.Rigs.CrateRig)

local StationService = {}

local function find(path: { string }): Instance?
	local cur: Instance? = workspace
	for _, name in path do
		cur = cur and cur:FindFirstChild(name)
	end
	return cur
end

local function prompt(parent: Instance, action: string, object: string, attrs: { [string]: any }): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "GHPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonY
	p.Style = Enum.ProximityPromptStyle.Default
	for k, v in attrs do
		p:SetAttribute(k, v)
	end
	p.Parent = parent
	return p
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(25, 10, 45)
	stroke.Parent = t
	t.Parent = parent
	return t
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function buildOddsBoard(board: BasePart, crate: Config.CrateDef)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Odds"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(70, 40, 120), Color3.fromRGB(25, 15, 45))
	grad.Rotation = 90
	grad.Parent = bg
	label(bg, crate.Name, UDim2.fromScale(0.94, 0.13), UDim2.fromScale(0.03, 0.03), crate.Trim)
	label(bg, "💚 " .. Format.Commas(crate.Price) .. " ECTOPLASM", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.1, 0.17), Color3.fromRGB(150, 255, 150))
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, 1, Config.LuckAffectsFromOrder)
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local row = Instance.new("Frame")
		row.Size = UDim2.fromScale(0.92, 0.155)
		row.Position = UDim2.fromScale(0.04, 0.29 + (i - 1) * 0.175)
		row.BackgroundColor3 = rar.Color
		row.BackgroundTransparency = 0.15
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = row
		local g2 = Instance.new("UIGradient")
		g2.Color = ColorSequence.new(rar.Color, rar.Color2)
		g2.Parent = row
		row.Parent = bg
		label(row, string.upper(def.Name), UDim2.fromScale(0.55, 0.55), UDim2.fromScale(0.03, 0.05), Color3.new(1, 1, 1))
		label(row, rar.Name .. "  •  ⚡" .. Format.Commas(def.Power), UDim2.fromScale(0.55, 0.38), UDim2.fromScale(0.03, 0.58), Color3.fromRGB(255, 255, 230))
		label(row, Format.Percent(odds[e.Hunter]), UDim2.fromScale(0.35, 0.8), UDim2.fromScale(0.62, 0.1), Color3.new(1, 1, 1))
	end
	gui.Parent = board
end

function StationService.Init() end

function StationService.Start()
	for crateId, crate in Config.Crates do
		local station = find({ "Map", "Stations", "CrateStation_" .. crateId })
		if not station then
			warn("[Stations] missing CrateStation_" .. crateId)
			continue
		end
		local slot = station:FindFirstChild("DisplaySlot") :: BasePart?
		if slot then
			local rig = CrateRig.Build(crateId)
			rig.Model.Name = "DisplayCrate"
			rig.Model:ScaleTo(1.3)
			rig.Model:PivotTo(CFrame.new(slot.Position - Vector3.new(0, 1.6, 0)))
			rig.Model.Parent = station
			CollectionService:AddTag(rig.Base, "SpinProp")
		end
		local board = station:FindFirstChild("OddsBoard") :: BasePart?
		if board then
			buildOddsBoard(board, crate)
		end
		local anchor = station:FindFirstChild("PromptAnchor")
		if anchor then
			prompt(anchor, "Open Crate", crate.Name .. " • " .. Format.Commas(crate.Price), { Crate = crateId })
		end
	end
	local up = find({ "Map", "Stations", "UpgradeStation", "PromptAnchor" })
	if up then
		prompt(up, "Upgrades", "Upgrade Station", { Station = "Upgrades" })
	end
	for _, zone in Config.Zones do
		local anchor = find({ "Map", "Gates", "Gate_" .. zone.Id, "PromptAnchor" })
		if anchor then
			prompt(anchor, "Unlock", zone.Name .. " • " .. Format.Commas(zone.Cost), { Zone = zone.Id })
		end
	end
end

return StationService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!strict
-- Giant Ghost event arena (workspace.Map.EventArena): a flat rune circle that stays clear
-- (nothing above 0.3 studs inside the radius, nothing in the air up to Y=40), with pumpkin
-- spectators, bleachers on the north/south edges and an entrance sign over the cross street.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Arena = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local function ring(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.4
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.1, cz + math.sin(a) * r)
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Kit.Part(parent, V(w, 0.2, segLen), CFrame.lookAt(p, p + tangent), color, { Mat = NEON })
	end
end

local function bleachers(parent: Instance, cx: number, z0: number, outward: number)
	-- 3 steps rising away from the arena; outward = +1 (north) or -1 (south)
	local cols = { C(160, 90, 255), C(255, 150, 60), C(110, 230, 160) }
	for i = 0, 2 do
		local zA = z0 + outward * (i * 3.5)
		local zB = z0 + outward * 11
		Kit.Box(parent, V(cx - 14, 0, zA), V(cx + 14, 1.6 * (i + 1), zB), cols[i + 1], { Solid = true })
	end
	-- pumpkin audience on the steps
	for i = 0, 2 do
		for k = -2, 2 do
			if (i + k) % 2 == 0 then
				local z = z0 + outward * (i * 3.5 + 1.75)
				Props.Pumpkin(parent, V(cx + k * 5, 1.6 * (i + 1), z), 2.6, 0, -outward)
			end
		end
	end
	Kit.AddRect(cx - 15, z0, cx + 15, z0 + outward * 12)
end

function Arena.Build(map: Instance)
	local ea = Config.Layout.EventArena
	local cx, cz, r = ea.Center.X, ea.Center.Z, ea.Radius
	local m = Kit.Model(map, "EventArena")

	-- Field (flat, top 0.12)
	local field = Kit.Disc(m, cx, cz, 0.12, r * 2 + 4, 0.4, C(90, 60, 140), { Mat = Enum.Material.Slate, Solid = true, Name = "Field" })
	Kit.Disc(m, cx, cz, 0.16, r * 2 - 6, 0.1, C(120, 80, 190), { Solid = true })
	ring(m, cx, cz, r, 36, 1.4, C(150, 255, 120), 0.32)
	ring(m, cx, cz, r * 0.62, 24, 0.9, C(255, 110, 220), 0.3)
	Kit.Disc(m, cx, cz, 0.3, 10, 0.12, C(150, 255, 160), { Mat = NEON, Transp = 0.3 })
	-- rune spokes and a star
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local p1 = V(cx + math.cos(a) * r * 0.62, 0.25, cz + math.sin(a) * r * 0.62)
		local a2 = a + math.pi * 2 / 6 * 2
		local p2 = V(cx + math.cos(a2) * r * 0.62, 0.25, cz + math.sin(a2) * r * 0.62)
		Props.Beam(m, p1, p2, 0.6, 0.12, C(190, 120, 255), { Mat = NEON })
		local outer = V(cx + math.cos(a) * (r - 3), 0.25, cz + math.sin(a) * (r - 3))
		Kit.Disc(m, outer.X, outer.Z, 0.3, 3, 0.12, C(255, 230, 90), { Mat = NEON })
	end

	-- Edge decorations (outside the radius)
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local px, pz = cx + math.cos(a) * (r + 3.5), cz + math.sin(a) * (r + 3.5)
		if math.abs(px) < 134 and not (px < cx and pz > cz - 10 and pz < cz + 26) then
			if i % 2 == 0 then
				Props.Pumpkin(m, V(px, 0, pz), 3.4, cx - px, cz - pz)
			else
				Kit.Box(m, V(px - 0.6, 0, pz - 0.6), V(px + 0.6, 4, pz + 0.6), C(60, 40, 90))
				Kit.Ball(m, 2, V(px, 5, pz), C(150, 255, 140), { Mat = NEON })
			end
		end
	end
	bleachers(m, cx, cz + r + 4, 1)
	bleachers(m, cx, cz - r - 4, -1)

	-- Entrance arch over the cross street on the west side, sign facing -X (toward the road)
	local ax = cx - r - 5
	for _, sz in { -1, 1 } do
		local pz = cz + 7 + sz * 13
		Kit.Box(m, V(ax - 1.2, 0, pz - 1.2), V(ax + 1.2, 22, pz + 1.2), C(110, 70, 200), { Solid = true })
		Kit.Ball(m, 3, V(ax, 23, pz), C(255, 150, 60), { Mat = NEON })
	end
	local signCF = CFrame.new(ax, 19, cz + 7) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local sign = Kit.Part(m, V(24, 5, 0.8), signCF, C(45, 25, 80))
	Kit.Part(m, V(25, 6, 0.4), signCF * CFrame.new(0, 0, 0.5), C(255, 110, 220), { Mat = NEON })
	Kit.Sign(sign, Enum.NormalId.Front, "👻 GIANT GHOST EVENT 👻", C(255, 230, 90))
	-- second sign facing into the arena from the east wall side
	local sign2CF = CFrame.new(cx + r + 4, 9, cz) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local s2 = Kit.Part(m, V(16, 5, 0.6), sign2CF, C(45, 25, 80))
	Kit.Part(m, V(17, 6, 0.3), sign2CF * CFrame.new(0, 0, 0.4), C(150, 255, 120), { Mat = NEON })
	Kit.Box(m, V(cx + r + 4.6, 0, cz - 0.5), V(cx + r + 5.6, 7, cz + 0.5), C(60, 40, 90))
	Kit.Sign(s2, Enum.NormalId.Front, "GIANT GHOST EVENT", C(150, 255, 140))

	-- lights on two tall poles at the edge
	for _, sz in { -1, 1 } do
		local p = V(cx + r * 0.75, 0, cz + sz * (r + 9))
		Kit.Cyl(m, 26, 1, CFrame.new(p + V(0, 13, 0)), C(60, 40, 90))
		local lamp = Kit.Ball(m, 3, p + V(0, 27, 0), C(255, 160, 230), { Mat = NEON })
		Kit.Light(lamp, C(255, 170, 230), 40, 1.4)
	end
	Kit.Emitter(field, C(200, 140, 255), 2, 9, 0.3)

	Kit.AddCircle(cx, cz, r + 6)
	m.PrimaryPart = field
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Boundary</string>
            <string name="Source"><![CDATA[--!strict
-- Ground slabs (top at Y=0), themed outer walls, the two zone-separation walls and the
-- invisible collision walls up to Y=80 that keep players inside and in front of locked gates.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Boundary = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local INVIS_TOP = 80
local HW = Config.Layout.HalfWidth -- 140

local function invisible(parent: Instance, a: Vector3, b: Vector3)
	local p = Kit.Box(parent, a, b, C(255, 255, 255), { Transp = 1, Solid = true, Name = "InvisibleWall", Shadow = false })
	p.CanQuery = false -- never block taps / ground raycasts
end

local function hedgeRun(f: Instance, a: Vector3, b: Vector3)
	-- a/b: opposite corners of the hedge box (Y 0..14)
	Kit.Box(f, a, b, C(70, 160, 85), { Mat = Enum.Material.Grass, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / 16)
	local greens = { C(80, 175, 90), C(95, 190, 100), C(70, 150, 95) }
	for i = 0, n do
		local t = (i + 0.5) / (n + 1)
		local pos = if alongX
			then V(lo.X + (hi.X - lo.X) * t, hi.Y, (lo.Z + hi.Z) / 2)
			else V((lo.X + hi.X) / 2, hi.Y, lo.Z + (hi.Z - lo.Z) * t)
		Kit.Ball(f, 7.5, pos, Kit.Pick(greens), { Mat = Enum.Material.Grass })
	end
end

local function stoneRun(f: Instance, a: Vector3, b: Vector3, wall: Color3, cap: Color3, topBall: Color3, spacing: number)
	Kit.Box(f, a, b, wall, { Mat = Enum.Material.Cobblestone, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	Kit.Box(f, V(lo.X - 0.5, hi.Y, lo.Z - 0.5), V(hi.X + 0.5, hi.Y + 1.2, hi.Z + 0.5), cap, { Mat = Enum.Material.Slate })
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / spacing)
	for i = 0, n do
		local t = i / math.max(n, 1)
		local cx = if alongX then lo.X + (hi.X - lo.X) * t else (lo.X + hi.X) / 2
		local cz = if alongX then (lo.Z + hi.Z) / 2 else lo.Z + (hi.Z - lo.Z) * t
		local half = if alongX then V(2.5, 0, (hi.Z - lo.Z) / 2 + 1) else V((hi.X - lo.X) / 2 + 1, 0, 2.5)
		Kit.Box(f, V(cx, 0, cz) - half, V(cx, hi.Y + 3, cz) + half, cap, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(f, 2.6, V(cx, hi.Y + 4.3, cz), topBall, { Mat = NEON })
	end
end

local function brickRun(f: Instance, a: Vector3, b: Vector3, spacing: number)
	stoneRun(f, a, b, C(215, 110, 95), C(250, 230, 210), C(200, 130, 255), spacing)
end

function Boundary.Build(map: Instance)
	local f = Kit.Folder(map, "Boundary")
	local W = HW + 6 -- outer face of the visible walls

	-- Ground (top surface Y = 0), wider than the play area so the walls sit on grass.
	Kit.Box(f, V(-190, -4, -100), V(190, 0, 260), C(105, 195, 100), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Neighborhood" })
	Kit.Box(f, V(-190, -4, 260), V(190, 0, 540), C(80, 160, 120), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Cemetery" })
	Kit.Box(f, V(-190, -4, 540), V(190, 0, 920), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_School" })

	-- Neighborhood: hedges (sides + behind spawn)
	hedgeRun(f, V(-W, 0, -66), V(-HW, 14, 260))
	hedgeRun(f, V(HW, 0, -66), V(W, 14, 260))
	hedgeRun(f, V(-W, 0, -66), V(W, 14, -60))
	-- Cemetery: mossy stone with green lantern tops
	stoneRun(f, V(-W, 0, 263), V(-HW, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	stoneRun(f, V(HW, 0, 263), V(W, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	-- School: brick with purple tops (sides + far end)
	brickRun(f, V(-W, 0, 543), V(-HW, 14, 886), 30)
	brickRun(f, V(HW, 0, 543), V(W, 14, 886), 30)
	brickRun(f, V(-W, 0, 880), V(W, 14, 886), 30)

	-- Zone separation walls with the gate opening centred on X = 0.
	for id, gate in Kit.Gates(Config.Layout) do
		local z = gate.Z
		local half = gate.Width / 2
		local h = 18
		if id == "Cemetery" then
			for _, s in { -1, 1 } do
				stoneRun(f, V(s * (half + 8), 0, z - 3), V(s * W, h, z + 3), C(135, 115, 175), C(185, 170, 220), C(255, 160, 60), 24)
			end
		else
			for _, s in { -1, 1 } do
				stoneRun(f, V(s * (half + 8), 0, z - 3), V(s * W, h, z + 3), C(215, 110, 95), C(250, 230, 210), C(200, 130, 255), 24)
			end
		end
		-- glowing band along the wall faces
		for _, s in { -1, 1 } do
			for _, fz in { -1, 1 } do
				Kit.Box(f, V(s * (half + 6), 3, z + fz * 3.05), V(s * (W - 1), 3.6, z + fz * 3.25), if id == "Cemetery" then C(150, 255, 120) else C(200, 120, 255), { Mat = NEON })
			end
			invisible(f, V(s * half, 0, z - 3), V(s * W, INVIS_TOP, z + 3))
		end
		-- above the arch beam (beam fills Y 30..36 of the opening)
		invisible(f, V(-half, 36, z - 3), V(half, INVIS_TOP, z + 3))
		-- pumpkins along the wall top on the approach side
		for i = 1, 4 do
			for _, s in { -1, 1 } do
				local x = s * (half + 12 + i * 26)
				Props.Pumpkin(f, V(x, h + 1.2, z - 1.5), 3.6, 0, -1)
			end
		end
	end

	-- Invisible outer walls (play area is |X| <= 140, Z -60..880)
	invisible(f, V(-W, 0, -66), V(-HW, INVIS_TOP, 886))
	invisible(f, V(HW, 0, -66), V(W, INVIS_TOP, 886))
	invisible(f, V(-W, 0, -66), V(W, INVIS_TOP, -60))
	invisible(f, V(-W, 0, 880), V(W, INVIS_TOP, 886))

	-- Outer scenery: soft purple hills and big trees just beyond the walls.
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i = 0, 9 do
		local z = -40 + i * 95
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 185, -12, z + s * 20), Kit.Pick(hill), { Mat = Enum.Material.Grass })
		end
	end
	for i = 0, 6 do
		local z = -30 + i * 140
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 156, 0, z), 22 + Kit.Rng:NextNumber(0, 10))
		end
	end
end

return Boundary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GHOST HUNTER SIMULATOR: procedural world builder. Call Builder.Build() once at server start.

	Layout (studs, +Z forward; ground top is Y = 0 everywhere walkable; play area |X| <= 140):

	  Z -60 ........ hedge wall behind spawn
	  Z -60..-36     Ghost Hunter HQ building (behind spawn)
	  Z   0          Spawn plaza (SpawnLocation at Config.Layout.Spawn, faces +Z)
	  Z  28          Beginner crate station (X -28, beacon) | Upgrade booth (X +28)
	  Z -36..260     ZONE 1 NEIGHBORHOOD: main road X -10..10 up to the gate, cross street
	                 Z 110..124 east to the Event Arena (95, 110, r32); houses on a 30-stud grid
	                 wherever ghost areas / roads / stations leave room.
	  Z 260          Stone wall + Gate_Cemetery (34-wide opening at X = 0)
	  Z 260..540     ZONE 2 CEMETERY: cobble path X -8..8, Haunted station (X -28, Z 292),
	                 giant mausoleum (X -122..-78, Z 477..513, spire to Y ~66), crypts, graves.
	  Z 540          Brick wall + Gate_School
	  Z 540..600     School courtyard: Elite station (X -28, Z 572), ghost bus, flagpole.
	  Z 600..860     ZONE 3 SCHOOL building (open-topped, see School.luau), clock tower to Y ~104.
	  Z 880 ........ brick wall at the far end.

	Every ghost area circle from Config.Layout.GhostAreas is registered as a keep-out, so no
	prop taller than ~0.3 studs is placed inside one (flat road paint / cracks / rune lines only).
	Instance tree:
	  workspace.Map.{Boundary, Gates, Stations, EventArena, Neighborhood, Cemetery, School}
]]

local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local LightingSetup = require(script.Parent.Lighting)
local Boundary = require(script.Parent.Boundary)
local Gates = require(script.Parent.Gates)
local Stations = require(script.Parent.Stations)
local Arena = require(script.Parent.Arena)
local Neighborhood = require(script.Parent.Neighborhood)
local Cemetery = require(script.Parent.Cemetery)
local School = require(script.Parent.School)

local Builder = {}

local function registerKeepOuts()
	for _, area in Config.Layout.GhostAreas do
		Kit.AddCircle(area.Center.X, area.Center.Z, area.Radius + 1)
	end
	local spawnPos = Config.Layout.Spawn
	Kit.AddCircle(spawnPos.X, spawnPos.Z, 27)
	for _, gate in Kit.Gates(Config.Layout) do
		Kit.AddRect(-30, gate.Z - 24, 30, gate.Z + 24)
	end
end

function Builder.Build()
	local old = Workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	Kit.Reset()
	registerKeepOuts()

	local map: Folder = Instance.new("Folder")
	map.Name = "Map"

	LightingSetup.Apply()
	Boundary.Build(map)
	Gates.Build(map)
	Stations.Build(map)
	Arena.Build(map)
	Neighborhood.Build(map)
	Cemetery.Build(map)
	School.Build(map)

	map.Parent = Workspace
	local s = Kit.Stats
	print(string.format("[GH World] built %d parts, %d lights, %d emitters, %d floating, %d flicker", s.Parts, s.Lights, s.Emitters, s.Floating, s.Flicker))
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Cemetery</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 2: Cemetery (Z 260..540). Cobblestone path along X = 0 from gate to gate, a giant
-- mausoleum in the north-west corner (tall dome + glowing spire, visible from spawn),
-- small crypts, rows of oversized pastel gravestones, twisted trees, lanterns, neon cracks,
-- glowing mushrooms, iron fences and slow purple fog.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Cemetery = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local STONES = { C(190, 180, 230), C(170, 220, 210), C(210, 200, 215), C(180, 200, 240), C(230, 190, 220) }
local EPITAPHS = { "RIP", "BRB", "BOO", "LOL", "GG", "AFK", "R.I.P.\nIN PEACE", "BE BACK\nSOON", "NOT\nHERE" }

-- Gable roof with the ridge along local X (slopes toward local ±Z), bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, { Solid = true, Shadow = true })
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, { Solid = true, Shadow = true })
end

local function mausoleum(f: Instance)
	local m = Kit.Model(f, "Mausoleum")
	local stone, light, roof = C(215, 205, 240), C(240, 235, 255), C(110, 80, 180)
	local glow = C(120, 255, 170)
	-- stepped platform
	Kit.Box(m, V(-122, 0, 477), V(-78, 1.2, 513), C(150, 140, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(-120, 1.2, 479), V(-82, 2.4, 511), C(170, 160, 200), { Mat = Enum.Material.Slate, Solid = true })
	-- body (front faces +X toward the path)
	Kit.Box(m, V(-118, 2.4, 482), V(-90, 26, 508), stone, { Mat = Enum.Material.Slate, Solid = true, Name = "Body" })
	-- portico columns
	for i = 0, 4 do
		local z = 483.5 + i * 5.75
		Kit.Cyl(m, 22, 2.6, CFrame.new(-85.5, 13.4, z), light, { Solid = true, Shadow = true })
		Kit.Box(m, V(-87, 2.4, z - 1.6), V(-84, 3.2, z + 1.6), light)
	end
	-- entablature + cornice
	Kit.Box(m, V(-119, 24.4, 480), V(-83, 27, 510), light, { Solid = true })
	Kit.Box(m, V(-83.3, 25, 483), V(-82.9, 26.4, 507), glow, { Mat = NEON })
	-- pediment roof (triangle face toward +X)
	gable(m, CFrame.new(-101, 27, 495), 37, 31, 9, roof)
	-- glowing doorway
	Kit.Box(m, V(-90.3, 2.4, 487.5), V(-89.9, 17.5, 502.5), light)
	local door = Kit.Box(m, V(-90.1, 2.4, 489), V(-89.6, 16, 501), glow, { Mat = NEON, Transp = 0.1 })
	Kit.Light(door, glow, 30, 2)
	-- name plate on the entablature, facing +X
	local plateCF = CFrame.new(-82.7, 25.7, 495) * CFrame.Angles(0, Kit.FaceYaw(1, 0), 0)
	local plate = Kit.Part(m, V(18, 2.4, 0.4), plateCF, C(60, 40, 100))
	Kit.Sign(plate, Enum.NormalId.Front, "REST IN PURPLE", C(150, 255, 170))
	-- drum + dome + spire (tall: visible from spawn)
	Kit.Cyl(m, 12, 15, CFrame.new(-104, 36, 495), light, { Solid = true, Shadow = true })
	Kit.Cyl(m, 1, 16.5, CFrame.new(-104, 42.2, 495), glow, { Mat = NEON })
	Kit.Ball(m, 15, V(-104, 42.5, 495), C(150, 110, 230), { Shadow = true })
	Kit.Cyl(m, 14, 1.4, CFrame.new(-104, 56, 495), C(240, 220, 120))
	local orb = Kit.Ball(m, 4.5, V(-104, 64, 495), glow, { Mat = NEON })
	Kit.Light(orb, glow, 40, 1.5)
	Kit.Emitter(orb, glow, 2, 4, 0.8)
	-- corner obelisks
	for _, x in { -121, -79 } do
		for _, z in { 476, 514 } do
			Kit.Box(m, V(x - 1.2, 0, z - 1.2), V(x + 1.2, 12, z + 1.2), light, { Solid = true })
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z - 0.6), light)
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z + 0.6) * CFrame.Angles(0, math.pi, 0), light)
			Kit.Ball(m, 1.6, V(x, 14.6, z), glow, { Mat = NEON })
		end
	end
	-- floating candles by the door
	for i = 0, 3 do
		Props.FloatingCandle(m, V(-80, 8 + (i % 2) * 2.5, 486 + i * 6))
	end
	Kit.AddRect(-124, 474, -76, 516)
end

local function crypt(f: Instance, cx: number, cz: number, fx: number, fz: number, flicker: boolean)
	local m = Kit.Model(f, "Crypt")
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = Kit.Pick(STONES)
	Kit.Part(m, V(15, 1, 13), base * CFrame.new(0, 0.5, 0), C(140, 130, 170), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(12, 10, 10), base * CFrame.new(0, 6, 0), stone, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- roof ridge runs front-to-back (local Z) so the triangle faces the front
	gable(m, base * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.pi / 2, 0), 12, 14, 5, C(120, 90, 190))
	local glow = Kit.Pick({ C(120, 255, 170), C(200, 130, 255) })
	local door = Kit.Part(m, V(4.4, 7, 0.4), base * CFrame.new(0, 4.5, -5.1), glow, { Mat = NEON, Transp = 0.15 })
	Kit.Part(m, V(5.6, 8.2, 0.3), base * CFrame.new(0, 4.6, -5.05), C(240, 235, 255))
	Kit.Part(m, V(1, 3.6, 0.6), base * CFrame.new(0, 13.5, -6.3), C(240, 235, 255))
	Kit.Part(m, V(2.6, 1, 0.6), base * CFrame.new(0, 14.2, -6.3), C(240, 235, 255))
	if flicker then
		Kit.Light(door, glow, 16, 1.4, true)
	end
	Props.FloatingCandle(m, (base * CFrame.new(-4, 7.5, -7.5)).Position)
	Kit.AddCircle(cx, cz, 10)
end

local function gravestone(f: Instance, x: number, z: number)
	local rng = Kit.Rng
	local w = rng:NextNumber(3.6, 5.2)
	local h = rng:NextNumber(3.5, 6)
	local yaw = rng:NextNumber(-0.25, 0.25)
	local tilt = rng:NextNumber(-0.08, 0.08)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt, 0, tilt * 0.5)
	local col = Kit.Pick(STONES)
	local kind = rng:NextInteger(1, 6)
	if kind == 6 then
		-- cross
		Kit.Part(f, V(1.4, h + 2, 1), base * CFrame.new(0, (h + 2) / 2, 0), col, { Solid = true })
		Kit.Part(f, V(w * 0.8, 1.2, 1), base * CFrame.new(0, h * 0.75 + 0.6, 0), col)
	else
		local slab = Kit.Part(f, V(w, h, 1.2), base * CFrame.new(0, h / 2, 0), col, { Solid = true, Shadow = true })
		Kit.Part(f, V(1.2, w, w), base * CFrame.new(0, h, 0) * CFrame.Angles(0, math.pi / 2, 0), col, { Shape = Enum.PartType.Cylinder })
		if kind <= 2 then
			Kit.Sign(slab, Enum.NormalId.Front, Kit.Pick(EPITAPHS), C(110, 70, 170), { Stroke = C(255, 255, 255), Font = Enum.Font.GothamBlack })
		elseif kind == 3 then
			Kit.Part(f, V(w * 0.5, 0.3, 0.2), base * CFrame.new(0, h * 0.55, -0.65), C(120, 255, 170), { Mat = NEON })
		end
	end
	-- little dirt mound in front
	Kit.Part(f, V(w + 0.6, 0.4, 3.4), base * CFrame.new(0, 0.1, -2.4), C(120, 95, 130))
	Kit.AddCircle(x, z, 2.5)
end

function Cemetery.Build(map: Instance)
	local f = Kit.Folder(map, "Cemetery")
	local rng = Kit.Rng

	-- main path + branch to the mausoleum
	Kit.Box(f, V(-8, -0.4, 260), V(8, 0.1, 540), C(165, 150, 190), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "Path" })
	Kit.Box(f, V(-80, -0.4, 490), V(-8, 0.08, 500), C(165, 150, 190), { Mat = Enum.Material.Cobblestone, Solid = true })
	for z = 270, 530, 20 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 8, 0.1, z), V(s * 8.6, 0.25, z + 10), C(120, 255, 170), { Mat = NEON })
		end
	end
	Kit.AddRect(-9, 260, 9, 540, true)
	Kit.AddRect(-80, 489, -8, 501, true)

	mausoleum(f)
	crypt(f, 112, 300, -1, 0, true)
	crypt(f, -110, 345, 1, 0, true)
	crypt(f, 116, 500, -1, 0, false)
	crypt(f, -116, 392, 1, 0, false)

	-- lanterns along the path
	local lit = 0
	for z = 280, 530, 30 do
		for _, s in { -1, 1 } do
			local x = s * 10.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				Props.Lantern(f, V(x, 0, z), if s < 0 then C(140, 255, 170) else C(200, 140, 255), lit % 3 == 1 and lit <= 10)
				Kit.AddCircle(x, z, 1.5)
			end
		end
	end

	-- twisted trees (tall ones near the back so they show over the wall from spawn)
	local treeSpots = {
		{ -125, 280, 26 }, { 126, 285, 24 }, { -100, 300, 30 }, { 45, 292, 22 }, { -30, 380, 26 }, { 110, 410, 30 },
		{ 128, 430, 34 }, { -128, 455, 36 }, { 30, 470, 28 }, { 100, 470, 34 }, { -60, 522, 38 }, { 60, 525, 40 },
		{ -128, 525, 34 }, { 128, 525, 36 },
	}
	for _, t in treeSpots do
		if Kit.IsFree(t[1], t[2], 4) then
			Props.TwistedTree(f, V(t[1], 0, t[2]), t[3])
		end
	end

	-- gravestone field on a jittered grid
	for gx = -128, 128, 11 do
		for gz = 272, 532, 12 do
			local x = gx + rng:NextNumber(-2, 2)
			local z = gz + rng:NextNumber(-2, 2)
			if rng:NextNumber() < 0.45 and Kit.IsFree(x, z, 3.2) then
				gravestone(f, x, z)
			end
		end
	end

	-- iron fences around the mausoleum yard and a few decorative runs
	Props.Fence(f, V(-126, 0, 472), V(-84, 0, 472), "iron")
	Props.Fence(f, V(-126, 0, 518), V(-84, 0, 518), "iron")
	Props.Fence(f, V(-133, 0, 300), V(-133, 0, 330), "iron")
	Props.Fence(f, V(133, 0, 330), V(133, 0, 360), "iron")

	-- neon ectoplasm cracks in the ground (flat, fine inside ghost areas)
	for _ = 1, 16 do
		local p = V(rng:NextNumber(-120, 120), 0.1, rng:NextNumber(275, 530))
		local a = rng:NextNumber(0, math.pi * 2)
		for _ = 1, 3 do
			a += rng:NextNumber(-1, 1)
			local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(3, 6)
			Props.Beam(f, p, q, 0.5, 0.12, C(120, 255, 170), { Mat = NEON })
			p = q
		end
	end

	-- glowing mushrooms
	local shrooms = 0
	for _ = 1, 200 do
		if shrooms >= 14 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(270, 530)
		if Kit.IsFree(x, z, 2.5) then
			shrooms += 1
			Props.Mushrooms(f, V(x, 0, z))
			Kit.AddCircle(x, z, 2.5)
		end
	end

	-- slow purple fog
	for _, p in { V(-40, 0, 300), V(40, 0, 395), V(-95, 0, 470), V(95, 0, 330), V(30, 0, 520) } do
		Props.Wisp(f, p, C(170, 110, 255), 14, true)
	end
	for _, p in { V(-60, 0, 360), V(80, 0, 500), V(-20, 0, 460) } do
		Props.Wisp(f, p, C(120, 255, 170), 10, false)
	end
end

return Cemetery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Gates</string>
            <string name="Source"><![CDATA[--!strict
-- Zone gates: workspace.Map.Gates.Gate_<ZoneId> with Barrier, Arch, PromptAnchor and Sign
-- (TextLabel "CostLabel" on the sign's Front face, which faces the approaching player at -Z).

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Gates = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

type Theme = { Stone: Color3, Trim: Color3, Barrier: Color3, Lamp: Color3 }

local THEMES: { [string]: Theme } = {
	Cemetery = { Stone = C(150, 125, 200), Trim = C(140, 255, 120), Barrier = C(170, 90, 255), Lamp = C(140, 255, 160) },
	School = { Stone = C(225, 120, 100), Trim = C(210, 120, 255), Barrier = C(110, 255, 170), Lamp = C(220, 150, 255) },
}

local function buildGate(folder: Instance, id: string, z: number, width: number)
	local zone = Config.ZoneById[id]
	local theme = THEMES[id] or THEMES.Cemetery
	local half = width / 2
	local m = Kit.Model(folder, "Gate_" .. id)

	-- Barrier: fills the opening. Other code toggles collision locally and tweens it.
	local barrier = Kit.Part(m, V(width, 30, 2), CFrame.new(0, 15, z), theme.Barrier, {
		Name = "Barrier",
		Mat = NEON,
		Transp = 0.4,
		Solid = true,
		Shadow = false,
	})
	barrier.CanQuery = false
	barrier.CanTouch = true

	-- Arch around the opening (never inside it).
	local arch = Kit.Model(m, "Arch")
	local pw = 8 -- pillar width
	for _, s in { -1, 1 } do
		local x1, x2 = s * half, s * (half + pw)
		Kit.Box(arch, V(x1, 0, z - 5), V(x2, 32, z + 5), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(arch, V(s * (half + 0.01), 0, z - 6), V(s * (half + pw + 1), 3, z + 6), theme.Stone:Lerp(Color3.new(0, 0, 0), 0.2), { Mat = Enum.Material.Slate, Solid = true })
		-- glowing trims on the pillar fronts (both sides)
		for _, fz in { -1, 1 } do
			for _, ex in { 0.6, pw - 0.6 } do
				local x = s * (half + ex)
				Kit.Box(arch, V(x - 0.3, 3, z + fz * 5), V(x + 0.3, 30, z + fz * 5.3), theme.Trim, { Mat = NEON })
			end
		end
		-- pumpkin on top of each pillar
		Props.Pumpkin(arch, V(s * (half + pw / 2), 36, z), 6.5, 0, -1)
		-- hanging lantern on the approach side
		local lx = s * (half + pw / 2)
		Kit.Box(arch, V(lx - 0.3, 24, z - 5.8), V(lx + 0.3, 26, z - 5), C(50, 40, 70))
		local lamp = Kit.Box(arch, V(lx - 1.1, 21, z - 6.8), V(lx + 1.1, 24, z - 4.6), theme.Lamp, { Mat = NEON })
		Kit.Light(lamp, theme.Lamp, 22, 1.6)
	end
	-- top beam (Y 30..36) spanning the opening above the barrier
	Kit.Box(arch, V(-(half + pw + 1), 30, z - 4), V(half + pw + 1, 36, z + 4), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
	for _, fz in { -1, 1 } do
		Kit.Box(arch, V(-(half + pw + 1), 30, z + fz * 4), V(half + pw + 1, 30.6, z + fz * 4.3), theme.Trim, { Mat = NEON })
	end
	-- crenellations
	for i = -2, 2 do
		local x = i * 9
		Kit.Box(arch, V(x - 2, 36, z - 3), V(x + 2, 38, z + 3), theme.Stone, { Mat = Enum.Material.Slate })
	end
	-- skull centrepiece on the approach face
	Props.Skull(arch, V(0, 33, z - 5), 4.5, 0, -1)
	-- low wisps either side of the opening
	Props.Wisp(arch, V(-(half + 5), 0, z - 9), theme.Barrier, 10, false)
	Props.Wisp(arch, V(half + 5, 0, z - 9), theme.Barrier, 10, false)

	-- Sign above the arch, Front face (-Z) toward players coming from the previous zone.
	local sign = Kit.Part(m, V(40, 10, 1), CFrame.new(0, 43, z - 3), C(45, 25, 80), { Name = "Sign" })
	Kit.Part(arch, V(42, 12, 0.6), CFrame.new(0, 43, z - 2.3), theme.Trim, { Mat = NEON })
	local gui = Kit.Gui(sign, Enum.NormalId.Front, 30)
	Kit.Label(gui, zone.Name, zone.Accent, {
		Name = "ZoneLabel",
		Pos = UDim2.fromScale(0.03, 0.04),
		Size = UDim2.fromScale(0.94, 0.5),
	})
	Kit.Label(gui, "🔒 " .. Kit.Comma(zone.Cost) .. " ECTOPLASM", C(150, 255, 140), {
		Name = "CostLabel",
		Pos = UDim2.fromScale(0.08, 0.56),
		Size = UDim2.fromScale(0.84, 0.38),
	})

	-- Prompt anchor on the near side.
	Kit.Part(m, V(1, 1, 1), CFrame.new(0, 4, z - 6), C(255, 255, 255), { Name = "PromptAnchor", Transp = 1 })

	m.PrimaryPart = barrier
end

function Gates.Build(map: Instance)
	local folder = Kit.Folder(map, "Gates")
	for id, g in Kit.Gates(Config.Layout) do
		buildGate(folder, id, g.Z, g.Width)
	end
end

return Gates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Part helpers for the procedural map. Every builder goes through these so that parts
-- get the same performance defaults (anchored, non-colliding, no touch/query, no shadow)
-- unless `Solid = true` is passed for floors, walls and buildings.
-- Also holds the seeded RNG, budgets (lights, emitters, tagged props) and a keep-out
-- registry so scattered props never land inside ghost areas, roads or stations.

local CollectionService = game:GetService("CollectionService")

local Kit = {}

export type Opts = {
	Name: string?,
	Mat: Enum.Material?,
	Transp: number?,
	Solid: boolean?, -- CanCollide + CanQuery (+ shadow)
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Refl: number?,
}

Kit.Rng = Random.new(42)

Kit.Stats = { Parts = 0, Lights = 0, Emitters = 0, Floating = 0, Flicker = 0 }
local MAX_LIGHTS = 40
local MAX_EMITTERS = 20
local MAX_FLOATING = 40
local MAX_FLICKER = 12

local NO_OPTS: Opts = {}

local function apply(p: BasePart, size: Vector3, cf: CFrame, color: Color3, opts: Opts?)
	local o: Opts = opts or NO_OPTS
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.Mat or Enum.Material.SmoothPlastic
	p.Transparency = o.Transp or 0
	p.Reflectance = o.Refl or 0
	local solid = o.Solid == true
	p.CanCollide = solid
	p.CanQuery = solid
	p.CanTouch = false
	if o.Shadow ~= nil then
		p.CastShadow = o.Shadow
	else
		p.CastShadow = solid
	end
	if o.Name then
		p.Name = o.Name
	end
	Kit.Stats.Parts += 1
end

-- Block (or Ball/Cylinder via opts.Shape) at an arbitrary CFrame.
function Kit.Part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	apply(p, size, cf, color, opts)
	p.Parent = parent
	return p
end

-- Axis-aligned block from two corners.
function Kit.Box(parent: Instance, a: Vector3, b: Vector3, color: Color3, opts: Opts?): Part
	local lo = a:Min(b)
	local hi = a:Max(b)
	return Kit.Part(parent, hi - lo, CFrame.new((lo + hi) / 2), color, opts)
end

-- WedgePart: the slope faces local -Z (low edge at -Z, tall face at +Z).
function Kit.Wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): WedgePart
	local w: WedgePart = Instance.new("WedgePart")
	apply(w, size, cf, color, opts)
	w.Parent = parent
	return w
end

function Kit.Ball(parent: Instance, d: number, pos: Vector3, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	apply(p, Vector3.new(d, d, d), CFrame.new(pos), color, opts)
	p.Parent = parent
	return p
end

-- Vertical cylinder centred at cf.
function Kit.Cyl(parent: Instance, height: number, d: number, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	apply(p, Vector3.new(height, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, opts)
	p.Parent = parent
	return p
end

-- Flat vertical cylinder whose TOP surface is at topY.
function Kit.Disc(parent: Instance, x: number, z: number, topY: number, d: number, thick: number, color: Color3, opts: Opts?): Part
	return Kit.Cyl(parent, thick, d, CFrame.new(x, topY - thick / 2, z), color, opts)
end

-- Cylinder lying along the world axis given by `along` ("X" or "Z").
function Kit.CylFlat(parent: Instance, length: number, d: number, pos: Vector3, along: string, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	local cf = CFrame.new(pos)
	if along == "Z" then
		cf *= CFrame.Angles(0, math.pi / 2, 0)
	end
	apply(p, Vector3.new(length, d, d), cf, color, opts)
	p.Parent = parent
	return p
end

function Kit.Folder(parent: Instance, name: string): Folder
	local f: Folder = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.Model(parent: Instance, name: string): Model
	local m: Model = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Yaw (radians) that turns a part's local -Z (its Front face) toward world (dx, dz).
function Kit.FaceYaw(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

function Kit.Comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	while true do
		local replaced, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if k == 0 then
			break
		end
	end
	return out
end

--==================================================================
-- GUI
--==================================================================
function Kit.Gui(part: BasePart, face: Enum.NormalId, pps: number?): SurfaceGui
	local g: SurfaceGui = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps or 40
	g.LightInfluence = 0
	g.Brightness = 1.5
	g.ZOffset = 1
	g.ResetOnSpawn = false
	g.Parent = part
	return g
end

export type LabelOpts = {
	Name: string?,
	Pos: UDim2?,
	Size: UDim2?,
	Font: Enum.Font?,
	Stroke: Color3?,
	Rotation: number?,
}

local NO_LABEL: LabelOpts = {}

function Kit.Label(gui: GuiBase2d, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local o: LabelOpts = opts or NO_LABEL
	local t: TextLabel = Instance.new("TextLabel")
	t.Name = o.Name or "Label"
	t.BackgroundTransparency = 1
	t.Position = o.Pos or UDim2.fromScale(0, 0)
	t.Size = o.Size or UDim2.fromScale(1, 1)
	t.Font = o.Font or Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Rotation = o.Rotation or 0
	local stroke: UIStroke = Instance.new("UIStroke")
	stroke.Color = o.Stroke or Color3.fromRGB(40, 20, 70)
	stroke.Thickness = 3
	stroke.Parent = t
	t.Parent = gui
	return t
end

-- Whole-face sign on a part.
function Kit.Sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local g = Kit.Gui(part, face)
	return Kit.Label(g, text, color, opts)
end

--==================================================================
-- EFFECTS (budgeted)
--==================================================================
function Kit.Light(part: BasePart, color: Color3, range: number, brightness: number, flicker: boolean?): PointLight?
	if Kit.Stats.Lights >= MAX_LIGHTS then
		return nil
	end
	Kit.Stats.Lights += 1
	local l: PointLight = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
	if flicker and Kit.Stats.Flicker < MAX_FLICKER then
		Kit.Stats.Flicker += 1
		CollectionService:AddTag(part, "FlickerLight")
	end
	return l
end

function Kit.Emitter(part: BasePart, color: Color3, rate: number, size: number?, speed: number?): ParticleEmitter?
	if Kit.Stats.Emitters >= MAX_EMITTERS then
		return nil
	end
	Kit.Stats.Emitters += 1
	local e: ParticleEmitter = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(4, 7)
	e.Speed = NumberRange.new(speed or 0.6, (speed or 0.6) * 2)
	e.SpreadAngle = Vector2.new(180, 15)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-15, 15)
	local s = size or 6
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s * 0.5),
		NumberSequenceKeypoint.new(0.5, s),
		NumberSequenceKeypoint.new(1, s * 1.2),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.75),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Acceleration = Vector3.new(0, 0.15, 0)
	e.Parent = part
	return e
end

-- Tag a single anchored part as a client-animated floating prop.
function Kit.Float(part: BasePart, bob: number): boolean
	if Kit.Stats.Floating >= MAX_FLOATING then
		return false
	end
	Kit.Stats.Floating += 1
	part:SetAttribute("BobHeight", bob)
	CollectionService:AddTag(part, "FloatingProp")
	return true
end

--==================================================================
-- KEEP-OUT REGISTRY (2D, X/Z)
--==================================================================
type Circle = { X: number, Z: number, R: number }
type Rect = { X1: number, Z1: number, X2: number, Z2: number, Road: boolean }

local circles: { Circle } = {}
local rects: { Rect } = {}

function Kit.ResetKeepOut()
	table.clear(circles)
	table.clear(rects)
end

-- Fresh RNG, budgets and keep-out map (so rebuilding gives the identical map).
function Kit.Reset()
	Kit.Rng = Random.new(42)
	Kit.Stats.Parts = 0
	Kit.Stats.Lights = 0
	Kit.Stats.Emitters = 0
	Kit.Stats.Floating = 0
	Kit.Stats.Flicker = 0
	Kit.ResetKeepOut()
end

function Kit.AddCircle(x: number, z: number, r: number)
	table.insert(circles, { X = x, Z = z, R = r })
end

function Kit.AddRect(x1: number, z1: number, x2: number, z2: number, road: boolean?)
	table.insert(rects, {
		X1 = math.min(x1, x2),
		Z1 = math.min(z1, z2),
		X2 = math.max(x1, x2),
		Z2 = math.max(z1, z2),
		Road = road == true,
	})
end

-- True when a circle of radius r at (x, z) touches no keep-out and stays inside the play area.
function Kit.IsFree(x: number, z: number, r: number, ignoreRoads: boolean?): boolean
	if math.abs(x) + r > 136 then
		return false
	end
	for _, c in circles do
		local dx, dz = x - c.X, z - c.Z
		if dx * dx + dz * dz < (c.R + r) * (c.R + r) then
			return false
		end
	end
	for _, q in rects do
		if not (ignoreRoads and q.Road) then
			if x + r > q.X1 and x - r < q.X2 and z + r > q.Z1 and z - r < q.Z2 then
				return false
			end
		end
	end
	return true
end

export type GateLayout = { Z: number, Width: number }

-- Typed views of Config.Layout tables (iterating a table literal yields unknown in strict mode).
function Kit.Gates(layout: any): { [string]: GateLayout }
	return layout.Gates
end

function Kit.CrateStations(layout: any): { [string]: Vector3 }
	return layout.CrateStations
end

function Kit.Pick<T>(list: { T }): T
	return list[Kit.Rng:NextInteger(1, #list)]
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
-- Night-but-bright lighting: purple haze, big moon, bloom on the neon, punchy colours.

local LightingService = game:GetService("Lighting")

local LightingSetup = {}

local function clear(name: string)
	local old = LightingService:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

function LightingSetup.Apply()
	local L = LightingService
	L.ClockTime = 0.5
	L.GeographicLatitude = 20
	L.Brightness = 2.5
	L.Ambient = Color3.fromRGB(150, 120, 200)
	L.OutdoorAmbient = Color3.fromRGB(160, 140, 210)
	L.ColorShift_Top = Color3.fromRGB(170, 140, 255)
	L.ColorShift_Bottom = Color3.fromRGB(60, 30, 90)
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.4
	L.GlobalShadows = true
	L.ShadowSoftness = 0.4
	L.ExposureCompensation = 0.15
	L.FogEnd = 100000

	for _, child in L:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "GHSky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 24
	sky.SunAngularSize = 10
	sky.Parent = L

	local atmo = Instance.new("Atmosphere")
	atmo.Name = "GHAtmosphere"
	atmo.Density = 0.3
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(190, 150, 255)
	atmo.Decay = Color3.fromRGB(110, 70, 180)
	atmo.Glare = 0.4
	atmo.Haze = 1.4
	atmo.Parent = L

	clear("GHBloom")
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GHBloom"
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 1.4
	bloom.Parent = L

	clear("GHColor")
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GHColor"
	cc.Saturation = 0.25
	cc.Contrast = 0.1
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(255, 245, 255)
	cc.Parent = L

	clear("GHSunRays")
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "GHSunRays"
	rays.Intensity = 0.06
	rays.Spread = 0.7
	rays.Parent = L
end

return LightingSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Neighborhood</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 1: Haunted Neighborhood (Z -60..260). Spawn plaza + Ghost Hunter HQ at the south end,
-- a main road along X = 0 to the Cemetery gate, a cross street at Z 110..124 leading east to
-- the event arena, and candy-coloured houses placed on a grid wherever the keep-out map allows.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Neighborhood = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local WALLS = {
	C(255, 170, 200), C(170, 220, 255), C(255, 225, 140), C(190, 255, 190), C(215, 180, 255),
	C(255, 190, 140), C(150, 240, 225), C(255, 150, 150),
}
local ROOFS = { C(120, 60, 170), C(60, 120, 190), C(200, 70, 110), C(70, 150, 110), C(230, 110, 50), C(90, 70, 160) }
local WINDOWS = { C(255, 235, 120), C(150, 255, 140), C(205, 140, 255), C(255, 200, 90) }
local DOORS = { C(140, 70, 200), C(255, 110, 70), C(60, 170, 150), C(230, 70, 120) }
local TRIM = C(255, 250, 245)

--==================================================================
-- HOUSE
--==================================================================
local function window(m: Instance, cf: CFrame, glow: Color3)
	Kit.Part(m, V(4, 4, 0.3), cf, TRIM)
	Kit.Part(m, V(3.2, 3.2, 0.3), cf * CFrame.new(0, 0, -0.12), glow, { Mat = NEON })
end

local function house(parent: Instance, cx: number, cz: number, fx: number, fz: number)
	local rng = Kit.Rng
	local W = rng:NextInteger(18, 23) -- along local X
	local D = rng:NextInteger(15, 19) -- along local Z (front = -Z)
	local twoStory = rng:NextNumber() < 0.35
	local H = if twoStory then 20 else 13
	local RH = math.floor(W * 0.38)
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local m = Kit.Model(parent, "House")
	local wall = Kit.Pick(WALLS)
	local roof = Kit.Pick(ROOFS)
	local glow = Kit.Pick(WINDOWS)

	Kit.Part(m, V(W + 0.8, 1.2, D + 0.8), base * CFrame.new(0, 0.6, 0), C(150, 130, 170), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(W, H, D), base * CFrame.new(0, H / 2, 0), wall, { Solid = true, Shadow = true, Name = "Body" })
	-- corner trims (front)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.9, H, 0.9), base * CFrame.new(sx * W / 2, H / 2, -D / 2), TRIM)
	end
	-- gable roof: two wedges meeting at the ridge (ridge along local X)
	local half = D / 2 + 1.5
	Kit.Part(m, V(W + 2.4, 0.6, D + 3.4), base * CFrame.new(0, H + 0.3, 0), TRIM)
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, -half / 2), roof, { Solid = true, Shadow = true })
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, half / 2) * CFrame.Angles(0, math.pi, 0), roof, { Solid = true, Shadow = true })
	-- chimney poking through the back slope
	local chX = (if rng:NextNumber() < 0.5 then -1 else 1) * W * 0.28
	Kit.Part(m, V(2.4, RH + 2.5, 2.4), base * CFrame.new(chX, H + (RH + 2.5) / 2 + 0.6, D * 0.22), C(190, 110, 100), { Shadow = true })
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(chX, H + RH + 3.4, D * 0.22), C(90, 70, 110))
	if rng:NextNumber() < 0.25 then
		Kit.Ball(m, 2.2, (base * CFrame.new(chX, H + RH + 5, D * 0.22)).Position, C(150, 255, 160), { Mat = NEON, Transp = 0.5 })
	end
	-- front windows
	local rows: { number } = if twoStory then { H * 0.3, H * 0.72 } else { H * 0.5 }
	for _, wy in rows do
		for _, sx in { -1, 1 } do
			window(m, base * CFrame.new(sx * W * 0.28, wy, -D / 2 - 0.15), glow)
		end
	end
	if twoStory then
		window(m, base * CFrame.new(0, H * 0.72, -D / 2 - 0.15), Kit.Pick(WINDOWS))
	end
	-- side windows
	for _, sx in { -1, 1 } do
		window(m, base * CFrame.new(sx * (W / 2 + 0.15), H * 0.5, 0) * CFrame.Angles(0, -sx * math.pi / 2, 0), glow)
	end
	-- door
	Kit.Part(m, V(5, 8, 0.3), base * CFrame.new(0, 4.6, -D / 2 - 0.1), TRIM)
	Kit.Part(m, V(4, 7, 0.4), base * CFrame.new(0, 4.4, -D / 2 - 0.2), Kit.Pick(DOORS))
	Kit.Ball(m, 0.6, (base * CFrame.new(1.3, 4.2, -D / 2 - 0.5)).Position, C(255, 215, 80), { Mat = NEON })
	-- porch with a little roof
	local pw = W * 0.6
	Kit.Part(m, V(pw, 0.8, 5), base * CFrame.new(0, 0.4, -D / 2 - 2.5), C(170, 120, 85), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local porchTop = if twoStory then 9.5 else 9.2
	Kit.Part(m, V(pw + 0.6, 0.5, 5.6), base * CFrame.new(0, porchTop + 0.25, -D / 2 - 2.8), roof)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, porchTop - 0.8, 0.6), base * CFrame.new(sx * (pw / 2 - 0.4), 0.8 + (porchTop - 0.8) / 2, -D / 2 - 5), TRIM)
	end
	if rng:NextNumber() < 0.55 then
		local p = base * CFrame.new(pw * 0.32, 0.8, -D / 2 - 3.2)
		local front = base.LookVector
		Props.Pumpkin(m, p.Position, 2.4, front.X, front.Z)
	end

	-- yard extras (only where the keep-out map allows)
	local function free(lx: number, lz: number, r: number): boolean
		local p = (base * CFrame.new(lx, 0, lz)).Position
		return Kit.IsFree(p.X, p.Z, r)
	end
	local yard = -D / 2 - 9
	if rng:NextNumber() < 0.45 and free(-W / 2 - 1, yard, 1) and free(W / 2 + 1, yard, 1) then
		local a1 = (base * CFrame.new(-W / 2 - 1, 0, yard)).Position
		local a2 = (base * CFrame.new(-2.5, 0, yard)).Position
		local b1 = (base * CFrame.new(2.5, 0, yard)).Position
		local b2 = (base * CFrame.new(W / 2 + 1, 0, yard)).Position
		Props.Fence(m, a1, a2, "picket")
		Props.Fence(m, b1, b2, "picket")
	elseif free(-W / 2 + 1, yard + 1, 1.5) then
		-- mailbox
		local mp = base * CFrame.new(-W / 2 + 1, 0, yard + 1)
		Kit.Part(m, V(0.5, 3.4, 0.5), mp * CFrame.new(0, 1.7, 0), C(110, 80, 60))
		Kit.Part(m, V(1.4, 1.3, 2.2), mp * CFrame.new(0, 3.9, 0), Kit.Pick(DOORS))
		Kit.Part(m, V(0.15, 1.2, 0.4), mp * CFrame.new(0.8, 4.4, 0.6), C(255, 70, 90))
	end
	if rng:NextNumber() < 0.3 then
		Props.FloatingPumpkin(m, (base * CFrame.new(-pw * 0.3, 11 + rng:NextNumber(0, 3), -D / 2 - 6)).Position)
	end
	Kit.AddCircle(cx, cz, math.max(W, D) / 2 + 4)
end

--==================================================================
-- SPAWN PLAZA + HQ
--==================================================================
local function chevron(parent: Instance, tip: Vector3, dir: Vector3, color: Color3)
	local perp = V(-dir.Z, 0, dir.X)
	for _, s in { -1, 1 } do
		local arm = (-dir + perp * s).Unit
		local center = tip + arm * 2
		Kit.Part(parent, V(1, 0.15, 4.6), CFrame.lookAt(center, center + arm), color, { Mat = NEON })
	end
end

local function plaza(f: Instance)
	local spawnPos = Config.Layout.Spawn
	local sx, sz = spawnPos.X, spawnPos.Z
	Kit.Disc(f, sx, sz, 0.25, 52, 0.6, C(175, 150, 220), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.Disc(f, sx, sz, 0.35, 44, 0.2, C(150, 255, 140), { Mat = NEON })
	Kit.Disc(f, sx, sz, 0.42, 42, 0.3, C(120, 95, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Disc(f, sx, sz, 0.5, 20, 0.2, C(210, 120, 255), { Mat = NEON, Transp = 0.3 })

	local spawn: SpawnLocation = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(14, 1, 14)
	-- top surface at Y = 1.1; face +Z (forward)
	spawn.CFrame = CFrame.new(sx, 0.6, sz) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = C(130, 70, 220)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.CanCollide = true
	spawn.CanQuery = true
	spawn.CanTouch = true
	spawn.CastShadow = false
	spawn.Parent = f
	Kit.Stats.Parts += 1
	local g = Kit.Gui(spawn, Enum.NormalId.Top, 20)
	Kit.Label(g, "👻", C(255, 255, 255), { Pos = UDim2.fromScale(0.15, 0.15), Size = UDim2.fromScale(0.7, 0.7) })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(sx - 7.4, 0.4, sz + s * 7) - V(0, 0, 0.4), V(sx + 7.4, 1.3, sz + s * 7) + V(0, 0, 0.4), C(150, 255, 140), { Mat = NEON })
		Kit.Box(f, V(sx + s * 7, 0.4, sz - 7) - V(0.4, 0, 0), V(sx + s * 7, 1.3, sz + 7) + V(0.4, 0, 0), C(150, 255, 140), { Mat = NEON })
	end

	-- plaza lamps on the rim
	for i, a in { 45, 135, 225, 315 } do
		local r = math.rad(a)
		Props.StreetLamp(f, V(sx + math.cos(r) * 23, 0.25, sz + math.sin(r) * 23), C(200, 140, 255), i <= 2)
	end

	-- guide chevrons to the Beginner crate and the upgrade booth
	local beg = Config.Layout.CrateStations.Beginner
	local up = Config.Layout.UpgradeStation
	for _, target in { beg, up } do
		local dir = (V(target.X, 0, target.Z) - V(sx, 0, sz)).Unit
		for i = 1, 3 do
			chevron(f, V(sx, 0.55, sz) + dir * (8 + i * 4.5), dir, if target == beg then C(255, 180, 60) else C(90, 210, 255))
		end
	end
	-- signpost straight ahead of spawn
	local post = V(sx, 0, sz + 19)
	Kit.Box(f, post - V(0.4, 0, 0.4), post + V(0.4, 11, 0.4), C(110, 80, 60))
	local boards = {
		{ Y = 10, Off = 0, Text = "👻 GHOSTS AHEAD", Col = C(150, 255, 140) },
		-- the player faces +Z, so -X is on their right
		{ Y = 7.6, Off = -3, Text = "CRATES ▶", Col = C(255, 190, 70) },
		{ Y = 5.2, Off = 3, Text = "◀ UPGRADES", Col = C(110, 220, 255) },
	}
	for _, b in boards do
		Props.SignBoard(f, post + V(b.Off, b.Y, -0.6), 8, 2, 0, -1, b.Text, C(50, 30, 85), b.Col)
	end
end

local function hq(f: Instance)
	local purple, dark = C(120, 75, 210), C(60, 40, 110)
	Kit.Box(f, V(-24, 0, -58), V(24, 16, -40), purple, { Solid = true, Name = "HQ" })
	Kit.Box(f, V(-26, 16, -60), V(26, 17.5, -38), dark, { Solid = true })
	Kit.Ball(f, 18, V(0, 17.5, -50), C(190, 160, 255), { Shadow = true })
	Kit.Box(f, V(-24.3, 5.6, -39.9), V(24.3, 6.4, -39.6), C(150, 255, 140), { Mat = NEON })
	Kit.Box(f, V(-24.3, 15, -39.9), V(24.3, 15.6, -39.6), C(255, 150, 60), { Mat = NEON })
	-- big glowing door
	Kit.Box(f, V(-7, 0, -39.85), V(7, 12, -39.6), TRIM)
	Kit.Box(f, V(-6, 0, -39.7), V(6, 11, -39.35), C(150, 255, 160), { Mat = NEON, Transp = 0.15 })
	-- windows
	for _, x in { -17, -11, 11, 17 } do
		Kit.Box(f, V(x - 2, 8, -39.8), V(x + 2, 12.5, -39.4), C(255, 235, 120), { Mat = NEON })
	end
	-- sign facing +Z (toward spawn)
	local signCF = CFrame.new(0, 21.5, -39) * CFrame.Angles(0, Kit.FaceYaw(0, 1), 0)
	local sign = Kit.Part(f, V(32, 6, 1), signCF, C(45, 25, 80))
	Kit.Part(f, V(33.5, 7.5, 0.5), signCF * CFrame.new(0, 0, 0.6), C(150, 255, 140), { Mat = NEON })
	Kit.Sign(sign, Enum.NormalId.Front, "GHOST HUNTER HQ", C(255, 230, 90))
	-- antenna + dish
	Kit.Cyl(f, 18, 0.8, CFrame.new(16, 26.5, -50), C(200, 200, 220))
	local orb = Kit.Ball(f, 2.6, V(16, 36, -50), C(255, 90, 160), { Mat = NEON })
	Kit.Light(orb, C(255, 120, 190), 30, 1.2)
	Kit.Cyl(f, 0.8, 9, CFrame.new(-16, 21, -50) * CFrame.Angles(math.rad(35), 0, 0), C(230, 230, 245))
	Kit.Cyl(f, 3, 1, CFrame.new(-16, 19, -50), C(150, 150, 170))
	-- containment tanks with captured ghosts
	for _, s in { -1, 1 } do
		local x = s * 30
		Kit.Cyl(f, 1, 9, CFrame.new(x, 0.5, -46), dark, { Solid = true })
		local tank = Kit.Cyl(f, 12, 8, CFrame.new(x, 7, -46), C(130, 255, 170), { Mat = NEON, Transp = 0.6 })
		Kit.Cyl(f, 1, 9, CFrame.new(x, 13.5, -46), dark)
		Kit.Ball(f, 3.6, V(x, 7.5, -46), C(240, 245, 255))
		Kit.Emitter(tank, C(150, 255, 180), 2, 2, 0.5)
	end
	Kit.AddRect(-36, -60, 36, -36)
end

--==================================================================
-- ROADS
--==================================================================
local function roads(f: Instance)
	local asphalt = C(80, 65, 110)
	local walk = C(200, 185, 230)
	-- main road X -10..10 from HQ to the gate
	Kit.Box(f, V(-10, -0.4, -36), V(10, 0.1, 260), asphalt, { Solid = true, Name = "MainRoad" })
	for z = 34, 250, 12 do
		Kit.Box(f, V(-0.4, 0.1, z), V(0.4, 0.14, z + 6), C(255, 210, 80))
	end
	-- cross street toward the arena
	Kit.Box(f, V(-136, -0.4, 110), V(63, 0.06, 124), asphalt, { Solid = true, Name = "CrossStreet" })
	for x = -130, 55, 12 do
		if x < -16 or x > 14 then
			Kit.Box(f, V(x, 0.06, 116.6), V(x + 6, 0.1, 117.4), C(255, 210, 80))
		end
	end
	-- sidewalks
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, -0.4, 26), V(s * 14, 0.22, 106), walk, { Solid = true })
		Kit.Box(f, V(s * 10, -0.4, 128), V(s * 14, 0.22, 257), walk, { Solid = true })
		Kit.Box(f, V(-136, -0.4, if s < 0 then 106 else 124), V(-14, 0.22, if s < 0 then 110 else 128), walk, { Solid = true })
		Kit.Box(f, V(14, -0.4, if s < 0 then 106 else 124), V(61, 0.22, if s < 0 then 110 else 128), walk, { Solid = true })
	end
	Kit.AddRect(-14, -36, 14, 260, true)
	Kit.AddRect(-136, 106, 63, 128, true)
end

--==================================================================
-- BUILD
--==================================================================
function Neighborhood.Build(map: Instance)
	local f = Kit.Folder(map, "Neighborhood")
	local rng = Kit.Rng

	plaza(f)
	hq(f)
	roads(f)

	-- Houses on a grid; each faces the main road.
	local houses = Kit.Folder(f, "Houses")
	for _, x in { -118, -88, -58, -28, 28, 58, 88, 118 } do
		for z = -40, 230, 30 do
			if Kit.IsFree(x, z, 15) then
				house(houses, x, z, if x < 0 then 1 else -1, 0)
			end
		end
	end

	-- Street lamps along the main road (skipped inside ghost areas)
	local lit = 0
	for z = 34, 250, 24 do
		for _, s in { -1, 1 } do
			local x = s * 12.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0.22, z), Kit.Pick({ C(255, 230, 120), C(170, 255, 150), C(210, 150, 255) }), lit % 2 == 1 and lit <= 9)
			end
		end
	end
	for x = -125, 50, 35 do
		if Kit.IsFree(x, 108, 1, true) then
			Props.StreetLamp(f, V(x, 0.22, 108), C(255, 200, 120), false)
		end
	end

	-- Parked cars (curbside)
	local cars = {
		{ -6, 150, 0, 1 }, { 6, 186, 0, -1 }, { -105, 113.5, 1, 0 }, { -42, 113.5, 1, 0 }, { 40, 120.5, -1, 0 },
		{ 70, -30, 0, 1 }, { -70, 20, 0, -1 },
	}
	for _, c in cars do
		if Kit.IsFree(c[1], c[2], 7.5, true) then
			Props.Car(f, V(c[1], 0.1, c[2]), c[3], c[4], Kit.Pick(Props.Colors.Car))
		end
	end

	-- Trees and pumpkins scattered on free grass
	local trees = 0
	for _ = 1, 260 do
		if trees >= 30 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(-54, 250)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(10, 17))
		end
	end
	local pumpkins = 0
	for _ = 1, 300 do
		if pumpkins >= 26 then
			break
		end
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(-54, 254)
		if Kit.IsFree(x, z, 2.5) then
			pumpkins += 1
			Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 4.6), -x, -z + 100)
			Kit.AddCircle(x, z, 2.5)
		end
	end
	local floats = 0
	for _ = 1, 200 do
		if floats >= 3 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(-40, 240)
		if Kit.IsFree(x, z, 3) then
			floats += 1
			Props.FloatingPumpkin(f, V(x, rng:NextNumber(8, 13), z))
		end
	end

	-- Spectral fog accents
	Props.Wisp(f, V(-40, 0, 40), C(170, 110, 255), 14, true)
	Props.Wisp(f, V(55, 0, 135), C(120, 255, 170), 12, true)
	Props.Wisp(f, V(-110, 0, 215), C(200, 120, 255), 16, true)
	Props.Wisp(f, V(30, 0, 240), C(120, 255, 170), 10, false)
	Props.Wisp(f, V(-60, 0, -20), C(170, 110, 255), 12, false)
	Props.Wisp(f, V(110, 0, 20), C(255, 140, 220), 12, false)
end

return Neighborhood
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable chunky props shared by every zone (pumpkins, trees, lamps, fences, cars...).
-- Positions are ground points (Y = 0 is the walkable surface) unless stated otherwise.

local Kit = require(script.Parent.Kit)

local Props = {}

local NEON = Enum.Material.Neon
local C = Color3.fromRGB

Props.Colors = {
	PumpkinBody = { C(255, 140, 30), C(255, 120, 40), C(255, 165, 50) },
	Canopy = { C(170, 90, 230), C(255, 140, 50), C(200, 110, 255), C(255, 110, 90), C(140, 220, 90) },
	Glow = { C(255, 230, 110), C(140, 255, 120), C(200, 130, 255), C(255, 170, 70) },
	Car = { C(255, 90, 140), C(80, 200, 255), C(255, 200, 60), C(140, 255, 140), C(190, 120, 255), C(255, 120, 60) },
	Book = { C(255, 90, 90), C(90, 170, 255), C(255, 210, 70), C(140, 230, 120), C(200, 120, 255), C(255, 140, 200) },
}

-- Segment between two points (square cross-section). Used for twisted trunks, branches, cracks.
function Props.Beam(parent: Instance, a: Vector3, b: Vector3, w: number, h: number, color: Color3, opts: Kit.Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local cf: CFrame
	if math.abs(d.Unit.Y) > 0.98 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return Kit.Part(parent, Vector3.new(w, h, len), cf, color, opts)
end

-- Pumpkin / jack-o-lantern with a glowing face toward (fx, fz). `y` is the bottom of the pumpkin.
function Props.Pumpkin(parent: Instance, pos: Vector3, d: number, fx: number, fz: number, lit: boolean?): Part
	local center = pos + Vector3.new(0, d * 0.45, 0)
	local body = Kit.Ball(parent, d, center, Kit.Pick(Props.Colors.PumpkinBody), { Shadow = false })
	local base = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Part(parent, Vector3.new(d * 0.12, d * 0.3, d * 0.12), base * CFrame.new(0, d * 0.55, 0) * CFrame.Angles(0, 0, 0.25), C(90, 160, 60))
	local face = C(255, 235, 90)
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(-d * 0.2, d * 0.12, -d * 0.46), face, { Mat = NEON })
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(d * 0.2, d * 0.12, -d * 0.46), face, { Mat = NEON })
	Kit.Part(parent, Vector3.new(d * 0.42, d * 0.1, d * 0.1), base * CFrame.new(0, -d * 0.12, -d * 0.45), face, { Mat = NEON })
	if lit then
		Kit.Light(body, C(255, 170, 60), 12, 1.5)
	end
	return body
end

-- Lollipop tree: trunk + three canopy balls.
function Props.Tree(parent: Instance, pos: Vector3, height: number, canopy: Color3?)
	local col = canopy or Kit.Pick(Props.Colors.Canopy)
	local rng = Kit.Rng
	Kit.Cyl(parent, height, 1.8, CFrame.new(pos + Vector3.new(0, height / 2, 0)), C(120, 75, 50), { Solid = true, Shadow = true })
	local top = pos + Vector3.new(0, height, 0)
	local s = height * 0.55
	Kit.Ball(parent, s, top, col, { Shadow = true })
	Kit.Ball(parent, s * 0.75, top + Vector3.new(rng:NextNumber(-2, 2), s * 0.35, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(1, 1, 1), 0.15))
	Kit.Ball(parent, s * 0.6, top + Vector3.new(rng:NextNumber(-3, 3), -s * 0.2, rng:NextNumber(-3, 3)), col:Lerp(Color3.new(0, 0, 0), 0.12))
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Twisted spooky tree made of crooked segments, bare branches and a few glowing leaf puffs.
function Props.TwistedTree(parent: Instance, pos: Vector3, height: number)
	local rng = Kit.Rng
	local trunk = C(95, 70, 110)
	local pts = { pos }
	local seg = height / 3
	for i = 1, 3 do
		local prev = pts[i]
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1.2, 2.8)
		table.insert(pts, prev + Vector3.new(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 3 do
		local w = 3.2 - i * 0.7
		Props.Beam(parent, pts[i], pts[i + 1], w, w, trunk, { Solid = i == 1, Shadow = true })
	end
	local leaf = { C(170, 90, 255), C(110, 255, 160), C(255, 120, 200) }
	for b = 1, 3 do
		local from = pts[2 + (b % 2)]
		local ang = b * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.22, 0.32)
		local tip = from + Vector3.new(math.cos(ang) * len, len * 0.6, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 0.9, 0.9, trunk)
		Kit.Ball(parent, rng:NextNumber(3.5, 5.5), tip, Kit.Pick(leaf), { Mat = if b == 1 then NEON else Enum.Material.SmoothPlastic, Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Street lamp: pole, arm and a glowing globe.
function Props.StreetLamp(parent: Instance, pos: Vector3, color: Color3, withLight: boolean)
	local pole = C(60, 45, 90)
	Kit.Cyl(parent, 13, 0.8, CFrame.new(pos + Vector3.new(0, 6.5, 0)), pole)
	Kit.Cyl(parent, 0.8, 1.8, CFrame.new(pos + Vector3.new(0, 0.4, 0)), pole)
	Kit.Box(parent, pos + Vector3.new(-0.3, 12.6, -0.3), pos + Vector3.new(0.3, 13.2, 0.3), pole)
	local globe = Kit.Ball(parent, 2.4, pos + Vector3.new(0, 14, 0), color, { Mat = NEON })
	Kit.Cyl(parent, 0.5, 2.8, CFrame.new(pos + Vector3.new(0, 15.3, 0)), pole)
	if withLight then
		Kit.Light(globe, color, 22, 1.6)
	end
end

-- Little post lantern (cemetery paths).
function Props.Lantern(parent: Instance, pos: Vector3, color: Color3, withLight: boolean, flicker: boolean?)
	local iron = C(50, 40, 70)
	Kit.Box(parent, pos + Vector3.new(-0.3, 0, -0.3), pos + Vector3.new(0.3, 7, 0.3), iron)
	local glow = Kit.Box(parent, pos + Vector3.new(-0.8, 7, -0.8), pos + Vector3.new(0.8, 9, 0.8), color, { Mat = NEON })
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, -0.55)), iron)
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, 0.55)) * CFrame.Angles(0, math.pi, 0), iron)
	if withLight then
		Kit.Light(glow, color, 18, 1.4, flicker)
	end
end

-- Mushroom cluster with glowing caps.
function Props.Mushrooms(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local caps = { C(120, 255, 200), C(200, 120, 255), C(255, 150, 220), C(120, 220, 255) }
	for _ = 1, rng:NextInteger(2, 3) do
		local p = pos + Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.8, 2)
		Kit.Cyl(parent, h, 0.5, CFrame.new(p + Vector3.new(0, h / 2, 0)), C(245, 240, 225))
		Kit.Ball(parent, rng:NextNumber(1.3, 2), p + Vector3.new(0, h, 0), Kit.Pick(caps), { Mat = NEON })
	end
end

-- Fence run from a to b (ground points). style: "picket" (crooked white) or "iron" (dark with neon tips).
function Props.Fence(parent: Instance, a: Vector3, b: Vector3, style: string)
	local rng = Kit.Rng
	local d = b - a
	local len = d.Magnitude
	if len < 1 then
		return
	end
	local dir = d.Unit
	local yaw = math.atan2(-dir.X, -dir.Z) -- local -Z along the run
	local iron = style == "iron"
	local col = if iron then C(55, 45, 80) else C(250, 240, 255)
	local h = if iron then 6 else 3.6
	local step = if iron then 2 else 1.6
	local rails = { h * 0.3, h * 0.75 }
	for _, ry in rails do
		local mid = a + d / 2 + Vector3.new(0, ry, 0)
		Kit.Part(parent, Vector3.new(0.3, 0.3, len), CFrame.new(mid) * CFrame.Angles(0, yaw, 0), col)
	end
	local n = math.floor(len / step)
	for i = 0, n do
		local p = a + dir * (i * step) + Vector3.new(0, h / 2, 0)
		local tilt = if iron then 0 else rng:NextNumber(-0.14, 0.14)
		local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt * 0.3, 0, tilt)
		Kit.Part(parent, Vector3.new(if iron then 0.35 else 0.25, h, if iron then 0.35 else 0.9), cf, col)
		if iron and i % 3 == 0 then
			Kit.Ball(parent, 0.7, p + Vector3.new(0, h / 2 + 0.3, 0), C(120, 255, 170), { Mat = NEON })
		end
	end
end

-- Low translucent neon wisp on the ground; optional slow particle fog.
function Props.Wisp(parent: Instance, pos: Vector3, color: Color3, d: number, emit: boolean)
	local p = Kit.Disc(parent, pos.X, pos.Z, 0.3, d, 0.12, color, { Mat = NEON, Transp = 0.8 })
	if emit then
		local src = Kit.Part(parent, Vector3.new(d * 0.6, 0.2, d * 0.6), CFrame.new(pos + Vector3.new(0, 1, 0)), color, { Transp = 1, Name = "FogSource" })
		Kit.Emitter(src, color, 1.5, 7, 0.4)
	end
	return p
end

-- Chunky cartoon car. `along` = direction the car faces (unit X/Z vector).
function Props.Car(parent: Instance, pos: Vector3, fx: number, fz: number, color: Color3)
	local m = Kit.Model(parent, "Car")
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	-- body (length along local Z)
	Kit.Part(m, Vector3.new(7.5, 3, 14), base * CFrame.new(0, 2.6, 0), color, { Solid = true, Shadow = true })
	Kit.Part(m, Vector3.new(6.6, 2.8, 7), base * CFrame.new(0, 5.4, 0.8), color:Lerp(Color3.new(1, 1, 1), 0.25), { Solid = true })
	local glass = C(170, 230, 255)
	Kit.Part(m, Vector3.new(5.8, 2, 0.3), base * CFrame.new(0, 5.5, -2.75), glass, { Mat = NEON, Transp = 0.35 })
	Kit.Part(m, Vector3.new(6.7, 1.8, 5.4), base * CFrame.new(0, 5.5, 0.8), glass, { Mat = NEON, Transp = 0.55 })
	local axle = if math.abs(fx) > math.abs(fz) then "Z" else "X"
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 1.2, 3.4, (base * CFrame.new(sx * 3.5, 1.7, sz * 4.4)).Position, axle, C(40, 35, 55))
		end
		Kit.Part(m, Vector3.new(1.4, 1, 0.3), base * CFrame.new(sx * 2.6, 3, -7.05), C(255, 250, 200), { Mat = NEON })
		Kit.Part(m, Vector3.new(1.2, 0.8, 0.3), base * CFrame.new(sx * 2.7, 3, 7.05), C(255, 60, 90), { Mat = NEON })
	end
	Kit.AddCircle(pos.X, pos.Z, 8)
end

-- Cute skull (big white ball with black eyes) facing (fx, fz). pos = centre.
function Props.Skull(parent: Instance, pos: Vector3, d: number, fx: number, fz: number)
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(parent, d, pos, C(250, 245, 235))
	Kit.Part(parent, Vector3.new(d * 0.55, d * 0.35, d * 0.5), base * CFrame.new(0, -d * 0.4, -d * 0.1), C(250, 245, 235))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, d * 0.28, (base * CFrame.new(sx * d * 0.18, d * 0.05, -d * 0.38)).Position, C(120, 255, 170), { Mat = NEON })
	end
end

-- Single-part floating book (tagged). pos = centre in the air.
function Props.FloatingBook(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local b = Kit.Part(parent, Vector3.new(1.8, 0.5, 2.4), cf, Kit.Pick(Props.Colors.Book), { Name = "FloatingBook" })
	Kit.Float(b, rng:NextNumber(0.6, 1.2))
end

-- Single-part floating candle (tagged).
function Props.FloatingCandle(parent: Instance, pos: Vector3)
	local c = Kit.Cyl(parent, 1.6, 0.6, CFrame.new(pos), C(255, 230, 160), { Mat = NEON, Name = "FloatingCandle" })
	Kit.Float(c, Kit.Rng:NextNumber(0.5, 1))
end

-- Single-part floating pumpkin (tagged).
function Props.FloatingPumpkin(parent: Instance, pos: Vector3)
	local p = Kit.Ball(parent, 2.4, pos, C(255, 150, 40), { Name = "FloatingPumpkin" })
	Kit.Float(p, Kit.Rng:NextNumber(0.6, 1.1))
end

-- A sign board facing (fx, fz) with text on its Front face.
function Props.SignBoard(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, bg: Color3, fg: Color3, frame: Color3?): Part
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local board = Kit.Part(parent, Vector3.new(w, h, 0.6), cf, bg, { Name = "SignBoard" })
	if frame then
		Kit.Part(parent, Vector3.new(w + 1, h + 1, 0.4), cf * CFrame.new(0, 0, 0.35), frame, { Mat = NEON })
	end
	Kit.Sign(board, Enum.NormalId.Front, text, fg)
	return board
end

-- Graffiti: an invisible thin panel with neon text, flat against a wall, facing (fx, fz).
function Props.Graffiti(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, color: Color3, rot: number?)
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local panel = Kit.Part(parent, Vector3.new(w, h, 0.1), cf, color, { Transp = 1, Name = "Graffiti" })
	Kit.Sign(panel, Enum.NormalId.Front, text, color, { Font = Enum.Font.FredokaOne, Stroke = C(30, 10, 50), Rotation = rot })
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">School</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 3: Haunted School (Z 540..880).
--   Courtyard Z 540..600: path, Elite crate station (built by Stations), ghost bus, flagpole.
--   Building X -100..100, Z 600..860, walls 16 tall, NO roof over the interior (only rim
--   ledges and a few thin beams) so the camera and ghost taps work from above.
--     Front wall Z=600 with a 20-wide entrance under the clock tower (top ~Y 104).
--     Central hallway X -16..16, Z 601..761 (ghost areas at Z 640 and 700).
--     Library   X -99..-18, Z 601..648   | Cafeteria X 18..99, Z 601..648
--     Class 1-A X -99..-18, Z 650..761   | Class 1-B X 18..99, Z 650..761 (ghost areas at X ±62, Z 690)
--     Gym       X -99..99,  Z 763..859 (Headmaster area at Z 805), bleachers along the back wall.
--   Doorways: hallway→library/cafeteria 14 wide, hallway→classes 20 wide, library/cafeteria→class
--   14 wide, classes→gym 16 wide, hallway→gym 32 wide.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local School = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local H = 16
local EXT = C(255, 195, 140)
local TRIMC = C(130, 80, 210)
local WHITE = C(255, 250, 245)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

type Opening = { c: number, w: number, h: number? }

local function sortOpenings(list: { Opening })
	table.sort(list, function(a: Opening, b: Opening)
		return a.c < b.c
	end)
end

-- Wall along X at fixed z (thickness 2), from x1 to x2, with doorway openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, color: Color3, openings: { Opening })
	sortOpenings(openings)
	local cur = x1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(cur, 0, z - 1), V(a, H, z + 1), color, SOLID)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(a, oh, z - 1), V(b, H, z + 1), color, SOLID)
		end
		cur = b
	end
	if x2 > cur then
		Kit.Box(parent, V(cur, 0, z - 1), V(x2, H, z + 1), color, SOLID)
	end
end

-- Wall along Z at fixed x (thickness 2), from z1 to z2, with doorway openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, color: Color3, openings: { Opening })
	sortOpenings(openings)
	local cur = z1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, a), color, SOLID)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(x - 1, oh, a), V(x + 1, H, b), color, SOLID)
		end
		cur = b
	end
	if z2 > cur then
		Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, z2), color, SOLID)
	end
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, SOLID)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, SOLID)
end

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	-- wall lamp on a wall whose inner face is at pos.X - fx * 0.5
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), C(60, 40, 90))
	Kit.Light(lamp, color, 24, 1.6, true)
end

--==================================================================
-- SHELL
--==================================================================
local function shell(f: Instance)
	-- floors (top Y 0.15)
	Kit.Box(f, V(-101, -0.5, 599), V(101, 0.1, 861), C(110, 90, 150), { Solid = true, Name = "SchoolFloor" })
	local tiles = { C(235, 225, 250), C(150, 110, 220) }
	for i = 0, 3 do
		for j = 0, 19 do
			local x0, z0 = -16 + i * 8, 601 + j * 8
			Kit.Box(f, V(x0, 0.05, z0), V(x0 + 8, 0.15, z0 + 8), tiles[((i + j) % 2) + 1], { Solid = true })
		end
	end
	Kit.Box(f, V(-99, 0.05, 601), V(-18, 0.15, 648), C(190, 130, 90), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 601), V(99, 0.15, 648), C(255, 225, 175), { Solid = true })
	Kit.Box(f, V(-99, 0.05, 650), V(-18, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 650), V(99, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(-99, 0.05, 763), V(99, 0.15, 859), C(235, 160, 90), { Mat = Enum.Material.WoodPlanks, Solid = true, Name = "GymFloor" })

	-- exterior walls
	wallX(f, 600, -101, 101, EXT, { { c = 0, w = 20 } })
	wallX(f, 860, -101, 101, EXT, {})
	wallZ(f, -100, 601, 859, EXT, {})
	wallZ(f, 100, 601, 859, EXT, {})
	-- hallway walls
	local hall = C(190, 170, 240)
	wallZ(f, -17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	wallZ(f, 17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	-- front rooms / classrooms divider and the gym wall
	local inner = C(170, 225, 210)
	wallX(f, 649, -99, -18, inner, { { c = -60, w = 14, h = 12 } })
	wallX(f, 649, 18, 99, inner, { { c = 60, w = 14, h = 12 } })
	wallX(f, 762, -99, 99, C(255, 170, 120), { { c = 0, w = 32 }, { c = -60, w = 16, h = 13 }, { c = 60, w = 16, h = 13 } })

	-- parapet on the exterior walls + partial roof ledges (no roof over the interior)
	local rim = C(120, 70, 190)
	Kit.Box(f, V(-102, H, 598), V(102, H + 2, 602), rim, SOLID)
	Kit.Box(f, V(-102, H, 858), V(102, H + 2, 862), rim, SOLID)
	Kit.Box(f, V(-102, H, 598), V(-98, H + 2, 862), rim, SOLID)
	Kit.Box(f, V(98, H, 598), V(102, H + 2, 862), rim, SOLID)
	local ledge = C(150, 100, 220)
	Kit.Box(f, V(-98, H + 0.5, 602), V(98, H + 1.5, 607), ledge)
	Kit.Box(f, V(-98, H + 0.5, 853), V(98, H + 1.5, 858), ledge)
	Kit.Box(f, V(-98, H + 0.5, 602), V(-93, H + 1.5, 858), ledge)
	Kit.Box(f, V(93, H + 0.5, 602), V(98, H + 1.5, 858), ledge)
	-- sloped eaves on the outside
	local eave = C(110, 60, 180)
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 596), 0, -1), eave, { Shadow = true })
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 864), 0, 1), eave, { Shadow = true })
	Kit.Wedge(f, V(268, 3, 4), faced(V(-104, H + 0.5, 730), -1, 0), eave, { Shadow = true })
	Kit.Wedge(f, V(268, 3, 4), faced(V(104, H + 0.5, 730), 1, 0), eave, { Shadow = true })
	-- neon band around the outside
	Kit.Box(f, V(-101.2, 14, 598.7), V(101.2, 14.6, 598.9), C(150, 255, 140), { Mat = NEON })

	-- corner turrets
	for _, x in { -100, 100 } do
		for _, z in { 600, 860 } do
			Kit.Cyl(f, 24, 10, CFrame.new(x, 12, z), C(240, 170, 120), SOLID)
			Kit.Cyl(f, 1, 10.6, CFrame.new(x, 14.3, z), C(200, 130, 255), { Mat = NEON })
			Kit.Cyl(f, 2, 11.5, CFrame.new(x, 25, z), TRIMC)
			Kit.Cyl(f, 3, 8, CFrame.new(x, 27.5, z), TRIMC)
			Kit.Cyl(f, 3, 4.5, CFrame.new(x, 30.5, z), TRIMC)
			Kit.Ball(f, 2.6, V(x, 33, z), C(150, 255, 140), { Mat = NEON })
		end
	end

	-- facade windows and side windows (glowing)
	for _, x in { -88, -70, -50, -30, 30, 50, 70, 88 } do
		Kit.Box(f, V(x - 3, 4.5, 598.75), V(x + 3, 12.5, 599), WHITE)
		Kit.Box(f, V(x - 2.4, 5, 598.6), V(x + 2.4, 12, 598.85), Kit.Pick({ C(255, 230, 120), C(150, 255, 140), C(210, 150, 255) }), { Mat = NEON })
	end
	for _, s in { -1, 1 } do
		for _, z in { 625, 690, 735, 790, 830 } do
			Kit.Box(f, V(s * 101, 4.5, z - 3), V(s * 101.25, 12.5, z + 3), WHITE)
			Kit.Box(f, V(s * 101.15, 5, z - 2.4), V(s * 101.4, 12, z + 2.4), Kit.Pick({ C(255, 230, 120), C(150, 255, 140), C(210, 150, 255) }), { Mat = NEON })
		end
	end
	-- entrance steps
	Kit.Box(f, V(-12, 0, 592), V(12, 0.5, 599), C(200, 190, 220), { Mat = Enum.Material.Slate, Solid = true })
end

--==================================================================
-- CLOCK TOWER (over the entrance)
--==================================================================
local function clockTower(f: Instance)
	local body = C(165, 115, 235)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, 594), V(s * 14, 22, 606), body, SOLID)
		Kit.Box(f, V(s * 9.8, 0, 593.8), V(s * 10.3, 22, 594.3), C(150, 255, 140), { Mat = NEON })
	end
	Kit.Box(f, V(-14, 22, 594), V(14, 62, 606), body, { Solid = true, Shadow = true, Name = "ClockTower" })
	Kit.Box(f, V(-14.3, 22, 593.7), V(14.3, 23, 606.3), C(150, 255, 140), { Mat = NEON })
	Kit.Box(f, V(-14.3, 61, 593.7), V(14.3, 62, 606.3), C(255, 160, 60), { Mat = NEON })
	-- SPOOKY HIGH sign
	local sign = Kit.Part(f, V(26, 6, 0.6), CFrame.new(0, 26.5, 593.6), C(45, 25, 80))
	Kit.Part(f, V(27.5, 7.5, 0.3), CFrame.new(0, 26.5, 593.85), C(255, 160, 60), { Mat = NEON })
	Kit.Sign(sign, Enum.NormalId.Front, "SPOOKY HIGH", C(255, 200, 80))
	-- clock (11:55, almost midnight)
	Kit.CylFlat(f, 0.5, 17.5, V(0, 44, 593.75), "Z", C(200, 120, 255), { Mat = NEON })
	Kit.CylFlat(f, 0.6, 16, V(0, 44, 593.4), "Z", C(255, 245, 225))
	local function hand(len: number, w: number, angle: number, z: number, color: Color3)
		Kit.Part(f, V(w, len, 0.25), CFrame.new(0, 44, z) * CFrame.Angles(0, 0, angle) * CFrame.new(0, len / 2, 0), color)
	end
	hand(5, 1, -0.05, 593.0, C(60, 30, 90))
	hand(7, 0.7, -0.52, 592.9, C(130, 60, 200))
	Kit.Ball(f, 1.2, V(0, 44, 592.9), C(255, 160, 60), { Mat = NEON })
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Part(f, V(0.8, 1.6, 0.3), CFrame.new(math.sin(a) * 6.5, 44 + math.cos(a) * 6.5, 593.0) * CFrame.Angles(0, 0, -a), C(130, 60, 200))
	end
	-- bell loft
	for _, x in { -12.5, 12.5 } do
		for _, z in { 595.5, 604.5 } do
			Kit.Box(f, V(x - 1.5, 62, z - 1.5), V(x + 1.5, 74, z + 1.5), body, SOLID)
		end
	end
	local bell = Kit.Ball(f, 7, V(0, 68, 600), C(255, 200, 70))
	Kit.Ball(f, 3, V(0, 64.8, 600), C(150, 255, 140), { Mat = NEON })
	Kit.Light(bell, C(170, 255, 160), 30, 1.4)
	Kit.Box(f, V(-15.5, 74, 592.5), V(15.5, 76, 607.5), TRIMC, SOLID)
	gable(f, CFrame.new(0, 76, 600), 31, 15, 14, C(110, 60, 180))
	Kit.Cyl(f, 12, 1.2, CFrame.new(0, 96, 600), C(240, 220, 120))
	Kit.Ball(f, 3.2, V(0, 103, 600), C(200, 120, 255), { Mat = NEON })
end

--==================================================================
-- HALLWAY
--==================================================================
local function hallway(f: Instance)
	local lockerCols = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	local runs = { { 606, 616 }, { 632, 679 }, { 701, 760 } }
	local n = 0
	for _, s in { -1, 1 } do
		for _, r in runs do
			local z0 = r[1]
			while z0 + 3 <= r[2] do
				n += 1
				Kit.Box(f, V(s * 16, 0.15, z0), V(s * 14.5, 8.5, z0 + 3), lockerCols[(n % #lockerCols) + 1], { Solid = true })
				if n % 7 == 0 then
					Kit.Box(f, V(s * 14.5, 1, z0 + 0.4), V(s * 14.35, 8, z0 + 2.6), C(140, 255, 150), { Mat = NEON })
				end
				z0 += 3.2
			end
			Kit.Box(f, V(s * 16, 8.5, r[1]), V(s * 14.3, 9, r[2]), C(120, 70, 190))
		end
	end
	-- glowing guide lines on the floor (flat)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 7 - 0.25, 0.15, 603), V(s * 7 + 0.25, 0.2, 760), C(200, 130, 255), { Mat = NEON })
	end
	-- thin beams overhead (Y 16..17.5), clear of the ghost areas' height
	for _, z in { 615, 670, 732, 758 } do
		Kit.Box(f, V(-18, H, z - 0.75), V(18, H + 1.5, z + 0.75), C(120, 80, 60), { Mat = Enum.Material.WoodPlanks })
	end
	local gymSign = Kit.Part(f, V(14, 3, 0.4), CFrame.new(0, 13.6, 758), C(45, 25, 80))
	Kit.Sign(gymSign, Enum.NormalId.Front, "🏀 GYM 🏀", C(255, 190, 80))
	for _, x in { -5, 5 } do
		Kit.Box(f, V(x - 0.1, 15.1, 757.9), V(x + 0.1, H, 758.1), C(60, 50, 70))
	end
	-- flickering sconces
	for _, z in { 612, 668, 722 } do
		sconce(f, V(-15.6, 12.4, z), 1, C(255, 230, 140))
	end
	for _, z in { 640, 712, 750 } do
		sconce(f, V(15.6, 12.4, z), -1, C(200, 150, 255))
	end
	-- door signs
	Props.SignBoard(f, V(-15.6, 14, 624), 12, 2.8, 1, 0, "📚 LIBRARY", C(45, 25, 80), C(255, 220, 120))
	Props.SignBoard(f, V(15.6, 14, 624), 12, 2.8, -1, 0, "🍕 CAFETERIA", C(45, 25, 80), C(150, 255, 140))
	Props.SignBoard(f, V(-15.6, 14.5, 690), 14, 2.6, 1, 0, "CLASS 1-A", C(45, 25, 80), C(255, 170, 220))
	Props.SignBoard(f, V(15.6, 14.5, 690), 14, 2.6, -1, 0, "CLASS 1-B", C(45, 25, 80), C(120, 220, 255))
	-- ghostly graffiti
	Props.Graffiti(f, V(-15.9, 12.3, 650), 10, 5, 1, 0, "BOO!", C(150, 255, 140), -6)
	Props.Graffiti(f, V(15.9, 12.3, 655), 14, 5, -1, 0, "NO RUNNING\n(FLOATING OK)", C(255, 150, 220), 4)
	Props.Graffiti(f, V(-15.9, 12.3, 740), 14, 5, 1, 0, "GHOSTS RULE", C(200, 140, 255), -3)
	Props.Graffiti(f, V(15.9, 12.3, 728), 12, 5, -1, 0, "HALL PASS?\nNAH.", C(120, 230, 255), 5)
	-- slime puddles (flat)
	local slime = Kit.Disc(f, -4, 662, 0.22, 6, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
	Kit.Emitter(slime, C(150, 255, 160), 1.5, 3, 0.4)
	Kit.Disc(f, 6, 721, 0.22, 4, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- LIBRARY + CAFETERIA
--==================================================================
local function shelf(f: Instance, a: Vector3, b: Vector3, faceAxis: string, faceSign: number)
	Kit.Box(f, a, b, C(120, 75, 55), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	for i = 0, 2 do
		local y = 1.4 + i * 3.1
		local col = Kit.Pick(Props.Colors.Book)
		if faceAxis == "X" then
			local x = if faceSign > 0 then hi.X else lo.X
			Kit.Box(f, V(x, y, lo.Z + 0.4), V(x + faceSign * 0.3, y + 2.3, hi.Z - 0.4), col)
		else
			local z = if faceSign > 0 then hi.Z else lo.Z
			Kit.Box(f, V(lo.X + 0.4, y, z), V(hi.X - 0.4, y + 2.3, z + faceSign * 0.3), col)
		end
	end
end

local function library(f: Instance)
	for z = 607, 638, 8.5 do
		shelf(f, V(-99, 0.15, z), V(-96, 11, z + 8), "X", 1)
	end
	for x = -93, -30, 9 do
		shelf(f, V(x, 0.15, 601), V(x + 8, 11, 604), "Z", 1)
	end
	for _, x in { -70, -45 } do
		Kit.Box(f, V(x - 6, 3, 621), V(x + 6, 3.6, 631), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
		Kit.Box(f, V(x - 1, 0.15, 624), V(x + 1, 3, 628), C(110, 70, 50))
		Kit.Cyl(f, 1.6, 0.3, CFrame.new(x + 3, 4.4, 626), C(70, 60, 80))
		Kit.Ball(f, 1.3, V(x + 3, 5.4, 626), C(150, 255, 140), { Mat = NEON })
	end
	local rng = Kit.Rng
	for _ = 1, 7 do
		Props.FloatingBook(f, V(rng:NextNumber(-90, -26), rng:NextNumber(6, 11), rng:NextNumber(608, 644)))
	end
	Props.Graffiti(f, V(-82, 11, 647.9), 16, 5, 0, -1, "SHHH!\nGHOSTS READING", C(150, 255, 140), -3)
end

local function cafeteria(f: Instance)
	-- counter + sneeze guard + menu
	Kit.Box(f, V(90, 0.15, 607), V(96, 4, 643), C(205, 205, 225), { Solid = true })
	local pans = { C(130, 255, 140), C(255, 160, 60), C(200, 120, 255), C(255, 110, 140) }
	for i = 0, 3 do
		Kit.Box(f, V(91, 4, 609 + i * 8.5), V(95, 4.5, 615 + i * 8.5), pans[i + 1], { Mat = NEON })
	end
	Kit.Box(f, V(89.8, 4, 607), V(90.2, 7, 643), C(200, 240, 255), { Transp = 0.6 })
	local menuCF = faced(V(98.7, 11, 625), -1, 0)
	local menu = Kit.Part(f, V(26, 6, 0.4), menuCF, C(40, 30, 60))
	Kit.Part(f, V(27, 7, 0.2), menuCF * CFrame.new(0, 0, 0.3), C(255, 160, 60), { Mat = NEON })
	Kit.Sign(menu, Enum.NormalId.Front, "TODAY: ECTO-LOAF\n& SCREAM PIE", C(150, 255, 140))
	-- long tables with benches and trays
	local trays = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	for _, x in { 35, 55, 75 } do
		Kit.Box(f, V(x - 2.5, 3, 610), V(x + 2.5, 3.6, 640), C(240, 240, 250), { Solid = true })
		Kit.Box(f, V(x - 0.5, 0.15, 612), V(x + 0.5, 3, 638), C(130, 130, 160))
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 3.6, 0.15, 611), V(x + s * 5, 2, 639), C(170, 110, 230), { Solid = true })
		end
		for i = 0, 3 do
			local s = if i % 2 == 0 then -1 else 1
			local tz = 614 + i * 7
			Kit.Box(f, V(x + s * 0.3, 3.6, tz - 0.8), V(x + s * 2.2, 3.85, tz + 0.8), trays[i + 1])
			Kit.Ball(f, 0.9, V(x + s * 1.25, 4.2, tz), Kit.Pick(pans), { Mat = NEON })
		end
	end
	Props.Graffiti(f, V(35, 11, 647.9), 16, 5, 0, -1, "FOOD FIGHT\nAT MIDNIGHT", C(255, 170, 220), 4)
	Props.FloatingPumpkin(f, V(45, 10, 628))
end

--==================================================================
-- CLASSROOMS
--==================================================================
local function classroom(f: Instance, side: number, title: string, graffiti: string)
	-- side = -1 (west, Class 1-A) or +1 (east, Class 1-B); board on the outer wall
	local gx, gz, gr = side * 62, 690, 20
	local boardCF = faced(V(side * 98.7, 8.5, 705), -side, 0)
	local board = Kit.Part(f, V(30, 8, 0.4), boardCF, C(40, 95, 75))
	Kit.Part(f, V(31.6, 9.6, 0.3), boardCF * CFrame.new(0, 0, 0.3), C(150, 100, 60), { Mat = Enum.Material.WoodPlanks })
	Kit.Sign(board, Enum.NormalId.Front, title, C(235, 255, 235), { Stroke = C(30, 70, 55), Font = Enum.Font.FredokaOne })
	-- teacher's desk + apple
	local tx = side * 90.5
	Kit.Box(f, V(tx - 2.5, 0.15, 698), V(tx + 2.5, 3.6, 710), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Ball(f, 1.2, V(tx, 4.2, 702), C(255, 70, 80))
	-- student desks (facing the board), kept out of the ghost circle and doorways
	local desk, chair = C(255, 210, 120), C(130, 90, 220)
	for ax = 91, 31, -12 do
		local x = side * ax
		for z = 656, 752, 12 do
			local dx, dz = x - gx, z - gz
			local inCircle = dx * dx + dz * dz < (gr + 4) * (gr + 4)
			local teacher = ax >= 85 and z >= 690 and z <= 716
			local gymDoor = z >= 736 and math.abs(ax - 60) < 9
			local divDoor = z <= 660 and math.abs(ax - 60) < 9
			local hallDoor = ax <= 31 and z >= 672 and z <= 708
			if not (inCircle or teacher or gymDoor or divDoor or hallDoor) then
				local back = side -- chairs sit on the side away from the board
				Kit.Box(f, V(x - 1.5, 3, z - 1.4), V(x + 1.5, 3.4, z + 1.4), desk, { Solid = true })
				Kit.Box(f, V(x + side * 1.5, 0.15, z - 1.2), V(x + side * 1.1, 3, z + 1.2), desk:Lerp(C(0, 0, 0), 0.2))
				Kit.Box(f, V(x - back * 2, 1.8, z - 1.1), V(x - back * 4.2, 2.1, z + 1.1), chair)
				Kit.Box(f, V(x - back * 4, 0.15, z - 1.1), V(x - back * 4.3, 4.4, z + 1.1), chair)
			end
		end
	end
	-- floating books near the back of the room
	local rng = Kit.Rng
	for i = 0, 3 do
		Props.FloatingBook(f, V(side * (36 + i * 14), rng:NextNumber(9, 12), 745 + rng:NextNumber(-4, 6)))
	end
	sconce(f, V(side * 98.4, 12.4, 740), -side, C(150, 255, 160))
	Props.Graffiti(f, V(side * 85, 11, 760.9), 18, 5, 0, -1, graffiti, C(200, 140, 255), side * 4)
	Kit.Disc(f, side * 40, 735, 0.22, 5, 0.08, C(200, 130, 255), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- GYM
--==================================================================
local function gym(f: Instance)
	local line = C(255, 250, 240)
	Kit.Box(f, V(-0.3, 0.15, 765), V(0.3, 0.2, 857), line, { Mat = NEON })
	for _, x in { -92, 92 } do
		Kit.Box(f, V(x - 0.3, 0.15, 768), V(x + 0.3, 0.2, 840), line, { Mat = NEON })
	end
	for _, z in { 768, 840 } do
		Kit.Box(f, V(-92, 0.15, z - 0.3), V(92, 0.2, z + 0.3), line, { Mat = NEON })
	end
	for i = 0, 15 do
		local a = (i + 0.5) / 16 * math.pi * 2
		local p = V(math.cos(a) * 10, 0.17, 805 + math.sin(a) * 10)
		Kit.Part(f, V(0.6, 0.06, 4.4), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), C(200, 130, 255), { Mat = NEON })
	end
	-- hoops on the side walls
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 97.4, 9.5, 800.5), V(s * 97.9, 14.5, 809.5), WHITE)
		Kit.Box(f, V(s * 97.3, 10.6, 803.5), V(s * 97.4, 13, 806.5), C(255, 120, 60), { Mat = NEON })
		Kit.Box(f, V(s * 97.9, 11.4, 804.6), V(s * 99, 12.2, 805.4), C(80, 80, 100))
		Kit.Disc(f, s * 95.4, 805, 10.3, 3.6, 0.3, C(255, 130, 50), { Mat = NEON })
		Kit.Cyl(f, 2, 3.2, CFrame.new(s * 95.4, 9.1, 805), WHITE, { Transp = 0.5 })
	end
	-- bleachers along the back wall
	local cols = { C(170, 110, 255), C(255, 160, 70), C(110, 230, 170), C(255, 120, 170) }
	for i = 0, 3 do
		Kit.Box(f, V(-60, 0.15, 842 + i * 4), V(60, 1.6 * (i + 1) + 0.15, 859), cols[i + 1], SOLID)
	end
	for k = 0, 5 do
		local i = k % 4
		Props.Pumpkin(f, V(-50 + k * 20, 1.6 * (i + 1) + 0.15, 844 + i * 4), 2.6, 0, -1)
	end
	-- scoreboard
	local sbCF = CFrame.new(0, 12.5, 858.5)
	local sb = Kit.Part(f, V(26, 6, 0.6), sbCF, C(30, 20, 50))
	Kit.Part(f, V(27.4, 7.4, 0.3), sbCF * CFrame.new(0, 0, 0.35), C(150, 255, 140), { Mat = NEON })
	Kit.Sign(sb, Enum.NormalId.Front, "HOME 0  •  GHOSTS 999", C(255, 210, 80), { Font = Enum.Font.GothamBlack })
	-- banners
	Props.SignBoard(f, V(-98.6, 10, 780), 14, 5, 1, 0, "GO GHOULS!", C(130, 70, 220), C(255, 220, 90))
	Props.SignBoard(f, V(-98.6, 10, 830), 14, 5, 1, 0, "TEAM SPIRIT\n(LITERALLY)", C(255, 120, 60), WHITE)
	Props.SignBoard(f, V(98.6, 10, 780), 14, 5, -1, 0, "SPIRIT WEEK", C(60, 170, 150), WHITE)
	Props.SignBoard(f, V(98.6, 10, 830), 14, 5, -1, 0, "BOO CREW", C(220, 70, 140), C(255, 230, 120))
	Props.Graffiti(f, V(-80, 11, 763.1), 18, 5, 0, 1, "DETENTION\nFOREVER", C(150, 255, 140), -4)
	sconce(f, V(-98.4, 13.5, 792), 1, C(255, 200, 120))
	sconce(f, V(98.4, 13.5, 818), -1, C(255, 200, 120))
	Props.FloatingPumpkin(f, V(-30, 13, 850))
	Props.FloatingPumpkin(f, V(30, 13, 850))
end

--==================================================================
-- COURTYARD
--==================================================================
local function courtyard(f: Instance)
	Kit.Box(f, V(-10, -0.4, 540), V(10, 0.1, 592), C(190, 175, 215), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.AddRect(-12, 540, 12, 600, true)
	Kit.AddRect(-104, 592, 104, 864)
	-- ghost bus
	local yellow = C(255, 205, 50)
	Kit.Box(f, V(55, 1.5, 566), V(85, 10.5, 578), yellow, SOLID)
	Kit.Box(f, V(55.5, 10.5, 566.5), V(84.5, 11.3, 577.5), C(255, 225, 120))
	Kit.Box(f, V(54.9, 5.5, 565.9), V(85.1, 6.1, 578.1), C(40, 30, 50))
	for _, z in { 565.8, 578.0 } do
		Kit.Box(f, V(58, 6.8, z), V(82, 9.6, z + 0.2), C(255, 245, 170), { Mat = NEON, Transp = 0.2 })
	end
	Kit.Box(f, V(54.8, 6.5, 567), V(55, 9.8, 577), C(170, 230, 255), { Mat = NEON, Transp = 0.3 })
	for _, x in { 60, 80 } do
		for _, z in { 565.6, 578.4 } do
			Kit.CylFlat(f, 1.4, 4, V(x, 2, z), "Z", C(40, 35, 55))
		end
	end
	for _, z in { 568, 576 } do
		Kit.Box(f, V(54.7, 3, z - 0.8), V(54.9, 4.2, z + 0.8), C(255, 250, 200), { Mat = NEON })
	end
	local busSign = Kit.Box(f, V(62, 2.2, 565.6), V(78, 5.2, 565.9), yellow)
	Kit.Sign(busSign, Enum.NormalId.Front, "SPOOKY HIGH 👻", C(60, 30, 90), { Stroke = C(255, 255, 255) })
	Kit.AddCircle(70, 572, 17)
	-- flagpole
	Kit.Cyl(f, 26, 0.6, CFrame.new(28, 13, 590), C(220, 220, 235))
	Kit.Ball(f, 1.2, V(28, 26.4, 590), C(255, 210, 80), { Mat = NEON })
	local flag = Kit.Box(f, V(28.3, 20, 589.9), V(37, 25, 590.1), C(150, 80, 230))
	Kit.Sign(flag, Enum.NormalId.Front, "👻", WHITE)
	Kit.AddCircle(28, 590, 2)
	-- pumpkins lining the path
	for z = 548, 590, 14 do
		for _, s in { -1, 1 } do
			Props.Pumpkin(f, V(s * 12.5, 0, z), 2.8, -s, 0)
		end
	end
	-- trees (courtyard and the strips around the building)
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(546, 874)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	local lampGlobe = C(210, 150, 255)
	Props.StreetLamp(f, V(-15, 0, 594), lampGlobe, true)
	Props.StreetLamp(f, V(15, 0, 594), lampGlobe, false)
end

function School.Build(map: Instance)
	local f = Kit.Folder(map, "School")
	courtyard(f)
	shell(f)
	clockTower(f)
	hallway(f)
	library(f)
	cafeteria(f)
	classroom(f, -1, "GHOST 101\nBOO = HELLO 👋", "NO HOMEWORK\nONLY HAUNTWORK")
	classroom(f, 1, "BOO-OLOGY\nCHAPTER 13 🕸️", "A+ IN\nSCARING")
	gym(f)
end

return School
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[--!strict
-- Crate stations (workspace.Map.Stations.CrateStation_<id>) and the upgrade booth
-- (workspace.Map.Stations.UpgradeStation). Stations sit beside the main path (X = 0);
-- their PromptAnchor and the OddsBoard's Front face point toward the path.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Stations = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WHITE = C(255, 255, 255)

local function anchors(m: Model, x: number, z: number, dir: number)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x, 4, z), WHITE, { Name = "DisplaySlot", Transp = 1 })
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })
end

local function pad(m: Model, x: number, z: number, color: Color3, trim: Color3): Part
	Kit.Disc(m, x, z, 0.6, 16.5, 0.6, trim, { Mat = NEON })
	local p = Kit.Disc(m, x, z, 1, 14, 1, color, { Name = "Pad", Solid = true })
	Kit.Disc(m, x, z, 1.12, 9, 0.2, trim, { Mat = NEON, Transp = 0.25 })
	Kit.Disc(m, x, z, 1.18, 6, 0.2, color:Lerp(WHITE, 0.3))
	return p
end

local function crateStation(folder: Instance, crate: Config.CrateDef, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1 -- toward the path
	local m = Kit.Model(folder, "CrateStation_" .. crate.Id)
	local padPart = pad(m, x, z, crate.Color, crate.Trim)
	anchors(m, x, z, dir)

	-- Odds board behind the pad, Front face toward the path.
	local yaw = Kit.FaceYaw(dir, 0)
	local boardCF = CFrame.new(x - dir * 9.5, 7, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(m, V(12, 9, 0.6), boardCF, C(35, 22, 60), { Name = "OddsBoard", Solid = true })
	Kit.Part(m, V(13.4, 10.4, 0.5), boardCF * CFrame.new(0, 0, 0.45), crate.Trim, { Mat = NEON })
	Kit.Part(m, V(14.2, 1.8, 1.2), boardCF * CFrame.new(0, 5.6, 0.3), crate.Color)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 2.6, 1), boardCF * CFrame.new(sx * 5, -5.8, 0.4), crate.Color:Lerp(C(0, 0, 0), 0.3), { Solid = true })
		Kit.Ball(m, 1.6, (boardCF * CFrame.new(sx * 7.1, 5.6, 0.3)).Position, crate.Trim, { Mat = NEON })
	end

	-- Arch over the back half of the pad with the crate's name facing the path.
	local ax = x - dir * 3
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(ax - 1.3, 0, z + sz * 9.5 - 1.3), V(ax + 1.3, 15, z + sz * 9.5 + 1.3), crate.Color, { Solid = true })
		Kit.Box(m, V(ax - 1.6, 0, z + sz * 9.5 - 1.6), V(ax + 1.6, 1.4, z + sz * 9.5 + 1.6), crate.Trim, { Mat = NEON })
		Kit.Ball(m, 3, V(ax, 18.4, z + sz * 10.5), crate.Trim, { Mat = NEON })
	end
	local beam = Kit.Box(m, V(ax - 1.5, 15, z - 11.5), V(ax + 1.5, 17, z + 11.5), crate.Color:Lerp(WHITE, 0.15))
	Kit.Light(beam, crate.Trim, 18, 1.8)
	local signCF = CFrame.new(ax, 19, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(20, 4, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(21, 5, 0.4), signCF * CFrame.new(0, 0, 0.4), crate.Trim, { Mat = NEON })
	Kit.Sign(sign, Enum.NormalId.Front, crate.Name, crate.Trim)

	-- glowing corner pumpkins / orbs
	Props.Pumpkin(m, V(x + dir * 6, 0, z + 9), 2.8, dir, 0)
	Props.Pumpkin(m, V(x + dir * 6, 0, z - 9), 2.8, dir, 0)

	Kit.AddCircle(ax, z, 13)
	m.PrimaryPart = padPart
	return m
end

local function beginnerExtras(m: Model, x: number, z: number, crate: Config.CrateDef)
	-- Tall translucent beacon so the first crate is obvious from spawn.
	local beacon = Kit.Cyl(m, 70, 5, CFrame.new(x, 57, z), crate.Trim, { Mat = NEON, Transp = 0.65, Name = "Beacon" })
	Kit.Emitter(beacon, crate.Trim, 3, 3, 2)
	Kit.Ball(m, 6, V(x, 22.5, z), crate.Color, { Mat = NEON, Transp = 0.2 })
	local bb: BillboardGui = Instance.new("BillboardGui")
	bb.Size = UDim2.new(20, 0, 5, 0)
	bb.StudsOffsetWorldSpace = V(0, -24, 0)
	bb.MaxDistance = 260
	bb.LightInfluence = 0
	bb.Parent = beacon
	Kit.Label(bb, "🎁 OPEN CRATES! 🎁", C(255, 230, 90), { Stroke = C(120, 50, 10) })
end

local function upgradeStation(folder: Instance, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1
	local m = Kit.Model(folder, "UpgradeStation")
	local color, trim = C(80, 200, 255), C(255, 220, 80)
	local padPart = pad(m, x, z, color, trim)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })

	local bx = x - dir * 9.5 -- workbench centre line
	local back = bx - dir * 3 -- back panel
	local yaw = Kit.FaceYaw(dir, 0)
	-- workbench
	Kit.Box(m, V(bx - 2, 0, z - 8), V(bx + 2, 3.6, z + 8), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(m, V(bx - 2.4, 3.6, z - 8.4), V(bx + 2.4, 4.2, z + 8.4), C(90, 230, 255), { Solid = true })
	-- back panel + big sign
	Kit.Box(m, V(back - 0.6, 0, z - 10.5), V(back + 0.6, 17, z + 10.5), C(110, 70, 200), { Solid = true })
	local signCF = CFrame.new(back + dir * 0.9, 13.2, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(19, 5, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(20, 6, 0.3), signCF * CFrame.new(0, 0, 0.4), trim, { Mat = NEON })
	Kit.Sign(sign, Enum.NormalId.Front, "⚡ UPGRADES ⚡", trim)
	-- upgrade icons
	for i, upId in Config.UpgradeOrder do
		local up = Config.Upgrades[upId]
		local icf = CFrame.new(back + dir * 0.8, 7.8, z + (i - 2) * 6) * CFrame.Angles(0, yaw, 0)
		local icon = Kit.Part(m, V(4.4, 4.4, 0.4), icf, C(60, 40, 110))
		Kit.Part(m, V(5, 5, 0.3), icf * CFrame.new(0, 0, 0.3), color, { Mat = NEON })
		Kit.Sign(icon, Enum.NormalId.Front, up.Icon, WHITE)
	end
	-- gadgets on the bench
	Kit.CylFlat(m, 4.5, 1.6, V(bx, 5, z - 4.5), "Z", C(255, 120, 200))
	Kit.CylFlat(m, 1.5, 0.8, V(bx, 5, z - 7.4), "Z", C(140, 255, 160), { Mat = NEON })
	for i = 0, 1 do
		Kit.Cyl(m, 3.2, 1.6, CFrame.new(bx, 5.8, z + 1 + i * 2.2), C(120, 255, 170), { Mat = NEON, Transp = 0.25 })
		Kit.Cyl(m, 0.5, 1.8, CFrame.new(bx, 7.6, z + 1 + i * 2.2), C(70, 70, 90))
	end
	Kit.CylFlat(m, 0.6, 3.2, V(bx, 5.9, z + 6), "X", C(255, 210, 70))
	Kit.Ball(m, 1.2, V(bx, 5.9, z + 6), C(255, 120, 60), { Mat = NEON })
	-- striped awning on posts
	local tilt = -dir * 0.22
	local stripes = { C(255, 140, 50), C(160, 90, 255) }
	for i = 0, 3 do
		local sz = z - 8.25 + i * 5.5
		Kit.Part(m, V(9, 0.5, 5.5), CFrame.new(bx - dir * 0.5, 17.2, sz) * CFrame.Angles(0, 0, tilt), stripes[(i % 2) + 1], { Shadow = true })
	end
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(bx + dir * 3.7 - 0.4, 0, z + sz * 10.5 - 0.4), V(bx + dir * 3.7 + 0.4, 16.3, z + sz * 10.5 + 0.4), C(70, 50, 110))
	end
	local bulb = Kit.Ball(m, 1.4, V(bx + dir * 2, 15, z), C(255, 240, 160), { Mat = NEON })
	Kit.Light(bulb, C(255, 220, 150), 18, 1.5)

	Kit.AddCircle(x - dir * 4, z, 14)
	m.PrimaryPart = padPart
end

function Stations.Build(map: Instance)
	local folder = Kit.Folder(map, "Stations")
	for id, pos in Kit.CrateStations(Config.Layout) do
		local crate = Config.Crates[id]
		if crate then
			local m = crateStation(folder, crate, pos)
			if id == "Beginner" then
				beginnerExtras(m, pos.X, pos.Z, crate)
			end
		end
	end
	upgradeStation(folder, Config.Layout.UpgradeStation)
end

return Stations
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="41">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">GHClient</string>
        </Properties>
        <Item class="Folder" referent="45">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- World liveliness + interactions:
--  * per-zone lighting blend (ambient + fog colour) as you walk between areas
--  * floating books/pumpkins (FloatingProp), flickering lights (FlickerLight), spinning
--    display crates (SpinProp) - one loop, only props near the camera are animated
--  * gates: open locally for zones you own, the NEW AREA UNLOCKED! sequence, sign text
--  * station prompts open the right panel
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local CratePanel = require(script.Parent.CratePanel)
local GatePanel = require(script.Parent.GatePanel)
local Reveal = require(script.Parent.Reveal)

local Ambience = {}

local player = Players.LocalPlayer
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end
local currentZone = 0
local unlocking: { [string]: boolean } = {}

type Prop = { Part: BasePart, Base: CFrame, Phase: number, Bob: number, Kind: string }
local props: { [BasePart]: Prop } = {}

local function addProp(inst: Instance, kind: string)
	if not inst:IsA("BasePart") or props[inst] then
		return
	end
	local bob = inst:GetAttribute("BobHeight")
	props[inst] = {
		Part = inst,
		Base = inst.CFrame,
		Phase = math.random() * 10,
		Bob = if type(bob) == "number" then bob else 0.6,
		Kind = kind,
	}
end

local flickers: { BasePart } = {}

local function blendZone(idx: number)
	local z = Config.Zones[idx]
	if not z then
		return
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { Ambient = z.Ambient, OutdoorAmbient = z.Ambient:Lerp(Color3.new(1, 1, 1), 0.15) }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, info, { Color = z.FogColor, Decay = z.FogColor:Lerp(Color3.new(0, 0, 0), 0.35) }):Play()
	end
end

local function gateParts(zoneId: string): (BasePart?, TextLabel?, ProximityPrompt?)
	local map = workspace:FindFirstChild("Map")
	local gates = map and map:FindFirstChild("Gates")
	local gate = gates and gates:FindFirstChild("Gate_" .. zoneId)
	if not gate then
		return nil, nil, nil
	end
	local barrier = gate:FindFirstChild("Barrier") :: BasePart?
	local sign = gate:FindFirstChild("Sign")
	local sg = sign and sign:FindFirstChildOfClass("SurfaceGui")
	local cost = sg and sg:FindFirstChild("CostLabel", true) :: TextLabel?
	local anchor = gate:FindFirstChild("PromptAnchor")
	local prompt = anchor and anchor:FindFirstChildOfClass("ProximityPrompt")
	return barrier, cost, prompt
end

local barrierOriginal: { [BasePart]: { Size: Vector3, CFrame: CFrame, Transparency: number } } = {}

local function applyGates()
	local d = State.Data
	if not d then
		return
	end
	for _, z in Config.Zones do
		if not Config.Layout.Gates[z.Id] or unlocking[z.Id] then
			continue
		end
		local barrier, cost, prompt = gateParts(z.Id)
		local owned = d.Zones[z.Id] == true
		if barrier then
			if not barrierOriginal[barrier] then
				barrierOriginal[barrier] = { Size = barrier.Size, CFrame = barrier.CFrame, Transparency = barrier.Transparency }
			end
			local o = barrierOriginal[barrier]
			barrier.CanCollide = not owned
			barrier.Transparency = if owned then 1 else o.Transparency
			if not owned then
				barrier.Size = o.Size
				barrier.CFrame = o.CFrame
			end
		end
		if cost then
			cost.Text = if owned then "✓ UNLOCKED" else "🔒 " .. Format.Commas(z.Cost) .. " ECTOPLASM"
		end
		if prompt then
			prompt.Enabled = not owned
		end
	end
end

local function unlockSequence(zoneId: string)
	local zone = Config.ZoneById[zoneId]
	if not zone then
		return
	end
	unlocking[zoneId] = true
	local barrier, cost, prompt = gateParts(zoneId)
	Sound.Play("ZoneUnlock")
	Hud.Banner("NEW AREA UNLOCKED!", zone.Name .. "  •  NEW GHOSTS  •  NEW CRATE", zone.Accent)
	if prompt then
		prompt.Enabled = false
	end
	if cost then
		cost.Text = "✓ UNLOCKED"
	end
	-- camera emphasis: quick punch-in + shake
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = 58
		TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Back), { FieldOfView = 70 }):Play()
	end
	if barrier then
		barrier.CanCollide = false
		local cf = barrier.CFrame
		local size = barrier.Size
		barrier.Color = Color3.new(1, 1, 1)
		TweenService:Create(barrier, TweenInfo.new(0.25), { Color = zone.Accent }):Play()
		for i = -2, 2 do
			local p = cf.Position + cf.RightVector * (i * size.X / 5) + Vector3.new(0, -size.Y / 2 + 4, 0)
			Effects.Burst(p, { Color = zone.Accent, Color2 = Color3.new(1, 1, 1), Count = 30, Size = 1.4, Speed = 24, Life = 1 })
		end
		Effects.Ring(cf.Position - Vector3.new(0, size.Y / 2 - 0.3, 0), zone.Accent, 30, 0.9)
		task.wait(0.3)
		-- the force field drains into the ground
		TweenService:Create(barrier, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(size.X, 0.2, size.Z),
			CFrame = cf - Vector3.new(0, size.Y / 2, 0),
			Transparency = 1,
		}):Play()
		task.wait(1.2)
	end
	unlocking[zoneId] = nil
	applyGates()
end

local function step()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	for part, p in props do
		if (p.Base.Position - camPos).Magnitude > 160 then
			continue
		end
		local cf
		if p.Kind == "Spin" then
			cf = p.Base * CFrame.new(0, math.sin(t * 1.8 + p.Phase) * 0.4, 0) * CFrame.Angles(0, t * 0.9, 0)
		else
			cf = p.Base * CFrame.new(0, math.sin(t * 1.4 + p.Phase) * p.Bob, 0) * CFrame.Angles(math.sin(t * 0.9 + p.Phase) * 0.12, t * 0.35 + p.Phase, math.cos(t * 0.7 + p.Phase) * 0.1)
		end
		table.insert(parts, part)
		table.insert(cfs, cf)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ambience.Init() end

function Ambience.Start()
	for _, inst in CollectionService:GetTagged("FloatingProp") do
		addProp(inst, "Float")
	end
	CollectionService:GetInstanceAddedSignal("FloatingProp"):Connect(function(inst)
		addProp(inst, "Float")
	end)
	for _, inst in CollectionService:GetTagged("SpinProp") do
		addProp(inst, "Spin")
	end
	CollectionService:GetInstanceAddedSignal("SpinProp"):Connect(function(inst)
		addProp(inst, "Spin")
	end)
	for _, inst in CollectionService:GetTagged("FlickerLight") do
		if inst:IsA("BasePart") then
			table.insert(flickers, inst)
		end
	end
	-- flicker: every so often one light stutters
	task.spawn(function()
		while true do
			task.wait(0.15 + math.random() * 0.35)
			if #flickers > 0 then
				local part = flickers[math.random(1, #flickers)]
				local light = part:FindFirstChildWhichIsA("Light")
				if light then
					local n = math.random(1, 3)
					for _ = 1, n do
						light.Enabled = false
						part.Transparency = 0.6
						task.wait(0.04 + math.random() * 0.08)
						light.Enabled = true
						part.Transparency = 0
						task.wait(0.03 + math.random() * 0.06)
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)

	-- zone blend
	task.spawn(function()
		while true do
			task.wait(0.5)
			local cam = workspace.CurrentCamera
			if cam and not Reveal.IsPlaying() then
				local idx = Rules.ZoneIndexAt(cam.Focus.Position.Z, zoneRanges)
				if idx ~= currentZone then
					currentZone = idx
					blendZone(idx)
				end
			end
		end
	end)

	-- gates
	State.Changed:Connect(applyGates)
	Net.Event("Fx").OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "ZoneUnlocked" and type(data) == "table" and type(data.Zone) == "string" then
			task.spawn(unlockSequence, data.Zone)
		end
	end)

	-- prompts → panels
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player or Reveal.IsPlaying() then
			return
		end
		local crate = prompt:GetAttribute("Crate")
		local station = prompt:GetAttribute("Station")
		local zone = prompt:GetAttribute("Zone")
		if type(crate) == "string" then
			CratePanel.Open(crate)
		elseif station == "Upgrades" then
			Hud.Open("Upgrades")
		elseif type(zone) == "string" then
			GatePanel.Open(zone)
		end
	end)
	-- keep prompts out of the way while a menu is open
	Kit.PanelOpened:Connect(function(name)
		ProximityPromptService.Enabled = name == nil
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Boss</string>
              <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST event presentation: warning announcement + countdown, a beacon over the
-- arena, dramatic spawn (flash, rings, camera shake), a big boss Spirit bar with timer, and
-- defeat / escape banners. Rewards arrive as normal Ectoplasm drops (the shower).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Boss = {}

local player = Players.LocalPlayer
local frame: Frame
local fill: Frame
local spiritLabel: TextLabel
local timerLabel: TextLabel
local titleLabel: TextLabel
local goButton: TextButton
local beacon: Part? = nil
local state = "Idle"
local warnAt = 0
local endsAt = 0
local bossUid = 0
local arenaPos = Config.Layout.EventArena.Center

local function setBeacon(on: boolean)
	if on and not beacon then
		local b = Instance.new("Part")
		b.Name = "BossBeacon"
		b.Shape = Enum.PartType.Cylinder
		b.Anchored = true
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CastShadow = false
		b.Material = Enum.Material.Neon
		b.Color = Color3.fromRGB(255, 120, 230)
		b.Transparency = 0.55
		b.Size = Vector3.new(220, 5, 5)
		b.CFrame = CFrame.new(arenaPos + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
		b.Parent = workspace
		beacon = b
		task.spawn(function()
			while beacon == b do
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.8 }):Play()
				task.wait(0.6)
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.45 }):Play()
				task.wait(0.6)
			end
		end)
	elseif not on and beacon then
		beacon:Destroy()
		beacon = nil
	end
end

local function show(on: boolean)
	if on == frame.Visible then
		return
	end
	frame.Visible = true
	local sc = frame:FindFirstChildOfClass("UIScale") :: UIScale
	if on then
		sc.Scale = 0.4
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		Kit.Tween(sc, 0.2, { Scale = 0.4 })
		task.delay(0.2, function()
			frame.Visible = false
		end)
	end
end

local function nearArena(): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - arenaPos).Magnitude < 150
end

local function onBoss(data: any)
	if data.Pos then
		arenaPos = data.Pos
	end
	if data.State == "Warning" then
		state = "Warning"
		warnAt = data.At or 0
		Hud.Announce("⚠️ GIANT POLTERGEIST INCOMING!", Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 200, 60))
		Sound.Play("BossAppear")
		setBeacon(true)
		titleLabel.Text = "⚠️ GIANT POLTERGEIST"
		fill.Size = UDim2.fromScale(1, 1)
		spiritLabel.Text = "APPEARS SOON!"
		goButton.Visible = not nearArena()
		show(true)
	elseif data.State == "Active" then
		state = "Active"
		bossUid = data.Uid or 0
		endsAt = data.EndsAt or 0
		titleLabel.Text = "👑 GIANT POLTERGEIST"
		setBeacon(true)
		Sound.Boss(true)
		show(true)
		if nearArena() then
			Sound.Play("BossAppear")
			Effects.Flash(arenaPos + Vector3.new(0, 14, 0), Color3.fromRGB(255, 120, 230), 30, 0.7)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Color3.fromRGB(255, 230, 90), 40, 0.9)
			Effects.Burst(arenaPos + Vector3.new(0, 14, 0), { Color = Color3.fromRGB(255, 120, 230), Color2 = Color3.fromRGB(255, 230, 90), Count = 120, Size = 2.5, Speed = 40, Life = 1.2 })
			-- camera shake
			task.spawn(function()
				local cam = workspace.CurrentCamera
				local t0 = os.clock()
				while os.clock() - t0 < 0.6 do
					local k = 0.6 * (1 - (os.clock() - t0) / 0.6)
					cam.CFrame *= CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
					RunService.RenderStepped:Wait()
				end
			end)
		end
	elseif data.State == "Defeated" then
		state = "Idle"
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("GIANT POLTERGEIST DEFEATED!", "Grab the Ectoplasm shower!", Theme.Gold)
		if data.Pos and nearArena() then
			Effects.Poof(data.Pos, Color3.fromRGB(255, 120, 230), 4, true)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Theme.Ecto, 45, 1)
		end
	elseif data.State == "Escaped" then
		state = "Idle"
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("IT ESCAPED...", "It'll be back. Bring more hunters!", Theme.Muted)
	end
end

function Boss.Init()
	local screen = Kit.Screen()
	frame = Kit.new("Frame", {
		Name = "BossBar",
		Size = UDim2.fromOffset(560, 92),
		Position = UDim2.new(0.5, 0, 0, 142),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		Parent = screen,
	})
	Kit.Corner(frame, UDim.new(0, 18))
	Kit.Stroke(frame, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(frame, Color3.fromRGB(110, 40, 120), Color3.fromRGB(50, 20, 70), 90)
	Kit.new("UIScale", { Parent = frame })
	titleLabel = Kit.Label(frame, "👑 GIANT POLTERGEIST", { Size = UDim2.new(0.7, 0, 0, 30), Position = UDim2.fromOffset(14, 6), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, ZIndex = 31 })
	timerLabel = Kit.Label(frame, "", { Size = UDim2.new(0.28, 0, 0, 28), Position = UDim2.new(1, -14, 0, 7), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, ZIndex = 31 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(1, -28, 0, 36), Position = UDim2.fromOffset(14, 44), BackgroundColor3 = Color3.fromRGB(30, 12, 45), ZIndex = 31, Parent = frame })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 32, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 220, 80), 0)
	spiritLabel = Kit.Label(bar, "", { Size = UDim2.fromScale(0.94, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 33 })
	-- "take me there" helper: walks you nowhere, just points the way (see Tutorial arrow)
	goButton = Kit.Button(frame, {
		Text = "📍 SHOW ME",
		Color = "Pink",
		Size = UDim2.fromOffset(150, 44),
		Position = UDim2.new(0.5, 0, 1, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 31,
		OnClick = function()
			Boss.PointRequested:Fire()
		end,
	})
	goButton.Visible = false
end

Boss.PointRequested = Instance.new("BindableEvent")

function Boss.State(): (string, Vector3)
	return state, arenaPos
end

function Boss.Start()
	Net.Event("Fx").OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "Boss" then
			onBoss(data)
		end
	end)
	RunService.Heartbeat:Connect(function()
		if state == "Warning" then
			local left = math.max(0, warnAt - workspace:GetServerTimeNow())
			timerLabel.Text = Format.Time(left)
			goButton.Visible = not nearArena()
		elseif state == "Active" then
			local left = math.max(0, endsAt - workspace:GetServerTimeNow())
			timerLabel.Text = "⏱ " .. Format.Time(left)
			timerLabel.TextColor3 = if left < 20 then Theme.Bad else Theme.Text
			goButton.Visible = not nearArena()
			local e = Ghosts.Get(bossUid)
			if e then
				local frac = math.clamp(e.Spirit / math.max(e.Max, 1), 0, 1)
				fill.Size = UDim2.fromScale(math.max(frac, 0.01), 1)
				spiritLabel.Text = Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max) .. " SPIRIT"
			end
		end
	end)
end

return Boss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">CratePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Crate station panel: odds (with luck boost), possible hunters, price and the OPEN button.
-- Opened by the station's ProximityPrompt. The server rolls; we only play the reveal.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Reveal = require(script.Parent.Reveal)

local CratePanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local list: Frame
local openButton: TextButton
local infoLabel: TextLabel
local luckLabel: TextLabel
local current: string? = nil
local busy = false
local openedSignal = Instance.new("BindableEvent")
CratePanel.Opened = openedSignal.Event -- (result) after a successful purchase

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function nearStation(crateId: string): boolean
	local pos = Config.Layout.CrateStations[crateId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return pos ~= nil and root ~= nil and (root.Position - pos).Magnitude < 28
end

local cardsKey = ""
local refreshCards: (string, any, { [string]: number }, number) -> ()
local refreshButton: (string, any, number) -> ()

local function refresh()
	local crateId = current
	local d = State.Data
	if not crateId or not d then
		return
	end
	local crate = Config.Crates[crateId]
	panel.Title.Text = crate.Name
	local luck = d.LuckMultiplier or 1
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, luck, Config.LuckAffectsFromOrder)
	-- cards only change with the crate, luck or discoveries; the button changes with Ectoplasm
	local key = crateId .. "|" .. luck
	for _, e in crate.Pool do
		key ..= if d.Discovered[e.Hunter] then "1" else "0"
	end
	if key ~= cardsKey then
		cardsKey = key
		refreshCards(crateId, d, odds, luck)
	end
	refreshButton(crateId, d, luck)
end

function refreshCards(crateId: string, d: any, odds: { [string]: number }, luck: number)
	local crate = Config.Crates[crateId]
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local found = d.Discovered[e.Hunter] == true
		local card: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(176, 236),
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = list,
		})
		Kit.Corner(card, UDim.new(0, 18))
		Kit.Stroke(card, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(card, rar.Color, rar.Color2, 90)
		local pic: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(120, 120),
			Position = UDim2.new(0.5, 0, 0, 10),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(30, 18, 55),
			BackgroundTransparency = 0.3,
			ZIndex = 63,
			Parent = card,
		})
		Kit.Corner(pic, UDim.new(1, 0))
		Portrait.Face(pic, e.Hunter, not found)
		Kit.Label(card, if found then string.upper(def.Name) else "???", { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 134), ZIndex = 64 })
		Kit.Label(card, rar.Name, { Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 164), ZIndex = 64, Color = Color3.fromRGB(255, 255, 240) })
		Kit.Label(card, "⚡ " .. Format.Commas(def.Power), { Size = UDim2.new(0.55, 0, 0, 26), Position = UDim2.fromOffset(8, 196), ZIndex = 64, Color = Theme.Gold, Align = Enum.TextXAlignment.Left })
		local pct = Kit.Label(card, Format.Percent(odds[e.Hunter]), { Size = UDim2.new(0.42, 0, 0, 28), Position = UDim2.new(1, -8, 0, 195), AnchorPoint = Vector2.new(1, 0), ZIndex = 64, Align = Enum.TextXAlignment.Right })
		if luck > 1 and rar.Order >= Config.LuckAffectsFromOrder then
			pct.TextColor3 = Theme.Ecto
		end
	end
end

function refreshButton(crateId: string, d: any, luck: number)
	local crate = Config.Crates[crateId]
	local free = d.FreeCrates[crateId] or 0
	local price = crate.Price
	if free > 0 then
		Kit.SetButtonText(openButton, "OPEN FREE! (" .. free .. ")")
		openButton:SetAttribute("Color", "Orange")
	elseif d.Ecto >= price then
		Kit.SetButtonText(openButton, "OPEN  💚 " .. Format.Commas(price))
		openButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(openButton, "NEED 💚 " .. Format.Short(price - d.Ecto) .. " MORE")
		openButton:SetAttribute("Color", "Gray")
	end
	if not d.Zones[crate.Zone] then
		infoLabel.Text = "Unlock " .. (Config.ZoneById[crate.Zone] :: Config.ZoneDef).Name .. " to open this crate"
	else
		infoLabel.Text = "Hunters jump out of crates! Better crates → stronger hunters."
	end
	luckLabel.Visible = luck > 1
end

local function buy()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	local d = State.Data
	local crate = Config.Crates[crateId]
	if d and (d.FreeCrates[crateId] or 0) <= 0 and d.Ecto < crate.Price then
		Kit.Toast("Defeat ghosts to collect more Ectoplasm!", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	local result: Reveal.Result = { Crate = crateId, Hunter = res.Hunter, Uid = res.Uid, IsNew = res.IsNew == true }
	openedSignal:Fire(result)
	local function again()
		if busy then
			return
		end
		local dd = State.Data
		if dd and (dd.FreeCrates[crateId] or 0) <= 0 and dd.Ecto < crate.Price then
			Kit.Toast("Not enough Ectoplasm!", "Bad")
			return
		end
		busy = true
		local r2 = State.Request("OpenCrate", crateId)
		busy = false
		if r2.ok then
			local res2: Reveal.Result = { Crate = crateId, Hunter = r2.Hunter, Uid = r2.Uid, IsNew = r2.IsNew == true }
			openedSignal:Fire(res2)
			Reveal.Play(res2, again)
		else
			Kit.Toast(r2.err or "Couldn't open the crate", "Bad")
		end
	end
	Reveal.Play(result, again)
end

function CratePanel.Open(crateId: string)
	if not Config.Crates[crateId] or Reveal.IsPlaying() then
		return
	end
	current = crateId
	refresh()
	panel:Open()
end

function CratePanel.Init()
	panel = Kit.Panel("Crate", "HUNTER CRATE", Vector2.new(820, 470), "Orange")
	infoLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 14), Color = Theme.Muted, Font = Theme.Body, ZIndex = 62, Stroke = 0 })
	luckLabel = Kit.Label(panel.Body, "🍀 LUCK BOOST ACTIVE: rare odds boosted!", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 40), Color = Theme.Ecto, ZIndex = 62 })
	luckLabel.Visible = false
	list = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 240),
		Position = UDim2.fromOffset(0, 70),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	openButton = Kit.Button(panel.Body, {
		Text = "OPEN",
		Color = "Green",
		Size = UDim2.fromOffset(340, 72),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = buy,
	})
	openButton.Name = "OpenButton"
end

function CratePanel.Start()
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

function CratePanel.Button(): TextButton
	return openButton
end

function CratePanel.IsOpen(): boolean
	return panel.IsOpen
end

return CratePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Crew</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every player's equipped Ghost Hunters (client-side, never collide with anything).
-- Idle: follow in a formation behind their player. Assigned (player's "Target" attribute):
-- run to a ring around the ghost, aim and fire a wobbly energy beam, celebrate on the poof,
-- then come back. All crews update in ONE RenderStepped loop: BulkMoveTo for roots, Motor6D
-- transforms for poses, staggered ground raycasts, and far-away crews are hidden.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local HunterRig = require(GH.Rigs.HunterRig)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Crew = {}

type Member = {
	Id: string,
	Rig: HunterRig.Rig,
	Pos: Vector3,
	Yaw: number,
	State: string,
	GroundY: number,
	NextRay: number,
	Beam: Beam,
	CelebrateUntil: number,
	Phase: number,
	Color: Color3,
}

type CrewData = {
	Player: Player,
	Members: { Member },
	Visible: boolean,
	LastTarget: number,
	NextSpark: number,
	NextSound: number,
	Conns: { RBXScriptConnection },
}

local player = Players.LocalPlayer
local crews: { [Player]: CrewData } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local nextFilter = 0

local VISIBLE_RANGE = 170
local HUNTER_SCALE = 0.88 -- rigs are ~4-4.6 studs; this puts them at a player's chest height
local RUN_SPEED = Config.Combat.HunterRunSpeed

local function refreshFilter()
	local list: { Instance } = { folder }
	for _, name in { "Ghosts", "GHEffects", "GHOrbs", "GHReveal" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function makeBeam(m: Member)
	local beam = Instance.new("Beam")
	beam.Name = "CaptureBeam"
	beam.Attachment0 = m.Rig.Tip
	beam.Color = ColorSequence.new(m.Color, Color3.new(1, 1, 1))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.8, 0.15), NumberSequenceKeypoint.new(1, 0.4) })
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Width0 = 0.35
	beam.Width1 = 0.9
	beam.Enabled = false
	beam.Parent = m.Rig.Model
	m.Beam = beam
end

local function addTag(m: Member, isLocal: boolean)
	local def = Config.Hunters[m.Id]
	local rar = Config.Rarities[def.Rarity]
	local gui: BillboardGui = Kit.new("BillboardGui", {
		Name = "Tag",
		Size = UDim2.fromOffset(150, 34),
		StudsOffsetWorldSpace = Vector3.new(0, m.Rig.Height + 0.9, 0),
		MaxDistance = if isLocal then 38 else 22,
		LightInfluence = 0,
		Adornee = m.Rig.Root,
		Parent = m.Rig.Model,
	})
	Kit.Label(gui, def.Name, { Size = UDim2.fromScale(1, 0.58), Color = Color3.new(1, 1, 1), Stroke = 2 })
	Kit.Label(gui, rar.Name, { Size = UDim2.fromScale(1, 0.42), Position = UDim2.fromScale(0, 0.58), Color = rar.Color, Stroke = 2 })
	-- rare+ hunters stand on a soft rarity-coloured glow disc
	if rar.Order >= 3 then
		local disc = Instance.new("Part")
		disc.Name = "RarityDisc"
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.12, 3.4, 3.4)
		disc.Material = Enum.Material.Neon
		disc.Color = rar.Color
		disc.Transparency = 0.55
		disc.CanCollide = false
		disc.CanQuery = false
		disc.CanTouch = false
		disc.CastShadow = false
		disc.Massless = true
		disc.CFrame = m.Rig.Root.CFrame * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = m.Rig.Root
		w.Part1 = disc
		w.Parent = disc
		disc.Parent = m.Rig.Model
	end
end

local function newMember(id: string, at: Vector3, isLocal: boolean): Member
	local rig = HunterRig.Build(id)
	rig.Model:ScaleTo(HUNTER_SCALE)
	rig.Height *= HUNTER_SCALE
	for _, p in rig.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	rig.Model:PivotTo(CFrame.new(at))
	rig.Model.Parent = folder
	local def = Config.Hunters[id]
	local m: Member = {
		Id = id,
		Rig = rig,
		Pos = at,
		Yaw = 0,
		State = "Idle",
		GroundY = at.Y,
		NextRay = 0,
		Beam = nil :: any,
		CelebrateUntil = 0,
		Phase = math.random() * 10,
		Color = def.Look.Beam,
	}
	makeBeam(m)
	addTag(m, isLocal)
	return m
end

local function rootOf(pl: Player): BasePart?
	local char = pl.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function rebuild(c: CrewData)
	local raw = c.Player:GetAttribute("Crew")
	local ids = {}
	if type(raw) == "string" and raw ~= "" then
		for id in raw:gmatch("[^,]+") do
			if Config.Hunters[id] and #ids < 12 then
				table.insert(ids, id)
			end
		end
	end
	local root = rootOf(c.Player)
	local at = if root then root.Position - Vector3.new(0, 3, 0) else Vector3.zero
	local isLocal = c.Player == player
	for i, id in ids do
		local m = c.Members[i]
		if not m or m.Id ~= id then
			if m then
				m.Rig.Model:Destroy()
			end
			local spawnAt = if m then m.Pos else at + Vector3.new((i - 2.5) * 2, 0, 3)
			c.Members[i] = newMember(id, spawnAt, isLocal)
			if isLocal and m == nil and os.clock() > 3 then
				Effects.Burst(spawnAt + Vector3.new(0, 2, 0), { Color = Config.Rarities[Config.Hunters[id].Rarity].Color, Count = 14, Size = 0.7, Speed = 10 })
			end
		end
	end
	for i = #c.Members, #ids + 1, -1 do
		c.Members[i].Rig.Model:Destroy()
		c.Members[i] = nil
	end
	if not c.Visible then
		for _, m in c.Members do
			m.Rig.Model.Parent = nil
		end
	end
end

local function addPlayer(pl: Player)
	if crews[pl] then
		return
	end
	local c: CrewData = {
		Player = pl,
		Members = {},
		Visible = true,
		LastTarget = 0,
		NextSpark = 0,
		NextSound = 0,
		Conns = {},
	}
	crews[pl] = c
	table.insert(c.Conns, pl:GetAttributeChangedSignal("Crew"):Connect(function()
		rebuild(c)
	end))
	rebuild(c)
end

local function removePlayer(pl: Player)
	local c = crews[pl]
	if not c then
		return
	end
	for _, conn in c.Conns do
		conn:Disconnect()
	end
	for _, m in c.Members do
		m.Rig.Model:Destroy()
	end
	crews[pl] = nil
end

local function setVisible(c: CrewData, on: boolean, root: BasePart?)
	if c.Visible == on then
		return
	end
	c.Visible = on
	for i, m in c.Members do
		m.Rig.Model.Parent = if on then folder else nil
		if on and root then
			-- snap back into formation instead of sprinting across the map
			m.Pos = root.Position + Vector3.new((i - 2.5) * 2.5, -3, 4)
			m.NextRay = 0
		end
	end
end

local function angleDiff(a: number, b: number): number
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

local function centerAttachment(e: Ghosts.Entry): Attachment
	local a = e.Core:FindFirstChild("Center")
	if a and a:IsA("Attachment") then
		return a
	end
	local made = Instance.new("Attachment")
	made.Name = "Center"
	made.Parent = e.Core
	return made
end

local roots: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	dt = math.min(dt, 0.1)
	local clock = os.clock()
	if clock > nextFilter then
		nextFilter = clock + 2
		refreshFilter()
	end
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(roots)
	table.clear(cframes)

	for pl, c in crews do
		local root = rootOf(pl)
		local isLocal = pl == player
		if not root or #c.Members == 0 then
			setVisible(c, false, nil)
			continue
		end
		local far = not isLocal and (root.Position - camPos).Magnitude > VISIBLE_RANGE
		setVisible(c, not far, root)
		if far then
			continue
		end
		local footY = root.Position.Y - 3
		local uid = (pl:GetAttribute("Target") :: number?) or 0
		local ghost = if uid ~= 0 then Ghosts.Get(uid) else nil
		if ghost and (ghost.Pos - root.Position).Magnitude > Config.Combat.MaxRange * 1.5 then
			ghost = nil
		end
		if ghost then
			c.LastTarget = uid
		end
		local n = #c.Members
		local anyAttacking = false
		local rootLook = root.CFrame.LookVector
		local rootYaw = math.atan2(-rootLook.X, -rootLook.Z)
		local flatRoot = CFrame.new(root.Position) * CFrame.Angles(0, rootYaw, 0)
		local speedNow = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude

		for i, m in c.Members do
			local goal: Vector3
			local faceTo: Vector3? = nil
			local attackMode = false
			if m.CelebrateUntil > clock then
				goal = m.Pos
			elseif ghost then
				attackMode = true
				local gp = ghost.Pos
				local away = Vector3.new(root.Position.X - gp.X, 0, root.Position.Z - gp.Z)
				local base = if away.Magnitude > 0.1 then math.atan2(away.X, away.Z) else 0
				local spread = math.rad(math.min(160, 42 * (n - 1)))
				local a = base + (if n > 1 then -spread / 2 + spread * (i - 1) / (n - 1) else 0)
				local r = 3.2 + ghost.Def.Scale * 2.2
				goal = Vector3.new(gp.X + math.sin(a) * r, m.Pos.Y, gp.Z + math.cos(a) * r)
				faceTo = gp
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local inRow = math.min(3, n - row * 3)
				local x = (col - (inRow - 1) / 2) * 3.2
				local z = 4.6 + row * 3.4
				goal = (flatRoot * CFrame.new(x, 0, z)).Position
			end
			-- move (XZ), teleport if hopelessly far
			local delta = Vector3.new(goal.X - m.Pos.X, 0, goal.Z - m.Pos.Z)
			local dist = delta.Magnitude
			if dist > 75 then
				m.Pos = Vector3.new(goal.X, footY, goal.Z)
				m.NextRay = 0
				dist = 0
			elseif dist > 0.05 then
				local speed = if attackMode then RUN_SPEED else math.max(14, speedNow * 1.15 + dist * 2)
				local stepLen = math.min(dist, speed * dt)
				m.Pos += delta.Unit * stepLen
			end
			-- ground snap (staggered raycasts)
			if clock >= m.NextRay then
				m.NextRay = clock + 0.18 + math.random() * 0.08
				local hit = workspace:Raycast(Vector3.new(m.Pos.X, root.Position.Y + 3, m.Pos.Z), Vector3.new(0, -20, 0), rayParams)
				m.GroundY = if hit then math.clamp(hit.Position.Y, footY - 10, footY + 4) else footY
			end
			local y = m.Pos.Y + (m.GroundY - m.Pos.Y) * math.min(1, dt * 14)
			m.Pos = Vector3.new(m.Pos.X, y, m.Pos.Z)

			-- facing
			local wantYaw = m.Yaw
			if faceTo and dist < 4 then
				local f = Vector3.new(faceTo.X - m.Pos.X, 0, faceTo.Z - m.Pos.Z)
				if f.Magnitude > 0.1 then
					wantYaw = math.atan2(-f.X, -f.Z)
				end
			elseif dist > 0.6 then
				wantYaw = math.atan2(-delta.X, -delta.Z)
			elseif not ghost then
				wantYaw = rootYaw
			end
			m.Yaw += angleDiff(m.Yaw, wantYaw) * math.min(1, dt * 12)

			-- state
			local state
			if m.CelebrateUntil > clock then
				state = "Celebrate"
			elseif attackMode and dist < 4 then
				state = "Attack"
			elseif dist > 0.6 then
				state = "Run"
			else
				state = "Idle"
			end
			m.State = state
			HunterRig.Pose(m.Rig, state, clock + m.Phase, 1)

			-- beam
			local beam = m.Beam
			if state == "Attack" and ghost then
				anyAttacking = true
				local att = centerAttachment(ghost)
				if beam.Attachment1 ~= att then
					beam.Attachment1 = att
				end
				beam.Enabled = true
				local w = math.sin(clock * 9 + m.Phase)
				beam.CurveSize0 = w * 1.6
				beam.CurveSize1 = -w * 1.1
				beam.Width0 = 0.3 + 0.12 * math.sin(clock * 22 + m.Phase)
				beam.Width1 = 0.7 + 0.25 * math.sin(clock * 17 + m.Phase)
			elseif beam.Enabled then
				beam.Enabled = false
			end

			table.insert(roots, m.Rig.Root)
			table.insert(cframes, CFrame.new(m.Pos) * CFrame.Angles(0, m.Yaw, 0))
		end

		-- impact sparks + soft zaps for your own crew only (keeps busy servers cheap)
		if isLocal and anyAttacking and ghost then
			if clock >= c.NextSpark then
				c.NextSpark = clock + 0.3
				local m = c.Members[math.random(1, n)]
				local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * ghost.Def.Scale * 2
				Effects.Burst(ghost.Pos + off, { Color = m.Color, Count = 7, Size = 0.5, Speed = 9, Life = 0.4 })
			end
			if clock >= c.NextSound then
				c.NextSound = clock + 0.45
				Sound.Play("Attack", 0.15)
			end
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Crew.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHCrews"
	folder.Parent = workspace
end

function Crew.Start()
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(removePlayer)
	for _, pl in Players:GetPlayers() do
		addPlayer(pl)
	end
	-- victory pose when a ghost they were fighting poofs
	Ghosts.Died:Connect(function(uid: number)
		local until_ = os.clock() + 0.9
		for _, c in crews do
			if c.LastTarget == uid then
				for _, m in c.Members do
					if m.State == "Attack" then
						m.CelebrateUntil = until_
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

-- Local crew members (for the crate reveal / tutorial).
function Crew.LocalCount(): number
	local c = crews[player]
	return if c then #c.Members else 0
end

return Crew
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">DailyPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DAILY reward: Day 1-7 tiles, a big golden Day 7, CLAIM button or a countdown.
-- Timing is decided by the server's clock (the client only displays it).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local DailyPanel = {}

type Tile = { Frame: Frame, Check: TextLabel, Today: TextLabel, Reward: TextLabel, Scale: UIScale }

local panel: Kit.Panel
local tiles: { Tile } = {}
local claimButton: TextButton
local statusLabel: TextLabel
local busy = false

local function rewardLabel(i: number, mult: number): string
	local r = Config.Daily.Rewards[i]
	if r.Amount and mult > 1 then
		return (r.Label:gsub(Format.Commas(r.Amount), Format.Commas(r.Amount * mult)))
	end
	return r.Label
end

local function remaining(d: any): number
	local info = d.DailyInfo
	if not info then
		return 0
	end
	return math.max(0, info.Wait - (State.Now() - (d.ServerTime or State.Now())))
end

local function refresh()
	local d = State.Data
	if not d or not d.DailyInfo then
		return
	end
	local info = d.DailyInfo
	local left = remaining(d)
	local canClaim = info.CanClaim or left <= 0
	local day = info.Day
	local claimed = if canClaim then day - 1 elseif day == 1 then #Config.Daily.Rewards else day - 1
	local mult = d.ZoneMultiplier or 1
	for i, t in tiles do
		t.Reward.Text = rewardLabel(i, mult)
		t.Check.Visible = i <= claimed
		t.Today.Visible = canClaim and i == day
		t.Frame.BackgroundTransparency = if i <= claimed then 0.45 else 0
	end
	if canClaim then
		Kit.SetButtonText(claimButton, "CLAIM DAY " .. day .. "!")
		claimButton:SetAttribute("Color", "Green")
		statusLabel.Text = if info.StreakBroken then "Streak reset - start again from Day 1!" else "Come back every day for bigger rewards!"
	else
		Kit.SetButtonText(claimButton, "NEXT IN " .. Format.Time(left))
		claimButton:SetAttribute("Color", "Gray")
		statusLabel.Text = "Day " .. day .. " unlocks in " .. Format.Time(left) .. ". Don't miss a day or your streak resets!"
	end
end

local function claim()
	if busy then
		return
	end
	busy = true
	local res = State.Request("ClaimDaily")
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Not yet!", "Bad")
		return
	end
	Sound.Play("Daily")
	Hud.Banner("DAY " .. tostring(res.Day) .. " REWARD!", res.Label, Theme.Gold)
	local t = tiles[res.Day]
	if t then
		t.Scale.Scale = 1.25
		Kit.Tween(t.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Effects.Burst(root.Position + Vector3.new(0, 2, 0), { Color = Theme.Gold, Color2 = Theme.Ecto, Count = 50, Size = 1, Speed = 20 })
	end
end

function DailyPanel.Init()
	panel = Kit.Panel("Daily", "DAILY REWARDS", Vector2.new(820, 520), "Purple")
	local grid: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 330), Position = UDim2.fromOffset(0, 18), BackgroundTransparency = 1, ZIndex = 61, Parent = panel.Body })
	local W, H, G = 180, 156, 12
	local startX = (784 - (4 * W + 3 * G)) / 2
	for i = 1, #Config.Daily.Rewards do
		local big = i == #Config.Daily.Rewards
		local row = if i <= 4 then 0 else 1
		local col = if i <= 4 then i - 1 else i - 5
		local f: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(if big then 2 * W + G else W, H),
			Position = UDim2.fromOffset(startX + col * (W + G), row * (H + G)),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 62,
			Parent = grid,
		})
		Kit.Corner(f, UDim.new(0, 18))
		Kit.Stroke(f, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
		if big then
			Kit.Gradient(f, Theme.Gold, Color3.fromRGB(255, 120, 40), 90)
		else
			Kit.Gradient(f, Theme.Panel3, Theme.Panel2, 90)
		end
		local sc = Kit.new("UIScale", { Parent = f })
		Kit.Label(f, "DAY " .. i, { Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 8), ZIndex = 63 })
		local r = Config.Daily.Rewards[i]
		local icon = if r.Kind == "Day7" then "🎁" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "🍀" else "⚡") else "💚"
		Kit.Label(f, icon, { Size = UDim2.fromOffset(60, 50), Position = UDim2.new(0.5, 0, 0, 40), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 63, Stroke = 0 })
		local reward = Kit.Label(f, r.Label, { Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 98), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230) })
		local check = Kit.Label(f, "✓", { Size = UDim2.fromScale(0.6, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Good, ZIndex = 66, Stroke = 4 })
		check.Visible = false
		local today = Kit.Label(f, "TODAY!", { Size = UDim2.fromOffset(100, 28), Position = UDim2.new(1, 6, 0, -12), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, ZIndex = 67, Stroke = 3 })
		today.Rotation = 8
		today.Visible = false
		table.insert(tiles, { Frame = f, Check = check, Today = today, Reward = reward, Scale = sc })
	end
	statusLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -40, 0, 26), Position = UDim2.new(0, 20, 1, -96), Color = Theme.Muted, Font = Theme.Body, ZIndex = 62, Stroke = 0 })
	claimButton = Kit.Button(panel.Body, {
		Text = "CLAIM",
		Color = "Green",
		Size = UDim2.fromOffset(340, 64),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = claim,
	})
	Hud.RegisterPanel("Daily", function()
		panel:Toggle()
	end)
end

function DailyPanel.Start()
	panel.OnOpen.Event:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
	-- a returning player with a reward waiting gets the panel once, a few seconds after joining
	task.spawn(function()
		local d = State.WaitForData()
		task.wait(6)
		if d.DailyInfo and d.DailyInfo.CanClaim and (d.Tutorial or 1) > #Config.Tutorial.Steps and not Kit.CurrentPanel() then
			panel:Open()
		end
	end)
end

return DailyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Short-lived VFX helpers (bursts, rings, sparkles). All local, all self-cleaning, and capped
-- so a busy moment never turns into a GPU benchmark.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

Effects.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local folder: Folder
local live = 0
local MAX_LIVE = 24

local function holder(pos: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = folder
	return p
end

export type BurstOpts = {
	Color: Color3,
	Color2: Color3?,
	Count: number?,
	Size: number?,
	Speed: number?,
	Life: number?,
	Texture: string?,
	Spread: number?,
	Gravity: number?,
	LightEmission: number?,
}

function Effects.Burst(pos: Vector3, o: BurstOpts)
	if live >= MAX_LIVE then
		return
	end
	live += 1
	local p = holder(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or Effects.Textures.Sparkle
	e.Color = ColorSequence.new(o.Color, o.Color2 or o.Color)
	local size = o.Size or 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.6, size * 0.8), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	local life = o.Life or 0.7
	e.Lifetime = NumberRange.new(life * 0.6, life)
	local speed = o.Speed or 18
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Acceleration = Vector3.new(0, -(o.Gravity or 0), 0)
	e.Drag = 3
	e.LightEmission = o.LightEmission or 1
	e.Rate = 0
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = p
	e:Emit(math.min(o.Count or 20, 160))
	task.delay(life + 0.2, function()
		live -= 1
		p:Destroy()
	end)
end

-- Expanding flat neon ring on the ground / around a point.
function Effects.Ring(pos: Vector3, color: Color3, radius: number, time: number?)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Size = Vector3.new(0.3, 1, 1)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = folder
	local t = time or 0.5
	TweenService:Create(r, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(r, t + 0.05)
end

-- Expanding glowing sphere (poofs, reveal flashes).
function Effects.Flash(pos: Vector3, color: Color3, radius: number, time: number?)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.Neon
	s.Color = color
	s.Transparency = 0.15
	s.Size = Vector3.new(1, 1, 1) * radius * 0.4
	s.CFrame = CFrame.new(pos)
	s.Parent = folder
	local t = time or 0.35
	TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(1, 1, 1) * radius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(s, t + 0.05)
end

-- The signature ghost POOF: flash + cloud + sparkles + ring.
function Effects.Poof(pos: Vector3, color: Color3, scale: number, big: boolean)
	Effects.Flash(pos, Color3.new(1, 1, 1), 3 * scale, 0.25)
	Effects.Flash(pos, color, 4.5 * scale, 0.45)
	Effects.Burst(pos, { Color = Color3.fromRGB(245, 240, 255), Color2 = color, Count = if big then 40 else 18, Size = 2.2 * scale, Speed = 10 * scale, Life = 0.8, Texture = Effects.Textures.Smoke, LightEmission = 0.3 })
	Effects.Burst(pos, { Color = color, Count = if big then 60 else 24, Size = 0.9 * math.sqrt(scale), Speed = 22 * math.sqrt(scale), Life = 0.7 })
	Effects.Ring(pos, color, 7 * scale, 0.5)
end

function Effects.Folder(): Folder
	return folder
end

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHEffects"
	folder.Parent = workspace
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">GatePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Zone gate confirm: "UNLOCK CEMETERY?" with cost, progress and what you get. The gate's
-- ProximityPrompt opens it; the server checks cost, order and distance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)

local GatePanel = {}

local panel: Kit.Panel
local costLabel: TextLabel
local fill: Frame
local progressLabel: TextLabel
local unlockButton: TextButton
local current: string? = nil
local busy = false

local function refresh()
	local d = State.Data
	local zone = current and Config.ZoneById[current]
	if not d or not zone then
		return
	end
	panel.Title.Text = "UNLOCK " .. zone.Name .. "?"
	costLabel.Text = "💚 " .. Format.Commas(zone.Cost) .. " ECTOPLASM"
	local frac = math.clamp(d.Ecto / math.max(zone.Cost, 1), 0, 1)
	Kit.Tween(fill, 0.25, { Size = UDim2.fromScale(math.max(frac, 0.03), 1) })
	progressLabel.Text = Format.Short(math.min(d.Ecto, zone.Cost)) .. " / " .. Format.Short(zone.Cost)
	if d.Zones[zone.Id] then
		Kit.SetButtonText(unlockButton, "UNLOCKED ✓")
		unlockButton:SetAttribute("Color", "Gray")
	elseif d.Ecto >= zone.Cost then
		Kit.SetButtonText(unlockButton, "UNLOCK!")
		unlockButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(unlockButton, "NEED " .. Format.Short(zone.Cost - d.Ecto) .. " MORE")
		unlockButton:SetAttribute("Color", "Gray")
	end
end

function GatePanel.Open(zoneId: string)
	if not Config.ZoneById[zoneId] then
		return
	end
	current = zoneId
	refresh()
	panel:Open()
end

function GatePanel.Init()
	panel = Kit.Panel("Gate", "UNLOCK?", Vector2.new(640, 430), "Green")
	local body = panel.Body
	costLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 20), Color = Theme.Ecto, ZIndex = 62, Stroke = 3 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(0.8, 0, 0, 34), Position = UDim2.new(0.1, 0, 0, 78), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(0.03, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Theme.Ecto, Theme.Ecto2, 0)
	progressLabel = Kit.Label(bar, "", { Size = UDim2.fromScale(0.9, 0.72), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 64 })
	local perks: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 128), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -8, 0, 52), CellPadding = UDim2.fromOffset(12, 10), Parent = perks })
	for _, p in { "👻 NEW GHOSTS", "📦 NEW CRATE", "🔦 BETTER HUNTERS", "💚 HIGHER REWARDS" } do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Theme.Panel3, ZIndex = 62, Parent = perks })
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Label(f, p, { Size = UDim2.fromScale(0.9, 0.62), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 63 })
	end
	unlockButton = Kit.Button(body, {
		Text = "UNLOCK!",
		Color = "Green",
		Size = UDim2.fromOffset(320, 70),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			local zoneId = current
			local d = State.Data
			if busy or not zoneId or not d or d.Zones[zoneId] then
				return
			end
			if d.Ecto < (Config.ZoneById[zoneId] :: Config.ZoneDef).Cost then
				Kit.Toast("Defeat more ghosts to earn Ectoplasm!", "Bad")
				return
			end
			busy = true
			local res = State.Request("UnlockZone", zoneId)
			busy = false
			if res.ok then
				panel:Close()
			else
				Kit.Toast(res.err or "Couldn't unlock", "Bad")
			end
		end,
	})
end

function GatePanel.Start()
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return GatePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Ghosts</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side ghost presentation: smooth movement along the server's wander segments,
-- bobbing, facing, Spirit billboards, hit wobble and the POOF. One RenderStepped loop
-- for all ghosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Ghosts = {}

export type Entry = {
	Uid: number,
	Model: Model,
	Core: BasePart,
	Def: Config.GhostDef,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	Phase: number,
	Max: number,
	Spirit: number,
	Fill: Frame,
	SpiritText: TextLabel,
	HitT: number,
	Yaw: number,
	Dying: boolean,
	Pos: Vector3,
	Gui: BillboardGui,
}

local entries: { [number]: Entry } = {}
local player = Players.LocalPlayer
local diedSignal = Instance.new("BindableEvent")
Ghosts.Died = diedSignal.Event -- (uid, pos)
local addedSignal = Instance.new("BindableEvent")
Ghosts.Added = addedSignal.Event -- (entry)

function Ghosts.Get(uid: number): Entry?
	return entries[uid]
end

function Ghosts.All(): { [number]: Entry }
	return entries
end

-- Finds the ghost entry owning an instance (for tap targeting).
function Ghosts.FromInstance(inst: Instance?): Entry?
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") then
			local uid = cur:GetAttribute("Uid")
			if type(uid) == "number" and entries[uid] then
				return entries[uid]
			end
		end
		cur = cur.Parent
	end
	return nil
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function buildBillboard(e: Entry)
	local def = e.Def
	local big = def.Kind ~= "Normal"
	local scale = if def.Kind == "Event" then 2.2 elseif big then 1.35 else 1
	local gui: BillboardGui = Kit.new("BillboardGui", {
		Name = "SpiritGui",
		Size = UDim2.fromOffset(220 * scale, 70 * scale),
		StudsOffsetWorldSpace = Vector3.new(0, 2.2 * def.Scale + 1.5, 0),
		AlwaysOnTop = false,
		MaxDistance = if def.Kind == "Event" then 400 else 110,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Adornee = e.Core,
		Parent = e.Model,
	})
	local nameText = def.Name
	if def.Kind == "MiniBoss" then
		nameText = "⭐ " .. nameText
	elseif def.Kind == "Boss" or def.Kind == "Event" then
		nameText = "👑 " .. nameText
	end
	Kit.Label(gui, nameText, { Size = UDim2.fromScale(1, 0.38), Color = if big then Theme.Gold else Theme.Text, Stroke = 2 })
	local bar: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(0.86, 0.3),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 15, 50),
		Parent = gui,
	})
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local fill: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, def.Glow, Color3.fromRGB(180, 120, 255), 0)
	local txt = Kit.Label(bar, "", { Size = UDim2.fromScale(0.95, 0.85), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 })
	Kit.Label(gui, "SPIRIT", { Size = UDim2.fromScale(0.4, 0.22), Position = UDim2.fromScale(0.5, 0.75), AnchorPoint = Vector2.new(0.5, 0), Color = Theme.Muted, ZIndex = 2 })
	e.Fill = fill
	e.SpiritText = txt
	e.Gui = gui
end

local function updateSpirit(e: Entry, spirit: number)
	local old = e.Spirit
	e.Spirit = spirit
	local frac = if e.Max > 0 then math.clamp(spirit / e.Max, 0, 1) else 0
	TweenService:Create(e.Fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(frac, 1) }):Play()
	e.SpiritText.Text = Format.Short(spirit) .. " / " .. Format.Short(e.Max)
	if spirit < old then
		e.HitT = os.clock()
	end
end

local function readSegment(e: Entry)
	local m = e.Model
	local from = m:GetAttribute("From")
	local to = m:GetAttribute("To")
	e.From = if typeof(from) == "Vector3" then from else e.Pos
	e.To = if typeof(to) == "Vector3" then to else e.From
	e.T0 = (m:GetAttribute("T0") :: number?) or 0
	e.Dur = (m:GetAttribute("Dur") :: number?) or 0
end

local function add(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local uid = model:GetAttribute("Uid")
	local ghostId = model:GetAttribute("GhostId")
	if type(uid) ~= "number" or type(ghostId) ~= "string" or entries[uid] then
		return
	end
	local def = Config.Ghosts[ghostId]
	local core = model.PrimaryPart or model:WaitForChild("Core", 5)
	if not def or not core or not core:IsA("BasePart") then
		return
	end
	local e: Entry = {
		Uid = uid,
		Model = model,
		Core = core,
		Def = def,
		From = core.Position,
		To = core.Position,
		T0 = 0,
		Dur = 0,
		Phase = math.random() * math.pi * 2,
		Max = (model:GetAttribute("MaxSpirit") :: number?) or def.Spirit,
		Spirit = (model:GetAttribute("Spirit") :: number?) or def.Spirit,
		Fill = nil :: any,
		SpiritText = nil :: any,
		HitT = 0,
		Yaw = math.random() * math.pi * 2,
		Dying = false,
		Pos = core.Position,
		Gui = nil :: any,
	}
	readSegment(e)
	buildBillboard(e)
	updateSpirit(e, e.Spirit)
	entries[uid] = e
	model:GetAttributeChangedSignal("T0"):Connect(function()
		readSegment(e)
	end)
	model:GetAttributeChangedSignal("Spirit"):Connect(function()
		updateSpirit(e, (model:GetAttribute("Spirit") :: number?) or 0)
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			entries[uid] = nil
		end
	end)
	-- spawn-in: grow from nothing (the event boss has its own dramatic entrance)
	if e.Def.Kind ~= "Event" then
		local s = Instance.new("NumberValue")
		s.Value = 0.2
		e.Model:ScaleTo(e.Def.Scale * 0.2)
		local conn
		conn = s.Changed:Connect(function(v)
			if e.Dying or not e.Model.Parent then
				conn:Disconnect()
				return
			end
			e.Model:ScaleTo(e.Def.Scale * v)
		end)
		local tw = TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Value = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			conn:Disconnect()
			s:Destroy()
		end)
	end
	addedSignal:Fire(e)
end

local function poof(data: any)
	local e = entries[data.Uid]
	local pos: Vector3 = data.Pos
	local color: Color3 = data.Color
	local scale: number = data.Scale or 1
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = root == nil or (root.Position - pos).Magnitude < 160
	if e then
		e.Dying = true
		pos = e.Pos
		entries[data.Uid] = nil
		diedSignal:Fire(data.Uid, pos)
		e.Gui.Enabled = false
		-- squash-and-stretch pop: inflate, then vanish
		local model = e.Model
		local v = Instance.new("NumberValue")
		v.Value = 1
		v.Changed:Connect(function(x)
			if model.Parent then
				model:ScaleTo(math.max(0.05, e.Def.Scale * x))
			end
		end)
		local up = TweenService:Create(v, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1.35 })
		up:Play()
		up.Completed:Connect(function()
			if near then
				Effects.Poof(pos, color, scale, data.Big == true)
			end
			for _, p in model:GetDescendants() do
				if p:IsA("BasePart") then
					p.Transparency = 1
				elseif p:IsA("ParticleEmitter") then
					p.Enabled = false
				elseif p:IsA("Light") then
					p.Enabled = false
				end
			end
			v:Destroy()
		end)
	elseif near then
		Effects.Poof(pos, color, scale, data.Big == true)
	end
	if near then
		if data.Escaped then
			Sound.Play("Poof")
		else
			Sound.Play(if data.Big then "BigPoof" else "Poof", 0.08)
		end
	end
end

local function step()
	local t = workspace:GetServerTimeNow()
	local clock = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	for _, e in entries do
		if e.Dying then
			continue
		end
		local a = if e.Dur > 0 then math.clamp((t - e.T0) / e.Dur, 0, 1) else 1
		local base = e.From:Lerp(e.To, smooth(a))
		local s = e.Def.Scale
		local bob = math.sin(clock * 2.2 + e.Phase) * 0.45 * math.sqrt(s)
		local pos = base + Vector3.new(0, bob, 0)
		-- hit shake
		local since = clock - e.HitT
		if since < 0.15 then
			local k = (0.15 - since) / 0.15
			pos += Vector3.new(math.sin(clock * 90) * 0.25 * k * s, 0, math.cos(clock * 80) * 0.2 * k * s)
		end
		-- face the camera horizontally (cute + readable), with a gentle sway
		local dx, dz = camPos.X - pos.X, camPos.Z - pos.Z
		if dx * dx + dz * dz > 1 then
			local target = math.atan2(-dx, -dz)
			local diff = (target - e.Yaw + math.pi) % (2 * math.pi) - math.pi
			e.Yaw += diff * 0.08
		end
		local sway = math.sin(clock * 1.7 + e.Phase) * 0.12
		local moving = a < 1 and (e.To - e.From).Magnitude > 0.5
		local lean = if moving then 0.12 else 0
		e.Pos = pos
		table.insert(parts, e.Core)
		table.insert(cframes, CFrame.new(pos) * CFrame.Angles(0, e.Yaw, 0) * CFrame.Angles(-lean, 0, sway))
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ghosts.Init() end

function Ghosts.Start()
	local folder = workspace:WaitForChild("Ghosts")
	folder.ChildAdded:Connect(function(m)
		task.defer(add, m)
	end)
	for _, m in folder:GetChildren() do
		add(m)
	end
	Net.Event("Fx").OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "Poof" then
			poof(data)
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return Ghosts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: Ectoplasm counter, crew power, boosts, main menu buttons, settings,
-- toasts, announcements and zone banners.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local Hud = {}

local player = Players.LocalPlayer
local openers: { [string]: () -> () } = {}
Hud.Buttons = {} :: { [string]: TextButton }

local ectoLabel: TextLabel
local ectoPill: Frame
local powerLabel: TextLabel
local boostHolder: Frame
local dailyBadge: Frame
local shownEcto = 0
local targetEcto = 0
local bannerLabel: TextLabel
local bannerSub: TextLabel
local announceFrame: Frame

function Hud.RegisterPanel(name: string, open: () -> ())
	openers[name] = open
end

function Hud.Open(name: string)
	local fn = openers[name]
	if fn then
		fn()
	end
end

-- Pulsing ring on a menu button (tutorial).
local pulses: { [string]: Frame } = {}
function Hud.Pulse(name: string, on: boolean)
	local b = Hud.Buttons[name]
	if not b then
		return
	end
	if on and not pulses[name] then
		local ring: Frame = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = b,
		})
		Kit.Corner(ring, UDim.new(0, 18))
		local st = Kit.Stroke(ring, 5, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		pulses[name] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.fromScale(1.4, 1.4) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and pulses[name] then
		pulses[name]:Destroy()
		pulses[name] = nil
	end
end

local function floatText(text: string, color: Color3)
	local l = Kit.Label(Kit.Overlay(), text, {
		Size = UDim2.fromOffset(200, 34),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = color,
		ZIndex = 80,
	})
	Kit.Tween(l, 0.9, { Position = UDim2.new(0.5, 0, 0, 40), TextTransparency = 1 })
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		Kit.Tween(st, 0.9, { Transparency = 1 })
	end
	task.delay(0.95, function()
		l:Destroy()
	end)
end

local function buildTop(screen: ScreenGui)
	-- Ectoplasm pill
	ectoPill = Kit.new("Frame", {
		Name = "Ecto",
		Size = UDim2.fromOffset(250, 58),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = screen,
	})
	Kit.Corner(ectoPill, UDim.new(1, 0))
	Kit.Stroke(ectoPill, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ectoPill, Theme.Panel2, Theme.Bg, 90)
	Kit.new("UIScale", { Parent = ectoPill })
	local orb: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(66, 66),
		Position = UDim2.new(0, -14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = ectoPill,
	})
	Kit.Corner(orb, UDim.new(1, 0))
	Kit.Stroke(orb, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(orb, Theme.Ecto, Theme.Ecto2, 135)
	local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.32, 0.26), Position = UDim2.fromScale(0.26, 0.2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3, ZIndex = 4, Parent = orb })
	Kit.Corner(shine, UDim.new(1, 0))
	ectoLabel = Kit.Label(ectoPill, "0", { Size = UDim2.new(1, -70, 0.72, 0), Position = UDim2.new(0, 60, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Color = Theme.Ecto, Stroke = 3 })
	-- crew power
	local power: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(210, 30),
		Position = UDim2.new(0.5, 0, 0, 72),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.15,
		Parent = screen,
	})
	Kit.Corner(power, UDim.new(1, 0))
	Kit.Stroke(power, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	powerLabel = Kit.Label(power, "⚡ 0 CAPTURE POWER", { Size = UDim2.fromScale(0.92, 0.72), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Gold })
	-- boosts
	boostHolder = Kit.new("Frame", {
		Size = UDim2.fromOffset(400, 30),
		Position = UDim2.new(0.5, 0, 0, 108),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), Parent = boostHolder })
end

local MENU = {
	{ Name = "Hunters", Icon = "🔦", Text = "HUNTERS", Color = "Orange" },
	{ Name = "Index", Icon = "📖", Text = "INDEX", Color = "Blue" },
	{ Name = "Upgrades", Icon = "🧲", Text = "UPGRADES", Color = "Green" },
	{ Name = "Shop", Icon = "🛒", Text = "SHOP", Color = "Pink" },
	{ Name = "Daily", Icon = "🎁", Text = "DAILY", Color = "Purple" },
}

local function buildMenu(screen: ScreenGui)
	local col: Frame = Kit.new("Frame", {
		Name = "Menu",
		Size = UDim2.fromOffset(96, 5 * 96),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = col })
	for i, m in MENU do
		local b = Kit.Button(col, {
			Text = "",
			Color = m.Color,
			Size = UDim2.fromOffset(88, 88),
			OnClick = function()
				Hud.Open(m.Name)
			end,
		})
		b.LayoutOrder = i
		Kit.SetButtonText(b, "")
		Kit.Label(b, m.Icon, { Size = UDim2.fromScale(0.62, 0.55), Position = UDim2.fromScale(0.5, 0.38), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 0, ZIndex = 3 })
		Kit.Label(b, m.Text, { Size = UDim2.fromScale(0.94, 0.24), Position = UDim2.fromScale(0.5, 0.82), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 })
		Hud.Buttons[m.Name] = b
	end
	-- red "!" badge on DAILY when claimable
	dailyBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Bad,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Daily,
	})
	Kit.Corner(dailyBadge, UDim.new(1, 0))
	Kit.Stroke(dailyBadge, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(dailyBadge, "!", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 11 })
end

-- Settings panel (gear, top right)
local function buildSettings(screen: ScreenGui)
	local panel = Kit.Panel("Settings", "SETTINGS", Vector2.new(460, 380), "Gray")
	local list: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel.Body, ZIndex = 61 })
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = list })
	local toggles = {
		{ Key = "Music", Text = "MUSIC" },
		{ Key = "Sfx", Text = "SOUND EFFECTS" },
		{ Key = "FastReveal", Text = "FAST CRATE OPENING" },
		{ Key = "AutoTarget", Text = "AUTO NEXT GHOST" },
	}
	local buttons: { [string]: TextButton } = {}
	for _, t in toggles do
		local b = Kit.Button(list, {
			Text = t.Text,
			Color = "Green",
			Size = UDim2.fromOffset(380, 56),
			ZIndex = 62,
			OnClick = function()
				local d = State.Data
				if not d then
					return
				end
				local new = not d.Settings[t.Key]
				local res = State.Request("Setting", t.Key, new)
				if not res.ok then
					Kit.Toast(res.err or "Couldn't change that", "Bad")
				end
			end,
		})
		buttons[t.Key] = b
	end
	State.Changed:Connect(function(d)
		for _, t in toggles do
			local on = d.Settings[t.Key] == true
			local b = buttons[t.Key]
			b:SetAttribute("Color", if on then "Green" else "Gray")
			Kit.SetButtonText(b, t.Text .. (if on then ": ON" else ": OFF"))
		end
	end)
	Hud.RegisterPanel("Settings", function()
		panel:Toggle()
	end)
	Kit.Button(screen, {
		Text = "⚙",
		Color = "Gray",
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, -12, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		OnClick = function()
			panel:Toggle()
		end,
	})
end

local function buildBanners()
	local overlay = Kit.Overlay()
	bannerLabel = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(760, 80),
		Position = UDim2.fromScale(0.5, 0.26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Ecto,
		Stroke = 4,
		ZIndex = 70,
	})
	bannerLabel.TextTransparency = 1
	bannerSub = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(640, 40),
		Position = UDim2.fromScale(0.5, 0.26),
		AnchorPoint = Vector2.new(0.5, -1.2),
		Color = Theme.Text,
		ZIndex = 70,
	})
	bannerSub.TextTransparency = 1
	announceFrame = Kit.new("Frame", {
		Size = UDim2.fromOffset(700, 52),
		Position = UDim2.new(0.5, 0, 0, -80),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 75,
		Parent = overlay,
	})
	Kit.Corner(announceFrame, UDim.new(0, 16))
	Kit.Stroke(announceFrame, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(announceFrame, Theme.Gold, Color3.fromRGB(255, 120, 40), 0)
	local l = Kit.Label(announceFrame, "", { Size = UDim2.new(1, -24, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 76 })
	l.Name = "Text"
end

local bannerToken = 0
-- Big centre-screen title (zone names, NEW AREA UNLOCKED!).
function Hud.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	bannerLabel.Text = title
	bannerLabel.TextColor3 = color or Theme.Ecto
	bannerSub.Text = sub or ""
	bannerLabel.TextTransparency = 1
	bannerSub.TextTransparency = 1
	local s1 = bannerLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
	local s2 = bannerSub:FindFirstChildOfClass("UIStroke") :: UIStroke
	s1.Transparency = 1
	s2.Transparency = 1
	bannerLabel.Size = UDim2.fromOffset(500, 50)
	Kit.Tween(bannerLabel, 0.4, { TextTransparency = 0, Size = UDim2.fromOffset(760, 80) }, Enum.EasingStyle.Back)
	Kit.Tween(s1, 0.4, { Transparency = 0 })
	Kit.Tween(bannerSub, 0.4, { TextTransparency = 0 })
	Kit.Tween(s2, 0.4, { Transparency = 0 })
	task.delay(2.6, function()
		if bannerToken ~= my then
			return
		end
		Kit.Tween(bannerLabel, 0.5, { TextTransparency = 1 })
		Kit.Tween(s1, 0.5, { Transparency = 1 })
		Kit.Tween(bannerSub, 0.5, { TextTransparency = 1 })
		Kit.Tween(s2, 0.5, { Transparency = 1 })
	end)
end

local announceToken = 0
-- Sliding top announcement (legendary hatches, boss events).
function Hud.Announce(text: string, c1: Color3?, c2: Color3?)
	announceToken += 1
	local my = announceToken
	local l = announceFrame:FindFirstChild("Text") :: TextLabel
	l.Text = text
	local g = announceFrame:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(c1 or Theme.Gold, c2 or Color3.fromRGB(255, 120, 40))
	Kit.Tween(announceFrame, 0.35, { Position = UDim2.new(0.5, 0, 0, 150) }, Enum.EasingStyle.Back)
	task.delay(4.5, function()
		if announceToken == my then
			Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, -80) })
		end
	end)
end

local boostLabels: { [string]: TextLabel } = {}
local function refreshBoosts()
	local d = State.Data
	if not d then
		return
	end
	local now = State.Now()
	for id, def in Config.Boosts :: any do
		if type(def) ~= "table" then
			continue
		end
		local expiry = d.Boosts[id]
		local left = if expiry then expiry - now else 0
		local l = boostLabels[id]
		if left > 0 then
			if not l then
				local f: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(180, 30), BackgroundColor3 = Theme.Panel2, Parent = boostHolder })
				Kit.Corner(f, UDim.new(1, 0))
				Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
				l = Kit.Label(f, "", { Size = UDim2.fromScale(0.9, 0.72), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Ecto })
				boostLabels[id] = l
			end
			(l :: TextLabel).Text = def.Icon .. " " .. def.Name .. "  " .. Format.Time(left)
		elseif l then
			(l.Parent :: Instance):Destroy()
			boostLabels[id] = nil
		end
	end
	local info = d.DailyInfo
	if info then
		local canClaim = info.CanClaim or info.Wait - (now - (d.ServerTime or now)) <= 0
		dailyBadge.Visible = canClaim
	end
end

local function onData(d: any)
	powerLabel.Text = "⚡ " .. Format.Short(d.CrewPower or 0) .. " CAPTURE POWER"
	targetEcto = d.Ecto
	refreshBoosts()
end

local lastZone = 0
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

function Hud.Init()
	local screen = Kit.Screen()
	Kit.SetSound(function(name)
		Sound.Play(name)
	end)
	buildTop(screen)
	buildMenu(screen)
	buildSettings(screen)
	buildBanners()
end

function Hud.Start()
	State.Changed:Connect(onData)
	State.EctoChanged:Connect(function(new: number, old: number)
		targetEcto = new
		if new > old then
			floatText("+" .. Format.Short(new - old), Theme.Ecto)
			local sc = ectoPill:FindFirstChildOfClass("UIScale") :: UIScale
			sc.Scale = 1.12
			Kit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
	-- smooth count-up
	RunService.RenderStepped:Connect(function(dt: number)
		if shownEcto ~= targetEcto then
			local diff = targetEcto - shownEcto
			local step = diff * math.min(1, dt * 10)
			if math.abs(diff) < 1 or math.abs(step) < 1 then
				shownEcto = targetEcto
			else
				shownEcto += step
			end
			ectoLabel.Text = Format.Short(math.floor(shownEcto + 0.5))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshBoosts()
			-- zone banner when walking into a different zone
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
				if idx ~= lastZone then
					if lastZone ~= 0 then
						local z = Config.Zones[idx]
						Hud.Banner(z.Name, nil, z.Accent)
					end
					lastZone = idx
				end
			end
		end
	end)
	Net.Event("Fx").OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "Toast" then
			Kit.Toast(data.Text, data.Color)
		elseif kind == "Announce" then
			local r = Config.Rarities[data.Color]
			Hud.Announce(data.Text, r and r.Color, r and r.Color2)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">HuntersPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTERS inventory: grid of cards (portrait, name, rarity, Capture Power, equipped/locked
-- badges), an inspect pane with a 3D preview, EQUIP / UNEQUIP / EQUIP BEST / LOCK / RELEASE,
-- sort by power or rarity, and a release mode with "select weak" for clearing storage.
-- Cards are cached per hunter uid, so data updates only touch what changed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)

local HuntersPanel = {}

type Card = {
	Frame: TextButton,
	Equip: Frame,
	Lock: TextLabel,
	Select: Frame,
}

local panel: Kit.Panel
local grid: ScrollingFrame
local cards: { [string]: Card } = {}
local equippedLabel: TextLabel
local powerLabel: TextLabel
local storageLabel: TextLabel
local sortButton: TextButton
local releaseButton: TextButton
local equipBestButton: TextButton
-- inspect pane
local inspect: Frame
local viewHolder: Frame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local rarityRibbon: Frame
local statLabel: TextLabel
local blurbLabel: TextLabel
local equipButton: TextButton
local lockButton: TextButton
local relOneButton: TextButton
local emptyHint: TextLabel
-- release mode
local releaseBar: Frame
local releaseConfirm: TextButton
local releaseMode = false
local selected: { [string]: boolean } = {}
local inspectUid: string? = nil
local sortMode = "Power"
local spinModel: Model? = nil
local spinConn: RBXScriptConnection? = nil

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOf(id: string): Config.RarityDef
	return Config.Rarities[Config.Hunters[id].Rarity]
end

local function crateRefund(id: string): number
	local def = Config.Hunters[id]
	local zone = Config.ZoneById[def.Zone]
	local crate = zone and Config.Crates[zone.Crate]
	return if crate then math.floor(crate.Price * Config.Inventory.ReleaseRefund) else 0
end

local function sortedUids(d: any): { string }
	local uids = {}
	for uid in d.Hunters do
		table.insert(uids, uid)
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	table.sort(uids, function(a, b)
		if eq[a] ~= eq[b] then
			return eq[a] == true
		end
		local ha, hb = d.Hunters[a].Id, d.Hunters[b].Id
		local pa, pb = powerOf(ha), powerOf(hb)
		local ra, rb = rarityOf(ha).Order, rarityOf(hb).Order
		if sortMode == "Rarity" and ra ~= rb then
			return ra > rb
		end
		if pa ~= pb then
			return pa > pb
		end
		if ra ~= rb then
			return ra > rb
		end
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	return uids
end

local function setInspect(uid: string?)
	inspectUid = uid
	local d = State.Data
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in viewHolder:GetChildren() do
		if c:IsA("ViewportFrame") then
			c:Destroy()
		end
	end
	spinModel = nil
	local h = uid and d and d.Hunters[uid]
	inspect.Visible = h ~= nil and not releaseMode
	emptyHint.Visible = not inspect.Visible and not releaseMode
	if not h or not d then
		return
	end
	local def = Config.Hunters[h.Id]
	local rar = rarityOf(h.Id)
	local _, model = Portrait.Viewport(viewHolder, h.Id, false)
	spinModel = model
	if model then
		local t0 = os.clock()
		spinConn = RunService.RenderStepped:Connect(function()
			if spinModel then
				spinModel:PivotTo(CFrame.Angles(0, math.sin((os.clock() - t0) * 0.8) * 0.6, 0))
			end
		end)
	end
	nameLabel.Text = string.upper(def.Name)
	rarityLabel.Text = rar.Name
	local g = rarityRibbon:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(rar.Color, rar.Color2)
	statLabel.Text = "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER"
	blurbLabel.Text = def.Blurb
	local isEq = table.find(d.Equipped, uid) ~= nil
	Kit.SetButtonText(equipButton, if isEq then "UNEQUIP" else "EQUIP")
	equipButton:SetAttribute("Color", if isEq then "Red" else "Green")
	Kit.SetButtonText(lockButton, if h.Locked then "🔓 UNLOCK" else "🔒 LOCK")
	relOneButton.Visible = not isEq and not h.Locked
	Kit.SetButtonText(relOneButton, "RELEASE (+" .. Format.Short(crateRefund(h.Id)) .. ")")
end

local function updateReleaseBar()
	local d = State.Data
	local n, refund = 0, 0
	if d then
		for uid in selected do
			local h = d.Hunters[uid]
			if h then
				n += 1
				refund += crateRefund(h.Id)
			else
				selected[uid] = nil
			end
		end
	end
	Kit.SetButtonText(releaseConfirm, "RELEASE " .. n .. "  (+💚" .. Format.Short(refund) .. ")")
	releaseConfirm:SetAttribute("Color", if n > 0 then "Red" else "Gray")
end

local function makeCard(uid: string, hunterId: string): Card
	local def = Config.Hunters[hunterId]
	local rar = rarityOf(hunterId)
	local f: TextButton = Kit.new("TextButton", {
		Name = uid,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 63,
		Parent = grid,
	})
	Kit.Corner(f, UDim.new(0, 16))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, rar.Color, rar.Color2, 90)
	if rar.Order >= 5 then
		-- legendary cards shimmer
		local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, ZIndex = 63, Parent = f })
		Kit.Corner(shine, UDim.new(0, 16))
		local sg = Kit.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 25,
			Parent = shine,
		})
		task.spawn(function()
			while shine.Parent do
				sg.Offset = Vector2.new(-1, 0)
				Kit.Tween(sg, 1.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear)
				task.wait(2.4)
			end
		end)
	end
	local pic: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(92, 92),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 18, 55),
		BackgroundTransparency = 0.35,
		ZIndex = 64,
		Parent = f,
	})
	Kit.Corner(pic, UDim.new(1, 0))
	Portrait.Face(pic, hunterId, false)
	Kit.Label(f, string.upper(def.Name), { Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 100), ZIndex = 66 })
	Kit.Label(f, "⚡" .. Format.Short(def.Power), { Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 124), ZIndex = 66, Color = Theme.Gold })
	local eqBadge: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.fromOffset(-6, -6),
		BackgroundColor3 = Theme.Good,
		Visible = false,
		ZIndex = 68,
		Parent = f,
	})
	Kit.Corner(eqBadge, UDim.new(1, 0))
	Kit.Stroke(eqBadge, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(eqBadge, "✓", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 69 })
	local lock = Kit.Label(f, "🔒", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, 2, 0, -4), AnchorPoint = Vector2.new(1, 0), ZIndex = 68, Stroke = 0 })
	lock.Visible = false
	local sel: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bad, BackgroundTransparency = 0.45, Visible = false, ZIndex = 70, Parent = f })
	Kit.Corner(sel, UDim.new(0, 16))
	Kit.Label(sel, "✖", { Size = UDim2.fromScale(0.5, 0.4), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 71 })
	f.Activated:Connect(function()
		Kit.Play("Click")
		if releaseMode then
			local d = State.Data
			local h = d and d.Hunters[uid]
			if not h or h.Locked or table.find(d.Equipped, uid) then
				Kit.Toast("Equipped or locked hunters can't be released", "Bad")
				return
			end
			if selected[uid] then
				selected[uid] = nil
			else
				selected[uid] = true
			end
			sel.Visible = selected[uid] == true
			updateReleaseBar()
		else
			setInspect(uid)
		end
	end)
	return { Frame = f, Equip = eqBadge, Lock = lock, Select = sel }
end

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	-- remove cards for hunters that are gone
	for uid, c in cards do
		if not d.Hunters[uid] then
			c.Frame:Destroy()
			cards[uid] = nil
			selected[uid] = nil
		end
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	for i, uid in sortedUids(d) do
		local h = d.Hunters[uid]
		local c = cards[uid]
		if not c then
			c = makeCard(uid, h.Id)
			cards[uid] = c
		end
		c.Frame.LayoutOrder = i
		c.Equip.Visible = eq[uid] == true
		c.Lock.Visible = h.Locked == true
		c.Select.Visible = releaseMode and selected[uid] == true
	end
	local count = State.CountOwned()
	local slots = d.Slots or Config.Inventory.BaseSlots
	equippedLabel.Text = "EQUIPPED " .. #d.Equipped .. "/" .. slots
	powerLabel.Text = "⚡ " .. Format.Short(d.CrewPower or 0)
	storageLabel.Text = "STORAGE " .. count .. "/" .. Config.Inventory.MaxHunters
	storageLabel.TextColor3 = if count >= Config.Inventory.MaxHunters - 5 then Theme.Bad else Theme.Muted
	if inspectUid and not d.Hunters[inspectUid] then
		inspectUid = nil
	end
	setInspect(inspectUid)
	if releaseMode then
		updateReleaseBar()
	end
end

local function setReleaseMode(on: boolean)
	releaseMode = on
	table.clear(selected)
	releaseBar.Visible = on
	Kit.SetButtonText(releaseButton, if on then "DONE" else "RELEASE")
	releaseButton:SetAttribute("Color", if on then "Gray" else "Red")
	rebuild()
end

local function act(action: string, ...: any)
	local res = State.Request(action, ...)
	if not res.ok then
		Kit.Toast(res.err or "Couldn't do that", "Bad")
	end
	return res
end

function HuntersPanel.Init()
	panel = Kit.Panel("Hunters", "GHOST HUNTERS", Vector2.new(920, 560), "Orange")
	local body = panel.Body
	-- top bar
	local top: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 12), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	equippedLabel = Kit.Label(top, "EQUIPPED 0/4", { Size = UDim2.fromOffset(190, 34), Position = UDim2.fromOffset(0, 2), Align = Enum.TextXAlignment.Left, ZIndex = 62 })
	powerLabel = Kit.Label(top, "⚡ 0", { Size = UDim2.fromOffset(140, 30), Position = UDim2.fromOffset(196, 4), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, ZIndex = 62 })
	storageLabel = Kit.Label(top, "STORAGE 0/150", { Size = UDim2.fromOffset(190, 20), Position = UDim2.fromOffset(0, 36), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, ZIndex = 62, Stroke = 0 })
	local buttons: Frame = Kit.new("Frame", { Size = UDim2.new(0, 520, 1, 0), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 61, Parent = top })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 10), Parent = buttons })
	sortButton = Kit.Button(buttons, {
		Text = "SORT: POWER",
		Color = "Blue",
		Size = UDim2.fromOffset(160, 52),
		ZIndex = 62,
		OnClick = function()
			sortMode = if sortMode == "Power" then "Rarity" else "Power"
			Kit.SetButtonText(sortButton, "SORT: " .. string.upper(sortMode))
			rebuild()
		end,
	})
	releaseButton = Kit.Button(buttons, {
		Text = "RELEASE",
		Color = "Red",
		Size = UDim2.fromOffset(140, 52),
		ZIndex = 62,
		OnClick = function()
			setReleaseMode(not releaseMode)
		end,
	})
	equipBestButton = Kit.Button(buttons, {
		Text = "EQUIP BEST",
		Color = "Green",
		Size = UDim2.fromOffset(190, 52),
		ZIndex = 62,
		OnClick = function()
			local res = act("EquipBest")
			if res.ok then
				Kit.Toast("Best crew equipped! ⚡ " .. Format.Commas(res.Power or 0), "Good")
			end
		end,
	})
	equipBestButton.Name = "EquipBest"
	-- grid
	grid = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, -300, 1, -84),
		Position = UDim2.fromOffset(0, 78),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.5,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.Corner(grid, UDim.new(0, 16))
	Kit.Padding(grid, 12)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(118, 150),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	-- inspect pane
	local side: Frame = Kit.new("Frame", { Size = UDim2.new(0, 284, 1, -84), Position = UDim2.new(1, 0, 0, 78), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 16))
	emptyHint = Kit.Label(side, "Tap a hunter to inspect it.\n\nEQUIP BEST picks your strongest crew!", { Size = UDim2.new(1, -30, 0.6, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, ZIndex = 63, Stroke = 0 })
	inspect = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	viewHolder = Kit.new("Frame", { Size = UDim2.fromOffset(170, 160), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 63, Parent = inspect })
	nameLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 166), ZIndex = 64 })
	rarityRibbon = Kit.new("Frame", { Size = UDim2.fromOffset(170, 26), Position = UDim2.new(0.5, 0, 0, 198), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 64, Parent = inspect })
	Kit.Corner(rarityRibbon, UDim.new(1, 0))
	Kit.Stroke(rarityRibbon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(rarityRibbon, Theme.Panel2, Theme.Panel, 0)
	rarityLabel = Kit.Label(rarityRibbon, "", { Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 65 })
	statLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 230), Color = Theme.Gold, ZIndex = 64 })
	blurbLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 256), Color = Theme.Muted, Font = Theme.Body, ZIndex = 64, Stroke = 0 })
	local actions: Frame = Kit.new("Frame", { Size = UDim2.new(1, -16, 0, 120), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1, ZIndex = 63, Parent = inspect })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 54), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = actions })
	equipButton = Kit.Button(actions, {
		Text = "EQUIP",
		Color = "Green",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			if not d or not uid then
				return
			end
			if table.find(d.Equipped, uid) then
				act("Unequip", uid)
			else
				act("Equip", uid)
			end
		end,
	})
	equipButton.LayoutOrder = 1
	lockButton = Kit.Button(actions, {
		Text = "🔒 LOCK",
		Color = "Blue",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			local h = uid and d and d.Hunters[uid]
			if h then
				act("Lock", uid, not h.Locked)
			end
		end,
	})
	lockButton.LayoutOrder = 2
	relOneButton = Kit.Button(actions, {
		Text = "RELEASE",
		Color = "Red",
		ZIndex = 64,
		OnClick = function()
			local uid = inspectUid
			if uid then
				act("Release", { uid })
			end
		end,
	})
	relOneButton.LayoutOrder = 3
	-- release bar (replaces the inspect pane in release mode)
	releaseBar = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	Kit.Label(releaseBar, "Tap hunters to select them.\nReleased hunters give back a little Ectoplasm.", { Size = UDim2.new(1, -24, 0, 90), Position = UDim2.fromOffset(12, 14), Color = Theme.Muted, Font = Theme.Body, ZIndex = 64, Stroke = 0 })
	Kit.Button(releaseBar, {
		Text = "SELECT WEAK",
		Color = "Orange",
		Size = UDim2.new(1, -24, 0, 54),
		Position = UDim2.fromOffset(12, 120),
		ZIndex = 64,
		OnClick = function()
			-- every unequipped, unlocked hunter weaker than your weakest equipped one
			local d = State.Data
			if not d then
				return
			end
			local weakest = math.huge
			for _, uid in d.Equipped do
				local h = d.Hunters[uid]
				if h then
					weakest = math.min(weakest, powerOf(h.Id))
				end
			end
			table.clear(selected)
			for uid, h in d.Hunters do
				if not h.Locked and not table.find(d.Equipped, uid) and powerOf(h.Id) < weakest then
					selected[uid] = true
				end
			end
			rebuild()
		end,
	})
	releaseConfirm = Kit.Button(releaseBar, {
		Text = "RELEASE 0",
		Color = "Gray",
		Size = UDim2.new(1, -24, 0, 60),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			local list = {}
			for uid in selected do
				table.insert(list, uid)
			end
			if #list == 0 then
				return
			end
			local res = act("Release", list)
			if res.ok then
				table.clear(selected)
				rebuild()
			end
		end,
	})
	Hud.RegisterPanel("Hunters", function()
		panel:Toggle()
	end)
end

function HuntersPanel.Start()
	panel.OnOpen.Event:Connect(rebuild)
	panel.OnClose.Event:Connect(function()
		if releaseMode then
			setReleaseMode(false)
		end
		if spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
end

function HuntersPanel.EquipBestButton(): TextButton
	return equipBestButton
end

function HuntersPanel.IsOpen(): boolean
	return panel.IsOpen
end

return HuntersPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTER INDEX: discovery tracking per zone ("HAUNTED NEIGHBORHOOD 3/4 DISCOVERED"),
-- overall completion %, silhouettes for unknown hunters, a 3D preview for known ones and a
-- NEW! indicator (menu badge + card sticker) for discoveries you haven't looked at yet.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)
local CratePanel = require(script.Parent.CratePanel)

local IndexPanel = {}

local panel: Kit.Panel
local scroll: ScrollingFrame
local totalLabel: TextLabel
local totalFill: Frame
local detail: Frame
local detailView: Frame
local detailName: TextLabel
local detailInfo: TextLabel
local detailBlurb: TextLabel
local menuBadge: Frame
local newIds: { [string]: boolean } = {}
local spinConn: RBXScriptConnection? = nil
local lastKey = ""

local function hunterList(zoneId: string): { Config.HunterDef }
	local out = {}
	local crate = Config.Crates[(Config.ZoneById[zoneId] :: Config.ZoneDef).Crate]
	for _, e in crate.Pool do
		table.insert(out, Config.Hunters[e.Hunter])
	end
	return out
end

local function oddsOf(h: Config.HunterDef): number
	local zone = Config.ZoneById[h.Zone]
	local crate = Config.Crates[zone.Crate]
	local odds = Rules.Odds(crate.Pool :: any, function(id)
		return Config.Rarities[Config.Hunters[id].Rarity].Order
	end, 1, Config.LuckAffectsFromOrder)
	return odds[h.Id] or 0
end

local function showDetail(h: Config.HunterDef, found: boolean)
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in detailView:GetChildren() do
		c:Destroy()
	end
	detail.Visible = true
	local rar = Config.Rarities[h.Rarity]
	local crate = Config.Crates[(Config.ZoneById[h.Zone] :: Config.ZoneDef).Crate]
	if found then
		local _, model = Portrait.Viewport(detailView, h.Id, false)
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				model:PivotTo(CFrame.Angles(0, (os.clock() - t0) * 0.9, 0))
			end)
		end
		detailName.Text = string.upper(h.Name)
		detailBlurb.Text = h.Blurb
	else
		Portrait.Viewport(detailView, h.Id, true)
		detailName.Text = "???"
		detailBlurb.Text = "Not discovered yet. Keep opening crates!"
	end
	detailName.TextColor3 = rar.Color
	detailInfo.Text = rar.Name .. "  •  ⚡ " .. (if found then Format.Commas(h.Power) else "?") .. "\n" .. crate.Name .. "  •  " .. Format.Percent(oddsOf(h))
end

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local key = ""
	for _, z in Config.Zones do
		for _, h in hunterList(z.Id) do
			key ..= (if d.Discovered[h.Id] then "1" else "0") .. (if newIds[h.Id] then "n" else "")
		end
	end
	if key == lastKey then
		return
	end
	lastKey = key
	for _, c in scroll:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local total, found = 0, 0
	for zi, z in Config.Zones do
		local list = hunterList(z.Id)
		local zf = 0
		for _, h in list do
			if d.Discovered[h.Id] then
				zf += 1
			end
		end
		total += #list
		found += zf
		local section: Frame = Kit.new("Frame", {
			Size = UDim2.new(1, -8, 0, 214),
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.45,
			LayoutOrder = zi,
			ZIndex = 62,
			Parent = scroll,
		})
		Kit.Corner(section, UDim.new(0, 16))
		local unlocked = d.Zones[z.Id] == true
		Kit.Label(section, (if unlocked then "" else "🔒 ") .. z.Name, { Size = UDim2.new(0.6, 0, 0, 30), Position = UDim2.fromOffset(14, 8), Align = Enum.TextXAlignment.Left, Color = z.Accent, ZIndex = 63 })
		local complete = zf == #list
		Kit.Label(section, (if complete then "★ COMPLETE " else "") .. zf .. "/" .. #list .. " DISCOVERED", { Size = UDim2.new(0.38, 0, 0, 26), Position = UDim2.new(1, -14, 0, 10), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = if complete then Theme.Gold else Theme.Text, ZIndex = 63 })
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, -20, 0, 160), Position = UDim2.fromOffset(10, 46), BackgroundTransparency = 1, ZIndex = 62, Parent = section })
		Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 12), Parent = row })
		for _, h in list do
			local rar = Config.Rarities[h.Rarity]
			local known = d.Discovered[h.Id] == true
			local card: TextButton = Kit.new("TextButton", {
				Size = UDim2.fromOffset(118, 156),
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 63,
				Parent = row,
			})
			Kit.Corner(card, UDim.new(0, 16))
			Kit.Stroke(card, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
			if known then
				Kit.Gradient(card, rar.Color, rar.Color2, 90)
			else
				Kit.Gradient(card, Color3.fromRGB(70, 60, 100), Color3.fromRGB(40, 32, 66), 90)
			end
			local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(90, 90), Position = UDim2.new(0.5, 0, 0, 8), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = card })
			Kit.Corner(pic, UDim.new(1, 0))
			Portrait.Face(pic, h.Id, not known)
			Kit.Label(card, if known then string.upper(h.Name) else "???", { Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 102), ZIndex = 66 })
			Kit.Label(card, rar.Name, { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 126), ZIndex = 66, Color = if known then Color3.new(1, 1, 1) else rar.Color })
			if newIds[h.Id] then
				local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(64, 26), Position = UDim2.new(1, 8, 0, -8), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, ZIndex = 70, Stroke = 3 })
				stamp.Rotation = 12
			end
			card.Activated:Connect(function()
				Kit.Play("Click")
				if newIds[h.Id] then
					newIds[h.Id] = nil
					menuBadge.Visible = next(newIds) ~= nil
				end
				showDetail(h, known)
			end)
		end
	end
	local pct = if total > 0 then found / total else 0
	totalLabel.Text = "COLLECTION " .. found .. "/" .. total .. "  (" .. math.floor(pct * 100 + 0.5) .. "%)"
	Kit.Tween(totalFill, 0.4, { Size = UDim2.fromScale(math.max(pct, 0.02), 1) })
end

function IndexPanel.Init()
	panel = Kit.Panel("Index", "HUNTER INDEX", Vector2.new(920, 560), "Blue")
	local body = panel.Body
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(1, -310, 0, 40), Position = UDim2.fromOffset(0, 16), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	totalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(totalFill, UDim.new(1, 0))
	Kit.Gradient(totalFill, Theme.Ecto, Theme.Ecto2, 0)
	totalLabel = Kit.Label(bar, "COLLECTION", { Size = UDim2.fromScale(0.9, 0.72), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 64 })
	scroll = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, -300, 1, -76),
		Position = UDim2.fromOffset(0, 70),
		BackgroundTransparency = 1,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	local side: Frame = Kit.new("Frame", { Size = UDim2.new(0, 284, 1, -30), Position = UDim2.new(1, 0, 0, 16), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 16))
	Kit.Label(side, "Tap a card to take a closer look!", { Size = UDim2.new(1, -30, 0, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, ZIndex = 63, Stroke = 0 })
	detail = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0, Visible = false, ZIndex = 64, Parent = side })
	Kit.Corner(detail, UDim.new(0, 16))
	detailView = Kit.new("Frame", { Size = UDim2.fromOffset(220, 230), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 65, Parent = detail })
	detailName = Kit.Label(detail, "", { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 240), ZIndex = 66 })
	detailInfo = Kit.Label(detail, "", { Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 278), ZIndex = 66, Color = Theme.Text, Font = Theme.Body, Stroke = 0 })
	detailBlurb = Kit.Label(detail, "", { Size = UDim2.new(1, -24, 0, 60), Position = UDim2.fromOffset(12, 336), ZIndex = 66, Color = Theme.Muted, Font = Theme.Body, Stroke = 0 })
	-- NEW badge on the INDEX menu button
	menuBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(48, 24),
		Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Ecto,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Index,
	})
	Kit.Corner(menuBadge, UDim.new(1, 0))
	Kit.Stroke(menuBadge, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(menuBadge, "NEW", { Size = UDim2.fromScale(0.85, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 11 })
	Hud.RegisterPanel("Index", function()
		panel:Toggle()
	end)
end

function IndexPanel.Start()
	panel.OnOpen.Event:Connect(function()
		lastKey = ""
		detail.Visible = false
		rebuild()
	end)
	panel.OnClose.Event:Connect(function()
		if spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
		-- looked at the index: discoveries are no longer "new"
		table.clear(newIds)
		menuBadge.Visible = false
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
	CratePanel.Opened:Connect(function(res: any)
		if res.IsNew then
			newIds[res.Hunter] = true
			menuBadge.Visible = true
		end
	end)
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[--!strict
-- Ectoplasm orbs (visual only; the server owns values and decides pickups).
--   Drops   → orbs pop out of the poof on an arc, bounce twice, then hover and glow.
--   Pickup  → as soon as an orb is inside your pickup radius it starts accelerating toward you
--             (predicted locally so it feels instant); it is "eaten" when the server confirms
--             the pickup (Collect). Unconfirmed orbs wait at your side briefly, then go back.
-- One RenderStepped loop moves every orb with BulkMoveTo; parts are pooled.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Orbs = {}

type Orb = {
	Id: number,
	Part: BasePart,
	Value: number,
	Start: Vector3,
	Land: Vector3,
	T0: number,
	FlyDur: number,
	Phase: string, -- Fly | Rest | Magnet | Held | Fade
	Confirmed: boolean,
	MagnetT0: number,
	MagnetFrom: Vector3,
	HeldT0: number,
	NoPredictUntil: number,
	ExpireAt: number,
	Spin: number,
	Size: number,
	Pos: Vector3,
}

local player = Players.LocalPlayer
local orbs: { [number]: Orb } = {}
local pool: { BasePart } = {}
local folder: Folder
local hidden = CFrame.new(0, -500, 0)
local streak = 0
local lastPickup = 0
local ring: Part
local ringGui: SurfaceGui
local ringStroke: UIStroke
local ringAlpha = 0
local collectedSignal = Instance.new("BindableEvent")
Orbs.Collected = collectedSignal.Event -- (amount)

local GREEN = Theme.Ecto
local CYAN = Theme.Ecto2

local function getPart(): BasePart
	local p = table.remove(pool)
	if p then
		p.Transparency = 0.05
		return p
	end
	local b = Instance.new("Part")
	b.Name = "Ecto"
	b.Shape = Enum.PartType.Ball
	b.Material = Enum.Material.Neon
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.CastShadow = false
	b.Transparency = 0.05
	b.CFrame = hidden
	b.Parent = folder
	return b
end

local function release(o: Orb)
	orbs[o.Id] = nil
	o.Part.CFrame = hidden
	if #pool < 300 then
		table.insert(pool, o.Part)
	else
		o.Part:Destroy()
	end
end

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function radius(): number
	local d = State.Data
	return if d and d.PickupRadius then d.PickupRadius else Config.Upgrades.PickupRadius.Levels[1]
end

local function spawnDrops(origin: Vector3, list: { any })
	local now = os.clock()
	for i, item in list do
		local id, land, value = item[1], item[2], item[3]
		if type(id) ~= "number" or typeof(land) ~= "Vector3" or type(value) ~= "number" or orbs[id] then
			continue
		end
		local size = math.clamp(0.9 + 0.22 * math.log10(math.max(1, value)), 0.9, 1.9)
		local part = getPart()
		part.Size = Vector3.new(size, size, size)
		part.Color = GREEN:Lerp(CYAN, math.random() * 0.6)
		local o: Orb = {
			Id = id,
			Part = part,
			Value = value,
			Start = origin,
			Land = land,
			T0 = now + (i - 1) * 0.025, -- tiny stagger so a burst "sprays"
			FlyDur = 0.45 + math.random() * 0.25,
			Phase = "Fly",
			Confirmed = false,
			MagnetT0 = 0,
			MagnetFrom = origin,
			HeldT0 = 0,
			NoPredictUntil = 0,
			ExpireAt = now + Config.Drops.Lifetime,
			Spin = math.random() * 6.28,
			Size = size,
			Pos = origin,
		}
		orbs[id] = o
	end
	-- ectoplasm splash where the ghost popped
	Effects.Burst(origin, { Color = GREEN, Color2 = CYAN, Count = math.min(6 + #list * 2, 30), Size = 0.7, Speed = 14, Life = 0.5, Gravity = 25 })
	Sound.Play("Drop", 0.1)
end

local function startMagnet(o: Orb)
	if o.Phase == "Magnet" or o.Phase == "Held" or o.Phase == "Fade" then
		return
	end
	o.Phase = "Magnet"
	o.MagnetT0 = os.clock()
	o.MagnetFrom = o.Pos
end

local function eat(o: Orb, at: Vector3)
	local now = os.clock()
	if now - lastPickup < 0.6 then
		streak = math.min(streak + 1, 14)
	else
		streak = 0
	end
	lastPickup = now
	Effects.Burst(at, { Color = o.Part.Color, Count = 5, Size = 0.45, Speed = 6, Life = 0.35 })
	Sound.Play("Pickup", 0.02, 1 + streak * 0.045) -- rising pitch on a pickup streak
	release(o)
	collectedSignal:Fire(o.Value)
end

local function onCollect(ids: { number }, _total: number)
	for _, id in ids do
		local o = orbs[id]
		if o then
			o.Confirmed = true
			if o.Phase == "Held" then
				local r = rootPart()
				eat(o, if r then r.Position else o.Pos)
			else
				startMagnet(o)
			end
		end
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	local now = os.clock()
	local root = rootPart()
	local rpos = if root then root.Position else nil
	local rad = radius()
	local r2 = rad * rad
	local nearCount = 0
	table.clear(parts)
	table.clear(cframes)
	for _, o in orbs do
		local pos: Vector3
		if o.Phase == "Fly" then
			local a = math.clamp((now - o.T0) / o.FlyDur, 0, 1)
			local dist = (o.Land - o.Start).Magnitude
			local arc = (2.5 + dist * 0.35) * 4 * a * (1 - a)
			pos = o.Start:Lerp(o.Land, a) + Vector3.new(0, arc, 0)
			if a >= 1 then
				o.Phase = "Rest"
				o.T0 = now
			end
		elseif o.Phase == "Rest" then
			local b = now - o.T0
			local bounce = 0
			if b < 0.5 then
				local k = b / 0.5
				bounce = math.abs(math.sin(k * math.pi * 2)) * 1.3 * (1 - k)
			end
			pos = o.Land + Vector3.new(0, 0.35 + bounce + math.sin(now * 3 + o.Spin) * 0.22, 0)
			if now >= o.ExpireAt then
				o.Phase = "Fade"
				o.T0 = now
			elseif rpos and now >= o.NoPredictUntil then
				local dx, dz = pos.X - rpos.X, pos.Z - rpos.Z
				if dx * dx + dz * dz <= r2 and math.abs(pos.Y - rpos.Y) < 14 then
					startMagnet(o)
				end
			end
			if rpos and (pos - rpos).Magnitude < rad + 25 then
				nearCount += 1
			end
		elseif o.Phase == "Magnet" then
			local a = math.clamp((now - o.MagnetT0) / Config.Drops.FlyTime, 0, 1)
			local target = if rpos then rpos else o.MagnetFrom
			local e = a * a -- accelerate in
			pos = o.MagnetFrom:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 2, 0)
			if a >= 1 then
				if o.Confirmed then
					eat(o, target)
					continue
				end
				o.Phase = "Held"
				o.HeldT0 = now
			end
		elseif o.Phase == "Held" then
			pos = if rpos then rpos else o.Pos
			if now - o.HeldT0 > 1.2 then
				-- server didn't agree (moved away too fast?) - send it back to where it was
				o.Phase = "Rest"
				o.T0 = now - 1
				o.NoPredictUntil = now + 1.5
				pos = o.Land
			end
		else -- Fade
			local a = math.clamp((now - o.T0) / 0.4, 0, 1)
			local s = o.Size * (1 - a)
			o.Part.Size = Vector3.new(s, s, s) + Vector3.new(0.05, 0.05, 0.05)
			pos = o.Land + Vector3.new(0, 0.35, 0)
			if a >= 1 then
				release(o)
				continue
			end
		end
		o.Pos = pos
		table.insert(parts, o.Part)
		-- hidden while held at the player (waiting for the server)
		table.insert(cframes, if o.Phase == "Held" then hidden else CFrame.new(pos) * CFrame.Angles(0, now * 2 + o.Spin, 0))
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- pickup radius ring: fades in while orbs are lying around nearby
	local want = if nearCount > 0 and rpos then 1 else 0
	ringAlpha += (want - ringAlpha) * math.min(1, dt * 6)
	if rpos and ringAlpha > 0.02 then
		local d = rad * 2
		if math.abs(ring.Size.X - d) > 0.05 then
			ring.Size = Vector3.new(d, 0.1, d)
			local pps = math.clamp(math.floor(600 / d), 6, 30)
			ringGui.PixelsPerStud = pps
			ringStroke.Thickness = math.max(2, 0.4 * pps)
		end
		ring.CFrame = CFrame.new(rpos.X, rpos.Y - 2.85, rpos.Z)
		ringStroke.Transparency = 1 - 0.55 * ringAlpha
		ringGui.Enabled = true
	elseif ringGui.Enabled then
		ringGui.Enabled = false
		ring.CFrame = hidden
	end
end

function Orbs.Count(): number
	local n = 0
	for _, o in orbs do
		if o.Phase == "Rest" or o.Phase == "Fly" then
			n += 1
		end
	end
	return n
end

function Orbs.Nearest(pos: Vector3): Vector3?
	local best, bestD = nil, math.huge
	for _, o in orbs do
		if o.Phase == "Rest" then
			local d = (o.Pos - pos).Magnitude
			if d < bestD then
				best, bestD = o.Pos, d
			end
		end
	end
	return best
end

function Orbs.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHOrbs"
	folder.Parent = workspace
	ring = Instance.new("Part")
	ring.Name = "PickupRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(28, 0.1, 28)
	ring.CFrame = hidden
	ring.Parent = folder
	ringGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Brightness = 2,
		Enabled = false,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = ringGui })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 6, Color = GREEN, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
end

function Orbs.Start()
	Net.Event("Drops").OnClientEvent:Connect(spawnDrops)
	Net.Event("Collect").OnClientEvent:Connect(onCollect)
	RunService.RenderStepped:Connect(step)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Crate opening cinematic. Plays on a private stage far from the map with a scripted camera:
--   crate drops in → bounces → shakes (rare+: levitates while rarity energy converges) →
--   locks pop → lid flies open → light burst → the hunter leaps out and poses → result card.
-- Intensity comes from Config.Rarities (RevealPause, ShakeIntensity, Particles, Darken,
-- CameraPunch). Commons are quick; "Fast crate opening" in settings shortens everything; SKIP
-- jumps straight to the result. Every step is written as anim(duration, apply(alpha)) so a
-- skip simply applies each step's end state.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local HunterRig = require(GH.Rigs.HunterRig)
local CrateRig = require(GH.Rigs.CrateRig)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local Targeting = require(script.Parent.Targeting)

local Reveal = {}

export type Result = {
	Crate: string,
	Hunter: string,
	Uid: string,
	IsNew: boolean,
}

local player = Players.LocalPlayer
local STAGE = Vector3.new(0, 900, -2500)
local CAM_FOV = 50

local playing = false
local skipping = false
local stage: Folder? = nil
local gui: ScreenGui? = nil
local cc: ColorCorrectionEffect? = nil
local rays: Frame? = nil
local raySpeed = 20
local poseConn: RBXScriptConnection? = nil
local hunterRig: HunterRig.Rig? = nil
local hunterState = "Idle"
local againFn: (() -> ())? = nil
local finishedSignal = Instance.new("BindableEvent")
Reveal.Finished = finishedSignal.Event -- (result)
local startedSignal = Instance.new("BindableEvent")
Reveal.Started = startedSignal.Event

function Reveal.IsPlaying(): boolean
	return playing
end

local function fast(): boolean
	local d = State.Data
	return d ~= nil and d.Settings.FastReveal == true
end

-- Runs fn(alpha) every frame for `t` seconds (alpha 0→1). On skip: fn(1) immediately.
local function anim(t: number, fn: (number) -> ())
	if skipping or t <= 0 then
		fn(1)
		return
	end
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / t, 0, 1)
		fn(a)
		if a >= 1 or skipping then
			if skipping then
				fn(1)
			end
			return
		end
		RunService.RenderStepped:Wait()
	end
end

local function easeOutBack(a: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end

local function easeOutBounce(a: number): number
	local n1, d1 = 7.5625, 2.75
	if a < 1 / d1 then
		return n1 * a * a
	elseif a < 2 / d1 then
		a -= 1.5 / d1
		return n1 * a * a + 0.75
	elseif a < 2.5 / d1 then
		a -= 2.25 / d1
		return n1 * a * a + 0.9375
	end
	a -= 2.625 / d1
	return n1 * a * a + 0.984375
end

local controls: any = nil
local function setControls(on: boolean)
	if not controls then
		local ok, mod = pcall(function()
			local ps = player:WaitForChild("PlayerScripts")
			return (require :: any)(ps:WaitForChild("PlayerModule"))
		end)
		if ok and mod then
			controls = mod:GetControls()
		end
	end
	if controls then
		pcall(function()
			if on then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = stage
	return p
end

local function buildStage(rarity: Config.RarityDef)
	local f = Instance.new("Folder")
	f.Name = "GHReveal"
	f.Parent = workspace
	stage = f
	-- floor disc with glowing trim
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 18, 18), Color = Color3.fromRGB(45, 28, 80), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 19, 19), Color = rarity.Color, Material = Enum.Material.Neon, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	-- backdrop with spinning rays (SurfaceGui, unaffected by lighting)
	local back = part({ Size = Vector3.new(70, 44, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 6, 14)) })
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 14,
		LightInfluence = 0,
		Brightness = 1,
		Parent = back,
	})
	local bg: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sg })
	Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 40)),
			ColorSequenceKeypoint.new(0.5, rarity.Color2:Lerp(Color3.fromRGB(40, 20, 70), 0.55)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 10, 40)),
		}),
		Rotation = 90,
		Parent = bg,
	})
	local holder: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(1400, 1400),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = bg,
	})
	-- six full-length bars through the centre = twelve rays (GUI rotation pivots on the centre)
	for i = 0, 5 do
		local ray: Frame = Kit.new("Frame", {
			Size = UDim2.new(0, 110, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Rotation = i * 30,
			Parent = holder,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.58, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
	end
	rays = holder
	-- lights
	local l1 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 7, -6)) })
	Kit.new("PointLight", { Range = 22, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 255), Parent = l1 })
	local l2 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 3, 3)) })
	Kit.new("PointLight", { Name = "RarityLight", Range = 16, Brightness = 0, Color = rarity.Color, Parent = l2 })
end

local function buildGui(): (ScreenGui, TextButton)
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = "GHRevealGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Kit.new("UIScale", { Scale = Kit.UIScale(), Parent = g })
	local skip = Kit.Button(g, {
		Text = "SKIP ⏩",
		Color = "Gray",
		Size = UDim2.fromOffset(150, 56),
		Position = UDim2.new(1, -20, 1, -20),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 5,
		OnClick = function()
			skipping = true
		end,
	})
	gui = g
	return g, skip
end

local function flash(color: Color3, t: number)
	local g = gui
	if not g then
		return
	end
	local f: Frame = Kit.new("Frame", { Size = UDim2.fromScale(4, 4), Position = UDim2.fromScale(-1.5, -1.5), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 20, Parent = g })
	Kit.Tween(f, t, { BackgroundTransparency = 1 })
	task.delay(t, function()
		f:Destroy()
	end)
end

local function cameraShake(intensity: number, t: number)
	local cam = workspace.CurrentCamera
	if not cam or skipping then
		return
	end
	local base = cam.CFrame
	anim(t, function(a)
		local k = intensity * (1 - a)
		cam.CFrame = base * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end)
	cam.CFrame = base
end

local function resultCard(g: ScreenGui, res: Result, rarity: Config.RarityDef)
	local def = Config.Hunters[res.Hunter]
	local d = State.Data
	local card: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(560, 250),
		Position = UDim2.new(0.5, 0, 1, -24),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = g,
	})
	Kit.Corner(card, UDim.new(0, 24))
	Kit.Stroke(card, 5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, Theme.Panel2, Theme.Bg, 90)
	local sc = Kit.new("UIScale", { Scale = 0.3, Parent = card })
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- rarity ribbon
	local ribbon: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(300, 46),
		Position = UDim2.new(0.5, 0, 0, -22),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 12,
		Parent = card,
	})
	Kit.Corner(ribbon, UDim.new(0, 14))
	Kit.Stroke(ribbon, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ribbon, rarity.Color, rarity.Color2, 0)
	Kit.Label(ribbon, rarity.Name, { Size = UDim2.fromScale(0.9, 0.78), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 13, Stroke = 3 })
	Kit.Label(card, string.upper(def.Name), { Size = UDim2.new(1, -40, 0, 54), Position = UDim2.fromOffset(20, 30), ZIndex = 11, Stroke = 4 })
	Kit.Label(card, "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER", { Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 86), Color = Theme.Gold, ZIndex = 11 })
	Kit.Label(card, def.Blurb, { Size = UDim2.new(1, -60, 0, 28), Position = UDim2.fromOffset(30, 122), Color = Theme.Muted, Font = Theme.Body, ZIndex = 11, Stroke = 0 })
	if res.IsNew then
		local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(120, 50), Position = UDim2.new(1, 10, 0, 6), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, ZIndex = 14, Stroke = 4 })
		stamp.Rotation = 14
		local ssc = Kit.new("UIScale", { Scale = 3, Parent = stamp })
		Kit.Tween(ssc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	-- buttons
	local row: Frame = Kit.new("Frame", {
		Size = UDim2.new(1, -40, 0, 64),
		Position = UDim2.new(0, 20, 1, -78),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = card,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 12), Parent = row })
	local equipped = d and table.find(d.Equipped, res.Uid) ~= nil
	local slots = if d then d.Slots or Config.Inventory.BaseSlots else Config.Inventory.BaseSlots
	if d and not equipped then
		local free = #d.Equipped < slots
		-- with full slots, offer EQUIP BEST only if this hunter beats the weakest equipped one
		local weakest = math.huge
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h then
				weakest = math.min(weakest, Config.Hunters[h.Id].Power)
			end
		end
		if free or def.Power > weakest then
			local b: TextButton
			b = Kit.Button(row, {
				Text = if free then "EQUIP" else "EQUIP BEST",
				Color = "Green",
				Size = UDim2.fromOffset(160, 60),
				ZIndex = 12,
				OnClick = function()
					local r = if free then State.Request("Equip", res.Uid) else State.Request("EquipBest")
					if r.ok then
						Kit.SetButtonText(b, "EQUIPPED ✓")
						b:SetAttribute("Color", "Gray")
						b.Active = false
					else
						Kit.Toast(r.err or "Couldn't equip", "Bad")
					end
				end,
			})
			b.Name = "EquipButton"
		end
	end
	if againFn then
		local crate = Config.Crates[res.Crate]
		local fnAgain = againFn
		Kit.Button(row, {
			Text = "AGAIN 💚" .. Format.Short(crate.Price),
			Color = "Purple",
			Size = UDim2.fromOffset(170, 60),
			ZIndex = 12,
			OnClick = function()
				fnAgain()
			end,
		})
	end
	Kit.Button(row, {
		Text = "OK",
		Color = "Blue",
		Size = UDim2.fromOffset(120, 60),
		ZIndex = 12,
		OnClick = function()
			Reveal.Close()
		end,
	})
end

local function teardownStage()
	if poseConn then
		poseConn:Disconnect()
		poseConn = nil
	end
	if stage then
		stage:Destroy()
		stage = nil
	end
	if gui then
		gui:Destroy()
		gui = nil
	end
	hunterRig = nil
	rays = nil
end

-- Ends the reveal and gives the camera back.
function Reveal.Close()
	if not playing then
		return
	end
	teardownStage()
	if cc then
		cc.Brightness = 0
		cc.Saturation = 0
		cc.Contrast = 0
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
	Kit.Screen().Enabled = true
	setControls(true)
	Targeting.SetBlocked(false)
	playing = false
	finishedSignal:Fire()
end

-- Plays the opening for a server-confirmed result. `again` (optional) re-buys the same crate.
function Reveal.Play(res: Result, again: (() -> ())?)
	local def = Config.Hunters[res.Hunter]
	local crateDef = Config.Crates[res.Crate]
	if not def or not crateDef then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	againFn = again
	if playing then
		teardownStage() -- "AGAIN": keep the camera, rebuild the stage
	end
	playing = true
	skipping = false
	startedSignal:Fire()
	Targeting.SetBlocked(true)
	setControls(false)
	Kit.Screen().Enabled = false
	buildStage(rarity)
	local g, skip = buildGui()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = CAM_FOV
	local camCF = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13), STAGE + Vector3.new(0, 2.6, 0))
	cam.CFrame = camCF
	flash(Color3.new(1, 1, 1), 0.35)

	local f = if fast() then 0.5 else 1
	local my = stage

	-- crate
	local crate = CrateRig.Build(res.Crate)
	crate.Model:ScaleTo(1.25)
	crate.Model.Parent = stage
	local base = CFrame.new(STAGE)
	local function placeCrate(cf: CFrame)
		crate.Model:PivotTo(cf)
	end
	placeCrate(base + Vector3.new(0, 9, 0))

	-- rays spin + hunter poses
	raySpeed = 20
	local hunterT0 = os.clock()
	poseConn = RunService.RenderStepped:Connect(function(dt: number)
		if rays then
			rays.Rotation = (rays.Rotation + dt * raySpeed) % 360
		end
		if hunterRig then
			HunterRig.Pose(hunterRig, hunterState, os.clock() - hunterT0, 1)
		end
	end)

	Sound.Play("CrateBuy")
	-- 1) drop in with a bounce
	anim(0.45 * f, function(a)
		placeCrate(base + Vector3.new(0, 9 * (1 - easeOutBounce(a)), 0))
	end)
	if stage ~= my then
		return
	end
	-- 2) shake (+ levitate, darken and converging energy for rarer pulls)
	local shakeT = (0.55 + rarity.RevealPause) * f
	local levitate = if rarity.Order >= 3 then 1.4 else 0
	local charge: ParticleEmitter? = nil
	if rarity.RevealPause > 0.3 and not skipping then
		local sphere = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 2.5, 0)) })
		local e = Instance.new("ParticleEmitter")
		e.Shape = Enum.ParticleEmitterShape.Sphere
		e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Texture = Effects.Textures.Sparkle
		e.Color = ColorSequence.new(rarity.Color, rarity.Color2)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) })
		e.Speed = NumberRange.new(9, 12)
		e.Lifetime = NumberRange.new(0.45, 0.6)
		e.Rate = 0
		e.Parent = sphere
		charge = e
	end
	if cc and rarity.Darken > 0 and not skipping then
		TweenService:Create(cc, TweenInfo.new(shakeT * 0.6), { Brightness = -rarity.Darken * 0.35, Saturation = -rarity.Darken * 0.4 }):Play()
	end
	local rl = (if stage then stage:FindFirstChild("RarityLight", true) else nil) :: any
	if not skipping then
		Sound.Play("CrateShake")
	end
	local nextShakeSound = os.clock() + 0.45
	anim(shakeT, function(a)
		local k = rarity.ShakeIntensity * (0.4 + a)
		local tt = os.clock()
		local wob = CFrame.Angles(math.sin(tt * 38) * 0.06 * k, math.sin(tt * 29) * 0.1 * k, math.sin(tt * 47) * 0.09 * k)
		local lift = levitate * math.sin(math.min(a * 1.6, 1) * math.pi / 2)
		placeCrate(base * CFrame.new(math.sin(tt * 53) * 0.12 * k, lift, 0) * wob)
		raySpeed = 20 + 160 * a * rarity.Order / 5
		if charge then
			charge.Rate = 15 + 110 * a
		end
		if rl then
			rl.Brightness = 3 * a * math.min(1, rarity.Order / 3)
		end
		if tt >= nextShakeSound and a < 0.95 then
			nextShakeSound = tt + 0.45
			Sound.Play("CrateShake", 0.1)
		end
	end)
	if charge then
		charge.Rate = 0
	end
	if stage ~= my then
		return
	end
	placeCrate(base + Vector3.new(0, levitate, 0))
	-- 3) locks pop off
	if not skipping then
		Sound.Play("LockPop")
	end
	anim(0.22 * f, function(a)
		local e = easeOutBack(a)
		crate.Motors.LockL.Transform = CFrame.new(-1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, 2.5 * a)
		crate.Motors.LockR.Transform = CFrame.new(1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, -2.5 * a)
	end)
	-- drop the padlocks (and their welded shackles) out of sight
	crate.Motors.LockL.Transform = CFrame.new(0, -60, 0)
	crate.Motors.LockR.Transform = CFrame.new(0, -60, 0)
	-- 4) lid flies open + light burst
	local burstPos = crate.Burst.WorldPosition
	if not skipping then
		Sound.Play(rarity.Sound)
		flash(rarity.Color, 0.45)
		Effects.Flash(burstPos, rarity.Color, 5 + rarity.Order, 0.5)
		Effects.Burst(burstPos, { Color = rarity.Color, Color2 = Color3.new(1, 1, 1), Count = rarity.Particles, Size = 0.9, Speed = 26, Life = 1.1, Gravity = 18 })
		Effects.Ring(STAGE + Vector3.new(0, 0.2, 0), rarity.Color, 10, 0.6)
		if cc then
			TweenService:Create(cc, TweenInfo.new(0.5), { Brightness = 0.12, Saturation = 0.15 }):Play()
			task.delay(0.5, function()
				if cc then
					TweenService:Create(cc, TweenInfo.new(0.6), { Brightness = 0, Saturation = 0 }):Play()
				end
			end)
		end
		if rarity.CameraPunch then
			cam.FieldOfView = CAM_FOV - 10
			TweenService:Create(cam, TweenInfo.new(0.45, Enum.EasingStyle.Back), { FieldOfView = CAM_FOV }):Play()
			task.spawn(cameraShake, 0.5 * rarity.ShakeIntensity, 0.35)
		end
	end
	crate.Glow.Color = rarity.Color
	anim(0.3 * f, function(a)
		crate.Motors.Lid.Transform = CFrame.Angles(math.rad(115) * easeOutBack(a), 0, 0)
		crate.Glow.Transparency = 1 - 0.85 * a
	end)
	if stage ~= my then
		return
	end
	-- 5) hunter leaps out
	local rig = HunterRig.Build(res.Hunter)
	rig.Model:ScaleTo(1.2)
	rig.Model.Parent = stage
	hunterRig = rig
	hunterState = "Celebrate"
	hunterT0 = os.clock()
	local from = STAGE + Vector3.new(0, levitate + 0.6, 0.2)
	local to = STAGE + Vector3.new(0, 0, -3.4)
	anim(0.55 * f, function(a)
		local p = from:Lerp(to, a) + Vector3.new(0, 5.5 * 4 * a * (1 - a), 0)
		local spin = (1 - a) * math.pi * 2
		rig.Model:PivotTo(CFrame.new(p) * CFrame.Angles(0, spin, 0))
	end)
	rig.Model:PivotTo(CFrame.new(to))
	-- the crate settles back down behind the hunter
	placeCrate(base)
	if not skipping then
		Effects.Ring(to + Vector3.new(0, 0.15, 0), Color3.new(1, 1, 1), 5, 0.4)
		Effects.Burst(to + Vector3.new(0, 3, 0), { Color = rarity.Color, Count = math.floor(rarity.Particles / 3), Size = 0.6, Speed = 14, Life = 0.7 })
	end
	if stage ~= my then
		return
	end
	-- 6) legendary title slam
	if rarity.Order >= 5 and not skipping then
		local title = Kit.Label(g, rarity.Name .. "!", { Size = UDim2.fromOffset(700, 110), Position = UDim2.fromScale(0.5, 0.22), AnchorPoint = Vector2.new(0.5, 0.5), Color = rarity.Color, ZIndex = 8, Stroke = 5 })
		Kit.new("UIGradient", { Color = ColorSequence.new(rarity.Color, rarity.Color2), Rotation = 90, Parent = title })
		local tsc = Kit.new("UIScale", { Scale = 3, Parent = title })
		Kit.Tween(tsc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		task.spawn(cameraShake, 0.35, 0.3)
	end
	skip.Visible = false
	skipping = false
	raySpeed = 25
	cam.CFrame = camCF
	resultCard(g, res, rarity)
end

function Reveal.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "GHRevealCC"
	effect.Parent = Lighting
	cc = effect
end

function Reveal.Start()
	-- respawning mid-reveal must not leave the camera stuck
	player.CharacterAdded:Connect(function()
		if playing then
			Reveal.Close()
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- SHOP: Robux products (Ectoplasm packs, boosts) and game passes. Items without an id in
-- Config show "SOON". Purchases are prompted and granted by the server only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local ShopPanel = {}

local panel: Kit.Panel
local passButtons: { [string]: TextButton } = {}
local ectoLabels: { [string]: TextLabel } = {}

local function card(parent: Instance, order: number, icon: string, name: string, sub: string, price: string, available: boolean, color: string, onBuy: () -> ()): (TextButton, TextLabel)
	local f: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(196, 232), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = parent })
	Kit.Corner(f, UDim.new(0, 18))
	Kit.Stroke(f, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local c = Theme.Buttons[color] or Theme.Buttons.Purple
	Kit.Gradient(f, c[1], c[2], 90)
	Kit.Label(f, icon, { Size = UDim2.fromOffset(80, 70), Position = UDim2.new(0.5, 0, 0, 8), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 63, Stroke = 0 })
	Kit.Label(f, name, { Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 80), ZIndex = 63 })
	local subLabel = Kit.Label(f, sub, { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 126), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Font = Theme.Body })
	local b = Kit.Button(f, {
		Text = if available then price else "SOON",
		Color = if available then "Green" else "Gray",
		Size = UDim2.new(1, -24, 0, 56),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 64,
		OnClick = onBuy,
	})
	return b, subLabel
end

local function buy(key: string)
	local res = State.Request("Buy", key)
	if not res.ok then
		Kit.Toast(res.err or "Can't buy that right now", "Bad")
	end
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local mult = d.ZoneMultiplier or 1
	for _, p in Config.Products do
		local l = ectoLabels[p.Key]
		if l and p.Amount then
			l.Text = "+" .. Format.Short(p.Amount * mult) .. " ECTOPLASM"
		end
	end
	for _, pass in Config.GamePasses do
		local b = passButtons[pass.Key]
		if b and d.Passes and d.Passes[pass.Key] then
			Kit.SetButtonText(b, "OWNED ✓")
			b:SetAttribute("Color", "Gray")
		end
	end
end

function ShopPanel.Init()
	panel = Kit.Panel("Shop", "SHOP", Vector2.new(900, 560), "Pink")
	local scroll: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -16),
		Position = UDim2.fromOffset(0, 14),
		BackgroundTransparency = 1,
		ScrollBarThickness = 10,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	local function section(order: number, title: string): Frame
		Kit.Label(scroll, title, { Size = UDim2.new(1, 0, 0, 30), ZIndex = 62 }).LayoutOrder = order
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 240), BackgroundTransparency = 1, LayoutOrder = order + 1, ZIndex = 61, Parent = scroll })
		Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		return row
	end
	local prodRow = section(1, "BOOSTS & ECTOPLASM")
	for i, p in Config.Products do
		local sub = if p.Kind == "Ecto" then "+" .. Format.Short(p.Amount or 0) .. " ECTOPLASM" else Format.Time(p.Seconds or 0) .. " BOOST"
		local _, subLabel = card(prodRow, i, p.Icon, p.Name, sub, p.PriceLabel, p.ProductId ~= nil, if p.Kind == "Ecto" then "Green" else "Purple", function()
			buy(p.Key)
		end)
		if p.Kind == "Ecto" then
			ectoLabels[p.Key] = subLabel
		end
	end
	local passRow = section(3, "GAME PASSES (FOREVER)")
	for i, pass in Config.GamePasses do
		local sub = if pass.Slots then "+" .. pass.Slots .. " EQUIPPED HUNTERS" else "x" .. tostring(pass.Multiplier or 2) .. " ALL ECTOPLASM"
		local b = card(passRow, i, pass.Icon, pass.Name, sub, pass.PriceLabel, pass.PassId ~= nil, "Orange", function()
			buy(pass.Key)
		end)
		passButtons[pass.Key] = b
	end
	Kit.Label(scroll, "Ectoplasm packs grow with the furthest area you've unlocked.", { Size = UDim2.new(1, 0, 0, 24), Color = Theme.Muted, Font = Theme.Body, ZIndex = 62, Stroke = 0 }).LayoutOrder = 5
	Hud.RegisterPanel("Shop", function()
		panel:Toggle()
	end)
end

function ShopPanel.Start()
	panel.OnOpen.Event:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds by key from GH.Sounds; respects the player's Music/SFX settings.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Sounds = require(GH.Sounds)
local State = require(script.Parent.Parent.State)

local Sound = {}

local pool: { [string]: { Sound } } = {}
local folder: Folder
local music: Sound? = nil
local bossMusic: Sound? = nil
local lastPlay: { [string]: number } = {}

local function sfxOn(): boolean
	local d = State.Data
	return not d or d.Settings.Sfx ~= false
end

local function make(key: string): Sound?
	local def = Sounds[key]
	if not def or not def.Id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch or 1
	s.Looped = def.Looped == true
	s.Parent = folder
	return s
end

-- pitchJitter adds small random variation; pitchMul shifts the pitch (pickup streaks).
function Sound.Play(key: string, pitchJitter: number?, pitchMul: number?)
	if not sfxOn() then
		return
	end
	local now = os.clock()
	if now - (lastPlay[key] or 0) < 0.035 then
		return -- de-dupe bursts (e.g. 20 orbs landing at once)
	end
	lastPlay[key] = now
	local list = pool[key]
	if not list then
		list = {}
		pool[key] = list
	end
	local s: Sound? = nil
	for _, c in list do
		if not c.IsPlaying then
			s = c
			break
		end
	end
	if not s and #list < 4 then
		s = make(key)
		if s then
			table.insert(list, s)
		end
	end
	if s then
		local def = Sounds[key]
		s.PlaybackSpeed = (def.Pitch or 1) * (pitchMul or 1) * (1 + (if pitchJitter then (math.random() * 2 - 1) * pitchJitter else 0))
		s.TimePosition = 0
		s:Play()
	end
end

local function refreshMusic()
	local d = State.Data
	local on = not d or d.Settings.Music ~= false
	for _, m in { music, bossMusic } do
		if m then
			m.Volume = if on then (Sounds[m.Name].Volume) else 0
		end
	end
end

function Sound.Boss(active: boolean)
	if bossMusic and music then
		if active then
			bossMusic:Play()
			music:Pause()
		else
			bossMusic:Stop()
			music:Resume()
		end
	end
end

function Sound.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHSounds"
	folder.Parent = SoundService
end

function Sound.Start()
	music = make("Music")
	bossMusic = make("BossMusic")
	if music then
		music:Play()
	end
	State.Changed:Connect(refreshMusic)
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Targeting</string>
              <string name="Source"><![CDATA[--!strict
-- Ghost selection. PC: click a ghost. Mobile: tap a ghost. Console: ButtonX (or F on a
-- keyboard) targets the ghost nearest the centre of the screen and cycles on repeat presses.
-- The selection is optimistic (instant highlight + sound) and then follows the server's
-- authoritative "Target" attribute.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Targeting = {}

local player = Players.LocalPlayer
local selectRemote: RemoteEvent
local selectHL: Highlight
local hoverHL: Highlight
local pending: number? = nil
local pendingAt = 0
local blocked = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local selectedSignal = Instance.new("BindableEvent")
Targeting.Selected = selectedSignal.Event -- (uid) fired on a local selection

function Targeting.SetBlocked(on: boolean)
	blocked = on
end

function Targeting.Current(): number
	return (player:GetAttribute("Target") :: number?) or 0
end

local function showHighlight(uid: number)
	local e = if uid ~= 0 then Ghosts.Get(uid) else nil
	if e then
		selectHL.Adornee = e.Model
		selectHL.OutlineColor = e.Def.Glow
		selectHL.FillColor = e.Def.Glow
		selectHL.Enabled = true
	else
		selectHL.Adornee = nil
		selectHL.Enabled = false
	end
end

local function rootPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

function Targeting.Select(uid: number)
	if blocked then
		return
	end
	local e = Ghosts.Get(uid)
	if not e then
		return
	end
	local zone = Config.ZoneById[e.Def.Zone]
	local d = State.Data
	if d and zone and not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " first!", "Bad")
		return
	end
	local p = rootPos()
	if p and (e.Pos - p).Magnitude > Config.Combat.MaxRange + 10 then
		Kit.Toast("Get closer to that ghost!", "Bad")
		return
	end
	pending = uid
	pendingAt = os.clock()
	showHighlight(uid)
	Sound.Play("Select")
	Effects.Ring(e.Pos, e.Def.Glow, 4 * e.Def.Scale, 0.35)
	if Targeting.Current() ~= uid then
		selectRemote:FireServer(uid)
	end
	selectedSignal:Fire(uid)
end

-- `pos` is in GUI coordinates (InputObject.Position, TouchTap) unless `viewport` is true
-- (GetMouseLocation); the matching camera functions keep the top-bar inset consistent.
local function ghostAtScreen(pos: Vector2, viewport: boolean?): Ghosts.Entry?
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Ghosts")
	if not cam or not folder then
		return nil
	end
	rayParams.FilterDescendantsInstances = { folder }
	local ray = if viewport then cam:ViewportPointToRay(pos.X, pos.Y) else cam:ScreenPointToRay(pos.X, pos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams)
	if hit then
		return Ghosts.FromInstance(hit.Instance)
	end
	-- forgiving fallback for small/fast ghosts: nearest ghost centre within 60 px of the tap
	local best, bestD = nil, 60
	for _, e in Ghosts.All() do
		local sp, onScreen
		if viewport then
			sp, onScreen = cam:WorldToViewportPoint(e.Pos)
		else
			sp, onScreen = cam:WorldToScreenPoint(e.Pos)
		end
		if onScreen then
			local dist = (Vector2.new(sp.X, sp.Y) - pos).Magnitude
			if dist < bestD then
				best, bestD = e, dist
			end
		end
	end
	return best
end

-- Console / keyboard: pick the ghost closest to screen centre (within range), cycling.
local function cycleTarget()
	local cam = workspace.CurrentCamera
	local p = rootPos()
	if not cam or not p then
		return
	end
	local list = {}
	for uid, e in Ghosts.All() do
		if (e.Pos - p).Magnitude <= Config.Combat.MaxRange then
			local sp, onScreen = cam:WorldToViewportPoint(e.Pos)
			if onScreen then
				local c = cam.ViewportSize / 2
				table.insert(list, { Uid = uid, Score = (Vector2.new(sp.X, sp.Y) - c).Magnitude })
			end
		end
	end
	if #list == 0 then
		Kit.Toast("No ghosts nearby!", "Bad")
		return
	end
	table.sort(list, function(a, b)
		return a.Score < b.Score
	end)
	local cur = pending or Targeting.Current()
	local idx = 1
	for i, item in list do
		if item.Uid == cur then
			idx = (i % #list) + 1
			break
		end
	end
	Targeting.Select(list[idx].Uid)
end

function Targeting.Init()
	selectHL = Instance.new("Highlight")
	selectHL.Name = "GHSelect"
	selectHL.FillTransparency = 0.75
	selectHL.OutlineTransparency = 0
	selectHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	selectHL.Enabled = false
	selectHL.Parent = workspace
	hoverHL = Instance.new("Highlight")
	hoverHL.Name = "GHHover"
	hoverHL.FillTransparency = 1
	hoverHL.OutlineColor = Color3.new(1, 1, 1)
	hoverHL.OutlineTransparency = 0.3
	hoverHL.DepthMode = Enum.HighlightDepthMode.Occluded
	hoverHL.Enabled = false
	hoverHL.Parent = workspace
end

function Targeting.Start()
	selectRemote = Net.Event("SelectTarget")

	-- Mouse click (PC). Taps use TouchTap so camera drags never select by accident.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or blocked then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local e = ghostAtScreen(Vector2.new(input.Position.X, input.Position.Y))
			if e then
				Targeting.Select(e.Uid)
			end
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or blocked or #positions == 0 then
			return
		end
		local e = ghostAtScreen(positions[1])
		if e then
			Targeting.Select(e.Uid)
		end
	end)
	ContextActionService:BindAction("GHTarget", function(_, state)
		if state == Enum.UserInputState.Begin and not blocked then
			cycleTarget()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonX, Enum.KeyCode.F)

	-- authoritative target from the server
	player:GetAttributeChangedSignal("Target"):Connect(function()
		local uid = Targeting.Current()
		pending = nil
		showHighlight(uid)
	end)
	Ghosts.Died:Connect(function(uid)
		if selectHL.Adornee and Targeting.Current() == uid then
			showHighlight(0)
		end
	end)

	-- hover outline (mouse only) + reconcile a rejected optimistic selection
	RunService.RenderStepped:Connect(function()
		if pending and os.clock() - pendingAt > 0.8 then
			pending = nil
			showHighlight(Targeting.Current())
		end
		if not UserInputService.MouseEnabled or blocked then
			hoverHL.Enabled = false
			return
		end
		local m = UserInputService:GetMouseLocation()
		local e = ghostAtScreen(m, true)
		if e and e.Model ~= selectHL.Adornee then
			hoverHL.Adornee = e.Model
			hoverHL.Enabled = true
		else
			hoverHL.Enabled = false
		end
	end)
end

return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time guidance without walls of text:
--   1 TAP A GHOST!  →  2 COLLECT ECTOPLASM!  →  3 OPEN A HUNTER CRATE!  →
--   4 EQUIP YOUR NEW HUNTER!  →  5 UNLOCK THE CEMETERY!  →  done
-- A glowing breadcrumb trail on the ground + a bouncing arrow over the target show where to
-- go; menu buttons pulse when they're the next step. After the tutorial a small NEXT GOAL
-- chip keeps the next zone in view. Progress is saved (server only accepts forward steps).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Orbs = require(script.Parent.Orbs)
local Reveal = require(script.Parent.Reveal)
local CratePanel = require(script.Parent.CratePanel)
local HuntersPanel = require(script.Parent.HuntersPanel)
local Boss = require(script.Parent.Boss)
local Sound = require(script.Parent.Sound)

local Tutorial = {}

local player = Players.LocalPlayer
local STEPS = #Config.Tutorial.Steps
local step = 0 -- 0 = not loaded yet
local promptFrame: Frame
local promptLabel: TextLabel
local promptSub: TextLabel
local goalChip: Frame
local goalLabel: TextLabel
local goalFill: Frame
local dots: { BasePart } = {}
local marker: BillboardGui
local markerPart: Part
local guideTarget: (() -> Vector3?)? = nil
local guideUntil = math.huge
local framed = false
local equipRing: Frame? = nil

local DOTS = 12
local SPACING = 3.6

--------------------------------------------------------------------------------
-- guide (breadcrumbs + marker)
--------------------------------------------------------------------------------
local function setGuide(fn: (() -> Vector3?)?, seconds: number?)
	guideTarget = fn
	guideUntil = if seconds then os.clock() + seconds else math.huge
end
Tutorial.SetGuide = setGuide

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local hidden = CFrame.new(0, -400, 0)
local function updateGuide()
	local root = rootPart()
	local target = if guideTarget and os.clock() < guideUntil then guideTarget() else nil
	if not root or not target or Reveal.IsPlaying() then
		for _, d in dots do
			d.CFrame = hidden
		end
		marker.Enabled = false
		return
	end
	markerPart.CFrame = CFrame.new(target)
	marker.Enabled = true
	local from = root.Position - Vector3.new(0, 2.7, 0)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 6 then
		for _, d in dots do
			d.CFrame = hidden
		end
		return
	end
	local dir = flat.Unit
	local t = os.clock()
	local offset = (t * 6) % SPACING -- dots flow toward the target
	local groundEnd = math.min(target.Y, from.Y + 2)
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	for i, d in dots do
		local along = 2.5 + (i - 1) * SPACING + offset
		if along > dist - 2 then
			table.insert(parts, d)
			table.insert(cfs, hidden)
		else
			local k = along / dist
			local y = from.Y + (groundEnd - from.Y) * k + 0.35
			local pulse = 0.75 + 0.25 * math.sin(t * 6 - i * 0.6)
			d.Size = Vector3.new(pulse, pulse, pulse)
			table.insert(parts, d)
			table.insert(cfs, CFrame.new(from.X + dir.X * along, y, from.Z + dir.Z * along))
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

--------------------------------------------------------------------------------
-- prompts
--------------------------------------------------------------------------------
local shownText = ""
local function setPrompt(text: string?, sub: string?)
	if not text then
		if promptFrame.Visible then
			promptFrame.Visible = false
			shownText = ""
		end
		return
	end
	promptSub.Text = sub or ""
	promptSub.Visible = sub ~= nil
	if text ~= shownText then
		shownText = text
		promptLabel.Text = text
		promptFrame.Visible = true
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		sc.Scale = 0.5
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.Play("Select")
	end
end

local function tapWord(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Gamepad1 then
		return "PRESS Ⓧ TO TARGET A GHOST!"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "TAP A GHOST!"
	end
	return "CLICK A GHOST!"
end

local function nearestGhost(): Vector3?
	local root = rootPart()
	if not root then
		return nil
	end
	local d = State.Data
	local best, bestD = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Def.Kind ~= "Event" and (not d or d.Zones[e.Def.Zone]) then
			local dist = (e.Pos - root.Position).Magnitude
			if dist < bestD then
				best, bestD = e, dist
			end
		end
	end
	return if best then best.Pos + Vector3.new(0, 2.5 * best.Def.Scale + 1, 0) else nil
end

local function cratePos(): Vector3?
	local p = Config.Layout.CrateStations.Beginner
	return p + Vector3.new(0, 8, 0)
end

local function gatePos(): Vector3?
	local g = Config.Layout.Gates.Cemetery
	return if g then Vector3.new(0, 10, g.Z - 4) else nil
end

local function advance(to: number)
	if to <= step then
		return
	end
	step = to
	task.spawn(State.Request, "Tutorial", to)
	if to > STEPS then
		setPrompt(nil)
		setGuide(nil)
		Hud.Pulse("Hunters", false)
		Hud.Banner("TUTORIAL COMPLETE!", "Keep hunting, collecting and unlocking!", Theme.Gold)
	end
end

local function setEquipRing(on: boolean)
	if on and not equipRing then
		local b = HuntersPanel.EquipBestButton()
		local ring: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 80, Parent = b })
		Kit.Corner(ring, UDim.new(0, 16))
		local st = Kit.Stroke(ring, 5, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		equipRing = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.new(1, 24, 1, 24) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and equipRing then
		equipRing:Destroy()
		equipRing = nil
	end
end

-- One-time camera framing of the nearest ghost for brand-new players.
local function frameGhost()
	if framed then
		return
	end
	framed = true
	local root = rootPart()
	local target = nearestGhost()
	local cam = workspace.CurrentCamera
	if not root or not target or not cam then
		return
	end
	local start = cam.CFrame
	local eye = root.Position + Vector3.new(0, 5, 0) - (target - root.Position).Unit * 10
	local look = CFrame.lookAt(eye, target)
	cam.CameraType = Enum.CameraType.Scriptable
	local tw = TweenService:Create(cam, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { CFrame = look })
	tw:Play()
	tw.Completed:Wait()
	task.wait(0.8)
	local back = TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { CFrame = start })
	back:Play()
	back.Completed:Wait()
	if not Reveal.IsPlaying() then
		cam.CameraType = Enum.CameraType.Custom
	end
end

local collectedOnce = false

local function tick()
	local d = State.Data
	if not d or step == 0 then
		return
	end
	local panel = Kit.CurrentPanel()
	if step > STEPS then
		-- NEXT GOAL chip
		local nextZone: Config.ZoneDef? = nil
		for _, z in Config.Zones do
			if not d.Zones[z.Id] then
				nextZone = z
				break
			end
		end
		local bossState = Boss.State()
		if nextZone and not panel and bossState == "Idle" and not Reveal.IsPlaying() then
			goalChip.Visible = true
			goalLabel.Text = "NEXT: UNLOCK " .. nextZone.Name .. "  " .. Format.Short(math.min(d.Ecto, nextZone.Cost)) .. " / " .. Format.Short(nextZone.Cost)
			goalFill.Size = UDim2.fromScale(math.clamp(d.Ecto / nextZone.Cost, 0.02, 1), 1)
		else
			goalChip.Visible = false
		end
		return
	end
	goalChip.Visible = false
	if Reveal.IsPlaying() then
		setPrompt(nil)
		return
	end
	local target = (player:GetAttribute("Target") :: number?) or 0
	if step == 1 then
		setPrompt(tapWord())
		setGuide(nearestGhost)
		if target ~= 0 then
			advance(2)
		end
	elseif step == 2 then
		if Orbs.Count() > 0 then
			setPrompt("COLLECT ECTOPLASM!", "Walk close - it flies to you!")
			setGuide(function()
				local root = rootPart()
				return if root then Orbs.Nearest(root.Position) else nil
			end)
		elseif target ~= 0 then
			setPrompt("YOUR HUNTER IS ON IT!", "Ghosts POOF into Ectoplasm")
			setGuide(nil)
		else
			setPrompt(tapWord())
			setGuide(nearestGhost)
		end
		if collectedOnce then
			advance(3)
		end
	elseif step == 3 then
		local price = Config.Crates.Beginner.Price
		if (d.Stats.Crates or 0) >= 1 then
			advance(4)
		elseif d.Ecto >= price or (d.FreeCrates.Beginner or 0) > 0 then
			if CratePanel.IsOpen() then
				setPrompt("TAP OPEN!")
				setGuide(nil)
			else
				setPrompt("OPEN A HUNTER CRATE!", "Follow the trail to the crate")
				setGuide(cratePos)
			end
		else
			setPrompt("COLLECT " .. price .. " ECTOPLASM", Format.Commas(d.Ecto) .. " / " .. price .. "  -  defeat more ghosts!")
			setGuide(if target == 0 then nearestGhost else nil)
		end
	elseif step == 4 then
		if #d.Equipped >= 2 then
			Hud.Pulse("Hunters", false)
			setEquipRing(false)
			advance(5)
		elseif panel == "Hunters" then
			setPrompt("TAP EQUIP BEST!")
			Hud.Pulse("Hunters", false)
			setEquipRing(true)
		else
			setPrompt("EQUIP YOUR NEW HUNTER!", "Open HUNTERS")
			Hud.Pulse("Hunters", true)
			setEquipRing(false)
		end
		setGuide(nil)
	elseif step == 5 then
		local zone = Config.ZoneById.Cemetery
		if d.Zones.Cemetery then
			advance(6)
		elseif panel then
			setPrompt(nil)
		elseif d.Ecto >= zone.Cost then
			setPrompt("UNLOCK THE CEMETERY!", "Follow the trail to the gate")
			setGuide(gatePos)
		else
			setPrompt("UNLOCK THE CEMETERY!", Format.Commas(d.Ecto) .. " / " .. Format.Commas(zone.Cost) .. " Ectoplasm  -  open crates, equip the best!")
			setGuide(nil)
		end
	end
end

function Tutorial.Init()
	local screen = Kit.Screen()
	promptFrame = Kit.new("Frame", {
		Name = "TutorialPrompt",
		Size = UDim2.fromOffset(560, 92),
		Position = UDim2.new(0.5, 0, 1, -170),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 40,
		Parent = screen,
	})
	Kit.new("UIScale", { Parent = promptFrame })
	promptLabel = Kit.Label(promptFrame, "", { Size = UDim2.new(1, 0, 0, 58), Color = Theme.Ecto, ZIndex = 41, Stroke = 4 })
	promptSub = Kit.Label(promptFrame, "", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 60), Color = Theme.Text, ZIndex = 41, Stroke = 3 })
	Kit.Button(promptFrame, {
		Text = "SKIP",
		Color = "Gray",
		Size = UDim2.fromOffset(70, 34),
		Position = UDim2.new(1, 50, 0, 12),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 42,
		OnClick = function()
			advance(STEPS + 1)
		end,
	})
	-- bounce the prompt gently
	task.spawn(function()
		while true do
			if promptFrame.Visible then
				Kit.Tween(promptLabel, 0.5, { Position = UDim2.fromOffset(0, -6) }, Enum.EasingStyle.Sine)
				task.wait(0.5)
				Kit.Tween(promptLabel, 0.5, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Sine)
			end
			task.wait(0.5)
		end
	end)
	goalChip = Kit.new("Frame", {
		Size = UDim2.fromOffset(420, 32),
		Position = UDim2.new(0.5, 0, 0, 142),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	})
	Kit.Corner(goalChip, UDim.new(1, 0))
	Kit.Stroke(goalChip, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	goalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Theme.Ecto, BackgroundTransparency = 0.55, ZIndex = 21, Parent = goalChip })
	Kit.Corner(goalFill, UDim.new(1, 0))
	goalLabel = Kit.Label(goalChip, "", { Size = UDim2.fromScale(0.94, 0.68), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 22 })

	-- breadcrumbs + marker
	local folder = Instance.new("Folder")
	folder.Name = "GHGuide"
	folder.Parent = workspace
	for _ = 1, DOTS do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.9, 0.9, 0.9)
		p.Material = Enum.Material.Neon
		p.Color = Theme.Ecto
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = hidden
		p.Parent = folder
		table.insert(dots, p)
	end
	markerPart = Instance.new("Part")
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(1, 1, 1)
	markerPart.CFrame = hidden
	markerPart.Parent = folder
	marker = Kit.new("BillboardGui", {
		Size = UDim2.fromOffset(90, 90),
		StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Enabled = false,
		Adornee = markerPart,
		Parent = folder,
	})
	local arrow = Kit.Label(marker, "⬇", { Size = UDim2.fromScale(1, 1), Color = Theme.Ecto, Stroke = 4 })
	task.spawn(function()
		while true do
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromOffset(0, 14) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
		end
	end)
end

function Tutorial.Start()
	Orbs.Collected:Connect(function()
		collectedOnce = true
	end)
	RunService.RenderStepped:Connect(updateGuide)
	-- "SHOW ME" on the boss bar reuses the trail for a few seconds
	Boss.PointRequested.Event:Connect(function()
		local _, pos = Boss.State()
		setGuide(function()
			return pos + Vector3.new(0, 16, 0)
		end, 10)
	end)
	task.spawn(function()
		local d = State.WaitForData()
		step = math.clamp(d.Tutorial or 1, 1, STEPS + 1)
		if step == 1 then
			-- let the world settle, then frame the first ghost
			task.wait(2)
			if (player:GetAttribute("Target") or 0) == 0 then
				frameGhost()
			end
		end
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[--!strict
-- UPGRADES: Pickup Radius, Ectoplasm Bonus, Movement Speed. Level pips, current → next value
-- and an escalating price; the server validates every purchase.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local UpgradesPanel = {}

type Row = { Pips: { Frame }, Value: TextLabel, Buy: TextButton }

local panel: Kit.Panel
local rows: { [string]: Row } = {}

local function fmt(up: Config.UpgradeDef, v: number): string
	if up.Format == "percent" then
		return "+" .. math.floor(v * 100 + 0.5) .. "%"
	elseif up.Format == "studs" then
		return v .. " studs"
	end
	return tostring(v)
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	for id, row in rows do
		local up = Config.Upgrades[id]
		local level = d.Upgrades[id] or 1
		for i, pip in row.Pips do
			pip.BackgroundColor3 = if i <= level then Theme.Ecto else Theme.Bg
		end
		local cur = Rules.UpgradeValue(up.Levels, level)
		local cost = Rules.UpgradeCost(up.Costs, level)
		if cost then
			row.Value.Text = fmt(up, cur) .. "  →  " .. fmt(up, Rules.UpgradeValue(up.Levels, level + 1))
			Kit.SetButtonText(row.Buy, "💚 " .. Format.Short(cost))
			row.Buy:SetAttribute("Color", if d.Ecto >= cost then "Green" else "Gray")
		else
			row.Value.Text = fmt(up, cur) .. "  (MAX)"
			Kit.SetButtonText(row.Buy, "MAXED ★")
			row.Buy:SetAttribute("Color", "Orange")
		end
	end
end

function UpgradesPanel.Init()
	panel = Kit.Panel("Upgrades", "UPGRADES", Vector2.new(780, 470), "Green")
	local list: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 1, -20), Position = UDim2.fromOffset(0, 18), BackgroundTransparency = 1, ZIndex = 61, Parent = panel.Body })
	Kit.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	for i, id in Config.UpgradeOrder do
		local up = Config.Upgrades[id]
		local r: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 118), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.4, LayoutOrder = i, ZIndex = 62, Parent = list })
		Kit.Corner(r, UDim.new(0, 18))
		local icon: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(88, 88), Position = UDim2.new(0, 14, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = r })
		Kit.Corner(icon, UDim.new(0, 18))
		Kit.Stroke(icon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(icon, Theme.Panel3, Theme.Panel, 90)
		Kit.Label(icon, up.Icon, { Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 64, Stroke = 0 })
		Kit.Label(r, up.Name, { Size = UDim2.fromOffset(330, 32), Position = UDim2.fromOffset(118, 10), Align = Enum.TextXAlignment.Left, ZIndex = 63 })
		Kit.Label(r, up.Description, { Size = UDim2.fromOffset(340, 22), Position = UDim2.fromOffset(118, 44), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, ZIndex = 63, Stroke = 0 })
		local value = Kit.Label(r, "", { Size = UDim2.fromOffset(300, 26), Position = UDim2.fromOffset(118, 74), Align = Enum.TextXAlignment.Left, Color = Theme.Ecto, ZIndex = 63 })
		local pipRow: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(150, 20), Position = UDim2.new(1, -220, 0, 16), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 63, Parent = r })
		Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = pipRow })
		local pips = {}
		for _ = 1, #up.Levels do
			local pip: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(24, 18), BackgroundColor3 = Theme.Bg, ZIndex = 64, Parent = pipRow })
			Kit.Corner(pip, UDim.new(0, 6))
			Kit.Stroke(pip, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
			table.insert(pips, pip)
		end
		local buy = Kit.Button(r, {
			Text = "",
			Color = "Green",
			Size = UDim2.fromOffset(190, 66),
			Position = UDim2.new(1, -14, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 64,
			OnClick = function()
				local res = State.Request("BuyUpgrade", id)
				if res.ok then
					Sound.Play("Upgrade")
					Kit.Toast(up.Name .. " upgraded to level " .. tostring(res.Level) .. "!", "Good")
					local char = game:GetService("Players").LocalPlayer.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						Effects.Burst(root.Position, { Color = Theme.Ecto, Count = 30, Size = 0.8, Speed = 16 })
						Effects.Ring(root.Position - Vector3.new(0, 2.8, 0), Theme.Ecto, 8, 0.5)
					end
				else
					Kit.Toast(res.err or "Can't buy that yet", "Bad")
				end
			end,
		})
		rows[id] = { Pips = pips, Value = value, Buy = buy }
	end
	Hud.RegisterPanel("Upgrades", function()
		panel:Toggle()
	end)
end

function UpgradesPanel.Start()
	panel.OnOpen.Event:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

function UpgradesPanel.Open()
	if not panel.IsOpen then
		panel:Open()
	end
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="64">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR client entry: initialises every controller, then starts them.
local StarterGui = game:GetService("StarterGui")

local State = require(script.Parent.State)
State.Init()

-- no tools or health in this game: keep the screen clean
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local Controllers = script.Parent.Controllers
local order = {
	"Sound",
	"Effects",
	"Hud",
	"Ghosts",
	"Targeting",
	"Crew",
	"Orbs",
	"Reveal",
	"CratePanel",
	"HuntersPanel",
	"IndexPanel",
	"UpgradesPanel",
	"ShopPanel",
	"DailyPanel",
	"GatePanel",
	"Boss",
	"Ambience",
	"Tutorial",
}
local loaded: { any } = {}
for _, name in order do
	local mod = require(Controllers:FindFirstChild(name) :: ModuleScript) :: any
	table.insert(loaded, mod)
	if mod.Init then
		mod.Init()
	end
end
for _, mod in loaded do
	if mod.Start then
		task.spawn(mod.Start)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client mirror of the server snapshot (read-only; the server is the authority).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)

local State = {}

State.Data = nil :: any -- latest snapshot (see DataService.snapshot on the server)
State.Ecto = 0
local changed = Instance.new("BindableEvent")
local ectoChanged = Instance.new("BindableEvent")
State.Changed = changed.Event -- (data)
State.EctoChanged = ectoChanged.Event -- (new, old)

-- os.time() on the server minus the client's, so countdowns use server time.
State.ClockOffset = 0

local request: RemoteFunction? = nil

function State.Init()
	request = Net.Function("Request")
	Net.Event("Sync").OnClientEvent:Connect(function(data: any)
		State.ClockOffset = (data.ServerTime or os.time()) - os.time()
		State.Data = data
		local old = State.Ecto
		State.Ecto = data.Ecto
		changed:Fire(data)
		if old ~= data.Ecto then
			ectoChanged:Fire(data.Ecto, old)
		end
	end)
	Net.Event("Ecto").OnClientEvent:Connect(function(value: number)
		local old = State.Ecto
		State.Ecto = value
		if State.Data then
			State.Data.Ecto = value
		end
		ectoChanged:Fire(value, old)
	end)
end

function State.Now(): number
	return os.time() + State.ClockOffset
end

-- Calls a server action; returns the response table (never errors).
function State.Request(action: string, ...: any): any
	local rf = request
	if not rf then
		return { ok = false, err = "Loading..." }
	end
	local args = table.pack(...)
	local ok, res = pcall(function()
		return rf:InvokeServer(action, table.unpack(args, 1, args.n))
	end)
	if not ok or type(res) ~= "table" then
		return { ok = false, err = "Connection hiccup, try again" }
	end
	return res
end

function State.WaitForData(): any
	while not State.Data do
		changed.Event:Wait()
	end
	return State.Data
end

function State.CountOwned(): number
	local n = 0
	if State.Data then
		for _ in State.Data.Hunters do
			n += 1
		end
	end
	return n
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny UI toolkit: creation helpers, chunky animated buttons, modal panels (one open at a
-- time, dimmed background, X button) and toasts.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent.Theme)

local Kit = {}

local player = Players.LocalPlayer
local sound: ((string) -> ())? = nil

function Kit.SetSound(fn: (string) -> ())
	sound = fn
end

local function play(name: string)
	if sound then
		(sound :: (string) -> ())(name)
	end
end
Kit.Play = play

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.Tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function Kit.Corner(parent: Instance, radius: UDim?): UICorner
	return Kit.new("UICorner", { CornerRadius = radius or UDim.new(0, 14), Parent = parent })
end

function Kit.Stroke(parent: Instance, thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return Kit.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Outline,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Kit.Gradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?): UIGradient
	return Kit.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90, Parent = parent })
end

function Kit.Padding(parent: Instance, px: number)
	Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

export type LabelProps = {
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Font: Enum.Font?,
	Align: Enum.TextXAlignment?,
	Stroke: number?,
	TextSize: number?,
	ZIndex: number?,
	Wrap: boolean?,
}

function Kit.Label(parent: Instance?, text: string, p: LabelProps?): TextLabel
	local o: LabelProps = p or {}
	local l: TextLabel = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero,
		Text = text,
		TextColor3 = o.Color or Theme.Text,
		Font = o.Font or Theme.Title,
		TextScaled = o.TextSize == nil,
		TextSize = o.TextSize or 14,
		TextWrapped = o.Wrap ~= false,
		TextXAlignment = o.Align or Enum.TextXAlignment.Center,
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	if o.TextSize == nil then
		Kit.new("UITextSizeConstraint", { MaxTextSize = 64, MinTextSize = 8, Parent = l })
	end
	if (o.Stroke or 2) > 0 then
		Kit.new("UIStroke", { Thickness = o.Stroke or 2, Color = Theme.Outline, Parent = l })
	end
	return l
end

export type ButtonProps = {
	Text: string?,
	Icon: string?,
	Color: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	OnClick: (() -> ())?,
	ZIndex: number?,
	TextScale: number?,
}

-- Chunky gradient button with press/hover animation and click sound.
function Kit.Button(parent: Instance?, p: ButtonProps): TextButton
	local colors = Theme.Buttons[p.Color or "Green"] or Theme.Buttons.Green
	local b: TextButton = Kit.new("TextButton", {
		Size = p.Size or UDim2.fromOffset(160, 56),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		ZIndex = p.ZIndex or 1,
		Parent = parent,
	})
	Kit.Corner(b, UDim.new(0, 14))
	Kit.Stroke(b, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local grad = Kit.Gradient(b, colors[1], colors[2], 90)
	b:SetAttribute("Color", p.Color or "Green")
	-- glossy top highlight
	local gloss = Kit.new("Frame", {
		Size = UDim2.new(1, -10, 0.38, 0),
		Position = UDim2.fromOffset(5, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		ZIndex = b.ZIndex,
		Parent = b,
	})
	Kit.Corner(gloss, UDim.new(0, 10))
	local text = (if p.Icon then p.Icon .. " " else "") .. (p.Text or "")
	local label = Kit.Label(b, text, {
		Size = UDim2.fromScale(0.9, p.TextScale or 0.62),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = b.ZIndex + 1,
	})
	label.Name = "Label"
	local scale = Kit.new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		Kit.Tween(scale, 0.12, { Scale = 1.06 })
		play("Hover")
	end)
	b.MouseLeave:Connect(function()
		Kit.Tween(scale, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		Kit.Tween(scale, 0.06, { Scale = 0.92 })
	end)
	b.MouseButton1Up:Connect(function()
		Kit.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	b.Activated:Connect(function()
		play("Click")
		if p.OnClick then
			(p.OnClick :: () -> ())()
		end
	end)
	b:GetAttributeChangedSignal("Color"):Connect(function()
		local c = Theme.Buttons[b:GetAttribute("Color") :: string] or Theme.Buttons.Green
		grad.Color = ColorSequence.new(c[1], c[2])
	end)
	return b
end

function Kit.SetButtonText(b: TextButton, text: string)
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l then
		l.Text = text
	end
end

--------------------------------------------------------------------------------
-- Screen + panels
--------------------------------------------------------------------------------
local screen: ScreenGui? = nil
local overlay: ScreenGui? = nil
local uiScale: UIScale? = nil

local function updateScale()
	local cam = workspace.CurrentCamera
	if not cam or not uiScale then
		return
	end
	local vp = cam.ViewportSize
	local s = math.clamp(math.min(vp.Y / Theme.ReferenceHeight, vp.X / 1000), 0.55, 1.35)
	for _, gui in { screen, overlay } do
		local sc = gui and gui:FindFirstChildOfClass("UIScale")
		if sc then
			sc.Scale = s
		end
	end
end

local function makeScreen(name: string, order: number): ScreenGui
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Kit.new("UIScale", { Parent = g })
	return g
end

-- Main HUD screen (UIScale'd). Children should use offsets designed for the reference size,
-- or scale anchored to edges.
function Kit.Screen(): ScreenGui
	if not screen then
		local s = makeScreen("GHHud", 10)
		screen = s
		overlay = makeScreen("GHOverlay", 20)
		uiScale = s:FindFirstChildOfClass("UIScale")
		local cam = workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	return screen :: ScreenGui
end

function Kit.Overlay(): ScreenGui
	Kit.Screen()
	return overlay :: ScreenGui
end

function Kit.UIScale(): number
	return if uiScale then uiScale.Scale else 1
end

-- Logical (pre-UIScale) screen size, for laying out UIScale'd content.
function Kit.LogicalSize(): Vector2
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	return vp / Kit.UIScale()
end

export type Panel = {
	Name: string,
	Root: Frame,
	Body: Frame,
	Title: TextLabel,
	IsOpen: boolean,
	Open: (Panel) -> (),
	Close: (Panel) -> (),
	Toggle: (Panel) -> (),
	OnOpen: BindableEvent,
	OnClose: BindableEvent,
}

local current: Panel? = nil
local dim: Frame? = nil
local panelOpenedSignal = Instance.new("BindableEvent")
Kit.PanelOpened = panelOpenedSignal.Event -- (name or nil)

local function getDim(): Frame
	if not dim then
		local d: Frame = Kit.new("TextButton", {
			Name = "Dim",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(4, 4),
			Position = UDim2.fromScale(-1.5, -1.5),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 50,
			Parent = Kit.Screen(),
		})
		;(d :: any).Activated:Connect(function()
			if current then
				(current :: Panel):Close()
			end
		end)
		dim = d
	end
	return dim :: Frame
end

function Kit.CurrentPanel(): string?
	return if current then (current :: Panel).Name else nil
end

-- Modal panel centred on screen.
function Kit.Panel(name: string, title: string, size: Vector2, color: string?): Panel
	local root: Frame = Kit.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 60,
		Parent = Kit.Screen(),
	})
	Kit.Corner(root, UDim.new(0, 24))
	Kit.Stroke(root, 5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(root, Theme.Panel2, Theme.Panel, 90)
	local scale = Kit.new("UIScale", { Parent = root })
	-- title banner
	local banner: Frame = Kit.new("Frame", {
		Size = UDim2.new(0.5, 0, 0, 58),
		Position = UDim2.new(0.5, 0, 0, -24),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 62,
		Parent = root,
	})
	Kit.Corner(banner, UDim.new(0, 18))
	Kit.Stroke(banner, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local bc = Theme.Buttons[color or "Purple"] or Theme.Buttons.Purple
	Kit.Gradient(banner, bc[1], bc[2], 90)
	local titleLabel = Kit.Label(banner, title, { Size = UDim2.fromScale(0.9, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 63, Stroke = 3 })
	local body: Frame = Kit.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -36, 1, -60),
		Position = UDim2.fromOffset(18, 44),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = root,
	})
	local panel: Panel
	panel = {
		Name = name,
		Root = root,
		Body = body,
		Title = titleLabel,
		IsOpen = false,
		OnOpen = Instance.new("BindableEvent"),
		OnClose = Instance.new("BindableEvent"),
		Open = function(self: Panel)
			if current and current ~= self then
				(current :: Panel):Close()
			end
			if self.IsOpen then
				return
			end
			current = self
			self.IsOpen = true
			local d = getDim()
			d.Visible = true
			Kit.Tween(d, 0.2, { BackgroundTransparency = 0.45 })
			root.Visible = true
			scale.Scale = 0.6
			Kit.Tween(scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
			play("PanelOpen")
			self.OnOpen:Fire()
			panelOpenedSignal:Fire(self.Name)
		end,
		Close = function(self: Panel)
			if not self.IsOpen then
				return
			end
			self.IsOpen = false
			if current == self then
				current = nil
				local d = getDim()
				Kit.Tween(d, 0.15, { BackgroundTransparency = 1 })
				task.delay(0.15, function()
					if not current then
						d.Visible = false
					end
				end)
			end
			Kit.Tween(scale, 0.12, { Scale = 0.7 })
			task.delay(0.12, function()
				if not self.IsOpen then
					root.Visible = false
				end
			end)
			self.OnClose:Fire()
			panelOpenedSignal:Fire(nil)
		end,
		Toggle = function(self: Panel)
			if self.IsOpen then
				self:Close()
			else
				self:Open()
			end
		end,
	}
	-- big obvious X
	Kit.Button(root, {
		Text = "X",
		Color = "Red",
		Size = UDim2.fromOffset(58, 58),
		Position = UDim2.new(1, 14, 0, -18),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 64,
		OnClick = function()
			panel:Close()
		end,
	})
	return panel
end

-- Close any open panel (Escape / B button).
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.ButtonB or (input.KeyCode == Enum.KeyCode.Backspace and not processed) then
		if current then
			(current :: Panel):Close()
		end
	end
end)
GuiService.MenuOpened:Connect(function()
	if current then
		(current :: Panel):Close()
	end
end)

--------------------------------------------------------------------------------
-- Toasts
--------------------------------------------------------------------------------
local toastHolder: Frame? = nil

function Kit.Toast(text: string, color: string?)
	if not toastHolder then
		local h: Frame = Kit.new("Frame", {
			Name = "Toasts",
			Size = UDim2.fromOffset(520, 300),
			Position = UDim2.new(0.5, 0, 0, 120),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			ZIndex = 90,
			Parent = Kit.Overlay(),
		})
		Kit.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = h,
		})
		toastHolder = h
	end
	local holder = toastHolder :: Frame
	local col = if color == "Bad" then Theme.Bad elseif color == "Good" then Theme.Good elseif color == "Gold" then Theme.Gold else Theme.Panel3
	local f: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(480, 44),
		BackgroundColor3 = col,
		BackgroundTransparency = 0.05,
		LayoutOrder = math.floor(os.clock() * 100),
		ZIndex = 90,
		Parent = holder,
	})
	Kit.Corner(f, UDim.new(0, 14))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local l = Kit.Label(f, text, { Size = UDim2.new(1, -20, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 91 })
	local sc = Kit.new("UIScale", { Scale = 0.5, Parent = f })
	Kit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if color == "Bad" then
		play("Error")
	end
	-- cap visible toasts
	local kids = {}
	for _, c in holder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 4 then
		table.sort(kids, function(a: any, b: any)
			return a.LayoutOrder < b.LayoutOrder
		end)
		kids[1]:Destroy()
	end
	task.delay(2.6, function()
		if f.Parent then
			Kit.Tween(f, 0.3, { BackgroundTransparency = 1 })
			Kit.Tween(l, 0.3, { TextTransparency = 1 })
			task.wait(0.3)
			f:Destroy()
		end
	end)
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Portrait</string>
              <string name="Source"><![CDATA[--!strict
-- Hunter portraits. Face(): cheap 2D portrait built from Frames (used in big grids).
-- Viewport(): real 3D model in a ViewportFrame (used for the index detail / inspect view).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local HunterRig = require(GH.Rigs.HunterRig)
local Kit = require(script.Parent.Kit)

local Portrait = {}

Portrait.ToolIcon = {
	Flashlight = "🔦",
	Vacuum = "🌀",
	Scanner = "📟",
	Blaster = "⚡",
	Cannon = "💥",
	Lantern = "🏮",
	Staff = "🪄",
	Projector = "📡",
} :: { [string]: string }

local function circle(parent: Instance, size: UDim2, pos: UDim2, color: Color3, z: number): Frame
	local f: Frame = Kit.new("Frame", {
		Size = size,
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
	Kit.Corner(f, UDim.new(1, 0))
	return f
end

-- Fills `parent` (a square frame) with a cartoon face. silhouette = undiscovered.
function Portrait.Face(parent: GuiObject, hunterId: string, silhouette: boolean?)
	local def = Config.Hunters[hunterId]
	if not def then
		return
	end
	local L = def.Look
	local z = parent.ZIndex + 1
	local dark = Color3.fromRGB(20, 12, 35)
	local function col(c: Color3): Color3
		return if silhouette then dark else c
	end
	local holder: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = z, Parent = parent })
	-- shoulders / shirt
	local body = circle(holder, UDim2.fromScale(0.78, 0.5), UDim2.fromScale(0.5, 1.02), col(L.Shirt), z)
	body.AnchorPoint = Vector2.new(0.5, 1)
	-- back item peeking out
	if L.Back == "Wings" or L.Back == "Cape" then
		local w = circle(holder, UDim2.fromScale(0.95, 0.45), UDim2.fromScale(0.5, 0.82), col(L.BackColor or L.Shirt), z - 0)
		w.ZIndex = z
		body.ZIndex = z + 1
	end
	-- head
	local head = circle(holder, UDim2.fromScale(0.64, 0.6), UDim2.fromScale(0.5, 0.46), col(L.Skin), z + 2)
	-- hair cap (top half)
	if L.HairStyle ~= "None" then
		local hair = circle(head, UDim2.fromScale(1.08, 0.62), UDim2.fromScale(0.5, 0.18), col(L.Hair), z + 3)
		if L.HairStyle == "Spiky" then
			for i = -1, 1 do
				local s = circle(head, UDim2.fromScale(0.3, 0.3), UDim2.fromScale(0.5 + i * 0.28, -0.05), col(L.Hair), z + 3)
				s.Rotation = 45
				local c = s:FindFirstChildOfClass("UICorner")
				if c then
					c.CornerRadius = UDim.new(0.15, 0)
				end
			end
		elseif L.HairStyle == "Puff" then
			circle(head, UDim2.fromScale(0.5, 0.45), UDim2.fromScale(0.2, 0.15), col(L.Hair), z + 3)
			circle(head, UDim2.fromScale(0.5, 0.45), UDim2.fromScale(0.8, 0.15), col(L.Hair), z + 3)
		elseif L.HairStyle == "Long" or L.HairStyle == "Bob" then
			circle(head, UDim2.fromScale(0.28, 0.75), UDim2.fromScale(0.02, 0.5), col(L.Hair), z + 1)
			circle(head, UDim2.fromScale(0.28, 0.75), UDim2.fromScale(0.98, 0.5), col(L.Hair), z + 1)
		end
		hair.ZIndex = z + 3
	end
	-- hat
	if L.Hat and L.Hat ~= "Goggles" and L.Hat ~= "Visor" then
		local hc = col(L.HatColor or L.Shirt)
		if L.Hat == "Halo" then
			local halo = circle(head, UDim2.fromScale(0.7, 0.18), UDim2.fromScale(0.5, -0.12), hc, z + 4)
			Kit.Stroke(halo, 2, if silhouette then dark else Color3.fromRGB(255, 255, 200))
		elseif L.Hat == "Mortarboard" then
			local top: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1.1, 0.14), Position = UDim2.fromScale(0.5, 0.0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = hc, ZIndex = z + 4, Parent = head })
			top.Rotation = -4
		elseif L.Hat == "Hood" then
			local hood = circle(holder, UDim2.fromScale(0.82, 0.74), UDim2.fromScale(0.5, 0.44), hc, z + 1)
			hood.ZIndex = z + 1
		else
			local cap = circle(head, UDim2.fromScale(1.0, 0.5), UDim2.fromScale(0.5, 0.08), hc, z + 4)
			if L.Hat == "Cap" or L.Hat == "Fedora" then
				local brim: Frame = Kit.new("Frame", { Size = UDim2.fromScale(if L.Hat == "Fedora" then 1.3 else 0.7, 0.1), Position = UDim2.fromScale(if L.Hat == "Fedora" then 0.5 else 0.7, 0.3), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = hc, ZIndex = z + 5, Parent = head })
				Kit.Corner(brim, UDim.new(1, 0))
			end
			cap.ZIndex = z + 4
		end
	end
	-- eyes
	if not silhouette then
		for _, x in { 0.33, 0.67 } do
			local e = circle(head, UDim2.fromScale(0.2, 0.24), UDim2.fromScale(x, 0.56), Color3.fromRGB(25, 20, 35), z + 5)
			circle(e, UDim2.fromScale(0.4, 0.4), UDim2.fromScale(0.65, 0.3), Color3.new(1, 1, 1), z + 6)
		end
		local mouth: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.22, 0.09), Position = UDim2.fromScale(0.5, 0.8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(150, 40, 60), ZIndex = z + 5, Parent = head })
		Kit.Corner(mouth, UDim.new(1, 0))
		-- blush
		for _, x in { 0.18, 0.82 } do
			local b = circle(head, UDim2.fromScale(0.14, 0.08), UDim2.fromScale(x, 0.74), Color3.fromRGB(255, 130, 150), z + 5)
			b.BackgroundTransparency = 0.4
		end
		if L.Hat == "Goggles" or L.Hat == "Visor" then
			local g: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = L.HatColor or Color3.new(0, 0, 0), BackgroundTransparency = 0.25, ZIndex = z + 7, Parent = head })
			Kit.Corner(g, UDim.new(0.5, 0))
		end
		-- tool badge
		Kit.Label(holder, Portrait.ToolIcon[L.Tool] or "👻", { Size = UDim2.fromScale(0.34, 0.34), Position = UDim2.fromScale(0.97, 0.97), AnchorPoint = Vector2.new(1, 1), ZIndex = z + 8, Stroke = 0 })
	else
		Kit.Label(holder, "?", { Size = UDim2.fromScale(0.4, 0.4), Position = UDim2.fromScale(0.5, 0.46), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 6, Color = Color3.fromRGB(160, 140, 210) })
	end
end

-- 3D portrait. Returns the ViewportFrame so callers can spin `model` if they want.
function Portrait.Viewport(parent: GuiObject, hunterId: string, silhouette: boolean?): (ViewportFrame, Model?)
	local vf: ViewportFrame = Kit.new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 190, 230),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
		ZIndex = parent.ZIndex + 1,
		Parent = parent,
	})
	if not Config.Hunters[hunterId] then
		return vf, nil
	end
	local model = HunterRig.BuildStatic(hunterId)
	if silhouette then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Color = Color3.fromRGB(15, 8, 30)
				p.Material = Enum.Material.SmoothPlastic
			elseif p:IsA("ParticleEmitter") or p:IsA("Light") then
				p:Destroy()
			end
		end
	end
	-- rigs face -Z and the camera sits on the -Z side: a slight turn gives a 3/4 view
	model:PivotTo(CFrame.Angles(0, math.rad(-22), 0))
	model.Parent = vf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local _, size = model:GetBoundingBox()
	local h = math.max(size.Y, 3.5)
	cam.CFrame = CFrame.lookAt(Vector3.new(0, h * 0.55, -h * 2.6), Vector3.new(0, h * 0.48, 0))
	cam.Parent = vf
	vf.CurrentCamera = cam
	return vf, model
end

return Portrait
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Colours, fonts and sizes for every UI element. Mobile-first: everything is designed for a
-- 620-pt-tall reference screen and scaled with one UIScale (see Kit.Screen).
local C = Color3.fromRGB
local Theme = {
	Bg = C(28, 16, 50),
	Panel = C(46, 28, 82),
	Panel2 = C(64, 40, 112),
	Panel3 = C(86, 56, 146),
	Outline = C(18, 8, 36),
	Text = C(255, 255, 255),
	Muted = C(205, 190, 240),
	Ecto = C(90, 255, 160),
	Ecto2 = C(40, 220, 210),
	Good = C(90, 230, 120),
	Bad = C(255, 85, 110),
	Gold = C(255, 200, 60),
	Buttons = {
		Green = { C(110, 240, 120), C(40, 185, 95) },
		Purple = { C(175, 110, 255), C(115, 60, 220) },
		Orange = { C(255, 180, 60), C(245, 110, 40) },
		Blue = { C(90, 200, 255), C(50, 120, 240) },
		Red = { C(255, 110, 120), C(215, 50, 80) },
		Gray = { C(150, 145, 170), C(105, 100, 130) },
		Pink = { C(255, 130, 220), C(220, 70, 170) },
	} :: { [string]: { Color3 } },
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,
	ReferenceHeight = 620,
}
return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
