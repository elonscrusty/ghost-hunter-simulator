		local stem = Color3.fromRGB(90, 150, 70)
		local cat = Color3.fromRGB(125, 80, 45)
		local tails = {
			{ Vector3.new(-0.55, 1.6, 0.25), Vector3.new(-1.0, 2.9, 0.35) },
			{ Vector3.new(0.1, 1.7, 0.15), Vector3.new(0.15, 3.25, 0.1) },
