		tpart(U.Block(Vector3.new(0.13, 0.19, 0.25), sf * CFrame.new(0, 0, 0.05), WHITE, model)) -- grip tape
		local bl = sf * CFrame.new(0.2, 0, -1.7) * CFrame.Angles(0.55, 0, 0)
