	floater(f, V(1.6, 2.2, 0.2), V(60, 9, 1362), C(205, 170, 120), "FloatingClipboard")
end

local function elevator(f: Instance, z: number)
	Kit.Box(f, V(-51, FLOOR_Y, z - 5), V(-50.2, 12, z + 5), C(180, 190, 205), { Mat = METAL, Solid = true })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(-50.2, FLOOR_Y, z + s * 0.1), V(-49.9, 10, z + s * 4), C(220, 225, 235), { Mat = METAL })
	end
	local disp = Kit.Box(f, V(-50.2, 10.4, z - 2), V(-49.9, 11.6, z + 2), DARK)
	Kit.Sign(disp, Enum.NormalId.Right, "▲ 13 ▼", C(255, 200, 90))
	Kit.AddRect(-52, z - 5, -48, z + 5)
end

local function atrium(f: Instance)
	elevator(f, 1362)
	elevator(f, 1386)
	Props.SignBoard(f, V(-50.4, 14, 1374), 18, 2.4, 1, 0, "ELEVATORS (GHOSTS ONLY)", C(60, 110, 170), WHITE)
	medCart(f, -20, 1380)
	medCart(f, 28, 1432)
	wheelchair(f, 20, 1368, -1, 0)
	wheelchair(f, -22, 1432, 0, 1)
	bench(f, 35, 1366, -1, 0)
	plant(f, 35, 1356)
	plant(f, -27, 1440)
	Props.SignBoard(f, V(39.4, 11, 1434), 14, 3.2, -1, 0, "QUIET PLEASE...\nBOO!", C(120, 80, 190), WHITE)
	sconce(f, V(38.4, 12, 1374), -1, C(255, 230, 170))
	-- overhead sign at the director's wing (Y 11..16, over the path, before the boss room)
	Kit.Box(f, V(-20, 14, 1443.5), V(20, 16, 1444.5), WHITE)
	local s = Kit.Part(f, V(24, 2.8, 0.4), CFrame.new(0, 12.4, 1443.3), C(60, 110, 170))
	Kit.Sign(s, Enum.NormalId.Front, "⬆ DIRECTOR'S OFFICE ⬆", WHITE)
	Props.Wisp(f, V(-10, 0, 1414), SPECT, 9, true)
	floater(f, V(1.6, 0.8, 0.8), V(4, 10, 1400), Kit.Vivid(C(255, 150, 200)), "FloatingPill", Enum.PartType.Cylinder)
end

local function lab(f: Instance)
	-- ecto tanks along the west wall
	for i, z in { 1415, 1455, 1492 } do
		Kit.Cyl(f, 1.5, 6, CFrame.new(-105, FLOOR_Y + 0.75, z), GREY, { Mat = METAL, Solid = true })
		Kit.Cyl(f, 8, 5, CFrame.new(-105, 5.9, z), C(200, 245, 225), { Transp = 0.55, Refl = 0.1 })
		local liquid = Kit.Cyl(f, 6, 4, CFrame.new(-105, 5, z), SPECT, { Mat = NEON, Transp = 0.3 })
		Kit.Cyl(f, 1, 5.6, CFrame.new(-105, 10.4, z), GREY, { Mat = METAL })
		if i == 2 then
			Kit.Light(liquid, SPECT, 24, 1.2)
			Kit.Emitter(liquid, SPECT, 2, 2, 0.6)
		end
		Kit.AddCircle(-105, z, 4)
	end
	-- lab bench with bubbling beakers
	Kit.Box(f, V(-66, 3.4, 1400), V(-40, 4, 1405.5), WHITE)
	Kit.Box(f, V(-65, FLOOR_Y, 1400.5), V(-41, 3.4, 1405), Kit.Vivid(MGREEN), { Solid = true })
	for i, col in { C(255, 150, 200), C(200, 140, 255), C(140, 230, 255) } do
		Kit.Cyl(f, 1.6, 1, CFrame.new(-60 + i * 5, 4.8, 1402.5), Kit.Vivid(col), { Transp = 0.2 })
	end
	Kit.AddRect(-67, 1399, -39, 1407)
	-- spirit coil "ghost-o-meter"
	local x, z = -60, 1515
	Kit.Cyl(f, 1, 6, CFrame.new(x, FLOOR_Y + 0.5, z), GREY, { Mat = METAL, Solid = true })
	Kit.Cyl(f, 10, 1.6, CFrame.new(x, 6, z), GREY, { Mat = METAL, Solid = true })
	for i, d in { 5, 4, 3 } do
		Kit.Cyl(f, 0.5, d, CFrame.new(x, 3 + i * 2.5, z), Kit.Vivid(PURPLE))
	end
	Kit.Ball(f, 2.2, V(x, 12, z), C(200, 150, 255), { Mat = NEON })
	Props.SignBoard(f, V(x, 3, z - 4), 7, 1.6, 0, -1, "GHOST-O-METER", DARK, SPECT)
	Kit.AddCircle(x, z, 5)
	Props.SignBoard(f, V(-100, 11, 1399.4), 14, 3, 0, 1, "PARANORMAL LAB", C(120, 80, 190), WHITE)
	puddle(f, -70, 1462, 6)
	floater(f, V(1, 1.8, 1), V(-45, 9, 1420), Kit.Vivid(C(200, 140, 255)), "FloatingBeaker", Enum.PartType.Cylinder)
end

local function office(f: Instance)
	-- director's desk (front-east corner, outside the boss circle)
	Kit.Box(f, V(16.5, FLOOR_Y, 1454.5), V(27.5, 3.6, 1461.5), C(140, 95, 65), { Mat = WOOD, Solid = true })
	Kit.Box(f, V(16, 3.6, 1454), V(28, 4.2, 1462), C(165, 115, 80), { Mat = WOOD })
	local plate = Kit.Part(f, V(4.5, 1, 0.4), faced(V(22, 4.7, 1454.5), 0, -1), DARK)
	Kit.Sign(plate, Enum.NormalId.Front, "DIRECTOR 👻", C(255, 215, 120))
	chair(f, 22, 1465, 0, -1, Kit.Vivid(PURPLE))
	Kit.AddRect(15, 1453, 29, 1467)
	-- boss ring painted on the carpet (flat)
	Kit.Disc(f, 0, 1505, 0.18, 46, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 0, 1505, 0.2, 42, 0.04, C(215, 195, 235))
	puddle(f, -6, 1500, 6)
	Props.SignBoard(f, V(-22, 10, 1532.6), 11, 6, 0, -1, "EMPLOYEE\nOF THE\nCENTURY 👻", C(120, 80, 190), C(255, 225, 130), C(255, 200, 80))
	plant(f, -27, 1449)
	plant(f, 27, 1530)
end

local function pharmacy(f: Instance)
	Kit.Box(f, V(50, FLOOR_Y, 1468), V(82, 4, 1471), WHITE, { Solid = true })
	Kit.Box(f, V(49.5, 4, 1467.5), V(82.5, 4.5, 1471.5), Kit.Vivid(MGREEN))
	Kit.AddRect(49, 1467, 83, 1472)
	local rows = { C(255, 150, 190), C(140, 220, 255), C(255, 210, 110) }
	for _, x in { 50, 70, 90 } do
		Kit.Box(f, V(x - 6, FLOOR_Y, 1529), V(x + 6, 10, 1533), WHITE, { Solid = true })
		for i, col in rows do
			local y = 1.2 + (i - 1) * 2.9
			Kit.Box(f, V(x - 5.6, y, 1528.7), V(x + 5.6, y + 1.8, 1529), Kit.Vivid(col))
		end
		Kit.AddRect(x - 7, 1527, x + 7, 1533)
	end
	Props.SignBoard(f, V(70, 13, 1532.6), 20, 3, 0, -1, "PHARMACY", C(60, 110, 170), WHITE)
	-- get-well balloons by the counter
	local top = V(80, 4.5, 1469.5)
	for i, col in { C(255, 140, 190), C(150, 205, 240), C(170, 120, 230) } do
		local p = top + V((i - 2) * 1.6, 7 + (i % 2) * 1.2, 0)
		Props.Beam(f, top, p - V(0, 1.3, 0), 0.1, 0.1, WHITE)
		Kit.Ball(f, 2.6, p, Kit.Vivid(col))
	end
	wheelchair(f, 100, 1480, -1, 0)
	Props.SignBoard(f, V(60, 11, 1445.4), 14, 3, 0, 1, "GET WELL BOO-N!", C(255, 140, 190), WHITE)
end

local function grounds(f: Instance)
	-- back yard
	bench(f, -42, 1546, 0, -1)
	bench(f, 42, 1546, 0, -1)
	-- trees in the garden strips and corners
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 10 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(60, 131)
		local z = rng:NextNumber(1226, 1555)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

function Hospital.Build(map: Instance)
	local f = Kit.Folder(map, "Hospital")
	ground(f)
	sideWalls(f)
	outside(f)
	courtyard(f)
	entrance(f)
	shell(f)
	tower(f)
	lobby(f)
	ward(f)
	patientRooms(f)
	xray(f)
	atrium(f)
	lab(f)
	office(f)
	pharmacy(f)
	grounds(f)
end

return Hospital
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Inferno</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 15: Inferno Caverns (Z 4840..5200). A cosy-hot volcanic cavern: dark basalt, warm glow.
--   Ground: basalt slab + slate lane along X = 0 with ember-orange edging.
--   Ghost areas get flat scorched rings ((0,4925) r30, (-82,4960) r24, (75,5020) r26,
--   (-62,5080) r24); the boss area (0,5145) r26 is an obsidian disc with ember runes.
--   Lava (flat neon, a few big pieces, all outside the lane and the ghost areas): a river at
--   Z 4988..4998 from the west wall to a pool at (36, 4993), crossed by a solid glass bridge on
--   the lane; pools in the front corners; cracks in the west back corner.
--   Rock arches over the lane at Z 4970 and Z 5100 (span bottom Y 32).
--   Landmark seen from the Clockwork Tower: the volcano at (98, 5152), crater ~Y 108.
--   Crystal clusters, obsidian spikes, cute fire-salamander statues, braziers, cliffs outside.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Inferno = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local BASALT = Enum.Material.Basalt
local SLATE = Enum.Material.Slate
local METAL = Enum.Material.Metal
local ROCK = Enum.Material.Rock

local Z0, Z1 = 4840, 5200
local RIVER_Z1, RIVER_Z2 = Z0 + 148, Z0 + 158

local GROUND = C(58, 48, 52)
local ROCKC = C(78, 60, 58)
local ROCK_D = C(48, 40, 44)
local ROCK_R = C(105, 55, 45)
local LAVA = C(255, 120, 35)
local LAVA_Y = C(255, 175, 60)
local EMBER = C(255, 150, 60)
local GOLD = C(255, 200, 80)
local DEEP_RED = C(150, 45, 40)
local OBSIDIAN = C(35, 28, 45)
local SAL = C(255, 110, 60)
local SAL_SPOT = C(255, 215, 80)

local SOLID_ROCK: Kit.Opts = { Mat = BASALT, Solid = true, Shadow = true }
local LAVA_O: Kit.Opts = { Mat = NEON }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
local function crack(parent: Instance, p: Vector3, segs: number, w: number)
	local rng = Kit.Rng
	local a = rng:NextNumber(0, math.pi * 2)
	for _ = 1, segs do
		a += rng:NextNumber(-0.8, 0.8)
		local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(4, 7)
		Props.Beam(parent, p, q, w, 0.06, LAVA, LAVA_O)
		p = q
	end
end

-- Flat lava pool: dark rim discs under glowing discs (tops below Y 0.1).
local function pool(parent: Instance, pieces: { { number } }, light: boolean)
	for i, d in pieces do
		Kit.Disc(parent, d[1], d[2], 0.04, d[3] + 5, 0.04, ROCK_D, { Mat = SLATE })
		local p = Kit.Disc(parent, d[1], d[2], 0.06 + i * 0.005, d[3], 0.05, if i == 1 then LAVA else LAVA_Y, LAVA_O)
		if light and i == 1 then
			Kit.Light(p, EMBER, 40, 1.8)
		end
	end
end

local function crystals(parent: Instance, x: number, z: number, color: Color3, glow: boolean, light: boolean)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "Crystals")
	for i = 1, 4 do
		local h = rng:NextNumber(4, 9) * (if i == 1 then 1.3 else 1)
		local w = rng:NextNumber(1.4, 2.4)
		local p = V(x + rng:NextNumber(-2, 2), h / 2 - 0.5, z + rng:NextNumber(-2, 2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 1.5), rng:NextNumber(-0.35, 0.35)) * CFrame.Angles(0, math.pi / 4, 0)
		local opts: Kit.Opts = if glow and i == 1 then { Mat = NEON } else { Refl = 0.25, Transp = 0.1 }
		local c = Kit.Part(m, V(w, h, w), cf, if i % 2 == 0 then Kit.Vivid(color) else color:Lerp(Color3.new(1, 1, 1), 0.2), opts)
		if light and i == 1 then
			Kit.Light(c, color, 26, 1.4)
		end
	end
	Kit.Ball(m, 4, V(x, -0.8, z), ROCK_D, { Mat = BASALT })
	Kit.AddCircle(x, z, 4)
end

local function spikes(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "ObsidianSpikes")
	for i = 1, 3 do
		local h = rng:NextNumber(8, 18) * (if i == 1 then 1.2 else 0.8)
		local w = rng:NextNumber(2.4, 3.6)
		local p = V(x + rng:NextNumber(-2.5, 2.5), h / 2 - 1, z + rng:NextNumber(-2.5, 2.5))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 1.5), rng:NextNumber(-0.25, 0.25))
		Kit.Part(m, V(w, h, w * 0.7), cf, OBSIDIAN, { Refl = 0.3, Solid = i == 1, Shadow = true })
		Kit.Wedge(m, V(w, w * 1.2, w * 0.7), cf * CFrame.new(0, h / 2 + w * 0.6, 0) * CFrame.Angles(0, math.pi / 2, 0), OBSIDIAN, { Refl = 0.3 })
	end
	Kit.AddCircle(x, z, 4.5)
end

-- Cute fire salamander statue facing (fx, fz); s = scale.
local function salamander(parent: Instance, x: number, z: number, s: number, fx: number, fz: number)
	local m = Kit.Model(parent, "SalamanderStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local ph = 2.5 * math.min(s, 1.6)
	local body = Kit.Vivid(SAL)
	Kit.Part(m, V(6 * s, ph, 9 * s), base * CFrame.new(0, ph / 2, 0.8 * s), ROCK_R, { Mat = SLATE, Solid = true, Shadow = true })
	Kit.Part(m, V(6.4 * s, 0.5, 9.4 * s), base * CFrame.new(0, ph, 0.8 * s), Kit.Vivid(GOLD), { Mat = METAL })
	local y = ph + 0.25
	Kit.Ball(m, 3.6 * s, (base * CFrame.new(0, y + 1.6 * s, 0.4 * s)).Position, body, { Shadow = true })
	Kit.Ball(m, 3.2 * s, (base * CFrame.new(0, y + 1.5 * s, 2.6 * s)).Position, body)
	Kit.Ball(m, 3.8 * s, (base * CFrame.new(0, y + 2.8 * s, -2 * s)).Position, body, { Shadow = true })
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 1.4 * s, (base * CFrame.new(sx * 0.85 * s, y + 3.7 * s, -3.4 * s)).Position, C(255, 255, 250))
		Kit.Ball(m, 0.75 * s, (base * CFrame.new(sx * 0.85 * s, y + 3.75 * s, -3.95 * s)).Position, C(30, 20, 30))
		Kit.Ball(m, 0.8 * s, (base * CFrame.new(sx * 1.4 * s, y + 2.6 * s, -3.4 * s)).Position, C(255, 150, 170))
		for _, lz in { -0.6, 2.8 } do
			Kit.Part(m, V(1 * s, 1.4 * s, 1 * s), base * CFrame.new(sx * 1.5 * s, y + 0.7 * s, lz * s), body)
		end
	end
	-- curly tail with an ember tip
	local t0 = (base * CFrame.new(0, y + 1.3 * s, 4 * s)).Position
	local t1 = (base * CFrame.new(1.6 * s, y + 0.8 * s, 6.4 * s)).Position
	Props.Beam(m, t0, t1, 1.3 * s, 1.3 * s, body)
	Kit.Ball(m, 1.6 * s, t1 + V(0, 0.5 * s, 0), LAVA_Y, if s > 1.5 then LAVA_O else nil)
	for i = 0, 2 do
		Kit.Ball(m, 0.9 * s, (base * CFrame.new((i - 1) * 0.7 * s, y + 3.3 * s, (0.2 + i * 1.1) * s)).Position, Kit.Vivid(SAL_SPOT))
	end
	Kit.AddCircle(x, z, 5.5 * s)
end

local function brazier(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "Brazier")
	Kit.Cyl(m, 4, 2.4, CFrame.new(x, 2, z), ROCKC, SOLID_ROCK)
	Kit.Cyl(m, 1.6, 4.4, CFrame.new(x, 4.8, z), C(60, 50, 55), { Mat = METAL })
	Kit.Cyl(m, 0.4, 4.6, CFrame.new(x, 5.4, z), Kit.Vivid(GOLD), { Mat = METAL })
	local flame = Kit.Ball(m, 2.6, V(x, 6, z), EMBER, { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(flame, EMBER, 26, 1.6, true)
	end
	Kit.AddCircle(x, z, 3)
end

--==================================================================
-- GROUND, LAVA, WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), GROUND, { Mat = BASALT, Solid = true, Name = "Ground_Inferno" })
	-- slate lane with ember edging, interrupted by the glass bridge over the lava river
	local edge = Kit.Vivid(C(220, 120, 60))
	for _, seg in { { Z0, RIVER_Z1 - 2 }, { RIVER_Z2 + 2, Z1 } } do
		Kit.Box(f, V(-9, 0, seg[1]), V(9, 0.05, seg[2]), C(105, 80, 72), { Mat = SLATE, Solid = true, Name = "Path" })
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 9, 0, seg[1]), V(s * 10, 0.08, seg[2]), edge, { Mat = SLATE })
		end
	end
	-- scorched rings on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, if i % 2 == 0 then DEEP_RED else ROCK_R, { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, C(82, 66, 66), { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.13, 8, 0.13, Kit.Vivid(GOLD), { Mat = METAL })
		crack(f, V(a[1] + 9, 0.15, a[2] - 6), 1, 0.5)
	end
	-- boss: obsidian disc, gold ring, ember runes
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, OBSIDIAN, { Mat = SLATE, Refl = 0.15 })
	for i = 0, 3 do
		local a1 = i * math.pi / 2 + 0.2
		local a2 = a1 + math.pi / 2 - 0.4
		Props.Beam(f, V(math.cos(a1) * 20, 0.14, BOSS_Z + math.sin(a1) * 20), V(math.cos(a2) * 20, 0.14, BOSS_Z + math.sin(a2) * 20), 0.7, 0.05, LAVA, LAVA_O)
	end
	Kit.Disc(f, 0, BOSS_Z, 0.17, 6, 0.06, EMBER, LAVA_O)
end

local function lava(f: Instance)
	local m = Kit.Model(f, "Lava")
	-- river from the west wall to a pool east of the lane
	local river = Kit.Box(m, V(-136, 0, RIVER_Z1), V(30, 0.06, RIVER_Z2), LAVA, { Mat = NEON, Name = "LavaRiver" })
	Kit.Light(river, EMBER, 30, 1.2) -- centre of the river (by the glass bridge)
	for _, zz in { RIVER_Z1 - 1.2, RIVER_Z2 } do
		Kit.Box(m, V(-136, 0, zz), V(-12.5, 0.12, zz + 1.2), ROCK_D, { Mat = BASALT })
		Kit.Box(m, V(12.5, 0, zz), V(30, 0.12, zz + 1.2), ROCK_D, { Mat = BASALT })
	end
	pool(m, { { 36, (RIVER_Z1 + RIVER_Z2) / 2, 18 } }, false)
	-- glass bridge on the lane (solid, top Y 0.25)
	Kit.Box(m, V(-12, 0, RIVER_Z1 - 2), V(12, 0.25, RIVER_Z2 + 2), C(255, 200, 160), { Mat = Enum.Material.Glass, Transp = 0.45, Refl = 0.1, Solid = true, Name = "GlassBridge" })
	local gold = Kit.Vivid(GOLD)
	for _, s in { -1, 1 } do
		for _, zz in { RIVER_Z1 - 2, RIVER_Z2 + 2 } do
			Kit.Box(m, V(s * 12.6 - 0.4, 0, zz - 0.4), V(s * 12.6 + 0.4, 2.6, zz + 0.4), gold, { Mat = METAL })
			Kit.Ball(m, 1.2, V(s * 12.6, 3, zz), gold, { Mat = METAL })
		end
		Kit.Box(m, V(s * 12.6 - 0.2, 2, RIVER_Z1 - 2), V(s * 12.6 + 0.2, 2.4, RIVER_Z2 + 2), gold, { Mat = METAL })
	end
	-- corner pools
	pool(m, { { -102, Z0 + 52, 34 }, { -122, Z0 + 70, 20 }, { -80, Z0 + 44, 14 } }, true)
	local embers = Kit.Part(m, V(24, 0.4, 24), CFrame.new(-104, 1, Z0 + 56), EMBER, { Transp = 1, Name = "EmberSource" })
	local e = Kit.Emitter(embers, C(255, 170, 70), 3, 0.8, 2)
	if e then
		e.LightEmission = 1
		e.Acceleration = V(0, 3, 0)
	end
	pool(m, { { 112, Z0 + 58, 30 }, { 126, Z0 + 84, 16 } }, true)
	-- cracks in the west back corner
	crack(m, V(-112, 0.1, Z0 + 330), 3, 2.2)
	Props.SignBoard(m, V(-70, 4, Z0 + 76), 10, 3, 1, -1, "HOT! DO NOT LICK", C(60, 30, 30), Kit.Vivid(LAVA_Y), GOLD)
	Kit.Box(m, V(-70.4, 0, Z0 + 76.4), V(-69.6, 2.5, Z0 + 77.2), ROCKC, { Mat = BASALT })
	Kit.AddCircle(-70, Z0 + 76, 6)
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 34, z1), ROCKC, SOLID_ROCK)
		Kit.Box(f, V(s * 139.7, 0, z0), V(s * 140, 3, z1), ROCK_R, { Mat = SLATE })
		for z = z0 + 10, z1 - 10, 32 do
			local w = rng:NextNumber(8, 14)
			local cf = CFrame.new(s * 143, 34 + rng:NextNumber(1, 4), z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 1), rng:NextNumber(-0.3, 0.3))
			Kit.Part(f, V(w, rng:NextNumber(6, 12), w), cf, Kit.Pick({ ROCKC, ROCK_D, ROCK_R }), { Mat = BASALT })
		end
		-- glowing magma veins on the inner face
		local x = s * 139.75
		local zv = if s < 0 then Z0 + 210 else Z0 + 120
		Props.Beam(f, V(x, 1, zv), V(x, 12, zv + 6), 0.6, 0.6, LAVA, LAVA_O)
		Props.Beam(f, V(x, 12, zv + 6), V(x, 22, zv + 1), 0.5, 0.5, LAVA, LAVA_O)
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local cols = { ROCKC, ROCK_D, C(70, 50, 50) }
	for _, s in { -1, 1 } do
		for i = 0, 7 do
			local z = Z0 + 14 + i * 46
			local w = rng:NextNumber(26, 44)
			local h = rng:NextNumber(46, 74)
			local cf = CFrame.new(s * (149 + w / 2), h / 2 - 3, z) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), s * rng:NextNumber(0.02, 0.1))
			Kit.Part(f, V(w, h, rng:NextNumber(38, 52)), cf, Kit.Pick(cols), { Mat = ROCK })
			if i % 2 == 0 then
				Kit.Ball(f, rng:NextNumber(40, 60), V(s * rng:NextNumber(185, 205), rng:NextNumber(4, 18), z + 20), Kit.Pick(cols), { Mat = BASALT })
			end
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function rockArch(f: Instance, z: number, title: string?)
	local m = Kit.Model(f, "RockArch")
	local rng = Kit.Rng
	for _, s in { -1, 1 } do
		local y = 0
		for i = 1, 3 do
			local h = if i == 3 then 36 - y else rng:NextNumber(10, 14)
			local w = 10 - i * 0.8
			local cf = CFrame.new(s * 23, y + h / 2, z) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0)
			Kit.Part(m, V(w, h, 8 - i * 0.6), cf, if i % 2 == 0 then ROCK_D else ROCKC, SOLID_ROCK)
			y += h
		end
		local c = Kit.Part(m, V(1.6, 4, 1.6), CFrame.new(s * 18.6, 14, z - 3) * CFrame.Angles(0.3, 0.6, s * 0.4), Kit.Vivid(C(255, 120, 200)), if s < 0 then LAVA_O else { Refl = 0.25 })
		c.Name = "ArchCrystal"
		Kit.AddRect(s * 17, z - 5, s * 29, z + 5)
	end
	-- span (bottom Y 32) and rough top boulders
	Kit.Box(m, V(-28, 32, z - 4), V(28, 40, z + 4), ROCKC, SOLID_ROCK)
	Kit.Part(m, V(20, 8, 9), CFrame.new(-10, 42, z) * CFrame.Angles(0, 0.1, 0.12), ROCK_D, { Mat = BASALT })
	Kit.Part(m, V(18, 7, 8), CFrame.new(12, 42, z) * CFrame.Angles(0, -0.12, -0.1), ROCK_R, { Mat = BASALT })
	if title then
		Props.SignBoard(m, V(0, 35.8, z - 4.4), 30, 4, 0, -1, title, C(50, 25, 25), Kit.Vivid(LAVA_Y), GOLD)
	end
end

local function volcano(f: Instance)
	local m = Kit.Model(f, "Volcano")
	local x, z = 98, Z0 + 312
	local ds = { 76, 64, 52, 42, 32, 24 }
	local H = 18
	for i, d in ds do
		local t = (i - 1) / (#ds - 1)
		Kit.Cyl(m, H, d, CFrame.new(x, H * (i - 0.5), z), ROCK_D:Lerp(ROCK_R, t * 0.8), { Mat = BASALT, Solid = i <= 2, Shadow = true })
	end
	local top = H * #ds
	local crater = Kit.Disc(m, x, z, top + 0.15, 16, 0.3, LAVA, LAVA_O)
	Kit.Light(crater, EMBER, 60, 2)
	for i = 0, 2 do
		local a = i * 2.1 + 0.4
		Kit.Part(m, V(7, 5, 6), CFrame.new(x + math.cos(a) * 10, top + 1.5, z + math.sin(a) * 10) * CFrame.Angles(0.2, a, -0.15), ROCK_D, { Mat = BASALT })
	end
	-- two lava streams down the tiers (toward the lane and toward the approach)
	for _, ang in { math.pi, -math.pi / 2 - 0.35 } do
		local dir = V(math.cos(ang), 0, math.sin(ang))
		local function pt(r: number, y: number): Vector3
			return V(x, y, z) + dir * r
		end
		local pts = { pt(12.6, top), pt(21.6, H * 4), pt(32.6, H * 2), pt(38.6, H), pt(39.6, 0.2) }
		for i = 1, #pts - 1 do
			Props.Beam(m, pts[i], pts[i + 1], 3, 1, if i % 2 == 0 then LAVA_Y else LAVA, LAVA_O)
		end
	end
	local smoke = Kit.Part(m, V(12, 1, 12), CFrame.new(x, top + 3, z), C(90, 80, 80), { Transp = 1, Name = "SmokeSource" })
	local e = Kit.Emitter(smoke, C(110, 95, 95), 2, 14, 4)
	if e then
		e.Acceleration = V(0, 3, 0)
	end
	Kit.AddCircle(x, z, 40)
end

local function floaters(f: Instance)
	for _, p in { V(-36, 24, Z0 + 150), V(40, 28, Z0 + 110), V(-112, 26, Z0 + 180), V(118, 30, Z0 + 230), V(-30, 22, Z0 + 340) } do
		local r = Kit.Ball(f, Kit.Rng:NextNumber(2.4, 3.6), p, Kit.Vivid(C(200, 90, 50)), { Mat = BASALT, Name = "FloatingEmberRock" })
		Kit.Float(r, 1.6)
	end
end

local function decor(f: Instance)
	local rng = Kit.Rng
	-- salamander statues welcoming hunters and one big one in the back corner
	for _, p in { { -18, Z0 + 52 }, { 18, Z0 + 52 }, { 20, Z0 + 205 }, { -20, Z0 + 200 }, { -40, Z0 + 330 } } do
		if Kit.IsFree(p[1], p[2], 5.5) then
			salamander(f, p[1], p[2], 1, if p[1] < 0 then 1 else -1, 0)
		end
	end
	if Kit.IsFree(-100, Z0 + 322, 12) then
		salamander(f, -100, Z0 + 322, 2.2, 1, -1)
	end
	for i, p in { { -14, Z0 + 232 }, { 14, Z0 + 232 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			brazier(f, p[1], p[2], i == 1)
		end
	end
	-- basalt column clusters (hexagonal causeway look) and rock buttresses on the walls
	for _, p in { { -118, Z0 + 120 }, { 120, Z0 + 140 }, { -40, Z0 + 290 }, { 124, Z0 + 250 }, { -126, Z0 + 230 } } do
		if Kit.IsFree(p[1], p[2], 7) then
			for i = 0, 5 do
				local a = i * math.pi / 3
				local r = if i == 0 then 0 else 3.6
				local h = rng:NextNumber(3, 12) + (if i == 0 then 6 else 0)
				local cx, cz = p[1] + math.cos(a) * r, p[2] + math.sin(a) * r
				Kit.Cyl(f, h, 3.8, CFrame.new(cx, h / 2, cz), Kit.Pick({ ROCKC, ROCK_D, C(68, 56, 60) }), { Mat = BASALT, Solid = i == 0, Shadow = true })
			end
			Kit.AddCircle(p[1], p[2], 7)
		end
	end
	for _, s in { -1, 1 } do
		for z = Z0 + 30, Z1 - 30, 50 do
			if Kit.IsFree(s * 134, z, 2) then
				local w = rng:NextNumber(5, 8)
				Kit.Part(f, V(w, rng:NextNumber(30, 40), w * 1.4), CFrame.new(s * (140 - w / 2 + 1), 15, z) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), s * 0.06), Kit.Pick({ ROCKC, ROCK_D }), SOLID_ROCK)
			end
		end
	end
	-- stalagmites
	local nst = 0
	for _ = 1, 300 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 10)
		if nst < 12 and Kit.IsFree(x, z, 3.5) then
			nst += 1
			local h = rng:NextNumber(6, 14)
			local col = Kit.Pick({ ROCKC, ROCK_R, C(92, 70, 64) })
			Kit.Cyl(f, h * 0.45, 4.4, CFrame.new(x, h * 0.225, z), col, { Mat = BASALT, Solid = true, Shadow = true })
			Kit.Cyl(f, h * 0.35, 3, CFrame.new(x, h * 0.45 + h * 0.175, z), col, { Mat = BASALT })
			Kit.Cyl(f, h * 0.25, 1.6, CFrame.new(x, h * 0.8 + h * 0.125, z), col:Lerp(Color3.new(1, 0.6, 0.3), 0.15), { Mat = BASALT })
			if nst % 3 == 0 then
				local x2, z2 = x + 3, z + 2
				Kit.Cyl(f, h * 0.5, 2.4, CFrame.new(x2, h * 0.25, z2), col, { Mat = BASALT })
			end
			Kit.AddCircle(x, z, 3.5)
		end
	end
	-- crystals and obsidian spikes
	local cols = { C(255, 90, 170), C(255, 170, 60), C(255, 220, 100), C(200, 100, 255) }
	local nc, ns, nb = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 10)
		if nc < 10 and Kit.IsFree(x, z, 4) then
			nc += 1
			crystals(f, x, z, cols[(nc - 1) % #cols + 1], nc <= 3, nc == 1)
		elseif ns < 11 and Kit.IsFree(x, z, 4.5) then
			ns += 1
			spikes(f, x, z)
		elseif nb < 10 and Kit.IsFree(x, z, 3.5) then
			nb += 1
			Kit.Ball(f, rng:NextNumber(4, 7), V(x, -0.6, z), Kit.Pick({ ROCKC, ROCK_D, ROCK_R }), { Mat = BASALT, Solid = true })
			Kit.AddCircle(x, z, 3.5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Inferno.Build(map: Instance)
	local f = Kit.Folder(map, "Inferno")
	ground(f)
	lava(f)
	sideWalls(f)
	outside(f)
	rockArch(f, Z0 + 130, "INFERNO CAVERNS")
	rockArch(f, Z0 + 260, nil)
	volcano(f)
	floaters(f)
	decor(f)
end

return Inferno
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Part helpers for the procedural map. Every builder goes through these so that parts
-- get the same performance defaults (anchored, non-colliding, no touch/query, no shadow)
-- unless `Solid = true` is passed for floors, walls and buildings.
-- Also holds the seeded RNG, budgets (lights, emitters, tagged props) and a keep-out
-- registry so scattered props never land inside ghost areas, roads or stations.
--
-- Neon is an accent, not a surface: keep it for small things whose glow means something
-- (windows, lamp globes, lanterns, jack-o'-lantern faces at landmarks, eyes, small ectoplasm
-- cracks/puddles). Trims, bands, rings, frames and pads use a solid material with a
-- Kit.Vivid colour instead. Kit.Stats.Neon counts the Neon parts so the build log shows it.

local CollectionService = game:GetService("CollectionService")
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)

local Kit = {}

export type Opts = {
	Name: string?,
	Mat: Enum.Material?,
	Transp: number?,
	Solid: boolean?, -- CanCollide + CanQuery (+ shadow)
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Refl: number?,
}

Kit.Rng = Random.new(42)

Kit.Stats = { Parts = 0, Neon = 0, Lights = 0, Emitters = 0, Floating = 0, Flicker = 0 }
-- Budgets for the whole 16-zone map (per zone ~9 lights, 2-3 emitters, 6-8 floating, 2 flicker).
local MAX_LIGHTS = 170
local MAX_EMITTERS = 54
local MAX_FLOATING = 140
local MAX_FLICKER = 34

local NO_OPTS: Opts = {}

local function apply(p: BasePart, size: Vector3, cf: CFrame, color: Color3, opts: Opts?)
	local o: Opts = opts or NO_OPTS
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.Mat or Enum.Material.SmoothPlastic
	p.Transparency = o.Transp or 0
	p.Reflectance = o.Refl or 0
	local solid = o.Solid == true
	p.CanCollide = solid
	p.CanQuery = solid
	p.CanTouch = false
	if o.Shadow ~= nil then
		p.CastShadow = o.Shadow
	else
		p.CastShadow = solid
	end
	if o.Name then
		p.Name = o.Name
	end
	Kit.Stats.Parts += 1
	if p.Material == Enum.Material.Neon then
		Kit.Stats.Neon += 1
	end
end

-- A slightly more saturated, brighter version of a colour. Solid materials are lit by the
-- scene instead of glowing, so former neon trims get this to stay candy-bright.
-- Near-greys/whites keep their saturation (no accidental tint).
function Kit.Vivid(c: Color3): Color3
	local h, s, v = c:ToHSV()
	local s2 = if s < 0.1 then s else math.min(1, s * 1.15 + 0.05)
	return Color3.fromHSV(h, s2, math.min(1, v * 1.06 + 0.03))
end

-- Block (or Ball/Cylinder via opts.Shape) at an arbitrary CFrame.
function Kit.Part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	apply(p, size, cf, color, opts)
	p.Parent = parent
	return p
end

-- Axis-aligned block from two corners.
function Kit.Box(parent: Instance, a: Vector3, b: Vector3, color: Color3, opts: Opts?): Part
	local lo = a:Min(b)
	local hi = a:Max(b)
	return Kit.Part(parent, hi - lo, CFrame.new((lo + hi) / 2), color, opts)
end

-- WedgePart: the slope faces local -Z (low edge at -Z, tall face at +Z).
function Kit.Wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): WedgePart
	local w: WedgePart = Instance.new("WedgePart")
	apply(w, size, cf, color, opts)
	w.Parent = parent
	return w
end

function Kit.Ball(parent: Instance, d: number, pos: Vector3, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	apply(p, Vector3.new(d, d, d), CFrame.new(pos), color, opts)
	p.Parent = parent
	return p
end

-- Vertical cylinder centred at cf.
function Kit.Cyl(parent: Instance, height: number, d: number, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	apply(p, Vector3.new(height, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, opts)
	p.Parent = parent
	return p
end

-- Flat vertical cylinder whose TOP surface is at topY.
function Kit.Disc(parent: Instance, x: number, z: number, topY: number, d: number, thick: number, color: Color3, opts: Opts?): Part
	return Kit.Cyl(parent, thick, d, CFrame.new(x, topY - thick / 2, z), color, opts)
end

-- Cylinder lying along the world axis given by `along` ("X" or "Z").
function Kit.CylFlat(parent: Instance, length: number, d: number, pos: Vector3, along: string, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	local cf = CFrame.new(pos)
	if along == "Z" then
		cf *= CFrame.Angles(0, math.pi / 2, 0)
	end
	apply(p, Vector3.new(length, d, d), cf, color, opts)
	p.Parent = parent
	return p
end

function Kit.Folder(parent: Instance, name: string): Folder
	local f: Folder = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.Model(parent: Instance, name: string): Model
	local m: Model = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Yaw (radians) that turns a part's local -Z (its Front face) toward world (dx, dz).
function Kit.FaceYaw(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

function Kit.Comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	while true do
		local replaced, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if k == 0 then
			break
		end
	end
	return out
end

--==================================================================
-- GUI
--==================================================================
function Kit.Gui(part: BasePart, face: Enum.NormalId, pps: number?): SurfaceGui
	local g: SurfaceGui = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	-- 30 px per stud: sharp up close, and far less shimmer when a sign is seen from a distance
	-- or while the camera moves (a 40 px texture squeezed into a few screen pixels sparkles,
	-- most on phones). Brightness just above 1 keeps the colours bright without the text
	-- glowing into the bloom.
	g.PixelsPerStud = pps or 30
	-- big signs (gate arches, the throne hall banner): a 30 px/stud canvas on a 40-64 stud face
	-- is a 0.4-0.5 Mpx texture each. 16 px/stud is still sharp at the distance they're read from,
	-- and past 250 studs they aren't drawn at all (TextFit sizes text from this canvas).
	local s = part.Size
	local wide = if face == Enum.NormalId.Left or face == Enum.NormalId.Right then s.Z else s.X
	if wide > 30 then
		g.PixelsPerStud = math.min(g.PixelsPerStud, 16)
		g.MaxDistance = 250
	end
	g.LightInfluence = 0
	g.Brightness = 1.1
	g.ZOffset = 1
	g.ResetOnSpawn = false
	g.Parent = part
	return g
end

export type LabelOpts = {
	Name: string?,
	Pos: UDim2?,
	Size: UDim2?,
	Font: Enum.Font?,
	Stroke: Color3?,
	Rotation: number?,
}

local NO_LABEL: LabelOpts = {}

function Kit.Label(gui: GuiBase2d, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local o: LabelOpts = opts or NO_LABEL
	local t: TextLabel = Instance.new("TextLabel")
	t.Name = o.Name or "Label"
	t.BackgroundTransparency = 1
	t.Position = o.Pos or UDim2.fromScale(0, 0)
	t.Size = o.Size or UDim2.fromScale(1, 1)
	t.Font = o.Font or Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Rotation = o.Rotation or 0
	local stroke: UIStroke = Instance.new("UIStroke")
	stroke.Color = o.Stroke or Color3.fromRGB(40, 20, 70)
	stroke.Thickness = 3
	stroke.Parent = t
	t.Parent = gui
	return t
end

-- Whole-face sign on a part.
function Kit.Sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local g = Kit.Gui(part, face)
	return Kit.Label(g, text, color, opts)
end

-- Square image at x (scale) inside a SurfaceGui / frame, `h` (scale) tall, `wFrac` (scale) wide.
local function iconImage(parent: Instance, image: string, x: number, y: number, wFrac: number, h: number): ImageLabel
	local img = Instance.new("ImageLabel")
	img.Name = "SignIcon"
	img.BackgroundTransparency = 1
	img.Image = image
	img.ScaleType = Enum.ScaleType.Fit
	img.Position = UDim2.fromScale(x, y)
	img.Size = UDim2.fromScale(wFrac, h)
	img.Parent = parent
	return img
end

-- Whole-face sign with the uploaded icon `iconKey` (shared Icons.luau) at both ends and the text
-- between them. Without an image id it is a plain Kit.Sign (no emoji is drawn).
function Kit.IconSign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, iconKey: string?, opts: LabelOpts?): TextLabel
	local g = Kit.Gui(part, face)
	local image = Icons.Get(iconKey)
	if not image then
		return Kit.Label(g, text, color, opts)
	end
	local s = part.Size
	local wide = if face == Enum.NormalId.Left or face == Enum.NormalId.Right then s.Z else s.X
	local tall = if face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then s.Z else s.Y
	local h = 0.8
	local f = math.min(0.22, tall * h / math.max(wide, 0.1)) -- square icon, as a width fraction
	local margin = 0.02
	iconImage(g, image, margin, (1 - h) / 2, f, h)
	iconImage(g, image, 1 - margin - f, (1 - h) / 2, f, h)
	local o: LabelOpts = table.clone(opts or NO_LABEL)
	local inner = margin + f + 0.01
	o.Pos = UDim2.fromScale(inner, 0)
	o.Size = UDim2.fromScale(1 - 2 * inner, 1)
	return Kit.Label(g, text, color, o)
end

Kit.IconImage = iconImage

--==================================================================
-- EFFECTS (budgeted)
--==================================================================
function Kit.Light(part: BasePart, color: Color3, range: number, brightness: number, flicker: boolean?): PointLight?
	if Kit.Stats.Lights >= MAX_LIGHTS then
		return nil
	end
	Kit.Stats.Lights += 1
	local l: PointLight = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
	if flicker and Kit.Stats.Flicker < MAX_FLICKER then
		Kit.Stats.Flicker += 1
		CollectionService:AddTag(part, "FlickerLight")
	end
	return l
end

function Kit.Emitter(part: BasePart, color: Color3, rate: number, size: number?, speed: number?): ParticleEmitter?
	if Kit.Stats.Emitters >= MAX_EMITTERS then
		return nil
	end
	Kit.Stats.Emitters += 1
	local e: ParticleEmitter = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(4, 7)
	e.Speed = NumberRange.new(speed or 0.6, (speed or 0.6) * 2)
	e.SpreadAngle = Vector2.new(180, 15)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-15, 15)
	local s = size or 6
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s * 0.5),
		NumberSequenceKeypoint.new(0.5, s),
		NumberSequenceKeypoint.new(1, s * 1.2),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.75),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Acceleration = Vector3.new(0, 0.15, 0)
	e.Parent = part
	return e
end

-- Tag a single anchored part as a client-animated floating prop.
function Kit.Float(part: BasePart, bob: number): boolean
	if Kit.Stats.Floating >= MAX_FLOATING then
		return false
	end
	Kit.Stats.Floating += 1
	part:SetAttribute("BobHeight", bob)
	CollectionService:AddTag(part, "FloatingProp")
	return true
end

--==================================================================
-- KEEP-OUT REGISTRY (2D, X/Z)
--==================================================================
type Circle = { X: number, Z: number, R: number }
type Rect = { X1: number, Z1: number, X2: number, Z2: number, Road: boolean }

local circles: { Circle } = {}
local rects: { Rect } = {}

function Kit.ResetKeepOut()
	table.clear(circles)
	table.clear(rects)
end

-- Fresh RNG, budgets and keep-out map (so rebuilding gives the identical map).
function Kit.Reset()
	Kit.Rng = Random.new(42)
	Kit.Stats.Parts = 0
	Kit.Stats.Neon = 0
	Kit.Stats.Lights = 0
	Kit.Stats.Emitters = 0
	Kit.Stats.Floating = 0
	Kit.Stats.Flicker = 0
	Kit.ResetKeepOut()
end

function Kit.AddCircle(x: number, z: number, r: number)
	table.insert(circles, { X = x, Z = z, R = r })
end

function Kit.AddRect(x1: number, z1: number, x2: number, z2: number, road: boolean?)
	table.insert(rects, {
		X1 = math.min(x1, x2),
		Z1 = math.min(z1, z2),
		X2 = math.max(x1, x2),
		Z2 = math.max(z1, z2),
		Road = road == true,
	})
end

-- True when a circle of radius r at (x, z) touches no keep-out and stays inside the play area.
function Kit.IsFree(x: number, z: number, r: number, ignoreRoads: boolean?): boolean
	if math.abs(x) + r > 136 then
		return false
	end
	for _, c in circles do
		local dx, dz = x - c.X, z - c.Z
		if dx * dx + dz * dz < (c.R + r) * (c.R + r) then
			return false
		end
	end
	for _, q in rects do
		if not (ignoreRoads and q.Road) then
			if x + r > q.X1 and x - r < q.X2 and z + r > q.Z1 and z - r < q.Z2 then
				return false
			end
		end
	end
	return true
end

export type GateLayout = { Z: number, Width: number }

-- Typed views of Config.Layout tables (iterating a table literal yields unknown in strict mode).
function Kit.Gates(layout: any): { [string]: GateLayout }
	return layout.Gates
end

function Kit.CrateStations(layout: any): { [string]: Vector3 }
	return layout.CrateStations
end

function Kit.ZoneSpawns(layout: any): { [string]: Vector3 }
	return layout.ZoneSpawns
end

function Kit.Pick<T>(list: { T }): T
	return list[Kit.Rng:NextInteger(1, #list)]
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby boards beside the spawn plaza: TOP GHOST HUNTERS (Config.Layout.Leaderboard, model
-- Map.Leaderboard.TopHunters) and TOP POWER (Config.Layout.PowerBoard, model TopPower). Each board
-- is a SurfaceGui with a title and Config.Leaderboard.Rows rows ("Row1".."RowN", each with Rank /
-- Name / Value labels); LeaderboardService fills them in.
local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)

local Leaderboard = {}

local C = Color3.fromRGB
local V = Vector3.new

type BoardSpec = { Model: string, Title: string, Icon: string?, Sub: string, Frame: Color3, Accent: Color3, ValueFit: string }

local function build(folder: Instance, L: { Position: Vector3, Yaw: number }, spec: BoardSpec)
	local m = Kit.Model(folder, spec.Model)
	local base = CFrame.new(L.Position) * CFrame.Angles(0, L.Yaw, 0)
	local W, H, BOTTOM = 18, 20, 3
	local wood = C(120, 80, 55)
	-- posts + feet
	for _, s in { -1, 1 } do
		Kit.Part(m, V(1.4, BOTTOM + H + 1, 1.4), base * CFrame.new(s * (W / 2 + 0.7), (BOTTOM + H + 1) / 2, 0.4), wood, { Mat = Enum.Material.Wood, Solid = true })
		Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(s * (W / 2 + 0.7), 0.3, 0.4), C(90, 70, 110), { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(m, 2, (base * CFrame.new(s * (W / 2 + 0.7), BOTTOM + H + 2, 0.4)).Position, Kit.Vivid(C(255, 200, 60)))
	end
	-- frame + board face (front = local -Z)
	Kit.Part(m, V(W + 1.2, H + 1.2, 0.8), base * CFrame.new(0, BOTTOM + H / 2, 0.6), Kit.Vivid(spec.Frame), { Solid = true })
	local board = Kit.Part(m, V(W, H, 0.6), base * CFrame.new(0, BOTTOM + H / 2, 0.2), C(35, 22, 60), { Solid = true, Name = "Board" })
	-- topper: crown shape
	Kit.Part(m, V(8, 2.4, 0.8), base * CFrame.new(0, BOTTOM + H + 1.6, 0.6), Kit.Vivid(C(255, 200, 60)), { Mat = Enum.Material.Metal })
	for i = -1, 1 do
		Kit.Wedge(m, V(0.8, 2, 2), base * CFrame.new(i * 3, BOTTOM + H + 3.8, 0.6) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(C(255, 200, 60)), { Mat = Enum.Material.Metal })
	end

	local gui = Kit.Gui(board, Enum.NormalId.Front, 30)
	gui.Name = "BoardGui"
	local rows = Config.Leaderboard.Rows
	local titleH = 0.15
	-- title, with the board's uploaded icon at both ends when it has one (square: the 18 x 20
	-- stud board makes a (titleH - 0.03)-tall square that wide in width scale * 20 / 18)
	local image = Icons.Get(spec.Icon)
	if image then
		local th = titleH - 0.03
		local iw = th * 20 / 18
		Kit.IconImage(gui, image, 0.04, 0.015, iw, th)
		Kit.IconImage(gui, image, 0.96 - iw, 0.015, iw, th)
		Kit.Label(gui, spec.Title, C(255, 215, 80), { Name = "Title", Pos = UDim2.fromScale(0.05 + iw, 0.015), Size = UDim2.fromScale(0.9 - 2 * iw, th) })
	else
		Kit.Label(gui, spec.Title, C(255, 215, 80), { Name = "Title", Pos = UDim2.fromScale(0.04, 0.015), Size = UDim2.fromScale(0.92, titleH - 0.03) })
	end
	Kit.Label(gui, spec.Sub, spec.Accent, { Name = "Sub", Pos = UDim2.fromScale(0.2, titleH - 0.02), Size = UDim2.fromScale(0.6, 0.05) })
	local rowH = (1 - titleH - 0.06) / rows
	for i = 1, rows do
		local y = titleH + 0.045 + (i - 1) * rowH
		local row: Frame = Instance.new("Frame")
		row.Name = "Row" .. i
		row.BackgroundColor3 = if i % 2 == 0 then C(55, 38, 90) else C(45, 30, 75)
		row.BorderSizePixel = 0
		row.Position = UDim2.fromScale(0.03, y)
		row.Size = UDim2.fromScale(0.94, rowH * 0.92)
		row.Parent = gui
		local rankColor = if i == 1 then C(255, 215, 80) elseif i == 2 then C(220, 225, 240) elseif i == 3 then C(240, 160, 90) else C(200, 190, 230)
		Kit.Label(row, "#" .. i, rankColor, { Name = "Rank", Pos = UDim2.fromScale(0.01, 0.1), Size = UDim2.fromScale(0.12, 0.8) })
		-- (filled in by LeaderboardService: TextFit sizes these against typical lengths, not the
		-- "..." / "" placeholders; longer names are cut with "...")
		local name = Kit.Label(row, "...", C(255, 255, 255), { Name = "PlayerName", Pos = UDim2.fromScale(0.15, 0.1), Size = UDim2.fromScale(0.52, 0.8) })
		name:SetAttribute("FitText", "👑 Ghosthunter123")
		local value = Kit.Label(row, "", spec.Accent, { Name = "Value", Pos = UDim2.fromScale(0.69, 0.1), Size = UDim2.fromScale(0.3, 0.8) })
		value:SetAttribute("FitText", spec.ValueFit)
	end
	local p = L.Position
	Kit.AddRect(p.X - 12, p.Z - 12, p.X + 12, p.Z + 12)
end

function Leaderboard.Build(map: Instance)
	local folder = Kit.Folder(map, "Leaderboard")
	build(folder, Config.Layout.Leaderboard, {
		Model = "TopHunters",
		Title = "🏆 TOP GHOST HUNTERS",
		Sub = "ALL-TIME ECTOPLASM",
		Frame = C(150, 90, 230),
		Accent = C(150, 255, 170),
		ValueFit = "999.9Qa",
	})
	build(folder, Config.Layout.PowerBoard, {
		Model = "TopPower",
		Title = "TOP POWER",
		Icon = "power",
		Sub = "BEST CREW POWER",
		Frame = C(255, 150, 50),
		Accent = C(255, 220, 110),
		ValueFit = "999.9Qa",
	})
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
-- Night-but-bright lighting: purple haze, big moon, punchy colours. Bloom is soft and only
-- catches the brightest pixels, so the few neon accents (windows, lamps, jack-o'-lantern
-- faces) glow without blowing out; the solid candy colours carry the scene.

local LightingService = game:GetService("Lighting")

local LightingSetup = {}

local function clear(name: string)
	local old = LightingService:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

function LightingSetup.Apply()
	local L = LightingService
	L.ClockTime = 0.5
	L.GeographicLatitude = 20
	L.Brightness = 1.7 -- owner: dimmer (was 2.2)
	L.Ambient = Color3.fromRGB(150, 120, 200)
	L.OutdoorAmbient = Color3.fromRGB(160, 140, 210)
	L.ColorShift_Top = Color3.fromRGB(170, 140, 255)
	L.ColorShift_Bottom = Color3.fromRGB(60, 30, 90)
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.4
	L.GlobalShadows = true
	L.ShadowSoftness = 0.4
	L.ExposureCompensation = -0.1 -- owner asked twice for less brightness (was 0.12)
	L.FogEnd = 100000

	for _, child in L:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "GHSky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 24
	sky.SunAngularSize = 10
	sky.Parent = L

	local atmo = Instance.new("Atmosphere")
	atmo.Name = "GHAtmosphere"
	atmo.Density = 0.26 -- the map is ~2.7k studs long now: keep the next zone's landmarks visible
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(190, 150, 255)
	atmo.Decay = Color3.fromRGB(110, 70, 180)
	atmo.Glare = 0 -- glare smeared bright lights
	atmo.Haze = 0.6
	atmo.Parent = L

	clear("GHBloom")
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GHBloom"
	bloom.Intensity = 0.04 -- owner: less bloom (was 0.2, then 0.08)
	bloom.Size = 4 -- small radius: lights stay crisp, no blurry halo
	bloom.Threshold = 3.2
	bloom.Parent = L

	clear("GHColor")
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GHColor"
	cc.Saturation = 0.24
	cc.Contrast = 0.12
	cc.Brightness = 0
	cc.TintColor = Color3.fromRGB(255, 245, 255)
	cc.Parent = L

	clear("GHSunRays")
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "GHSunRays"
	rays.Intensity = 0.04
	rays.Spread = 0.7
	rays.Parent = L
end

return LightingSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Neighborhood</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 1: Haunted Neighborhood (Z -37..260) and the LOBBY behind it (Config.Layout.Lobby,
-- Z -130..-37, no ghosts): spawn plaza, Ghost Hunter HQ, Merge/Trading booths (the Hatchery,
-- the Boss Tower entrance and the boards are built in their own files). Players walk from the plaza through the free
-- "THE NEIGHBORHOOD" arch in the lobby's front hedge, past the Beginner crate station and the
-- upgrade booth, then down a main road along X = 0 to the Cemetery gate, a cross street at Z 110..124 running
-- from hedge to hedge, and candy-coloured houses placed on a grid wherever the keep-out map allows.
-- Palette: bright grass, warm houses, orange accents, purple paranormal touches, ectoplasm
-- green. Glow is reserved for the front windows, street lamps, car headlights and the HQ
-- antenna; side windows, plaza rings, bands, doors and tanks are solid colours.
-- Materials: Asphalt roads, Concrete sidewalks, Slate roof shingles, Brick chimneys, Wood posts.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)
local Props = require(script.Parent.Props)

local Neighborhood = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local WALLS = {
	C(255, 175, 190), C(255, 214, 168), C(255, 225, 140), C(250, 236, 200), C(215, 180, 255),
	C(255, 190, 140), C(240, 200, 150), C(255, 155, 135),
}
local ROOFS = { C(120, 60, 170), C(60, 120, 190), C(200, 70, 110), C(70, 150, 110), C(230, 110, 50), C(90, 70, 160) }
local WINDOWS = { C(255, 235, 120), C(150, 255, 140), C(205, 140, 255), C(255, 200, 90) }
local DOORS = { C(140, 70, 200), C(255, 110, 70), C(60, 170, 150), C(230, 70, 120) }
local TRIM = C(255, 250, 245)
-- lobby offset: everything in the lobby was laid out around a spawn at Z = 0
local LZ = Config.Layout.Spawn.Z
local LOBBY = Config.Layout.Lobby

--==================================================================
-- HOUSE
--==================================================================
-- Front windows glow; side windows (lit = false) are warm painted glass.
local function window(m: Instance, cf: CFrame, glow: Color3, lit: boolean?)
	Kit.Part(m, V(4, 4, 0.3), cf, TRIM, { Mat = Enum.Material.Wood })
	local glass: Kit.Opts = if lit == false then { Refl = 0.2 } else { Mat = NEON }
	Kit.Part(m, V(3.2, 3.2, 0.3), cf * CFrame.new(0, 0, -0.12), if lit == false then Kit.Vivid(glow) else glow, glass)
end

local function house(parent: Instance, cx: number, cz: number, fx: number, fz: number)
	local rng = Kit.Rng
	local W = rng:NextInteger(18, 23) -- along local X
	local D = rng:NextInteger(15, 19) -- along local Z (front = -Z)
	local twoStory = rng:NextNumber() < 0.35
	local H = if twoStory then 20 else 13
	local RH = math.floor(W * 0.38)
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local m = Kit.Model(parent, "House")
	local wall = Kit.Pick(WALLS)
	local roof = Kit.Pick(ROOFS)
	local glow = Kit.Pick(WINDOWS)

	Kit.Part(m, V(W + 0.8, 1.2, D + 0.8), base * CFrame.new(0, 0.6, 0), C(150, 130, 170), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(W, H, D), base * CFrame.new(0, H / 2, 0), wall, { Solid = true, Shadow = true, Name = "Body" })
	-- corner trims (front)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.9, H, 0.9), base * CFrame.new(sx * W / 2, H / 2, -D / 2), TRIM)
	end
	-- gable roof: two wedges meeting at the ridge (ridge along local X)
	local half = D / 2 + 1.5
	Kit.Part(m, V(W + 2.4, 0.6, D + 3.4), base * CFrame.new(0, H + 0.3, 0), TRIM)
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, -half / 2), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, half / 2) * CFrame.Angles(0, math.pi, 0), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- chimney poking through the back slope
	local chX = (if rng:NextNumber() < 0.5 then -1 else 1) * W * 0.28
	Kit.Part(m, V(2.4, RH + 2.5, 2.4), base * CFrame.new(chX, H + (RH + 2.5) / 2 + 0.6, D * 0.22), C(190, 110, 100), { Mat = Enum.Material.Brick, Shadow = true })
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(chX, H + RH + 3.4, D * 0.22), C(90, 70, 110))
	if rng:NextNumber() < 0.25 then
		-- a puff of ectoplasm smoke
		Kit.Ball(m, 2.2, (base * CFrame.new(chX, H + RH + 5, D * 0.22)).Position, Kit.Vivid(C(150, 255, 160)), { Transp = 0.4 })
	end
	-- front windows
	local rows: { number } = if twoStory then { H * 0.3, H * 0.72 } else { H * 0.5 }
	for _, wy in rows do
		for _, sx in { -1, 1 } do
			window(m, base * CFrame.new(sx * W * 0.28, wy, -D / 2 - 0.15), glow)
		end
	end
	if twoStory then
		window(m, base * CFrame.new(0, H * 0.72, -D / 2 - 0.15), Kit.Pick(WINDOWS))
	end
	-- side windows
	for _, sx in { -1, 1 } do
		window(m, base * CFrame.new(sx * (W / 2 + 0.15), H * 0.5, 0) * CFrame.Angles(0, -sx * math.pi / 2, 0), glow, false)
	end
	-- door
	Kit.Part(m, V(5, 8, 0.3), base * CFrame.new(0, 4.6, -D / 2 - 0.1), TRIM)
	Kit.Part(m, V(4, 7, 0.4), base * CFrame.new(0, 4.4, -D / 2 - 0.2), Kit.Pick(DOORS))
	Kit.Ball(m, 0.6, (base * CFrame.new(1.3, 4.2, -D / 2 - 0.5)).Position, C(255, 215, 80), { Refl = 0.3 }) -- brass knob
	-- porch with a little roof
	local pw = W * 0.6
	Kit.Part(m, V(pw, 0.8, 5), base * CFrame.new(0, 0.4, -D / 2 - 2.5), C(170, 120, 85), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local porchTop = if twoStory then 9.5 else 9.2
	Kit.Part(m, V(pw + 0.6, 0.5, 5.6), base * CFrame.new(0, porchTop + 0.25, -D / 2 - 2.8), roof)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, porchTop - 0.8, 0.6), base * CFrame.new(sx * (pw / 2 - 0.4), 0.8 + (porchTop - 0.8) / 2, -D / 2 - 5), TRIM, { Mat = Enum.Material.Wood })
	end
	if rng:NextNumber() < 0.55 then
		local p = base * CFrame.new(pw * 0.32, 0.8, -D / 2 - 3.2)
		local front = base.LookVector
		Props.Pumpkin(m, p.Position, 2.4, front.X, front.Z)
	end

	-- yard extras (only where the keep-out map allows)
	local function free(lx: number, lz: number, r: number): boolean
		local p = (base * CFrame.new(lx, 0, lz)).Position
		return Kit.IsFree(p.X, p.Z, r)
	end
	local yard = -D / 2 - 9
	if rng:NextNumber() < 0.45 and free(-W / 2 - 1, yard, 1) and free(W / 2 + 1, yard, 1) then
		local a1 = (base * CFrame.new(-W / 2 - 1, 0, yard)).Position
		local a2 = (base * CFrame.new(-2.5, 0, yard)).Position
		local b1 = (base * CFrame.new(2.5, 0, yard)).Position
		local b2 = (base * CFrame.new(W / 2 + 1, 0, yard)).Position
		Props.Fence(m, a1, a2, "picket")
		Props.Fence(m, b1, b2, "picket")
	elseif free(-W / 2 + 1, yard + 1, 1.5) then
		-- mailbox
		local mp = base * CFrame.new(-W / 2 + 1, 0, yard + 1)
		Kit.Part(m, V(0.5, 3.4, 0.5), mp * CFrame.new(0, 1.7, 0), C(110, 80, 60), { Mat = Enum.Material.Wood })
		Kit.Part(m, V(1.4, 1.3, 2.2), mp * CFrame.new(0, 3.9, 0), Kit.Pick(DOORS))
		Kit.Part(m, V(0.15, 1.2, 0.4), mp * CFrame.new(0.8, 4.4, 0.6), C(255, 70, 90))
	end
	if rng:NextNumber() < 0.3 then
		Props.FloatingPumpkin(m, (base * CFrame.new(-pw * 0.3, 11 + rng:NextNumber(0, 3), -D / 2 - 6)).Position)
	end
	Kit.AddCircle(cx, cz, math.max(W, D) / 2 + 4)
end

--==================================================================
-- SPAWN PLAZA + HQ
--==================================================================
local function plaza(f: Instance)
	local spawnPos = Config.Layout.Spawn
	local sx, sz = spawnPos.X, spawnPos.Z
	Kit.Disc(f, sx, sz, 0.25, 52, 0.6, C(175, 150, 220), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.Disc(f, sx, sz, 0.35, 44, 0.2, Kit.Vivid(C(150, 255, 140)))
	Kit.Disc(f, sx, sz, 0.42, 42, 0.3, C(120, 95, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Disc(f, sx, sz, 0.5, 20, 0.2, Kit.Vivid(C(210, 120, 255)))

	local spawn: SpawnLocation = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(14, 1, 14)
	-- top surface at Y = 1.1; face +Z (forward)
	spawn.CFrame = CFrame.new(sx, 0.6, sz) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = C(130, 70, 220)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.CanCollide = true
	spawn.CanQuery = true
	spawn.CanTouch = true
	spawn.CastShadow = false
	spawn.Parent = f
	Kit.Stats.Parts += 1
	-- emblem rings painted on the pad
	Kit.Disc(f, sx, sz, 1.16, 6, 0.1, Kit.Vivid(C(150, 255, 200)))
	Kit.Disc(f, sx, sz, 1.18, 4.6, 0.1, C(120, 70, 210))
	local border = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(sx - 7.4, 0.4, sz + s * 7) - V(0, 0, 0.4), V(sx + 7.4, 1.3, sz + s * 7) + V(0, 0, 0.4), border)
		Kit.Box(f, V(sx + s * 7, 0.4, sz - 7) - V(0.4, 0, 0), V(sx + s * 7, 1.3, sz + 7) + V(0.4, 0, 0), border)
	end
end

local function hq(f: Instance)
	local purple, dark = C(120, 75, 210), C(60, 40, 110)
	Kit.Box(f, V(-24, 0, LZ - 58), V(24, 16, LZ - 40), purple, { Mat = Enum.Material.Concrete, Solid = true, Name = "HQ" })
	Kit.Box(f, V(-26, 16, LZ - 60), V(26, 17.5, LZ - 38), dark, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Ball(f, 18, V(0, 17.5, LZ - 50), C(190, 160, 255), { Shadow = true })
	Kit.Box(f, V(-24.3, 5.6, LZ - 39.9), V(24.3, 6.4, LZ - 39.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Box(f, V(-24.3, 15, LZ - 39.9), V(24.3, 15.6, LZ - 39.6), Kit.Vivid(C(255, 150, 60)))
	-- big mint door
	Kit.Box(f, V(-7, 0, LZ - 39.85), V(7, 12, LZ - 39.6), TRIM)
	Kit.Box(f, V(-6, 0, LZ - 39.7), V(6, 11, LZ - 39.35), Kit.Vivid(C(150, 255, 160)), { Refl = 0.1 })
	-- windows
	for _, x in { -17, -11, 11, 17 } do
		Kit.Box(f, V(x - 2, 8, LZ - 39.8), V(x + 2, 12.5, LZ - 39.4), C(255, 235, 120), { Mat = NEON })
	end
	-- sign facing +Z (toward spawn)
	local signCF = CFrame.new(0, 21.5, LZ - 39) * CFrame.Angles(0, Kit.FaceYaw(0, 1), 0)
	local sign = Kit.Part(f, V(32, 6, 1), signCF, C(45, 25, 80))
	Kit.Part(f, V(33.5, 7.5, 0.5), signCF * CFrame.new(0, 0, 0.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sign, Enum.NormalId.Front, "GHOST HUNTER HQ", C(255, 230, 90))
	-- antenna + dish
	Kit.Cyl(f, 18, 0.8, CFrame.new(16, 26.5, LZ - 50), C(200, 200, 220), { Mat = Enum.Material.Metal })
	local orb = Kit.Ball(f, 2.6, V(16, 36, LZ - 50), C(255, 90, 160), { Mat = NEON })
	Kit.Light(orb, C(255, 120, 190), 30, 1.2)
	Kit.Cyl(f, 0.8, 9, CFrame.new(-16, 21, LZ - 50) * CFrame.Angles(math.rad(35), 0, 0), C(230, 230, 245))
	Kit.Cyl(f, 3, 1, CFrame.new(-16, 19, LZ - 50), C(150, 150, 170))
	-- containment tanks with captured ghosts
	for _, s in { -1, 1 } do
		local x = s * 30
		Kit.Cyl(f, 1, 9, CFrame.new(x, 0.5, LZ - 46), dark, { Mat = Enum.Material.Metal, Solid = true })
		local tank = Kit.Cyl(f, 12, 8, CFrame.new(x, 7, LZ - 46), Kit.Vivid(C(130, 255, 170)), { Transp = 0.55, Refl = 0.2 })
		Kit.Cyl(f, 1, 9, CFrame.new(x, 13.5, LZ - 46), dark, { Mat = Enum.Material.Metal })
		Kit.Ball(f, 3.6, V(x, 7.5, LZ - 46), C(240, 245, 255))
		Kit.Emitter(tank, C(150, 255, 180), 2, 2, 0.5)
	end
	Kit.AddRect(-36, LZ - 60, 36, LZ - 36)
end

--==================================================================
-- SPAWN KIOSKS (Merge / Trading) in the right pocket behind the plaza
--==================================================================
-- Market booths facing the plaza: plank deck, back wall, counter, striped awning with a
-- scalloped edge, a sign board and a hanging lantern, plus themed counter props (Trading: two
-- display pedestals with swap arrows and crates; Merge: a bubbling fusion cauldron with two
-- orbs about to merge). Each has an invisible PromptAnchor part carrying attribute
-- Kiosk = "Trade" | "Merge" and a ProximityPrompt; the client opens the matching panel from
-- ProximityPromptService.PromptTriggered (prompt.Parent:GetAttribute("Kiosk")).
-- The pocket (X 14..36, Z LZ-36..LZ-12) is reserved in Builder.registerKeepOuts; the left pocket
-- holds the Pet Hatchery (Hatchery.luau).
local KIOSKS = {
	{ Id = "Merge", Title = "MERGE", Emoji = "✨", Icon = "menu_merge", Pos = V(20, 0, LZ - 29), Main = C(190, 110, 255), Accent = C(255, 230, 90) },
	{ Id = "Trade", Title = "TRADING", Emoji = "🤝", Icon = "menu_trade", Pos = Config.Layout.TradeBooth, Main = C(255, 170, 60), Accent = C(150, 255, 140) },
}

local KIOSK_DARK = C(55, 35, 90)
local COUNTER_TOP = 4.3 -- top of the counter (Y above the ground)

-- Flat arrow on the back wall pointing along local `dir` (+1 = +X, -1 = -X).
local function swapArrow(m: Instance, at: CFrame, dir: number, color: Color3)
	Kit.Part(m, V(2.6, 0.45, 0.2), at, color)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(1.2, 0.45, 0.2), at * CFrame.new(dir * 1.05, s * 0.32, 0) * CFrame.Angles(0, 0, dir * s * math.rad(-45)), color)
	end
end

-- Wooden crate with dark corner bands.
local function crate(m: Instance, cf: CFrame, s: number)
	Kit.Part(m, V(s, s, s), cf, C(190, 135, 80), { Mat = Enum.Material.WoodPlanks })
	Kit.Part(m, V(s + 0.08, s * 0.16, s + 0.08), cf * CFrame.new(0, s * 0.36, 0), C(95, 60, 40))
	Kit.Part(m, V(s + 0.08, s * 0.16, s + 0.08), cf * CFrame.new(0, -s * 0.36, 0), C(95, 60, 40))
end

local function tradeDecor(m: Instance, base: CFrame, k: typeof(KIOSKS[1]))
	-- two display pedestals on the counter: a spirit gem and a mini crate, ready to swap
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.8, 1.6, 1.6), base * CFrame.new(sx * 2.7, COUNTER_TOP + 0.4, -2.3) * CFrame.Angles(0, 0, math.pi / 2), C(240, 235, 250), { Shape = Enum.PartType.Cylinder })
	end
	Kit.Part(m, V(0.9, 1.4, 0.9), base * CFrame.new(-2.7, COUNTER_TOP + 1.6, -2.3) * CFrame.Angles(0, math.rad(45), 0), C(120, 230, 255), { Mat = Enum.Material.Glass, Transp = 0.1, Refl = 0.2 })
	crate(m, base * CFrame.new(2.7, COUNTER_TOP + 1.4, -2.3) * CFrame.Angles(0, math.rad(20), 0), 1.2)
	-- swap arrows on the back wall (one each way)
	swapArrow(m, base * CFrame.new(0, 6.6, 2.85), 1, Kit.Vivid(k.Main))
	swapArrow(m, base * CFrame.new(0, 5.3, 2.85), -1, Kit.Vivid(k.Accent))
	-- crates stacked beside the booth
	crate(m, base * CFrame.new(-6.4, 1, 1), 2)
	crate(m, base * CFrame.new(-6.3, 2.75, 1.1) * CFrame.Angles(0, math.rad(25), 0), 1.5)
	crate(m, base * CFrame.new(-6.5, 0.7, -1.6) * CFrame.Angles(0, math.rad(-15), 0), 1.4)
end

local function mergeDecor(m: Instance, base: CFrame, k: typeof(KIOSKS[1]))
	-- fusion cauldron on the counter: dark pot, gold rim, glowing brew with sparkles
	local pot = base * CFrame.new(0, COUNTER_TOP, -2.3)
	Kit.Cyl(m, 1.7, 2.6, pot * CFrame.new(0, 0.85, 0), C(45, 35, 70), { Refl = 0.1 })
	Kit.Cyl(m, 0.35, 3, pot * CFrame.new(0, 1.7, 0), Kit.Vivid(k.Accent))
	local brew = Kit.Cyl(m, 0.2, 2.4, pot * CFrame.new(0, 1.8, 0), C(225, 140, 255), { Mat = NEON })
	Kit.Emitter(brew, C(255, 220, 255), 3, 0.7, 1.2)
	-- two orbs above the brew, about to merge
	for i, col in { C(120, 230, 255), C(255, 200, 90) } do
		local orb = Kit.Ball(m, 0.8, (pot * CFrame.new(if i == 1 then -1 else 1, 3, 0)).Position, col, { Mat = NEON })
		Kit.Float(orb, 0.5)
	end
	Kit.Ball(m, 0.45, (pot * CFrame.new(0, 3.6, 0)).Position, C(255, 250, 230), { Mat = NEON })
	-- fusion crystals at both ends of the counter
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.8, 1.5, 0.8), base * CFrame.new(sx * 3.6, COUNTER_TOP + 0.75, -2.3) * CFrame.Angles(0, math.rad(45), math.rad(sx * 10)), C(200, 160, 255), { Mat = Enum.Material.Glass, Transp = 0.15, Refl = 0.2 })
	end
	-- rune circle painted on the back wall
	Kit.Part(m, V(0.2, 3.6, 3.6), base * CFrame.new(0, 6, 2.85) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(k.Accent), { Shape = Enum.PartType.Cylinder })
	Kit.Part(m, V(0.2, 3, 3), base * CFrame.new(0, 6, 2.8) * CFrame.Angles(0, math.pi / 2, 0), k.Main, { Shape = Enum.PartType.Cylinder })
	Kit.Part(m, V(1.4, 1.4, 0.2), base * CFrame.new(0, 6, 2.7) * CFrame.Angles(0, 0, math.rad(45)), Kit.Vivid(k.Accent))
end

local KIOSK_DECOR: { [string]: (Instance, CFrame, typeof(KIOSKS[1])) -> () } = {
	Trade = tradeDecor,
	Merge = mergeDecor,
}

local function kiosk(parent: Instance, k: typeof(KIOSKS[1]))
	local spawnPos = Config.Layout.Spawn
	-- local -Z (front) faces the spawn plaza
	local base = CFrame.new(k.Pos) * CFrame.Angles(0, Kit.FaceYaw(spawnPos.X - k.Pos.X, spawnPos.Z - k.Pos.Z), 0)
	local m = Kit.Model(parent, "Kiosk_" .. k.Id)
	local cream = C(250, 245, 255)
	local wood: Kit.Opts = { Mat = Enum.Material.WoodPlanks, Solid = true }
	-- floor deck and back wall with a painted accent band
	Kit.Part(m, V(10, 0.6, 8), base * CFrame.new(0, 0.3, 0), C(150, 110, 80), wood)
	Kit.Part(m, V(9.4, 8, 0.8), base * CFrame.new(0, 4.6, 3.3), k.Main, { Solid = true, Shadow = true })
	Kit.Part(m, V(9.4, 0.5, 0.2), base * CFrame.new(0, 3.6, 2.85), Kit.Vivid(k.Accent))
	-- counter: dark planks, coloured top, a front stripe and a trim at the foot
	Kit.Part(m, V(9, 3.4, 1.6), base * CFrame.new(0, 2.3, -2.3), KIOSK_DARK, wood)
	Kit.Part(m, V(9.4, 0.3, 2), base * CFrame.new(0, COUNTER_TOP - 0.15, -2.3), Kit.Vivid(k.Accent))
	Kit.Part(m, V(9.02, 0.6, 0.1), base * CFrame.new(0, 3, -3.12), Kit.Vivid(k.Main))
	Kit.Part(m, V(9.02, 0.3, 0.1), base * CFrame.new(0, 0.75, -3.12), cream)
	-- corner posts
	for _, sx in { -1, 1 } do
		for _, lz in { -3.6, 3.3 } do
			Kit.Part(m, V(0.6, 8, 0.6), base * CFrame.new(sx * 4.7, 4.6, lz), cream, { Mat = Enum.Material.Wood })
		end
	end
	-- striped awning roof with a scalloped front edge
	for i = 0, 5 do
		local col = if i % 2 == 0 then k.Main else cream
		local x = -4.25 + i * 1.7
		Kit.Part(m, V(1.7, 0.5, 9), base * CFrame.new(x, 8.85, -0.4) * CFrame.Angles(math.rad(-8), 0, 0), col)
		Kit.Ball(m, 1.5, (base * CFrame.new(x, 8.05, -4.85)).Position, col)
	end
	Kit.Part(m, V(10.4, 0.4, 0.4), base * CFrame.new(0, 8.3, -4.75), Kit.Vivid(k.Accent))
	-- sign board above the awning, facing the plaza
	local board = Kit.Part(m, V(8, 2.2, 0.5), base * CFrame.new(0, 10.8, -1.2), KIOSK_DARK, { Name = "KioskSign" })
	Kit.Part(m, V(8.8, 3, 0.3), base * CFrame.new(0, 10.8, -0.85), Kit.Vivid(k.Accent))
	-- the same icon image as the menu button, left of the title (emoji only without an image id)
	local icon = Icons.Get(k.Icon)
	if icon then
		local g = Kit.Gui(board, Enum.NormalId.Front)
		local img = Instance.new("ImageLabel")
		img.Name = "KioskIcon"
		img.BackgroundTransparency = 1
		img.Image = icon
		img.ScaleType = Enum.ScaleType.Fit
		img.Position = UDim2.fromScale(0.03, 0.06)
		img.Size = UDim2.fromScale(0.24, 0.88) -- square on the 8 x 2.2 board
		img.Parent = g
		Kit.Label(g, k.Title, C(255, 255, 255), { Size = UDim2.fromScale(0.68, 0.8), Pos = UDim2.fromScale(0.29, 0.1) })
	else
		Kit.Sign(board, Enum.NormalId.Front, k.Emoji .. " " .. k.Title, C(255, 255, 255))
	end
	-- lantern hanging from the front-left post (accent glow, meaning "open")
	Kit.Part(m, V(0.15, 0.9, 0.15), base * CFrame.new(-4.7, 7.25, -4.1), KIOSK_DARK)
	local lantern = Kit.Ball(m, 0.9, (base * CFrame.new(-4.7, 6.5, -4.1)).Position, k.Accent, { Mat = NEON })
	Kit.Light(lantern, k.Accent, 12, 0.8)
	local decor = KIOSK_DECOR[k.Id]
	if decor then
		decor(m, base, k)
	end
	-- invisible prompt anchor in front of the counter
	local anchor = Kit.Part(m, V(1, 1, 1), base * CFrame.new(0, 3, -3.9), k.Main, { Transp = 1, Name = "PromptAnchor" })
	anchor:SetAttribute("Kiosk", k.Id)
	-- pcall: the headless world simulator (tools/worldsim) has no ProximityPrompt class
	pcall(function()
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "KioskPrompt"
		prompt.ActionText = "Open"
		prompt.ObjectText = k.Title
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.Parent = anchor
	end)
end

local function kiosks(f: Instance)
	local folder = Kit.Folder(f, "Kiosks")
	for _, k in KIOSKS do
		if k.Id ~= "Trade" or Config.Trade.Enabled then -- no trading booth while trading is off
			kiosk(folder, k)
		end
	end
end

--==================================================================
-- LOBBY ENTRANCE: open arch (no barrier, no cost) in the lobby's front hedge
--==================================================================
local function entrance(f: Instance)
	local m = Kit.Model(f, "LobbyEntrance")
	local z = LOBBY.FrontZ
	local half = LOBBY.EntranceWidth / 2
	local pw = 8
	local stone, trim = C(150, 125, 200), Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		local x1, x2 = s * half, s * (half + pw)
		Kit.Box(m, V(x1, 0, z - 5), V(x2, 26, z + 5), stone, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(m, V(s * (half + 0.01), 0, z - 6), V(s * (half + pw + 1), 3, z + 6), C(120, 100, 165), { Mat = Enum.Material.Slate, Solid = true })
		for _, fz in { -1, 1 } do
			Kit.Box(m, V(s * (half + 0.6) - 0.3, 3, z + fz * 5), V(s * (half + 0.6) + 0.3, 24, z + fz * 5.3), trim)
		end
		Props.Pumpkin(m, V(s * (half + pw / 2), 30, z), 6, 0, -1, true)
		Props.StreetLamp(m, V(s * (half + pw / 2), 0.2, z - 9), C(200, 160, 240), false, true)
	end
	-- top beam (Y 24..30) spanning the opening, sign above it facing the lobby (-Z)
	Kit.Box(m, V(-(half + pw + 1), 24, z - 4), V(half + pw + 1, 30, z + 4), stone, { Mat = Enum.Material.Slate, Solid = true })
	for _, fz in { -1, 1 } do
		Kit.Box(m, V(-(half + pw + 1), 24, z + fz * 4), V(half + pw + 1, 24.6, z + fz * 4.3), trim)
	end
	local sign = Kit.Part(m, V(40, 9, 1), CFrame.new(0, 36, z - 3), C(45, 25, 80), { Name = "EntranceSign" })
	Kit.Part(m, V(42, 11, 0.6), CFrame.new(0, 36, z - 2.3), trim)
	local zone = Config.Zones[1]
	local gui = Kit.Gui(sign, Enum.NormalId.Front, 30)
	Kit.Label(gui, "THE NEIGHBORHOOD", zone.Accent, { Name = "ZoneLabel", Pos = UDim2.fromScale(0.03, 0.06), Size = UDim2.fromScale(0.94, 0.52) })
	Kit.Label(gui, "GHOSTS AHEAD ▲", C(255, 230, 120), { Name = "SubLabel", Pos = UDim2.fromScale(0.15, 0.6), Size = UDim2.fromScale(0.7, 0.34) })
	Kit.AddRect(-(half + pw + 2), z - 10, half + pw + 2, z + 6)
end

--==================================================================
-- ROADS
--==================================================================
local function roads(f: Instance)
	local asphalt = C(72, 64, 92)
	local walk = C(200, 185, 230)
	local front = LOBBY.FrontZ
	-- lobby walkway (cobbles) from the HQ door through the arch, then the main road X -10..10
	-- from the arch to the gate
	local pave: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true }
	Kit.Box(f, V(-10, -0.4, LZ - 36), V(10, 0.1, front + 3), C(165, 140, 205), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "LobbyWalk" })
	Kit.Box(f, V(-10, -0.4, front + 3), V(10, 0.1, 260), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "MainRoad" })
	for z = front + 9, 250, 12 do
		Kit.Box(f, V(-0.4, 0.1, z), V(0.4, 0.14, z + 6), C(255, 210, 80))
	end
	-- cross street from hedge to hedge
	Kit.Box(f, V(-136, -0.4, 110), V(136, 0.06, 124), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "CrossStreet" })
	for x = -130, 124, 12 do
		if x < -16 or x > 14 then
			Kit.Box(f, V(x, 0.06, 116.6), V(x + 6, 0.1, 117.4), C(255, 210, 80))
		end
	end
	-- sidewalks
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, -0.4, front + 3), V(s * 14, 0.22, 106), walk, pave)
		Kit.Box(f, V(s * 10, -0.4, 128), V(s * 14, 0.22, 257), walk, pave)
		Kit.Box(f, V(-136, -0.4, if s < 0 then 106 else 124), V(-14, 0.22, if s < 0 then 110 else 128), walk, pave)
		Kit.Box(f, V(14, -0.4, if s < 0 then 106 else 124), V(136, 0.22, if s < 0 then 110 else 128), walk, pave)
	end
	Kit.AddRect(-14, LZ - 36, 14, 260, true)
	Kit.AddRect(-136, 106, 136, 128, true)
end

--==================================================================
-- BUILD
--==================================================================
function Neighborhood.Build(map: Instance)
	local f = Kit.Folder(map, "Neighborhood")
	local rng = Kit.Rng

	plaza(f)
	hq(f)
	entrance(f)
	roads(f)
	kiosks(f)

	-- Houses on a grid; each faces the main road.
	local houses = Kit.Folder(f, "Houses")
	for _, x in { -118, -88, -58, -28, 28, 58, 88, 118 } do
		for z = -40, 230, 30 do
			if Kit.IsFree(x, z, 15) then
				house(houses, x, z, if x < 0 then 1 else -1, 0)
			end
		end
	end

	-- Street lamps along the main road (skipped inside ghost areas)
	local lit = 0
	for z = LOBBY.FrontZ + 11, 250, 24 do
		for _, s in { -1, 1 } do
			local x = s * 12.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0.22, z), Kit.Pick({ C(255, 230, 120), C(170, 255, 150), C(210, 150, 255) }), lit % 2 == 1 and lit <= 9)
			end
		end
	end
	for x = -125, 120, 35 do
		if Kit.IsFree(x, 108, 1, true) then
			Props.StreetLamp(f, V(x, 0.22, 108), C(255, 200, 120), false)
		end
	end

	-- Parked cars (curbside)
	local cars = {
		{ -6, 150, 0, 1 }, { 6, 186, 0, -1 }, { -105, 113.5, 1, 0 }, { -42, 113.5, 1, 0 }, { 40, 120.5, -1, 0 },
		{ 70, -20, 0, 1 }, { -70, 20, 0, -1 },
	}
	for _, c in cars do
		if Kit.IsFree(c[1], c[2], 7.5, true) then
			Props.Car(f, V(c[1], 0.1, c[2]), c[3], c[4], Kit.Pick(Props.Colors.Car))
		end
	end

	-- Trees and pumpkins scattered on free grass
	local trees = 0
	for _ = 1, 260 do
		if trees >= 30 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(LOBBY.FrontZ + 6, 250)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(10, 17))
		end
	end
	local pumpkins = 0
	for _ = 1, 300 do
		if pumpkins >= 26 then
			break
		end
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(LOBBY.FrontZ + 6, 254)
		if Kit.IsFree(x, z, 2.5) then
			pumpkins += 1
			Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 4.6), -x, -z + 100)
			Kit.AddCircle(x, z, 2.5)
		end
	end
	local floats = 0
	for _ = 1, 200 do
		if floats >= 3 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(LOBBY.FrontZ + 6, 240)
		if Kit.IsFree(x, z, 3) then
			floats += 1
			Props.FloatingPumpkin(f, V(x, rng:NextNumber(8, 13), z))
		end
	end

	-- Spectral fog accents
	Props.Wisp(f, V(-40, 0, 40), C(170, 110, 255), 14, true)
	Props.Wisp(f, V(55, 0, 135), C(120, 255, 170), 12, true)
	Props.Wisp(f, V(-110, 0, 215), C(200, 120, 255), 16, true)
	Props.Wisp(f, V(30, 0, 240), C(120, 255, 170), 10, false)
	Props.Wisp(f, V(-60, 0, -20), C(170, 110, 255), 12, false)
	Props.Wisp(f, V(110, 0, 20), C(255, 140, 220), 12, false)
end

return Neighborhood
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable chunky props shared by every zone (pumpkins, trees, lamps, fences, cars...).
-- Positions are ground points (Y = 0 is the walkable surface) unless stated otherwise.

local Kit = require(script.Parent.Kit)

local Props = {}

local NEON = Enum.Material.Neon
local C = Color3.fromRGB

Props.Colors = {
	PumpkinBody = { C(255, 140, 30), C(255, 120, 40), C(255, 165, 50) },
	Canopy = { C(170, 90, 230), C(255, 140, 50), C(200, 110, 255), C(255, 110, 90), C(140, 220, 90) },
	Glow = { C(255, 230, 110), C(140, 255, 120), C(200, 130, 255), C(255, 170, 70) },
	Car = { C(255, 90, 140), C(80, 200, 255), C(255, 200, 60), C(140, 255, 140), C(190, 120, 255), C(255, 120, 60) },
	Book = { C(255, 90, 90), C(90, 170, 255), C(255, 210, 70), C(140, 230, 120), C(200, 120, 255), C(255, 140, 200) },
}

-- Segment between two points (square cross-section). Used for twisted trunks, branches, cracks.
function Props.Beam(parent: Instance, a: Vector3, b: Vector3, w: number, h: number, color: Color3, opts: Kit.Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local cf: CFrame
	if math.abs(d.Unit.Y) > 0.98 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return Kit.Part(parent, Vector3.new(w, h, len), cf, color, opts)
end

-- Pumpkin / jack-o-lantern with a carved face toward (fx, fz). `pos` is the bottom of the pumpkin.
-- glow = true gives a Neon jack-o'-lantern face: use it only at landmarks (gate pillars, crate
-- stations, the arena rim, the school path). Every other pumpkin gets a warm solid-yellow
-- face, so the ~100 pumpkins on the map don't turn into glowing confetti.
local FACE_GLOW = C(255, 235, 90)
local FACE_SOLID = C(255, 205, 55)

function Props.Pumpkin(parent: Instance, pos: Vector3, d: number, fx: number, fz: number, glow: boolean?): Part
	local center = pos + Vector3.new(0, d * 0.45, 0)
	local body = Kit.Ball(parent, d, center, Kit.Pick(Props.Colors.PumpkinBody), { Shadow = false })
	local base = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Part(parent, Vector3.new(d * 0.12, d * 0.3, d * 0.12), base * CFrame.new(0, d * 0.55, 0) * CFrame.Angles(0, 0, 0.25), C(90, 160, 60))
	local face = if glow then FACE_GLOW else FACE_SOLID
	local faceOpts: Kit.Opts = if glow then { Mat = NEON } else {}
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(-d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.42, d * 0.1, d * 0.1), base * CFrame.new(0, -d * 0.12, -d * 0.45), face, faceOpts)
	return body
end

-- Lollipop tree: trunk + three canopy balls.
function Props.Tree(parent: Instance, pos: Vector3, height: number, canopy: Color3?)
	local col = canopy or Kit.Pick(Props.Colors.Canopy)
	local rng = Kit.Rng
	Kit.Cyl(parent, height, 1.8, CFrame.new(pos + Vector3.new(0, height / 2, 0)), C(120, 75, 50), { Mat = Enum.Material.Wood, Solid = true, Shadow = true })
	local top = pos + Vector3.new(0, height, 0)
	local s = height * 0.55
	Kit.Ball(parent, s, top, col, { Shadow = true })
	Kit.Ball(parent, s * 0.75, top + Vector3.new(rng:NextNumber(-2, 2), s * 0.35, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(1, 1, 1), 0.15))
	Kit.Ball(parent, s * 0.6, top + Vector3.new(rng:NextNumber(-3, 3), -s * 0.2, rng:NextNumber(-3, 3)), col:Lerp(Color3.new(0, 0, 0), 0.12))
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Twisted spooky tree made of crooked segments, bare branches and a few candy-coloured leaf puffs.
function Props.TwistedTree(parent: Instance, pos: Vector3, height: number)
	local rng = Kit.Rng
	local trunk = C(95, 70, 110)
	local pts = { pos }
	local seg = height / 3
	for i = 1, 3 do
		local prev = pts[i]
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1.2, 2.8)
		table.insert(pts, prev + Vector3.new(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 3 do
		local w = 3.2 - i * 0.7
		Props.Beam(parent, pts[i], pts[i + 1], w, w, trunk, { Mat = Enum.Material.Wood, Solid = i == 1, Shadow = true })
	end
	local leaf = { C(170, 90, 255), C(110, 255, 160), C(255, 120, 200) }
	for b = 1, 3 do
		local from = pts[2 + (b % 2)]
		local ang = b * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.22, 0.32)
		local tip = from + Vector3.new(math.cos(ang) * len, len * 0.6, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 0.9, 0.9, trunk, { Mat = Enum.Material.Wood })
		Kit.Ball(parent, rng:NextNumber(3.5, 5.5), tip, Kit.Vivid(Kit.Pick(leaf)), { Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Street lamp: pole, arm and a glowing globe.
-- soft = a frosted, dim globe (no neon) for busy spots like the spawn plaza
function Props.StreetLamp(parent: Instance, pos: Vector3, color: Color3, withLight: boolean, soft: boolean?)
	local pole = C(60, 45, 90)
	local metal: Kit.Opts = { Mat = Enum.Material.Metal }
	Kit.Cyl(parent, 13, 0.8, CFrame.new(pos + Vector3.new(0, 6.5, 0)), pole, metal)
	Kit.Cyl(parent, 0.8, 1.8, CFrame.new(pos + Vector3.new(0, 0.4, 0)), pole, metal)
	Kit.Box(parent, pos + Vector3.new(-0.3, 12.6, -0.3), pos + Vector3.new(0.3, 13.2, 0.3), pole, metal)
	local globe = Kit.Ball(parent, 2.4, pos + Vector3.new(0, 14, 0), if soft then color:Lerp(C(60, 45, 90), 0.35) else color, { Mat = if soft then Enum.Material.Glass else NEON })
	Kit.Cyl(parent, 0.5, 2.8, CFrame.new(pos + Vector3.new(0, 15.3, 0)), pole, metal)
	if withLight then
		Kit.Light(globe, color, if soft then 16 else 22, if soft then 0.7 else 1.6)
	end
end

-- Little post lantern (cemetery paths).
function Props.Lantern(parent: Instance, pos: Vector3, color: Color3, withLight: boolean, flicker: boolean?)
	local iron = C(50, 40, 70)
	Kit.Box(parent, pos + Vector3.new(-0.3, 0, -0.3), pos + Vector3.new(0.3, 7, 0.3), iron, { Mat = Enum.Material.Metal })
	local glow = Kit.Box(parent, pos + Vector3.new(-0.8, 7, -0.8), pos + Vector3.new(0.8, 9, 0.8), color, { Mat = NEON })
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, -0.55)), iron)
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, 0.55)) * CFrame.Angles(0, math.pi, 0), iron)
	if withLight then
		Kit.Light(glow, color, 18, 1.4, flicker)
	end
end

-- Mushroom cluster with bright candy caps.
function Props.Mushrooms(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local caps = { C(120, 255, 200), C(200, 120, 255), C(255, 150, 220), C(120, 220, 255) }
	for _ = 1, rng:NextInteger(2, 3) do
		local p = pos + Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.8, 2)
		Kit.Cyl(parent, h, 0.5, CFrame.new(p + Vector3.new(0, h / 2, 0)), C(245, 240, 225))
		Kit.Ball(parent, rng:NextNumber(1.3, 2), p + Vector3.new(0, h, 0), Kit.Vivid(Kit.Pick(caps)))
	end
end

-- Fence run from a to b (ground points). style: "picket" (crooked white wood) or "iron" (dark
-- metal with mint tips).
function Props.Fence(parent: Instance, a: Vector3, b: Vector3, style: string)
	local rng = Kit.Rng
	local d = b - a
	local len = d.Magnitude
	if len < 1 then
		return
	end
	local dir = d.Unit
	local yaw = math.atan2(-dir.X, -dir.Z) -- local -Z along the run
	local iron = style == "iron"
	local col = if iron then C(55, 45, 80) else C(250, 240, 255)
	local h = if iron then 6 else 3.6
	local mat: Kit.Opts = { Mat = if iron then Enum.Material.Metal else Enum.Material.Wood }
	local step = if iron then 2 else 1.6
	local rails = { h * 0.3, h * 0.75 }
	for _, ry in rails do
		local mid = a + d / 2 + Vector3.new(0, ry, 0)
		Kit.Part(parent, Vector3.new(0.3, 0.3, len), CFrame.new(mid) * CFrame.Angles(0, yaw, 0), col, mat)
	end
	local n = math.floor(len / step)
	for i = 0, n do
		local p = a + dir * (i * step) + Vector3.new(0, h / 2, 0)
		local tilt = if iron then 0 else rng:NextNumber(-0.14, 0.14)
		local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt * 0.3, 0, tilt)
		Kit.Part(parent, Vector3.new(if iron then 0.35 else 0.25, h, if iron then 0.35 else 0.9), cf, col, mat)
		if iron and i % 3 == 0 then
			Kit.Ball(parent, 0.7, p + Vector3.new(0, h / 2 + 0.3, 0), Kit.Vivid(C(120, 255, 170)))
		end
	end
end

-- Low translucent spectral puddle on the ground (solid colour, the fog particles do the
-- glowing); optional slow particle fog.
function Props.Wisp(parent: Instance, pos: Vector3, color: Color3, d: number, emit: boolean)
	local p = Kit.Disc(parent, pos.X, pos.Z, 0.3, d, 0.12, Kit.Vivid(color), { Transp = 0.6 })
	if emit then
		local src = Kit.Part(parent, Vector3.new(d * 0.6, 0.2, d * 0.6), CFrame.new(pos + Vector3.new(0, 1, 0)), color, { Transp = 1, Name = "FogSource" })
		Kit.Emitter(src, color, 1.5, 7, 0.4)
	end
	return p
end

-- Chunky cartoon car. `along` = direction the car faces (unit X/Z vector).
function Props.Car(parent: Instance, pos: Vector3, fx: number, fz: number, color: Color3)
	local m = Kit.Model(parent, "Car")
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	-- body (length along local Z)
	Kit.Part(m, Vector3.new(7.5, 3, 14), base * CFrame.new(0, 2.6, 0), color, { Solid = true, Shadow = true })
	Kit.Part(m, Vector3.new(6.6, 2.8, 7), base * CFrame.new(0, 5.4, 0.8), color:Lerp(Color3.new(1, 1, 1), 0.25), { Solid = true })
	local glass = Kit.Vivid(C(170, 230, 255))
	Kit.Part(m, Vector3.new(5.8, 2, 0.3), base * CFrame.new(0, 5.5, -2.75), glass, { Transp = 0.2, Refl = 0.25 })
	Kit.Part(m, Vector3.new(6.7, 1.8, 5.4), base * CFrame.new(0, 5.5, 0.8), glass, { Transp = 0.3, Refl = 0.25 })
	local axle = if math.abs(fx) > math.abs(fz) then "Z" else "X"
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 1.2, 3.4, (base * CFrame.new(sx * 3.5, 1.7, sz * 4.4)).Position, axle, C(40, 35, 55), { Mat = Enum.Material.Rubber })
		end
		Kit.Part(m, Vector3.new(1.4, 1, 0.3), base * CFrame.new(sx * 2.6, 3, -7.05), C(255, 250, 200), { Mat = NEON })
		-- tail lights: glossy painted red (headlights are the only glow on a car)
		Kit.Part(m, Vector3.new(1.2, 0.8, 0.3), base * CFrame.new(sx * 2.7, 3, 7.05), Kit.Vivid(C(230, 40, 70)), { Refl = 0.3 })
	end
	Kit.AddCircle(pos.X, pos.Z, 8)
end

-- Cute skull (big white ball with black eyes) facing (fx, fz). pos = centre.
function Props.Skull(parent: Instance, pos: Vector3, d: number, fx: number, fz: number)
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(parent, d, pos, C(250, 245, 235))
	Kit.Part(parent, Vector3.new(d * 0.55, d * 0.35, d * 0.5), base * CFrame.new(0, -d * 0.4, -d * 0.1), C(250, 245, 235))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, d * 0.28, (base * CFrame.new(sx * d * 0.18, d * 0.05, -d * 0.38)).Position, C(120, 255, 170), { Mat = NEON })
	end
end

-- Single-part floating book (tagged). pos = centre in the air.
function Props.FloatingBook(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local b = Kit.Part(parent, Vector3.new(1.8, 0.5, 2.4), cf, Kit.Pick(Props.Colors.Book), { Name = "FloatingBook" })
	Kit.Float(b, rng:NextNumber(0.6, 1.2))
end

-- Single-part floating candle (tagged).
function Props.FloatingCandle(parent: Instance, pos: Vector3)
	local c = Kit.Cyl(parent, 1.6, 0.6, CFrame.new(pos), C(255, 230, 160), { Mat = NEON, Name = "FloatingCandle" })
	Kit.Float(c, Kit.Rng:NextNumber(0.5, 1))
end

-- Single-part floating pumpkin (tagged).
function Props.FloatingPumpkin(parent: Instance, pos: Vector3)
	local p = Kit.Ball(parent, 2.4, pos, C(255, 150, 40), { Name = "FloatingPumpkin" })
	Kit.Float(p, Kit.Rng:NextNumber(0.6, 1.1))
end

-- A sign board facing (fx, fz) with text on its Front face.
function Props.SignBoard(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, bg: Color3, fg: Color3, frame: Color3?): Part
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local board = Kit.Part(parent, Vector3.new(w, h, 0.6), cf, bg, { Name = "SignBoard" })
	if frame then
		Kit.Part(parent, Vector3.new(w + 1, h + 1, 0.4), cf * CFrame.new(0, 0, 0.35), Kit.Vivid(frame))
	end
	Kit.Sign(board, Enum.NormalId.Front, text, fg)
	return board
end

-- Graffiti: an invisible thin panel with neon text, flat against a wall, facing (fx, fz).
function Props.Graffiti(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, color: Color3, rot: number?)
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local panel = Kit.Part(parent, Vector3.new(w, h, 0.1), cf, color, { Transp = 1, Name = "Graffiti" })
	Kit.Sign(panel, Enum.NormalId.Front, text, color, { Font = Enum.Font.FredokaOne, Stroke = C(30, 10, 50), Rotation = rot })
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">School</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 3: Haunted School (Z 540..880).
--   Courtyard Z 540..600: path, Elite crate station (built by Stations), ghost bus, flagpole.
--   Building X -100..100, Z 600..860, walls 16 tall, NO roof over the interior (only rim
--   ledges and a few thin beams) so the camera and ghost taps work from above.
--     Front wall Z=600 with a 20-wide entrance under the clock tower (top ~Y 104).
--     Central hallway X -16..16, Z 601..761 (ghost areas at Z 640 and 700).
--     Library   X -99..-18, Z 601..648   | Cafeteria X 18..99, Z 601..648
--     Class 1-A X -99..-18, Z 650..761   | Class 1-B X 18..99, Z 650..761 (ghost areas at X ±62, Z 690)
--     Gym       X -99..99,  Z 763..859 (Headmaster area at Z 805), bleachers along the back wall
--               in two halves either side of the back exit.
--   Doorways: hallway→library/cafeteria 14 wide, hallway→classes 20 wide, library/cafeteria→class
--   14 wide, classes→gym 16 wide, hallway→gym 32 wide, gym→back exit 28 wide (X -14..14, Z 860,
--   12 tall under an "EXIT → CARNIVAL" sign), then a flat path to Gate_Carnival at Z 880.
--   The strips X 105..136 beside the building stay walkable from the courtyard to the back.
--   Palette: warm brick exterior, cream inner walls and trims, school-blue roofs/ledges, purple
--   spectral accents, green ectoplasm. Glow is kept to the front windows, sconces, desk lamps,
--   the bell, slime puddles, bus headlights and the jack-o'-lanterns along the path; bands,
--   rings, lines, frames, trims and side windows are painted.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local School = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local H = 16
local EXT = C(190, 98, 76) -- warm brick
local CREAM = C(245, 232, 205)
local BLUE = C(70, 112, 190) -- school blue
local TRIMC = C(70, 105, 185)
local WHITE = C(255, 250, 245)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }
local BRICK: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }

type Opening = { c: number, w: number, h: number? }

local function sortOpenings(list: { Opening })
	table.sort(list, function(a: Opening, b: Opening)
		return a.c < b.c
	end)
end

-- Wall along X at fixed z (thickness 2), from x1 to x2, with doorway openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = x1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(cur, 0, z - 1), V(a, H, z + 1), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(a, oh, z - 1), V(b, H, z + 1), color, wo)
		end
		cur = b
	end
	if x2 > cur then
		Kit.Box(parent, V(cur, 0, z - 1), V(x2, H, z + 1), color, wo)
	end
end

-- Wall along Z at fixed x (thickness 2), from z1 to z2, with doorway openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = z1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, a), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(x - 1, oh, a), V(x + 1, H, b), color, wo)
		end
		cur = b
	end
	if z2 > cur then
		Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, z2), color, wo)
	end
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, SOLID)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, SOLID)
end

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	-- wall lamp on a wall whose inner face is at pos.X - fx * 0.5
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), C(60, 40, 90))
	Kit.Light(lamp, color, 24, 1.6, true)
end

--==================================================================
-- SHELL
--==================================================================
local function shell(f: Instance)
	-- floors (top Y 0.15)
	Kit.Box(f, V(-101, -0.5, 599), V(101, 0.1, 861), C(110, 90, 150), { Solid = true, Name = "SchoolFloor" })
	local tiles = { C(240, 230, 210), C(95, 135, 205) }
	for i = 0, 3 do
		for j = 0, 19 do
			local x0, z0 = -16 + i * 8, 601 + j * 8
			Kit.Box(f, V(x0, 0.05, z0), V(x0 + 8, 0.15, z0 + 8), tiles[((i + j) % 2) + 1], { Solid = true })
		end
	end
	Kit.Box(f, V(-99, 0.05, 601), V(-18, 0.15, 648), C(190, 130, 90), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 601), V(99, 0.15, 648), C(255, 225, 175), { Solid = true })
	Kit.Box(f, V(-99, 0.05, 650), V(-18, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 650), V(99, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(-99, 0.05, 763), V(99, 0.15, 859), C(235, 160, 90), { Mat = Enum.Material.WoodPlanks, Solid = true, Name = "GymFloor" })

	-- exterior walls
	wallX(f, 600, -101, 101, EXT, { { c = 0, w = 20 } }, BRICK)
	-- back exit out of the gym toward Gate_Carnival (X -14..14, 12 tall)
	wallX(f, 860, -101, 101, EXT, { { c = 0, w = 28, h = 12 } }, BRICK)
	wallZ(f, -100, 601, 859, EXT, {}, BRICK)
	wallZ(f, 100, 601, 859, EXT, {}, BRICK)
	-- hallway walls
	local hall = CREAM
	wallZ(f, -17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	wallZ(f, 17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	-- front rooms / classrooms divider and the gym wall
	local inner = C(120, 160, 215)
	wallX(f, 649, -99, -18, inner, { { c = -60, w = 14, h = 12 } })
	wallX(f, 649, 18, 99, inner, { { c = 60, w = 14, h = 12 } })
	wallX(f, 762, -99, 99, C(235, 215, 180), { { c = 0, w = 32 }, { c = -60, w = 16, h = 13 }, { c = 60, w = 16, h = 13 } })

	-- parapet on the exterior walls + partial roof ledges (no roof over the interior)
	local rim: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true, Shadow = true }
	Kit.Box(f, V(-102, H, 598), V(102, H + 2, 602), CREAM, rim)
	Kit.Box(f, V(-102, H, 858), V(102, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(-102, H, 598), V(-98, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(98, H, 598), V(102, H + 2, 862), CREAM, rim)
	local ledge = BLUE
	Kit.Box(f, V(-98, H + 0.5, 602), V(98, H + 1.5, 607), ledge)
	Kit.Box(f, V(-98, H + 0.5, 853), V(98, H + 1.5, 858), ledge)
	Kit.Box(f, V(-98, H + 0.5, 602), V(-93, H + 1.5, 858), ledge)
	Kit.Box(f, V(93, H + 0.5, 602), V(98, H + 1.5, 858), ledge)
	-- sloped eaves on the outside
	local eave = C(55, 85, 150)
	local eaveOpts: Kit.Opts = { Mat = Enum.Material.Slate, Shadow = true }
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 596), 0, -1), eave, eaveOpts)
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 864), 0, 1), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(-104, H + 0.5, 730), -1, 0), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(104, H + 0.5, 730), 1, 0), eave, eaveOpts)
	-- painted band along the front
	Kit.Box(f, V(-101.2, 14, 598.7), V(101.2, 14.6, 598.9), Kit.Vivid(C(150, 255, 140)))

	-- corner turrets
	local turretRing, turretTop = Kit.Vivid(C(200, 130, 255)), Kit.Vivid(C(150, 255, 140))
	for _, x in { -100, 100 } do
		for _, z in { 600, 860 } do
			Kit.Cyl(f, 24, 10, CFrame.new(x, 12, z), EXT:Lerp(C(255, 255, 255), 0.08), BRICK)
			Kit.Cyl(f, 1, 10.6, CFrame.new(x, 14.3, z), turretRing)
			Kit.Cyl(f, 2, 11.5, CFrame.new(x, 25, z), CREAM, { Mat = Enum.Material.Concrete })
			Kit.Cyl(f, 3, 8, CFrame.new(x, 27.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Cyl(f, 3, 4.5, CFrame.new(x, 30.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Ball(f, 2.6, V(x, 33, z), turretTop)
		end
	end

	-- facade windows glow (ghostly); side windows are warm painted glass
	for _, x in { -88, -70, -50, -30, 30, 50, 70, 88 } do
		Kit.Box(f, V(x - 3, 4.5, 598.75), V(x + 3, 12.5, 599), WHITE)
		Kit.Box(f, V(x - 2.4, 5, 598.6), V(x + 2.4, 12, 598.85), Kit.Pick({ C(255, 230, 120), C(150, 255, 140), C(210, 150, 255) }), { Mat = NEON })
	end
	for _, s in { -1, 1 } do
		for _, z in { 625, 690, 735, 790, 830 } do
			Kit.Box(f, V(s * 101, 4.5, z - 3), V(s * 101.25, 12.5, z + 3), WHITE)
			Kit.Box(f, V(s * 101.15, 5, z - 2.4), V(s * 101.4, 12, z + 2.4), Kit.Vivid(Kit.Pick({ C(255, 225, 130), C(160, 235, 150), C(200, 160, 245) })), { Refl = 0.2 })
		end
	end
	-- entrance steps
	Kit.Box(f, V(-12, 0, 592), V(12, 0.5, 599), C(200, 190, 220), { Mat = Enum.Material.Slate, Solid = true })
end

--==================================================================
-- CLOCK TOWER (over the entrance)
--==================================================================
local function clockTower(f: Instance)
	local body = EXT:Lerp(C(0, 0, 0), 0.05)
	local mint, orange = Kit.Vivid(C(150, 255, 140)), Kit.Vivid(C(255, 160, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, 594), V(s * 14, 22, 606), body, BRICK)
		Kit.Box(f, V(s * 9.8, 0, 593.8), V(s * 10.3, 22, 594.3), mint)
	end
	Kit.Box(f, V(-14, 22, 594), V(14, 62, 606), body, { Mat = Enum.Material.Brick, Solid = true, Shadow = true, Name = "ClockTower" })
	Kit.Box(f, V(-14.3, 22, 593.7), V(14.3, 23, 606.3), mint)
	Kit.Box(f, V(-14.3, 61, 593.7), V(14.3, 62, 606.3), orange)
	-- SPOOKY HIGH sign
	local sign = Kit.Part(f, V(26, 6, 0.6), CFrame.new(0, 26.5, 593.6), C(45, 25, 80))
	Kit.Part(f, V(27.5, 7.5, 0.3), CFrame.new(0, 26.5, 593.85), orange)
	Kit.Sign(sign, Enum.NormalId.Front, "SPOOKY HIGH", C(255, 200, 80))
	-- clock (11:55, almost midnight)
	Kit.CylFlat(f, 0.5, 17.5, V(0, 44, 593.75), "Z", Kit.Vivid(C(200, 120, 255)))
	Kit.CylFlat(f, 0.6, 16, V(0, 44, 593.4), "Z", C(255, 245, 225))
	local function hand(len: number, w: number, angle: number, z: number, color: Color3)
		Kit.Part(f, V(w, len, 0.25), CFrame.new(0, 44, z) * CFrame.Angles(0, 0, angle) * CFrame.new(0, len / 2, 0), color)
	end
	hand(5, 1, -0.05, 593.0, C(60, 30, 90))
	hand(7, 0.7, -0.52, 592.9, C(130, 60, 200))
	Kit.Ball(f, 1.2, V(0, 44, 592.9), orange)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Part(f, V(0.8, 1.6, 0.3), CFrame.new(math.sin(a) * 6.5, 44 + math.cos(a) * 6.5, 593.0) * CFrame.Angles(0, 0, -a), C(130, 60, 200))
	end
	-- bell loft
	for _, x in { -12.5, 12.5 } do
		for _, z in { 595.5, 604.5 } do
			Kit.Box(f, V(x - 1.5, 62, z - 1.5), V(x + 1.5, 74, z + 1.5), CREAM, { Mat = Enum.Material.Concrete, Solid = true, Shadow = true })
		end
	end
	local bell = Kit.Ball(f, 7, V(0, 68, 600), C(255, 200, 70))
	Kit.Ball(f, 3, V(0, 64.8, 600), C(150, 255, 140), { Mat = NEON })
	Kit.Light(bell, C(170, 255, 160), 30, 1.4)
	Kit.Box(f, V(-15.5, 74, 592.5), V(15.5, 76, 607.5), TRIMC, SOLID)
	gable(f, CFrame.new(0, 76, 600), 31, 15, 14, C(55, 85, 150))
	Kit.Cyl(f, 12, 1.2, CFrame.new(0, 96, 600), C(240, 220, 120))
	Kit.Ball(f, 3.2, V(0, 103, 600), Kit.Vivid(C(200, 120, 255)))
end

--==================================================================
-- HALLWAY
--==================================================================
local function hallway(f: Instance)
	local lockerCols = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	local runs = { { 606, 616 }, { 632, 679 }, { 701, 760 } }
	local slimed = Kit.Vivid(C(140, 255, 150))
	local n = 0
	for _, s in { -1, 1 } do
		for _, r in runs do
			local z0 = r[1]
			while z0 + 3 <= r[2] do
				n += 1
				Kit.Box(f, V(s * 16, 0.15, z0), V(s * 14.5, 8.5, z0 + 3), lockerCols[(n % #lockerCols) + 1], { Mat = Enum.Material.Metal, Solid = true })
				if n % 7 == 0 then
					Kit.Box(f, V(s * 14.5, 1, z0 + 0.4), V(s * 14.35, 8, z0 + 2.6), slimed) -- slimed locker door
				end
				z0 += 3.2
			end
			Kit.Box(f, V(s * 16, 8.5, r[1]), V(s * 14.3, 9, r[2]), C(120, 70, 190))
		end
	end
	-- painted guide lines on the floor (flat)
	local guide = Kit.Vivid(C(200, 130, 255))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 7 - 0.25, 0.15, 603), V(s * 7 + 0.25, 0.2, 760), guide)
	end
	-- thin beams overhead (Y 16..17.5), clear of the ghost areas' height
	for _, z in { 615, 670, 732, 758 } do
		Kit.Box(f, V(-18, H, z - 0.75), V(18, H + 1.5, z + 0.75), C(120, 80, 60), { Mat = Enum.Material.WoodPlanks })
	end
	local gymSign = Kit.Part(f, V(14, 3, 0.4), CFrame.new(0, 13.6, 758), C(45, 25, 80))
	Kit.Sign(gymSign, Enum.NormalId.Front, "🏀 GYM 🏀", C(255, 190, 80))
	for _, x in { -5, 5 } do
		Kit.Box(f, V(x - 0.1, 15.1, 757.9), V(x + 0.1, H, 758.1), C(60, 50, 70))
	end
	-- flickering sconces
	for _, z in { 612, 668, 722 } do
		sconce(f, V(-15.6, 12.4, z), 1, C(255, 230, 140))
	end
	for _, z in { 640, 712, 750 } do
		sconce(f, V(15.6, 12.4, z), -1, C(200, 150, 255))
	end
	-- door signs
	Props.SignBoard(f, V(-15.6, 14, 624), 12, 2.8, 1, 0, "📚 LIBRARY", C(45, 25, 80), C(255, 220, 120))
	Props.SignBoard(f, V(15.6, 14, 624), 12, 2.8, -1, 0, "🍕 CAFETERIA", C(45, 25, 80), C(150, 255, 140))
	Props.SignBoard(f, V(-15.6, 14.5, 690), 14, 2.6, 1, 0, "CLASS 1-A", C(45, 25, 80), C(255, 170, 220))
	Props.SignBoard(f, V(15.6, 14.5, 690), 14, 2.6, -1, 0, "CLASS 1-B", C(45, 25, 80), C(120, 220, 255))
	-- ghostly graffiti
	Props.Graffiti(f, V(-15.9, 12.3, 650), 10, 5, 1, 0, "BOO!", C(150, 255, 140), -6)
	Props.Graffiti(f, V(15.9, 12.3, 655), 14, 5, -1, 0, "NO RUNNING\n(FLOATING OK)", C(255, 150, 220), 4)
	Props.Graffiti(f, V(-15.9, 12.3, 740), 14, 5, 1, 0, "GHOSTS RULE", C(200, 140, 255), -3)
	Props.Graffiti(f, V(15.9, 12.3, 728), 12, 5, -1, 0, "HALL PASS?\nNAH.", C(120, 230, 255), 5)
	-- slime puddles (flat)
	local slime = Kit.Disc(f, -4, 662, 0.22, 6, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
	Kit.Emitter(slime, C(150, 255, 160), 1.5, 3, 0.4)
	Kit.Disc(f, 6, 721, 0.22, 4, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- LIBRARY + CAFETERIA
--==================================================================
local function shelf(f: Instance, a: Vector3, b: Vector3, faceAxis: string, faceSign: number)
	Kit.Box(f, a, b, C(120, 75, 55), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	for i = 0, 2 do
		local y = 1.4 + i * 3.1
		local col = Kit.Pick(Props.Colors.Book)
		if faceAxis == "X" then
			local x = if faceSign > 0 then hi.X else lo.X
			Kit.Box(f, V(x, y, lo.Z + 0.4), V(x + faceSign * 0.3, y + 2.3, hi.Z - 0.4), col)
		else
			local z = if faceSign > 0 then hi.Z else lo.Z
			Kit.Box(f, V(lo.X + 0.4, y, z), V(hi.X - 0.4, y + 2.3, z + faceSign * 0.3), col)
		end
	end
end

local function library(f: Instance)
	for z = 607, 638, 8.5 do
		shelf(f, V(-99, 0.15, z), V(-96, 11, z + 8), "X", 1)
	end
	for x = -93, -30, 9 do
		shelf(f, V(x, 0.15, 601), V(x + 8, 11, 604), "Z", 1)
	end
	for _, x in { -70, -45 } do
		Kit.Box(f, V(x - 6, 3, 621), V(x + 6, 3.6, 631), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
		Kit.Box(f, V(x - 1, 0.15, 624), V(x + 1, 3, 628), C(110, 70, 50))
		Kit.Cyl(f, 1.6, 0.3, CFrame.new(x + 3, 4.4, 626), C(70, 60, 80))
		Kit.Ball(f, 1.3, V(x + 3, 5.4, 626), C(150, 255, 140), { Mat = NEON })
	end
	local rng = Kit.Rng
	for _ = 1, 7 do
		Props.FloatingBook(f, V(rng:NextNumber(-90, -26), rng:NextNumber(6, 11), rng:NextNumber(608, 644)))
	end
	Props.Graffiti(f, V(-82, 11, 647.9), 16, 5, 0, -1, "SHHH!\nGHOSTS READING", C(150, 255, 140), -3)
end

local function cafeteria(f: Instance)
	-- counter + sneeze guard + menu
	Kit.Box(f, V(90, 0.15, 607), V(96, 4, 643), C(205, 205, 225), { Solid = true })
	local pans = { C(130, 255, 140), C(255, 160, 60), C(200, 120, 255), C(255, 110, 140) }
	for i = 0, 3 do
		Kit.Box(f, V(91, 4, 609 + i * 8.5), V(95, 4.5, 615 + i * 8.5), Kit.Vivid(pans[i + 1]))
	end
	Kit.Box(f, V(89.8, 4, 607), V(90.2, 7, 643), C(200, 240, 255), { Transp = 0.6 })
	local menuCF = faced(V(98.7, 11, 625), -1, 0)
	local menu = Kit.Part(f, V(26, 6, 0.4), menuCF, C(40, 30, 60))
	Kit.Part(f, V(27, 7, 0.2), menuCF * CFrame.new(0, 0, 0.3), Kit.Vivid(C(255, 160, 60)))
	Kit.Sign(menu, Enum.NormalId.Front, "TODAY: ECTO-LOAF\n& SCREAM PIE", C(150, 255, 140))
	-- long tables with benches and trays
	local trays = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	for _, x in { 35, 55, 75 } do
		Kit.Box(f, V(x - 2.5, 3, 610), V(x + 2.5, 3.6, 640), C(240, 240, 250), { Solid = true })
		Kit.Box(f, V(x - 0.5, 0.15, 612), V(x + 0.5, 3, 638), C(130, 130, 160))
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 3.6, 0.15, 611), V(x + s * 5, 2, 639), C(170, 110, 230), { Solid = true })
		end
		for i = 0, 3 do
			local s = if i % 2 == 0 then -1 else 1
			local tz = 614 + i * 7
			Kit.Box(f, V(x + s * 0.3, 3.6, tz - 0.8), V(x + s * 2.2, 3.85, tz + 0.8), trays[i + 1])
			Kit.Ball(f, 0.9, V(x + s * 1.25, 4.2, tz), Kit.Vivid(Kit.Pick(pans)))
		end
	end
	Props.Graffiti(f, V(35, 11, 647.9), 16, 5, 0, -1, "FOOD FIGHT\nAT MIDNIGHT", C(255, 170, 220), 4)
	Props.FloatingPumpkin(f, V(45, 10, 628))
end

--==================================================================
-- CLASSROOMS
--==================================================================
local function classroom(f: Instance, side: number, title: string, graffiti: string)
	-- side = -1 (west, Class 1-A) or +1 (east, Class 1-B); board on the outer wall
	local gx, gz, gr = side * 62, 690, 20
	local boardCF = faced(V(side * 98.7, 8.5, 705), -side, 0)
	local board = Kit.Part(f, V(30, 8, 0.4), boardCF, C(40, 95, 75))
	Kit.Part(f, V(31.6, 9.6, 0.3), boardCF * CFrame.new(0, 0, 0.3), C(150, 100, 60), { Mat = Enum.Material.WoodPlanks })
	Kit.Sign(board, Enum.NormalId.Front, title, C(235, 255, 235), { Stroke = C(30, 70, 55), Font = Enum.Font.FredokaOne })
	-- teacher's desk + apple
	local tx = side * 90.5
	Kit.Box(f, V(tx - 2.5, 0.15, 698), V(tx + 2.5, 3.6, 710), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Ball(f, 1.2, V(tx, 4.2, 702), C(255, 70, 80))
	-- student desks (facing the board), kept out of the ghost circle and doorways
	local desk, chair = C(255, 210, 120), C(130, 90, 220)
	for ax = 91, 31, -12 do
		local x = side * ax
		for z = 656, 752, 12 do
			local dx, dz = x - gx, z - gz
			local inCircle = dx * dx + dz * dz < (gr + 4) * (gr + 4)
			local teacher = ax >= 85 and z >= 690 and z <= 716
			local gymDoor = z >= 736 and math.abs(ax - 60) < 9
			local divDoor = z <= 660 and math.abs(ax - 60) < 9
			local hallDoor = ax <= 31 and z >= 672 and z <= 708
			if not (inCircle or teacher or gymDoor or divDoor or hallDoor) then
				local back = side -- chairs sit on the side away from the board
				Kit.Box(f, V(x - 1.5, 3, z - 1.4), V(x + 1.5, 3.4, z + 1.4), desk, { Solid = true })
				Kit.Box(f, V(x + side * 1.5, 0.15, z - 1.2), V(x + side * 1.1, 3, z + 1.2), desk:Lerp(C(0, 0, 0), 0.2))
				Kit.Box(f, V(x - back * 2, 1.8, z - 1.1), V(x - back * 4.2, 2.1, z + 1.1), chair)
				Kit.Box(f, V(x - back * 4, 0.15, z - 1.1), V(x - back * 4.3, 4.4, z + 1.1), chair)
			end
		end
	end
	-- floating books near the back of the room
	local rng = Kit.Rng
	for i = 0, 3 do
		Props.FloatingBook(f, V(side * (36 + i * 14), rng:NextNumber(9, 12), 745 + rng:NextNumber(-4, 6)))
	end
	sconce(f, V(side * 98.4, 12.4, 740), -side, C(150, 255, 160))
	Props.Graffiti(f, V(side * 85, 11, 760.9), 18, 5, 0, -1, graffiti, C(200, 140, 255), side * 4)
	Kit.Disc(f, side * 40, 735, 0.22, 5, 0.08, C(200, 130, 255), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- GYM
--==================================================================
local function gym(f: Instance)
	-- court lines (white paint) and the purple centre circle
	local line = C(255, 250, 240)
	Kit.Box(f, V(-0.3, 0.15, 765), V(0.3, 0.2, 857), line)
	for _, x in { -92, 92 } do
		Kit.Box(f, V(x - 0.3, 0.15, 768), V(x + 0.3, 0.2, 840), line)
	end
	for _, z in { 768, 840 } do
		Kit.Box(f, V(-92, 0.15, z - 0.3), V(92, 0.2, z + 0.3), line)
	end
	local circle = Kit.Vivid(C(200, 130, 255))
	for i = 0, 15 do
		local a = (i + 0.5) / 16 * math.pi * 2
		local p = V(math.cos(a) * 10, 0.17, 805 + math.sin(a) * 10)
		Kit.Part(f, V(0.6, 0.06, 4.4), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), circle)
	end
	-- hoops on the side walls
	local hoop = Kit.Vivid(C(255, 120, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 97.4, 9.5, 800.5), V(s * 97.9, 14.5, 809.5), WHITE)
		Kit.Box(f, V(s * 97.3, 10.6, 803.5), V(s * 97.4, 13, 806.5), hoop)
		Kit.Box(f, V(s * 97.9, 11.4, 804.6), V(s * 99, 12.2, 805.4), C(80, 80, 100))
		Kit.Disc(f, s * 95.4, 805, 10.3, 3.6, 0.3, hoop)
		Kit.Cyl(f, 2, 3.2, CFrame.new(s * 95.4, 9.1, 805), WHITE, { Transp = 0.5 })
	end
	-- bleachers along the back wall, split either side of the back exit (X -15..15 open)
	local cols = { C(95, 135, 205), C(235, 150, 70), C(240, 225, 195), C(150, 100, 220) }
	for i = 0, 3 do
		for _, s in { -1, 1 } do
			-- rows overlap (each reaches the back): inset hidden faces per row against z-fighting
			local d = i * 0.03
			Kit.Box(f, V(s * (15 + d), 0.15 + d, 842 + i * 4), V(s * (60 - d), 1.6 * (i + 1) + 0.15, 859 - d), cols[i + 1], { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		end
	end
	for k, px in { -50, -36, -22, 22, 36, 50 } do
		local i = (k - 1) % 4
		Props.Pumpkin(f, V(px, 1.6 * (i + 1) + 0.15, 844 + i * 4), 2.6, 0, -1)
	end
	-- back exit: cream door frame, EXIT sign on the lintel, path to Gate_Carnival
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 14 - 0.6, 0, 858.6), V(s * 14 + 0.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	end
	Kit.Box(f, V(-14.6, 12, 858.6), V(14.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	local exitSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 858.7), C(30, 60, 45))
	Kit.Part(f, V(25, 3.6, 0.2), CFrame.new(0, 14.2, 858.95), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(exitSign, Enum.NormalId.Front, "EXIT → CARNIVAL 🎡", C(170, 255, 160), { Stroke = C(20, 50, 30) })
	local backSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 861.3) * CFrame.Angles(0, math.pi, 0), C(30, 60, 45))
	Kit.Sign(backSign, Enum.NormalId.Front, "SPOOKY HIGH 🏫", C(255, 220, 120), { Stroke = C(20, 50, 30) })
	Kit.Box(f, V(-12, 0, 861), V(12, 0.05, 877), C(175, 165, 190), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "ExitPath" })
	local guide = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12 - 0.3, 0.05, 862), V(s * 12 + 0.3, 0.1, 876), guide)
	end
	Props.Pumpkin(f, V(-15.5, 0, 865), 2.6, 1, 0)
	Props.Pumpkin(f, V(15.5, 0, 865), 2.6, -1, 0)
	-- scoreboard (on the back wall over the west bleachers)
	local sbCF = CFrame.new(-40, 12.5, 858.5)
	local sb = Kit.Part(f, V(26, 6, 0.6), sbCF, C(30, 20, 50))
	Kit.Part(f, V(27.4, 7.4, 0.3), sbCF * CFrame.new(0, 0, 0.35), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sb, Enum.NormalId.Front, "HOME 0  •  GHOSTS 999", C(255, 210, 80), { Font = Enum.Font.GothamBlack })
	-- banners
	Props.SignBoard(f, V(-98.6, 10, 780), 14, 5, 1, 0, "GO GHOULS!", C(130, 70, 220), C(255, 220, 90))
	Props.SignBoard(f, V(-98.6, 10, 830), 14, 5, 1, 0, "TEAM SPIRIT\n(LITERALLY)", C(255, 120, 60), WHITE)
	Props.SignBoard(f, V(98.6, 10, 780), 14, 5, -1, 0, "SPIRIT WEEK", C(60, 170, 150), WHITE)
	Props.SignBoard(f, V(98.6, 10, 830), 14, 5, -1, 0, "BOO CREW", C(220, 70, 140), C(255, 230, 120))
	Props.Graffiti(f, V(-80, 11, 763.1), 18, 5, 0, 1, "DETENTION\nFOREVER", C(150, 255, 140), -4)
	sconce(f, V(-98.4, 13.5, 792), 1, C(255, 200, 120))
	sconce(f, V(98.4, 13.5, 818), -1, C(255, 200, 120))
	Props.FloatingPumpkin(f, V(-30, 13, 850))
	Props.FloatingPumpkin(f, V(30, 13, 850))
end

--==================================================================
-- COURTYARD
--==================================================================
local function courtyard(f: Instance)
	Kit.Box(f, V(-10, -0.4, 540), V(10, 0.1, 592), C(190, 175, 215), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.AddRect(-12, 540, 12, 600, true)
	Kit.AddRect(-104, 592, 104, 864)
	Kit.AddRect(-18, 860, 18, 880, true) -- back exit path to Gate_Carnival
	-- ghost bus
	local yellow = C(255, 205, 50)
	Kit.Box(f, V(55, 1.5, 566), V(85, 10.5, 578), yellow, SOLID)
	Kit.Box(f, V(55.5, 10.5, 566.5), V(84.5, 11.3, 577.5), C(255, 225, 120))
	Kit.Box(f, V(54.9, 5.5, 565.9), V(85.1, 6.1, 578.1), C(40, 30, 50))
	-- windows: warm pale yellow sides, glassy windshield (solid; too long to glow nicely)
	for _, z in { 565.8, 578.0 } do
		Kit.Box(f, V(58, 6.8, z), V(82, 9.6, z + 0.2), C(255, 240, 160), { Refl = 0.15 })
	end
	Kit.Box(f, V(54.8, 6.5, 567), V(55, 9.8, 577), Kit.Vivid(C(170, 230, 255)), { Transp = 0.2, Refl = 0.25 })
	for _, x in { 60, 80 } do
		for _, z in { 565.6, 578.4 } do
			Kit.CylFlat(f, 1.4, 4, V(x, 2, z), "Z", C(40, 35, 55))
		end
	end
	for _, z in { 568, 576 } do
		Kit.Box(f, V(54.7, 3, z - 0.8), V(54.9, 4.2, z + 0.8), C(255, 250, 200), { Mat = NEON })
	end
	local busSign = Kit.Box(f, V(62, 2.2, 565.6), V(78, 5.2, 565.9), yellow)
	Kit.Sign(busSign, Enum.NormalId.Front, "SPOOKY HIGH 👻", C(60, 30, 90), { Stroke = C(255, 255, 255) })
	Kit.AddCircle(70, 572, 17)
	-- flagpole
	Kit.Cyl(f, 26, 0.6, CFrame.new(28, 13, 590), C(220, 220, 235))
	Kit.Ball(f, 1.2, V(28, 26.4, 590), C(255, 210, 80), { Refl = 0.3 })
	local flag = Kit.Box(f, V(28.3, 20, 589.9), V(37, 25, 590.1), C(150, 80, 230))
	Kit.Sign(flag, Enum.NormalId.Front, "👻", WHITE)
	Kit.AddCircle(28, 590, 2)
	-- jack-o'-lanterns lining the path
	for z = 548, 590, 14 do
		for _, s in { -1, 1 } do
			Props.Pumpkin(f, V(s * 12.5, 0, z), 2.8, -s, 0, true)
		end
	end
	-- trees (courtyard and the strips around the building)
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(546, 874)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	local lampGlobe = C(210, 150, 255)
	Props.StreetLamp(f, V(-15, 0, 594), lampGlobe, true)
	Props.StreetLamp(f, V(15, 0, 594), lampGlobe, false)
end

function School.Build(map: Instance)
	local f = Kit.Folder(map, "School")
	courtyard(f)
	shell(f)
	clockTower(f)
	hallway(f)
	library(f)
	cafeteria(f)
	classroom(f, -1, "GHOST 101\nBOO = HELLO 👋", "NO HOMEWORK\nONLY HAUNTWORK")
	classroom(f, 1, "BOO-OLOGY\nCHAPTER 13 🕸️", "A+ IN\nSCARING")
	gym(f)
end

return School
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">SpiritRealm</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 8: Spirit Realm (Z 2280..2680), the endgame: "you have entered another dimension".
--   Play area (|X| <= 140): a dark translucent "void glass" floor (top Y = 0, no holes) with
--   flat-topped floating islands of dark slate (tops Y 0.04..0.06) sunk into it; their glowing
--   lips and rocky undersides show through the glass, with stars and nebula far below.
--   Rune path along X = 0 (flat, top 0.08) from the gate to the portal platform at the back.
--   Ghost areas (0,2365) r30, (-82,2400) r24, (75,2470) r26, (-62,2530) r24 and the boss
--   SPIRIT OVERLORD at (0,2605) r28 hold only flat paint; nothing stands in or hangs above them.
--   Side walls: crystal-capped rock ridges at X +-140..146 (Z 2283..2677).
--   Back (Z 2645..2677): a huge portal arch the path walks through; it frames the Swamp gate.
--   Outside the walls: open void with floating islands, spirit trees, crystals, waterfalls
--   pouring into nothing, broken bridges, distant islands, cloud banks and a ringed planet.
--   Glow: island lips, path edge runes, wall crystal tips, a few crystals, tree spirit-orbs,
--   portal runes and stars. Rock, ruins, trunks and most crystals are solid/glass.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local SpiritRealm = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local ROCK = Enum.Material.Rock
local SLATE = Enum.Material.Slate
local GLASS = Enum.Material.Glass
local WOOD = Enum.Material.Wood

local Z0, Z1 = 2280, 2680
local W = 146 -- outer face of the side walls

local ROCKS = { C(44, 38, 70), C(36, 34, 60), C(52, 44, 82), C(32, 36, 58) }
local LIPS = { C(150, 100, 255), C(80, 210, 255), C(110, 240, 190), C(120, 140, 255) }
local CRYSTAL = { C(160, 110, 255), C(90, 200, 255), C(120, 235, 200), C(195, 140, 255) }
local LEAVES = { C(80, 210, 255), C(160, 105, 255), C(110, 240, 200), C(130, 150, 255) }
local RUIN = C(82, 76, 112)
local RUIN_DARK = C(56, 50, 84)
local BARK = C(34, 28, 46)
local BLACK = C(0, 0, 0)

local function clearOfGhosts(x: number, z: number, r: number): boolean
	for _, a in Config.Layout.GhostAreas do
		local dx, dz = x - a.Center.X, z - a.Center.Z
		local rr = a.Radius + r
		if dx * dx + dz * dz < rr * rr then
			return false
		end
	end
	return true
end

--==================================================================
-- PIECES
--==================================================================

-- Floating island: flat slate top at topY, a glowing lip just under the top edge and a
-- rocky underside tapering into the void.
local function island(f: Instance, x: number, z: number, topY: number, d: number, solid: boolean, lip: boolean): Part
	local rock = Kit.Pick(ROCKS)
	local top = Kit.Disc(f, x, z, topY, d, 3, rock, { Mat = SLATE, Solid = solid, Shadow = true })
	if lip then
		Kit.Disc(f, x, z, topY - 0.5, d + 1.6, 0.8, Kit.Pick(LIPS), { Mat = NEON })
	end
	local under = rock:Lerp(BLACK, 0.2)
	Kit.Disc(f, x, z, topY - 3, d * 0.84, 5, under, { Mat = ROCK })
	Kit.Disc(f, x + d * 0.04, z, topY - 8, d * 0.58, 7, under:Lerp(BLACK, 0.2), { Mat = ROCK })
	Kit.Disc(f, x - d * 0.03, z + d * 0.03, topY - 15, d * 0.3, 9, under:Lerp(BLACK, 0.35), { Mat = ROCK })
	Kit.Ball(f, d * 0.17, V(x, topY - 23, z), under:Lerp(BLACK, 0.45), { Mat = ROCK })
	return top
end

-- Crystal prism with a diamond tip, leaning by (tiltX, tiltZ). Neon only when asked;
-- otherwise translucent glass in a vivid colour.
local function shard(parent: Instance, base: Vector3, h: number, w: number, tiltX: number, tiltZ: number, color: Color3, neon: boolean): Part
	local cf = CFrame.new(base) * CFrame.Angles(tiltX, 0, tiltZ) * CFrame.Angles(0, Kit.Rng:NextNumber(0, math.pi), 0)
	local opts: Kit.Opts = if neon then { Mat = NEON } else { Mat = GLASS, Transp = 0.2, Refl = 0.2 }
	local col = if neon then color else Kit.Vivid(color)
	local body = Kit.Part(parent, V(w, h, w), cf * CFrame.new(0, h / 2, 0), col, opts)
	Kit.Part(parent, V(w * 0.72, w * 0.72, w * 0.72), cf * CFrame.new(0, h, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), col, opts)
	return body
end

-- Cluster of crystals on a dark rock base; returns the big central crystal.
local function crystalCluster(parent: Instance, pos: Vector3, scale: number, neonMain: boolean): Part
	local rng = Kit.Rng
	local col = Kit.Pick(CRYSTAL)
	Kit.Part(parent, V(5, 2.2, 4.4) * scale, CFrame.new(pos + V(0, 0.5 * scale, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0.12), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
	local main = shard(parent, pos, 12 * scale, 2.6 * scale, rng:NextNumber(-0.1, 0.1), rng:NextNumber(-0.1, 0.1), col, neonMain)
	for k = 1, 3 do
		local a = k * 2.1 + rng:NextNumber(-0.3, 0.3)
		local t = rng:NextNumber(0.25, 0.45)
		local p = pos + V(math.cos(a), 0, math.sin(a)) * (1.7 * scale)
		shard(parent, p, rng:NextNumber(4.5, 8) * scale, rng:NextNumber(1.2, 1.8) * scale, math.sin(a) * t, -math.cos(a) * t, Kit.Pick(CRYSTAL), false)
	end
	return main
end

-- Enormous spirit tree: twisted dark trunk, roots, four branches with glowing leaf clusters
-- (solid translucent colour) and one small Neon spirit-orb. Returns the orb.
local function spiritTree(parent: Instance, pos: Vector3, height: number): Part
	local rng = Kit.Rng
	local pts = { pos }
	local seg = height / 4
	for i = 1, 4 do
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1, 2.5)
		table.insert(pts, pts[i] + V(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 4 do
		local w = 4.6 - i * 0.85
		Props.Beam(parent, pts[i], pts[i + 1], w, w, BARK, { Mat = WOOD, Solid = i == 1, Shadow = true })
	end
	for r = 0, 2 do
		local a = r * 2.1 + rng:NextNumber(-0.3, 0.3)
		Props.Beam(parent, pos + V(0, 2.6, 0), pos + V(math.cos(a) * 5.5, -0.3, math.sin(a) * 5.5), 1.4, 1.4, BARK, { Mat = WOOD })
	end
	local s = height / 40
	local top = pts[5]
	local crown = Kit.Pick(LEAVES)
	Kit.Ball(parent, 12 * s, top + V(0, 1.5, 0), Kit.Vivid(crown), { Transp = 0.12, Shadow = true })
	for b = 1, 4 do
		local from = pts[3 + (b % 2)]
		local ang = b * 1.57 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.2, 0.28)
		local tip = from + V(math.cos(ang) * len, len * 0.5, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 1.2, 1.2, BARK, { Mat = WOOD })
		Kit.Ball(parent, rng:NextNumber(7, 9.5) * s, tip, Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.15 })
	end
	local orb = Kit.Ball(parent, 3.2 * s, top + V(0, -4.5 * s, 0), crown:Lerp(C(255, 255, 255), 0.3), { Mat = NEON })
	return orb
end

-- Falling water pouring off an edge into the void: a translucent sheet facing X plus a paler
-- core streak and a misty lip.
local function waterfall(parent: Instance, top: Vector3, width: number, len: number, mist: boolean)
	local cf = CFrame.new(top - V(0, len / 2, 0))
	Kit.Part(parent, V(1.2, len, width), cf, C(110, 180, 255), { Mat = GLASS, Transp = 0.45, Refl = 0.1, Name = "Waterfall" })
	Kit.Part(parent, V(1.6, len - 0.04, width * 0.4), cf, C(205, 235, 255), { Transp = 0.6 }) -- ends inside the sheet (z-fighting)
	local lip = Kit.Part(parent, V(3, 0.8, width + 1), CFrame.new(top + V(0, 0.2, 0)), C(170, 220, 255), { Transp = 0.35 })
	if mist then
		Kit.Emitter(lip, C(190, 225, 255), 4, 7, 1.2)
	end
end

local function brokenColumn(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	Kit.Box(parent, V(x - 2.2, 0, z - 2.2), V(x + 2.2, 1.2, z + 2.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	local h = rng:NextNumber(4, 17)
	Kit.Cyl(parent, h, 3, CFrame.new(x, 1.2 + h / 2, z), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
	if h > 13 then
		Kit.Box(parent, V(x - 2.2, 1.2 + h, z - 2.2), V(x + 2.2, 2.6 + h, z + 2.2), RUIN_DARK, { Mat = SLATE })
	else
		Kit.Part(parent, V(2.4, 1.4, 2.4), CFrame.new(x, 1.6 + h, z) * CFrame.Angles(0.35, rng:NextNumber(0, 3), 0.25), RUIN, { Mat = SLATE })
		if rng:NextNumber() < 0.5 then
			Kit.CylFlat(parent, 4, 3, V(x + 2.2, 1.5, z + 2.4), "X", RUIN, { Mat = SLATE, Solid = true })
		end
	end
end

local function brokenArch(parent: Instance, x: number, z: number, yaw: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0)
	local o: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }
	Kit.Part(parent, V(3, 18, 3), base * CFrame.new(-7, 9, 0), RUIN, o)
	Kit.Part(parent, V(3, 11, 3), base * CFrame.new(7, 5.5, 0), RUIN, o)
	Kit.Part(parent, V(3, 2, 3), base * CFrame.new(7, 11.6, 0) * CFrame.Angles(0, 0, 0.4), RUIN_DARK, { Mat = SLATE })
	Kit.Part(parent, V(10, 3, 3.2), base * CFrame.new(-3.2, 19.3, 0) * CFrame.Angles(0, 0, -0.08), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Part(parent, V(6, 3, 3), base * CFrame.new(9.5, 1.3, 5) * CFrame.Angles(0.25, 0.6, 0.1), RUIN_DARK, o)
	-- faint rune carved on the standing pillar
	Kit.Part(parent, V(1.2, 1.2, 0.2), base * CFrame.new(-7, 12, -1.55) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(C(120, 220, 255)))
	Kit.AddCircle(x, z, 10)
end

local function temple(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "AncientTemple")
	Kit.Box(m, V(x - 13, 0, z - 11), V(x + 13, 0.9, z + 11), RUIN_DARK, { Mat = SLATE, Solid = true })
	Kit.Box(m, V(x - 10, 0.9, z - 8), V(x + 10, 1.8, z + 8), RUIN, { Mat = SLATE, Solid = true })
	local rng = Kit.Rng
	for _, cx in { -8, 8 } do
		for _, cz in { -6, 0, 6 } do
			local intact = cz >= 0
			local h = if intact then 14 else rng:NextNumber(4, 9)
			Kit.Cyl(m, h, 2.6, CFrame.new(x + cx, 1.8 + h / 2, z + cz), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
		end
	end
	Kit.Box(m, V(x - 9.6, 15.8, z - 1.6), V(x + 9.6, 17.4, z + 7.6), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Wedge(m, V(19.2, 4, 4.6), CFrame.new(x, 19.4, z + 5.3) * CFrame.Angles(0, math.pi, 0), RUIN_DARK, { Mat = SLATE })
	Kit.Part(m, V(9, 1.6, 4), CFrame.new(x + 3, 2.4, z - 9) * CFrame.Angles(0.15, 0.4, -0.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	-- altar with a spirit flame
	Kit.Box(m, V(x - 1.6, 1.8, z - 4.6), V(x + 1.6, 4.4, z - 1.4), C(70, 62, 102), { Mat = SLATE, Solid = true })
	local flame = Kit.Ball(m, 1.8, V(x, 5.3, z - 3), C(140, 255, 210), { Mat = NEON })
	Kit.Light(flame, C(140, 255, 210), 26, 1.6, true)
	Kit.AddCircle(x, z, 15)
end

local function monolithRing(parent: Instance, mx: number, mz: number)
	local rng = Kit.Rng
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local p = V(mx + math.cos(a) * 9, 0, mz + math.sin(a) * 9)
		local h = rng:NextNumber(7, 12)
		local cf = CFrame.new(p) * CFrame.Angles(0, Kit.FaceYaw(mx - p.X, mz - p.Z), 0) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
		Kit.Part(parent, V(2.8, h, 1.8), cf * CFrame.new(0, h / 2 - 0.3, 0), RUIN_DARK, { Mat = SLATE, Solid = true, Shadow = true })
	end
	Kit.Disc(parent, mx, mz, 0.1, 9, 0.06, Kit.Vivid(C(150, 100, 255)))
	Kit.Disc(parent, mx, mz, 0.13, 3.2, 0.06, C(150, 240, 255), { Mat = NEON })
	Kit.AddCircle(mx, mz, 12)
end

-- Flat ring of paint segments.
local function paintRing(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.3
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.03, cz + math.sin(a) * r)
		Kit.Part(parent, V(w, 0.06, segLen), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), color)
	end
end

--==================================================================
-- SECTIONS
--==================================================================
local function ground(f: Instance)
	-- void glass: walkable everywhere in the play area, dark and see-through
	-- (ends 0.05 short of the edge so it doesn't share the side rocks' outer face)
	Kit.Box(f, V(-W + 0.05, -1, Z0), V(W - 0.05, 0, Z1), C(16, 12, 34), { Solid = true, Transp = 0.3, Refl = 0.15, Name = "VoidGlass" })
	-- invisible backing slab: the glass alone is only 1 stud thick while every other zone floor
	-- is 4, so this brings the realm floor to 4 studs and fast characters can't tunnel through.
	Kit.Box(f, V(-W, -4, Z0), V(W, -1, Z1), C(16, 12, 34), { Solid = true, Transp = 1, Shadow = false, Name = "VoidGlassBacking" })
	-- islands sunk into the glass (tops alternate 0.04 / 0.06 so overlaps never flicker)
	local islands = {
		{ 0, 2320, 92, 0.04 }, { 6, 2382, 70, 0.06 }, { -82, 2400, 66, 0.06 }, { 92, 2352, 46, 0.04 },
		{ 75, 2470, 70, 0.04 }, { -20, 2462, 40, 0.06 }, { -62, 2530, 66, 0.04 }, { 60, 2562, 42, 0.04 },
		{ 0, 2605, 90, 0.06 }, { -106, 2612, 36, 0.04 }, { 102, 2640, 34, 0.04 }, { -108, 2322, 40, 0.06 },
		{ 0, 2658, 60, 0.04 },
	}
	for _, i in islands do
		island(f, i[1], i[2], i[4], i[3], true, true)
	end
	-- starfield and nebula far below the glass
	local rng = Kit.Rng
	for _ = 1, 12 do
		Kit.Ball(f, rng:NextNumber(0.6, 1.4), V(rng:NextNumber(-135, 135), rng:NextNumber(-110, -35), rng:NextNumber(Z0 + 10, Z1 - 10)), Kit.Pick({ C(220, 230, 255), C(180, 150, 255), C(150, 240, 255) }), { Mat = NEON })
	end
	local nebula = { V(-180, -200, 2400), V(200, -230, 2560), V(0, -260, 2480) }
	local nebulaCol = { C(90, 50, 160), C(40, 80, 160), C(40, 120, 130) }
	for k, n in nebula do
		Kit.Disc(f, n.X, n.Z, n.Y, 520, 2, nebulaCol[k], { Transp = 0.55 })
	end
end

local function runePath(f: Instance)
	local z2 = 2648
	Kit.Box(f, V(-5, 0.02, Z0 + 3), V(5, 0.08, z2), C(40, 36, 68), { Mat = SLATE, Solid = true, Name = "RunePath" })
	local edge = C(120, 210, 255)
	for z = Z0 + 10, z2 - 14, 28 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 5, 0.02, z), V(s * 5.6, 0.1, z + 14), edge, { Mat = NEON })
		end
	end
	local glyph = C(190, 140, 255)
	for z = Z0 + 30, z2 - 10, 48 do
		Kit.Part(f, V(1.8, 0.04, 1.8), CFrame.new(0, 0.1, z) * CFrame.Angles(0, math.pi / 4, 0), glyph, { Mat = NEON })
	end
	-- painted (solid) dashes between the glyphs
	local dash = Kit.Vivid(C(130, 110, 220))
	for z = Z0 + 54, z2 - 10, 48 do
		Kit.Box(f, V(-0.3, 0.08, z - 4), V(0.3, 0.1, z + 4), dash)
	end
end

local function bossRing(f: Instance)
	local cx, cz = 0, 2605
	paintRing(f, cx, cz, 31, 28, 1.2, Kit.Vivid(C(150, 100, 255)), 0.12)
	paintRing(f, cx, cz, 20, 20, 0.8, Kit.Vivid(C(90, 200, 255)), 0.12)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Kit.Disc(f, cx + math.cos(a) * 33, cz + math.sin(a) * 33, 0.14, 2.4, 0.06, C(170, 240, 255), { Mat = NEON })
	end
end

local function portal(f: Instance)
	-- A horseshoe arch the main path walks through: it frames the Swamp gate (Z 2680) and the
	-- swamp beyond, so the "glimpse of the next destination" is the real next zone.
	local m = Kit.Model(f, "SpiritPortal")
	local cy, pz, R = 30, 2666, 32
	Kit.Box(m, V(-40, 0, 2648), V(40, 0.8, 2677), C(48, 42, 78), { Mat = SLATE, Solid = true })
	Kit.Box(m, V(-36, 0.8, 2654), V(36, 1.4, 2676), C(60, 52, 92), { Mat = SLATE, Solid = true })
	-- stone ring (upper part only) + a shimmering inner band
	local n = 28
	local segLen = 2 * math.pi * R / n + 0.6
	local inner = R - 4.5
	local innerLen = 2 * math.pi * inner / n + 0.4
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		if math.sin(a) > -0.45 then
			local pos = V(math.cos(a) * R, cy + math.sin(a) * R, pz)
			Kit.Part(m, V(segLen, 4.5, 4), CFrame.new(pos) * CFrame.Angles(0, 0, a + math.pi / 2), if i % 2 == 0 then C(52, 44, 84) else C(40, 36, 66), { Mat = SLATE, Shadow = true })
			if i % 4 == 1 then
				Kit.Part(m, V(1.4, 1.4, 0.3), CFrame.new(pos.X, pos.Y, pz - 2.1) * CFrame.Angles(0, 0, math.pi / 4), C(150, 240, 255), { Mat = NEON })
			end
			local ip = V(math.cos(a) * inner, cy + math.sin(a) * inner, pz)
			Kit.Part(m, V(innerLen, 1.6, 1), CFrame.new(ip) * CFrame.Angles(0, 0, a + math.pi / 2), if i % 2 == 0 then C(160, 90, 255) else C(80, 220, 255), { Mat = Enum.Material.ForceField, Transp = 0.2 })
		end
	end
	-- legs carrying the arch down to the platform (outside the gate opening)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 25.5, 1.4, pz - 2.5), V(s * 31.5, 18, pz + 2.5), C(44, 38, 70), { Mat = ROCK, Solid = true, Shadow = true })
		Kit.Box(m, V(s * 25, 1.4, pz - 3), V(s * 32, 4, pz + 3), RUIN_DARK, { Mat = SLATE, Solid = true })
	end
	-- glowing keystone with the portal light and sparkles drifting down through the arch
	local key = Kit.Part(m, V(5, 5, 5), CFrame.new(0, cy + R - 6, pz - 1) * CFrame.Angles(0, 0, math.pi / 4), C(225, 210, 255), { Transp = 0.2 })
	Kit.Light(key, C(190, 150, 255), 60, 2)
	Kit.Emitter(key, C(200, 160, 255), 5, 5, 2.5)
	-- flanking obelisks with crystal tips
	for _, s in { -1, 1 } do
		local x = s * 43
		Kit.Box(m, V(x - 2.5, 0, 2657.5), V(x + 2.5, 2, 2662.5), RUIN_DARK, { Mat = SLATE, Solid = true })
		Kit.Box(m, V(x - 1.8, 2, 2658.2), V(x + 1.8, 28, 2661.8), C(48, 42, 78), { Mat = SLATE, Solid = true, Shadow = true })
		shard(m, V(x, 28, 2660), 6, 2.2, 0, 0, if s < 0 then C(170, 110, 255) else C(90, 220, 255), true)
	end
	-- two rocks drifting around the portal
	for _, s in { -1, 1 } do
		local rock = Kit.Part(m, V(6, 4.5, 5), CFrame.new(s * 52, 30 + s * 6, 2655) * CFrame.Angles(0.4, s * 0.7, 0.3), Kit.Pick(ROCKS), { Mat = ROCK, Name = "FloatingRock" })
		Kit.Float(rock, 1.6)
	end
	Kit.AddRect(-47, 2645, 47, 2678)
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local zA, zB = Z0 + 3, Z1 - 3
	local n = 10
	local len = (zB - zA) / n
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local z = zA + i * len
			local h = rng:NextNumber(8, 13)
			Kit.Box(f, V(s * 140, -26, z), V(s * W, h, z + len), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
			for k = 1, 2 do
				local cz = z + len * (k / 3) + rng:NextNumber(-3, 3)
				local lean = rng:NextNumber(0.1, 0.35)
				shard(f, V(s * 143, h - 0.5, cz), rng:NextNumber(5, 10), rng:NextNumber(1.6, 2.4), rng:NextNumber(-0.2, 0.2), -s * lean, Kit.Pick(CRYSTAL), k == 1 and i % 4 == 1)
			end
		end
	end
end

local function insideScenery(f: Instance)
	local rng = Kit.Rng
	temple(f, 105, 2545)
	if Kit.IsFree(-104, 2345, 12) then
		monolithRing(f, -104, 2345)
	end
	-- broken arches beside the path
	local arches = { { -45, 2330, 0.3 }, { 48, 2412, -0.4 }, { -28, 2495, 0.2 }, { 40, 2525, -0.2 }, { -100, 2478, 1.2 } }
	local placed = 0
	for _, a in arches do
		if placed < 3 and Kit.IsFree(a[1], a[2], 10) then
			placed += 1
			brokenArch(f, a[1], a[2], a[3])
		end
	end
	-- entry pylons flanking the path just past the gate
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 13, 2318, 3, true) then
			local c = crystalCluster(f, V(s * 13, 0, 2318), 0.9, s > 0)
			if s > 0 then
				Kit.Light(c, C(120, 230, 255), 30, 1.5)
			else
				Kit.Emitter(c, C(170, 140, 255), 2, 2.5, 0.8)
			end
			Kit.AddCircle(s * 13, 2318, 4)
		end
	end
	-- enormous spirit trees along the edges (crowns kept clear of the ghost areas)
	local trees = { { -120, 2296, 42 }, { 120, 2298, 38 }, { -122, 2445, 44 }, { 124, 2395, 40 }, { 122, 2600, 42 }, { -124, 2566, 38 }, { 118, 2510, 34 } }
	local lit = 0
	for _, t in trees do
		if Kit.IsFree(t[1], t[2], 5) and clearOfGhosts(t[1], t[2], 19) then
			local orb = spiritTree(f, V(t[1], 0, t[2]), t[3])
			lit += 1
			if lit <= 2 then
				Kit.Light(orb, orb.Color, 28, 1.3)
			end
			Kit.AddCircle(t[1], t[2], 6)
		end
	end
	-- giant spectral crystal clusters
	local clusters, lights = 0, 0
	for _ = 1, 300 do
		if clusters >= 9 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 45)
		if math.abs(x) > 14 and Kit.IsFree(x, z, 6) then
			clusters += 1
			local neon = clusters % 2 == 1
			local main = crystalCluster(f, V(x, 0, z), rng:NextNumber(0.9, 1.4), neon)
			if neon and lights < 3 then
				lights += 1
				Kit.Light(main, main.Color, 26, 1.4)
			end
			Kit.AddCircle(x, z, 6)
		end
	end
	-- broken colonnade lining the path
	for z = Z0 + 46, 2640, 30 do
		for _, s in { -1, 1 } do
			local x = s * rng:NextNumber(17, 24)
			if Kit.IsFree(x, z, 5) then
				brokenColumn(f, x, z)
				Kit.AddCircle(x, z, 4)
			end
		end
	end
	-- loose boulders
	local boulders = 0
	for _ = 1, 200 do
		if boulders >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 40)
		if Kit.IsFree(x, z, 3) then
			boulders += 1
			local sz = V(rng:NextNumber(2, 4.5), rng:NextNumber(1.5, 3), rng:NextNumber(2, 4.5))
			Kit.Part(f, sz, CFrame.new(x, sz.Y * 0.35, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true }).CanCollide = false -- small prop: tappable/queryable but walk-through (solid ones snag players)
			Kit.AddCircle(x, z, 3)
		end
	end
	-- floating ruin pieces and crystals (never over a ghost area)
	local floats = 0
	for _ = 1, 300 do
		if floats >= 8 then
			break
		end
		local x, z = rng:NextNumber(-125, 125), rng:NextNumber(Z0 + 40, Z1 - 50)
		if math.abs(x) > 12 and Kit.IsFree(x, z, 6) then
			floats += 1
			local y = rng:NextNumber(9, 18)
			local cf = CFrame.new(x, y, z) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5))
			local p: Part
			if floats <= 2 then
				p = Kit.Part(f, V(1.8, 6, 1.8), cf, Kit.Vivid(Kit.Pick(CRYSTAL)), { Mat = GLASS, Transp = 0.15, Refl = 0.2, Name = "FloatingCrystal" })
			elseif floats % 2 == 0 then
				p = Kit.Part(f, V(3, 5, 3), cf, RUIN, { Mat = SLATE, Shape = Enum.PartType.Cylinder, Name = "FloatingColumn" })
			else
				p = Kit.Part(f, V(4, 2.4, 3), cf, RUIN_DARK, { Mat = SLATE, Name = "FloatingBlock" })
			end
			Kit.Float(p, rng:NextNumber(0.8, 1.6))
		end
	end
end

local function outsideScenery(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Void")
	-- floating islands just beyond the walls: { x, z, topY, d, content, waterfall? }
	type Outer = { x: number, z: number, y: number, d: number, kind: string, falls: boolean }
	local outer: { Outer } = {
		{ x = -186, z = 2322, y = 6, d = 44, kind = "tree", falls = true },
		{ x = -206, z = 2420, y = -2, d = 52, kind = "crystal", falls = false },
		{ x = -182, z = 2522, y = 10, d = 36, kind = "ruin", falls = true },
		{ x = -214, z = 2622, y = 2, d = 50, kind = "tree", falls = false },
		{ x = 190, z = 2342, y = 2, d = 50, kind = "crystal", falls = true },
		{ x = 182, z = 2450, y = 12, d = 34, kind = "tree", falls = false },
		{ x = 210, z = 2552, y = -4, d = 56, kind = "ruin", falls = true },
		{ x = 188, z = 2652, y = 8, d = 40, kind = "crystal", falls = false },
	}
	local mist = false
	local litOuter = false
	for _, i in outer do
		island(o, i.x, i.z, i.y, i.d, false, true)
		local top = V(i.x, i.y, i.z)
		if i.kind == "tree" then
			spiritTree(o, top, rng:NextNumber(30, 40))
		elseif i.kind == "crystal" then
			local c = crystalCluster(o, top, 1.8, not litOuter)
			if not litOuter then
				litOuter = true
				Kit.Light(c, c.Color, 40, 1.6)
			end
			crystalCluster(o, top + V(i.d * 0.25, 0, i.d * 0.2), 0.9, false)
		else
			for k = 0, 2 do
				local h = 8 + k * 4
				Kit.Cyl(o, h, 3.2, CFrame.new(i.x - 8 + k * 8, i.y + h / 2, i.z - 6 + k * 3), RUIN, { Mat = SLATE })
			end
			Kit.Part(o, V(14, 2.4, 3.4), CFrame.new(i.x, i.y + 17, i.z) * CFrame.Angles(0, 0.3, 0.2), RUIN_DARK, { Mat = SLATE })
		end
		if i.falls then
			local s = if i.x < 0 then -1 else 1
			-- pours off the island edge that faces the play area
			-- (offset in Z so it never lands on a bridge)
			waterfall(o, V(i.x - s * (i.d / 2 - 2), i.y, i.z + i.d * 0.22), rng:NextNumber(7, 10), 170, not mist)
			mist = true
		end
	end
	-- broken bridges from the walls to two islands
	local bridges = { { -1, 2322, 6, 186 - 22 }, { 1, 2450, 12, 182 - 17 } }
	for _, b in bridges do
		local s, z, y, reach = b[1], b[2], b[3], b[4]
		local slabs = math.floor((reach - W) / 4.5)
		for k = 0, slabs - 1 do
			if k ~= 2 then
				local x = s * (W + 2.25 + k * 4.5)
				local cf = CFrame.new(x, y - 0.6, z)
				if k == slabs - 1 then
					cf = CFrame.new(x, y - 4, z + 1) * CFrame.Angles(0.3, 0, s * 0.5)
				end
				Kit.Part(o, V(4.2, 1.2, 7), cf, RUIN, { Mat = SLATE })
				if k % 2 == 0 then
					Kit.Box(o, V(x - 0.4, y, z + 3), V(x + 0.4, y + 3.5, z + 3.8), RUIN_DARK, { Mat = SLATE })
				end
			end
		end
	end
	-- loose rocks hanging in the void
	for _ = 1, 12 do
		local s = if rng:NextNumber() < 0.5 then -1 else 1
		local sz = V(rng:NextNumber(4, 12), rng:NextNumber(3, 8), rng:NextNumber(4, 12))
		Kit.Part(o, sz, CFrame.new(s * rng:NextNumber(160, 290), rng:NextNumber(-30, 45), rng:NextNumber(Z0, Z1 + 40)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)), Kit.Pick(ROCKS), { Mat = ROCK })
	end
	-- distant islands (low detail silhouettes)
	local far = { { -340, 2330, 30, 120 }, { -410, 2520, 55, 150 }, { -330, 2690, 20, 100 }, { 350, 2300, 45, 130 }, { 420, 2480, 25, 150 }, { 340, 2660, 60, 110 } }
	for _, d in far do
		local x, z, y, dia = d[1], d[2], d[3], d[4]
		Kit.Disc(o, x, z, y, dia, 6, C(40, 34, 66), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 6, dia * 0.7, 12, C(30, 26, 50), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 18, dia * 0.36, 18, C(22, 20, 40), { Mat = ROCK })
		Props.Beam(o, V(x, y, z), V(x + 4, y + 30, z), 4, 4, BARK, { Mat = WOOD })
		Kit.Ball(o, 22, V(x + 4, y + 34, z), Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.25 })
	end
	-- cloud banks and a ringed planet in a strange sky
	local clouds = {
		{ -260, 2300, 90, 160 }, { -420, 2460, 130, 220 }, { -300, 2640, 110, 180 }, { 280, 2340, 120, 200 },
		{ 440, 2560, 95, 230 }, { 260, 2700, 140, 170 }, { 0, 2820, 120, 260 }, { -150, 2800, 80, 150 },
		{ 160, 2790, 70, 150 }, { 0, 2250, 170, 200 },
	}
	for i, c in clouds do
		local col = if i % 2 == 0 then C(120, 90, 200) else C(80, 120, 210)
		Kit.Cyl(o, rng:NextNumber(6, 12), c[4], CFrame.new(c[1], c[3], c[2]) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)), col, { Transp = 0.75 })
	end
	local planet = V(-520, 230, 2760)
	Kit.Ball(o, 220, planet, C(110, 80, 180), { Transp = 0.15 })
	Kit.Cyl(o, 1, 400, CFrame.new(planet) * CFrame.Angles(0.35, 0, 0.25), C(170, 150, 230), { Transp = 0.65 })
	Kit.Ball(o, 60, V(480, 190, 2480), C(150, 220, 235), { Transp = 0.1 })
end

function SpiritRealm.Build(map: Instance)
	local f = Kit.Folder(map, "SpiritRealm")
	ground(f)
	runePath(f)
	bossRing(f)
	portal(f)
	sideWalls(f)
	insideScenery(f)
	outsideScenery(f)
end

return SpiritRealm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[--!strict
-- Crate stations (workspace.Map.Stations.CrateStation_<id>) and the upgrade booth
-- (workspace.Map.Stations.UpgradeStation). Stations sit beside the main path (X = 0);
-- their PromptAnchor and the OddsBoard's Front face point toward the path.
-- Pads, frames and trims are solid candy colours; the glow is kept to the arch lamps, the
-- corner jack-o'-lanterns and a couple of gadget lights.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Stations = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WHITE = C(255, 255, 255)

local function anchors(m: Model, x: number, z: number, dir: number)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x, 4, z), WHITE, { Name = "DisplaySlot", Transp = 1 })
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })
end

local function pad(m: Model, x: number, z: number, color: Color3, trim: Color3): Part
	local ring = Kit.Vivid(trim)
	Kit.Disc(m, x, z, 0.6, 16.5, 0.6, ring)
	local p = Kit.Disc(m, x, z, 1, 14, 1, color, { Name = "Pad", Solid = true })
	Kit.Disc(m, x, z, 1.12, 9, 0.2, ring)
	Kit.Disc(m, x, z, 1.18, 6, 0.2, color:Lerp(WHITE, 0.3))
	return p
end

local function crateStation(folder: Instance, crate: Config.CrateDef, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1 -- toward the path
	local m = Kit.Model(folder, "CrateStation_" .. crate.Id)
	local padPart = pad(m, x, z, crate.Color, crate.Trim)
	anchors(m, x, z, dir)
	local trim = Kit.Vivid(crate.Trim)

	-- Odds board behind the pad, Front face toward the path.
	local yaw = Kit.FaceYaw(dir, 0)
	local boardCF = CFrame.new(x - dir * 9.5, 7, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(m, V(12, 9, 0.6), boardCF, C(35, 22, 60), { Name = "OddsBoard", Solid = true })
	Kit.Part(m, V(13.4, 10.4, 0.5), boardCF * CFrame.new(0, 0, 0.45), trim)
	Kit.Part(m, V(14.2, 1.8, 1.2), boardCF * CFrame.new(0, 5.6, 0.3), crate.Color)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 2.6, 1), boardCF * CFrame.new(sx * 5, -5.8, 0.4), crate.Color:Lerp(C(0, 0, 0), 0.3), { Solid = true })
		Kit.Ball(m, 1.6, (boardCF * CFrame.new(sx * 7.1, 5.6, 0.3)).Position, trim)
	end

	-- Arch over the back half of the pad with the crate's name facing the path; the two
	-- orbs on top are its lamps (the beam carries the light).
	local ax = x - dir * 3
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(ax - 1.3, 0, z + sz * 9.5 - 1.3), V(ax + 1.3, 15, z + sz * 9.5 + 1.3), crate.Color, { Solid = true })
		Kit.Box(m, V(ax - 1.6, 0, z + sz * 9.5 - 1.6), V(ax + 1.6, 1.4, z + sz * 9.5 + 1.6), trim)
		Kit.Ball(m, 3, V(ax, 18.4, z + sz * 10.5), crate.Trim, { Mat = NEON })
	end
	local beam = Kit.Box(m, V(ax - 1.5, 15, z - 11.5), V(ax + 1.5, 17, z + 11.5), crate.Color:Lerp(WHITE, 0.15))
	Kit.Light(beam, crate.Trim, 18, 1.8)
	local signCF = CFrame.new(ax, 19, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(20, 4, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(21, 5, 0.4), signCF * CFrame.new(0, 0, 0.4), trim)
	Kit.IconSign(sign, Enum.NormalId.Front, crate.Name, crate.Trim, Icons.ForCrate[crate.Id])

	-- glowing corner jack-o'-lanterns
	Props.Pumpkin(m, V(x + dir * 6, 0, z + 9), 2.8, dir, 0, true)
	Props.Pumpkin(m, V(x + dir * 6, 0, z - 9), 2.8, dir, 0, true)

	Kit.AddCircle(ax, z, 13)
	m.PrimaryPart = padPart
	return m
end

local function beginnerExtras(m: Model, x: number, z: number, crate: Config.CrateDef)
	-- Tall shimmering beacon so the first crate is obvious from spawn (ForceField: reads as a
	-- light pillar without a 70-stud neon tube blooming over everything).
	local beacon = Kit.Cyl(m, 70, 5, CFrame.new(x, 57, z), Kit.Vivid(crate.Trim), { Mat = Enum.Material.ForceField, Transp = 0.5, Name = "Beacon" })
	Kit.Emitter(beacon, crate.Trim, 3, 3, 2)
	Kit.Ball(m, 6, V(x, 22.5, z), Kit.Vivid(crate.Color), { Refl = 0.15 })
	-- World-space label with ONE fixed text size. (It used to be sized in studs with TextScaled,
	-- which re-sized the text on every camera move: constant text re-drawing that made letters
	-- glitch on phones.) MaxDistance hides it when far away.
	local bb: BillboardGui = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 40)
	bb.StudsOffsetWorldSpace = V(0, -24, 0)
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Parent = beacon
	-- the crate's icon either side of the words (bb is 240 x 40 px)
	local crateImage = Icons.Get(Icons.ForCrate[crate.Id])
	local label = Kit.Label(bb, if crateImage then "OPEN CRATES!" else "🎁 OPEN CRATES! 🎁", C(255, 230, 90), { Stroke = C(120, 50, 10) })
	if crateImage then
		Kit.IconImage(bb, crateImage, 0, 0.05, 0.15, 0.9)
		Kit.IconImage(bb, crateImage, 0.85, 0.05, 0.15, 0.9)
	end
	label.TextScaled = false
	label.TextSize = 24
	local st = label:FindFirstChildOfClass("UIStroke")
	if st then
		st.Thickness = 2
	end
end

local function upgradeStation(folder: Instance, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1
	local m = Kit.Model(folder, "UpgradeStation")
	local color, trim = C(80, 200, 255), C(255, 220, 80)
	local padPart = pad(m, x, z, color, trim)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })

	local bx = x - dir * 9.5 -- workbench centre line
	local back = bx - dir * 3 -- back panel
	local yaw = Kit.FaceYaw(dir, 0)
	-- workbench
	Kit.Box(m, V(bx - 2, 0, z - 8), V(bx + 2, 3.6, z + 8), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(m, V(bx - 2.4, 3.6, z - 8.4), V(bx + 2.4, 4.2, z + 8.4), C(90, 230, 255), { Solid = true })
	-- back panel + big sign
	Kit.Box(m, V(back - 0.6, 0, z - 10.5), V(back + 0.6, 17, z + 10.5), C(110, 70, 200), { Solid = true })
	local signCF = CFrame.new(back + dir * 0.9, 13.2, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(19, 5, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(20, 6, 0.3), signCF * CFrame.new(0, 0, 0.4), Kit.Vivid(trim))
	Kit.IconSign(sign, Enum.NormalId.Front, "UPGRADES", trim, "menu_upgrades")
	-- upgrade icons
	for i, upId in Config.UpgradeOrder do
		local up = Config.Upgrades[upId]
		local icf = CFrame.new(back + dir * 0.8, 7.8, z + (i - 2) * 6) * CFrame.Angles(0, yaw, 0)
		local icon = Kit.Part(m, V(4.4, 4.4, 0.4), icf, C(60, 40, 110))
		Kit.Part(m, V(5, 5, 0.3), icf * CFrame.new(0, 0, 0.3), Kit.Vivid(color))
		-- the uploaded upgrade icon (same picture as the Upgrades menu); emoji only without one
		local image = Icons.Get(Icons.ForUpgrade[upId])
		if image then
			local g = Kit.Gui(icon, Enum.NormalId.Front)
			local img = Instance.new("ImageLabel")
			img.Name = "UpgradeIcon"
			img.BackgroundTransparency = 1
			img.Image = image
			img.ScaleType = Enum.ScaleType.Fit
			img.Size = UDim2.fromScale(0.9, 0.9)
			img.Position = UDim2.fromScale(0.05, 0.05)
			img.Parent = g
		else
			Kit.Sign(icon, Enum.NormalId.Front, up.Icon, WHITE)
		end
	end
	-- gadgets on the bench (potion vials are solid candy colours; the orange status light glows)
	Kit.CylFlat(m, 4.5, 1.6, V(bx, 5, z - 4.5), "Z", C(255, 120, 200))
	Kit.CylFlat(m, 1.5, 0.8, V(bx, 5, z - 7.4), "Z", Kit.Vivid(C(140, 255, 160)))
	for i = 0, 1 do
		Kit.Cyl(m, 3.2, 1.6, CFrame.new(bx, 5.8, z + 1 + i * 2.2), Kit.Vivid(C(120, 255, 170)), { Transp = 0.15, Refl = 0.15 })
		Kit.Cyl(m, 0.5, 1.8, CFrame.new(bx, 7.6, z + 1 + i * 2.2), C(70, 70, 90))
	end
	Kit.CylFlat(m, 0.6, 3.2, V(bx, 5.9, z + 6), "X", C(255, 210, 70))
	Kit.Ball(m, 1.2, V(bx, 5.9, z + 6), C(255, 120, 60), { Mat = NEON })
	-- striped awning on posts
	local tilt = -dir * 0.22
	local stripes = { C(255, 140, 50), C(160, 90, 255) }
	for i = 0, 3 do
		local sz = z - 8.25 + i * 5.5
		Kit.Part(m, V(9, 0.5, 5.5), CFrame.new(bx - dir * 0.5, 17.2, sz) * CFrame.Angles(0, 0, tilt), stripes[(i % 2) + 1], { Shadow = true })
	end
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(bx + dir * 3.7 - 0.4, 0, z + sz * 10.5 - 0.4), V(bx + dir * 3.7 + 0.4, 16.3, z + sz * 10.5 + 0.4), C(70, 50, 110))
	end
	local bulb = Kit.Ball(m, 1.4, V(bx + dir * 2, 15, z), C(255, 240, 160), { Mat = NEON })
	Kit.Light(bulb, C(255, 220, 150), 18, 1.5)

	Kit.AddCircle(x - dir * 4, z, 14)
	m.PrimaryPart = padPart
end

function Stations.Build(map: Instance)
	local folder = Kit.Folder(map, "Stations")
	for id, pos in Kit.CrateStations(Config.Layout) do
		local crate = Config.Crates[id]
		if crate then
			local m = crateStation(folder, crate, pos)
			if id == "Beginner" then
				beginnerExtras(m, pos.X, pos.Z, crate)
			end
		end
	end
	upgradeStation(folder, Config.Layout.UpgradeStation)
end

return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Sunken</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 13: Sunken City (Z 4120..4480). Atlantis ruins on a sandy sea floor you can walk on.
--   Ground: sand slab + pale marble-tile avenue along X = 0 (flat, teal edging).
--   Ghost areas get flat mosaic discs ((0,4205) r30, (-82,4240) r24, (75,4300) r26,
--   (-62,4360) r24, boss (0,4425) r26 with a gold trident star).
--   Atlantis gate arch over the avenue at Z 4168 (beam bottom Y 30).
--   Landmark seen from the Toy Factory: domed temple (-100, 4432), trident tip ~Y 102.
--   Sunken ship bow (east back corner), giant clams, coral reefs, kelp, broken columns,
--   treasure chests and flat starfish. A translucent water surface floats at Y 120
--   (no collision) with a few soft light shafts.
--   Side walls: teal reef rock (X +-140..146) topped with coral; outside: reef hills, coral
--   spires and kelp forests.
-- Glow: temple pearl, clam pearl, arch crystal, sea lanterns, the ship lantern, the boss
-- mosaic heart and a few anemone patches. Everything else is sand, marble, rock and plastic.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Sunken = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SAND = Enum.Material.Sand
local MARBLE = Enum.Material.Marble
local ROCK = Enum.Material.Rock
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.WoodPlanks
local FABRIC = Enum.Material.Fabric
local PEBBLE = Enum.Material.Pebble

local Z0, Z1 = 4120, 4480

local SANDC = C(226, 206, 160)
local SAND_D = C(205, 182, 135)
local TEAL = C(60, 175, 175)
local SEA = C(55, 125, 200)
local DEEP = C(40, 80, 130)
local CORAL = C(255, 120, 150)
local CORAL_O = C(255, 150, 80)
local CORAL_P = C(190, 110, 230)
local GOLD = C(255, 205, 80)
local MARBLE_C = C(232, 238, 236)
local MARBLE_T = C(190, 225, 220)
local REEF = C(75, 130, 145)
local KELP = { C(70, 160, 90), C(95, 185, 85), C(60, 140, 100) }
local AQUA = C(130, 255, 235)
local PEARL = C(250, 245, 255)
local WOODC = C(110, 80, 60)

local SOLID_MARBLE: Kit.Opts = { Mat = MARBLE, Solid = true, Shadow = true }
local GOLD_M: Kit.Opts = { Mat = METAL }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- SMALL PROPS
--==================================================================
local function coral(parent: Instance, x: number, z: number, s: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "Coral")
	local cols = { CORAL, CORAL_O, CORAL_P, C(255, 190, 90) }
	-- brain coral
	Kit.Ball(m, 4.5 * s, V(x, 0.8 * s, z), Kit.Vivid(Kit.Pick(cols)), { Mat = PEBBLE })
	-- branching coral
	local bc = Kit.Vivid(Kit.Pick(cols))
	local base = V(x + 2.6 * s, 0, z + rng:NextNumber(-1.5, 1.5))
	for i = 1, 3 do
		local a = i * 2.1 + rng:NextNumber(-0.4, 0.4)
		local tip = base + V(math.cos(a) * 1.6 * s, rng:NextNumber(4, 6.5) * s, math.sin(a) * 1.6 * s)
		Props.Beam(m, base, tip, 0.8 * s, 0.8 * s, bc)
		Kit.Ball(m, 1.3 * s, tip, bc)
	end
	-- tube coral
	local tc = Kit.Vivid(Kit.Pick(cols))
	for i = 0, 1 do
		local h = rng:NextNumber(2.5, 4.5) * s
		local p = V(x - 2.4 * s + i * 1.4 * s, 0, z + 1.6 * s - i * 1.2 * s)
		Kit.Cyl(m, h, 1.3 * s, CFrame.new(p + V(0, h / 2, 0)), tc)
		Kit.Disc(m, p.X, p.Z, h + 0.2, 1.6 * s, 0.4, tc:Lerp(Color3.new(1, 1, 1), 0.35))
	end
	-- fan coral
	Kit.Part(m, V(0.3, 4 * s, 4.5 * s), CFrame.new(x - 0.5 * s, 2 * s, z - 2.4 * s) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Kit.Vivid(Kit.Pick(cols)))
	Kit.AddCircle(x, z, 4.5 * s)
end

local function kelp(parent: Instance, x: number, z: number, h: number)
	local rng = Kit.Rng
	for i = 1, 3 do
		local hh = h * rng:NextNumber(0.6, 1)
		local p = V(x + rng:NextNumber(-2, 2), hh / 2, z + rng:NextNumber(-2, 2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, math.pi), rng:NextNumber(-0.08, 0.08))
		Kit.Part(parent, V(0.7, hh, 2.4), cf, Kit.Pick(KELP), { Mat = Enum.Material.Grass })
		if i == 1 then
			Kit.Ball(parent, 1.4, p + V(0, hh * 0.3, 0), C(170, 200, 70))
		end
	end
	Kit.AddCircle(x, z, 3)
end

local function starfish(parent: Instance, x: number, z: number)
	local col = Kit.Vivid(Kit.Pick({ CORAL_O, CORAL, C(255, 215, 90) }))
	local yaw = Kit.Rng:NextNumber(0, math.pi * 2)
	for i = 0, 4 do
		local a = yaw + i * math.pi * 2 / 5
		Kit.Part(parent, V(0.9, 0.12, 2.6), CFrame.new(x + math.cos(a) * 1.2, 0.08, z + math.sin(a) * 1.2) * CFrame.Angles(0, -a + math.pi / 2, 0), col)
	end
end

local function brokenColumn(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "BrokenColumn")
	local h = rng:NextNumber(6, 18)
	Kit.Box(m, V(x - 2.6, 0, z - 2.6), V(x + 2.6, 1.2, z + 2.6), MARBLE_T, SOLID_MARBLE)
	Kit.Cyl(m, h, 3.6, CFrame.new(x, 1.2 + h / 2, z), MARBLE_C, SOLID_MARBLE)
	if h > 12 then
		Kit.Box(m, V(x - 2.4, 1.2 + h, z - 2.4), V(x + 2.4, 2.4 + h, z + 2.4), Kit.Vivid(GOLD), GOLD_M)
	else
		Kit.CylFlat(m, 6, 3.6, V(x + (if x > 0 then 3.2 else -3.2), 1.8, z + 3.5), "Z", MARBLE_C, { Mat = MARBLE })
		Kit.Ball(m, 2.2, V(x, 1.2 + h + 0.4, z), Kit.Vivid(CORAL), { Mat = PEBBLE })
	end
	Kit.AddCircle(x, z, 4)
end

local function chest(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "TreasureChest")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(m, V(6, 3.4, 4), base * CFrame.new(0, 1.7, 0), WOODC, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(6.3, 0.5, 4.3), base * CFrame.new(0, 3.05, 0), gold, GOLD_M) -- top below the box top (no z-fight)
	Kit.Part(m, V(6, 0.6, 4), base * CFrame.new(0, 4.6, 2.6) * CFrame.Angles(-1.1, 0, 0), WOODC, { Mat = WOOD })
	Kit.Part(m, V(0.8, 1.2, 0.3), base * CFrame.new(0, 2.6, -2.1), gold, GOLD_M)
	-- coin pile spilling out the front + a couple of gems
	for i = 0, 3 do
		Kit.Ball(m, 2.4 - i * 0.3, (base * CFrame.new(-1.5 + i, 3.4 - i * 0.6, -0.6 - i * 0.9)).Position, gold, GOLD_M)
	end
	Kit.Ball(m, 1.1, (base * CFrame.new(1.6, 3.8, 0)).Position, Kit.Vivid(C(230, 60, 110)), { Refl = 0.3 })
	Kit.Ball(m, 1, (base * CFrame.new(-1.8, 3.7, 0.6)).Position, Kit.Vivid(C(70, 200, 255)), { Refl = 0.3 })
	Kit.AddCircle(x, z, 5)
end

local function clam(parent: Instance, x: number, z: number, d: number, glow: boolean): Part
	local m = Kit.Model(parent, "GiantClam")
	local R = d / 2
	local shell = C(230, 170, 215)
	local rib = C(250, 215, 240)
	Kit.Disc(m, x, z, 1.6, d, 1.6, shell, { Solid = true, Shadow = true })
	Kit.Disc(m, x, z, 1.8, d - 2, 0.3, C(255, 205, 220))
	-- upper shell hinged at the back (+Z), opening toward -Z
	local hinge = CFrame.new(x, 1.8, z + R) * CFrame.Angles(0.65, 0, 0)
	Kit.Cyl(m, 1.4, d, hinge * CFrame.new(0, 0.7, -R), shell, { Shadow = true })
	for i = -2, 2 do
		local a = i * 0.32
		Kit.Part(m, V(0.6, 0.4, R * 1.7), hinge * CFrame.new(0, 1.5, -R) * CFrame.Angles(0, a, 0), rib)
	end
	local pearlOpts: Kit.Opts = if glow then { Mat = NEON } else { Refl = 0.35 }
	local pearl = Kit.Ball(m, d * 0.28, V(x, 1.8 + d * 0.14, z - R * 0.15), PEARL, pearlOpts)
	if glow then
		Kit.Light(pearl, C(220, 240, 255), 28, 1.4)
	end
	Kit.AddCircle(x, z, R + 2)
	return pearl
end

local function seaLantern(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "SeaLantern")
	Kit.Disc(m, x, z, 0.8, 3, 0.8, MARBLE_T, { Mat = MARBLE })
	Kit.Cyl(m, 9, 0.7, CFrame.new(x, 5.2, z), Kit.Vivid(GOLD), GOLD_M)
	-- shell cup holding a glowing sea-glass orb
	Kit.Cyl(m, 0.8, 3.4, CFrame.new(x, 10, z), Kit.Vivid(CORAL))
	local orb = Kit.Ball(m, 2.4, V(x, 11.4, z), AQUA, { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(orb, AQUA, 24, 1.4)
	end
	Kit.AddCircle(x, z, 2.5)
end

--==================================================================
-- GROUND, WALLS, OUTSIDE, WATER
--==================================================================
local function ground(f: Instance)
	local rng = Kit.Rng
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SANDC, { Mat = SAND, Solid = true, Name = "Ground_Sunken" })
	-- marble-tile avenue with teal edging and gold mosaic bands
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), MARBLE_C, { Mat = MARBLE, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, Z0), V(s * 10, 0.08, Z1), Kit.Vivid(TEAL))
	end
	for z = Z0 + 40, Z1 - 20, 40 do
		Kit.Box(f, V(-9, 0.05, z - 0.8), V(9, 0.08, z + 0.8), Kit.Vivid(GOLD), GOLD_M)
	end
	-- darker sand ripples (flat)
	for _ = 1, 8 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 20)
		if math.abs(x) > 26 then
			Kit.Part(f, V(rng:NextNumber(18, 30), 0.04, 3), CFrame.new(x, 0.02, z) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), SAND_D, { Mat = SAND })
		end
	end
	-- mosaic discs on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, Kit.Vivid(if i % 2 == 0 then SEA else TEAL), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, MARBLE_T, { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.13, 10, 0.13, Kit.Vivid(GOLD), GOLD_M)
	end
	-- boss: deep-blue mosaic with a gold trident star and a glowing heart
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, Kit.Vivid(GOLD), GOLD_M)
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, DEEP, { Mat = MARBLE })
	for i = 0, 5 do
		local a = i * math.pi / 3
		Props.Beam(f, V(math.cos(a) * 4, 0.14, BOSS_Z + math.sin(a) * 4), V(math.cos(a) * 22, 0.14, BOSS_Z + math.sin(a) * 22), 1.2, 0.06, Kit.Vivid(GOLD), GOLD_M)
	end
	Kit.Disc(f, 0, BOSS_Z, 0.18, 7, 0.06, AQUA, { Mat = NEON, Transp = 0.15 })
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 26, z1), REEF, { Mat = ROCK, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 26, z0), V(s * 146.4, 27.2, z1), SAND_D, { Mat = Enum.Material.Sandstone })
		Kit.Box(f, V(s * 139.7, 18, z0), V(s * 140, 19.2, z1), Kit.Vivid(TEAL))
		-- coral growing over the wall top
		for z = z0 + 14, z1 - 10, 30 do
			local c = Kit.Vivid(Kit.Pick({ CORAL, CORAL_O, CORAL_P }))
			Kit.Ball(f, rng:NextNumber(6, 9), V(s * 143, 28, z), c, { Mat = PEBBLE })
			Kit.Ball(f, rng:NextNumber(3.5, 5), V(s * 142, 30.5, z + 4), c:Lerp(Color3.new(1, 1, 1), 0.2), { Mat = PEBBLE })
		end
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local hills = { REEF, C(90, 110, 160), C(110, 150, 140) }
	for i = 0, 4 do
		local z = Z0 + 30 + i * 75
		for _, s in { -1, 1 } do
			Kit.Ball(f, rng:NextNumber(60, 80), V(s * rng:NextNumber(185, 200), -16, z + s * 15), Kit.Pick(hills), { Mat = ROCK })
			-- coral spire
			local x = s * rng:NextNumber(158, 168)
			local h = rng:NextNumber(30, 48)
			local c = Kit.Vivid(Kit.Pick({ CORAL, CORAL_O, CORAL_P }))
			Kit.Cyl(f, h, 5, CFrame.new(x, h / 2, z + 30), c)
			Kit.Ball(f, 8, V(x, h, z + 30), c:Lerp(Color3.new(1, 1, 1), 0.2), { Mat = PEBBLE })
			Kit.Ball(f, 5, V(x + s * 3, h * 0.6, z + 32), c, { Mat = PEBBLE })
			-- tall kelp forest
			for k = 0, 2 do
				local hh = rng:NextNumber(36, 60)
				local cf = CFrame.new(s * (151 + k * 5), hh / 2, z + 6 + k * 7) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.08, 0.08))
				Kit.Part(f, V(1.2, hh, 3.6), cf, Kit.Pick(KELP), { Mat = Enum.Material.Grass })
			end
		end
	end
end

local function water(f: Instance)
	Kit.Box(f, V(-190, 120, Z0), V(190, 121, Z1), C(70, 180, 215), { Transp = 0.85, Name = "WaterSurface", Shadow = false })
	-- soft light shafts (kept outside the ghost areas)
	for _, p in { { -118, Z0 + 52 }, { 116, Z0 + 120 }, { -24, Z0 + 205 }, { 48, Z0 + 262 } } do
		Kit.Part(f, V(6, 110, 14), CFrame.new(p[1], 64, p[2]) * CFrame.Angles(0, 0.4, 0.12), C(200, 245, 255), { Transp = 0.9, Name = "LightShaft", Shadow = false })
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function gateArch(f: Instance)
	local m = Kit.Model(f, "AtlantisArch")
	local z = Z0 + 48
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 13.5, 0, z - 4), V(s * 20.5, 2.5, z + 4), MARBLE_T, SOLID_MARBLE)
		Kit.Cyl(m, 27.5, 5.5, CFrame.new(s * 17, 2.5 + 13.75, z), MARBLE_C, SOLID_MARBLE)
		for _, y in { 8, 18 } do
			Kit.Cyl(m, 0.8, 6, CFrame.new(s * 17, y, z), Kit.Vivid(TEAL))
		end
		Kit.Ball(m, 5, V(s * 19, 4.5, z - 3), Kit.Vivid(CORAL), { Mat = PEBBLE })
		Kit.AddRect(s * 12.5, z - 4.5, s * 21.5, z + 4.5)
	end
	Kit.Box(m, V(-22, 30, z - 3.5), V(22, 34, z + 3.5), MARBLE_C, SOLID_MARBLE)
	Kit.Box(m, V(-22.4, 30, z - 3.7), V(22.4, 30.8, z + 3.7), Kit.Vivid(GOLD), GOLD_M)
	-- pediment (two wedges meeting in the middle)
	Kit.Wedge(m, V(7, 7, 22), CFrame.new(-11, 37.5, z) * CFrame.Angles(0, -math.pi / 2, 0), MARBLE_C, { Mat = MARBLE })
	Kit.Wedge(m, V(7, 7, 22), CFrame.new(11, 37.5, z) * CFrame.Angles(0, math.pi / 2, 0), MARBLE_C, { Mat = MARBLE })
	local crystal = Kit.Part(m, V(3, 3, 3), CFrame.new(0, 43.5, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), AQUA, { Mat = NEON })
	Kit.Light(crystal, AQUA, 30, 1.4)
	Props.SignBoard(m, V(0, 32, z - 3.9), 30, 3.4, 0, -1, "~ SUNKEN CITY ~", DEEP, Kit.Vivid(GOLD))
end

local function temple(f: Instance)
	local m = Kit.Model(f, "DomedTemple")
	local x, z = -100, Z0 + 312
	local gold = Kit.Vivid(GOLD)
	Kit.Disc(m, x, z, 2, 48, 2, MARBLE_T, SOLID_MARBLE)
	Kit.Disc(m, x, z, 4, 44, 2, MARBLE_C, SOLID_MARBLE)
	Kit.Disc(m, x, z, 6, 40, 2, MARBLE_T, SOLID_MARBLE)
	-- ring of columns
	for i = 0, 9 do
		local a = i * math.pi / 5
		local cx, cz = x + math.cos(a) * 17, z + math.sin(a) * 17
		Kit.Cyl(m, 30, 3.4, CFrame.new(cx, 21, cz), MARBLE_C, SOLID_MARBLE)
		Kit.Box(m, V(cx - 2.2, 35, cz - 2.2), V(cx + 2.2, 36.4, cz + 2.2), gold, GOLD_M)
	end
	-- inner cella with a door toward the avenue
	Kit.Cyl(m, 28, 22, CFrame.new(x, 20, z), C(150, 205, 200), SOLID_MARBLE)
	Kit.Box(m, V(x + 10.5, 6, z - 3.5), V(x + 11.2, 18, z + 3.5), C(30, 60, 90))
	Kit.Box(m, V(x + 10.6, 18, z - 4.3), V(x + 11.3, 19, z + 4.3), gold, GOLD_M)
	-- entablature, drum, dome
	Kit.Cyl(m, 4, 40, CFrame.new(x, 38, z), MARBLE_C, { Mat = MARBLE, Shadow = true })
	Kit.Cyl(m, 0.8, 40.6, CFrame.new(x, 36.6, z), gold, GOLD_M)
	Kit.Cyl(m, 6, 32, CFrame.new(x, 43, z), MARBLE_T, { Mat = MARBLE, Shadow = true })
	Kit.Ball(m, 32, V(x, 46, z), C(80, 190, 175), { Shadow = true, Refl = 0.1 })
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Props.Beam(m, V(x + math.cos(a) * 15.6, 47, z + math.sin(a) * 15.6), V(x + math.cos(a) * 3, 61.6, z + math.sin(a) * 3), 0.9, 0.9, gold, GOLD_M)
	end
	-- lantern with the glowing pearl
	Kit.Cyl(m, 1, 9, CFrame.new(x, 62.5, z), gold, GOLD_M)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Cyl(m, 6, 0.8, CFrame.new(x + math.cos(a) * 3.4, 66, z + math.sin(a) * 3.4), gold, GOLD_M)
	end
	local pearl = Kit.Ball(m, 4.2, V(x, 66, z), PEARL, { Mat = NEON })
	Kit.Light(pearl, C(200, 240, 255), 40, 1.6)
	Kit.Cyl(m, 1.2, 9, CFrame.new(x, 69.6, z), gold, GOLD_M)
	-- giant trident on top
	Kit.Cyl(m, 22, 1.2, CFrame.new(x, 81, z), gold, GOLD_M)
	Kit.Box(m, V(x - 5, 91.4, z - 0.6), V(x + 5, 92.6, z + 0.6), gold, GOLD_M)
	for _, dx in { -4.4, 0, 4.4 } do
		local top = if dx == 0 then 101 else 98
		Kit.Box(m, V(x + dx - 0.6, 92.6, z - 0.6), V(x + dx + 0.6, top, z + 0.6), gold, GOLD_M)
		Kit.Wedge(m, V(1.2, 2, 1.2), CFrame.new(x + dx, top + 1, z), gold, GOLD_M)
	end
	-- bubbles rising from the dome
	local src = Kit.Part(m, V(10, 0.4, 10), CFrame.new(x, 63, z), AQUA, { Transp = 1, Name = "BubbleSource" })
	local e = Kit.Emitter(src, C(210, 250, 255), 3, 2, 3)
	if e then
		e.Acceleration = V(0, 2, 0)
	end
	Props.SignBoard(m, V(x + 11.6, 22.5, z), 11, 2.6, 1, 0, "TEMPLE OF TIDES", DEEP, Kit.Vivid(GOLD))
	Kit.AddCircle(x, z, 25)
end

local function ship(f: Instance)
	local m = Kit.Model(f, "SunkenShip")
	local hull = C(120, 85, 65)
	local plank = C(150, 110, 80)
	local base = CFrame.new(104, 3, Z0 + 296) * CFrame.Angles(0, -0.35, 0) * CFrame.Angles(0.28, 0, 0.12)
	local so: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	Kit.Part(m, V(16, 14, 40), base, hull, so)
	Kit.Part(m, V(11.3, 14, 11.3), base * CFrame.new(0, 0, -20) * CFrame.Angles(0, math.pi / 4, 0), hull, so)
	Kit.Part(m, V(15.4, 0.6, 40), base * CFrame.new(0, 7.2, 0), plank, { Mat = WOOD })
	Kit.Part(m, V(16.4, 1.2, 40.4), base * CFrame.new(0, 2, 0), Kit.Vivid(C(220, 70, 70)), { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, 2, 38), base * CFrame.new(sx * 7.8, 8.5, 1), plank, { Mat = WOOD })
		for i = 0, 2 do
			Kit.Part(m, V(0.4, 2.6, 2.6), base * CFrame.new(sx * 8.1, 4.5, -10 + i * 9), Kit.Vivid(GOLD), { Mat = METAL, Shape = Enum.PartType.Cylinder })
			Kit.Part(m, V(0.5, 1.8, 1.8), base * CFrame.new(sx * 8.15, 4.5, -10 + i * 9), C(40, 70, 100), { Shape = Enum.PartType.Cylinder })
		end
	end
	-- bowsprit, broken mast and a tattered sail
	Kit.Part(m, V(1.2, 1.2, 14), base * CFrame.new(0, 7, -30) * CFrame.Angles(0.25, 0, 0), plank, { Mat = WOOD })
	local mast = base * CFrame.new(0, 7, -6) * CFrame.Angles(0, 0, 0.35)
	Kit.Part(m, V(1.8, 26, 1.8), mast * CFrame.new(0, 13, 0), WOODC, { Mat = WOOD })
	Kit.Part(m, V(0.2, 12, 14), mast * CFrame.new(0.4, 16, 0), C(240, 230, 205), { Mat = FABRIC, Transp = 0.1 })
	Kit.Part(m, V(1, 1, 16), mast * CFrame.new(0, 22, 0), WOODC, { Mat = WOOD })
	-- lantern hanging from the bowsprit
	local lantern = Kit.Part(m, V(1.6, 2.2, 1.6), base * CFrame.new(0, 5.5, -33), C(255, 210, 120), { Mat = NEON })
	Kit.Light(lantern, C(255, 200, 120), 26, 1.3, true)
	-- name board on the stern deck
	local sign = Kit.Part(m, V(9, 2.6, 0.4), base * CFrame.new(0, 10.3, 19.5) * CFrame.Angles(0, math.pi, 0), DEEP)
	Kit.Sign(sign, Enum.NormalId.Front, "S.S. BOO-NANZA", Kit.Vivid(GOLD))
	Kit.AddRect(80, Z0 + 262, 128, Z0 + 340)
end

local function seaLife(f: Instance)
	-- floating jellyfish and fish (single tagged parts, outside the ghost areas)
	for _, p in { V(-30, 26, Z0 + 150), V(40, 32, Z0 + 230), V(-116, 30, Z0 + 190), V(112, 28, Z0 + 92) } do
		local j = Kit.Ball(f, 4, p, Kit.Vivid(Kit.Pick({ CORAL, CORAL_P, C(255, 170, 220) })), { Transp = 0.35, Name = "Jellyfish" })
		Kit.Float(j, 2)
	end
	for _, p in { V(26, 18, Z0 + 140), V(-30, 22, Z0 + 290), V(120, 16, Z0 + 230) } do
		local fish = Kit.Part(f, V(1.4, 2.2, 4), CFrame.new(p) * CFrame.Angles(0, Kit.Rng:NextNumber(0, 6), 0), Kit.Vivid(Kit.Pick({ CORAL_O, C(255, 215, 80), SEA })), { Name = "Fish" })
		Kit.Float(fish, 1.5)
	end
end

local function scatter(f: Instance)
	local rng = Kit.Rng
	-- broken columns lining the avenue
	for z = Z0 + 128, Z1 - 70, 26 do
		for _, s in { -1, 1 } do
			local x = s * 16
			if Kit.IsFree(x, z, 3.5) then
				brokenColumn(f, x, z)
			end
		end
	end
	-- giant clams
	if Kit.IsFree(-104, Z0 + 52, 9) then
		clam(f, -104, Z0 + 52, 14, true)
	end
	if Kit.IsFree(118, Z0 + 140, 8) then
		clam(f, 118, Z0 + 140, 12, false)
	end
	if Kit.IsFree(-34, Z0 + 320, 7) then
		local pearl = clam(f, -34, Z0 + 320, 10, false)
		local e = Kit.Emitter(pearl, C(210, 250, 255), 2, 1.6, 2.5)
		if e then
			e.Acceleration = V(0, 2.5, 0)
		end
	end
	-- treasure
	for _, p in { { 84, Z0 + 248, -1, -1 }, { -64, Z0 + 320, 1, 0 }, { 120, Z0 + 352, -1, 0 } } do
		if Kit.IsFree(p[1], p[2], 5) then
			chest(f, p[1], p[2], p[3], p[4])
		end
	end
	-- sea lanterns along the avenue
	for i, p in { { -14, Z0 + 118 }, { 14, Z0 + 118 }, { -14, Z0 + 265 }, { 14, Z0 + 265 } } do
		if Kit.IsFree(p[1], p[2], 2.5) then
			seaLantern(f, p[1], p[2], i == 1 or i == 4)
		end
	end
	-- coral reefs and kelp
	local corals, kelps, stars = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 30, Z1 - 10)
		if corals < 14 and Kit.IsFree(x, z, 6) then
			corals += 1
			coral(f, x, z, rng:NextNumber(0.9, 1.3))
		elseif kelps < 10 and Kit.IsFree(x, z, 3) then
			kelps += 1
			kelp(f, x, z, rng:NextNumber(14, 30))
		elseif stars < 8 and math.abs(x) > 12 then
			stars += 1
			starfish(f, x, z)
		end
	end
	-- glowing anemone patches (flat neon accents)
	for _, p in { V(-48, 0, Z0 + 60), V(46, 0, Z0 + 330), V(-122, 0, Z0 + 270) } do
		Kit.Disc(f, p.X, p.Z, 0.2, 3.5, 0.1, AQUA, { Mat = NEON, Transp = 0.2 })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Sunken.Build(map: Instance)
	local f = Kit.Folder(map, "Sunken")
	ground(f)
	sideWalls(f)
	outside(f)
	water(f)
	gateArch(f)
	temple(f)
	ship(f)
	seaLife(f)
	scatter(f)
end

return Sunken
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Swamp</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 9: Phantom Swamp (Z 2680..3040). A misty, moss-green bayou: cute-spooky, not dark.
--   Ground: grass slab (top Y = 0) with flat mud patches and shallow water: translucent teal
--   sheets lying on the solid ground (no pits anywhere).
--   Main path: a plank boardwalk along X = 0 (X -8..8, top 0.05) from gate to gate.
--   Ghost areas hold flat paint only: lily-pad ponds either side of the boardwalk, moss clearings,
--   a wide lily pond and the boss bog ring around (0, 2985) with lime ectoplasm runes.
--   Landmark: the SWAMP KING, a giant gnarled cypress wearing a golden crown at (100, 2970),
--   ~90 tall, seen through the Spirit Realm portal arch.
--   Also: an old stranded paddle boat "Swamp Queen" (100, 2775), three crooked stilt shacks
--   (two with raised side boardwalks), cypress trees with hanging moss, reeds, glowing
--   mushrooms, fireflies, frogs and lanterns. Side walls: mossy plank palisade at X +-140..146.
--   Outside: open bayou water with cypress silhouettes and low fog banks.
-- Glow is limited to fireflies, a few mushroom caps, shack windows, lanterns, the boss runes,
-- the paddle boat's bow lamp and the Swamp King's eyes.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Swamp = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local GRASS = Enum.Material.Grass
local MUD = Enum.Material.Mud
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal

local Z0, Z1 = 2680, 3040

local GROUND = C(88, 128, 66)
local MUDC = C(104, 84, 58)
local WATER = C(64, 140, 120)
local WATER_DEEP = C(48, 112, 104)
local BARK = C(92, 70, 52)
local BARK_DARK = C(70, 54, 42)
local PLANK = C(150, 112, 74)
local PLANK_DARK = C(104, 76, 52)
local MOSS = C(96, 150, 70)
local MOSS_LIGHT = C(140, 180, 96)
local HANGMOSS = C(160, 182, 132)
local LIME = C(170, 255, 110)
local WARM = C(255, 220, 130)
local LILY = C(90, 170, 80)
local GOLD = C(255, 200, 60)
local CANOPY = { C(70, 125, 62), C(86, 140, 70), C(62, 112, 70), C(98, 150, 78) }
local SHACKS = { C(110, 150, 140), C(150, 120, 160), C(160, 130, 90) }

local function rz(n: number): number
	return Z0 + n
end

-- Plan-view triangle (local Y y0..y1): right angle at (xEdge, zBase), point at (xEdge, zTip > zBase).
local function bowHalf(parent: Instance, base: CFrame, xEdge: number, xOuter: number, zBase: number, zTip: number, y0: number, y1: number, color: Color3, opts: Kit.Opts)
	local s = if xOuter > xEdge then 1 else -1
	local center = V((xEdge + xOuter) / 2, (y0 + y1) / 2, (zBase + zTip) / 2)
	local cf = base * CFrame.fromMatrix(center, V(0, s, 0), V(s, 0, 0))
	Kit.Wedge(parent, V(y1 - y0, math.abs(xOuter - xEdge), zTip - zBase), cf, color, opts)
end

-- Gable roof, ridge along local X, bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = true, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Shallow water sheet (non-solid) with a mud rim, lying on the solid ground; top at Y 0.1.
local function pond(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.04, d + 4, 0.03, MUDC, { Mat = MUD })
	Kit.Disc(parent, x, z, 0.1, d, 0.06, WATER, { Transp = 0.2, Refl = 0.15, Name = "Water" })
end

local function lilyPad(parent: Instance, x: number, z: number, d: number, flower: boolean)
	Kit.Disc(parent, x, z, 0.14, d, 0.03, Kit.Vivid(LILY))
	if flower then
		Kit.Disc(parent, x + d * 0.15, z, 0.2, d * 0.35, 0.06, Kit.Vivid(C(255, 150, 200)))
	end
end

--==================================================================
-- PROPS
--==================================================================
local function cypress(parent: Instance, pos: Vector3, h: number)
	local rng = Kit.Rng
	local wood: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	Kit.Cyl(parent, 3, 5.5, CFrame.new(pos + V(0, 1.5, 0)), BARK_DARK, wood)
	local trunkCf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
	Kit.Cyl(parent, h, 2.4, trunkCf * CFrame.new(0, h / 2, 0), BARK, wood)
	-- cypress knees poking out of the mud
	for k = 1, 2 do
		local a = rng:NextNumber(0, math.pi * 2)
		local kh = rng:NextNumber(1.2, 2.4)
		Kit.Cyl(parent, kh, 0.9, CFrame.new(pos + V(math.cos(a) * (3.5 + k), kh / 2, math.sin(a) * (3.5 + k))), BARK)
	end
	-- flat-topped canopy layers
	local top = (trunkCf * CFrame.new(0, h, 0)).Position
	local col = Kit.Pick(CANOPY)
	local d = h * 0.75
	Kit.Cyl(parent, 2.6, d, CFrame.new(top + V(0, -1, 0)), col, { Mat = GRASS, Shadow = true })
	Kit.Cyl(parent, 2.4, d * 0.65, CFrame.new(top + V(rng:NextNumber(-1.5, 1.5), 1.2, rng:NextNumber(-1.5, 1.5))), col:Lerp(Color3.new(1, 1, 1), 0.12), { Mat = GRASS })
	Kit.Ball(parent, d * 0.4, top + V(rng:NextNumber(-2, 2), -2.2, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(0, 0, 0), 0.1), { Mat = GRASS })
	-- hanging moss strands under the canopy edge
	for k = 0, 2 do
		local a = k * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = rng:NextNumber(4, 7)
		local p = top + V(math.cos(a) * d * 0.38, -2.3 - len / 2, math.sin(a) * d * 0.38)
		Kit.Part(parent, V(0.6, len, 1.6), CFrame.new(p) * CFrame.Angles(0, a, 0), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, d / 2)
end

local function reeds(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	for k = 0, 2 do
		local h = rng:NextNumber(4, 6.5)
		local p = V(x + rng:NextNumber(-1.2, 1.2), 0, z + rng:NextNumber(-1.2, 1.2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15))
		Kit.Cyl(parent, h, 0.3, cf * CFrame.new(0, h / 2, 0), C(110, 160, 80))
		if k < 2 then
			Kit.Cyl(parent, 1.6, 0.75, cf * CFrame.new(0, h - 1.2, 0), C(120, 80, 50), { Mat = FABRIC })
		end
	end
	Kit.AddCircle(x, z, 2)
end

local function mushrooms(parent: Instance, x: number, z: number, glow: boolean)
	local rng = Kit.Rng
	local caps = { C(170, 255, 110), C(110, 240, 210), C(200, 150, 255) }
	for _ = 1, 3 do
		local p = V(x + rng:NextNumber(-1.8, 1.8), 0, z + rng:NextNumber(-1.8, 1.8))
		local h = rng:NextNumber(1, 2.6)
		Kit.Cyl(parent, h, 0.6, CFrame.new(p + V(0, h / 2, 0)), C(240, 236, 220))
		local cap = Kit.Pick(caps)
		Kit.Cyl(parent, 0.8, rng:NextNumber(1.8, 2.8), CFrame.new(p + V(0, h + 0.3, 0)), if glow then cap else Kit.Vivid(cap), if glow then { Mat = NEON } else {})
	end
	Kit.AddCircle(x, z, 2.5)
end

local function frog(parent: Instance, x: number, z: number, fx: number, fz: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Disc(parent, x, z, 0.14, 4.4, 0.03, Kit.Vivid(LILY))
	Kit.Part(parent, V(2.4, 1.4, 2.2), base * CFrame.new(0, 0.9, 0), Kit.Vivid(C(110, 200, 90)))
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.9, (base * CFrame.new(s * 0.65, 1.75, -0.5)).Position, C(250, 250, 240))
		Kit.Ball(parent, 0.45, (base * CFrame.new(s * 0.65, 1.8, -0.88)).Position, C(30, 30, 40))
	end
	Kit.Part(parent, V(1.4, 0.15, 0.2), base * CFrame.new(0, 0.85, -1.12), Kit.Vivid(C(255, 120, 150)))
	Kit.AddCircle(x, z, 3)
end

local function fallenLog(parent: Instance, x: number, z: number, yaw: number, len: number)
	local cf = CFrame.new(x, 1.1, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(parent, V(len, 2.2, 2.2), cf, BARK, { Mat = WOOD, Shape = Enum.PartType.Cylinder, Solid = true })
	Kit.Part(parent, V(len * 0.5, 0.4, 1.6), cf * CFrame.new(len * 0.1, 1.05, 0), MOSS, { Mat = GRASS })
	Kit.AddCircle(x, z, len / 2)
end

-- Crooked stilt shack whose front (door, ramp) faces (fx, 0); a little pond under it.
local function shack(parent: Instance, x: number, z: number, fx: number, col: Color3, lit: boolean, flicker: boolean)
	local m = Kit.Model(parent, "StiltShack")
	pond(m, x, z, 20)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local tilt = base * CFrame.Angles(0, 0, 0.04)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Cyl(m, 5.2, 1.1, base * CFrame.new(sx * 6, 2.6, sz * 5), BARK_DARK, { Mat = WOOD, Solid = true })
		end
	end
	Kit.Part(m, V(14, 1, 12), base * CFrame.new(0, 4.6, 0), PLANK, { Mat = PLANKS, Solid = true, Shadow = true })
	Kit.Part(m, V(10, 8, 8), tilt * CFrame.new(0, 9.1, 1), col, { Mat = PLANKS, Solid = true, Shadow = true })
	gable(m, tilt * CFrame.new(0, 13.1, 1), 12, 10.5, 4.5, C(150, 96, 70), Enum.Material.CorrodedMetal)
	-- door + window on the front (local -Z)
	Kit.Part(m, V(2.6, 5, 0.3), tilt * CFrame.new(-2, 7.6, -3.1), PLANK_DARK, { Mat = WOOD })
	local win = Kit.Part(m, V(2.6, 2.2, 0.3), tilt * CFrame.new(2.4, 9.4, -3.1), WARM, if lit then { Mat = NEON } else {})
	Kit.Part(m, V(3.2, 0.4, 0.4), tilt * CFrame.new(2.4, 8.2, -3.2), PLANK_DARK)
	if lit then
		Kit.Light(win, WARM, 20, 1.3, flicker)
	end
	-- crooked stovepipe, porch rail and a ramp down to the mud
	Kit.Cyl(m, 5, 1, tilt * CFrame.new(3.5, 15, 3) * CFrame.Angles(0, 0, 0.15), C(70, 70, 80), { Mat = METAL })
	Kit.Part(m, V(14, 0.3, 0.3), base * CFrame.new(0, 7, -5.8), PLANK_DARK, { Mat = WOOD })
	Kit.Wedge(m, V(3.4, 4.6, 7), base * CFrame.new(-2, 2.3, -9.5), PLANK, { Mat = PLANKS, Solid = true })
	Kit.AddCircle(x, z, 12)
end

-- Raised boardwalk (top 0.6, a walkable step) along X at z.
local function sideWalk(parent: Instance, x1: number, x2: number, z: number)
	local lo, hi = math.min(x1, x2), math.max(x1, x2)
	Kit.Box(parent, V(lo, 0, z - 2.2), V(hi, 0.6, z + 2.2), PLANK, { Mat = PLANKS, Solid = true, Name = "SideBoardwalk" })
	local x = lo + 4
	while x < hi - 2 do
		for _, s in { -1, 1 } do
			Kit.Cyl(parent, 2.4, 0.7, CFrame.new(x, 1.2, z + s * 2.3), PLANK_DARK, { Mat = WOOD })
		end
		x += 16
	end
	Kit.AddRect(lo, z - 3, hi, z + 3)
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), GROUND, { Mat = GRASS, Solid = true, Name = "Ground_Swamp" })
	-- boardwalk along X = 0 with dark edge boards and cross seams
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PLANK, { Mat = PLANKS, Solid = true, Name = "Boardwalk" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.5, 0.05, Z0), V(s * 8 + 0.5, 0.11, Z1), PLANK_DARK, { Mat = WOOD })
	end
	for z = Z0 + 10, Z1 - 10, 22 do
		Kit.Box(f, V(-7.5, 0.05, z), V(7.5, 0.08, z + 0.6), PLANK_DARK, { Mat = WOOD })
	end
	-- flat mud patches
	local rng = Kit.Rng
	for _ = 1, 9 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(14, 26), 0.03, rng:NextNumber(10, 22)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), MUDC, { Mat = MUD })
		end
	end
	-- winding water channels along both sides (flat sheets on solid ground)
	local channels = {
		{ V(-122, 0, rz(70)), V(-128, 0, rz(130)), V(-116, 0, rz(190)), V(-124, 0, rz(250)), V(-112, 0, rz(320)) },
		{ V(124, 0, rz(150)), V(116, 0, rz(210)), V(124, 0, rz(250)) },
	}
	for _, ch in channels do
		for i = 1, #ch - 1 do
			local a, b = ch[i], ch[i + 1]
			local d = b - a
			local mid = (a + b) / 2
			local rot = CFrame.Angles(0, math.atan2(-d.X, -d.Z), 0)
			Kit.Part(f, V(13, 0.03, d.Magnitude + 8), CFrame.new(mid.X, 0.025, mid.Z) * rot, MUDC, { Mat = MUD })
			Kit.Part(f, V(9, 0.06, d.Magnitude + 6), CFrame.new(mid.X, 0.07, mid.Z) * rot, WATER_DEEP, { Transp = 0.2, Refl = 0.15, Name = "Water" })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 11, zB), PLANK_DARK, { Mat = PLANKS, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 11, zA), V(s * 146.4, 12.2, zB), MOSS, { Mat = GRASS })
		Kit.Box(f, V(s * 139.85, 2.5, zA), V(s * 139.65, 3.1, zB), Kit.Vivid(C(150, 230, 90)))
		for z = zA + 12, zB - 6, 36 do
			Kit.Cyl(f, 15, 3.2, CFrame.new(s * 143, 7.5, z), BARK, { Mat = WOOD, Solid = true })
			Kit.Ball(f, 4, V(s * 143, 15.4, z), Kit.Pick(CANOPY), { Mat = GRASS })
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- bog wisps: lily ponds either side of the boardwalk on a moss clearing
	local cz = rz(85)
	Kit.Disc(f, 0, cz, 0.03, 64, 0.02, MOSS_LIGHT, { Mat = GRASS })
	for _, s in { -1, 1 } do
		pond(f, s * 19.5, cz, 18)
		pond(f, s * 21, cz - 18, 9)
		pond(f, s * 20, cz + 18, 10)
		lilyPad(f, s * 16, cz - 3, 4, s > 0)
		lilyPad(f, s * 23, cz + 4, 3.2, s < 0)
		lilyPad(f, s * 20, cz + 18, 3, false)
	end
	-- moss clearings with mud rims
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 4, 0.03, MUDC, { Mat = MUD })
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, MOSS_LIGHT, { Mat = GRASS })
		pond(f, a[1] + 6, a[2] - 4, 12)
		lilyPad(f, a[1] + 8, a[2] - 3, 3.4, true)
	end
	-- marsh phantoms: a wide lily pond
	pond(f, 75, rz(180), 44)
	for _, l in { { 66, rz(172), 4.5 }, { 84, rz(186), 3.6 }, { 72, rz(194), 3 }, { 88, rz(170), 4.2 } } do
		lilyPad(f, l[1], l[2], l[3], l[3] > 4)
	end
	-- boss bog: mud ring, two murky pools and lime ectoplasm runes
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, MUDC, { Mat = MUD })
	for _, s in { -1, 1 } do
		pond(f, s * 17, bz, 15)
		lilyPad(f, s * 16, bz + 3, 3.6, s > 0)
	end
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.14
		local a2 = a1 + math.pi / 4 - 0.28
		Props.Beam(f, V(math.cos(a1) * 25, 0.13, bz + math.sin(a1) * 25), V(math.cos(a2) * 25, 0.13, bz + math.sin(a2) * 25), 0.5, 0.06, LIME, { Mat = NEON })
	end
	local core = Kit.Disc(f, 0, bz, 0.12, 6, 0.05, Kit.Vivid(LIME), { Transp = 0.3 })
	Kit.Light(core, LIME, 30, 1.2)
	local fog = Kit.Part(f, V(40, 0.2, 40), CFrame.new(0, 1, bz), C(200, 240, 200), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(200, 240, 200), 1.6, 9, 0.3)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function swampKing(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SwampKing")
	local wood: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	pond(m, x, z, 34)
	-- roots
	for i = 0, 5 do
		local a = i * math.pi / 3 + 0.3
		Props.Beam(m, V(x + math.cos(a) * 17, 0.3, z + math.sin(a) * 17), V(x + math.cos(a) * 6, 9, z + math.sin(a) * 6), 3.2, 3.2, BARK_DARK, { Mat = WOOD })
	end
	Kit.Cyl(m, 14, 18, CFrame.new(x, 7, z), BARK, wood)
	-- gnarled trunk
	local pts = { V(x, 12, z), V(x + 3, 26, z - 2), V(x - 2, 40, z + 2), V(x + 1, 54, z) }
	for i = 1, #pts - 1 do
		local w = 14 - i * 2.5
		Props.Beam(m, pts[i], pts[i + 1], w, w, if i % 2 == 0 then BARK_DARK else BARK, wood)
	end
	-- sleepy face on the side looking at the boardwalk (-X)
	Kit.Box(m, V(x - 9.4, 3.5, z - 3.5), V(x - 8.4, 6.5, z + 3.5), C(40, 30, 28))
	local eye: Part? = nil
	for _, s in { -1, 1 } do
		Kit.Ball(m, 4.2, V(x - 8.4, 10.5, z + s * 3.6), C(40, 30, 28))
		local e = Kit.Ball(m, 2.6, V(x - 9.6, 10.5, z + s * 3.6), LIME, { Mat = NEON })
		eye = eye or e
	end
	if eye then
		Kit.Light(eye, LIME, 26, 1.4)
	end
	-- branches
	for i = 0, 4 do
		local a = i * 1.26 + 0.5
		local from = pts[2 + (i % 3)]
		local tip = from + V(math.cos(a) * 18, 10 + i * 2, math.sin(a) * 18)
		Props.Beam(m, from, tip, 2.4, 2.4, BARK, { Mat = WOOD })
	end
	-- mossy crown
	local crown = { V(0, 62, 0), V(14, 58, 6), V(-12, 60, -8), V(6, 60, -14), V(-6, 58, 14), V(-2, 72, 2) }
	for i, c in crown do
		Kit.Ball(m, if i == 1 then 30 else 20, V(x, 0, z) + c, CANOPY[(i % #CANOPY) + 1], { Mat = GRASS, Shadow = true })
	end
	for i = 0, 5 do
		local a = i * 1.05
		local len = 10 + (i % 3) * 3
		Kit.Part(m, V(0.8, len, 2.4), CFrame.new(x + math.cos(a) * 16, 52 - len / 2, z + math.sin(a) * 16) * CFrame.Angles(0, a, 0), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
	end
	-- the golden crown
	local gold = Kit.Vivid(GOLD)
	Kit.Cyl(m, 5, 13, CFrame.new(x - 2, 85, z + 2), gold, { Mat = METAL, Refl = 0.2 })
	for i = 0, 4 do
		local a = i * math.pi * 2 / 5
		local p = V(x - 2 + math.cos(a) * 5.5, 88.5, z + 2 + math.sin(a) * 5.5)
		Kit.Part(m, V(2.4, 3.6, 2.4), CFrame.new(p) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, math.pi / 4), gold, { Mat = METAL })
		Kit.Ball(m, 1.3, p + V(0, 2.4, 0), Kit.Vivid(if i % 2 == 0 then C(230, 60, 90) else C(70, 200, 220)))
	end
	Kit.AddCircle(x, z, 22)
end

local function paddleBoat(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "PaddleBoat")
	pond(m, x, z, 56)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, 0, 0.05) -- listing a little in the mud
	local hull = C(222, 212, 182)
	local teal = Kit.Vivid(C(60, 160, 150))
	local red = Kit.Vivid(C(200, 80, 70))
	local sol: Kit.Opts = { Mat = PLANKS, Solid = true, Shadow = true }
	-- hull (along Z, stern at -Z), pointed bow
	Kit.Part(m, V(16, 6, 30), base * CFrame.new(0, 2, -4), hull, sol)
	bowHalf(m, base, 0, -8, 11, 21, -1, 5, hull, sol)
	bowHalf(m, base, 0, 8, 11, 21, -1, 5, hull, sol)
	Kit.Part(m, V(16.3, 0.8, 30.2), base * CFrame.new(0, 3.6, -4), teal, { Mat = WOOD })
	Kit.Part(m, V(15, 0.5, 29), base * CFrame.new(0, 5.25, -4), PLANK, { Mat = PLANKS })
	Kit.Part(m, V(16.4, 1.4, 8), base * CFrame.new(0, 0.4, 2), MOSS, { Mat = GRASS })
	-- cabins
	Kit.Part(m, V(11, 5.5, 20), base * CFrame.new(0, 8.25, -4), hull, sol)
	Kit.Part(m, V(11.3, 1.6, 20.3), base * CFrame.new(0, 9.4, -4), C(60, 90, 110))
	Kit.Part(m, V(14, 0.6, 24), base * CFrame.new(0, 11.3, -4), red, { Mat = WOOD })
	Kit.Part(m, V(7, 4, 7), base * CFrame.new(0, 13.6, 0), hull, { Mat = PLANKS })
	Kit.Part(m, V(7.3, 1.3, 7.3), base * CFrame.new(0, 14.2, 0), C(60, 90, 110))
	Kit.Part(m, V(8.5, 0.5, 8.5), base * CFrame.new(0, 15.85, 0), red, { Mat = WOOD })
	-- smokestacks with gold crowns
	for _, s in { -1, 1 } do
		Kit.Cyl(m, 13, 2, base * CFrame.new(s * 3.5, 17.5, 6.5), C(50, 48, 58), { Mat = METAL })
		Kit.Cyl(m, 0.8, 3, base * CFrame.new(s * 3.5, 24.2, 6.5), Kit.Vivid(GOLD), { Mat = METAL })
	end
	-- stern paddle wheel
	local hub = base * CFrame.new(0, 5, -24)
	Kit.CylFlat(m, 10, 13, hub.Position, "X", red, { Mat = WOOD })
	for i = 0, 3 do
		Kit.Part(m, V(10.6, 1, 14), hub * CFrame.Angles(i * math.pi / 4, 0, 0), PLANK_DARK, { Mat = WOOD })
	end
	Kit.CylFlat(m, 18, 1.4, hub.Position, "X", C(60, 60, 70), { Mat = METAL })
	-- name board and a bow lantern
	local board = Kit.Part(m, V(0.4, 1.8, 12), base * CFrame.new(-8.25, 2.2, -4), C(40, 60, 60))
	Kit.Sign(board, Enum.NormalId.Left, "SWAMP QUEEN", Kit.Vivid(C(255, 220, 120)), { Stroke = C(20, 40, 30) })
	Kit.Cyl(m, 4, 0.4, base * CFrame.new(0, 7.5, 16), C(50, 45, 60), { Mat = METAL })
	local lamp = Kit.Part(m, V(1.4, 1.8, 1.4), base * CFrame.new(0, 10, 16), LIME, { Mat = NEON })
	Kit.Light(lamp, LIME, 24, 1.2)
	-- mist over the stranded boat's pond
	local fog = Kit.Part(m, V(40, 0.2, 50), CFrame.new(x, 1, z), C(210, 240, 220), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(210, 240, 220), 1.5, 9, 0.3)
	Kit.AddRect(x - 14, z - 32, x + 14, z + 24)
end

--==================================================================
-- OUTSIDE THE WALLS
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Bayou")
	for _, s in { -1, 1 } do
		-- shallow bayou water over the outer ground, then open water beyond the slab
		Kit.Box(o, V(s * 146, 0, Z0), V(s * 190, 0.1, Z1), WATER, { Transp = 0.15, Refl = 0.15 })
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.4, Z1), WATER_DEEP, { Refl = 0.15 })
		-- cypress silhouettes standing in the water
		for i = 0, 7 do
			local x = s * rng:NextNumber(160, 330)
			local z = Z0 + 20 + i * 45 + rng:NextNumber(-10, 10)
			local h = rng:NextNumber(24, 40)
			local y0 = if math.abs(x) > 190 then -0.4 else 0
			Kit.Cyl(o, h, 2.6, CFrame.new(x, y0 + h / 2, z), BARK_DARK, { Mat = WOOD })
			local col = Kit.Pick(CANOPY)
			Kit.Cyl(o, 3, h * 0.8, CFrame.new(x, y0 + h, z), col, { Mat = GRASS })
			Kit.Ball(o, h * 0.4, V(x + 2, y0 + h + 1.5, z - 1), col:Lerp(Color3.new(1, 1, 1), 0.1), { Mat = GRASS })
			Kit.Part(o, V(0.8, 8, 2.4), CFrame.new(x + h * 0.25, y0 + h - 5, z), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
		end
		-- low fog banks
		for i = 0, 2 do
			Kit.Cyl(o, 5, rng:NextNumber(70, 110), CFrame.new(s * rng:NextNumber(225, 320), 3, Z0 + 60 + i * 120), C(215, 235, 225), { Transp = 0.7 })
		end
	end
	-- a broken jetty on the -X side
	for k = 0, 4 do
		if k ~= 2 then
			Kit.Box(o, V(-152 - k * 7, 0.2, rz(150)), V(-146 - k * 7, 0.7, rz(156)), PLANK, { Mat = PLANKS })
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Swamp.Build(map: Instance)
	local f = Kit.Folder(map, "Swamp")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	swampKing(f, 100, rz(290))
	paddleBoat(f, 100, rz(95))
	shack(f, 64, rz(34), -1, SHACKS[1], true, true)
	shack(f, -100, rz(50), 1, SHACKS[2], true, false)
	shack(f, -118, rz(192), 1, SHACKS[3], false, false)
	sideWalk(f, -88, -10, rz(50))
	sideWalk(f, -106, -10, rz(192))

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Props.Beam(f, V(x + s * 10, 0, z), V(x + s * 10.6, 13, z + 0.3), 1.4, 1.4, BARK, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "🐸 PHANTOM SWAMP 🐸", C(70, 95, 60), C(220, 255, 170), C(150, 110, 70))
		Kit.AddCircle(x, z, 12)
	end
	do
		local x, z = 22, rz(150)
		if Kit.IsFree(x, z, 4) then
			Kit.Box(f, V(x - 0.3, 0, z - 0.3), V(x + 0.3, 5.5, z + 0.3), BARK, { Mat = WOOD })
			Props.SignBoard(f, V(x, 6.5, z), 11, 4.4, 0, -1, "DON'T FEED\nTHE GATORS", C(240, 230, 200), Kit.Vivid(C(60, 130, 60)), C(120, 90, 60))
			Kit.AddCircle(x, z, 6)
		end
	end

	-- lanterns along the boardwalk (one lit)
	local lit = 0
	for z = Z0 + 46, Z1 - 30, 46 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 23 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.Lantern(f, V(x, 0, zz), C(220, 255, 150), lit == 3, false)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- cypress trees
	local trees = 0
	for _ = 1, 400 do
		if trees >= 17 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 28)
		if Kit.IsFree(x, z, h * 0.375 + 1) then
			trees += 1
			cypress(f, V(x, 0, z), h)
		end
	end

	-- logs, reeds, mushrooms, frogs
	local logs, clumps, shrooms, frogs = 0, 0, 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if logs < 5 and Kit.IsFree(x, z, 6) then
			logs += 1
			fallenLog(f, x, z, rng:NextNumber(0, math.pi), rng:NextNumber(8, 12))
		elseif clumps < 13 and Kit.IsFree(x, z, 2) then
			clumps += 1
			reeds(f, x, z)
		elseif shrooms < 6 and Kit.IsFree(x, z, 3) then
			shrooms += 1
			mushrooms(f, x, z, shrooms <= 2)
		elseif frogs < 3 and Kit.IsFree(x, z, 3) then
			frogs += 1
			frog(f, x, z, -x, 0)
		end
	end

	-- fireflies: small glowing dots, a few of them bobbing
	local flies = 0
	for _ = 1, 300 do
		if flies >= 10 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 12 and Kit.IsFree(x, z, 2, true) then
			flies += 1
			local p = Kit.Ball(f, 0.6, V(x, rng:NextNumber(2.5, 6), z), Kit.Pick({ LIME, C(255, 240, 140) }), { Mat = NEON, Name = "Firefly" })
			if flies <= 5 then
				Kit.Float(p, rng:NextNumber(0.8, 1.4))
			end
		end
	end

	outside(f)
end

return Swamp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">TextFit</string>
            <string name="Source"><![CDATA[--!strict
-- MOBILE TEXT FIX (signs): every world sign used TextScaled, so each of the ~230 signs drew its
-- words at its own pixel size (often huge, with big emoji). Phones keep every letter shape they
-- draw in one shared glyph cache; with hundreds of different sizes in view it overflows and
-- letters (in signs AND menus) flicker or vanish depending on where the camera points.
-- This pass gives every TextScaled label in the world ONE size from a short fixed list that
-- still fits its box, so the whole map only uses a handful of text sizes.
local TextFit = {}

-- the only sizes world signs use (px on the SurfaceGui canvas)
TextFit.Sizes = { 14, 20, 28, 40, 56, 80 }

local FACE_AXES: { [string]: { string } } = {
	Front = { "X", "Y" },
	Back = { "X", "Y" },
	Top = { "X", "Z" },
	Bottom = { "X", "Z" },
	Left = { "Z", "Y" },
	Right = { "Z", "Y" },
}

-- Estimated width of a line in "em" (multiples of the text size), a little generous so text fits.
function TextFit.LineEm(line: string, wide: boolean): number
	local em = 0
	for _, cp in utf8.codes(line) do
		if cp == 32 then
			em += 0.32
		elseif cp > 0x2000 then
			em += 1.15 -- emoji and symbols
		elseif (cp >= 65 and cp <= 90) or (cp >= 48 and cp <= 57) then
			em += 0.66
		else
			em += 0.54
		end
	end
	return if wide then em * 1.1 else em
end

-- Largest size from Sizes whose text fits w x h px (smallest size if nothing fits).
function TextFit.Pick(text: string, w: number, h: number, wide: boolean): number
	local lines = string.split(text, "\n")
	local maxEm = 0.5
	for _, l in lines do
		maxEm = math.max(maxEm, TextFit.LineEm(l, wide))
	end
	local best = TextFit.Sizes[1]
	for _, s in TextFit.Sizes do
		if maxEm * s <= w * 0.94 and #lines * s * 1.18 <= h * 0.94 then
			best = s
		end
	end
	return best
end

-- Pixel size of a GuiObject inside a SurfaceGui (nil if it isn't in one / not placed yet).
local function pxSize(obj: Instance): Vector2?
	if obj:IsA("SurfaceGui") then
		local part = obj.Adornee or obj.Parent
		if not part or not part:IsA("BasePart") then
			return nil
		end
		if obj.SizingMode == Enum.SurfaceGuiSizingMode.FixedSize then
			return obj.CanvasSize
		end
		local axes = FACE_AXES[obj.Face.Name]
		local size = (part :: BasePart).Size
		local pps = obj.PixelsPerStud
		return Vector2.new((size :: any)[axes[1]] * pps, (size :: any)[axes[2]] * pps)
	end
	if obj:IsA("GuiObject") then
		local parent = obj.Parent
		local p = if parent then pxSize(parent) else nil
		if not p then
			return nil
		end
		local s = obj.Size
		return Vector2.new(p.X * s.X.Scale + s.X.Offset, p.Y * s.Y.Scale + s.Y.Offset)
	end
	return nil
end

-- Picks the size for the label's current text (or its "FitText" attribute: the longest text
-- it is expected to show, for labels filled in later) and applies it.
local function size(l: TextLabel)
	local px = pxSize(l)
	if not px or px.X <= 0 or px.Y <= 0 then
		return
	end
	local wide = l.Font == Enum.Font.GothamBlack or l.Font == Enum.Font.GothamBold
	local sample = l:GetAttribute("FitText")
	local s = TextFit.Pick(if type(sample) == "string" then sample else l.Text, px.X, px.Y, wide)
	l.TextSize = s
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		st.Thickness = if s <= 20 then 1 elseif s <= 40 then 2 else 3
	end
end

local function fit(l: TextLabel)
	if not l.TextScaled or not l:FindFirstAncestorOfClass("SurfaceGui") then
		return
	end
	local px = pxSize(l)
	if not px or px.X <= 0 or px.Y <= 0 then
		return
	end
	l.TextScaled = false
	l.TextWrapped = false
	l.TextTruncate = Enum.TextTruncate.AtEnd -- text longer than expected never spills out of the box
	size(l)
	if l:GetAttribute("FitText") == nil then
		-- text set later by the server (placeholders like "..."): re-pick from the same short
		-- list so the label isn't stuck at the placeholder's size
		l:GetPropertyChangedSignal("Text"):Connect(function()
			size(l)
		end)
	end
end

-- Fixes every TextScaled label under `root` once, then any added later.
function TextFit.Apply(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("TextLabel") and d.TextScaled then
			fit(d)
			if not d.TextScaled then
				n += 1
			end
		end
	end
	pcall(function()
		root.DescendantAdded:Connect(function(d)
			if d:IsA("TextLabel") then
				task.defer(fit, d) -- after the builder has parented and filled it
			end
		end)
	end)
	return n
end

return TextFit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Throne</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 16: The Ghost King's Throne (Z 5200..5560), the final area. A floating royal palace in
-- the clouds: white marble, gold, royal purple and soft lavender.
--   Ground: marble slab + royal purple carpet along X = 0 with gold borders.
--   Ghost areas get flat gold-and-lavender medallions ((0,5285) r30, (-82,5320) r24,
--   (75,5380) r26, (-62,5440) r24); the boss area (0,5505) r28 is the royal seal. Nothing
--   stands in or above the boss circle (the Ghost King is huge and hovers at Y ~14).
--   Grand colonnades at X +-22 (Z 5325..5465) with banners, golden ghost-king statues,
--   floating chandeliers over the carpet (Y ~55), golden urns, lavender planters.
--   Grand final backdrop BEHIND the end of the play area (Z >= 5557, past the boss circle and
--   clear of the route check): the gigantic throne (crown tip ~Y 142, seen from the Inferno),
--   twin grand staircases up to a palace terrace, the palace facade with corner towers and the
--   "THE END... FOR NOW" banner. Cloud banks outside the side walls and behind the palace.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Throne = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local MARBLE = Enum.Material.Marble
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric

local Z0, Z1 = 5200, 5560
local BACK = Z1 - 3 -- the backdrop starts here (route check ends at Z1 - 4)

local WHITE = C(245, 242, 250)
local MARBLE_L = C(225, 215, 245) -- soft lavender marble
local LAVENDER = C(190, 160, 240)
local PURPLE = C(120, 65, 185)
local PURPLE_D = C(80, 40, 130)
local GOLD = C(255, 210, 90)
local CLOUD = C(250, 250, 255)
local CLOUD_S = C(225, 225, 245)
local WARM = C(255, 225, 160)

local GOLD_M: Kit.Opts = { Mat = METAL, Refl = 0.15 }
local SOLID_MARBLE: Kit.Opts = { Mat = MARBLE, Solid = true, Shadow = true }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
local function banner(parent: Instance, pos: Vector3, w: number, h: number, fx: number, fz: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(parent, V(w, h, 0.3), cf, color, { Mat = FABRIC })
	-- little crown emblem
	Kit.Part(parent, V(w * 0.5, w * 0.18, 0.2), cf * CFrame.new(0, h * 0.12, -0.22), gold, { Mat = METAL })
	for i = -1, 1 do
		Kit.Part(parent, V(w * 0.1, w * 0.18, 0.2), cf * CFrame.new(i * w * 0.2, h * 0.12 + w * 0.17, -0.22), gold, { Mat = METAL })
	end
	Kit.Part(parent, V(w + 1, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.2, 0), gold, { Mat = METAL })
	Kit.Part(parent, V(w, 0.6, 0.36), cf * CFrame.new(0, -h / 2 + 0.3, 0), gold, { Mat = FABRIC })
end

local function cloud(parent: Instance, pos: Vector3, d: number)
	local rng = Kit.Rng
	Kit.Ball(parent, d, pos, CLOUD, { Mat = Enum.Material.SmoothPlastic })
	Kit.Ball(parent, d * 0.7, pos + V(d * 0.45, -d * 0.12, rng:NextNumber(-d, d) * 0.25), CLOUD_S)
	Kit.Ball(parent, d * 0.6, pos + V(-d * 0.42, -d * 0.15, rng:NextNumber(-d, d) * 0.25), CLOUD)
end

-- Golden ghost-king statue facing (fx, fz).
local function statue(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "GoldenStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(m, V(8, 4, 8), base * CFrame.new(0, 2, 0), WHITE, SOLID_MARBLE)
	Kit.Part(m, V(8.6, 0.8, 8.6), base * CFrame.new(0, 4.2, 0), gold, GOLD_M)
	Kit.Cyl(m, 7, 5.6, base * CFrame.new(0, 8, 0), gold, GOLD_M)
	Kit.Ball(m, 7, (base * CFrame.new(0, 12, 0)).Position, gold, GOLD_M)
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 2.2, (base * CFrame.new(sx * 3.4, 10, -0.6)).Position, gold, GOLD_M)
		Kit.Ball(m, 1.2, (base * CFrame.new(sx * 1.2, 12.6, -3.1)).Position, C(40, 30, 60))
	end
	Kit.Ball(m, 1, (base * CFrame.new(0, 11, -3.3)).Position, C(40, 30, 60))
	Kit.Cyl(m, 1.4, 5, base * CFrame.new(0, 15.6, 0), gold, GOLD_M)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(m, V(1, 2.2, 1), base * CFrame.new(math.cos(a) * 1.9, 17.2, math.sin(a) * 1.9), gold, GOLD_M)
	end
	Kit.Ball(m, 1.2, (base * CFrame.new(0, 16, -2.5)).Position, Kit.Vivid(PURPLE), { Refl = 0.3 })
	Kit.AddCircle(x, z, 5.5)
end

local function urn(parent: Instance, x: number, z: number, light: boolean, flicker: boolean)
	local m = Kit.Model(parent, "GoldenUrn")
	local gold = Kit.Vivid(GOLD)
	Kit.Box(m, V(x - 2, 0, z - 2), V(x + 2, 3.5, z + 2), WHITE, SOLID_MARBLE)
	Kit.Cyl(m, 1.4, 1.6, CFrame.new(x, 4.2, z), gold, GOLD_M)
	Kit.Ball(m, 4, V(x, 6.2, z), gold, GOLD_M)
	Kit.Cyl(m, 0.6, 4.4, CFrame.new(x, 7.8, z), gold, GOLD_M)
	local flame = Kit.Ball(m, 2.6, V(x, 8.8, z), C(255, 220, 150), { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(flame, WARM, 26, 1.5, flicker)
	end
	Kit.AddCircle(x, z, 3)
end

local function planter(parent: Instance, x: number, z: number)
	Kit.Box(parent, V(x - 2.4, 0, z - 2.4), V(x + 2.4, 2.4, z + 2.4), MARBLE_L, { Mat = MARBLE, Solid = true })
	Kit.Box(parent, V(x - 2.6, 2.4, z - 2.6), V(x + 2.6, 2.8, z + 2.6), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Ball(parent, 4.6, V(x, 4.6, z), C(150, 200, 140), { Mat = Enum.Material.Grass })
	Kit.Ball(parent, 2, V(x + 1, 6.4, z - 0.6), Kit.Vivid(LAVENDER))
	Kit.AddCircle(x, z, 3)
end

local function chandelier(parent: Instance, x: number, y: number, z: number)
	local m = Kit.Model(parent, "Chandelier")
	local gold = Kit.Vivid(GOLD)
	Kit.Cyl(m, 1.2, 16, CFrame.new(x, y, z), gold, GOLD_M)
	Kit.Cyl(m, 1, 9, CFrame.new(x, y + 4, z), gold, GOLD_M)
	Kit.Cyl(m, 6, 1, CFrame.new(x, y + 2, z), gold, GOLD_M)
	Kit.Ball(m, 2.4, V(x, y + 7.6, z), gold, GOLD_M)
	Kit.Ball(m, 3, V(x, y - 2, z), LAVENDER, { Transp = 0.2, Refl = 0.3 })
	for i = 0, 5 do
		local a = i * math.pi / 3
		local cx, cz = x + math.cos(a) * 7.2, z + math.sin(a) * 7.2
		Kit.Cyl(m, 1.8, 0.7, CFrame.new(cx, y + 1.5, cz), C(250, 245, 230))
		local flame = Kit.Ball(m, 0.8, V(cx, y + 2.8, cz), WARM, { Mat = NEON })
		if i == 0 then
			Kit.Light(flame, WARM, 40, 1.4)
		end
	end
end

--==================================================================
-- GROUND, WALLS, CLOUDS
--==================================================================
local function ground(f: Instance)
	local gold = Kit.Vivid(GOLD)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), WHITE, { Mat = MARBLE, Solid = true, Name = "Ground_Throne" })
	-- royal carpet (flat) with gold borders, ending in a gold seal before the backdrop
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), Kit.Vivid(PURPLE), { Mat = FABRIC, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8, 0, Z0), V(s * 9.5, 0.07, Z1), gold, { Mat = FABRIC })
	end
	-- lavender diamond inlays beside the carpet
	for z = Z0 + 40, Z1 - 20, 40 do
		for _, s in { -1, 1 } do
			Kit.Part(f, V(6, 0.04, 6), CFrame.new(s * 15, 0.02, z) * CFrame.Angles(0, math.pi / 4, 0), MARBLE_L, { Mat = MARBLE })
		end
	end
	-- medallions on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.08, a[3] * 2 + 4, 0.08, gold, { Mat = METAL })
		Kit.Disc(f, a[1], a[2], 0.11, a[3] * 2, 0.11, if i % 2 == 0 then MARBLE_L else C(235, 228, 250), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.14, 12, 0.14, Kit.Vivid(LAVENDER), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.17, 5, 0.17, gold, { Mat = METAL })
	end
	-- boss: the royal seal (purple, gold rings, flat gold crown and glowing star points)
	Kit.Disc(f, 0, BOSS_Z, 0.08, 62, 0.08, gold, { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.11, 58, 0.11, PURPLE_D, { Mat = MARBLE })
	Kit.Disc(f, 0, BOSS_Z, 0.14, 42, 0.03, gold, { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.16, 40, 0.05, Kit.Vivid(PURPLE), { Mat = MARBLE })
	Kit.Box(f, V(-9, 0.16, BOSS_Z - 4), V(9, 0.2, BOSS_Z + 1), gold, { Mat = METAL })
	for i = -2, 2 do
		local h = if i == 0 then 9 else (if math.abs(i) == 1 then 6 else 7.5)
		Kit.Box(f, V(i * 4 - 1.1, 0.16, BOSS_Z + 1), V(i * 4 + 1.1, 0.2, BOSS_Z + 1 + h), gold, { Mat = METAL })
	end
	for i = 0, 7 do
		local a = i * math.pi / 4
		Kit.Part(f, V(1.6, 0.06, 1.6), CFrame.new(math.cos(a) * 25, 0.18, BOSS_Z + math.sin(a) * 25) * CFrame.Angles(0, math.pi / 4, 0), C(255, 235, 150), { Mat = NEON })
	end
end

local function sideWalls(f: Instance)
	local gold = Kit.Vivid(GOLD)
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 14, z1), WHITE, SOLID_MARBLE)
		Kit.Box(f, V(s * 139.5, 14, z0), V(s * 146.5, 15, z1), gold, GOLD_M)
		Kit.Box(f, V(s * 139.7, 9, z0), V(s * 140, 10.2, z1), Kit.Vivid(LAVENDER), { Mat = MARBLE })
		for z = z0 + 12, z1 - 6, 36 do
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 18, z + 2.5), MARBLE_L, SOLID_MARBLE)
			Kit.Ball(f, 3.4, V(s * 143, 19.6, z), gold, GOLD_M)
		end
	end
end

local function clouds(f: Instance)
	local rng = Kit.Rng
	for i = 0, 6 do
		local z = Z0 + 20 + i * 54
		for _, s in { -1, 1 } do
			cloud(f, V(s * rng:NextNumber(166, 186), rng:NextNumber(-8, 4), z + s * 10), rng:NextNumber(30, 44))
		end
	end
	-- high drifting cloud puffs outside the walls
	for _, p in { V(-200, 70, Z0 + 90), V(205, 85, Z0 + 200), V(-210, 95, Z0 + 330), V(200, 60, Z0 + 380) } do
		cloud(f, p, rng:NextNumber(24, 34))
	end
end

--==================================================================
-- COLONNADES AND HALL DECOR
--==================================================================
local function colonnade(f: Instance)
	local gold = Kit.Vivid(GOLD)
	local zs = { Z0 + 125, Z0 + 153, Z0 + 181, Z0 + 209, Z0 + 237, Z0 + 265 }
	for _, s in { -1, 1 } do
		local x = s * 22
		local built = 0
		for i, z in zs do
			if Kit.IsFree(x, z, 3.5) then
				built += 1
				Kit.Box(f, V(x - 2.8, 0, z - 2.8), V(x + 2.8, 2, z + 2.8), MARBLE_L, SOLID_MARBLE)
				Kit.Cyl(f, 28, 4, CFrame.new(x, 16, z), WHITE, SOLID_MARBLE)
				Kit.Box(f, V(x - 2.8, 30, z - 2.8), V(x + 2.8, 31.6, z + 2.8), gold, GOLD_M)
				if i % 2 == 1 then
					banner(f, V(x - s * 2.2, 18, z), 4, 12, -s, 0, if s < 0 then PURPLE else Kit.Vivid(LAVENDER))
				end
				Kit.AddCircle(x, z, 3.5)
			end
		end
		if built == #zs then
			Kit.Box(f, V(x - 2.6, 31.6, zs[1] - 2.8), V(x + 2.6, 34.4, zs[#zs] + 2.8), WHITE, { Mat = MARBLE, Shadow = true })
			Kit.Box(f, V(x - 2.8, 34.4, zs[1] - 3), V(x + 2.8, 35, zs[#zs] + 3), gold, GOLD_M)
		end
	end
end

local function decor(f: Instance)
	for _, p in { { -40, Z0 + 52 }, { 40, Z0 + 52 }, { -42, Z1 - 16 }, { 42, Z1 - 16 } } do
		if Kit.IsFree(p[1], p[2], 5.5) then
			statue(f, p[1], p[2], 0, -1)
		end
	end
	for i, p in { { -15, Z0 + 46 }, { 15, Z0 + 46 }, { -36, Z0 + 290 }, { 36, Z0 + 290 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			urn(f, p[1], p[2], i == 2 or i == 3, i == 3)
		end
	end
	for _, p in { { -36, Z0 + 140 }, { 36, Z0 + 140 }, { -36, Z0 + 196 }, { 36, Z0 + 250 }, { 110, Z0 + 60 }, { -110, Z0 + 60 }, { 120, Z0 + 280 }, { -120, Z0 + 180 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			planter(f, p[1], p[2])
		end
	end
	chandelier(f, 0, 54, Z0 + 155)
	chandelier(f, 0, 54, Z0 + 225)
	-- floating golden orbs and crowns (single tagged parts, outside the ghost areas)
	local gold = Kit.Vivid(GOLD)
	for i, p in { V(-40, 26, Z0 + 150), V(44, 30, Z0 + 120), V(-112, 28, Z0 + 190), V(116, 24, Z0 + 270), V(42, 32, Z0 + 250) } do
		local part: Part
		if i % 2 == 0 then
			part = Kit.Cyl(f, 1.4, 3, CFrame.new(p), gold, { Mat = METAL, Name = "FloatingCrown" })
		else
			part = Kit.Ball(f, 2.6, p, Kit.Vivid(LAVENDER), { Refl = 0.3, Name = "FloatingOrb" })
		end
		Kit.Float(part, 1.5)
	end
	-- low cloud tufts along the inner wall foot
	for _, p in { V(-132, 0, Z0 + 60), V(132, 0, Z0 + 110), V(-132, 0, Z0 + 290), V(132, 0, Z0 + 330), V(-132, 0, Z0 + 200) } do
		if Kit.IsFree(p.X, p.Z, 5) then
			Kit.Ball(f, 10, p + V(0, 1, 0), CLOUD)
			Kit.Ball(f, 7, p + V(0, 2, 5), CLOUD_S)
			Kit.AddCircle(p.X, p.Z, 6)
		end
	end
end

--==================================================================
-- GRAND FINAL BACKDROP (behind the end of the play area)
--==================================================================
local function backdrop(f: Instance)
	local m = Kit.Model(f, "GrandBackdrop")
	local gold = Kit.Vivid(GOLD)
	local TOP = 33.6 -- terrace height
	-- marble base under everything past the end of the zone
	Kit.Box(m, V(-190, -4, Z1), V(190, 0, Z1 + 90), WHITE, { Mat = MARBLE, Solid = true })

	-- twin grand staircases rising away from the hall (X +-34..140)
	local steps = 14
	local run = 3.2
	local rise = TOP / steps
	for i = 0, steps - 1 do
		local z = BACK + i * run
		local col = if i % 2 == 0 then WHITE else MARBLE_L
		-- each step is a slab reaching to the back; inset the hidden faces a hair per step so the
		-- alternating colours never share a plane (z-fighting)
		local d = (i + 1) * 0.03
		for _, s in { -1, 1 } do
			Kit.Box(m, V(s * (34 + d), d, z), V(s * (146 - d), rise * (i + 1), BACK + steps * run + 4 - d), col, { Mat = MARBLE, Solid = i < 2, Shadow = true })
		end
	end
	local stairEnd = BACK + steps * run
	for _, s in { -1, 1 } do
		Props.Beam(m, V(s * 34.5, 3, BACK + 0.5), V(s * 34.5, TOP + 3, stairEnd), 0.6, 0.6, gold, GOLD_M)
		for i = 0, 3 do
			local t = i / 3
			local p = V(s * 34.5, rise + (TOP - rise) * t, BACK + 0.5 + (stairEnd - BACK - 0.5) * t)
			Kit.Box(m, p + V(-0.5, 0, -0.5), p + V(0.5, 3.4, 0.5), gold, GOLD_M)
		end
	end
	-- terrace behind the throne and stairs
	Kit.Box(m, V(-146, 0, stairEnd), V(146, TOP, Z1 + 80), WHITE, { Mat = MARBLE })
	Kit.Box(m, V(-146, TOP - 1, stairEnd - 0.3), V(146, TOP, stairEnd), gold, GOLD_M)

	-- palace facade with arched windows
	local fz = stairEnd + 14
	Kit.Box(m, V(-122, TOP, fz), V(122, 98, fz + 8), WHITE, { Mat = MARBLE, Shadow = true })
	Kit.Box(m, V(-123, 96, fz - 0.6), V(123, 99, fz + 8.6), gold, GOLD_M)
	Kit.Box(m, V(-121, TOP, fz - 0.4), V(121, TOP + 2, fz), MARBLE_L, { Mat = MARBLE })
	for _, x in { -100, -70, 70, 100 } do
		Kit.Box(m, V(x - 6, 44, fz - 0.4), V(x + 6, 74, fz), gold, GOLD_M)
		Kit.Box(m, V(x - 5, 45, fz - 0.6), V(x + 5, 73, fz - 0.2), Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15, Refl = 0.2 })
		Kit.CylFlat(m, 0.6, 12, V(x, 74, fz - 0.4), "Z", gold, GOLD_M)
		Kit.CylFlat(m, 0.6, 10, V(x, 74, fz - 0.5), "Z", Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15 })
	end
	-- corner towers with gold domes and flags
	for _, s in { -1, 1 } do
		local tx, tz = s * 132, stairEnd + 10
		Kit.Cyl(m, 120, 22, CFrame.new(tx, 60, tz), WHITE, { Mat = MARBLE, Shadow = true })
		Kit.Cyl(m, 2, 24, CFrame.new(tx, 92, tz), gold, GOLD_M)
		Kit.Cyl(m, 3, 25, CFrame.new(tx, 121, tz), MARBLE_L, { Mat = MARBLE })
		Kit.Ball(m, 22, V(tx, 124, tz), gold, GOLD_M)
		Kit.Cyl(m, 18, 1, CFrame.new(tx, 142, tz), gold, GOLD_M)
		Kit.Part(m, V(0.3, 5, 9), CFrame.new(tx, 148, tz - 4.6), Kit.Vivid(PURPLE), { Mat = FABRIC })
		for _, y in { 50, 80 } do
			Kit.Box(m, V(tx - s * 11.2 - 1.6, y, tz - 3), V(tx - s * 11.2 + 1.6, y + 8, tz + 3), Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15 })
		end
	end
	-- the big farewell banners on the facade
	local endSign = Props.SignBoard(m, V(84, 84, fz - 0.8), 64, 9, 0, -1, "THE END... FOR NOW", PURPLE_D, gold, GOLD)
	Kit.Light(endSign, WARM, 50, 1.2)
	Props.SignBoard(m, V(-84, 84, fz - 0.8), 64, 9, 0, -1, "THANKS FOR HUNTING!", PURPLE_D, gold, GOLD)
	for _, x in { -84, 84 } do
		for _, dx in { -33, 33 } do
			Kit.Wedge(m, V(4, 8, 1), CFrame.new(x + dx, 78, fz - 0.9) * CFrame.Angles(math.pi / 2, 0, 0), Kit.Vivid(PURPLE), { Mat = FABRIC })
		end
	end

	-- THE THRONE (dais front at the end of the play area; seat faces the hall)
	local tz = BACK + 2 -- front of the dais
	for i = 0, 2 do
		local z = tz + i * 4
		Kit.Box(m, V(-32 + i * 2, i * 3, z), V(32 - i * 2, (i + 1) * 3, stairEnd), if i % 2 == 0 then WHITE else MARBLE_L, { Mat = MARBLE, Shadow = true })
		Kit.Box(m, V(-32 + i * 2, (i + 1) * 3 - 0.5, z - 0.2), V(32 - i * 2, (i + 1) * 3, z), gold, GOLD_M)
	end
	local seatZ = tz + 13
	Kit.Box(m, V(-20, 9, seatZ), V(20, 30, seatZ + 16), Kit.Vivid(PURPLE), { Mat = FABRIC, Shadow = true })
	Kit.Box(m, V(-20.4, 26, seatZ - 0.4), V(20.4, 27.2, seatZ + 16), gold, GOLD_M)
	Kit.Box(m, V(-18, 30, seatZ - 1), V(18, 34, seatZ + 14), Kit.Vivid(LAVENDER), { Mat = FABRIC })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 20, 9, seatZ - 4), V(s * 27, 42, seatZ + 20), gold, GOLD_M)
		Kit.Ball(m, 8, V(s * 23.5, 45, seatZ - 3), gold, GOLD_M)
		Kit.Ball(m, 3, V(s * 23.5, 50, seatZ - 3), Kit.Vivid(PURPLE), { Refl = 0.3 })
		Kit.Box(m, V(s * 22, 9, seatZ + 14), V(s * 27, 126, seatZ + 21), gold, GOLD_M)
	end
	Kit.Box(m, V(-22, 30, seatZ + 14), V(22, 120, seatZ + 20), Kit.Vivid(PURPLE), { Mat = FABRIC, Shadow = true })
	Kit.Box(m, V(-27, 120, seatZ + 13.5), V(27, 126, seatZ + 21), gold, GOLD_M)
	-- friendly ghost emblem on the backrest
	Kit.Ball(m, 20, V(0, 82, seatZ + 17), C(250, 248, 255))
	Kit.Box(m, V(-10, 62, seatZ + 13.4), V(10, 82, seatZ + 15), C(250, 248, 255))
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 3.6, V(sx * 4, 85, seatZ + 7.6), C(45, 30, 70))
	end
	Kit.Ball(m, 3, V(0, 78, seatZ + 7.6), C(45, 30, 70))
	-- the crown on top
	local cz = seatZ + 17
	Kit.Cyl(m, 6, 28, CFrame.new(0, 129, cz), gold, GOLD_M)
	for i = -2, 2 do
		local h = if i == 0 then 14 else (if math.abs(i) == 1 then 10 else 8)
		Kit.Box(m, V(i * 6 - 2, 132, cz - 2), V(i * 6 + 2, 132 + h, cz + 2), gold, GOLD_M)
		Kit.Ball(m, 3.4, V(i * 6, 133 + h, cz), if i == 0 then C(255, 120, 160) else Kit.Vivid(LAVENDER), { Refl = 0.3 })
	end
	local gem = Kit.Ball(m, 6, V(0, 129, cz - 13.4), C(210, 150, 255), { Mat = NEON })
	Kit.Light(gem, C(210, 160, 255), 60, 2)
	local sparkle = Kit.Part(m, V(30, 4, 6), CFrame.new(0, 136, cz), gold, { Transp = 1, Name = "SparkleSource" })
	Kit.Emitter(sparkle, C(255, 230, 140), 4, 2, 1.5)
	Props.SignBoard(m, V(0, 1.5, tz - 0.4), 34, 2.6, 0, -1, "THE GHOST KING'S THRONE", PURPLE_D, gold)

	-- clouds hugging the back of the palace
	for i = -3, 3 do
		cloud(m, V(i * 50, Kit.Rng:NextNumber(20, 40), Z1 + 92), Kit.Rng:NextNumber(40, 56))
	end
	local mist = Kit.Part(m, V(260, 1, 20), CFrame.new(0, 34, Z1 + 70), CLOUD, { Transp = 1, Name = "CloudMist" })
	Kit.Emitter(mist, C(250, 250, 255), 3, 16, 0.5)
end

--==================================================================
-- BUILD
--==================================================================
function Throne.Build(map: Instance)
	local f = Kit.Folder(map, "Throne")
	ground(f)
	sideWalls(f)
	clouds(f)
	colonnade(f)
	decor(f)
	backdrop(f)
end

return Throne
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Tomb</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 11: Pharaoh's Tomb (Z 3400..3760). A sunny desert temple: sand, gold and turquoise.
--   Ground: sand slab (top Y = 0). Main path along X = 0: sandstone paving (X -8..8, top 0.05)
--   with turquoise edges and terracotta seams.
--   Ghost areas hold flat paint only: a sun mosaic on the path (0, 3485), tiled circles, the
--   OASIS (flat turquoise water on solid sand) at (75, 3580) and the Pharaoh's seal with a big
--   painted eye around the boss (0, 3705).
--   Landmark: a huge step pyramid outside the +X wall (centre X 226, Z 3650, ~105 tall) with
--   its entrance facing the valley, and a smaller one outside the -X wall; both read from the
--   Frost zone.
--   Also: a colonnade of painted sandstone columns with lintels over the path (Z 3530..3600),
--   two pairs of obelisks, a cute sphinx-cat statue (-100, 3700) facing the path, palm trees
--   around the oasis, golden treasure piles, urns, broken columns and torches.
--   Side walls: sandstone with a terracotta cap and a painted hieroglyph band.
--   Outside: dunes and palms on open sand.
-- Glow: torch flames, the eye above the pyramid entrance and a few turquoise glints in the seal.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Tomb = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SAND = Enum.Material.Sand
local SANDSTONE = Enum.Material.Sandstone
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local GRASS = Enum.Material.Grass

local Z0, Z1 = 3400, 3760

local SANDC = C(238, 208, 150)
local SAND_DARK = C(222, 188, 128)
local STONE = C(224, 190, 132)
local STONE_DARK = C(196, 160, 106)
local PAVE = C(214, 178, 122)
local GOLD = C(255, 200, 60)
local TURQ = C(60, 200, 210)
local TERRA = C(206, 104, 70)
local LAPIS = C(50, 90, 190)
local FLAME = C(255, 160, 60)
local WATER = C(70, 200, 205)
local PALM = { C(70, 160, 70), C(90, 180, 80), C(60, 145, 85) }
local TRUNK = C(150, 110, 70)

local function rz(n: number): number
	return Z0 + n
end

--==================================================================
-- PROPS
--==================================================================
local function palm(parent: Instance, pos: Vector3, h: number)
	local rng = Kit.Rng
	local lean = rng:NextNumber(-1, 1)
	local a = rng:NextNumber(0, math.pi * 2)
	local dir = V(math.cos(a), 0, math.sin(a))
	local pts = { pos, pos + V(0, h * 0.4, 0) + dir * lean * 0.6, pos + V(0, h * 0.75, 0) + dir * lean * 1.8, pos + V(0, h, 0) + dir * lean * 3.2 }
	for i = 1, 3 do
		Props.Beam(parent, pts[i], pts[i + 1], 1.9 - i * 0.2, 1.9 - i * 0.2, if i % 2 == 0 then TRUNK else TRUNK:Lerp(Color3.new(1, 1, 1), 0.12), { Mat = WOOD, Solid = i == 1, Shadow = true })
	end
	local top = pts[4]
	local col = Kit.Pick(PALM)
	for k = 0, 4 do
		local fa = k * math.pi * 2 / 5 + rng:NextNumber(-0.2, 0.2)
		local len = h * 0.42
		local tip = top + V(math.cos(fa) * len, -h * 0.14, math.sin(fa) * len)
		local mid = (top + tip) / 2 + V(0, 0.8, 0)
		Kit.Part(parent, V(2.6, 0.3, len + 1), CFrame.lookAt(mid, tip) * CFrame.Angles(0, 0, 0), col, { Mat = GRASS })
	end
	Kit.Ball(parent, 1.3, top + V(0.6, -0.9, 0.3), C(120, 80, 45))
	Kit.Ball(parent, 1.3, top + V(-0.5, -1, -0.4), C(120, 80, 45))
	Kit.AddCircle(pos.X, pos.Z, h * 0.42 + 3)
end

local function obelisk(parent: Instance, x: number, z: number, h: number)
	local m = Kit.Model(parent, "Obelisk")
	Kit.Box(m, V(x - 3.5, 0, z - 3.5), V(x + 3.5, 1.6, z + 3.5), STONE_DARK, { Mat = SANDSTONE, Solid = true })
	Kit.Box(m, V(x - 2.2, 1.6, z - 2.2), V(x + 2.2, h * 0.55, z + 2.2), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1.8, h * 0.55, z - 1.8), V(x + 1.8, h, z + 1.8), STONE, { Mat = SANDSTONE, Shadow = true })
	Kit.Part(m, V(2.6, 2.6, 2.6), CFrame.new(x, h + 0.3, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Kit.Vivid(GOLD), { Mat = METAL, Refl = 0.2 })
	-- painted hieroglyph band
	Kit.Box(m, V(x - 2.3, h * 0.3, z - 2.3), V(x + 2.3, h * 0.3 + 1, z + 2.3), Kit.Vivid(TURQ))
	local panel = Kit.Box(m, V(x - 1.6, h * 0.36, z - 2.35), V(x + 1.6, h * 0.5, z - 2.25), Kit.Vivid(TERRA))
	Kit.Sign(panel, Enum.NormalId.Front, "☥\n👁\n☀", C(255, 245, 210), { Stroke = C(90, 40, 20) })
	Kit.AddCircle(x, z, 4.5)
end

local function column(parent: Instance, x: number, z: number, h: number)
	Kit.Box(parent, V(x - 2.6, 0, z - 2.6), V(x + 2.6, 1.4, z + 2.6), STONE_DARK, { Mat = SANDSTONE, Solid = true })
	Kit.Cyl(parent, h - 3.4, 3.6, CFrame.new(x, 1.4 + (h - 3.4) / 2, z), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
	Kit.Cyl(parent, 1.2, 3.9, CFrame.new(x, h * 0.62, z), Kit.Vivid(TURQ))
	Kit.Cyl(parent, 0.6, 3.9, CFrame.new(x, h * 0.62 + 1.2, z), Kit.Vivid(TERRA))
	Kit.Box(parent, V(x - 2.8, h - 2, z - 2.8), V(x + 2.8, h, z + 2.8), STONE_DARK, { Mat = SANDSTONE })
end

local function torch(parent: Instance, x: number, z: number, lit: boolean, flicker: boolean)
	Kit.Box(parent, V(x - 0.5, 0, z - 0.5), V(x + 0.5, 6, z + 0.5), STONE_DARK, { Mat = SANDSTONE })
	Kit.Cyl(parent, 1.2, 2.4, CFrame.new(x, 6.6, z), Kit.Vivid(GOLD), { Mat = METAL })
	local flame = Kit.Part(parent, V(1.3, 1.3, 1.3), CFrame.new(x, 7.6, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), FLAME, { Mat = NEON })
	if lit then
		Kit.Light(flame, C(255, 180, 90), 22, 1.5, flicker)
	end
end

local function urn(parent: Instance, x: number, z: number, s: number)
	local col = if Kit.Rng:NextNumber() < 0.5 then TERRA else C(190, 120, 70)
	Kit.Ball(parent, 2.4 * s, V(x, 1.2 * s, z), col, { Solid = true }).CanCollide = false -- small prop: tappable/queryable but walk-through (solid ones snag players)
	Kit.Cyl(parent, 1.1 * s, 1.1 * s, CFrame.new(x, 2.6 * s, z), col)
	Kit.Cyl(parent, 0.3 * s, 1.5 * s, CFrame.new(x, 3.2 * s, z), Kit.Vivid(TURQ))
end

local function treasure(parent: Instance, x: number, z: number, sparkle: boolean)
	local m = Kit.Model(parent, "Treasure")
	local gold = Kit.Vivid(GOLD)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.25 }
	Kit.Ball(m, 9, V(x, -2.2, z), gold, mo)
	Kit.Ball(m, 6, V(x + 4, -1.6, z - 3.5), gold, mo)
	Kit.Ball(m, 5, V(x - 4, -1.4, z + 3), gold, mo)
	-- chest
	local wood = C(150, 90, 50)
	Kit.Box(m, V(x - 2.7, 0, z + 2), V(x + 2.7, 3, z + 5.4), wood, { Mat = WOOD, Solid = true })
	Kit.CylFlat(m, 5.4, 3.4, V(x, 3, z + 3.7), "X", wood, { Mat = WOOD })
	Kit.Box(m, V(x - 2.9, 1.4, z + 1.9), V(x + 2.9, 2, z + 5.5), gold, { Mat = METAL })
	-- gems, a golden mask and coins
	for i, g in { C(230, 60, 90), TURQ, C(170, 90, 240) } do
		Kit.Part(m, V(1.2, 1.2, 1.2), CFrame.new(x - 2.5 + i * 1.3, 2.3 - i * 0.3, z - 1 + i * 0.5) * CFrame.Angles(0.6, 0.4, 0.6), Kit.Vivid(g), { Refl = 0.3 })
	end
	Kit.Part(m, V(2.6, 3.2, 0.8), CFrame.new(x + 1.5, 3, z - 1.2) * CFrame.Angles(-0.4, 0.3, 0), gold, mo)
	for i = 0, 2 do
		local a = i * 2.1
		Kit.Disc(m, x + math.cos(a) * 6, z + math.sin(a) * 6, 0.2, 1.8, 0.2, gold, mo)
	end
	if sparkle then
		local src = Kit.Part(m, V(8, 1, 8), CFrame.new(x, 3, z), gold, { Transp = 1, Name = "SparkleSource" })
		local e = Kit.Emitter(src, C(255, 230, 120), 3, 0.6, 1.2)
		if e then
			e.Size = NumberSequence.new(0.5)
			e.Lifetime = NumberRange.new(1.5, 3)
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		end
		Kit.Light(src, C(255, 210, 120), 18, 1)
	end
	Kit.AddCircle(x, z, 7.5)
end

-- Cute sphinx-cat lying on a plinth, facing (fx, 0).
local function sphinxCat(parent: Instance, x: number, z: number, fx: number)
	local m = Kit.Model(parent, "SphinxCat")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local stone: Kit.Opts = { Mat = SANDSTONE, Solid = true, Shadow = true }
	local fur = C(232, 198, 140)
	Kit.Part(m, V(18, 4, 36), base * CFrame.new(0, 2, 0), STONE_DARK, stone)
	Kit.Part(m, V(18.4, 1, 36.4), base * CFrame.new(0, 3.2, 0), Kit.Vivid(TURQ), { Mat = SANDSTONE })
	-- body, haunch, paws
	Kit.Part(m, V(12, 9, 22), base * CFrame.new(0, 8.5, 3), fur, stone)
	Kit.Ball(m, 12, (base * CFrame.new(0, 9, 12)).Position, fur, stone)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(3.6, 3, 11), base * CFrame.new(s * 3.6, 5.5, -11), fur, stone)
		Kit.Ball(m, 3.8, (base * CFrame.new(s * 3.6, 5.6, -16.4)).Position, fur, { Mat = SANDSTONE })
	end
	-- head with nemes headdress
	local head = base * CFrame.new(0, 17, -8)
	Kit.Part(m, V(10, 9, 9), head, fur, stone)
	for _, s in { -1, 1 } do
		Kit.Wedge(m, V(1.6, 4, 3.4), head * CFrame.new(s * 3.2, 6.4, 0.5) * CFrame.Angles(0, math.pi, 0), fur, { Mat = SANDSTONE })
		-- striped headdress flaps
		Kit.Part(m, V(1.6, 10, 5), head * CFrame.new(s * 5.6, -1.5, 1.5), Kit.Vivid(LAPIS), { Mat = SANDSTONE })
		Kit.Part(m, V(1.8, 1.4, 5.2), head * CFrame.new(s * 5.6, 0.5, 1.5), Kit.Vivid(GOLD), { Mat = METAL })
		Kit.Part(m, V(1.8, 1.4, 5.2), head * CFrame.new(s * 5.6, -3.5, 1.5), Kit.Vivid(GOLD), { Mat = METAL })
		-- big friendly eyes
		Kit.Part(m, V(2.2, 2.6, 0.4), head * CFrame.new(s * 2.4, 1, -4.6), Kit.Vivid(TURQ))
		Kit.Part(m, V(0.9, 1.6, 0.3), head * CFrame.new(s * 2.4, 1, -4.85), C(30, 30, 45))
	end
	Kit.Part(m, V(10.4, 1.4, 9.4), head * CFrame.new(0, 3.6, 0), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(1.4, 0.9, 0.4), head * CFrame.new(0, -1.2, -4.6), Kit.Vivid(C(255, 140, 170)))
	-- gold collar and a curled tail
	Kit.Part(m, V(12.4, 1.6, 2), base * CFrame.new(0, 12.5, -6.4), Kit.Vivid(GOLD), { Mat = METAL })
	Props.Beam(m, (base * CFrame.new(5, 4.5, 16)).Position, (base * CFrame.new(8, 4.5, 6)).Position, 1.6, 1.6, fur, { Mat = SANDSTONE })
	Props.Beam(m, (base * CFrame.new(8, 4.5, 6)).Position, (base * CFrame.new(7.5, 6.5, 1)).Position, 1.6, 1.6, fur, { Mat = SANDSTONE })
	Kit.AddCircle(x, z, 20)
end

-- Step pyramid centred at (x, z); entrance on the face toward (ex, 0).
local function pyramid(parent: Instance, x: number, z: number, base: number, tiers: number, tierH: number, ex: number, entrance: boolean)
	local m = Kit.Model(parent, "Pyramid")
	for i = 0, tiers - 1 do
		local s = base * (1 - i / tiers)
		Kit.Box(m, V(x - s / 2, i * tierH - (if i == 0 then 2 else 0), z - s / 2), V(x + s / 2, (i + 1) * tierH, z + s / 2), if i % 2 == 0 then STONE else SAND_DARK, { Mat = SANDSTONE, Shadow = true })
	end
	local topY = tiers * tierH
	local cap = base / tiers
	Kit.Part(m, V(cap * 0.9, cap * 0.9, cap * 0.9), CFrame.new(x, topY + cap * 0.1, z) * CFrame.Angles(0, math.pi / 4, 0) * CFrame.Angles(math.pi / 4, 0, 0), Kit.Vivid(GOLD), { Mat = METAL, Refl = 0.3 })
	-- a painted band around the second tier
	local s2 = base * (1 - 1 / tiers)
	Kit.Box(m, V(x - s2 / 2 - 0.2, tierH * 1.4, z - s2 / 2 - 0.2), V(x + s2 / 2 + 0.2, tierH * 1.4 + 1.5, z + s2 / 2 + 0.2), Kit.Vivid(TURQ))
	if entrance then
		-- pylon facade on the face toward the valley: posts, tall lintel with a painted band and
		-- a glowing eye, a dark doorway, torches either side
		local back = x + ex * base / 2 -- the pyramid face
		local front = back + ex * 3 -- the facade's outer face
		local function slab(x1: number, x2: number, y1: number, y2: number, z1: number, z2: number, col: Color3, opts: Kit.Opts?): Part
			return Kit.Box(m, V(x1, y1, z1), V(x2, y2, z2), col, opts)
		end
		local sand: Kit.Opts = { Mat = SANDSTONE }
		slab(front, back, 0, 30, z - 13, z - 9, STONE_DARK, sand)
		slab(front, back, 0, 30, z + 9, z + 13, STONE_DARK, sand)
		slab(front, back, 30, 42, z - 15, z + 15, Kit.Vivid(TERRA), sand)
		slab(back - ex * 0.2, back + ex * 0.3, 0, 30, z - 9, z + 9, C(45, 35, 40))
		local band = slab(front + ex * 0.1, front, 30.8, 34.4, z - 13, z + 13, Kit.Vivid(LAPIS))
		Kit.Sign(band, if ex < 0 then Enum.NormalId.Left else Enum.NormalId.Right, "☥ 👁 ☀ 🐍 ☥", C(255, 240, 200), { Stroke = C(30, 30, 60) })
		local eye = slab(front + ex * 0.3, front, 35.4, 40.4, z - 5, z + 5, Kit.Vivid(TURQ), { Mat = NEON })
		slab(front + ex * 0.4, front, 36.6, 39.2, z - 1.5, z + 1.5, C(30, 30, 50))
		Kit.Light(eye, TURQ, 45, 1.6)
		for _, sz in { -1, 1 } do
			Kit.Cyl(m, 14, 2.6, CFrame.new(front + ex * 1.6, 7, z + sz * 17), STONE, sand)
			Kit.Part(m, V(1.6, 1.6, 1.6), CFrame.new(front + ex * 1.6, 14.8, z + sz * 17) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), FLAME, { Mat = NEON })
		end
		local dust = Kit.Part(m, V(4, 20, 18), CFrame.new(front + ex * 2, 12, z), C(255, 220, 160), { Transp = 1, Name = "DustSource" })
		Kit.Emitter(dust, C(255, 225, 170), 1.2, 6, 0.4)
	end
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SANDC, { Mat = SAND, Solid = true, Name = "Ground_Tomb" })
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PAVE, { Mat = SANDSTONE, Solid = true, Name = "TempleRoad" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.6, 0.05, Z0), V(s * 8 + 0.6, 0.1, Z1), Kit.Vivid(TURQ))
	end
	for z = Z0 + 12, Z1 - 10, 16 do
		Kit.Box(f, V(-7.4, 0.05, z), V(7.4, 0.07, z + 0.5), Kit.Vivid(TERRA))
	end
	-- wind ripples in the sand (flat shading)
	local rng = Kit.Rng
	for _ = 1, 8 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(16, 28), 0.03, rng:NextNumber(8, 16)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), SAND_DARK, { Mat = SAND })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	local glyphs = { "☥  👁  ☀", "🐍  ☥  🐈", "☀  🪲  ☥", "👁  ☥  🐍", "🐈  ☀  ☥" }
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 12, zB), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.5, 12, zA), V(s * 146.5, 13.2, zB), Kit.Vivid(TERRA), { Mat = SANDSTONE })
		Kit.Box(f, V(s * 139.9, 7.6, zA), V(s * 139.7, 9.6, zB), Kit.Vivid(TURQ))
		Kit.Box(f, V(s * 139.9, 9.6, zA), V(s * 139.7, 10.2, zB), Kit.Vivid(GOLD))
		for i, z in { rz(40), rz(110), rz(180), rz(250), rz(320) } do
			local p = Kit.Box(f, V(s * 139.95, 2.5, z - 9), V(s * 139.65, 7, z + 9), Kit.Vivid(if i % 2 == 0 then TERRA else LAPIS))
			Kit.Sign(p, if s < 0 then Enum.NormalId.Right else Enum.NormalId.Left, glyphs[i], C(255, 240, 200), { Stroke = C(70, 40, 20) })
		end
		for z = zA + 20, zB - 10, 48 do
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), STONE_DARK, { Mat = SANDSTONE, Solid = true })
			Kit.Ball(f, 3, V(s * 143, 16.4, z), Kit.Vivid(TURQ))
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- mummy spirits: sun mosaic across the road
	local cz = rz(85)
	Kit.Disc(f, 0, cz, 0.04, 64, 0.03, Kit.Vivid(TERRA), { Mat = SANDSTONE })
	Kit.Disc(f, 0, cz, 0.07, 60, 0.03, PAVE, { Mat = SANDSTONE })
	Kit.Disc(f, 0, cz, 0.1, 14, 0.03, Kit.Vivid(GOLD))
	for i = 0, 7 do
		local a = i * math.pi / 4
		Props.Beam(f, V(math.cos(a) * 7, 0.1, cz + math.sin(a) * 7), V(math.cos(a) * 17, 0.1, cz + math.sin(a) * 17), 2.2, 0.04, Kit.Vivid(GOLD))
		local b = a + math.pi / 8
		Kit.Part(f, V(2.4, 0.04, 2.4), CFrame.new(math.cos(b) * 23, 0.1, cz + math.sin(b) * 23) * CFrame.Angles(0, b + math.pi / 4, 0), Kit.Vivid(TURQ))
	end
	-- tiled circles
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 3, 0.03, Kit.Vivid(TURQ))
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, PAVE, { Mat = SANDSTONE })
		Kit.Disc(f, a[1], a[2], 0.1, 10, 0.03, Kit.Vivid(TERRA))
	end
	-- the oasis: turquoise water lying flat on the sand, grass rim
	local ox, oz = 75, rz(180)
	Kit.Disc(f, ox, oz, 0.04, 54, 0.03, C(120, 190, 90), { Mat = GRASS })
	Kit.Disc(f, ox, oz, 0.1, 42, 0.06, WATER, { Transp = 0.2, Refl = 0.2, Name = "Oasis" })
	for _, l in { { 68, rz(174), 4 }, { 84, rz(186), 3.4 }, { 78, rz(166), 3 } } do
		Kit.Disc(f, l[1], l[2], 0.14, l[3], 0.03, Kit.Vivid(C(90, 180, 80)))
	end
	-- boss: the Pharaoh's seal with a big painted eye
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(TERRA), { Mat = SANDSTONE })
	Kit.Disc(f, 0, bz, 0.06, 54, 0.03, Kit.Vivid(GOLD))
	Kit.Disc(f, 0, bz, 0.08, 50, 0.03, PAVE, { Mat = SANDSTONE })
	Kit.Part(f, V(26, 0.04, 12), CFrame.new(0, 0.1, bz), C(250, 245, 230))
	Kit.Disc(f, 0, bz, 0.13, 9, 0.04, Kit.Vivid(TURQ))
	Kit.Disc(f, 0, bz, 0.15, 4, 0.04, C(30, 30, 50))
	Props.Beam(f, V(-13, 0.13, bz - 8), V(13, 0.13, bz - 8), 1.6, 0.04, Kit.Vivid(LAPIS))
	Props.Beam(f, V(-2, 0.13, bz + 6), V(-5, 0.13, bz + 15), 1.4, 0.04, Kit.Vivid(LAPIS))
	Props.Beam(f, V(6, 0.13, bz + 6), V(12, 0.13, bz + 13), 1.4, 0.04, Kit.Vivid(LAPIS))
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(f, V(1.8, 0.05, 1.8), CFrame.new(math.cos(a) * 22, 0.12, bz + math.sin(a) * 22) * CFrame.Angles(0, math.pi / 4, 0), TURQ, { Mat = NEON })
	end
end

--==================================================================
-- OUTSIDE
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Desert")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), SANDC, { Mat = SAND })
		-- dunes
		for i = 0, 4 do
			local x = s * rng:NextNumber(165, 330)
			local z = Z0 + 30 + i * 75 + rng:NextNumber(-15, 15)
			local d = rng:NextNumber(50, 90)
			if not (s > 0 and z > rz(160) and z < rz(340) and math.abs(x) < 310) then
				Kit.Ball(o, d, V(x, -d * 0.36, z), if i % 2 == 0 then SANDC else SAND_DARK, { Mat = SAND })
			end
		end
		-- palms just beyond the wall
		for i = 0, 3 do
			local z = Z0 + 30 + i * 95 + rng:NextNumber(-10, 10)
			if not (s > 0 and z > rz(150) and z < rz(345)) then
				palm(o, V(s * rng:NextNumber(152, 175), 0, z), rng:NextNumber(18, 26))
			end
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Tomb.Build(map: Instance)
	local f = Kit.Folder(map, "Tomb")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	pyramid(f, 226, rz(250), 150, 9, 11.5, -1, true)
	pyramid(f, -222, rz(110), 110, 7, 10, 1, false)
	sphinxCat(f, -100, rz(300), 1)
	treasure(f, 118, rz(262), true)
	treasure(f, 112, rz(56), false)
	treasure(f, -120, rz(232), false)

	-- obelisks: entrance pair and boss pair
	for _, s in { -1, 1 } do
		obelisk(f, s * 16, rz(48), 38)
		obelisk(f, s * 36, rz(268), 44)
	end

	-- colonnade along the road with painted lintels
	local glyphs = { "☥ 👁 ☀ 🐍 ☥", "🐈 ☀ ☥ 👁 🐈", "☀ ☥ 🪲 ☥ ☀", "👁 🐍 ☥ 🐈 👁" }
	for i, z in { rz(130), rz(152), rz(174), rz(196) } do
		for _, s in { -1, 1 } do
			column(f, s * 16, z, 20)
			Kit.AddCircle(s * 16, z, 3.5)
		end
		local lintel = Kit.Box(f, V(-19, 20, z - 2.4), V(19, 23, z + 2.4), STONE, { Mat = SANDSTONE, Shadow = true })
		Kit.Box(f, V(-19.1, 20.6, z - 2.5), V(19.1, 22.4, z - 2.42), Kit.Vivid(LAPIS))
		Kit.Sign(lintel, Enum.NormalId.Front, glyphs[i], C(255, 230, 150), { Stroke = C(60, 30, 20) })
	end

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 10 - 0.8, 0, z - 0.8), V(x + s * 10 + 0.8, 13, z + 0.8), STONE_DARK, { Mat = SANDSTONE, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "☥ PHARAOH'S TOMB ☥", Kit.Vivid(LAPIS), C(255, 220, 110), GOLD)
		Kit.AddCircle(x, z, 12)
	end

	-- torches along the road (three lit, one flickers)
	local n = 0
	for z = Z0 + 40, Z1 - 30, 40 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 20 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				n += 1
				torch(f, x, zz, n == 2 or n == 6 or n == 9, n == 6)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- palms around the oasis, then elsewhere
	local palms = 0
	for k = 0, 11 do
		local a = k * math.pi / 6
		local x, z = 75 + math.cos(a) * 40, rz(180) + math.sin(a) * 40
		if palms < 6 and Kit.IsFree(x, z, 12) then
			palms += 1
			palm(f, V(x, 0, z), rng:NextNumber(18, 20))
		end
	end
	for _ = 1, 400 do
		if palms >= 13 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 26)
		if Kit.IsFree(x, z, h * 0.42 + 3.5) then
			palms += 1
			palm(f, V(x, 0, z), h)
		end
	end

	-- urns and broken columns
	local urns, stumps = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if urns < 9 and Kit.IsFree(x, z, 2.5) then
			urns += 1
			urn(f, x, z, rng:NextNumber(1, 1.5))
			if rng:NextNumber() < 0.5 then
				urn(f, x + 2.4, z + 1, 0.8)
			end
			Kit.AddCircle(x, z, 3)
		elseif stumps < 6 and Kit.IsFree(x, z, 4) then
			stumps += 1
			local h = rng:NextNumber(3, 8)
			Kit.Cyl(f, h, 3.6, CFrame.new(x, h / 2, z), STONE, { Mat = SANDSTONE, Solid = true })
			Kit.Part(f, V(7, 3.4, 3.4), CFrame.new(x + 3.5, 1.7, z + 1) * CFrame.Angles(0, 0.6, 0), STONE_DARK, { Mat = SANDSTONE, Shape = Enum.PartType.Cylinder })
			Kit.AddCircle(x, z, 5)
		end
	end

	-- floating gems near the treasure and the pyramid entrance
	for _, p in { V(108, 8, rz(250)), V(126, 10, rz(274)), V(124, 7, rz(46)), V(-128, 9, rz(222)), V(130, 12, rz(300)) } do
		local g = Kit.Part(f, V(1.4, 1.4, 1.4), CFrame.new(p) * CFrame.Angles(0.6, 0.3, 0.6), Kit.Vivid(Kit.Pick({ TURQ, C(230, 60, 90), C(170, 90, 240), GOLD })), { Refl = 0.3, Name = "FloatingGem" })
		Kit.Float(g, rng:NextNumber(0.6, 1.2))
	end

	outside(f)
end

return Tomb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">TowerEntrance</string>
            <string name="Source"><![CDATA[--!strict
-- BOSS TOWER ENTRANCE (workspace.Map.TowerEntrance) in the lobby's wider left side, just
-- outside the Pet Hatchery, turned to face the spawn plaza so it is visible from spawn.
-- Built in a local frame `base` (origin = the party pad centre Config.Layout.TowerEntrance.Pad,
-- local -Z = front, toward the spawn):
--   * the party pad (part "TowerPad", radius Config.Tower.PadRadius) at the origin;
--     TowerService finds Map.TowerEntrance.TowerPad and adds the "Enter Boss Tower" prompt;
--   * the ENDLESS BOSS TOWER behind it (local Z 11..21, X -9..9, spire orb at Y ~52: taller
--     than the hatchery and HQ, smaller than the old plaza tower), door facing the pad;
--   * the "BOSS TOWER" arch in front of the pad (local Z -13), facing the plaza.
-- The whole lobby is a keep-out (Builder), so no random props land here.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)

local TowerEntrance = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local STONE = C(92, 66, 138)
local STONE_DARK = C(62, 44, 96)
local STONE_LIGHT = C(128, 98, 178)
local ROOF = C(70, 40, 110)
local ECTO = C(110, 255, 160)

-- tower footprint (local): X -TW..TW, Z TZ1..TZ2 (door face at TZ1)
local TW, TZ1, TZ2 = 9, 11, 21
local HALL_H = 18
local ARCH_Z = -13

function TowerEntrance.Build(map: Instance)
	local m = Kit.Model(map, "TowerEntrance")
	local P = Config.Layout.TowerEntrance.Pad
	local spawnPos = Config.Layout.Spawn
	local base = CFrame.new(P.X, 0, P.Z) * CFrame.Angles(0, Kit.FaceYaw(spawnPos.X - P.X, spawnPos.Z - P.Z), 0)
	local function L(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	-- local box from corner (x1, y1, z1) to (x2, y2, z2)
	local function box(x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, color: Color3, opts: Kit.Opts?): Part
		local size = V(math.abs(x2 - x1), math.abs(y2 - y1), math.abs(z2 - z1))
		return Kit.Part(m, size, L((x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2), color, opts)
	end
	local stone: Kit.Opts = { Mat = Enum.Material.Slate, Solid = true }

	local function battlements(x1: number, z1: number, x2: number, z2: number, y: number)
		for x = x1, x2 - 1.2, 2.5 do
			box(x, y, z1, x + 1.2, y + 1.6, z1 + 1, STONE_LIGHT, { Mat = Enum.Material.Slate })
			box(x, y, z2 - 1, x + 1.2, y + 1.6, z2, STONE_LIGHT, { Mat = Enum.Material.Slate })
		end
		for z = z1 + 2.5, z2 - 2.5, 2.5 do
			box(x1, y, z, x1 + 1, y + 1.6, z + 1.2, STONE_LIGHT, { Mat = Enum.Material.Slate })
			box(x2 - 1, y, z, x2, y + 1.6, z + 1.2, STONE_LIGHT, { Mat = Enum.Material.Slate })
		end
	end
	-- painted ectoplasm band (solid, not Neon) around a footprint
	local function band(x1: number, z1: number, x2: number, z2: number, y: number)
		local paint = Kit.Vivid(ECTO)
		box(x1 - 0.3, y, z1 - 0.3, x2 + 0.3, y + 0.7, z1 + 0.2, paint)
		box(x1 - 0.3, y, z2 - 0.2, x2 + 0.3, y + 0.7, z2 + 0.3, paint)
		box(x1 - 0.3, y, z1, x1 + 0.2, y + 0.7, z2, paint)
		box(x2 - 0.2, y, z1, x2 + 0.3, y + 0.7, z2, paint)
	end
	-- gable roof (ridge along local X) over (x, cz) from y up by height
	local function gable(x: number, y: number, cz: number, width: number, height: number, depth: number)
		local half = depth / 2
		Kit.Wedge(m, V(width, height, half), L(x, y + height / 2, cz - half / 2), ROOF, { Mat = Enum.Material.Slate })
		Kit.Wedge(m, V(width, height, half), L(x, y + height / 2, cz + half / 2) * CFrame.Angles(0, math.pi, 0), ROOF, { Mat = Enum.Material.Slate })
	end
	-- stone post with a glowing ghost lantern on top
	local function lantern(x: number, z: number, h: number, light: boolean)
		local p = L(x, 0, z).Position
		local px, pz = p.X, p.Z
		Kit.Box(m, V(px - 0.7, 0, pz - 0.7), V(px + 0.7, h, pz + 0.7), STONE_DARK, stone)
		Kit.Box(m, V(px - 1.1, h, pz - 1.1), V(px + 1.1, h + 0.45, pz + 1.1), STONE_LIGHT, { Mat = Enum.Material.Slate })
		Kit.Box(m, V(px - 0.8, h + 0.45, pz - 0.8), V(px + 0.8, h + 2.8, pz + 0.8), C(40, 30, 60), { Mat = Enum.Material.Glass, Transp = 0.55 })
		local glow = Kit.Ball(m, 1.2, V(px, h + 1.6, pz), ECTO, { Mat = NEON })
		Kit.Box(m, V(px - 1.1, h + 2.8, pz - 1.1), V(px + 1.1, h + 3.2, pz + 1.1), STONE_DARK, { Mat = Enum.Material.Metal })
		if light then
			Kit.Light(glow, ECTO, 16, 1.1, true)
		end
	end

	--------------------------------------------------------------- TOWER
	box(-TW, 0, TZ1, TW, HALL_H, TZ2, STONE, stone) -- base hall
	box(-TW - 0.5, 0, TZ1 - 0.5, TW + 0.5, 1.6, TZ2 + 0.5, STONE_DARK, stone) -- plinth
	band(-TW, TZ1, TW, TZ2, HALL_H - 0.7)
	battlements(-TW, TZ1, TW, TZ2, HALL_H)
	-- front corner turrets with pointed roofs
	for _, sx in { -1, 1 } do
		local tx = sx * (TW - 1.5)
		Kit.Cyl(m, 24, 4.6, L(tx, 12, TZ1 + 1.5), STONE_DARK, stone)
		Kit.Cyl(m, 0.7, 5.2, L(tx, 23.9, TZ1 + 1.5), Kit.Vivid(ECTO))
		gable(tx, 24.2, TZ1 + 1.5, 5.4, 4.5, 5.4)
	end
	-- upper tower
	local ux, uz1, uz2, uy = 6, TZ1 + 1.5, TZ2 - 1, 37
	box(-ux, HALL_H, uz1, ux, uy, uz2, STONE_LIGHT, stone)
	band(-ux, uz1, ux, uz2, 27)
	band(-ux, uz1, ux, uz2, uy - 0.7)
	battlements(-ux, uz1, ux, uz2, uy)
	-- spire with a floating ectoplasm orb
	local ucz = (uz1 + uz2) / 2
	box(-ux + 2, uy, uz1 + 2, ux - 2, uy + 4, uz2 - 2, STONE_DARK, stone)
	gable(0, uy + 4, ucz, ux * 2 - 3, 8, uz2 - uz1 - 3)
	local orb = Kit.Ball(m, 2.6, L(0, uy + 15, ucz).Position, ECTO, { Mat = NEON })
	Kit.Float(orb, 1)
	Kit.Light(orb, ECTO, 26, 1.4)
	-- windows on the front of the upper tower, carved ghost eyes above them
	for _, wx in { -3.2, 0, 3.2 } do
		box(wx - 0.8, 29, uz1 - 0.25, wx + 0.8, 32.5, uz1 + 0.05, ECTO, { Mat = NEON })
		box(wx - 0.8, 21, uz1 - 0.25, wx + 0.8, 24.5, uz1 + 0.05, C(25, 15, 40))
	end
	for _, s in { -1, 1 } do
		local fx = s * 2.8
		Kit.Ball(m, 1, L(fx - 0.6, 34.6, uz1 - 0.15).Position, C(25, 15, 40))
		Kit.Ball(m, 1, L(fx + 0.6, 34.6, uz1 - 0.15).Position, C(25, 15, 40))
	end
	-- the door: dark arch with an ectoplasm portal glow and a stone frame
	local dw = 4
	box(-dw, 0, TZ1 - 0.4, dw, 10, TZ1 + 0.2, C(25, 15, 40), { Name = "TowerDoor" })
	local portal = box(-dw + 0.8, 0.3, TZ1 - 0.55, dw - 0.8, 9, TZ1 - 0.45, ECTO, { Mat = NEON, Transp = 0.45, Name = "Portal" })
	Kit.Emitter(portal, ECTO, 3, 2.4, 0.5)
	for _, s in { -1, 1 } do
		local fx = s * (dw + 1.1)
		box(fx - 1.1, 0, TZ1 - 1.6, fx + 1.1, 11.5, TZ1, STONE_LIGHT, stone)
	end
	box(-dw - 2.2, 10, TZ1 - 1.6, dw + 2.2, 12, TZ1, STONE_LIGHT, stone)
	-- sign over the door
	local signCF = L(0, 14.6, TZ1 - 1.2)
	local sign = Kit.Part(m, V(15, 3.2, 0.5), signCF, C(45, 25, 80))
	Kit.Part(m, V(15.8, 3.9, 0.3), signCF * CFrame.new(0, 0, 0.4), Kit.Vivid(ECTO))
	Kit.Sign(sign, Enum.NormalId.Front, "ENDLESS BOSS TOWER", C(150, 255, 170))
	lantern(-TW + 1, TZ1 - 3, 5, true)
	lantern(TW - 1, TZ1 - 3, 5, false)

	--------------------------------------------------------------- PAD
	-- flat party pad (top at 0.34): the TowerPad part carries the prompt (added by TowerService)
	local r = Config.Tower.PadRadius
	Kit.Disc(m, P.X, P.Z, 0.24, r * 2 + 1.4, 0.3, Kit.Vivid(ECTO), { Solid = true })
	Kit.Disc(m, P.X, P.Z, 0.3, r * 2 - 1, 0.3, C(70, 45, 120), { Mat = Enum.Material.Slate, Solid = true, Name = "TowerPad" })
	Kit.Disc(m, P.X, P.Z, 0.34, 5, 0.08, Kit.Vivid(C(190, 120, 255)))
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local d = L(math.cos(a) * (r - 2.4), 0, math.sin(a) * (r - 2.4)).Position
		Kit.Disc(m, d.X, d.Z, 0.34, 1.6, 0.08, Kit.Vivid(ECTO))
	end
	-- flat cobble apron joining the pad to the door and out through the arch (top 0.14)
	box(-4, -0.4, r - 0.5, 4, 0.14, TZ1 - 1.6, C(110, 90, 150), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "TowerPath" })
	box(-5, -0.4, ARCH_Z - 5, 5, 0.14, -r + 0.5, C(110, 90, 150), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "TowerPath" })

	--------------------------------------------------------------- ARCH
	local ah = 16
	for _, s in { -1, 1 } do
		local ax = s * 11
		box(ax - 1, 0, ARCH_Z - 1, ax + 1, ah, ARCH_Z + 1, STONE, stone)
		Kit.Ball(m, 2.6, L(ax, ah + 1, ARCH_Z).Position, Kit.Vivid(ECTO))
	end
	local archCF = L(0, ah - 2.6, ARCH_Z)
	local arch = Kit.Part(m, V(20, 4.2, 0.8), archCF, C(45, 25, 80), { Name = "TowerArchSign" })
	Kit.Part(m, V(21, 5, 0.4), archCF * CFrame.new(0, 0, 0.5), Kit.Vivid(C(190, 120, 255)))
	-- title between two icon images: the tower icon once uploaded, else the Spirit Shards icon
	-- (shards are what the tower pays); plain text if neither image exists
	local icon = Icons.Get("tower") or Icons.Get("shards")
	if icon then
		local g = Kit.Gui(arch, Enum.NormalId.Front)
		for _, x in { 0.02, 0.8 } do
			local img = Instance.new("ImageLabel")
			img.Name = "TowerIcon"
			img.BackgroundTransparency = 1
			img.Image = icon
			img.ScaleType = Enum.ScaleType.Fit
			img.Position = UDim2.fromScale(x, 0.07)
			img.Size = UDim2.fromScale(0.18, 0.86) -- about square on the 20 x 4.2 board
			img.Parent = g
		end
		Kit.Label(g, "BOSS TOWER", C(150, 255, 170), { Size = UDim2.fromScale(0.58, 0.8), Pos = UDim2.fromScale(0.21, 0.1) })
	else
		Kit.Sign(arch, Enum.NormalId.Front, "BOSS TOWER", C(150, 255, 170))
	end
	lantern(-8, ARCH_Z - 3, 4, false)
	lantern(8, ARCH_Z - 3, 4, true)

	Kit.AddCircle(P.X, P.Z, 30)
end

return TowerEntrance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">TowerRoom</string>
            <string name="Source"><![CDATA[--!strict
-- BOSS TOWER room geometry, built at runtime by TowerService for one run in its own far-away
-- slot (outside the main map). Anchored, solid 4-stud floor (top at origin.Y), stone walls all
-- round (no ceiling), pillars with ghost lanterns, a painted rune circle where the boss floats,
-- the entry portal on the south wall and a ROOM n sign on the north wall.
--
-- Rooms are not part of the map build, so they don't use the map's Kit light/emitter budgets:
-- the few lights here are created directly (4 per room) and the room is destroyed with the run.
local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)

local TowerRoom = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local HALF = 48 -- room spans origin +-HALF in X and Z
local WALL_H = 26
local ECTO = C(110, 255, 160)
local STONE = C(78, 58, 118)
local STONE_DARK = C(48, 34, 74)
local STONE_LIGHT = C(120, 94, 170)

-- Accent colour per boss in the cycle (room 1 Warden, 2 Jester, 3 Baron, 4 Titan, ...).
local ACCENTS = { C(110, 255, 160), C(255, 200, 80), C(120, 200, 255), C(200, 140, 255) }

local function light(part: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
end

-- Where the party appears: the south end of the room, facing the boss (+Z).
function TowerRoom.Entry(origin: Vector3): Vector3
	return origin + V(0, 0, -HALF + 12)
end

-- Centre of the boss's wander circle.
function TowerRoom.BossCenter(origin: Vector3): Vector3
	return origin + V(0, 0, 8)
end

TowerRoom.BossRadius = 10

local function ringPaint(parent: Instance, cx: number, cz: number, y: number, r: number, n: number, w: number, color: Color3, name: string?)
	local segLen = 2 * math.pi * r / n + 0.4
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, y + 0.05, cz + math.sin(a) * r)
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Kit.Part(parent, V(w, 0.12, segLen), CFrame.lookAt(p, p + tangent), color, { Name = name })
	end
end

local function lanternPillar(m: Model, x: number, z: number, y: number, lit: boolean)
	Kit.Box(m, V(x - 2, y, z - 2), V(x + 2, y + 20, z + 2), STONE_LIGHT, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(x - 2.5, y, z - 2.5), V(x + 2.5, y + 1.5, z + 2.5), STONE_DARK, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(x - 2.5, y + 20, z - 2.5), V(x + 2.5, y + 21, z + 2.5), STONE_DARK, { Mat = Enum.Material.Slate })
	local glow = Kit.Ball(m, 2, V(x, y + 22.4, z), ECTO, { Mat = NEON, Name = "Accent" })
	if lit then
		light(glow, ECTO, 34, 1.4)
	end
end

-- Builds the room for one slot. The model holds a "RoomSign" label and "Accent" parts that
-- SetRoom updates.
function TowerRoom.Build(parent: Instance, origin: Vector3, slot: number): Model
	local m = Instance.new("Model")
	m.Name = "TowerRoom_" .. slot
	local ox, oy, oz = origin.X, origin.Y, origin.Z
	local solid: Kit.Opts = { Mat = Enum.Material.Slate, Solid = true }

	-- floor (4 thick) with a darker inlay and painted runes under the boss
	local floor = Kit.Box(m, V(ox - HALF - 3, oy - 4, oz - HALF - 3), V(ox + HALF + 3, oy, oz + HALF + 3), STONE_DARK, { Mat = Enum.Material.Slate, Solid = true, Name = "Floor" })
	Kit.Box(m, V(ox - HALF + 4, oy, oz - HALF + 4), V(ox + HALF - 4, oy + 0.06, oz + HALF - 4), STONE, { Mat = Enum.Material.Slate })
	local bc = TowerRoom.BossCenter(origin)
	ringPaint(m, bc.X, bc.Z, oy, 18, 28, 1.2, Kit.Vivid(ECTO), "Accent")
	ringPaint(m, bc.X, bc.Z, oy, 11, 20, 0.7, Kit.Vivid(C(255, 110, 220)))
	Kit.Disc(m, bc.X, bc.Z, oy + 0.2, 6, 0.12, Kit.Vivid(C(190, 120, 255)))
	-- carpet from the entry to the circle
	Kit.Box(m, V(ox - 3, oy, oz - HALF + 4), V(ox + 3, oy + 0.1, bc.Z - 18), C(120, 30, 60), { Mat = Enum.Material.Fabric })

	-- walls (no ceiling) with an ectoplasm band and battlements
	local w = 3
	Kit.Box(m, V(ox - HALF - w, oy, oz - HALF - w), V(ox + HALF + w, oy + WALL_H, oz - HALF), STONE, solid)
	Kit.Box(m, V(ox - HALF - w, oy, oz + HALF), V(ox + HALF + w, oy + WALL_H, oz + HALF + w), STONE, solid)
	Kit.Box(m, V(ox - HALF - w, oy, oz - HALF), V(ox - HALF, oy + WALL_H, oz + HALF), STONE, solid)
	Kit.Box(m, V(ox + HALF, oy, oz - HALF), V(ox + HALF + w, oy + WALL_H, oz + HALF), STONE, solid)
	local paint = Kit.Vivid(ECTO)
	Kit.Box(m, V(ox - HALF, oy + 18, oz - HALF), V(ox + HALF, oy + 19, oz - HALF + 0.3), paint, { Name = "Accent" })
	Kit.Box(m, V(ox - HALF, oy + 18, oz + HALF - 0.3), V(ox + HALF, oy + 19, oz + HALF), paint, { Name = "Accent" })
	Kit.Box(m, V(ox - HALF, oy + 18, oz - HALF), V(ox - HALF + 0.3, oy + 19, oz + HALF), paint, { Name = "Accent" })
	Kit.Box(m, V(ox + HALF - 0.3, oy + 18, oz - HALF), V(ox + HALF, oy + 19, oz + HALF), paint, { Name = "Accent" })
	for i = -HALF, HALF - 2, 6 do
		Kit.Box(m, V(ox + i, oy + WALL_H, oz - HALF - w), V(ox + i + 3, oy + WALL_H + 2.5, oz - HALF), STONE_LIGHT, { Mat = Enum.Material.Slate })
		Kit.Box(m, V(ox + i, oy + WALL_H, oz + HALF), V(ox + i + 3, oy + WALL_H + 2.5, oz + HALF + w), STONE_LIGHT, { Mat = Enum.Material.Slate })
		Kit.Box(m, V(ox - HALF - w, oy + WALL_H, oz + i), V(ox - HALF, oy + WALL_H + 2.5, oz + i + 3), STONE_LIGHT, { Mat = Enum.Material.Slate })
		Kit.Box(m, V(ox + HALF, oy + WALL_H, oz + i), V(ox + HALF + w, oy + WALL_H + 2.5, oz + i + 3), STONE_LIGHT, { Mat = Enum.Material.Slate })
	end

	-- pillars with ghost lanterns (4 of them lit)
	for _, sx in { -1, 1 } do
		for k, z in { -HALF + 8, -6, HALF - 8 } do
			lanternPillar(m, ox + sx * (HALF - 6), oz + z, oy, k ~= 2)
		end
	end

	-- entry portal on the south wall (behind the party)
	Kit.Box(m, V(ox - 7, oy, oz - HALF), V(ox + 7, oy + 16, oz - HALF + 0.6), C(25, 15, 40))
	Kit.Box(m, V(ox - 5.5, oy + 0.3, oz - HALF + 0.6), V(ox + 5.5, oy + 14, oz - HALF + 0.8), ECTO, { Mat = NEON, Transp = 0.5 })
	Kit.Box(m, V(ox - 9, oy, oz - HALF + 0.6), V(ox - 7, oy + 18, oz - HALF + 2.2), STONE_LIGHT, solid)
	Kit.Box(m, V(ox + 7, oy, oz - HALF + 0.6), V(ox + 9, oy + 18, oz - HALF + 2.2), STONE_LIGHT, solid)
	Kit.Box(m, V(ox - 9, oy + 16, oz - HALF + 0.6), V(ox + 9, oy + 18, oz - HALF + 2.2), STONE_LIGHT, solid)

	-- ROOM n sign on the north wall, facing the party
	local signCF = CFrame.new(ox, oy + 13, oz + HALF - 0.5) * CFrame.Angles(0, Kit.FaceYaw(0, -1), 0)
	local sign = Kit.Part(m, V(26, 7, 0.6), signCF, C(45, 25, 80))
	Kit.Part(m, V(27, 8, 0.3), signCF * CFrame.new(0, 0, 0.45), paint, { Name = "Accent" })
	local label = Kit.Sign(sign, Enum.NormalId.Front, "ROOM 1", C(150, 255, 170))
	label.Name = "RoomSign"
	-- hanging banners either side of the sign
	for _, s in { -1, 1 } do
		Kit.Box(m, V(ox + s * 20 - 3, oy + 6, oz + HALF - 0.6), V(ox + s * 20 + 3, oy + 20, oz + HALF - 0.3), C(110, 30, 70), { Mat = Enum.Material.Fabric })
		Kit.Ball(m, 2.4, V(ox + s * 20, oy + 15, oz + HALF - 0.8), paint, { Name = "Accent" })
	end

	m.PrimaryPart = floor
	m.Parent = parent
	return m
end

-- Updates the room number sign and the accent colour for room n.
function TowerRoom.SetRoom(m: Model, n: number)
	local accent = ACCENTS[(n - 1) % #ACCENTS + 1]
	for _, d in m:GetDescendants() do
		if d.Name == "RoomSign" and d:IsA("TextLabel") then
			d.Text = "ROOM " .. n
			d.TextColor3 = accent
		elseif d.Name == "Accent" and d:IsA("BasePart") then
			d.Color = if d.Material == NEON then accent else Kit.Vivid(accent)
		end
	end
end

-- Treasure chest in front of the boss circle (facing the entry). It is only the visual of a
-- payout the server already credited, so it has no prompt and nothing to claim.
function TowerRoom.Chest(m: Model, origin: Vector3): Model
	local old = m:FindFirstChild("Chest")
	if old then
		old:Destroy()
	end
	local pos = TowerRoom.BossCenter(origin) + V(0, 0, -14)
	local chest = Instance.new("Model")
	chest.Name = "Chest"
	local wood, gold = C(120, 70, 40), C(255, 200, 70)
	local base = Kit.Box(chest, pos + V(-2.5, 0, -1.8), pos + V(2.5, 2.8, 1.8), wood, { Mat = Enum.Material.WoodPlanks, Solid = true, Name = "Base" })
	Kit.Box(chest, pos + V(-2.6, 0.2, -1.9), pos + V(2.6, 0.6, 1.9), gold, { Mat = Enum.Material.Metal })
	Kit.Box(chest, pos + V(-2.6, 2.3, -1.9), pos + V(2.6, 2.7, 1.9), gold, { Mat = Enum.Material.Metal })
	local glow = Kit.Box(chest, pos + V(-2.1, 2.2, -1.4), pos + V(2.1, 2.85, 1.4), ECTO, { Mat = NEON, Name = "Glow" })
	glow.Transparency = 1
	-- lid hinged along its back (+Z) top edge
	Kit.Part(chest, V(5, 1.4, 3.6), CFrame.new(pos + V(0, 3.5, 0)), wood, { Mat = Enum.Material.WoodPlanks, Name = "Lid" })
	Kit.Part(chest, V(1, 1, 0.3), CFrame.new(pos + V(0, 2, -1.95)), gold, { Mat = Enum.Material.Metal })
	chest.PrimaryPart = base
	chest.Parent = m
	return chest
end

-- Opens the chest lid (server tween; replicates to the party) and lights the inside.
function TowerRoom.OpenChest(chest: Model)
	local lid = chest:FindFirstChild("Lid") :: BasePart?
	local glow = chest:FindFirstChild("Glow") :: BasePart?
	if not lid then
		return
	end
	local hinge = lid.CFrame * CFrame.new(0, -0.7, 1.8)
	local open = hinge * CFrame.Angles(math.rad(105), 0, 0) * CFrame.new(0, 0.7, -1.8)
	TweenService:Create(lid, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = open }):Play()
	if glow then
		glow.Transparency = 0.15
		light(glow, ECTO, 16, 2)
	end
end

return TowerRoom
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">ToyFactory</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 12: Haunted Toy Factory (Z 3760..4120). A bright, open-topped factory hall.
--   Floor: pale lilac plastic (top Y = 0) inside the walls, grass outside. Main path along X = 0:
--   a sky-blue lane (X -8..8, top 0.05) with yellow edges and white dashes.
--   Walls: pink, 16 tall at X +-140..146 with a yellow rim ledge, purple skirting, sky-blue
--   windows, big gears and a candy-striped pipe on the inner faces. No roof anywhere.
--   Ghost areas hold flat paint only: a giant play mat (0, 3845), rugs, a pinwheel (75, 3940)
--   and the Puppet Master's striped stage floor (0, 4065).
--   Landmarks: a giant sitting TEDDY BEAR with a wind-up key (95, 4050, ~61 tall) and a huge
--   JACK-IN-THE-BOX (-100, 4060, ~62 tall), plus striped factory chimneys outside the walls.
--   Also: an entrance gantry sign, a toy train on an oval track, conveyor belts carrying toys,
--   giant lettered building blocks, a wind-up mouse, toy soldiers, gift boxes, lamp posts and
--   balloons.
-- Glow: lamp globes, the train headlamp, the jack's nose and four star glints on the stage.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local ToyFactory = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GRASS = Enum.Material.Grass
local FABRIC = Enum.Material.Fabric

local Z0, Z1 = 3760, 4120

local FLOOR = C(246, 238, 252)
local PINK = C(255, 150, 195)
local SKY = C(110, 190, 255)
local YELLOW = C(255, 215, 80)
local PURPLE = C(160, 110, 230)
local WHITE = C(255, 255, 255)
local RED = C(240, 80, 90)
local MINT = C(120, 225, 170)
local FUR = C(200, 140, 90)
local FUR_LIGHT = C(240, 205, 160)
local DARK = C(45, 35, 50)
local TOYS = { PINK, SKY, YELLOW, PURPLE, MINT, C(255, 150, 80) }

local function rz(n: number): number
	return Z0 + n
end

-- Cylinder whose axis runs along the local Z of `cf`.
local function cylZ(parent: Instance, cf: CFrame, len: number, d: number, color: Color3, opts: Kit.Opts?): Part
	local o: Kit.Opts = opts or {}
	local p = Kit.Part(parent, V(len, d, d), cf * CFrame.Angles(0, math.pi / 2, 0), color, o)
	p.Shape = Enum.PartType.Cylinder
	return p
end

--==================================================================
-- PROPS
--==================================================================
local function gift(parent: Instance, x: number, z: number, s: number, yaw: number, y: number?)
	local cf = CFrame.new(x, (y or 0) + s / 2, z) * CFrame.Angles(0, yaw, 0)
	local col = Kit.Pick(TOYS)
	local rib = if col == YELLOW then PINK else YELLOW
	Kit.Part(parent, V(s, s, s), cf, Kit.Vivid(col), { Solid = true }).CanCollide = false -- small prop: tappable/queryable but walk-through (solid ones snag players)
	Kit.Part(parent, V(s + 0.1, s + 0.1, s * 0.18), cf, Kit.Vivid(rib))
	Kit.Part(parent, V(s * 0.18, s + 0.1, s + 0.1), cf, Kit.Vivid(rib))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, s * 0.3, (cf * CFrame.new(sx * s * 0.16, s * 0.6, 0)).Position, Kit.Vivid(rib))
	end
end

local function block(parent: Instance, cf: CFrame, s: number, col: Color3, letter: string)
	local b = Kit.Part(parent, V(s, s, s), cf, Kit.Vivid(col), { Solid = true, Shadow = true })
	Kit.Sign(b, Enum.NormalId.Front, letter, WHITE, { Stroke = DARK })
	Kit.Sign(b, Enum.NormalId.Right, letter, WHITE, { Stroke = DARK })
end

local function blockStack(parent: Instance, x: number, z: number, s: number, letters: string)
	local rng = Kit.Rng
	local n = #letters
	for i = 1, n do
		local cf = CFrame.new(x + rng:NextNumber(-0.6, 0.6), s * (i - 0.5), z + rng:NextNumber(-0.6, 0.6)) * CFrame.Angles(0, rng:NextNumber(-0.35, 0.35), 0)
		block(parent, cf, s, TOYS[(i % #TOYS) + 1], string.sub(letters, i, i))
	end
	Kit.AddCircle(x, z, s * 0.8 + 1)
end

local function soldier(parent: Instance, x: number, z: number, fx: number, fz: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local blue = Kit.Vivid(C(60, 90, 200))
	for _, s in { -1, 1 } do
		Kit.Part(parent, V(1.1, 3.4, 1.3), base * CFrame.new(s * 0.7, 1.7, 0), blue)
		Kit.Part(parent, V(0.9, 3.2, 0.9), base * CFrame.new(s * 2, 5.4, 0), Kit.Vivid(RED))
	end
	Kit.Part(parent, V(3.2, 3.6, 2), base * CFrame.new(0, 5.2, 0), Kit.Vivid(RED), { Solid = true })
	Kit.Part(parent, V(3.3, 0.6, 2.1), base * CFrame.new(0, 4, 0), WHITE)
	Kit.Ball(parent, 2.4, (base * CFrame.new(0, 8, 0)).Position, C(255, 220, 190))
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.4, (base * CFrame.new(s * 0.45, 8.2, -1.1)).Position, DARK)
	end
	Kit.Cyl(parent, 2.8, 2.2, base * CFrame.new(0, 10.3, 0), DARK)
	Kit.Ball(parent, 0.9, (base * CFrame.new(0, 11.9, 0)).Position, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 3)
end

local function conveyor(parent: Instance, x: number, z1: number, z2: number, col: Color3)
	local m = Kit.Model(parent, "Conveyor")
	Kit.Box(m, V(x - 3, 0, z1), V(x + 3, 3, z2), Kit.Vivid(col), { Solid = true, Shadow = true })
	Kit.Box(m, V(x - 2.6, 3, z1), V(x + 2.6, 3.3, z2), C(70, 70, 90), { Mat = Enum.Material.Rubber })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 3 - 0.05, 1.2, z1), V(x + s * 3 + 0.05, 1.8, z2), Kit.Vivid(YELLOW))
	end
	for _, z in { z1, z2 } do
		Kit.CylFlat(m, 6.4, 3.4, V(x, 1.7, z), "X", Kit.Vivid(YELLOW), { Mat = METAL })
	end
	local rng = Kit.Rng
	local n = math.floor((z2 - z1) / 14)
	for i = 1, n do
		local z = z1 + i * (z2 - z1) / (n + 1)
		if i % 2 == 0 then
			Kit.Ball(m, 2.6, V(x, 4.6, z), Kit.Vivid(Kit.Pick(TOYS)))
		else
			local s = rng:NextNumber(2, 2.8)
			Kit.Part(m, V(s, s, s), CFrame.new(x, 3.3 + s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), Kit.Vivid(Kit.Pick(TOYS)))
		end
	end
	Kit.AddRect(x - 4.5, z1 - 2, x + 4.5, z2 + 2)
end

local function windupMouse(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "WindupMouse")
	local grey = C(185, 185, 205)
	Kit.Part(m, V(5, 4, 8), CFrame.new(x, 2.2, z), grey, { Solid = true })
	Kit.Ball(m, 5, V(x, 2.6, z - 3.6), grey)
	Kit.Ball(m, 1, V(x, 2.6, z - 6.2), Kit.Vivid(PINK))
	for _, s in { -1, 1 } do
		cylZ(m, CFrame.new(x + s * 1.6, 5.2, z - 3), 0.4, 3, Kit.Vivid(PINK))
		Kit.Ball(m, 0.6, V(x + s * 1, 3.4, z - 5.6), DARK)
	end
	Props.Beam(m, V(x, 1, z + 4), V(x + 2, 2.6, z + 9), 0.4, 0.4, Kit.Vivid(PINK))
	-- wind-up key on its back
	Kit.Cyl(m, 2.4, 0.5, CFrame.new(x, 5.3, z + 1), Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		cylZ(m, CFrame.new(x + s * 1.3, 7, z + 1) * CFrame.Angles(0, math.pi / 2, 0), 0.5, 2.6, Kit.Vivid(YELLOW), { Mat = METAL })
	end
	Kit.AddCircle(x, z, 7)
end

local function gear(parent: Instance, x: number, y: number, z: number, d: number, col: Color3)
	-- a gear flat against a wall that faces X (x is the wall's inner face)
	local s = if x > 0 then -1 else 1 -- direction into the hall
	Kit.CylFlat(parent, 0.8, d, V(x + s * 0.4, y, z), "X", col, { Mat = METAL })
	for k = 0, 5 do
		local a = k * math.pi / 3
		Kit.Part(parent, V(0.8, d * 0.2, d * 0.2), CFrame.new(x + s * 0.4, y + math.cos(a) * d / 2, z + math.sin(a) * d / 2) * CFrame.Angles(a, 0, 0), col, { Mat = METAL })
	end
	Kit.CylFlat(parent, 1, d * 0.32, V(x + s * 0.6, y, z), "X", Kit.Vivid(YELLOW), { Mat = METAL })
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-140, -4, Z0), V(140, 0, Z1), FLOOR, { Solid = true, Name = "Ground_ToyFactory" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -4, Z0), V(s * 190, 0, Z1), C(120, 205, 110), { Mat = GRASS, Solid = true })
	end
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), SKY, { Solid = true, Name = "FactoryLane" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.6, 0.05, Z0), V(s * 8 + 0.6, 0.1, Z1), Kit.Vivid(YELLOW))
	end
	for z = Z0 + 10, Z1 - 10, 18 do
		Kit.Box(f, V(-0.4, 0.05, z), V(0.4, 0.08, z + 7), WHITE)
	end
	-- coloured work zones painted on the floor
	Kit.Box(f, V(58, 0, rz(12)), V(120, 0.02, rz(142)), C(255, 225, 238))
	Kit.Box(f, V(-136, 0, rz(8)), V(-48, 0.02, rz(90)), C(225, 240, 255))
	Kit.Box(f, V(20, 0, rz(120)), V(44, 0.02, rz(212)), C(255, 246, 210))
	Kit.Box(f, V(-44, 0, rz(124)), V(-20, 0.02, rz(206)), C(232, 250, 238))
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 16, zB), PINK, { Solid = true, Shadow = true })
		Kit.Box(f, V(s * 138.5, 16, zA), V(s * 146.5, 17.5, zB), Kit.Vivid(YELLOW))
		Kit.Box(f, V(s * 139.6, 0, zA), V(s * 140, 1.6, zB), Kit.Vivid(PURPLE))
		-- candy-striped pipe along the wall
		Kit.CylFlat(f, zB - zA - 10, 2.6, V(s * 137.5, 12.5, (zA + zB) / 2), "Z", WHITE, { Mat = METAL })
		for z = zA + 12, zB - 10, 24 do
			Kit.CylFlat(f, 3, 2.9, V(s * 137.5, 12.5, z), "Z", Kit.Vivid(RED), { Mat = METAL })
		end
		for _, z in { zA + 6, zB - 6 } do
			Kit.Cyl(f, 12.5, 2.6, CFrame.new(s * 137.5, 6.25, z), WHITE, { Mat = METAL })
			Kit.Cyl(f, 2, 2.9, CFrame.new(s * 137.5, 4, z), Kit.Vivid(RED), { Mat = METAL })
		end
		-- windows and gears on the inner face
		for i, z in { rz(40), rz(100), rz(160), rz(220), rz(280), rz(330) } do
			if i % 2 == 1 then
				Kit.Box(f, V(s * 139.9, 3.5, z - 8), V(s * 139.65, 10, z + 8), Kit.Vivid(SKY), { Refl = 0.2 })
				Kit.Box(f, V(s * 139.95, 6.6, z - 8), V(s * 139.6, 6.9, z + 8), WHITE)
			else
				gear(f, s * 140, 7, z, 9, if i % 4 == 0 then Kit.Vivid(PURPLE) else Kit.Vivid(MINT))
			end
		end
	end
end

local function gantry(f: Instance)
	local z = rz(44)
	for _, s in { -1, 1 } do
		Kit.Cyl(f, 26, 2.4, CFrame.new(s * 14, 13, z), Kit.Vivid(PINK), { Solid = true })
		for _, y in { 8, 18 } do
			Kit.Cyl(f, 1.6, 2.7, CFrame.new(s * 14, y, z), WHITE)
		end
		Kit.AddCircle(s * 14, z, 2)
	end
	local beam = Kit.Box(f, V(-17, 22, z - 1.6), V(17, 27, z + 1.6), Kit.Vivid(YELLOW), { Shadow = true })
	Kit.Sign(beam, Enum.NormalId.Front, "🧸 HAUNTED TOY FACTORY 🧸", Kit.Vivid(PURPLE), { Stroke = WHITE })
	for _, s in { -1, 1 } do
		Kit.CylFlat(f, 1, 6, V(s * 17.5, 24.5, z - 0.4), "Z", Kit.Vivid(SKY), { Mat = METAL })
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- toy soldiers: giant play mat
	local cz = rz(85)
	local sizes = { 64, 58, 44, 30, 12 }
	local cols = { PINK, YELLOW, SKY, WHITE, PINK }
	for i, d in sizes do
		Kit.Disc(f, 0, cz, 0.02 + i * 0.025, d, 0.02, Kit.Vivid(cols[i]))
	end
	-- rugs with polka dots
	for k, a in { { -82, rz(120) }, { -62, rz(240) } } do
		Kit.Disc(f, a[1], a[2], 0.04, 51, 0.03, Kit.Vivid(if k == 1 then SKY else PURPLE))
		Kit.Disc(f, a[1], a[2], 0.07, 44, 0.03, Kit.Vivid(if k == 1 then C(190, 225, 255) else C(215, 190, 250)))
		for i = 0, 3 do
			local ang = i * math.pi / 2 + 0.4
			Kit.Disc(f, a[1] + math.cos(ang) * 12, a[2] + math.sin(ang) * 12, 0.1, 6, 0.03, WHITE)
		end
	end
	-- jack-in-the-box phantoms: pinwheel
	local px, pz = 75, rz(180)
	Kit.Disc(f, px, pz, 0.04, 54, 0.03, Kit.Vivid(YELLOW))
	for i = 0, 5 do
		local a = i * math.pi / 3
		Props.Beam(f, V(px, 0.08, pz), V(px + math.cos(a) * 24, 0.08, pz + math.sin(a) * 24), 5, 0.04, Kit.Vivid(TOYS[i + 1]))
	end
	Kit.Disc(f, px, pz, 0.12, 6, 0.03, WHITE)
	-- boss: the Puppet Master's striped stage floor
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(PURPLE))
	Kit.Disc(f, 0, bz, 0.06, 52, 0.03, Kit.Vivid(YELLOW))
	Kit.Disc(f, 0, bz, 0.08, 48, 0.03, Kit.Vivid(C(240, 70, 100)))
	for i = 0, 7 do
		local a = i * math.pi / 4
		Props.Beam(f, V(0, 0.11, bz), V(math.cos(a) * 23, 0.11, bz + math.sin(a) * 23), 4, 0.04, WHITE)
	end
	Kit.Disc(f, 0, bz, 0.14, 8, 0.03, Kit.Vivid(YELLOW))
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(f, V(1.8, 0.05, 1.8), CFrame.new(math.cos(a) * 25.5, 0.12, bz + math.sin(a) * 25.5) * CFrame.Angles(0, math.pi / 4, 0), YELLOW, { Mat = NEON })
	end
end

--==================================================================
-- TOY TRAIN
--==================================================================
local function track(f: Instance, cx: number, z1: number, z2: number, r: number)
	local bed = C(150, 110, 200)
	local rail = C(120, 125, 145)
	local function seg(a: Vector3, b: Vector3)
		Props.Beam(f, a + V(0, 0.05, 0), b + V(0, 0.05, 0), 5, 0.06, bed)
		local d = (b - a).Unit
		local side = V(-d.Z, 0, d.X) * 1.7
		for _, s in { -1, 1 } do
			Props.Beam(f, a + side * s + V(0, 0.15, 0), b + side * s + V(0, 0.15, 0), 0.5, 0.14, rail, { Mat = METAL })
		end
	end
	for _, s in { -1, 1 } do
		seg(V(cx + s * r, 0, z1), V(cx + s * r, 0, z2))
	end
	for k = 0, 3 do
		local a1, a2 = k * math.pi / 4, (k + 1) * math.pi / 4
		seg(V(cx + math.cos(a1) * r, 0, z2 + math.sin(a1) * r), V(cx + math.cos(a2) * r, 0, z2 + math.sin(a2) * r))
		seg(V(cx + math.cos(a1) * r, 0, z1 - math.sin(a1) * r), V(cx + math.cos(a2) * r, 0, z1 - math.sin(a2) * r))
	end
end

local function train(f: Instance, x: number, zc: number)
	local m = Kit.Model(f, "ToyTrain")
	local sol: Kit.Opts = { Solid = true, Shadow = true }
	-- engine (front at +Z)
	Kit.Box(m, V(x - 3, 1.6, zc - 7), V(x + 3, 3, zc + 7), Kit.Vivid(RED), sol)
	Kit.CylFlat(m, 9, 5, V(x, 5.5, zc + 2), "Z", Kit.Vivid(SKY))
	Kit.CylFlat(m, 0.6, 5.4, V(x, 5.5, zc + 6.8), "Z", Kit.Vivid(YELLOW))
	Kit.Box(m, V(x - 3, 3, zc - 7), V(x + 3, 10.5, zc - 2), Kit.Vivid(YELLOW), sol)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 3.05, 6.5, zc - 6), V(x + s * 3.1, 9, zc - 3), Kit.Vivid(SKY), { Refl = 0.2 })
	end
	Kit.Box(m, V(x - 3.6, 10.5, zc - 7.6), V(x + 3.6, 11.3, zc - 1.4), Kit.Vivid(PURPLE))
	Kit.Cyl(m, 4, 1.8, CFrame.new(x, 10, zc + 4.5), DARK)
	Kit.Cyl(m, 1, 2.8, CFrame.new(x, 12.4, zc + 4.5), Kit.Vivid(RED))
	Kit.Wedge(m, V(6, 2.2, 2.4), CFrame.new(x, 2.2, zc + 8.2) * CFrame.Angles(0, math.pi, 0), Kit.Vivid(YELLOW))
	for _, z in { zc - 4.5, zc + 0.5, zc + 5 } do
		Kit.CylFlat(m, 6.6, 3.2, V(x, 1.6, z), "X", Kit.Vivid(PINK))
	end
	-- wind-up key on the boiler
	Kit.Cyl(m, 2, 0.6, CFrame.new(x, 9, zc + 1), Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		Kit.CylFlat(m, 0.5, 2.4, V(x, 10.6, zc + 1 + s * 1.3), "X", Kit.Vivid(YELLOW), { Mat = METAL })
	end
	local lamp = Kit.Part(m, V(1.6, 1.6, 0.4), CFrame.new(x, 5.5, zc + 7.2), C(255, 245, 190), { Mat = NEON })
	Kit.Light(lamp, C(255, 240, 190), 20, 1.2)
	-- two wagons
	for i, cargo in { "blocks", "balls" } do
		local zw = zc - 7 - i * 12 + 4
		Kit.Box(m, V(x - 2.5, 1.6, zw - 5), V(x + 2.5, 5, zw + 5), Kit.Vivid(if i == 1 then MINT else PURPLE), sol)
		for _, z in { zw - 3, zw + 3 } do
			Kit.CylFlat(m, 5.6, 3, V(x, 1.5, z), "X", Kit.Vivid(YELLOW))
		end
		Kit.Box(m, V(x - 0.5, 2.2, zw + 5), V(x + 0.5, 2.8, zw + 7), DARK)
		if cargo == "blocks" then
			block(m, CFrame.new(x, 6.6, zw - 2) * CFrame.Angles(0, 0.3, 0), 3.2, YELLOW, "A")
			block(m, CFrame.new(x, 6.6, zw + 2) * CFrame.Angles(0, -0.2, 0), 3.2, SKY, "B")
		else
			Kit.Ball(m, 3.4, V(x, 6.6, zw - 2), Kit.Vivid(RED))
			Kit.Ball(m, 3.4, V(x, 6.6, zw + 2), Kit.Vivid(YELLOW))
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function teddy(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GiantTeddy")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local sol: Kit.Opts = { Mat = FABRIC, Solid = true, Shadow = true }
	local soft: Kit.Opts = { Mat = FABRIC, Shadow = true }
	local function at(lx: number, ly: number, lz: number): Vector3
		return (base * CFrame.new(lx, ly, lz)).Position
	end
	Kit.Ball(m, 34, at(0, 17, 2), FUR, sol)
	cylZ(m, base * CFrame.new(0, 15, -14.6), 0.6, 19, FUR_LIGHT, { Mat = FABRIC })
	-- legs and paw pads
	for _, s in { -1, 1 } do
		cylZ(m, base * CFrame.new(s * 8.5, 6, -10), 16, 12, FUR, sol)
		cylZ(m, base * CFrame.new(s * 8.5, 6, -18.1), 0.4, 9, Kit.Vivid(PINK), { Mat = FABRIC })
	end
	-- arms resting on the knees
	for _, s in { -1, 1 } do
		local a, b = at(s * 14, 26, -2), at(s * 15, 14, -13)
		local mid = (a + b) / 2
		local arm = Kit.Part(m, V((b - a).Magnitude, 9, 9), CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0), FUR, soft)
		arm.Shape = Enum.PartType.Cylinder
		Kit.Ball(m, 9.5, b, FUR, soft)
	end
	-- head
	Kit.Ball(m, 28, at(0, 44, 0), FUR, sol)
	Kit.Ball(m, 11, at(0, 40, -11.5), FUR_LIGHT, soft)
	Kit.Ball(m, 4, at(0, 42.5, -16.6), DARK)
	for _, s in { -1, 1 } do
		Kit.Ball(m, 3.6, at(s * 5.5, 47, -12.3), DARK)
		Kit.Ball(m, 1.2, at(s * 5.1, 47.8, -13.8), WHITE)
		Kit.Ball(m, 10, at(s * 11, 56, 0), FUR, soft)
		Kit.Ball(m, 6, at(s * 11, 56, -2.6), Kit.Vivid(PINK), { Mat = FABRIC })
		Kit.Part(m, V(5, 4, 1.4), base * CFrame.new(s * 3.4, 31.5, -14.2) * CFrame.Angles(0, 0, s * 0.35), Kit.Vivid(SKY), { Mat = FABRIC })
	end
	Kit.Ball(m, 2.8, at(0, 31.5, -14.6), Kit.Vivid(SKY), { Mat = FABRIC })
	-- wind-up key in the back
	cylZ(m, base * CFrame.new(0, 20, 21), 6, 1.4, Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		local lobe = Kit.Part(m, V(0.8, 5.5, 5.5), base * CFrame.new(s * 2.6, 20, 24.2), Kit.Vivid(YELLOW), { Mat = METAL })
		lobe.Shape = Enum.PartType.Cylinder
	end
	Kit.AddCircle(x, z, 24)
end

local function jackInTheBox(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "JackInTheBox")
	local sol: Kit.Opts = { Solid = true, Shadow = true }
	-- the box (front faces +X toward the lane)
	Kit.Box(m, V(x - 11, 0, z - 11), V(x + 11, 22, z + 11), Kit.Vivid(PINK), sol)
	Kit.Box(m, V(x - 11.5, 21, z - 11.5), V(x + 11.5, 22.5, z + 11.5), Kit.Vivid(PURPLE))
	local front = Kit.Box(m, V(x + 11, 3, z - 8), V(x + 11.3, 19, z + 8), Kit.Vivid(YELLOW))
	Kit.Sign(front, Enum.NormalId.Right, "★", Kit.Vivid(RED), { Stroke = WHITE })
	local side = Kit.Box(m, V(x - 8, 3, z - 11.3), V(x + 8, 19, z - 11), Kit.Vivid(SKY))
	Kit.Sign(side, Enum.NormalId.Front, "JACK", WHITE, { Stroke = Kit.Vivid(PURPLE) })
	-- lid flipped open at the back
	Kit.Part(m, V(1, 22, 22), CFrame.new(x - 11, 22.5, z) * CFrame.Angles(0, 0, 0.3) * CFrame.new(-0.5, 11, 0), Kit.Vivid(PURPLE), { Shadow = true })
	-- crank handle on the +Z side
	Kit.CylFlat(m, 3, 1.2, V(x, 12, z + 12.5), "Z", Kit.Vivid(YELLOW), { Mat = METAL })
	Props.Beam(m, V(x, 12, z + 14), V(x + 4, 15, z + 14), 0.8, 0.8, Kit.Vivid(YELLOW), { Mat = METAL })
	Kit.Ball(m, 2, V(x + 4, 15, z + 14.8), Kit.Vivid(RED))
	-- spring
	for i = 0, 6 do
		Kit.Cyl(m, 2.2, 7, CFrame.new(x + (if i % 2 == 0 then 0.8 else -0.8), 23.6 + i * 2.6, z), C(200, 205, 220), { Mat = METAL })
	end
	-- ruff, head, face, jester hat
	Kit.Cyl(m, 2, 15, CFrame.new(x, 41.5, z), Kit.Vivid(YELLOW), { Mat = FABRIC })
	Kit.Ball(m, 14, V(x, 49, z), C(255, 236, 222))
	local nose = Kit.Ball(m, 2.6, V(x + 6.9, 49, z), RED, { Mat = NEON })
	Kit.Light(nose, C(255, 120, 130), 22, 1.2)
	for _, s in { -1, 1 } do
		Kit.Ball(m, 1.8, V(x + 6, 51.4, z + s * 2.6), DARK)
		Kit.Ball(m, 2.2, V(x + 5.6, 47.6, z + s * 4.3), Kit.Vivid(C(255, 170, 190)))
		Props.Beam(m, V(x, 55, z + s * 1.5), V(x - 1, 62, z + s * 8), 3.4, 3.4, Kit.Vivid(if s < 0 then PURPLE else SKY), { Mat = FABRIC })
		Kit.Ball(m, 2.6, V(x - 1, 62.8, z + s * 8.6), Kit.Vivid(YELLOW))
	end
	Kit.Part(m, V(0.5, 0.9, 5), CFrame.new(x + 6.7, 45.6, z), Kit.Vivid(RED))
	Kit.Cyl(m, 2.4, 12, CFrame.new(x, 55, z), Kit.Vivid(PURPLE), { Mat = FABRIC })
	-- confetti puffing out of the box
	local src = Kit.Part(m, V(10, 1, 10), CFrame.new(x, 24, z), WHITE, { Transp = 1, Name = "ConfettiSource" })
	local e = Kit.Emitter(src, PINK, 4, 0.6, 3)
	if e then
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, PINK),
			ColorSequenceKeypoint.new(0.33, SKY),
			ColorSequenceKeypoint.new(0.66, YELLOW),
			ColorSequenceKeypoint.new(1, PURPLE),
		})
		e.LightEmission = 0.2
		e.Size = NumberSequence.new(0.5)
		e.Transparency = NumberSequence.new(0)
		e.Lifetime = NumberRange.new(2, 3.5)
		e.Acceleration = V(0, -4, 0)
		e.EmissionDirection = Enum.NormalId.Top
	end
	Kit.AddCircle(x, z, 17)
end

--==================================================================
-- OUTSIDE
--==================================================================
local function outside(f: Instance)
	local o = Kit.Folder(f, "Outside")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), C(120, 205, 110), { Mat = GRASS })
		for i, h in { { 60, 92 }, { 250, 80 } } do
			local cx, cz, ht = s * (180 + i * 14), rz(h[1]), h[2]
			Kit.Cyl(o, ht, 11, CFrame.new(cx, ht / 2, cz), WHITE, { Shadow = true })
			for k = 1, 4 do
				Kit.Cyl(o, 5, 11.4, CFrame.new(cx, ht * k / 5, cz), Kit.Vivid(if (k + i) % 2 == 0 then PINK else SKY))
			end
			Kit.Cyl(o, 3, 13, CFrame.new(cx, ht + 1.5, cz), Kit.Vivid(PURPLE))
			Kit.Ball(o, 12, V(cx + 2, ht + 9, cz), WHITE, { Transp = 0.35 })
			Kit.Ball(o, 8, V(cx + 6, ht + 16, cz + 3), WHITE, { Transp = 0.5 })
			if s > 0 and i == 1 then
				local top = Kit.Part(o, V(8, 1, 8), CFrame.new(cx, ht + 4, cz), WHITE, { Transp = 1, Name = "SteamSource" })
				Kit.Emitter(top, C(250, 250, 255), 2, 8, 2)
			end
		end
		-- pastel hills and lollipop trees
		for i = 0, 2 do
			Kit.Ball(o, 90, V(s * (290 + i * 20), -30, Z0 + 60 + i * 120), Kit.Vivid(if i % 2 == 0 then C(170, 230, 150) else C(255, 200, 220)), { Mat = GRASS })
		end
		for i = 0, 3 do
			Props.Tree(o, V(s * (158 + (i % 2) * 14), 0, Z0 + 30 + i * 90 + 25), 18 + (i % 3) * 4)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function ToyFactory.Build(map: Instance)
	local f = Kit.Folder(map, "ToyFactory")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	gantry(f)
	teddy(f, 95, rz(290))
	jackInTheBox(f, -100, rz(300))

	-- toy train on an oval track in the east work zone
	track(f, 88, rz(42), rz(110), 22)
	train(f, 110, rz(88))
	Kit.AddRect(60, rz(14), 120, rz(138))
	gift(f, 84, rz(60), 4, 0.3)
	gift(f, 92, rz(72), 3, -0.4)
	blockStack(f, 86, rz(96), 5, "TOY")

	conveyor(f, 31, rz(124), rz(206), PURPLE)
	conveyor(f, -31, rz(128), rz(202), MINT)
	conveyor(f, -48, rz(276), rz(330), SKY)
	conveyor(f, 48, rz(226), rz(264), PINK)

	type Stack = { x: number, z: number, s: number, text: string }
	local stacks: { Stack } = {
		{ x = -72, z = rz(30), s = 6, text = "BOO" },
		{ x = -104, z = rz(64), s = 5, text = "ABC" },
		{ x = -124, z = rz(24), s = 6, text = "GH" },
	}
	for _, b in stacks do
		if Kit.IsFree(b.x, b.z, b.s + 1) then
			blockStack(f, b.x, b.z, b.s, b.text)
		end
	end
	windupMouse(f, -46, rz(166))

	-- lamp posts along the lane (three lit)
	local cols = { PINK, SKY, YELLOW }
	local n = 0
	for z = Z0 + 50, Z1 - 30, 44 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 22 else 0)
			local x = s * 13
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.4, true) then
				n += 1
				Props.StreetLamp(f, V(x, 0, zz), Kit.Vivid(cols[(n % 3) + 1]), n == 2 or n == 6)
				Kit.AddCircle(x, zz, 1.6)
			end
		end
	end

	-- toy soldiers and gift boxes
	local soldiers, gifts = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 30, Z1 - 28)
		if soldiers < 4 and math.abs(x) < 40 and Kit.IsFree(x, z, 3.5) then
			soldiers += 1
			soldier(f, x, z, -x, 0)
		elseif gifts < 12 and Kit.IsFree(x, z, 3.5) then
			gifts += 1
			local s = rng:NextNumber(3, 5.5)
			gift(f, x, z, s, rng:NextNumber(0, 1.5))
			if rng:NextNumber() < 0.4 then
				gift(f, x + rng:NextNumber(-0.4, 0.4), z, 2.4, rng:NextNumber(0, 1.5), s)
			end
			Kit.AddCircle(x, z, 3.5)
		end
	end
	-- balloons drifting over the hall
	for i, p in { V(118, 18, rz(240)), V(60, 16, rz(132)), V(-120, 14, rz(84)), V(-50, 18, rz(300)), V(122, 15, rz(166)) } do
		local b = Kit.Ball(f, 3.2, p, Kit.Vivid(TOYS[i]), { Name = "Balloon" })
		Kit.Float(b, rng:NextNumber(0.8, 1.4))
	end

	outside(f)
end

return ToyFactory
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="71">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="72">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="73">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="74">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="75">
        <Properties>
          <string name="Name">GHClient</string>
        </Properties>
        <Item class="Folder" referent="76">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- World liveliness + interactions:
--  * per-zone lighting blend (ambient + fog colour) as you walk between areas
--  * floating books/pumpkins (FloatingProp), flickering lights (FlickerLight), spinning
--    display crates (SpinProp) - one loop, only props near the camera are animated
--  * gates: open locally for zones you own, the NEW AREA UNLOCKED! sequence, sign text
--  * station prompts open the right panel
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local CratePanel = require(script.Parent.CratePanel)
local GatePanel = require(script.Parent.GatePanel)
local Reveal = require(script.Parent.Reveal)

local Ambience = {}

local player = Players.LocalPlayer
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end
local currentZone = 0
local unlocking: { [string]: boolean } = {}

type Prop = { Part: BasePart, Base: CFrame, Phase: number, Bob: number, Kind: string }
local props: { [BasePart]: Prop } = {}

local function addProp(inst: Instance, kind: string)
	if not inst:IsA("BasePart") or props[inst] then
		return
	end
	local bob = inst:GetAttribute("BobHeight")
	props[inst] = {
		Part = inst,
		Base = inst.CFrame,
		Phase = math.random() * 10,
		Bob = if type(bob) == "number" then bob else 0.6,
		Kind = kind,
	}
end

local flickers: { BasePart } = {}

local function blendZone(idx: number)
	local z = Config.Zones[idx]
	if not z then
		return
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { Ambient = z.Ambient, OutdoorAmbient = z.Ambient:Lerp(Color3.new(1, 1, 1), 0.15) }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, info, { Color = z.FogColor, Decay = z.FogColor:Lerp(Color3.new(0, 0, 0), 0.35) }):Play()
	end
end

-- Gate sign cost row (World/Gates): the lock icon + price while locked, "✅ UNLOCKED" (whole
-- row, icon hidden) once owned. Without the icon (no image id) the text carries the 🔒.
local function setCost(cost: TextLabel, owned: boolean, price: number)
	local icon = cost.Parent and cost.Parent:FindFirstChild("CostIcon") :: GuiObject?
	if not cost:GetAttribute("BasePos") then
		cost:SetAttribute("BasePos", true)
		cost:SetAttribute("PosX", cost.Position.X.Scale)
		cost:SetAttribute("SizeX", cost.Size.X.Scale)
	end
	if icon then
		icon.Visible = not owned
		local x, w = cost:GetAttribute("PosX") :: number, cost:GetAttribute("SizeX") :: number
		cost.Position = UDim2.new(if owned then 0.08 else x, 0, cost.Position.Y.Scale, cost.Position.Y.Offset)
		cost.Size = UDim2.new(if owned then 0.84 else w, 0, cost.Size.Y.Scale, cost.Size.Y.Offset)
	end
	cost.Text = if owned then "✅ UNLOCKED" else (if icon then "" else "🔒 ") .. Format.Short(price) .. " ECTOPLASM"
end

local function gateParts(zoneId: string): (BasePart?, TextLabel?, ProximityPrompt?)
	local map = workspace:FindFirstChild("Map")
	local gates = map and map:FindFirstChild("Gates")
	local gate = gates and gates:FindFirstChild("Gate_" .. zoneId)
	if not gate then
		return nil, nil, nil
	end
	local barrier = gate:FindFirstChild("Barrier") :: BasePart?
	local sign = gate:FindFirstChild("Sign")
	local sg = sign and sign:FindFirstChildOfClass("SurfaceGui")
	local cost = sg and sg:FindFirstChild("CostLabel", true) :: TextLabel?
	local anchor = gate:FindFirstChild("PromptAnchor")
	local prompt = anchor and anchor:FindFirstChildOfClass("ProximityPrompt")
	return barrier, cost, prompt
end

local barrierOriginal: { [BasePart]: { Size: Vector3, CFrame: CFrame, Transparency: number } } = {}

local function applyGates()
	local d = State.Data
	if not d then
		return
	end
	for _, z in Config.Zones do
		if not Config.Layout.Gates[z.Id] or unlocking[z.Id] then
			continue
		end
		local barrier, cost, prompt = gateParts(z.Id)
		local owned = d.Zones[z.Id] == true
		if barrier then
			if not barrierOriginal[barrier] then
				barrierOriginal[barrier] = { Size = barrier.Size, CFrame = barrier.CFrame, Transparency = barrier.Transparency }
			end
			local o = barrierOriginal[barrier]
			barrier.CanCollide = not owned
			barrier.Transparency = if owned then 1 else o.Transparency
			if not owned then
				barrier.Size = o.Size
				barrier.CFrame = o.CFrame
			end
		end
		if cost then
			setCost(cost, owned, z.Cost)
		end
		if prompt then
			prompt.Enabled = not owned
		end
	end
end

local function unlockSequence(zoneId: string)
	local zone = Config.ZoneById[zoneId]
	if not zone then
		return
	end
	unlocking[zoneId] = true
	local barrier, cost, prompt = gateParts(zoneId)
	Sound.Play("ZoneUnlock")
	Hud.Banner("NEW AREA UNLOCKED!", zone.Name .. "  ·  NEW GHOSTS  ·  NEW CRATE", zone.Accent)
	if prompt then
		prompt.Enabled = false
	end
	if cost then
		setCost(cost, true, zone.Cost)
	end
	-- camera emphasis: quick punch-in + shake
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = 58
		TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Back), { FieldOfView = 70 }):Play()
	end
	if barrier then
		barrier.CanCollide = false
		local cf = barrier.CFrame
		local size = barrier.Size
		barrier.Color = Color3.new(1, 1, 1)
		TweenService:Create(barrier, TweenInfo.new(0.25), { Color = zone.Accent }):Play()
		for i = -2, 2 do
			local p = cf.Position + cf.RightVector * (i * size.X / 5) + Vector3.new(0, -size.Y / 2 + 4, 0)
			Effects.Burst(p, { Color = zone.Accent, Color2 = Color3.new(1, 1, 1), Count = 30, Size = 1.4, Speed = 24, Life = 1 })
		end
		Effects.Ring(cf.Position - Vector3.new(0, size.Y / 2 - 0.3, 0), zone.Accent, 30, 0.9)
		task.wait(0.3)
		-- the force field drains into the ground
		TweenService:Create(barrier, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(size.X, 0.2, size.Z),
			CFrame = cf - Vector3.new(0, size.Y / 2, 0),
			Transparency = 1,
		}):Play()
		task.wait(1.2)
	end
	unlocking[zoneId] = nil
	applyGates()
end

local stepParts: { BasePart } = {}
local stepCfs: { CFrame } = {}

local function step()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	table.clear(stepParts)
	table.clear(stepCfs)
	local parts, cfs = stepParts, stepCfs
	for part, p in props do
		if (p.Base.Position - camPos).Magnitude > 160 then
			continue
		end
		local cf
		if p.Kind == "Spin" then
			cf = p.Base * CFrame.new(0, math.sin(t * 1.8 + p.Phase) * 0.4, 0) * CFrame.Angles(0, t * 0.9, 0)
		else
			cf = p.Base * CFrame.new(0, math.sin(t * 1.4 + p.Phase) * p.Bob, 0) * CFrame.Angles(math.sin(t * 0.9 + p.Phase) * 0.12, t * 0.35 + p.Phase, math.cos(t * 0.7 + p.Phase) * 0.1)
		end
		table.insert(parts, part)
		table.insert(cfs, cf)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ambience.Init() end

function Ambience.Start()
	for _, inst in CollectionService:GetTagged("FloatingProp") do
		addProp(inst, "Float")
	end
	CollectionService:GetInstanceAddedSignal("FloatingProp"):Connect(function(inst)
		addProp(inst, "Float")
	end)
	for _, inst in CollectionService:GetTagged("SpinProp") do
		addProp(inst, "Spin")
	end
	CollectionService:GetInstanceAddedSignal("SpinProp"):Connect(function(inst)
		addProp(inst, "Spin")
	end)
	for _, inst in CollectionService:GetTagged("FlickerLight") do
		if inst:IsA("BasePart") then
			table.insert(flickers, inst)
		end
	end
	-- flicker: every so often one light stutters
	task.spawn(function()
		while true do
			task.wait(0.15 + math.random() * 0.35)
			if #flickers > 0 then
				local part = flickers[math.random(1, #flickers)]
				local light = part:FindFirstChildWhichIsA("Light")
				if light then
					local base = part:GetAttribute("BaseTransparency")
					if type(base) ~= "number" then
						base = part.Transparency
						part:SetAttribute("BaseTransparency", base)
					end
					local n = math.random(1, 3)
					for _ = 1, n do
						light.Enabled = false
						part.Transparency = math.max(base :: number, 0.6)
						task.wait(0.04 + math.random() * 0.08)
						light.Enabled = true
						part.Transparency = base :: number
						task.wait(0.03 + math.random() * 0.06)
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)

	-- zone blend
	task.spawn(function()
		while true do
			task.wait(0.5)
			local cam = workspace.CurrentCamera
			if cam and not Reveal.IsPlaying() then
				local idx = Rules.ZoneIndexAt(cam.Focus.Position.Z, zoneRanges)
				if idx ~= currentZone then
					currentZone = idx
					blendZone(idx)
				end
			end
		end
	end)

	-- gates
	State.OnData(function()
		applyGates()
	end)
	State.OnFx("ZoneUnlocked", function(data: any)
		if type(data) == "table" and type(data.Zone) == "string" then
			unlockSequence(data.Zone)
		end
	end)

	-- prompts → panels
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player or Reveal.IsPlaying() then
			return
		end
		local crate = prompt:GetAttribute("Crate")
		local station = prompt:GetAttribute("Station")
		local zone = prompt:GetAttribute("Zone")
		if type(crate) == "string" then
			CratePanel.Open(crate)
		elseif station == "Upgrades" then
			Hud.Open("Upgrades")
		elseif type(zone) == "string" then
			GatePanel.Open(zone)
		end
	end)
	-- keep prompts out of the way while a menu is open
	Kit.PanelOpened:Connect(function(name)
		ProximityPromptService.Enabled = name == nil
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Boss</string>
              <string name="Source"><![CDATA[--!strict
-- RETIRED: the GIANT POLTERGEIST lobby event (boss bar, beacon, SHOW ME) was removed with the
-- event itself (see EventService). The module stays in the controller list as an empty stub;
-- Boss Tower presentation lives in TowerHud.
local Boss = {}

function Boss.Init() end

function Boss.Start() end

return Boss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">CratePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Crate station panel: odds (with luck boost), possible hunters, price and the OPEN button.
-- Opened by the station's ProximityPrompt. The server rolls; we only play the reveal.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Reveal = require(script.Parent.Reveal)

local CratePanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local list: ScrollingFrame
local openButton: TextButton
local tripleButton: TextButton
local autoButton: TextButton
local luckyButton: TextButton
-- Auto Open results waiting to be shown (the server keeps opening while one plays)
local autoQueue: { any } = {}
local autoPlaying = false
local infoLabel: TextLabel
local luckLabel: TextLabel
local legendLabel: TextLabel -- per-RARITY totals (cards keep each hunter's own chance)
local current: string? = nil
local crateIcon: ImageLabel
local busy = false
local openedSignal = Signal.new()
CratePanel.Opened = openedSignal -- (result) after a successful purchase

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

-- The server may stop a multi-open early (e.g. storage full): say why after the results.
local function toastStopped(res: any)
	if type(res.Stopped) == "string" and res.Stopped ~= "" then
		Kit.Toast(res.Stopped, "Bad")
	end
end

local function nearStation(crateId: string): boolean
	local pos = Config.Layout.CrateStations[crateId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return pos ~= nil and root ~= nil and (root.Position - pos).Magnitude < 28
end

local cardsKey = ""
local refreshCards: (string, any, { [string]: number }, number) -> ()
local refreshButton: (string, any, number) -> ()

local function refresh()
	local crateId = current
	local d = State.Data
	if not crateId or not d then
		return
	end
	local crate = Config.Crates[crateId]
	panel.Title.Text = crate.Name
	local img = Icons.Get(Icons.ForCrate[crateId])
	crateIcon.Image = img or ""
	crateIcon.Visible = img ~= nil
	-- the luck boost ends on the server clock even if no new snapshot arrives
	-- (LuckOther = the Lucky Hunter pass and Server Luck, so the shown odds match the real roll)
	local luck = (tonumber(d.LuckOther) or 1) * (if (d.Boosts.Luck or 0) > State.Now() then Config.Boosts.Luck.Multiplier else 1)
	if d.LuckyOpens and (d.LuckyOpens[crateId] or 0) > 0 then
		luck *= Config.LuckyOpens.Multiplier
	end
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, luck, Config.LuckAffectsFromOrder)
	-- cards only change with the crate, luck or discoveries; the button changes with Ectoplasm
	local key = crateId .. "|" .. luck
	for _, e in crate.Pool do
		key ..= if d.Discovered[e.Hunter] then "1" else "0"
	end
	if key ~= cardsKey then
		cardsKey = key
		refreshCards(crateId, d, odds, luck)
	end
	refreshButton(crateId, d, luck)
end

function refreshCards(crateId: string, d: any, odds: { [string]: number }, luck: number)
	local crate = Config.Crates[crateId]
	-- category totals: sum every hunter of the same rarity; rarities absent from this crate are skipped
	local totals: { [string]: number } = {}
	local rars: { Config.RarityDef } = {}
	for _, e in crate.Pool do
		local rid = Config.Hunters[e.Hunter].Rarity
		if totals[rid] == nil then
			totals[rid] = 0
			table.insert(rars, Config.Rarities[rid])
		end
		totals[rid] += odds[e.Hunter] or 0
	end
	table.sort(rars, function(a, b)
		return a.Order < b.Order
	end)
	local parts = {}
	for _, r in rars do
		-- brighter of the pair so dark rarities (Secret) stay readable
		local c = if r.Color.R + r.Color.G + r.Color.B >= r.Color2.R + r.Color2.G + r.Color2.B then r.Color else r.Color2
		table.insert(parts, string.format('<font color="#%s">%s</font> %s', c:ToHex(), r.Name, Format.Percent(totals[r.Id])))
	end
	legendLabel.Text = if #parts > 0 then "BY RARITY: " .. table.concat(parts, "  ·  ") else ""
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local found = d.Discovered[e.Hunter] == true
		local card: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = list,
		})
		Kit.Corner(card, UDim.new(0, 14))
		Kit.Stroke(card, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(card, rar.Color, rar.Color2, 90)
		local pic: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(88, 88),
			Position = UDim2.new(0.5, 0, 0, 8),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(30, 18, 55),
			BackgroundTransparency = 0.3,
			ZIndex = 63,
			Parent = card,
		})
		Kit.Corner(pic, UDim.new(1, 0))
		Portrait.Face(pic, e.Hunter, not found)
		Kit.Label(card, if found then string.upper(def.Name) else "???", { Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 100), ZIndex = 64, Style = "Body", Fit = true })
		Kit.Label(card, rar.Name, { Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 121), ZIndex = 64, Color = Color3.fromRGB(255, 255, 240), Style = "Small", Fit = true })
		local powerText = Kit.Label(card, "", { Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.new(0, 8, 1, -28), ZIndex = 64, Color = Theme.Gold, Align = Enum.TextXAlignment.Left, Style = "Small", Fit = true })
		Kit.IconText(powerText, "⚡ " .. Format.Commas(def.Power))
		local pct = Kit.Label(card, Format.Percent(odds[e.Hunter]), { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(1, -8, 1, -29), AnchorPoint = Vector2.new(1, 0), ZIndex = 64, Align = Enum.TextXAlignment.Right, Style = "Heading", Fit = true })
		if luck > 1 and rar.Order >= Config.LuckAffectsFromOrder then
			pct.TextColor3 = Theme.Ecto
		end
	end
end

function refreshButton(crateId: string, d: any, luck: number)
	local crate = Config.Crates[crateId]
	local free = d.FreeCrates[crateId] or 0
	local price = crate.Price
	if free > 0 then
		Kit.SetButtonText(openButton, "OPEN FREE! (" .. free .. ")")
		openButton:SetAttribute("Color", "Orange")
	elseif d.Ecto >= price then
		Kit.SetButtonText(openButton, "OPEN  💚 " .. Format.Commas(price))
		openButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(openButton, "NEED 💚 " .. Format.Short(price - d.Ecto) .. " MORE")
		openButton:SetAttribute("Color", "Gray")
	end
	if not d.Zones[crate.Zone] then
		infoLabel.Text = "Unlock " .. (Config.ZoneById[crate.Zone] :: Config.ZoneDef).Name .. " to open this crate"
	else
		infoLabel.Text = "Better crates > stronger hunters!"
	end
	local left = if d.LuckyOpens then d.LuckyOpens[crateId] or 0 else 0
	local L = Config.LuckyOpens
	Kit.SetButtonText(luckyButton, string.format("🍀 x%d LUCKY  💚 %s", L.Opens, Format.Short(price * L.PriceMultiplier)))
	luckyButton:SetAttribute("Color", if d.Ecto >= price * L.PriceMultiplier then "Teal" else "Gray")
	Kit.IconText(luckLabel, if left > 0
		then string.format("🍀 %d LUCKY OPEN%s LEFT: rare odds x%d!", left, if left == 1 then "" else "S", L.Multiplier)
		else "🍀 LUCK BOOST: rare odds boosted!")
	luckLabel.Visible = luck > 1
	local autoOwned = d.Passes and d.Passes[Config.AutoOpen.Pass] == true
	local autoOn = player:GetAttribute("AutoOpen") ~= nil
	Kit.SetButtonText(autoButton, if not autoOwned then "🔒 AUTO OPEN" elseif autoOn then "AUTO OPEN: ON" else "AUTO OPEN: OFF")
	autoButton:SetAttribute("Color", if not autoOwned then "Gray" elseif autoOn then "Green" else "Purple")
	-- no "🔒 AUTO OPEN" while the pass isn't on sale (owners keep their button)
	autoButton.Visible = autoOwned == true -- a paid pass: only owners see it here (it's sold in the shop)
	luckyButton.Position = if autoButton.Visible then UDim2.new(1, -180, 0, 8) else UDim2.new(1, 0, 0, 8)
	local triple = d.Passes and d.Passes[Config.TripleOpen.Pass] == true
	tripleButton.Visible = triple == true
	if triple then
		Kit.SetButtonText(tripleButton, "OPEN x3  💚 " .. Format.Short(price * Config.TripleOpen.Count))
	end
end

-- Plays the best of several results (Triple Open) and lists the rest as toasts.
local function rarityOf(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 0
end

local function playResults(crateId: string, first: any, again: (() -> ())?)
	local all = { { Uid = first.Uid, Hunter = first.Hunter, IsNew = first.IsNew == true } }
	for _, m in (first.More or {}) :: { any } do
		table.insert(all, { Uid = m.Uid, Hunter = m.Hunter, IsNew = m.IsNew == true })
	end
	table.sort(all, function(a, b)
		return rarityOf(a.Hunter) > rarityOf(b.Hunter)
	end)
	for _, r in all do
		openedSignal:Fire({ Crate = crateId, Hunter = r.Hunter, Uid = r.Uid, IsNew = r.IsNew })
	end
	local best = all[1]
	Reveal.Play({ Crate = crateId, Hunter = best.Hunter, Uid = best.Uid, IsNew = best.IsNew }, again)
	for i = 2, #all do
		local h = Config.Hunters[all[i].Hunter]
		if h then
			Kit.Toast("Also got: " .. Config.Rarities[h.Rarity].Name .. " " .. h.Name .. (if all[i].IsNew then " (NEW!)" else ""), "Good")
		end
	end
end

local function buyTriple()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	if player:GetAttribute("AutoOpen") then
		Kit.Toast("Turn AUTO OPEN off first", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId, Config.TripleOpen.Count)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	playResults(crateId, res, nil)
	toastStopped(res)
end

local function buy()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	if player:GetAttribute("AutoOpen") then
		Kit.Toast("Turn AUTO OPEN off first", "Bad")
		return
	end
	local d = State.Data
	local crate = Config.Crates[crateId]
	if d and (d.FreeCrates[crateId] or 0) <= 0 and d.Ecto < crate.Price then
		Kit.Toast("Defeat ghosts to collect more Ectoplasm!", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	local result: Reveal.Result = { Crate = crateId, Hunter = res.Hunter, Uid = res.Uid, IsNew = res.IsNew == true }
	openedSignal:Fire(result)
	local function again()
		if busy then
			return
		end
		local dd = State.Data
		if dd and (dd.FreeCrates[crateId] or 0) <= 0 and dd.Ecto < crate.Price then
			Kit.Toast("Not enough Ectoplasm!", "Bad")
			return
		end
		busy = true
		local r2 = State.Request("OpenCrate", crateId)
		busy = false
		if r2.ok then
			local res2: Reveal.Result = { Crate = crateId, Hunter = r2.Hunter, Uid = r2.Uid, IsNew = r2.IsNew == true }
			openedSignal:Fire(res2)
			Reveal.Play(res2, again)
			toastStopped(r2)
		else
			Kit.Toast(r2.err or "Couldn't open the crate", "Bad")
		end
	end
	Reveal.Play(result, again)
	toastStopped(res)
end

function CratePanel.Open(crateId: string)
	if not Config.Crates[crateId] or Reveal.IsPlaying() then
		return
	end
	current = crateId
	refresh()
	panel:Open()
end

function CratePanel.Init()
	panel = Kit.Panel("Crate", "HUNTER CRATE", Vector2.new(700, 380), "Orange")
	-- crate picture in the top-left corner (uploaded icon per crate, see Icons.ForCrate)
	crateIcon = Kit.new("ImageLabel", {
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(72, 72),
		Position = UDim2.fromOffset(-14, -34),
		ZIndex = 64,
		Visible = false,
		Parent = panel.Root,
	})
	infoLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -400, 0, 20), Position = UDim2.fromOffset(0, 12), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	-- below the LUCKY / AUTO OPEN buttons (y 8-42): it used to sit half under them
	luckLabel = Kit.Label(panel.Body, "🍀 LUCK BOOST: rare odds boosted!", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 46), Color = Theme.Ecto, Style = "Small", ZIndex = 62 })
	luckLabel.Visible = false
	legendLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 64), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62, Fit = true })
	legendLabel.RichText = true
	-- cards wrap onto more rows (and scroll) when the panel is narrow (phones, portrait)
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -146),
		Position = UDim2.fromOffset(0, 84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(148, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = list })
	-- OPEN [+ OPEN x3]: a centred row whose buttons share the body width (capped at their design
	-- widths), so the pair never runs past the panel edge on narrow screens
	local openRow: Frame = Kit.new("Frame", { Name = "OpenRow", Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 1, -4), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1, ZIndex = 62, Parent = panel.Body })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = openRow })
	openButton = Kit.Button(openRow, {
		Text = "OPEN",
		Color = "Green",
		Size = UDim2.new(0.56, -5, 0, 50),
		ZIndex = 63,
		OnClick = buy,
	})
	openButton.Name = "OpenButton"
	openButton.LayoutOrder = 1
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(280, 50), Parent = openButton })
	panel.Primary = openButton
	tripleButton = Kit.Button(openRow, {
		Text = "OPEN x3",
		Color = "Purple",
		Size = UDim2.new(0.44, -5, 0, 50),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = buyTriple,
	})
	tripleButton.LayoutOrder = 2
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(200, 50), Parent = tripleButton })
	tripleButton.Visible = false
	-- LUCKY OPENS (Ectoplasm): next few opens of this crate at higher luck
	luckyButton = Kit.Button(panel.Body, {
		Text = "🍀 LUCKY",
		Color = "Teal",
		Size = UDim2.fromOffset(200, 34),
		Position = UDim2.new(1, -180, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = function()
			local crateId = current
			if busy or not crateId then
				return
			end
			busy = true
			local res = State.Request("BuyLuckyOpens", crateId)
			busy = false
			if res.ok then
				Kit.Toast(string.format("🍀 %d lucky opens ready for this crate!", res.Left or Config.LuckyOpens.Opens), "Good")
				refresh()
			else
				Kit.Toast(res.err or "Couldn't buy luck", "Bad")
			end
		end,
	})
	-- AUTO OPEN (game pass; NOT Auto Attack, which is free): locked button prompts the pass
	autoButton = Kit.Button(panel.Body, {
		Text = "🔒 AUTO OPEN",
		Color = "Gray",
		Size = UDim2.fromOffset(170, 34),
		Position = UDim2.new(1, 0, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = function()
			local crateId = current
			local d = State.Data
			if busy or not crateId or not d then
				return
			end
			local owned = d.Passes and d.Passes[Config.AutoOpen.Pass] == true
			if not owned then
				local res = State.Request("Buy", Config.AutoOpen.Pass)
				if not res.ok then
					Kit.Toast(res.err or "Auto Open isn't available yet", "Bad")
				end
				return
			end
			if player:GetAttribute("AutoOpen") then
				State.Request("AutoOpen", nil)
				refresh()
				return
			end
			if not nearStation(crateId) then
				Kit.Toast("Walk to the crate first!", "Bad")
				return
			end
			busy = true
			local res = State.Request("AutoOpen", crateId)
			busy = false
			if res.ok then
				panel:Close()
				Kit.Toast("AUTO OPEN: ON - stand still at the crate", "Good")
			else
				Kit.Toast(if res.err == "NeedPass" then "Auto Open is a game pass" else (res.err or "Couldn't start"), "Bad")
			end
		end,
	})
end

function CratePanel.Start()
	-- Robux Exclusive Crate: the server grants the hunter and tells us to play the reveal
	-- AUTO OPEN results: play them one after another (never two reveals at once)
	local function playNextAuto()
		if autoPlaying then
			return
		end
		local nextRes = table.remove(autoQueue, 1)
		if not nextRes then
			return
		end
		autoPlaying = true
		openedSignal:Fire(nextRes)
		Reveal.Play(nextRes, nil, { Auto = true })
	end
	Reveal.Finished:Connect(function()
		if autoPlaying then
			autoPlaying = false
			task.defer(playNextAuto)
		end
	end)
	Reveal.AutoStopped:Connect(function()
		table.clear(autoQueue)
	end)
	State.OnFx("AutoOpened", function(data: any)
		if type(data) ~= "table" or type(data.Hunter) ~= "string" or not Config.Hunters[data.Hunter] then
			return
		end
		local res: Reveal.Result = { Crate = tostring(data.Crate), Hunter = data.Hunter, Uid = tostring(data.Uid), IsNew = data.IsNew == true }
		if #autoQueue >= 3 then
			-- reveals can't keep up: list the extra hunter instead of queueing forever
			local h = Config.Hunters[res.Hunter]
			Kit.Toast("Auto Open: " .. Config.Rarities[h.Rarity].Name .. " " .. h.Name, "Good")
			openedSignal:Fire(res)
			return
		end
		table.insert(autoQueue, res)
		if panel.IsOpen then
			panel:Close()
		end
		playNextAuto()
	end)
	State.OnFx("AutoOpenStopped", function(data: any)
		local reason = if type(data) == "table" and type(data.Reason) == "string" then data.Reason else "stopped"
		Kit.Toast("AUTO OPEN stopped: " .. reason, "Bad")
	end)

	State.OnFx("Exclusive", function(data: any)
		if type(data) == "table" and type(data.Hunter) == "string" and Config.Hunters[data.Hunter] then
			if panel.IsOpen then
				panel:Close()
			end
			local res: Reveal.Result = { Crate = "Exclusive", Hunter = data.Hunter, Uid = tostring(data.Uid), IsNew = data.IsNew == true }
			openedSignal:Fire(res)
			Reveal.Play(res, nil)
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh() -- keeps the odds honest when a luck boost runs out
			end
		end
	end)
end

function CratePanel.Button(): TextButton
	return openButton
end

function CratePanel.IsOpen(): boolean
	return panel.IsOpen
end

return CratePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Crew</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every player's equipped Ghost Hunters (client-side, never collide with anything).
-- Idle: follow in a formation behind their player. Assigned (player's "Target" attribute):
-- run to a ring around the ghost, aim and fire a wobbly energy beam, celebrate on the poof,
-- then come back. All crews update in ONE RenderStepped loop: BulkMoveTo for roots, Motor6D
-- transforms for poses, staggered ground raycasts, and far-away crews are hidden.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local HunterRig = require(GH.Rigs.HunterRig)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Ghosts = require(script.Parent.Ghosts)
local Targeting = require(script.Parent.Targeting)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Crew = {}

type Member = {
	Id: string,
	Uid: string,
	Tier: number,
	Rig: HunterRig.Rig,
	Pos: Vector3,
	Yaw: number,
	State: string,
	GroundY: number,
	NextRay: number,
	Beam: Beam,
	CelebrateUntil: number,
	Phase: number,
	Color: Color3,
	-- HP bar over the tag (own crew: big, plus a short alert line like "DODGED"; others: small)
	HpGui: BillboardGui,
	HpFill: Frame,
	Hp: number,
	Alert: TextLabel?,
	AlertUntil: number,
	HitT: number, -- last slime hit (tiny squash/recoil in step)
	Mark: Highlight?, -- red outline while a ghost winds up on this hunter
	MarkUntil: number,
}

-- An own equipped hunter that is knocked out: a faded rig behind the player with a countdown.
type KO = {
	Uid: string,
	Rig: HunterRig.Rig,
	Pos: Vector3,
	Label: TextLabel,
}

type CrewData = {
	Player: Player,
	Members: { Member },
	Visible: boolean,
	LastTarget: number,
	NextSpark: number,
	NextSound: number,
	Fighting: boolean,
	Conns: { RBXScriptConnection },
}

local player = Players.LocalPlayer
local crews: { [Player]: CrewData } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local nextFilter = 0
local gone: { [string]: Vector3 } = {} -- last spot of local rigs removed by the latest rebuild (knockout poof)
local kos: { KO } = {}

local VISIBLE_RANGE = 170
local HUNTER_SCALE = 0.88 -- rigs are ~4-4.6 studs; this puts them at a player's chest height
local RUN_SPEED = Config.Combat.HunterRunSpeed

local function refreshFilter()
	local list: { Instance } = { folder }
	for _, name in { "Ghosts", "GHEffects", "GHOrbs", "GHReveal" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function makeBeam(m: Member)
	local beam = Instance.new("Beam")
	beam.Name = "CaptureBeam"
	beam.Attachment0 = m.Rig.Tip
	beam.Color = ColorSequence.new(m.Color, Color3.new(1, 1, 1))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.8, 0.15), NumberSequenceKeypoint.new(1, 0.4) })
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Width0 = 0.35
	beam.Width1 = 0.9
	beam.Enabled = false
	beam.Parent = m.Rig.Model
	m.Beam = beam
end

-- One small line over each hunter: "★ Name" in its rarity colour. Short range (your own crew
-- reads it when the camera is close; it never stacks into clutter from afar).
local function addTag(m: Member, isLocal: boolean)
	local def = Config.Hunters[m.Id]
	local rar = Config.Rarities[def.Rarity]
	local gui = WorldLabel.New({
		Name = "Tag",
		Adornee = m.Rig.Root,
		Parent = m.Rig.Model,
		Size = Theme.World.CrewTag,
		Offset = Vector3.new(0, m.Rig.Height + 0.7, 0),
		MaxDistance = if isLocal then Theme.World.CrewMaxDistance else Theme.World.CrewMaxDistance * 0.6,
		AlwaysOnTop = true, -- never cut by walls / the hunter's own body
	})
	local tier = Config.Tiers[m.Tier]
	local text = (if tier and tier.Icon ~= "" then tier.Icon .. " " else "") .. string.rep("⭐", math.min(rar.Order, 5)) .. " " .. def.Name
	WorldLabel.Text(gui, text, { Style = "Tiny", Color = Theme.RarityText(rar) })
	gui.Enabled = game:GetService("Players").LocalPlayer:GetAttribute("ShowNames") ~= false -- Settings: NAMES
	-- HP bar: its own label at the tag's anchor point, drawn in the upper part so it always
	-- sits just above the name. Own crew: readable at play distance; others: small and close only.
	local hpGui = WorldLabel.New({
		Name = "Hp",
		Adornee = m.Rig.Root,
		Parent = m.Rig.Model,
		Size = if isLocal then Vector2.new(84, 64) else Vector2.new(44, 40),
		Offset = Vector3.new(0, m.Rig.Height + 0.7, 0),
		MaxDistance = if isLocal then 70 else 35,
		AlwaysOnTop = true,
	})
	hpGui.Enabled = false
	local bar: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(1, if isLocal then 0.16 else 0.12),
		Position = UDim2.fromScale(0, 0.3),
		BackgroundColor3 = Color3.fromRGB(30, 15, 50),
		Parent = hpGui,
	})
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, if isLocal then 1.5 else 1, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local fill: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Ecto, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	m.HpGui = hpGui
	m.HpFill = fill
	if isLocal then
		m.Alert = WorldLabel.Text(hpGui, "", { Style = "Small", Color = Theme.Bad, Size = UDim2.fromScale(1, 0.28) })
	end
	-- rare+ hunters stand on a soft rarity-coloured disc
	if rar.Order >= 3 then
		local disc = Instance.new("Part")
		disc.Name = "RarityDisc"
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.12, 3.4, 3.4)
		disc.Material = Enum.Material.SmoothPlastic
		disc.Color = rar.Color
		disc.Transparency = 0.45
		disc.CanCollide = false
		disc.CanQuery = false
		disc.CanTouch = false
		disc.CastShadow = false
		disc.Massless = true
		disc.CFrame = m.Rig.Root.CFrame * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = m.Rig.Root
		w.Part1 = disc
		w.Parent = disc
		disc.Parent = m.Rig.Model
	end
end

local function newMember(id: string, tier: number, uid: string, at: Vector3, isLocal: boolean): Member
	local rig = HunterRig.Build(id)
	HunterRig.ApplyTier(rig.Model, tier) -- Shiny / Mega finish (same look as inventory + index)
	local scale = if tier >= 2 then HUNTER_SCALE * 1.2 else HUNTER_SCALE
	rig.Model:ScaleTo(scale)
	rig.Height *= scale
	for _, p in rig.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	rig.Model:PivotTo(CFrame.new(at))
	rig.Model.Parent = folder
	local def = Config.Hunters[id]
	local m: Member = {
		Id = id,
		Uid = uid,
		Tier = tier,
		Rig = rig,
		Pos = at,
		Yaw = 0,
		State = "Idle",
		GroundY = at.Y,
		NextRay = 0,
		Beam = nil :: any,
		CelebrateUntil = 0,
		Phase = math.random() * 10,
		Color = def.Look.Beam,
		HpGui = nil :: any,
		HpFill = nil :: any,
		Hp = 100,
		AlertUntil = 0,
		MarkUntil = 0,
		HitT = 0,
	}
	makeBeam(m)
	addTag(m, isLocal)
	return m
end

local function rootOf(pl: Player): BasePart?
	local char = pl.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- green (full) -> gold (half) -> red (empty)
local function hpColor(pct: number): Color3
	local f = math.clamp(pct / 100, 0, 1)
	return if f > 0.5 then Theme.Gold:Lerp(Theme.Ecto, (f - 0.5) * 2) else Theme.Bad:Lerp(Theme.Gold, f * 2)
end

-- Reads each rig's HP from "uid=pct,uid=pct" (the bar itself is shown/hidden in step).
local function applyHP(c: CrewData)
	local hp: { [string]: number } = {}
	local raw = c.Player:GetAttribute("CrewHP")
	if type(raw) == "string" then
		for uid, pct in raw:gmatch("([^,=]+)=(%d+)") do
			hp[uid] = tonumber(pct) or 100
		end
	end
	for _, m in c.Members do
		local pct = math.clamp(hp[m.Uid] or 100, 0, 100)
		m.Hp = pct
		m.HpFill.Size = UDim2.fromScale(pct / 100, 1)
		m.HpFill.BackgroundColor3 = hpColor(pct)
	end
end

-- "Crew" is "HunterId|tier|uid,..." (old "HunterId,..." still works); rigs are kept per uid.
local function rebuild(c: CrewData)
	local raw = c.Player:GetAttribute("Crew")
	local root = rootOf(c.Player)
	local at = if root then root.Position - Vector3.new(0, 3, 0) else Vector3.zero
	local isLocal = c.Player == player
	local old: { [string]: Member } = {}
	for _, m in c.Members do
		old[m.Uid] = m
	end
	local members: { Member } = {}
	if type(raw) == "string" then
		for item in raw:gmatch("[^,]+") do
			local p = item:split("|")
			local id = p[1]
			if Config.Hunters[id] and #members < 12 then
				local i = #members + 1
				local tier = tonumber(p[2]) or 0
				local uid = p[3] or (id .. "#" .. i)
				local m = old[uid]
				old[uid] = nil
				if not m or m.Id ~= id or m.Tier ~= tier then
					local spawnAt = if m then m.Pos else at + Vector3.new((i - 2.5) * 2, 0, 3)
					if m then
						m.Rig.Model:Destroy()
					elseif isLocal and os.clock() > 3 then
						Effects.Burst(spawnAt + Vector3.new(0, 2, 0), { Color = Config.Rarities[Config.Hunters[id].Rarity].Color, Count = 14, Size = 0.7, Speed = 10 })
					end
					m = newMember(id, tier, uid, spawnAt, isLocal)
				end
				members[i] = m :: Member
			end
		end
	end
	if isLocal then
		table.clear(gone)
	end
	for uid, m in old do
		if isLocal then
			gone[uid] = m.Pos
		end
		m.Rig.Model:Destroy()
	end
	c.Members = members
	if not c.Visible then
		for _, m in c.Members do
			m.Rig.Model.Parent = nil
		end
	end
	applyHP(c)
end

local function addPlayer(pl: Player)
	if crews[pl] then
		return
	end
	local c: CrewData = {
		Player = pl,
		Members = {},
		Visible = true,
		LastTarget = 0,
		NextSpark = 0,
		NextSound = 0,
		Fighting = false,
		Conns = {},
	}
	crews[pl] = c
	table.insert(c.Conns, pl:GetAttributeChangedSignal("Crew"):Connect(function()
		rebuild(c)
	end))
	table.insert(c.Conns, pl:GetAttributeChangedSignal("CrewHP"):Connect(function()
		applyHP(c)
	end))
	rebuild(c)
end

local function removePlayer(pl: Player)
	local c = crews[pl]
	if not c then
		return
	end
	for _, conn in c.Conns do
		conn:Disconnect()
	end
	for _, m in c.Members do
		m.Rig.Model:Destroy()
	end
	crews[pl] = nil
end

local function setVisible(c: CrewData, on: boolean, root: BasePart?)
	if c.Visible == on then
		return
	end
	c.Visible = on
	for i, m in c.Members do
		m.Rig.Model.Parent = if on then folder else nil
		if on and root then
			-- snap back into formation instead of sprinting across the map
			m.Pos = root.Position + Vector3.new((i - 2.5) * 2.5, -3, 4)
			m.NextRay = 0
		end
	end
end

local function angleDiff(a: number, b: number): number
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

local function centerAttachment(e: Ghosts.Entry): Attachment
	local a = e.Core:FindFirstChild("Center")
	if a and a:IsA("Attachment") then
		return a
	end
	local made = Instance.new("Attachment")
	made.Name = "Center"
	made.Parent = e.Core
	return made
end

local roots: { BasePart } = {}
local cframes: { CFrame } = {}

-- Ectoplasm spit (Fx "GhostWindup"/"GhostHit", sent to everyone fighting the ghost): a pooled
-- glossy green blob flies from the ghost's mouth to the targeted hunter's chest along an arc,
-- then splashes on the hunter (hit) or splats on the ground beside it (dodged).
type Spit = {
	Part: Part,
	Trail: Trail,
	Drip: ParticleEmitter,
	Active: boolean,
	Ghost: number,
	Owner: number,
	Hunter: string,
	Member: Member,
	Small: boolean,
	From: Vector3,
	To: Vector3,
	Pos: Vector3,
	Arc: number,
	T0: number,
	Arrive: number,
	Result: string?, -- nil while waiting for GhostHit | "Hit" | "Knocked" | "Dodged"
}
local spits: { Spit } = {}
local SPIT_FLIGHT = 0.35 -- leaves this long before the windup ends, so it lands with GhostHit
local SPIT_WAIT = 0.5 -- how long a landed blob waits for a late GhostHit before fizzling
local MAX_SPITS = 8
local SLIME = Color3.fromRGB(120, 255, 100)

local function chestPos(m: Member): Vector3
	return m.Pos + Vector3.new(0, m.Rig.Height * 0.55, 0)
end

-- Resolves a hunter rig by (owner userId, hunter uid): uids are per player and can collide.
local function memberOf(owner: any, uid: any): (Member?, boolean)
	local pl = if type(owner) == "number" then Players:GetPlayerByUserId(owner) else nil
	local mine = pl ~= nil and pl == player
	local c = if pl then crews[pl] else nil
	if c then
		local key = tostring(uid)
		for _, m in c.Members do
			if m.Uid == key then
				return m, mine
			end
		end
	end
	return nil, mine
end

local function takeSpit(): Spit?
	for _, s in spits do
		if not s.Active then
			return s
		end
	end
	if #spits >= MAX_SPITS then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = "EctoSpit"
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0.25
	p.Color = SLIME
	local light = Instance.new("PointLight")
	light.Color = SLIME
	light.Range = 5
	light.Brightness = 0.8
	light.Shadows = false
	light.Parent = p
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.25, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.25, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.18
	trail.Color = ColorSequence.new(SLIME)
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.LightEmission = 0.4
	trail.Enabled = false
	trail.Parent = p
	local drip = Instance.new("ParticleEmitter")
	drip.Color = ColorSequence.new(SLIME)
	drip.LightEmission = 0.3
	drip.Size = NumberSequence.new(0.18, 0)
	drip.Lifetime = NumberRange.new(0.3, 0.45)
	drip.Speed = NumberRange.new(0, 0.5)
	drip.Acceleration = Vector3.new(0, -40, 0)
	drip.Rate = 25
	drip.Enabled = false
	drip.Parent = p
	local s: Spit = {
		Part = p,
		Trail = trail,
		Drip = drip,
		Active = false,
		Ghost = 0,
		Owner = 0,
		Hunter = "",
		Member = nil :: any,
		Small = false,
		From = Vector3.zero,
		To = Vector3.zero,
		Pos = Vector3.zero,
		Arc = 0,
		T0 = 0,
		Arrive = 0,
		Result = nil,
	}
	table.insert(spits, s)
	return s
end

local function releaseSpit(s: Spit)
	s.Active = false
	s.Member = nil :: any
	s.Trail.Enabled = false
	s.Drip.Enabled = false
	s.Part.Parent = nil
end

local function splashOn(m: Member, small: boolean)
	Effects.Splat(chestPos(m), m.Pos.Y, SLIME, if small then 0.65 else 1)
	m.HitT = os.clock()
end

local function launchSpit(ghostUid: number, owner: number, m: Member, mine: boolean, flight: number)
	local e = Ghosts.Get(ghostUid)
	if not e or e.Dying or e.Culled or m.Rig.Model.Parent == nil then
		return
	end
	local s = takeSpit()
	if not s then
		return
	end
	local clock = os.clock()
	local to = chestPos(m)
	s.Active = true
	s.Ghost = ghostUid
	s.Owner = owner
	s.Hunter = m.Uid
	s.Member = m
	s.Small = not mine
	s.From = e.MouthPos
	s.Pos = s.From
	s.To = to
	s.Arc = math.clamp(1.2 + (to - s.From).Magnitude * 0.12, 1.2, 4)
	s.T0 = clock
	s.Arrive = clock + math.max(flight, 0.15)
	s.Result = nil
	local d = if mine then 1 else 0.7
	s.Part.Size = Vector3.new(d, d, d)
	s.Part.CFrame = CFrame.new(s.From)
	s.Part.Parent = folder
	s.Trail:Clear()
	s.Trail.Enabled = true
	s.Drip.Enabled = true
end

-- Moves live blobs (into the step's BulkMoveTo lists) and resolves the ones that landed.
local function stepSpits(clock: number)
	for _, s in spits do
		if not s.Active then
			continue
		end
		local e = Ghosts.Get(s.Ghost)
		local m = s.Member
		local rigUp = m.Rig.Model.Parent ~= nil
		if not e or e.Dying or (not rigUp and s.Result ~= "Dodged") then
			releaseSpit(s) -- ghost or hunter gone mid-flight
			continue
		end
		if s.Result ~= "Dodged" then
			s.To = chestPos(m) -- home in on the (moving) hunter
		end
		if clock < s.Arrive then
			local a = (clock - s.T0) / math.max(s.Arrive - s.T0, 0.01)
			s.Pos = s.From:Lerp(s.To, a) + Vector3.new(0, s.Arc * 4 * a * (1 - a), 0)
			table.insert(roots, s.Part)
			table.insert(cframes, CFrame.new(s.Pos))
			continue
		end
		local r = s.Result
		if r == "Hit" then
			splashOn(m, s.Small)
		elseif r == "Dodged" then
			Effects.Splat(s.To, s.To.Y, SLIME, if s.Small then 0.4 else 0.55)
		elseif r == nil and clock < s.Arrive + SPIT_WAIT then
			-- landed before the server's verdict: cling to the hunter for a moment
			s.Pos = s.To
			table.insert(roots, s.Part)
			table.insert(cframes, CFrame.new(s.Pos))
			continue
		end
		releaseSpit(s) -- "Knocked" (the knockout poof covers it) or no verdict in time
	end
end

local function step(dt: number)
	dt = math.min(dt, 0.1)
	local clock = os.clock()
	if clock > nextFilter then
		nextFilter = clock + 2
		refreshFilter()
	end
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(roots)
	table.clear(cframes)

	for pl, c in crews do
		local root = rootOf(pl)
		local isLocal = pl == player
		if not root or #c.Members == 0 then
			setVisible(c, false, nil)
			continue
		end
		local far = not isLocal and (root.Position - camPos).Magnitude > VISIBLE_RANGE
		setVisible(c, not far, root)
		if far then
			continue
		end
		local footY = root.Position.Y - 3
		-- your own crew reacts to your tap instantly; others follow the server's choice
		local uid = if isLocal then Targeting.LocalTarget() else ((pl:GetAttribute("Target") :: number?) or 0)
		local ghost = if uid ~= 0 then Ghosts.Get(uid) else nil
		if ghost and (ghost.Pos - root.Position).Magnitude > Config.Combat.MaxRange * 1.5 then
			ghost = nil
		end
		if ghost then
			c.LastTarget = uid
		end
		local n = #c.Members
		local anyAttacking = false
		local rootLook = root.CFrame.LookVector
		local rootYaw = math.atan2(-rootLook.X, -rootLook.Z)
		local flatRoot = CFrame.new(root.Position) * CFrame.Angles(0, rootYaw, 0)
		local speedNow = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude

		for i, m in c.Members do
			local goal: Vector3
			local faceTo: Vector3? = nil
			local attackMode = false
			if m.CelebrateUntil > clock then
				goal = m.Pos
			elseif ghost then
				attackMode = true
				local gp = ghost.Pos
				local away = Vector3.new(root.Position.X - gp.X, 0, root.Position.Z - gp.Z)
				local base = if away.Magnitude > 0.1 then math.atan2(away.X, away.Z) else 0
				local spread = math.rad(math.min(160, 42 * (n - 1)))
				local a = base + (if n > 1 then -spread / 2 + spread * (i - 1) / (n - 1) else 0)
				local r = 3.2 + ghost.Def.Scale * 2.2
				goal = Vector3.new(gp.X + math.sin(a) * r, m.Pos.Y, gp.Z + math.cos(a) * r)
				faceTo = gp
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local inRow = math.min(3, n - row * 3)
				local x = (col - (inRow - 1) / 2) * 3.2
				local z = 4.6 + row * 3.4
				goal = (flatRoot * CFrame.new(x, 0, z)).Position
			end
			-- move (XZ), teleport if hopelessly far
			local delta = Vector3.new(goal.X - m.Pos.X, 0, goal.Z - m.Pos.Z)
			local dist = delta.Magnitude
			if dist > 75 then
				m.Pos = Vector3.new(goal.X, footY, goal.Z)
				m.NextRay = 0
				dist = 0
			elseif dist > 0.05 then
				local speed = if attackMode then RUN_SPEED else math.max(14, speedNow * 1.15 + dist * 2)
				local stepLen = math.min(dist, speed * dt)
				m.Pos += delta.Unit * stepLen
			end
			-- ground snap (staggered raycasts)
			if clock >= m.NextRay then
				m.NextRay = clock + 0.18 + math.random() * 0.08
				local hit = workspace:Raycast(Vector3.new(m.Pos.X, root.Position.Y + 3, m.Pos.Z), Vector3.new(0, -20, 0), rayParams)
				m.GroundY = if hit then math.clamp(hit.Position.Y, footY - 10, footY + 4) else footY
			end
			local y = m.Pos.Y + (m.GroundY - m.Pos.Y) * math.min(1, dt * 14)
			m.Pos = Vector3.new(m.Pos.X, y, m.Pos.Z)

			-- facing
			local wantYaw = m.Yaw
			if faceTo and dist < 4 then
				local f = Vector3.new(faceTo.X - m.Pos.X, 0, faceTo.Z - m.Pos.Z)
				if f.Magnitude > 0.1 then
					wantYaw = math.atan2(-f.X, -f.Z)
				end
			elseif dist > 0.6 then
				wantYaw = math.atan2(-delta.X, -delta.Z)
			elseif not ghost then
				wantYaw = rootYaw
			end
			m.Yaw += angleDiff(m.Yaw, wantYaw) * math.min(1, dt * 12)

			-- state
			local state
			if m.CelebrateUntil > clock then
				state = "Celebrate"
			elseif attackMode and dist < 4 then
				state = "Attack"
			elseif dist > 0.6 then
				state = "Run"
			else
				state = "Idle"
			end
			m.State = state
			HunterRig.Pose(m.Rig, state, clock + m.Phase, 1)

			-- beam
			local beam = m.Beam
			if state == "Attack" and ghost then
				anyAttacking = true
				local att = centerAttachment(ghost)
				if beam.Attachment1 ~= att then
					beam.Attachment1 = att
				end
				beam.Enabled = true
				local w = math.sin(clock * 9 + m.Phase)
				beam.CurveSize0 = w * 1.6
				beam.CurveSize1 = -w * 1.1
				beam.Width0 = 0.3 + 0.12 * math.sin(clock * 22 + m.Phase)
				beam.Width1 = 0.7 + 0.25 * math.sin(clock * 17 + m.Phase)
				-- RAINBOW BEAMS pass (cosmetic): hue cycles along the beam
				if pl:GetAttribute("RainbowBeams") == true then
					local h = (clock * 0.35 + m.Phase * 0.1) % 1
					beam.Color = ColorSequence.new(Color3.fromHSV(h, 0.75, 1), Color3.fromHSV((h + 0.35) % 1, 0.75, 1))
				end
			elseif beam.Enabled then
				beam.Enabled = false
			end

			-- HP bar: while hurt, while the own crew fights, or while an alert line shows
			local alertOn = m.AlertUntil > clock
			local show = m.Hp < 100 or (isLocal and c.Fighting) or alertOn
			if m.HpGui.Enabled ~= show then
				m.HpGui.Enabled = show
			end
			local a = m.Alert
			if a and not alertOn and a.Text ~= "" then
				a.Text = ""
			end

			table.insert(roots, m.Rig.Root)
			local hk = clock - m.HitT
			if hk < 0.3 then
				-- slime hit: tiny squash down + lean back, then spring up
				local k = math.sin(math.pi * hk / 0.3)
				table.insert(cframes, CFrame.new(m.Pos.X, m.Pos.Y - 0.3 * k, m.Pos.Z) * CFrame.Angles(0, m.Yaw, 0) * CFrame.Angles(0.25 * k, 0, 0))
			else
				table.insert(cframes, CFrame.new(m.Pos) * CFrame.Angles(0, m.Yaw, 0))
			end
		end
		c.Fighting = anyAttacking

		-- impact sparks + soft zaps for your own crew only (keeps busy servers cheap)
		if isLocal and anyAttacking and ghost then
			if clock >= c.NextSpark then
				c.NextSpark = clock + 0.3
				local m = c.Members[math.random(1, n)]
				local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * ghost.Def.Scale * 2
				Effects.Burst(ghost.Pos + off, { Color = m.Color, Count = 7, Size = 0.5, Speed = 9, Life = 0.4 })
			end
			if clock >= c.NextSound then
				c.NextSound = clock + 0.45
				Sound.Play("Attack", 0.15)
			end
		end
	end
	-- knocked-out own hunters drift along in a row behind the crew
	local lroot = rootOf(player)
	if lroot and #kos > 0 then
		local c = crews[player]
		local rows = math.ceil((if c then #c.Members else 0) / 3)
		local look = lroot.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local flat = CFrame.new(lroot.Position) * CFrame.Angles(0, yaw, 0)
		local k = math.min(1, dt * 6)
		for i, ko in kos do
			local col = (i - 1) % 3
			local row = (i - 1) // 3
			local goal = (flat * CFrame.new((col - 1) * 3.2, -2.7, 4.6 + (rows + row) * 3.4)).Position
			ko.Pos = if (goal - ko.Pos).Magnitude > 60 then goal else ko.Pos:Lerp(goal, k)
			table.insert(roots, ko.Rig.Root)
			table.insert(cframes, CFrame.new(ko.Pos) * CFrame.Angles(0, yaw, 0))
		end
	end
	stepSpits(clock)
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local KO_TINT = Color3.fromRGB(170, 175, 200)

local function newKO(uid: string, id: string, tier: number, at: Vector3): KO
	local rig = HunterRig.Build(id)
	local scale = if tier >= 2 then HUNTER_SCALE * 1.2 else HUNTER_SCALE
	rig.Model:ScaleTo(scale)
	rig.Height *= scale
	for _, p in rig.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.SmoothPlastic
			p.Color = p.Color:Lerp(KO_TINT, 0.75)
			p.Transparency = math.max(p.Transparency, 0.6)
		elseif p:IsA("Light") or p:IsA("ParticleEmitter") then
			p:Destroy()
		end
	end
	rig.Model:PivotTo(CFrame.new(at))
	rig.Model.Parent = folder
	local gui = WorldLabel.New({
		Name = "KO",
		Adornee = rig.Root,
		Parent = rig.Model,
		Size = Vector2.new(80, 22),
		Offset = Vector3.new(0, rig.Height + 0.7, 0),
		MaxDistance = 70,
		AlwaysOnTop = true,
	})
	return { Uid = uid, Rig = rig, Pos = at, Label = WorldLabel.Text(gui, "", { Style = "Small", Color = Color3.fromRGB(200, 205, 230) }) }
end

-- Keeps one faded rig per equipped hunter whose knockout hasn't ended; updates the countdowns.
local function syncKnocked()
	local d = State.Data
	local now = State.Now()
	local want: { [string]: number } = {}
	if d and d.Equipped and d.Knocked then
		for _, uid in d.Equipped do
			local t = d.Knocked[uid]
			local h = d.Hunters and d.Hunters[uid]
			if type(t) == "number" and t > now and h and Config.Hunters[h.Id] then
				want[uid] = t
			end
		end
	end
	for i = #kos, 1, -1 do
		local ko = kos[i]
		if not want[ko.Uid] then
			ko.Rig.Model:Destroy()
			table.remove(kos, i)
		end
	end
	for uid, t in want do
		local label: TextLabel? = nil
		for _, k in kos do
			if k.Uid == uid then
				label = k.Label
				break
			end
		end
		if not label then
			local root = rootOf(player)
			local at = gone[uid] or (if root then root.Position - Vector3.new(0, 2.7, -6) else Vector3.zero)
			local h = d.Hunters[uid]
			local ko = newKO(uid, h.Id, tonumber(h.Tier) or 0, at)
			table.insert(kos, ko)
			label = ko.Label
		end
		(label :: TextLabel).Text = "💤 " .. Format.Time(t - now)
	end
end

local function localMember(uid: any): Member?
	local c = crews[player]
	if c then
		for _, m in c.Members do
			if m.Uid == uid then
				return m
			end
		end
	end
	return nil
end

-- Short line over an own rig's HP bar ("DODGED"); step clears it when the time is up.
local function flash(m: Member, text: string, color: Color3, t: number)
	local a = m.Alert
	if not a then
		return
	end
	a.Text = text
	a.TextColor3 = color
	m.AlertUntil = os.clock() + t
end

-- Calm red outline on the targeted hunter during a windup (one reused Highlight per rig).
local function mark(m: Member, t: number)
	local hl = m.Mark
	if not hl then
		local made = Instance.new("Highlight")
		made.FillTransparency = 1
		made.OutlineColor = Theme.Bad
		made.OutlineTransparency = 0.1
		made.Parent = m.Rig.Model
		m.Mark = made
		hl = made
	end
	local h = hl :: Highlight
	h.Enabled = t > 0
	m.MarkUntil = os.clock() + t
	if t > 0 then
		task.delay(t + 0.05, function()
			if os.clock() >= m.MarkUntil then
				h.Enabled = false
			end
		end)
	end
end

function Crew.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHCrews"
	folder.Parent = workspace
end

function Crew.Start()
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(removePlayer)
	for _, pl in Players:GetPlayers() do
		addPlayer(pl)
	end
	-- victory pose when a ghost they were fighting poofs
	Ghosts.Died:Connect(function(uid: number)
		local until_ = os.clock() + 0.9
		for _, c in crews do
			if c.LastTarget == uid then
				for _, m in c.Members do
					if m.State == "Attack" then
						m.CelebrateUntil = until_
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
	-- retaliation (Fx reaches everyone fighting the ghost; hunter uids are per player, so the
	-- rig is always resolved by Owner + Hunter): windup telegraph, ectoplasm spit, splash/splat
	State.OnFx("GhostWindup", function(d: any)
		local t = tonumber(d.Time) or 0.9
		local m, mine = memberOf(d.Owner, d.Hunter)
		if m and mine then
			mark(m, t) -- own hunter: quiet red outline (the ❗ sits on the ghost)
		end
		local lead = math.max(0.1, t - SPIT_FLIGHT)
		local drawn = m ~= nil and m.Rig.Model.Parent ~= nil
		Ghosts.Windup(d.Ghost, lead, if m and drawn then m.Pos else nil, mine and m ~= nil)
		if m and drawn then
			task.delay(lead, launchSpit, d.Ghost, d.Owner, m, mine, t - lead)
		end
	end)
	State.OnFx("GhostHit", function(d: any)
		local m, mine = memberOf(d.Owner, d.Hunter)
		if m and mine then
			mark(m, 0)
			if d.Dodged then
				flash(m, "DODGED", Theme.Ecto, 0.8)
			end
		end
		local result = if d.Dodged then "Dodged" elseif d.Knocked then "Knocked" else "Hit"
		local key = tostring(d.Hunter)
		for _, s in spits do
			if s.Active and s.Result == nil and s.Ghost == d.Ghost and s.Owner == d.Owner and s.Hunter == key then
				s.Result = result
				if result == "Dodged" then
					-- veer off to the ground beside where the hunter stands now
					local base = s.Member.Pos
					local clock = os.clock()
					s.From = s.Pos
					s.To = Vector3.new(base.X + (math.random() - 0.5) * 2.5, base.Y + 0.1, base.Z + (math.random() - 0.5) * 2.5)
					s.Arc = 0.6
					s.T0 = clock
					s.Arrive = clock + math.max(0.15, s.Arrive - clock)
				end
				return
			end
		end
		-- no blob in flight (windup missed / pool full): still show the hit on a drawn rig
		if result == "Hit" and m and m.Rig.Model.Parent ~= nil then
			splashOn(m, not mine)
		end
	end)
	-- knocked-out rigs + countdowns: resync on every snapshot and once a second
	State.Changed:Connect(syncKnocked)
	task.spawn(function()
		while true do
			syncKnocked()
			task.wait(1)
		end
	end)
	State.OnFx("Knocked", function(d: any)
		local m = localMember(d.Uid)
		local pos = if m then m.Pos else gone[d.Uid]
		if pos then
			Effects.Poof(pos + Vector3.new(0, 2, 0), Color3.fromRGB(200, 200, 215), 0.6, false)
		end
	end)
end

-- Local crew members (for the crate reveal / tutorial).
function Crew.LocalCount(): number
	local c = crews[player]
	return if c then #c.Members else 0
end

return Crew
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">DailyPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DAILY reward: Day 1-7 tiles, a big golden Day 7, CLAIM button or a countdown.
-- Timing is decided by the server's clock (the client only displays it).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local DailyPanel = {}

type Tile = { Frame: Frame, Check: TextLabel, Today: TextLabel, Reward: TextLabel, Scale: UIScale }

local panel: Kit.Panel
local tiles: { Tile } = {}
local claimButton: TextButton
local statusLabel: TextLabel
local busy = false

local function rewardLabel(i: number, mult: number): string
	local r = Config.Daily.Rewards[i]
	if r.Amount and mult > 1 then
		return (r.Label:gsub(Format.Commas(r.Amount), Format.Commas(r.Amount * mult)))
	end
	return r.Label
end

local function remaining(d: any): number
	local info = d.DailyInfo
	if not info then
		return 0
	end
	return math.max(0, info.Wait - (State.Now() - (d.ServerTime or State.Now())))
end

local function refresh()
	local d = State.Data
	if not d or not d.DailyInfo then
		return
	end
	local info = d.DailyInfo
	local left = remaining(d)
	local canClaim = info.CanClaim or left <= 0
	local day = info.Day
	local claimed = if canClaim then day - 1 elseif day == 1 then #Config.Daily.Rewards else day - 1
	local mult = d.ZoneMultiplier or 1
	for i, t in tiles do
		t.Reward.Text = rewardLabel(i, mult)
		t.Check.Visible = i <= claimed
		t.Today.Visible = canClaim and i == day
		t.Frame.BackgroundTransparency = if i <= claimed then 0.45 else 0
	end
	if canClaim then
		Kit.SetButtonText(claimButton, "CLAIM DAY " .. day .. "!")
		claimButton:SetAttribute("Color", "Green")
		statusLabel.Text = if info.StreakBroken then "Streak reset - start again from Day 1!" else "Come back every day for bigger rewards!"
	else
		Kit.SetButtonText(claimButton, "NEXT IN " .. Format.Time(left))
		claimButton:SetAttribute("Color", "Gray")
		statusLabel.Text = "Day " .. day .. " unlocks in " .. Format.Time(left) .. ". Don't miss a day or your streak resets!"
	end
end

local function claim()
	if busy then
		return
	end
	busy = true
	local res = State.Request("ClaimDaily")
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Not yet!", "Bad")
		return
	end
	Sound.Play("Daily")
	Hud.Banner("DAY " .. tostring(res.Day) .. " REWARD!", res.Label, Theme.Gold)
	local t = tiles[res.Day]
	if t then
		t.Scale.Scale = 1.25
		Kit.Tween(t.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Effects.Burst(root.Position + Vector3.new(0, 2, 0), { Color = Theme.Gold, Color2 = Theme.Ecto, Count = 50, Size = 1, Speed = 20 })
	end
end

function DailyPanel.Init()
	panel = Kit.Panel("Daily", "DAILY REWARDS", Vector2.new(700, 440), "Purple")
	-- tiles wrap to the panel width (4 per row on wide screens) and scroll if short
	local grid: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -96),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(148, 124), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6), Parent = grid })
	for i = 1, #Config.Daily.Rewards do
		local big = i == #Config.Daily.Rewards
		local f: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = grid,
		})
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		if big then
			Kit.Gradient(f, Theme.Gold, Color3.fromRGB(255, 120, 40), 90)
		else
			Kit.Gradient(f, Theme.Panel3, Theme.Panel2, 90)
		end
		local sc = Kit.new("UIScale", { Parent = f })
		Kit.Label(f, "DAY " .. i, { Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 4), Style = "Heading", ZIndex = 63 })
		local r = Config.Daily.Rewards[i]
		local icon = if r.Kind == "Day7" then "🎁" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "🍀" else "⚡") else "💚"
		local iconKey = if r.Kind == "Day7" then "menu_daily" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "boost_luck" else "boost_ecto2x") else "ecto_pile"
		Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 28), Style = "Icon", TextSize = 28, ZIndex = 63, Stroke = 0 })
		local reward = Kit.Label(f, r.Label, { Size = UDim2.new(1, -12, 0, 52), Position = UDim2.fromOffset(6, 66), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Style = "Small" })
		local check = Kit.Label(f, "✅", { Size = UDim2.fromScale(1, 1), Color = Theme.Good, ZIndex = 66, Style = "Banner", Stroke = 3 })
		check.Visible = false
		local today = Kit.Label(f, "TODAY!", { Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, 4, 0, -8), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 67, Stroke = 2 })
		today.Rotation = 8
		today.Visible = false
		table.insert(tiles, { Frame = f, Check = check, Today = today, Reward = reward, Scale = sc })
	end
	statusLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 1, -82), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 })
	claimButton = Kit.Button(panel.Body, {
		Text = "CLAIM",
		Color = "Green",
		Size = UDim2.fromOffset(280, 48),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = claim,
	})
	panel.Primary = claimButton
	Hud.RegisterPanel("Daily", function()
		panel:Toggle()
	end)
end

function DailyPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
	-- a returning player with a reward waiting gets the panel once, a few seconds after joining
	task.spawn(function()
		local d = State.WaitForData()
		task.wait(6)
		if d.DailyInfo and d.DailyInfo.CanClaim and (d.Tutorial or 1) > #Config.Tutorial.Steps then
			-- waits for any open menu / crate reveal to finish instead of skipping or closing it
			Kit.WhenFree(function()
				local now = State.Data
				if not panel.IsOpen and now and now.DailyInfo and now.DailyInfo.CanClaim then
					panel:Open()
				end
			end)
		end
	end)
end

return DailyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DEV panel: owner-only test tools. The 🛠 button appears only when the server marked this
-- player as a developer (attribute "IsDev"); every action is checked again on the server.
-- Rare pet launch event admins (attribute "RarePetAdmin", Config.RarePetEvent.AdminUserIds) also
-- get the button, with the START RARE PET EVENT control + status at the top of the panel.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Format = require(GH.Logic.Format)
local Config = require(GH.Config)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local DevPanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local inbox: Kit.Panel
local inboxList: ScrollingFrame
local devButton: TextButton
local list: ScrollingFrame
local actionButtons: { GuiObject } = {}
local rareRow: Frame
local rareStatus: TextLabel
local rareButton: TextButton
local rareConfirm: Kit.Panel
local rareBusy = false
local rareMsg: string? = nil -- last error / result line from the server
local rareMsgBad = false

local function showInbox()
	local res = State.Request("FeedbackInbox")
	if not res.ok then
		Kit.Toast(res.err or "Couldn't load feedback", "Bad")
		return
	end
	for _, c in inboxList:GetChildren() do
		if c:IsA("Frame") or c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local entries = res.Entries or {}
	if #entries == 0 then
		Kit.Label(inboxList, "No feedback yet.", { Size = UDim2.new(1, 0, 0, 30), Style = "Body", ZIndex = 62 })
	end
	for i, e in entries do
		local f: Frame = Kit.new("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.3, LayoutOrder = i, ZIndex = 62, Parent = inboxList })
		Kit.Corner(f, UDim.new(0, 10))
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = f })
		Kit.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = f })
		local head = (if e.Kind == "Bug" then "🐞 BUG" else "💡 IDEA") .. "  ·  " .. tostring(e.Name) .. "  ·  " .. tostring(e.Zone) .. "  ·  " .. os.date("%Y-%m-%d %H:%M", e.T or 0) .. "  ·  v" .. tostring(e.Version)
		local h = Kit.Label(f, head, { Size = UDim2.new(1, 0, 0, 16), Align = Enum.TextXAlignment.Left, Color = if e.Kind == "Bug" then Theme.Bad else Theme.Ecto, Style = "Tiny", Fit = true, ZIndex = 63 })
		h.LayoutOrder = 1
		local t = Kit.Label(f, tostring(e.Text), { Size = UDim2.new(1, 0, 0, 0), Align = Enum.TextXAlignment.Left, AlignY = Enum.TextYAlignment.Top, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 63 })
		t.AutomaticSize = Enum.AutomaticSize.Y
		t.LayoutOrder = 2
	end
	panel:Close()
	inbox:Open()
end

local HUNTER_COUNT = 0
for _ in Config.Hunters do
	HUNTER_COUNT += 1
end

type Action = { Text: string, Cmd: string, Arg: any?, Color: string, Confirm: boolean?, StudioOnly: boolean? }
local ACTIONS: { Action } = {
	{ Text = "+10K ECTO", Cmd = "Ecto", Arg = 10000, Color = "Green" },
	{ Text = "+1M ECTO", Cmd = "Ecto", Arg = 1000000, Color = "Green" },
	{ Text = "+1B ECTO", Cmd = "Ecto", Arg = 1000000000, Color = "Green" },
	{ Text = "+1T ECTO", Cmd = "Ecto", Arg = 1000000000000, Color = "Green" },
	{ Text = "UNLOCK ALL AREAS", Cmd = "Zones", Color = "Blue" },
	{ Text = "ALL " .. HUNTER_COUNT .. " HUNTERS", Cmd = "Hunters", Color = "Orange" },
	{ Text = "COMPLETE INDEX (ALL FORMS)", Cmd = "IndexAll", Color = "Orange" },
	{ Text = "EQUIPPED CREW → MEGA", Cmd = "MegaCrew", Color = "Purple" },
	{ Text = "KNOCK OUT CREW (30S)", Cmd = "KnockCrew", Color = "Red" },
	{ Text = "MAX UPGRADES", Cmd = "MaxUpgrades", Color = "Teal" },
	{ Text = "GIVE ALL PETS", Cmd = "AllPets", Color = "Pink" },
	{ Text = "UNLOCK ALL EGGS", Cmd = "UnlockEggs", Color = "Pink" },
	{ Text = "+1K SPIRIT SHARDS", Cmd = "Shards", Arg = 1000, Color = "Purple" },
	{ Text = "+10K SPIRIT SHARDS", Cmd = "Shards", Arg = 10000, Color = "Purple" },
	{ Text = "+100K SPIRIT SHARDS", Cmd = "Shards", Arg = 100000, Color = "Purple" },
	{ Text = "EQUIPPED CREW → SHINY", Cmd = "ShinyCrew", Color = "Purple" },
	{ Text = "+4 COPIES OF CREW (MERGE TEST)", Cmd = "MergeCopies", Color = "Orange" },
	{ Text = "TELEPORT: LOBBY", Cmd = "Teleport", Arg = "Lobby", Color = "Blue" },
	{ Text = "TELEPORT: BOSS TOWER", Cmd = "Teleport", Arg = "Tower", Color = "Blue" },
	{ Text = "TELEPORT: PET HATCHERY", Cmd = "Teleport", Arg = "Hatchery", Color = "Blue" },
	{ Text = "MAX LUCKY OPENS", Cmd = "LuckyOpens", Color = "Green" },
	{ Text = "+10 SKIP TOKENS", Cmd = "SkipTokens", Color = "Teal" },
	{ Text = "2X ECTO + LUCK BOOSTS 30M", Cmd = "Boosts", Color = "Green" },
	{ Text = "HEAL ALL HUNTERS", Cmd = "HealAll", Color = "Green" },
	{ Text = "2X ECTOPLASM: 2 DAYS", Cmd = "Ecto2x", Arg = 48, Color = "Green" },
	{ Text = "2X ECTOPLASM: ON (48H)", Cmd = "Ecto2x", Arg = true, Color = "Green" },
	{ Text = "2X ECTOPLASM: OFF", Cmd = "Ecto2x", Arg = false, Color = "Red" },
	{ Text = "RESET DAILY", Cmd = "ResetDaily", Color = "Purple" },
	{ Text = "LEGACY PASS: AUTO OPEN", Cmd = "AutoAttack", Color = "Purple" },
	{ Text = "ALL GAME PASSES", Cmd = "AllPasses", Color = "Purple" },
	{ Text = "SERVER LUCK 15M", Cmd = "ServerLuck", Color = "Green" },
	{ Text = "EXCLUSIVE HUNTER", Cmd = "Exclusive", Color = "Teal" },
	{ Text = "REPLAY TUTORIAL", Cmd = "Tutorial", Color = "Gray" },
	{ Text = "+5 MIN RARE PET PLAY", Cmd = "RarePetAddMinutes", Arg = 5, Color = "Orange", StudioOnly = true },
	{ Text = "💬 READ FEEDBACK", Cmd = "Inbox", Color = "Blue" },
	{ Text = "PREVIEW UPDATE POPUP", Cmd = "UpdatePopup", Color = "Purple" },
	{ Text = "⚠️ RESET MY PROGRESS", Cmd = "ResetProgress", Color = "Red", Confirm = true },
}

local armed: { [string]: number } = {} -- dangerous actions need a second tap within 4 s

local function run(a: Action)
	if a.Cmd == "Inbox" then
		showInbox()
		return
	end
	if a.Cmd == "UpdatePopup" then
		panel:Close()
		require(script.Parent.UpdatePopup).Show()
		return
	end
	if a.Confirm then
		local t = armed[a.Cmd]
		if not t or os.clock() - t > 4 then
			armed[a.Cmd] = os.clock()
			Kit.Toast("Tap " .. a.Text .. " again to confirm", "Bad")
			return
		end
		armed[a.Cmd] = nil
	end
	local res = State.Request("Dev", a.Cmd, a.Arg)
	if res.ok then
		Kit.Toast(if a.Cmd == "Ecto" then "+" .. Format.Short(a.Arg :: number) .. " Ectoplasm" elseif a.Cmd == "Shards" then "+" .. Format.Short(a.Arg :: number) .. " Spirit Shards" else a.Text .. " ✅", "Good")
	else
		Kit.Toast(res.err or "Failed", "Bad")
	end
end

-- One grid cell: number box + button. Checked here for a quick message; the server re-checks.
local function numberInput(order: number, placeholder: string, text: string, color: string, cmd: string, max: number, done: (number) -> string)
	local cell: Frame = Kit.new("Frame", { BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.3, LayoutOrder = order, ZIndex = 62, Parent = list })
	Kit.Corner(cell, UDim.new(0, 10))
	local box: TextBox = Kit.new("TextBox", {
		Size = UDim2.new(0, 70, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = Theme.Body,
		TextSize = Theme.Type.Body,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		PlaceholderText = placeholder,
		Text = "",
		ZIndex = 63,
		Parent = cell,
	})
	Kit.Button(cell, { Text = text, Color = color, TextStyle = "Small", Size = UDim2.new(1, -80, 1, -6), Position = UDim2.new(1, -3, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 63, OnClick = function()
		local n = tonumber(box.Text)
		if not n or n % 1 ~= 0 or n < 1 or n > max then
			Kit.Toast("Enter a whole number 1-" .. Format.Short(max), "Bad")
			return
		end
		local res = State.Request("Dev", cmd, n)
		if res.ok then
			Kit.Toast(done(n), "Good")
		else
			Kit.Toast(res.err or "Failed", "Bad")
		end
	end })
	table.insert(actionButtons, cell)
end

--------------------------------------------------------------------------------
-- Rare pet launch event (admins only; the server checks again)
--------------------------------------------------------------------------------
local RARE_ROW_H = 58

local function utc(t: number): string
	return os.date("!%Y-%m-%d %H:%M UTC", t)
end

local function refreshRare()
	if not rareStatus then
		return
	end
	local startT = workspace:GetAttribute("RarePetStart")
	local endT = workspace:GetAttribute("RarePetEnd")
	local checked = workspace:GetAttribute("RarePetChecked") == true
	local text: string
	local color = Theme.Muted
	local canStart = false
	if type(startT) == "number" and type(endT) == "number" then
		local active = State.Now() < endT
		text = (if active then "🏮 RARE PET EVENT: ACTIVE" else "🏮 RARE PET EVENT: ENDED") .. "\nStart " .. utc(startT) .. "  ·  End " .. utc(endT)
		color = if active then Theme.Good else Theme.Muted
	elseif rareBusy then
		text = "🏮 RARE PET EVENT: Starting..."
	elseif not checked then
		text = "🏮 RARE PET EVENT: Checking..."
	else
		text = "🏮 RARE PET EVENT: Not started"
		canStart = true
	end
	if rareMsg then
		text ..= "\n" .. (rareMsg :: string)
		if rareMsgBad then
			color = Theme.Bad
		end
	end
	rareStatus.Text = text
	rareStatus.TextColor3 = color
	canStart = canStart and not rareBusy
	rareButton:SetAttribute("Color", if canStart then "Orange" else "Gray")
	rareButton.Active = canStart
	rareButton.AutoButtonColor = false
	local label = if canStart then "START RARE PET EVENT" elseif type(startT) == "number" then "ALREADY STARTED" elseif rareBusy then "STARTING..." else "CHECKING..."
	Kit.SetButtonText(rareButton, label)
end

local function startRare()
	if rareBusy then
		return
	end
	rareBusy = true
	rareMsg = nil
	refreshRare()
	local res = State.Request("Dev", "StartRarePetEvent")
	rareBusy = false
	if res.ok then
		rareMsg = "Started on all servers."
		rareMsgBad = false
		Kit.Toast("Rare Pet Event started ✅", "Good")
	else
		rareMsg = res.err or "Failed"
		rareMsgBad = true
		Kit.Toast(rareMsg :: string, "Bad")
	end
	refreshRare()
	panel:Open()
end

local function buildRare()
	rareRow = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, RARE_ROW_H), Position = UDim2.fromOffset(0, 6), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.3, Visible = false, ZIndex = 61, Parent = panel.Body })
	Kit.Corner(rareRow, UDim.new(0, 10))
	rareStatus = Kit.Label(rareRow, "🏮 RARE PET EVENT: Checking...", { Size = UDim2.new(1, -212, 1, -6), Position = UDim2.fromOffset(10, 3), Align = Enum.TextXAlignment.Left, Font = Theme.Body, Style = "Tiny", Stroke = 0, Wrap = true, ZIndex = 62 })
	rareButton = Kit.Button(rareRow, {
		Text = "START RARE PET EVENT",
		Color = "Orange",
		Size = UDim2.fromOffset(190, 42),
		Position = UDim2.new(1, -6, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			if not rareButton.Active then
				refreshRare()
				return
			end
			rareConfirm:Open()
		end,
	})

	rareConfirm = Kit.Panel("RarePetConfirm", "START RARE PET EVENT?", Vector2.new(480, 270), "Orange")
	Kit.Label(rareConfirm.Body, "This starts ONE global 48-hour event on ALL servers immediately. It can't be undone or restarted.", { Size = UDim2.new(1, -20, 0, 90), Position = UDim2.fromOffset(10, 16), Style = "Body", Wrap = true, ZIndex = 62 })
	Kit.Label(rareConfirm.Body, "Players who play 30 active minutes before it ends get the Rare pet.", { Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 110), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, Wrap = true, ZIndex = 62 })
	Kit.Button(rareConfirm.Body, {
		Text = "CANCEL",
		Color = "Gray",
		Size = UDim2.fromOffset(170, 46),
		Position = UDim2.new(0.5, -8, 1, -4),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 63,
		OnClick = function()
			rareConfirm:Close()
			panel:Open()
		end,
	})
	local confirm = Kit.Button(rareConfirm.Body, {
		Text = "CONFIRM",
		Color = "Red",
		Size = UDim2.fromOffset(170, 46),
		Position = UDim2.new(0.5, 8, 1, -4),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 63,
		OnClick = function()
			rareConfirm:Close()
			task.spawn(startRare)
		end,
	})
	rareConfirm.Primary = confirm
end

function DevPanel.Init()
	panel = Kit.Panel("Dev", "🛠 DEV TOOLS", Vector2.new(620, 400), "Gray")
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 46), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = list })
	for i, a in ACTIONS do
		if a.StudioOnly and not RunService:IsStudio() then
			continue
		end
		local b = Kit.Button(list, { Text = a.Text, Color = a.Color, TextStyle = "Small", ZIndex = 62, OnClick = function()
			run(a)
		end })
		b.LayoutOrder = i
		table.insert(actionButtons, b)
		if i == 1 then
			panel.Primary = b
		end
	end
	numberInput(#ACTIONS + 1, "amount", "GIVE SHARDS", "Teal", "Shards", 1000000, function(n)
		return "+" .. Format.Short(n) .. " Spirit Shards"
	end)
	numberInput(#ACTIONS + 2, "room", "TOWER ROOM", "Orange", "TowerRoom", 400, function(n)
		panel:Close()
		return "Tower room " .. n .. " ✅"
	end)
	buildRare()
	Kit.Label(panel.Body, "Only you can see this. In a live server these change your real save.", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), Color = Theme.Muted, Font = Theme.Body, Style = "Tiny", Stroke = 0, ZIndex = 62 })

	inbox = Kit.Panel("DevInbox", "💬 PLAYER FEEDBACK", Vector2.new(760, 460), "Blue")
	inboxList = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -8),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = inbox.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inboxList })

	-- lower-right row next to FEEDBACK / SETTINGS
	devButton = Kit.Button(Hud.LowerRow or Kit.Screen(), {
		Text = "🛠",
		Color = "Gray",
		Size = UDim2.fromOffset(44, 44),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	devButton.Visible = false
	devButton.LayoutOrder = 1
end

function DevPanel.Start()
	local function refresh()
		local isDev = player:GetAttribute("IsDev") == true
		local isAdmin = player:GetAttribute("RarePetAdmin") == true
		devButton.Visible = isDev or isAdmin
		for _, b in actionButtons do
			b.Visible = isDev
		end
		rareRow.Visible = isAdmin
		local top = if isAdmin then RARE_ROW_H + 12 else 8
		list.Position = UDim2.fromOffset(0, top)
		list.Size = UDim2.new(1, 0, 1, -26 - top)
		refreshRare()
	end
	player:GetAttributeChangedSignal("IsDev"):Connect(refresh)
	player:GetAttributeChangedSignal("RarePetAdmin"):Connect(refresh)
	for _, attr in { "RarePetStart", "RarePetEnd", "RarePetChecked" } do
		workspace:GetAttributeChangedSignal(attr):Connect(refreshRare)
	end
	refresh()
	-- Active -> Ended needs no message: re-check the clock while the panel is open
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen and rareRow.Visible then
				refreshRare()
			end
		end
	end)
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Short-lived VFX helpers (bursts, rings, sparkles). All local, all self-cleaning, and capped
-- so a busy moment never turns into a GPU benchmark.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

Effects.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local folder: Folder
local live = 0
local MAX_LIVE = 24

local function holder(pos: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = folder
	return p
end

export type BurstOpts = {
	Color: Color3,
	Color2: Color3?,
	Count: number?,
	Size: number?,
	Speed: number?,
	Life: number?,
	Texture: string?,
	Spread: number?,
	Gravity: number?,
	LightEmission: number?,
}

function Effects.Burst(pos: Vector3, o: BurstOpts)
	if live >= MAX_LIVE then
		return
	end
	live += 1
	local p = holder(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or Effects.Textures.Sparkle
	e.Color = ColorSequence.new(o.Color, o.Color2 or o.Color)
	local size = o.Size or 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.6, size * 0.8), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	local life = o.Life or 0.7
	e.Lifetime = NumberRange.new(life * 0.6, life)
	local speed = o.Speed or 18
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Acceleration = Vector3.new(0, -(o.Gravity or 0), 0)
	e.Drag = 3
	e.LightEmission = o.LightEmission or 1
	e.Rate = 0
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = p
	e:Emit(math.min(o.Count or 20, 160))
	task.delay(life + 0.2, function()
		live -= 1
		p:Destroy()
	end)
end

-- Expanding flat neon ring on the ground / around a point.
function Effects.Ring(pos: Vector3, color: Color3, radius: number, time: number?)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Size = Vector3.new(0.3, 1, 1)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = folder
	local t = time or 0.5
	TweenService:Create(r, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(r, t + 0.05)
end

-- Expanding glowing sphere (poofs, reveal flashes).
function Effects.Flash(pos: Vector3, color: Color3, radius: number, time: number?)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.Neon
	s.Color = color
	s.Transparency = 0.15
	s.Size = Vector3.new(1, 1, 1) * radius * 0.4
	s.CFrame = CFrame.new(pos)
	s.Parent = folder
	local t = time or 0.35
	TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(1, 1, 1) * radius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(s, t + 0.05)
end

-- The signature ghost POOF: flash + cloud + sparkles + ring.
function Effects.Poof(pos: Vector3, color: Color3, scale: number, big: boolean)
	Effects.Flash(pos, Color3.new(1, 1, 1), 3 * scale, 0.25)
	Effects.Flash(pos, color, 4.5 * scale, 0.45)
	Effects.Burst(pos, { Color = Color3.fromRGB(245, 240, 255), Color2 = color, Count = if big then 40 else 18, Size = 2.2 * scale, Speed = 10 * scale, Life = 0.8, Texture = Effects.Textures.Smoke, LightEmission = 0.3 })
	Effects.Burst(pos, { Color = color, Count = if big then 60 else 24, Size = 0.9 * math.sqrt(scale), Speed = 22 * math.sqrt(scale), Life = 0.7 })
	Effects.Ring(pos, color, 7 * scale, 0.5)
end

-- Cute slime splat: a few green droplets + a soft puddle ring that fades in ~0.5 s (no flash).
function Effects.Splat(pos: Vector3, groundY: number, color: Color3, scale: number)
	Effects.Burst(pos, { Color = color, Color2 = color:Lerp(Color3.new(1, 1, 1), 0.35), Count = math.max(4, math.round(9 * scale)), Size = 0.45 * scale, Speed = 10 * scale, Life = 0.5, Spread = 70, Gravity = 35, LightEmission = 0.35 })
	Effects.Ring(Vector3.new(pos.X, groundY + 0.08, pos.Z), color, 1.6 * scale, 0.5)
end

function Effects.Folder(): Folder
	return folder
end

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHEffects"
	folder.Parent = workspace
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">EventPopup</string>
              <string name="Source"><![CDATA[--!strict
-- 2X ECTOPLASM EVENT announcement. Shown when a developer turns the global event on, and once
-- after joining while it is already on. Closing it only hides the popup (the event keeps
-- running; the "2X ECTOPLASM EVENT" chip under the counters stays while it's active).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local EventPopup = {}

local panel: Kit.Panel
local shownThisSession = false
local eventOn = false -- latest on/off from the Ecto2xEvent Fx
local _ = GH

-- waits until no menu is open and no crate reveal is playing (never closes what you're using)
local queued = false
local function show()
	shownThisSession = true
	if queued then
		return -- one popup is already waiting for a free screen
	end
	queued = true
	Kit.WhenFree(function()
		queued = false
		if panel.IsOpen or not (eventOn or workspace:GetAttribute("Ecto2x") == true) then
			return -- already showing, or the event ended while we waited
		end
		Sound.Play("ZoneUnlock")
		panel:Open()
	end)
end

function EventPopup.Init()
	panel = Kit.Panel("Ecto2xEvent", "2X ECTOPLASM EVENT!", Vector2.new(460, 270), "Green")
	local body = panel.Body
	-- solid colour, no UIGradient: on phones the gradient-filled 56 px "2X" lost its "2" and
	-- flickered (seen in a player recording)
	Kit.Label(body, "2X", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 12), Color = Theme.Ecto, Style = "Banner", ZIndex = 62, Stroke = 3 })
	Kit.Label(body, "Earn DOUBLE Ectoplasm from ghosts while the event is active!", { Size = UDim2.new(1, -20, 0, 48), Position = UDim2.fromOffset(10, 80), Style = "Body", ZIndex = 62 })
	local ok = Kit.Button(body, {
		Text = "LET'S HUNT!",
		Color = "Green",
		Size = UDim2.fromOffset(220, 48),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			panel:Close()
		end,
	})
	panel.Primary = ok
end

function EventPopup.Start()
	State.OnFx("Ecto2xEvent", function(data: any)
		eventOn = type(data) == "table" and data.On == true
		if eventOn then
			show()
		elseif panel.IsOpen then
			panel:Close()
		end
	end)
	-- joined while the event is already on: show it once, after loading settles
	task.spawn(function()
		State.WaitForData()
		task.wait(4)
		if workspace:GetAttribute("Ecto2x") == true and not shownThisSession then
			show()
		end
	end)
end

return EventPopup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">FeedbackPanel</string>
              <string name="Source"><![CDATA[--!strict
-- FEEDBACK: players send a bug report or an idea (Settings → SEND FEEDBACK). The server filters
-- and stores it; the owner reads them in the DEV panel (FeedbackInbox).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local FeedbackPanel = {}

local panel: Kit.Panel
local box: TextBox
local counter: TextLabel
local kindButtons: { [string]: TextButton } = {}
local kind = "Bug"
local busy = false

local function setKind(k: string)
	kind = k
	for id, b in kindButtons do
		b:SetAttribute("Color", if id == k then (if id == "Bug" then "Red" else "Blue") else "Gray")
	end
	box.PlaceholderText = if k == "Bug"
		then "What went wrong? Where were you and what did you do?"
		else "What would make the game more fun?"
end

local function send()
	if busy then
		return
	end
	local text = box.Text
	if #text < Config.Feedback.MinLength then
		Kit.Toast("Tell us a bit more!", "Bad")
		return
	end
	busy = true
	local res = State.Request("Feedback", kind, text)
	busy = false
	if res.ok then
		box.Text = ""
		panel:Close()
		Kit.Toast("Thanks! Your " .. (if kind == "Bug" then "bug report" else "idea") .. " was sent 💚", "Good")
	else
		Kit.Toast(res.err or "Couldn't send", "Bad")
	end
end

function FeedbackPanel.Init()
	panel = Kit.Panel("Feedback", "💬 FEEDBACK", Vector2.new(520, 360), "Blue")
	local body = panel.Body
	local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 10), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), Parent = row })
	for _, k in { "Bug", "Idea" } do
		kindButtons[k] = Kit.Button(row, {
			Text = if k == "Bug" then "🐞 BUG" else "💡 IDEA",
			Color = "Gray",
			Size = UDim2.fromOffset(150, 40),
			TextStyle = "Body",
			ZIndex = 62,
			OnClick = function()
				setKind(k)
			end,
		})
	end
	local frame: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 1, -128), Position = UDim2.fromOffset(0, 58), BackgroundColor3 = Theme.Bg, ZIndex = 61, Parent = body })
	Kit.Corner(frame, UDim.new(0, 12))
	Kit.Stroke(frame, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	box = Kit.new("TextBox", {
		Size = UDim2.new(1, -20, 1, -16),
		Position = UDim2.fromOffset(10, 8),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Body,
		TextSize = Theme.Type.Body,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		Text = "",
		ZIndex = 62,
		Parent = frame,
	})
	counter = Kit.Label(body, "0 / " .. Config.Feedback.MaxLength, { Size = UDim2.fromOffset(110, 18), Position = UDim2.new(1, 0, 1, -66), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = Theme.Muted, Style = "Tiny", Stroke = 0, ZIndex = 62 })
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.Feedback.MaxLength then
			box.Text = box.Text:sub(1, Config.Feedback.MaxLength)
		end
		counter.Text = #box.Text .. " / " .. Config.Feedback.MaxLength
	end)
	local sendButton = Kit.Button(body, {
		Text = "SEND",
		Color = "Green",
		Size = UDim2.fromOffset(220, 46),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = send,
	})
	panel.Primary = sendButton
	setKind("Bug")
	Hud.RegisterPanel("Feedback", function()
		panel:Toggle()
	end)
end

return FeedbackPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">GatePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Zone gate confirm: "UNLOCK CEMETERY?" with cost, progress and what you get. The gate's
-- ProximityPrompt opens it; the server checks cost, order and distance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Icons = require(GH.Icons)

local GatePanel = {}

local panel: Kit.Panel
local costLabel: TextLabel
local fill: Frame
local progressLabel: TextLabel
local unlockButton: TextButton
local perkIcons: { [string]: ImageLabel } = {} -- per-zone perk pictures (area / crate)
local current: string? = nil
local busy = false

local function refresh()
	local d = State.Data
	local zone = current and Config.ZoneById[current]
	if not d or not zone then
		return
	end
	panel.Title.Text = "UNLOCK " .. zone.Name .. "?"
	Kit.IconText(costLabel, "💚 " .. Format.Short(zone.Cost) .. " ECTOPLASM")
	perkIcons.Ghosts.Image = Icons.Get(Icons.ForZone(zone.Id)) or ""
	perkIcons.Crate.Image = Icons.Get(Icons.ForCrate[zone.Crate]) or ""
	local frac = math.clamp(d.Ecto / math.max(zone.Cost, 1), 0, 1)
	Kit.Tween(fill, 0.25, { Size = UDim2.fromScale(math.max(frac, 0.03), 1) })
	progressLabel.Text = Format.Short(math.min(d.Ecto, zone.Cost)) .. " / " .. Format.Short(zone.Cost)
	if d.Zones[zone.Id] then
		Kit.SetButtonText(unlockButton, "UNLOCKED ✅")
		unlockButton:SetAttribute("Color", "Gray")
	elseif d.Ecto >= zone.Cost then
		Kit.SetButtonText(unlockButton, "UNLOCK!")
		unlockButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(unlockButton, "NEED 💚 " .. Format.Short(zone.Cost - d.Ecto) .. " MORE")
		unlockButton:SetAttribute("Color", "Gray")
	end
end

function GatePanel.Open(zoneId: string)
	if not Config.ZoneById[zoneId] then
		return
	end
	current = zoneId
	refresh()
	panel:Open()
end

function GatePanel.Init()
	panel = Kit.Panel("Gate", "UNLOCK?", Vector2.new(520, 330), "Green")
	local body = panel.Body
	costLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 14), Color = Theme.Ecto, Style = "Heading", ZIndex = 62 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(0.8, 0, 0, 24), Position = UDim2.new(0.1, 0, 0, 48), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(0.03, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Theme.Ecto, Theme.Ecto2, 0)
	progressLabel = Kit.Label(bar, "", { Style = "Small", ZIndex = 64 })
	local perks: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), Position = UDim2.fromOffset(0, 84), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 38), CellPadding = UDim2.fromOffset(10, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = perks })
	-- each perk: a picture (this area's icon / its crate / hunters / Ectoplasm) + the words
	local perkList: { { Id: string, Text: string, Key: string? } } = {
		{ Id = "Ghosts", Text = "NEW GHOSTS" },
		{ Id = "Crate", Text = "NEW CRATE" },
		{ Id = "Hunters", Text = "BETTER HUNTERS", Key = "menu_hunters" },
		{ Id = "Ecto", Text = "HIGHER REWARDS", Key = "ecto" },
	}
	for i, p in perkList do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Theme.Panel3, LayoutOrder = i, ZIndex = 62, Parent = perks })
		Kit.Corner(f, UDim.new(0, 10))
		local img: ImageLabel = Kit.new("ImageLabel", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = Icons.Get(p.Key) or "", ZIndex = 63, Parent = f })
		perkIcons[p.Id] = img
		Kit.Label(f, p.Text, { Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(40, 0), Align = Enum.TextXAlignment.Left, Style = "Body", Fit = true, ZIndex = 63 })
	end
	unlockButton = Kit.Button(body, {
		Text = "UNLOCK!",
		Color = "Green",
		Size = UDim2.fromOffset(260, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			local zoneId = current
			local d = State.Data
			if busy or not zoneId or not d or d.Zones[zoneId] then
				return
			end
			if d.Ecto < (Config.ZoneById[zoneId] :: Config.ZoneDef).Cost then
				Kit.Toast("Defeat more ghosts to earn Ectoplasm!", "Bad")
				return
			end
			busy = true
			local res = State.Request("UnlockZone", zoneId)
			busy = false
			if res.ok then
				panel:Close()
			else
				Kit.Toast(res.err or "Couldn't unlock", "Bad")
			end
		end,
	})
	panel.Primary = unlockButton
end

function GatePanel.Start()
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return GatePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Ghosts</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side ghost presentation. The server sends each ghost as a single invisible hitbox
-- (`Core`, the tap target) plus attributes; this module builds the visual rig locally
-- (GhostRig) only while the ghost is within draw range (rigs go back to a small per-kind pool
-- when it leaves), moves both along the server's wander segments, and handles bobbing, facing,
-- Spirit labels, the selected-ghost state (active label + ground ring), hit wobble, spawn-in
-- and the POOF. One RenderStepped loop for all ghosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Signal = require(GH.Signal)
local Format = require(GH.Logic.Format)
local GhostRig = require(GH.Rigs.GhostRig)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Ghosts = {}

export type Entry = {
	Uid: number,
	Model: Model, -- server model (hitbox)
	Core: BasePart, -- server hitbox (tap target, beam attachments)
	Vis: Model?, -- local visual rig (nil while culled: built/taken from the pool on approach)
	VisCore: BasePart?,
	Def: Config.GhostDef,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	Phase: number,
	Max: number,
	Spirit: number,
	Gui: BillboardGui,
	NameLabel: TextLabel,
	Bar: Frame,
	Fill: Frame,
	SpiritText: TextLabel,
	HitT: number,
	Yaw: number,
	Dying: boolean,
	Pos: Vector3, -- visual centre this frame
	Base: Vector3, -- centre without bob (for the ground ring)
	Selected: boolean,
	Culled: boolean,
	-- attack telegraph (driven by Crew on Fx "GhostWindup"): lean back + green glow at the
	-- mouth, then a forward "spit" pop when the ectoplasm bolt leaves (Crew flies the bolt)
	WindupEnd: number,
	WindupLen: number,
	LungeT: number,
	LungeDir: Vector3,
	Alert: TextLabel?, -- ❗ only while one of the local player's own hunters is the target
	Mine: boolean,
	Mouth: Part?, -- reused glow ball, made on the first windup (lives in the server model)
	MouthPos: Vector3, -- where bolts leave from (updated every frame while drawn)
	Grow: number, -- spawn-in size factor (1 = full); applied to a rig taken mid-grow
}

local entries: { [number]: Entry } = {}
local player = Players.LocalPlayer
local diedSignal = Signal.new()
Ghosts.Died = diedSignal -- (uid, pos)
local addedSignal = Signal.new()
Ghosts.Added = addedSignal -- (entry)
local selectedUid = 0
local ring: Part
local ringStroke: UIStroke
local MOUTH_GREEN = Color3.fromRGB(120, 255, 100)

-- Spare visual rigs per ghost id, so walking back and forth doesn't rebuild them every time.
local POOL_MAX = 3
local pool: { [string]: { Model } } = {}

local function takeRig(e: Entry)
	local id = e.Def.Id
	local list = pool[id]
	local vis: Model
	local spare = list and table.remove(list)
	if spare then
		vis = spare
	else
		vis = GhostRig.Build(id)
		vis.Name = "Visual"
		local core = vis.PrimaryPart :: BasePart
		core.CanQuery = false -- the server hitbox is the tap target
	end
	if e.Grow ~= 1 then
		vis:ScaleTo(e.Def.Scale * e.Grow)
	end
	vis:PivotTo(CFrame.new(e.Pos))
	vis.Parent = e.Model
	e.Vis = vis
	e.VisCore = vis.PrimaryPart :: BasePart
end

-- Unparents the rig and keeps it for reuse (full size, so a half-grown spawn-in isn't pooled).
local function releaseRig(e: Entry)
	local vis = e.Vis
	if not vis then
		return
	end
	e.Vis = nil
	e.VisCore = nil
	vis.Parent = nil
	local id = e.Def.Id
	local list = pool[id]
	if not list then
		list = {}
		pool[id] = list
	end
	if #list < POOL_MAX then
		if vis:GetScale() ~= e.Def.Scale then
			vis:ScaleTo(e.Def.Scale)
		end
		table.insert(list, vis)
	else
		vis:Destroy()
	end
end

function Ghosts.Get(uid: number): Entry?
	return entries[uid]
end

function Ghosts.All(): { [number]: Entry }
	return entries
end

-- Finds the ghost entry owning an instance (for tap targeting).
function Ghosts.FromInstance(inst: Instance?): Entry?
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") then
			local uid = cur:GetAttribute("Uid")
			if type(uid) == "number" and entries[uid] then
				return entries[uid]
			end
		end
		cur = cur.Parent
	end
	return nil
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function labelSize(e: Entry): Vector2
	local boss = e.Def.Kind == "Boss" or e.Def.Kind == "Event"
	if e.Selected then
		return if boss then Theme.World.BossLabelSelected else Theme.World.GhostLabelSelected
	end
	return if boss then Theme.World.BossLabel else Theme.World.GhostLabel
end

local function maxDistance(e: Entry): number
	if e.Selected then
		return Theme.World.SelectedMaxDistance
	end
	return if e.Def.Kind == "Normal" then Theme.World.GhostMaxDistance else Theme.World.BossMaxDistance
end

-- Spirit value on the bar: "x / max" when selected (and on bosses), just "x" otherwise.
local function spiritText(e: Entry)
	e.SpiritText.Text = if e.Selected or e.Def.Kind ~= "Normal"
		then Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max)
		else Format.Short(e.Spirit)
end

-- Unselected: name + slim bar. Selected: bigger bar with numbers, brighter, visible further,
-- drawn on top so you never lose your target.
local function styleLabel(e: Entry)
	spiritText(e)
	WorldLabel.Resize(e.Gui, labelSize(e))
	e.Gui.MaxDistance = maxDistance(e)
	-- always drawn on top: a world-depth label got cut by the ghost's own body and nearby walls
	-- at some camera angles (words "clipping through the wall"); MaxDistance still hides far ones
	e.Gui.AlwaysOnTop = true
	WorldLabel.SetTextStyle(e.SpiritText, if e.Selected then "Small" else "Tiny")
	e.Bar.Size = UDim2.fromScale(0.9, if e.Selected then 0.5 else 0.42)
	local st = e.Bar:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = if e.Selected then Color3.new(1, 1, 1) else Theme.Outline
		st.Thickness = if e.Selected then 2 else 1.5
	end
	e.NameLabel.TextColor3 = if e.Selected then Theme.Gold elseif e.Def.Kind ~= "Normal" then Color3.fromRGB(255, 230, 150) else Theme.Text
end

local function buildLabel(e: Entry)
	local def = e.Def
	-- above the head: hitbox top + a little, scaled with the ghost
	local gui = WorldLabel.New({
		Name = "SpiritGui",
		Adornee = e.Core,
		Parent = e.Model,
		Size = labelSize(e),
		Offset = Vector3.new(0, 2.6 * def.Scale + 0.8, 0),
		MaxDistance = Theme.World.GhostMaxDistance,
	})
	local nameText = def.Name
	if def.Kind == "MiniBoss" then
		nameText = "⭐ " .. nameText
	elseif def.Kind == "Boss" or def.Kind == "Event" then
		nameText = "👑 " .. nameText
	end
	e.NameLabel = WorldLabel.Text(gui, nameText, { Size = UDim2.fromScale(1, 0.48), Style = if def.Kind == "Normal" or def.Kind == "MiniBoss" then "Small" else "Body" })
	local bar: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(0.9, 0.42),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 15, 50),
		Parent = gui,
	})
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 1.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local fill: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, def.Glow, Color3.fromRGB(180, 120, 255), 0)
	e.SpiritText = WorldLabel.Text(bar, "", { Style = "Tiny", ZIndex = 3 })
	e.Bar = bar
	e.Fill = fill
	e.Gui = gui
end

local function updateSpirit(e: Entry, spirit: number)
	local old = e.Spirit
	e.Spirit = spirit
	local frac = if e.Max > 0 then math.clamp(spirit / e.Max, 0, 1) else 0
	TweenService:Create(e.Fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(frac, 1) }):Play()
	spiritText(e)
	if spirit < old then
		e.HitT = os.clock()
	end
end

-- Wander segment, packed by the server into one attribute: "fx,fy,fz|tx,ty,tz|t0|dur".
local function readSegment(e: Entry)
	local seg = e.Model:GetAttribute("Seg")
	if type(seg) ~= "string" then
		return
	end
	local fx, fy, fz, tx, ty, tz, t0, dur = string.match(seg, "^([^,]+),([^,]+),([^|]+)|([^,]+),([^,]+),([^|]+)|([^|]+)|(.+)$")
	local n = { tonumber(fx), tonumber(fy), tonumber(fz), tonumber(tx), tonumber(ty), tonumber(tz), tonumber(t0), tonumber(dur) }
	for i = 1, 8 do
		if n[i] == nil then
			return
		end
	end
	e.From = Vector3.new(n[1] :: number, n[2] :: number, n[3] :: number)
	e.To = Vector3.new(n[4] :: number, n[5] :: number, n[6] :: number)
	e.T0 = n[7] :: number
	e.Dur = n[8] :: number
end

-- Selected ghost: active label + soft ground ring (set by Targeting).
function Ghosts.SetSelected(uid: number)
	if uid == selectedUid then
		return
	end
	local old = entries[selectedUid]
	if old then
		old.Selected = false
		styleLabel(old)
	end
	selectedUid = uid
	local e = entries[uid]
	if e then
		e.Selected = true
		styleLabel(e)
		local d = math.max(4, 2.8 * e.Def.Scale + 1.5)
		ring.Size = Vector3.new(d, 0.1, d)
		ringStroke.Color = e.Def.Glow
	else
		ring.CFrame = CFrame.new(0, -500, 0)
	end
end

local function add(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local uid = model:GetAttribute("Uid")
	local ghostId = model:GetAttribute("GhostId")
	if type(uid) ~= "number" or type(ghostId) ~= "string" or entries[uid] then
		return
	end
	local def = Config.Ghosts[ghostId]
	local core = model.PrimaryPart or model:WaitForChild("Core", 5)
	if not def or not core or not core:IsA("BasePart") or model:GetAttribute("Dead") then
		return
	end
	-- the visual rig is built lazily by step() once the ghost is within draw range
	local e: Entry = {
		Uid = uid,
		Model = model,
		Core = core,
		Vis = nil,
		VisCore = nil,
		Def = def,
		From = core.Position,
		To = core.Position,
		T0 = 0,
		Dur = 0,
		Phase = math.random() * math.pi * 2,
		Max = (model:GetAttribute("MaxSpirit") :: number?) or def.Spirit,
		Spirit = (model:GetAttribute("Spirit") :: number?) or def.Spirit,
		Gui = nil :: any,
		NameLabel = nil :: any,
		Bar = nil :: any,
		Fill = nil :: any,
		SpiritText = nil :: any,
		HitT = 0,
		Yaw = math.random() * math.pi * 2,
		Dying = false,
		Pos = core.Position,
		Base = core.Position,
		Selected = false,
		Culled = true,
		WindupEnd = 0,
		WindupLen = 1,
		LungeT = 0,
		LungeDir = Vector3.zero,
		Alert = nil,
		Mine = false,
		Mouth = nil,
		MouthPos = core.Position,
		Grow = 1,
	}
	readSegment(e)
	buildLabel(e)
	e.Gui.Enabled = false -- shown when step() draws it
	updateSpirit(e, e.Spirit)
	entries[uid] = e
	if uid == selectedUid then
		selectedUid = 0
		Ghosts.SetSelected(uid)
	end
	model:GetAttributeChangedSignal("Seg"):Connect(function()
		readSegment(e)
	end)
	model:GetAttributeChangedSignal("Spirit"):Connect(function()
		updateSpirit(e, (model:GetAttribute("Spirit") :: number?) or 0)
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			if entries[uid] == e then
				entries[uid] = nil
			end
			e.Dying = true
			local vis = e.Vis
			if vis then
				e.Vis = nil
				e.VisCore = nil
				vis:Destroy()
			end
		end
	end)
	-- spawn-in: grow from nothing (the event boss gets its own dramatic entrance)
	if def.Kind ~= "Event" then
		local s = Instance.new("NumberValue")
		s.Value = 0.2
		e.Grow = 0.2
		local conn
		conn = s.Changed:Connect(function(v)
			if e.Dying or not model.Parent then
				conn:Disconnect()
				return
			end
			e.Grow = v
			local vis = e.Vis -- nil while culled (a far ghost has nothing to grow)
			if vis then
				vis:ScaleTo(def.Scale * v)
			end
		end)
		local tw = TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Value = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			e.Grow = 1
			conn:Disconnect()
			s:Destroy()
		end)
	end
	addedSignal:Fire(e)
end

local function poof(data: any)
	local e = entries[data.Uid]
	local pos: Vector3 = data.Pos
	local color: Color3 = data.Color
	local scale: number = data.Scale or 1
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = root == nil or (root.Position - pos).Magnitude < 160
	if e then
		e.Dying = true
		pos = e.Pos
		entries[data.Uid] = nil
		if selectedUid == data.Uid then
			selectedUid = 0
			ring.CFrame = CFrame.new(0, -500, 0)
		end
		diedSignal:Fire(data.Uid, pos)
		e.Gui.Enabled = false
		-- squash-and-stretch pop: inflate, then vanish (nothing to pop if the rig isn't drawn)
		local vis = e.Vis
		if not vis then
			if near then
				Effects.Poof(pos, color, scale, data.Big == true)
				Sound.Play(if data.Big then "BigPoof" else "Poof", 0.08)
			end
			return
		end
		local v = Instance.new("NumberValue")
		v.Value = 1
		v.Changed:Connect(function(x)
			if vis.Parent then
				vis:ScaleTo(math.max(0.05, e.Def.Scale * x))
			end
		end)
		local up = TweenService:Create(v, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1.35 })
		up:Play()
		up.Completed:Connect(function()
			if near then
				Effects.Poof(pos, color, scale, data.Big == true)
			end
			for _, p in vis:GetDescendants() do
				if p:IsA("BasePart") then
					p.Transparency = 1
				elseif p:IsA("ParticleEmitter") then
					p.Enabled = false
				elseif p:IsA("Light") then
					p.Enabled = false
				end
			end
			v:Destroy()
		end)
	elseif near then
		Effects.Poof(pos, color, scale, data.Big == true)
	end
	if near then
		Sound.Play(if data.Big then "BigPoof" else "Poof", 0.08)
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}
-- Ghost visuals further than this from the camera are parked (unparented): with 8 zones most
-- ghosts are far away, and mobile shouldn't draw or animate them. Hysteresis avoids flicker.
local CULL_OUT = 330
local CULL_IN = 300

local function step()
	local t = workspace:GetServerTimeNow()
	local clock = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(parts)
	table.clear(cframes)
	for _, e in entries do
		if e.Dying then
			continue
		end
		local a = if e.Dur > 0 then math.clamp((t - e.T0) / e.Dur, 0, 1) else 1
		local base = e.From:Lerp(e.To, smooth(a))
		local camDist = (base - camPos).Magnitude
		if e.Culled then
			if camDist > CULL_IN and not e.Selected then
				-- keep the position fresh for readers (Targeting fallback, Crew, Boss)
				e.Pos = base
				e.Base = base
				e.MouthPos = base
				continue
			end
			e.Culled = false
			e.Pos = base
			takeRig(e)
			e.Gui.Enabled = true
		elseif camDist > CULL_OUT and not e.Selected then
			e.Culled = true
			releaseRig(e)
			e.Gui.Enabled = false
			if e.Mouth then
				e.Mouth.Transparency = 1
			end
			e.Pos = base
			e.Base = base
			e.MouthPos = base
			continue
		end
		WorldLabel.SetDistance(e.Gui, camDist)
		local s = e.Def.Scale
		local bob = math.sin(clock * 2.2 + e.Phase) * 0.45 * math.sqrt(s)
		local pos = base + Vector3.new(0, bob, 0)
		-- hit shake
		local since = clock - e.HitT
		if since < 0.15 then
			local k = (0.15 - since) / 0.15
			pos += Vector3.new(math.sin(clock * 90) * 0.25 * k * s, 0, math.cos(clock * 80) * 0.2 * k * s)
		end
		-- attack telegraph: puff up + lean back during the windup, then a forward spit pop
		local winding = clock < e.WindupEnd
		local wk = 0 -- windup progress 0..1
		local pitch = 0
		if winding then
			wk = 1 - (e.WindupEnd - clock) / e.WindupLen
			pos += Vector3.new(0, 0.35 * s * wk, 0) - e.LungeDir * (0.7 * s * wk)
			pitch = 0.3 * wk
		elseif clock - e.LungeT < 0.25 then
			local k = math.sin(math.pi * (clock - e.LungeT) / 0.25)
			pos += e.LungeDir * (k * 1.2 * s)
			pitch = -0.2 * k
		end
		local alert = e.Alert
		if alert then
			local show = winding and e.Mine
			if alert.Visible ~= show then
				alert.Visible = show -- steady, no blinking
			end
		end
		-- face the camera horizontally (cute + readable), with a gentle sway
		local dx, dz = camPos.X - pos.X, camPos.Z - pos.Z
		if dx * dx + dz * dz > 1 then
			local target = math.atan2(-dx, -dz)
			local diff = (target - e.Yaw + math.pi) % (2 * math.pi) - math.pi
			e.Yaw += diff * 0.08
		end
		local sway = math.sin(clock * 1.7 + e.Phase) * 0.12
		local moving = a < 1 and (e.To - e.From).Magnitude > 0.5
		local lean = if moving then 0.12 else 0
		e.Pos = pos
		e.Base = base
		local cf = CFrame.new(pos) * CFrame.Angles(0, e.Yaw, 0) * CFrame.Angles(pitch - lean, 0, sway)
		e.MouthPos = cf * Vector3.new(0, -0.45 * s, -1.8 * s)
		table.insert(parts, e.Core)
		table.insert(cframes, CFrame.new(pos))
		local visCore = e.VisCore
		if visCore then
			table.insert(parts, visCore)
			table.insert(cframes, cf)
		end
		-- green glow gathering at the mouth while winding up
		local mouth = e.Mouth
		if mouth then
			if winding then
				local d = (0.25 + 0.75 * wk) * math.sqrt(s)
				mouth.Size = Vector3.new(d, d, d)
				mouth.Transparency = 0.45 - 0.25 * wk
				table.insert(parts, mouth)
				table.insert(cframes, CFrame.new(e.MouthPos))
			elseif mouth.Transparency < 1 then
				mouth.Transparency = 1
			end
		end
	end
	-- ground ring under the selected ghost
	local sel = entries[selectedUid]
	if sel and not sel.Dying then
		local groundY = sel.Base.Y - sel.Def.Hover + 0.15
		table.insert(parts, ring)
		table.insert(cframes, CFrame.new(sel.Base.X, groundY, sel.Base.Z) * CFrame.Angles(0, clock * 0.8, 0))
		ringStroke.Transparency = 0.25 + 0.2 * math.sin(clock * 4)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ghosts.Init()
	ring = Instance.new("Part")
	ring.Name = "TargetRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(6, 0.1, 6)
	ring.CFrame = CFrame.new(0, -500, 0)
	ring.Parent = workspace
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 24,
		LightInfluence = 0,
		Brightness = 1.5,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = sg })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 7, Color = Theme.Ecto, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
	-- dashed look: a second, inner faint circle
	local inner: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = circle })
	Kit.Corner(inner, UDim.new(1, 0))
	Kit.new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1), Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inner })
end

-- Windup telegraph for one attack (Crew calls this on Fx "GhostWindup"; the server sends it to
-- everyone fighting this ghost). `len` is the lean-back time before the spit leaves; `at` is the
-- targeted hunter's position (nil if not drawn); `mine` shows the ❗ (own hunter targeted).
function Ghosts.Windup(uid: number, len: number, at: Vector3?, mine: boolean)
	local e = entries[uid]
	if not e or e.Dying then
		return
	end
	local clock = os.clock()
	e.WindupLen = math.max(len, 0.1)
	e.WindupEnd = clock + e.WindupLen
	e.LungeT = e.WindupEnd -- spit pop right after the windup
	e.Mine = mine
	local flat = if at then Vector3.new(at.X - e.Base.X, 0, at.Z - e.Base.Z) else Vector3.zero
	e.LungeDir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.zero
	if mine and not e.Alert then
		e.Alert = WorldLabel.Text(e.Gui, "❗", { Style = "Body", Color = Theme.Bad, Size = UDim2.fromScale(1, 0.8), Position = UDim2.fromScale(0, -0.85) })
	end
	if not e.Mouth then
		local m = Instance.new("Part")
		m.Name = "MouthGlow"
		m.Shape = Enum.PartType.Ball
		m.Anchored = true
		m.CanCollide = false
		m.CanQuery = false
		m.CanTouch = false
		m.CastShadow = false
		m.Material = Enum.Material.Neon
		m.Color = MOUTH_GREEN
		m.Transparency = 1
		m.Size = Vector3.new(0.3, 0.3, 0.3)
		m.CFrame = CFrame.new(e.MouthPos)
		m.Parent = e.Model -- not in the pooled rig; hidden when culled, gone with the model
		e.Mouth = m
	end
end

function Ghosts.Start()
	local folder = workspace:WaitForChild("Ghosts")
	folder.ChildAdded:Connect(function(m)
		task.defer(add, m)
	end)
	for _, m in folder:GetChildren() do
		task.spawn(add, m)
	end
	State.OnFx("Poof", poof)
	RunService.RenderStepped:Connect(step)
end

return Ghosts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Hatchery</string>
              <string name="Source"><![CDATA[--!strict
-- PET HATCHERY egg panel (looks like the hunter crate panel). The world pedestals (server World/Hatchery) carry a
-- "View" ProximityPrompt with attribute Egg = egg id; triggering it opens this panel for that
-- egg: price, lock state, a grid of every possible pet with its rarity, bonus and EXACT odds, and a
-- BUY & HATCH button. The server ("BuyEgg") checks, rolls, charges and saves in one step;
-- each purchase carries a request id, and a failed/timed-out request is retried ONCE with the
-- SAME id, so a retry can never charge twice or roll again. The hatch plays as a crate-style
-- cinematic (Reveal.PlayPet) of the result the server already saved.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Eggs = require(GH.Logic.Eggs)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local PetPortrait = require(Client.UI.PetPortrait)
local PetsPanel = require(script.Parent.PetsPanel)
local Reveal = require(script.Parent.Reveal)

local Hatchery = {}

local SHARD = Color3.fromRGB(200, 160, 255)
local REQUEST_TIMEOUT = 12 -- seconds before a buy request counts as lost and is retried
-- errors worth one retry with the same request id (the server may or may not have hatched)
local RETRY_ERRORS: { [string]: boolean } = {
	["Connection hiccup, try again"] = true,
	["Slow down!"] = true,
	["Something went wrong"] = true,
	["One moment..."] = true,
	["Loading..."] = true,
}

local panel: Kit.Panel
local priceLabel: TextLabel
local lockLabel: TextLabel
local list: ScrollingFrame
local buyButton: TextButton
local reasonLabel: TextLabel
local currentEgg: string? = nil
local busy = false

local function countPets(d: any): number
	local n = 0
	for _ in d.Pets or {} do
		n += 1
	end
	return n
end

local function pct(chance: number): string
	return string.format("%g%%", chance)
end

-- Why the egg can't be bought right now (nil = it can).
local function blockReason(egg: Config.EggDef, d: any): string?
	if not Eggs.Unlocked(egg, d.TowerCheckpoint or 0) then
		return string.format("Locked: reach Boss Tower checkpoint %d", egg.Unlock)
	end
	if countPets(d) >= Config.PetRules.MaxOwned then
		return "Your pet room is full!"
	end
	if (d.Shards or 0) < egg.Price then
		return string.format("Needs %s more Spirit Shards (Boss Tower)", Format.Commas(egg.Price - (d.Shards or 0)))
	end
	return nil
end

-- One pet card, laid out like a CratePanel hunter card (rarity gradient, round picture).
local function petCard(order: number, pet: Config.PetDef, chance: number)
	local r = Config.Rarities[pet.Rarity]
	local card: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = list })
	Kit.Corner(card, UDim.new(0, 14))
	Kit.Stroke(card, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, if r then r.Color else Theme.Panel3, if r then r.Color2 else Theme.Panel, 90)
	local pic: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(80, 80),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = pet.Color:Lerp(Color3.new(0, 0, 0), 0.5),
		ZIndex = 63,
		Parent = card,
	})
	Kit.Corner(pic, UDim.new(1, 0))
	Kit.Stroke(pic, 3, pet.Glow, Enum.ApplyStrokeMode.Border)
	PetPortrait.New(pic, pet.Id)
	Kit.Label(card, string.upper(pet.Name), { Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 92), ZIndex = 64, Style = "Body", Fit = true })
	Kit.Label(card, r and r.Name or string.upper(pet.Rarity), { Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 113), ZIndex = 64, Color = Color3.fromRGB(255, 255, 240), Style = "Small", Fit = true })
	-- two short lines (a one-line "+25% POWER for all hunters" was cut to "+25% PO…" here)
	local bonus = string.gsub(PetsPanel.BonusText(pet.Bonus.Kind, pet.Bonus.Value), " for all hunters", "")
	Kit.Label(card, bonus, { Size = UDim2.new(0.6, -8, 0, 28), Position = UDim2.new(0, 8, 1, -32), ZIndex = 64, Color = Theme.Ecto, Align = Enum.TextXAlignment.Left, Style = "Tiny", Wrap = true })
	Kit.Label(card, pct(chance), { Size = UDim2.new(0.4, 0, 0, 24), Position = UDim2.new(1, -8, 1, -29), AnchorPoint = Vector2.new(1, 0), ZIndex = 64, Align = Enum.TextXAlignment.Right, Style = "Heading", Fit = true })
end

local function refresh()
	local d = State.Data
	local egg = currentEgg and Config.Eggs[currentEgg]
	if not d or not egg then
		return
	end
	panel.Title.Text = string.upper(egg.Name)
	Kit.IconText(priceLabel, string.format("🔮 %s  •  you have 🔮 %s", Format.Commas(egg.Price), Format.Short(d.Shards or 0)))
	if Eggs.Unlocked(egg, d.TowerCheckpoint or 0) then
		Kit.IconText(lockLabel, if egg.Unlock > 0 then string.format("UNLOCKED (Tower checkpoint %d)", egg.Unlock) else "Open to everyone")
		lockLabel.TextColor3 = Theme.Good
	else
		Kit.IconText(lockLabel, string.format("🔒 Unlock: Tower checkpoint %d (yours: %d)", egg.Unlock, d.TowerCheckpoint or 0))
		lockLabel.TextColor3 = Theme.Bad
	end
	local reason = blockReason(egg, d)
	buyButton:SetAttribute("Color", if reason then "Gray" else "Green")
	reasonLabel.Text = reason or "Odds are exact: every hatch is rolled by the server"
	reasonLabel.TextColor3 = if reason then Theme.Bad else Theme.Muted
end

local function fill(eggId: string)
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local egg = Config.Eggs[eggId]
	for i, o in egg.Odds do
		local pet = Config.Pets[o.Pet]
		if pet then
			petCard(i, pet, o.Chance)
		end
	end
end

-- Request with a timeout: a lost reply counts as a failure (the caller retries with the same id).
local function requestBuy(eggId: string, requestId: string): any
	local result: any = nil
	task.spawn(function()
		local r = State.Request("BuyEgg", eggId, requestId)
		if result == nil then
			result = r
		end
	end)
	local t0 = os.clock()
	while result == nil and os.clock() - t0 < REQUEST_TIMEOUT do
		task.wait(0.1)
	end
	if result == nil then
		result = { ok = false, err = "Connection hiccup, try again" }
	end
	return result
end

local hatch: (string?, boolean) -> ()
hatch = function(eggId: string?, fromAgain: boolean)
	local d = State.Data
	local egg = eggId and Config.Eggs[eggId]
	-- HATCH AGAIN runs while the reveal card is still up; the BUY button never does
	if busy or (not fromAgain and Reveal.IsPlaying()) or not eggId or not egg or not d then
		return
	end
	local reason = blockReason(egg, d)
	if reason then
		Kit.Toast(reason, "Bad")
		return
	end
	busy = true
	Kit.SetButtonText(buyButton, "HATCHING...")
	local requestId = HttpService:GenerateGUID(false)
	local res = requestBuy(eggId, requestId)
	if not res.ok and RETRY_ERRORS[tostring(res.err)] then
		task.wait(1.2)
		res = requestBuy(eggId, requestId) -- same id: the server returns the saved result if it already hatched
	end
	busy = false
	Kit.SetButtonText(buyButton, "🥚 BUY & HATCH")
	if not res.ok then
		local msg = res.err or "Can't do that right now"
		if RETRY_ERRORS[tostring(res.err)] then
			msg ..= " - if your shards went down, your pet is already in PETS"
		end
		Kit.Toast(msg, "Bad")
		return
	end
	local pet: Config.PetDef? = if type(res.Pet) == "string" then Config.Pets[res.Pet] else nil
	panel:Close()
	if pet then
		local id = eggId :: string
		Reveal.PlayPet({ Egg = id, Pet = pet.Id }, function()
			hatch(id, true)
		end)
	end
end

local function buy()
	hatch(currentEgg, false)
end

function Hatchery.Open(eggId: string)
	if not Config.Eggs[eggId] or Reveal.IsPlaying() then
		return
	end
	currentEgg = eggId
	fill(eggId)
	panel:Open()
	refresh()
end

function Hatchery.Init()
	panel = Kit.Panel("Hatchery", "PET HATCHERY", Vector2.new(700, 420), "Purple")
	local body = panel.Body
	priceLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 10), Color = SHARD, Style = "Currency", Fit = true, ZIndex = 62 })
	lockLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 40), Style = "Small", Fit = true, ZIndex = 62 })
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -146),
		Position = UDim2.fromOffset(0, 64),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = body,
	})
	-- cards wrap onto more rows (and scroll) when the panel is narrow (phones, portrait)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(148, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = list })
	reasonLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -72), Font = Theme.Body, Style = "Small", Fit = true, Stroke = 0, ZIndex = 62 })
	buyButton = Kit.Button(body, {
		Text = "🥚 BUY & HATCH",
		Color = "Gray",
		Size = UDim2.fromOffset(280, 50),
		Position = UDim2.new(0.5, 0, 1, -2),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			task.spawn(buy)
		end,
	})
	panel.Primary = buyButton
end

function Hatchery.Start()
	local player = Players.LocalPlayer
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= player or Reveal.IsPlaying() then
			return
		end
		local eggId = prompt:GetAttribute("Egg")
		if eggId == nil and prompt.Parent then
			eggId = prompt.Parent:GetAttribute("Egg")
		end
		if type(eggId) == "string" then
			Hatchery.Open(eggId)
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return Hatchery
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD, kept compact so the screen stays free for seeing and tapping ghosts:
-- Ectoplasm counter, crew power, active boosts, menu buttons (one column on big screens,
-- a 2-column block in the top-left on phones, clear of the thumbstick), settings, the
-- AUTO ATTACK toggle (pass owners only), toasts, announcements and zone banners.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local Hud = {}

local player = Players.LocalPlayer
local openers: { [string]: () -> () } = {}
Hud.Buttons = {} :: { [string]: TextButton }

local ectoLabel: TextLabel
local ectoPill: Frame
local powerLabel: TextLabel
local powerPrefix = "⚡ "
local boostHolder: Frame
local shardLabel: TextLabel
local tradeButton: TextButton
local dailyBadge: Frame
local autoButton: TextButton
local shownEcto = 0
local targetEcto = 0
local bannerLabel: TextLabel
local bannerSub: TextLabel
local announceFrame: Frame
local announceToken = 0

function Hud.RegisterPanel(name: string, open: () -> ())
	openers[name] = open
end

function Hud.Open(name: string)
	local fn = openers[name]
	if fn then
		fn()
	end
end

-- Pulsing ring on a menu button (tutorial).
local pulses: { [string]: Frame } = {}
function Hud.Pulse(name: string, on: boolean)
	local b = Hud.Buttons[name]
	if not b then
		return
	end
	if on and not pulses[name] then
		local ring: Frame = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = b,
		})
		Kit.Corner(ring, UDim.new(0, 14))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		pulses[name] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.fromScale(1.35, 1.35) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and pulses[name] then
		pulses[name]:Destroy()
		pulses[name] = nil
	end
end

local function floatText(text: string, color: Color3)
	local l = Kit.Label(Kit.Overlay(), text, {
		Size = UDim2.fromOffset(160, 24),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = color,
		Style = "Heading",
		ZIndex = 80,
	})
	Kit.Tween(l, 0.8, { Position = UDim2.new(0.5, 0, 0, 40), TextTransparency = 1 })
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		Kit.Tween(st, 0.8, { Transparency = 1 })
	end
	task.delay(0.85, function()
		l:Destroy()
	end)
end

local function buildTop(screen: ScreenGui)
	-- Ectoplasm + power + Spirit Shards: three same-size pills side by side, centred in the top bar row
	local PILL_W = 160
	local top = Kit.TopBar()
	local row: Frame = Kit.new("Frame", {
		Name = "Counters",
		Size = UDim2.fromOffset(PILL_W * 3 + 14 * 2, 40),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = top,
	})
	ectoPill = Kit.new("Frame", {
		Name = "Ecto",
		Size = UDim2.fromOffset(PILL_W, 40),
		Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	Kit.Corner(ectoPill, UDim.new(1, 0))
	Kit.Stroke(ectoPill, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ectoPill, Theme.Panel2, Theme.Bg, 90)
	Kit.new("UIScale", { Parent = ectoPill })
	local orb: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, -12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = ectoPill,
	})
	Kit.Corner(orb, UDim.new(1, 0))
	Kit.Stroke(orb, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(orb, Theme.Ecto, Theme.Ecto2, 135)
	local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.3, 0.24), Position = UDim2.fromScale(0.26, 0.2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3, ZIndex = 4, Parent = orb })
	Kit.Corner(shine, UDim.new(1, 0))
	if Icons.Get("ecto") then
		-- uploaded Ectoplasm icon replaces the drawn orb
		orb.BackgroundTransparency = 1
		shine.Visible = false
		local st = orb:FindFirstChildOfClass("UIStroke")
		if st then
			st.Enabled = false
		end
		local g = orb:FindFirstChildOfClass("UIGradient")
		if g then
			g.Enabled = false
		end
		Kit.Icon(orb, "ecto", "💚", { Size = UDim2.fromScale(1.15, 1.15), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 })
	end
	ectoLabel = Kit.Label(ectoPill, "0", { Size = UDim2.new(1, -46, 1, 0), Position = UDim2.fromOffset(40, 0), Color = Theme.Ecto, Style = "Currency", Fit = true })
	-- crew power
	local power: Frame = Kit.new("Frame", {
		Name = "Power",
		Size = UDim2.fromOffset(PILL_W, 40),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	Kit.Corner(power, UDim.new(1, 0))
	Kit.Stroke(power, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(power, Theme.Panel2, Theme.Bg, 90)
	Kit.Icon(power, "power", "⚡", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, -12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Style = "Icon", TextSize = 30, Stroke = 0, ZIndex = 4 })
	powerPrefix = ""
	powerLabel = Kit.Label(power, "0 POWER", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(42, 0), Color = Theme.Gold, Style = "Heading", Fit = true })
	-- Spirit Shards (Hud.ShardsPill: target for shard fly-in effects)
	local shards: Frame = Kit.new("Frame", {
		Name = "Shards",
		Size = UDim2.fromOffset(PILL_W, 40),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	Kit.Corner(shards, UDim.new(1, 0))
	Kit.Stroke(shards, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(shards, Theme.Panel2, Theme.Bg, 90)
	Kit.new("UIScale", { Parent = shards })
	Kit.Icon(shards, "shards", "🔮", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, -12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Style = "Icon", TextSize = 30, Stroke = 0, ZIndex = 4 })
	shardLabel = Kit.Label(shards, "0", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(42, 0), Color = Color3.fromRGB(200, 160, 255), Style = "Currency", Fit = true })
	Hud.ShardsPill = shards
	Hud.Counters = { Ecto = ectoPill, Power = power, Shards = shards } -- menu tour targets
	-- boosts (only while active)
	-- directly under the counters: next-area progress bar (Tutorial), boss event bar (Boss) and
	-- active boosts, stacked so they never overlap and never sit in the middle of the play area
	local stack: Frame = Kit.new("Frame", {
		Name = "TopStack",
		Size = UDim2.fromOffset(440, 220),
		Position = UDim2.new(0.5, 0, 0, 52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = top,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 5), FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = stack })
	Hud.TopStack = stack
	local _ = screen
	boostHolder = Kit.new("Frame", {
		Size = UDim2.fromOffset(340, 22),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Visible = false,
		Parent = stack,
	})
	-- 3+ active boosts wrap onto a second row instead of spilling past the stack's sides
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), Wraps = true, Parent = boostHolder })
end

-- HUD layout
--   LEFT  (vertical): HUNTERS, INDEX, WORLDS, PETS (PETS appears once Boss Tower/shards start)
--   RIGHT (vertical, bottom-anchored stack): UPGRADES, SHOP, DAILY, then the free AUTO ATTACK
--   toggle, then the lower-right row: [DEV] [TRADE] FEEDBACK SETTINGS. On touch screens the stack sits
--   above the Roblox jump button; on desktop the left column starts under the chat window.
local MENU_LEFT = {
	{ Name = "Hunters", Icon = "🔦", Text = "HUNTERS", Color = "Orange" },
	{ Name = "Index", Icon = "📖", Text = "INDEX", Color = "Blue" },
	{ Name = "Worlds", Icon = "🌍", Text = "WORLDS", Color = "Teal" },
	{ Name = "Pets", Icon = "🐾", Text = "PETS", Color = "Purple" },
}
local MENU_RIGHT = {
	{ Name = "Upgrades", Icon = "🧲", Text = "UPGRADES", Color = "Green" },
	{ Name = "Shop", Icon = "🛒", Text = "SHOP", Color = "Pink" },
	{ Name = "Daily", Icon = "🎁", Text = "DAILY", Color = "Purple" },
}
local CELL_MAX = 84
local GAP = 6
local SMALL = 44 -- settings / feedback / trade / dev buttons
local ROW_W = SMALL * 4 + GAP * 3
local AUTO_W, AUTO_H = 132, 40

local menu: Frame -- left column
local menuScale: UIScale
Hud.TopStack = nil :: Frame?
Hud.ShardsPill = nil :: Frame?
Hud.Counters = {} :: { [string]: Frame }
local rightStack: Frame
local rightScale: UIScale
local lowerRow: Frame
Hud.LowerRow = nil :: Frame? -- other controllers (DEV button) add small buttons here
Hud.RightStack = nil :: Frame?
local chatBottomCache = 0

local function touchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Desktop only: bottom of the Roblox chat window (logical px below our inset), read once after
-- joining and on resizes, so the left column starts under it. Phones keep chat collapsed
-- behind its top-bar button (following it live made the menu jump around).
local function readChatBottom()
	chatBottomCache = 0
	if touchOnly() then
		return
	end
	pcall(function()
		local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if cfg and cfg.Enabled then
			local pos = (cfg :: any).AbsolutePosition :: Vector2
			local size = (cfg :: any).AbsoluteSize :: Vector2
			local inset = Kit.Screen().AbsolutePosition.Y
			chatBottomCache = math.max(0, (pos.Y + size.Y - inset) / Kit.UIScale())
		end
	end)
end

-- Room to keep free above the bottom edge on the right (the touch jump button), logical px,
-- plus MENU_LIFT so both menu columns sit a little higher (the fit scaling still shrinks them).
local MENU_LIFT = 90 -- owner: a bit higher again (was 40)
local function bottomReserve(): number
	if not touchOnly() then
		return 10 + MENU_LIFT
	end
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local small = math.min(vp.X, vp.Y) < 500 -- Roblox uses the small jump button below 500 px
	local physical = if small then 100 else 225
	return physical / Kit.UIScale() + MENU_LIFT
end

local function columnHeight(n: number): number
	return CELL_MAX * n + GAP * (n - 1)
end

local function layoutMenu()
	local logical = Kit.LogicalSize()
	-- right stack (anchored bottom-right, above the jump button on touch screens)
	local reserve = bottomReserve()
	local rightH = columnHeight(#MENU_RIGHT) + GAP * 2 + AUTO_H + GAP * 2 + SMALL
	local rightW = math.max(CELL_MAX, AUTO_W, ROW_W)
	local rfit = math.clamp((logical.Y - reserve - 8) / rightH, 0.5, 1)
	rightScale.Scale = rfit
	rightStack.Size = UDim2.fromOffset(rightW, rightH)
	rightStack.Position = UDim2.new(1, -8, 1, -reserve)
	rightStack.AnchorPoint = Vector2.new(1, 1)
	-- left column: same button size as the right, top lined up with the right column's top
	-- (desktop: never above the bottom of the chat window)
	local rightTop = logical.Y - reserve - rightH * rfit
	local top = math.max(4, rightTop, if chatBottomCache > 0 then chatBottomCache + 8 else 0)
	local full = columnHeight(#MENU_LEFT)
	menuScale.Scale = math.min(rfit, math.clamp((logical.Y - top - 10) / full, 0.5, 1))
	menu.Size = UDim2.fromOffset(CELL_MAX, full)
	menu.Position = UDim2.fromOffset(8, top)
	menu.AnchorPoint = Vector2.zero
end

local function menuButton(parent: Instance, i: number, m: any): TextButton
	local b = Kit.Button(parent, {
		Text = "",
		Color = m.Color,
		OnClick = function()
			Hud.Open(m.Name)
		end,
	})
	b.LayoutOrder = i
	b.Size = UDim2.fromOffset(CELL_MAX, CELL_MAX)
	Kit.Icon(b, "menu_" .. string.lower(m.Name), m.Icon, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 7), Style = "Icon", TextSize = 36, Stroke = 0, ZIndex = 3 })
	Kit.Label(b, m.Text, { Size = UDim2.new(1, -4, 0, 19), Position = UDim2.new(0, 2, 1, -25), Style = "Tiny", TextSize = 14, Fit = true, ZIndex = 3 })
	Hud.Buttons[m.Name] = b
	return b
end

local function buildMenu(screen: ScreenGui)
	-- LEFT column
	menu = Kit.new("Frame", { Name = "Menu", BackgroundTransparency = 1, Parent = screen })
	menuScale = Kit.new("UIScale", { Parent = menu })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	for i, m in MENU_LEFT do
		menuButton(menu, i, m)
	end
	-- RIGHT stack
	rightStack = Kit.new("Frame", { Name = "RightMenu", BackgroundTransparency = 1, Parent = screen })
	rightScale = Kit.new("UIScale", { Parent = rightStack })
	Kit.new("UIListLayout", {
		Padding = UDim.new(0, GAP * 2),
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = rightStack,
	})
	local col: Frame = Kit.new("Frame", { Name = "Column", BackgroundTransparency = 1, Size = UDim2.fromOffset(CELL_MAX, columnHeight(#MENU_RIGHT)), LayoutOrder = 1, Parent = rightStack })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
	for i, m in MENU_RIGHT do
		menuButton(col, i, m)
	end
	lowerRow = Kit.new("Frame", { Name = "LowerRow", BackgroundTransparency = 1, Size = UDim2.fromOffset(ROW_W, SMALL), LayoutOrder = 3, Parent = rightStack })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder, Parent = lowerRow })
	Hud.LowerRow = lowerRow
	Hud.RightStack = rightStack
	-- red "!" on DAILY when a reward is waiting
	dailyBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, 5, 0, -5),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Bad,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Daily,
	})
	Kit.Corner(dailyBadge, UDim.new(1, 0))
	Kit.Stroke(dailyBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(dailyBadge, "!", { Style = "Small", ZIndex = 11 })
	layoutMenu()
	-- desktop: start under the chat window (read after it has appeared; again on resizes)
	task.delay(3, function()
		readChatBottom()
		layoutMenu()
	end)
	Kit.ScaleChanged:Connect(function()
		readChatBottom()
		layoutMenu()
	end)
end

-- Settings panel (gear, top right)
local function buildSettings(screen: ScreenGui)
	local panel = Kit.Panel("Settings", "SETTINGS", Vector2.new(400, 460), "Gray")
	local list: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel.Body, ZIndex = 61 })
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = list })
	local toggles = {
		{ Key = "Music", Text = "MUSIC" },
		{ Key = "Sfx", Text = "SOUND EFFECTS" },
		{ Key = "FastReveal", Text = "FAST CRATE OPENING" },
		{ Key = "Names", Text = "HUNTER & PET NAMES" },
	}
	local buttons: { [string]: TextButton } = {}
	for _, t in toggles do
		local b = Kit.Button(list, {
			Text = t.Text,
			Color = "Green",
			Size = UDim2.fromOffset(320, 44),
			ZIndex = 62,
			OnClick = function()
				local d = State.Data
				if not d then
					return
				end
				local res = State.Request("Setting", t.Key, not d.Settings[t.Key])
				if not res.ok then
					Kit.Toast(res.err or "Couldn't change that", "Bad")
				end
			end,
		})
		buttons[t.Key] = b
	end
	Kit.Button(list, {
		Text = "💬 SEND FEEDBACK / REPORT A BUG",
		Color = "Blue",
		Size = UDim2.fromOffset(320, 44),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			panel:Close()
			Hud.Open("Feedback")
		end,
	})
	Kit.Button(list, {
		Text = "📖 MENU TOUR",
		Color = "Purple",
		Size = UDim2.fromOffset(320, 44),
		ZIndex = 62,
		OnClick = function()
			panel:Close()
			Hud.Open("MenuTour") -- registered by MenuTour
		end,
	})
	State.OnData(function(d)
		-- names over hunters and pets: Crew / PetFollowers read this attribute for new tags
		local namesOn = d.Settings.Names ~= false
		local me = game:GetService("Players").LocalPlayer
		if me:GetAttribute("ShowNames") ~= namesOn then
			me:SetAttribute("ShowNames", namesOn)
			for _, g in workspace:GetDescendants() do
				if g:IsA("BillboardGui") and (g.Name == "Tag" or g.Name == "PetTag") then
					g.Enabled = namesOn
				end
			end
		end
		for _, t in toggles do
			local on = d.Settings[t.Key] == true
			local b = buttons[t.Key]
			b:SetAttribute("Color", if on then "Green" else "Gray")
			Kit.SetButtonText(b, t.Text .. (if on then ": ON" else ": OFF"))
			if t.Key == "FastReveal" then
				-- fast crate opening is part of the Permanent Crate Skip pass
				b.Visible = d.Passes ~= nil and d.Passes[Config.CrateSkip.Pass] == true
			end
		end
	end)
	Hud.RegisterPanel("Settings", function()
		panel:Toggle()
	end)
	-- lower-right row: [TRADE] FEEDBACK SETTINGS (the DEV button, for developers, goes first)
	local _ = screen
	tradeButton = Kit.Button(lowerRow, {
		Text = "",
		Color = "Teal",
		Size = UDim2.fromOffset(SMALL, SMALL),
		TextStyle = "Heading",
		OnClick = function()
			Hud.Open("Trade")
		end,
	})
	Kit.Icon(tradeButton, "menu_trade", "🤝", { Size = UDim2.fromScale(0.85, 0.85), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Heading", Stroke = 0, ZIndex = 3 })
	tradeButton.LayoutOrder = 2
	tradeButton.Visible = false
	Hud.Buttons.Trade = tradeButton
	local feedback = Kit.Button(lowerRow, {
		Text = "💬",
		Color = "Blue",
		Size = UDim2.fromOffset(SMALL, SMALL),
		TextStyle = "Heading",
		OnClick = function()
			Hud.Open("Feedback")
		end,
	})
	feedback.LayoutOrder = 3
	Hud.Buttons.Feedback = feedback
	local gear = Kit.Button(lowerRow, {
		Text = "",
		Color = "Gray",
		Size = UDim2.fromOffset(SMALL, SMALL),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	gear.LayoutOrder = 4
	Hud.Buttons.Settings = gear
	Kit.Icon(gear, "menu_settings", "⚙", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Heading", Stroke = 0, ZIndex = 3 })
end

-- AUTO ATTACK toggle: FREE for every player (no pass, no Robux).
local busyAuto = false
local function refreshAuto()
	autoButton.Visible = true -- Auto Attack is free for everyone
	local on = player:GetAttribute("AutoAttack") == true
	Kit.SetButtonText(autoButton, if on then "🤖 AUTO: ON" else "🤖 AUTO: OFF")
	autoButton:SetAttribute("Color", if on then "Green" else "Gray")
end

local function buildAuto(screen: ScreenGui)
	autoButton = Kit.Button(rightStack, {
		Text = "🤖 AUTO: OFF",
		Color = "Gray",
		Size = UDim2.fromOffset(AUTO_W, AUTO_H),
		TextStyle = "Small",
		OnClick = function()
			if busyAuto then
				return
			end
			busyAuto = true
			local on = player:GetAttribute("AutoAttack") == true
			local res = State.Request("AutoAttack", not on)
			busyAuto = false
			if not res.ok then
				Kit.Toast(res.err or "Couldn't switch Auto Attack", "Bad")
			else
				Kit.Toast(if res.On then "AUTO ATTACK ON: your crew picks nearby ghosts" else "AUTO ATTACK OFF: tap a ghost to attack", "Good")
			end
		end,
	})
	autoButton.Name = "AutoAttack"
	autoButton.LayoutOrder = 2
	autoButton.Visible = false
	player:GetAttributeChangedSignal("AutoAttack"):Connect(refreshAuto)
	State.OnData(function()
		refreshAuto()
	end)
end

local function buildBanners()
	local overlay = Kit.Overlay()
	bannerLabel = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(640, 48),
		Position = UDim2.fromScale(0.5, 0.27),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Ecto,
		Style = "Banner",
		Fit = true,
		ZIndex = 70,
	})
	bannerLabel.TextTransparency = 1
	bannerSub = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(560, 24),
		Position = UDim2.new(0.5, 0, 0.27, 30),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Theme.Text,
		Style = "Body",
		Fit = true,
		ZIndex = 70,
	})
	bannerSub.TextTransparency = 1
	announceFrame = Kit.new("Frame", {
		Size = UDim2.fromOffset(500, 36),
		Position = UDim2.new(0.5, 0, 0, -60),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		-- on the HUD screen, below panels (ZIndex 60): an announcement must never cover an open
		-- popup's title (it used to sit on the overlay, above every panel)
		ZIndex = 58,
		Parent = Kit.Screen(),
	})
	Kit.Corner(announceFrame, UDim.new(0, 12))
	Kit.Stroke(announceFrame, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(announceFrame, Theme.Gold, Color3.fromRGB(255, 120, 40), 0)
	local l = Kit.Label(announceFrame, "", { Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(10, 0), Style = "Body", Fit = true, ZIndex = 76 })
	l.Name = "Text"
	-- ✕ (or tapping the bar anywhere) dismisses the announcement right away
	local function dismiss()
		announceToken += 1
		local my = announceToken
		Kit.Tween(announceFrame, 0.2, { Position = UDim2.new(0.5, 0, 0, -60) })
		task.delay(0.2, function()
			if announceToken == my then
				announceFrame.Visible = false
			end
		end)
	end
	local tap: TextButton = Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 77, Parent = announceFrame })
	tap.Activated:Connect(dismiss)
	Kit.CloseButton(announceFrame, dismiss, 79)
end

local bannerToken = 0
-- Centre-screen title (zone names, NEW AREA UNLOCKED!). The one place for big text.
function Hud.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	bannerLabel.Text = title
	bannerLabel.TextColor3 = color or Theme.Ecto
	Kit.IconText(bannerSub, sub or "") -- 💚 / 🔮 / ⚡ ... as their uploaded images
	local subIcons: { ImageLabel } = {}
	for _, c in bannerSub:GetChildren() do
		if c:IsA("ImageLabel") and c.Visible then
			table.insert(subIcons, c)
			c.ImageTransparency = 1
			Kit.Tween(c, 0.3, { ImageTransparency = 0 })
		end
	end
	local s1 = bannerLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
	local s2 = bannerSub:FindFirstChildOfClass("UIStroke") :: UIStroke
	bannerLabel.TextTransparency = 1
	bannerSub.TextTransparency = 1
	s1.Transparency = 1
	s2.Transparency = 1
	local sc = bannerLabel:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = bannerLabel })
	sc.Scale = 0.6
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.Tween(bannerLabel, 0.3, { TextTransparency = 0 })
	Kit.Tween(s1, 0.3, { Transparency = 0 })
	Kit.Tween(bannerSub, 0.3, { TextTransparency = 0 })
	Kit.Tween(s2, 0.3, { Transparency = 0 })
	task.delay(2.4, function()
		if bannerToken ~= my then
			return
		end
		Kit.Tween(bannerLabel, 0.45, { TextTransparency = 1 })
		Kit.Tween(s1, 0.45, { Transparency = 1 })
		Kit.Tween(bannerSub, 0.45, { TextTransparency = 1 })
		Kit.Tween(s2, 0.45, { Transparency = 1 })
		for _, c in subIcons do
			Kit.Tween(c, 0.45, { ImageTransparency = 1 })
		end
	end)
end

-- Sliding top announcement (legendary hatches, boss events).
function Hud.Announce(text: string, c1: Color3?, c2: Color3?)
	announceToken += 1
	local my = announceToken
	local l = announceFrame:FindFirstChild("Text") :: TextLabel
	l.Text = text
	local g = announceFrame:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(c1 or Theme.Gold, c2 or Color3.fromRGB(255, 120, 40))
	-- below the boss bar / goal chip so event warnings never stack on top of each other
	announceFrame.Visible = true
	Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, 100) }, Enum.EasingStyle.Back)
	task.delay(4, function()
		if announceToken == my then
			Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, -60) })
			task.wait(0.3)
			if announceToken == my then
				announceFrame.Visible = false -- parked off-screen must not peek under the top bar
			end
		end
	end)
end

local boostLabels: { [string]: TextLabel } = {}
local function refreshBoosts()
	local d = State.Data
	if not d then
		return
	end
	local now = State.Now()
	local chips: { [string]: any } = {}
	for id, def in Config.Boosts :: any do
		if type(def) == "table" then
			chips[id] = { Icon = def.Icon, Name = def.Name, Expiry = d.Boosts[id] }
		end
	end
	-- server-wide luck someone bought (Robux): everyone sees it
	chips.ServerLuck = { Icon = "🍀", Name = "SERVER LUCK", Expiry = d.ServerLuckUntil }
	-- global 2X Ectoplasm event (developer-controlled; a countdown when it was started for a set time)
	local ends = workspace:GetAttribute("Ecto2xEnds")
	local timed = type(ends) == "number" and ends > 0
	chips.Ecto2x = {
		Icon = "💚",
		Name = "2X ECTOPLASM",
		Expiry = if workspace:GetAttribute("Ecto2x") ~= true then 0 elseif timed then ends else now + 1e9,
		NoTimer = not timed,
	}
	for id, def in chips do
		local expiry = def.Expiry
		local left = if expiry then expiry - now else 0
		local l = boostLabels[id]
		if left > 0 then
			if not l then
				local f: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Theme.Panel2, BackgroundTransparency = 0.1, Parent = boostHolder })
				Kit.Corner(f, UDim.new(1, 0))
				l = Kit.Label(f, "", { Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0), Color = Theme.Ecto, Style = "Tiny", Fit = true })
				boostLabels[id] = l
			end
			Kit.EctoText(l :: TextLabel, def.Icon .. " " .. def.Name .. (if def.NoTimer then "" else " " .. Format.Time(left)))
		elseif l then
			(l.Parent :: Instance):Destroy()
			boostLabels[id] = nil
		end
	end
	boostHolder.Visible = next(boostLabels) ~= nil
	local info = d.DailyInfo
	if info then
		local canClaim = info.CanClaim or info.Wait - (now - (d.ServerTime or now)) <= 0
		dailyBadge.Visible = canClaim
	end
end

local seeded = false
local function onData(d: any)
	powerLabel.Text = powerPrefix .. Format.Short(d.CrewPower or 0) .. " POWER"
	targetEcto = d.Ecto
	if not seeded then
		-- first snapshot: show the balance as-is (no count-up from 0 on every join)
		seeded = true
		shownEcto = d.Ecto
		ectoLabel.Text = Format.Short(d.Ecto)
	end
	refreshBoosts()
	-- gradual reveal: PETS once the Boss Tower/shards start, TRADE once the player has 5+ hunters
	local shards = d.Shards or 0
	Hud.Buttons.Pets.Visible = shards > 0 or (d.Pets ~= nil and next(d.Pets) ~= nil) or (d.TowerRuns or 0) > 0
	tradeButton.Visible = false -- trading opens from the TRADING booth only (no request spam)
	shardLabel.Text = Format.Short(shards)
end

local lastZone = 0
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

function Hud.Init()
	local screen = Kit.Screen()
	Kit.SetSound(function(name)
		Sound.Play(name)
	end)
	buildTop(screen)
	buildMenu(screen)
	buildSettings(screen)
	buildAuto(screen)
	buildBanners()
	Hud.Buttons.Pets.Visible = false
	-- world kiosks open their panels (always, even before the menu buttons are revealed)
	local KIOSK_PANELS: { [string]: string } = { Trade = if Config.Trade.Enabled then "Trade" else nil, Pets = "Pets", Merge = "Hunters" } :: any
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local parent = prompt.Parent
		local name = parent and KIOSK_PANELS[tostring(parent:GetAttribute("Kiosk"))]
		if name then
			Hud.Open(name)
		end
	end)
	-- TopStack lives in the top-bar ScreenGui (drawn above the HUD screen), so hide it while a
	-- panel is open (it would cover the panel's title) or the HUD is hidden (crate reveal)
	local stack = Hud.TopStack
	if stack then
		local function syncStack()
			stack.Visible = screen.Enabled and Kit.CurrentPanel() == nil
		end
		screen:GetPropertyChangedSignal("Enabled"):Connect(syncStack)
		Kit.PanelOpened:Connect(function()
			task.defer(syncStack)
		end)
	end
end

-- [VIP] chat tag for VIP pass owners (the server sets the player's "VIP" attribute)
local function hookVipChat()
	pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage)
			local props = Instance.new("TextChatMessageProperties")
			local src = message.TextSource
			local who = src and Players:GetPlayerByUserId(src.UserId)
			if who and who:GetAttribute("VIP") == true then
				props.PrefixText = '<font color="#FFD24A">[VIP]</font> ' .. message.PrefixText
			end
			return props
		end
	end)
end

function Hud.Start()
	hookVipChat()
	State.OnData(onData)
	State.EctoChanged:Connect(function(new: number, old: number)
		targetEcto = new
		if new > old then
			floatText("+" .. Format.Short(new - old), Theme.Ecto)
			local sc = ectoPill:FindFirstChildOfClass("UIScale") :: UIScale
			sc.Scale = 1.1
			Kit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
	-- smooth count-up
	RunService.RenderStepped:Connect(function(dt: number)
		if shownEcto ~= targetEcto then
			local diff = targetEcto - shownEcto
			local step = diff * math.min(1, dt * 10)
			if math.abs(diff) < 1 or math.abs(step) < 1 then
				shownEcto = targetEcto
			else
				shownEcto += step
			end
			ectoLabel.Text = Format.Short(math.floor(shownEcto + 0.5))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshBoosts()
			-- zone banner when walking into a different zone
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
				if idx ~= lastZone then
					if lastZone ~= 0 then
						local z = Config.Zones[idx]
						Hud.Banner(z.Name, nil, z.Accent)
					end
					lastZone = idx
				end
			end
		end
	end)
	State.OnFx("Toast", function(data: any)
		Kit.Toast(data.Text, data.Color)
	end)
	State.OnFx("Announce", function(data: any)
		local r = Config.Rarities[data.Color]
		Hud.Announce(data.Text, r and r.Color, r and r.Color2)
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">HuntersPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTERS inventory: grid of cards (portrait, name, rarity, Capture Power, equipped/locked
-- badges), an inspect pane with a 3D preview, EQUIP / UNEQUIP / EQUIP BEST / LOCK / RELEASE,
-- sort by power or rarity, a release mode with "select weak" for clearing storage, and a merge
-- mode (5 identical hunters -> 1 of the next tier). Knocked hunters show a recovery countdown.
-- Cards are cached per hunter uid, so data updates only touch what changed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Client = script.Parent.Parent
local State = require(Client.State)

-- max HP of a hunter with this power (incl. the equipped pets' HP bonus), as the server counts it
local function hpFor(power: number): number
	local d = State.Data
	local bonus = if d and d.PetBonuses then tonumber(d.PetBonuses.HP) or 0 else 0
	return Rules.HunterMaxHP(power, Config.Retaliation.HPPerPower, bonus)
end

local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)

local HuntersPanel = {}

type Card = {
	Frame: TextButton,
	Equip: Frame,
	Lock: GuiObject,
	Select: Frame,
	SelectLabel: TextLabel,
	Knock: Frame,
	KnockLabel: TextLabel,
}

local panel: Kit.Panel
local grid: ScrollingFrame
local cards: { [string]: Card } = {}
local equippedLabel: TextLabel
local powerLabel: TextLabel
local storageLabel: TextLabel
local sortButton: TextButton
local releaseButton: TextButton
local mergeButton: TextButton
local equipBestButton: TextButton
local top: Frame
local actionsRow: Frame
local side: Frame
-- inspect pane
local inspect: ScrollingFrame
local viewHolder: Frame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local rarityRibbon: Frame
local statLabel: TextLabel
local blurbLabel: TextLabel
local equipButton: TextButton
local lockButton: TextButton
local relOneButton: TextButton
local emptyHint: TextLabel
-- release mode
local releaseBar: Frame
local releaseConfirm: TextButton
local releaseMode = false
-- merge mode
local mergeBar: Frame
local mergeInfo: TextLabel
local mergeConfirm: TextButton
local mergeMode = false
local pickId: string? = nil
local pickTier = 0
local selected: { [string]: boolean } = {}
local inspectUid: string? = nil
local sortMode = "Power"
local spinModel: Model? = nil
local spinConn: RBXScriptConnection? = nil

local function tierOf(h: any): Config.TierDef
	return Config.Tiers[h.Tier or 0] or Config.Tiers[0]
end

-- tiered Capture Power of one owned hunter record
local function powerOf(h: any): number
	local def = Config.Hunters[h.Id]
	return if def then def.Power * tierOf(h).Mult else 0
end

local function knockLeft(d: any, uid: string): number
	return ((d.Knocked and d.Knocked[uid]) or 0) - State.Now()
end

local function rarityOf(id: string): Config.RarityDef
	return Config.Rarities[Config.Hunters[id].Rarity]
end

local function cratePrice(id: string): number
	local def = Config.Hunters[id]
	local zone = Config.ZoneById[def.Zone]
	local crate = zone and Config.Crates[zone.Crate]
	return if crate then crate.Price else 0
end

-- What releasing gives back, as HunterService's releaseRefund: nothing for NoRefund hunters
-- (traded / dev-granted), otherwise a share of the crate price scaled by the tier.
local function hunterRefund(h: any): number
	if h.NoRefund then
		return 0
	end
	return math.floor(cratePrice(h.Id) * Config.Inventory.ReleaseRefund * tierOf(h).Mult)
end

local function sortedUids(d: any): { string }
	local uids = {}
	for uid in d.Hunters do
		table.insert(uids, uid)
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	table.sort(uids, function(a, b)
		if eq[a] ~= eq[b] then
			return eq[a] == true
		end
		local ha, hb = d.Hunters[a].Id, d.Hunters[b].Id
		local pa, pb = powerOf(d.Hunters[a]), powerOf(d.Hunters[b])
		local ra, rb = rarityOf(ha).Order, rarityOf(hb).Order
		if sortMode == "Rarity" and ra ~= rb then
			return ra > rb
		end
		if pa ~= pb then
			return pa > pb
		end
		if ra ~= rb then
			return ra > rb
		end
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	return uids
end

local previewUid: string? = nil
local rebuild: () -> ()

local function clearPreview()
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in viewHolder:GetChildren() do
		if c:IsA("ViewportFrame") then
			c:Destroy()
		end
	end
	spinModel = nil
	previewUid = nil
end

local function setInspect(uid: string?)
	inspectUid = uid
	local d = State.Data
	local h = uid and d and d.Hunters[uid]
	inspect.Visible = h ~= nil and not releaseMode and not mergeMode
	emptyHint.Visible = not inspect.Visible and not releaseMode and not mergeMode
	if not h or not d or not uid then
		clearPreview()
		return
	end
	local def = Config.Hunters[h.Id]
	local rar = rarityOf(h.Id)
	-- the 3D preview is only rebuilt when you pick a different hunter (not on every update)
	if previewUid ~= uid then
		clearPreview()
		previewUid = uid
		local _, model = Portrait.Viewport(viewHolder, h.Id, false, h.Tier or 0)
		spinModel = model
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				if spinModel then
					spinModel:PivotTo(CFrame.Angles(0, math.sin((os.clock() - t0) * 0.8) * 0.6, 0))
				end
			end)
		end
	end
	local tier = tierOf(h)
	nameLabel.Text = (if (h.Tier or 0) > 0 then tier.Icon .. " " .. tier.Name .. " " else "") .. string.upper(def.Name)
	nameLabel.TextColor3 = tier.Color
	rarityLabel.Text = rar.Name
	local g = rarityRibbon:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(rar.Color, rar.Color2)
	Kit.IconText(statLabel, "⚡ " .. Format.Short(powerOf(h)) .. " POWER  ·  ❤️ " .. Format.Short(hpFor(powerOf(h))) .. " HP")
	blurbLabel.Text = def.Blurb
	local isEq = table.find(d.Equipped, uid) ~= nil
	Kit.SetButtonText(equipButton, if isEq then "UNEQUIP" else "EQUIP")
	equipButton:SetAttribute("Color", if isEq then "Red" else "Green")
	Kit.SetButtonText(lockButton, if h.Locked then "🔓 UNLOCK" else "🔒 LOCK")
	relOneButton.Visible = not isEq and not h.Locked
	Kit.SetButtonText(relOneButton, "RELEASE +💚" .. Format.Short(hunterRefund(h)))
end

local function updateReleaseBar()
	local d = State.Data
	local n, refund = 0, 0
	if d then
		for uid in selected do
			local h = d.Hunters[uid]
			if h then
				n += 1
				refund += hunterRefund(h)
			else
				selected[uid] = nil
			end
		end
	end
	Kit.SetButtonText(releaseConfirm, "RELEASE " .. n .. "  (+💚" .. Format.Short(refund) .. ")")
	releaseConfirm:SetAttribute("Color", if n > 0 then "Red" else "Gray")
end

-- The 5 copies a merge of (pickId, pickTier) would use: unlocked, not knocked, unequipped and
-- oldest first. Returns the picks and how many usable copies exist.
local function mergePicks(d: any): ({ string }, number)
	local list = {}
	for uid, h in d.Hunters do
		if h.Id == pickId and (h.Tier or 0) == pickTier and not h.Locked and knockLeft(d, uid) <= 0 then
			table.insert(list, uid)
		end
	end
	table.sort(list, function(a, b)
		local ea, eb = table.find(d.Equipped, a) ~= nil, table.find(d.Equipped, b) ~= nil
		if ea ~= eb then
			return eb
		end
		return (d.Hunters[a].T or 0) < (d.Hunters[b].T or 0)
	end)
	local n = #list
	while #list > Config.Merge.Count do
		table.remove(list)
	end
	return list, n
end

local function updateMergeBar()
	local d = State.Data
	table.clear(selected)
	mergeConfirm:SetAttribute("Color", "Gray")
	local id = pickId
	local def = id and Config.Hunters[id]
	if not d or not id or not def then
		mergeInfo.Text = "Tap a hunter to merge " .. Config.Merge.Count .. " identical copies into one stronger hunter.\n\nLocked and knocked hunters are never used."
		Kit.SetButtonText(mergeConfirm, "CONFIRM")
		return
	end
	local tier = Config.Tiers[pickTier]
	local name = (if pickTier > 0 then tier.Icon .. " " .. tier.Name .. " " else "") .. string.upper(def.Name)
	if pickTier >= Config.Merge.MaxTier then
		mergeInfo.Text = name .. " is already the top tier. It can't be merged further."
		Kit.SetButtonText(mergeConfirm, "MAX TIER")
		return
	end
	local picks, n = mergePicks(d)
	if n < Config.Merge.Count then
		mergeInfo.Text = "You have " .. n .. "/" .. Config.Merge.Count .. " usable " .. name .. ".\n\nYou need " .. Config.Merge.Count .. " identical copies (same tier, unlocked, not knocked)."
		Kit.SetButtonText(mergeConfirm, "NEED " .. Config.Merge.Count)
		return
	end
	for _, uid in picks do
		selected[uid] = true
	end
	local nextTier = Config.Tiers[pickTier + 1]
	local cost = cratePrice(id) * Config.Merge.CostMult[pickTier + 1]
	mergeInfo.Text = "Uses the " .. Config.Merge.Count .. " highlighted " .. name .. ".\n\nYou get: " .. nextTier.Icon .. " " .. nextTier.Name .. " " .. string.upper(def.Name) .. "\n" .. Format.Commas(def.Power * nextTier.Mult) .. " CAPTURE POWER\n\nCost: " .. Format.Commas(cost) .. " ECTOPLASM"
	Kit.SetButtonText(mergeConfirm, "CONFIRM 💚" .. Format.Short(cost))
	mergeConfirm:SetAttribute("Color", if State.Ecto >= cost then "Green" else "Gray")
end

local function refreshKnocked()
	local d = State.Data
	if not d then
		return
	end
	for uid, c in cards do
		local left = knockLeft(d, uid)
		c.Knock.Visible = left > 0
		if left > 0 then
			c.KnockLabel.Text = "💤 " .. Format.Time(left)
		end
	end
end

local function makeCard(uid: string, hunter: any): Card
	local hunterId = hunter.Id
	local def = Config.Hunters[hunterId]
	local rar = rarityOf(hunterId)
	local tier = tierOf(hunter)
	local f: TextButton = Kit.new("TextButton", {
		Name = uid,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 63,
		Parent = grid,
	})
	Kit.Corner(f, UDim.new(0, 16))
	Kit.Stroke(f, if (hunter.Tier or 0) > 0 then 5 else 3, if (hunter.Tier or 0) > 0 then tier.Color else Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, rar.Color, rar.Color2, 90)
	if rar.Order >= 5 then
		-- legendary cards shimmer
		local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, ZIndex = 63, Parent = f })
		Kit.Corner(shine, UDim.new(0, 16))
		local sg = Kit.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 25,
			Parent = shine,
		})
		task.spawn(function()
			while shine.Parent do
				sg.Offset = Vector2.new(-1, 0)
				Kit.Tween(sg, 1.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear)
				task.wait(2.4)
			end
		end)
	end
	local pic: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 18, 55),
		BackgroundTransparency = 0.35,
		ZIndex = 64,
		Parent = f,
	})
	Kit.Corner(pic, UDim.new(1, 0))
	Portrait.Face(pic, hunterId, false, hunter.Tier or 0)
	Kit.Label(f, string.upper(def.Name), { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
	if (hunter.Tier or 0) > 0 then
		Kit.Label(f, tier.Icon .. " " .. tier.Name, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 64), ZIndex = 67, Color = tier.Color, Style = "Small", Fit = true })
	end
	Kit.IconText(Kit.Label(f, "", { Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 98), ZIndex = 66, Color = Theme.Gold, Style = "Body", Fit = true }), "⚡" .. Format.Short(powerOf(hunter)))
	local eqBadge: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.fromOffset(-5, -5),
		BackgroundColor3 = Theme.Good,
		Visible = false,
		ZIndex = 68,
		Parent = f,
	})
	Kit.Corner(eqBadge, UDim.new(1, 0))
	Kit.Stroke(eqBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(eqBadge, "✅", { Style = "Body", ZIndex = 69 })
	local lock = Kit.Icon(f, "lock", "🔒", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, 2, 0, -3), AnchorPoint = Vector2.new(1, 0), ZIndex = 68, Stroke = 0, Style = "Small" })
	lock.Visible = false
	local sel: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bad, BackgroundTransparency = 0.45, Visible = false, ZIndex = 70, Parent = f })
	Kit.Corner(sel, UDim.new(0, 12))
	local selLabel = Kit.Label(sel, "X", { Style = "Title", ZIndex = 71 })
	local knock: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(60, 60, 70), BackgroundTransparency = 0.35, Visible = false, ZIndex = 69, Parent = f })
	Kit.Corner(knock, UDim.new(0, 16))
	local knockLabel = Kit.Label(knock, "", { Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Body", Fit = true, ZIndex = 70 })
	f.Activated:Connect(function()
		Kit.Play("Click")
		if mergeMode then
			local d = State.Data
			local h = d and d.Hunters[uid]
			if not h then
				return
			end
			if h.Locked then
				Kit.Toast("Locked hunters can't be merged", "Bad")
				return
			end
			pickId, pickTier = h.Id, h.Tier or 0
			rebuild()
		elseif releaseMode then
			local d = State.Data
			local h = d and d.Hunters[uid]
			if not h or h.Locked or table.find(d.Equipped, uid) then
				Kit.Toast("Equipped or locked hunters can't be released", "Bad")
				return
			end
			if selected[uid] then
				selected[uid] = nil
			else
				selected[uid] = true
			end
			sel.Visible = selected[uid] == true
			updateReleaseBar()
		else
			setInspect(uid)
		end
	end)
	return { Frame = f, Equip = eqBadge, Lock = lock, Select = sel, SelectLabel = selLabel, Knock = knock, KnockLabel = knockLabel }
end

local BATCH = 24 -- new cards per frame: a 150-hunter inventory opens without a hitch
local rebuildQueued = false

function rebuild()
	local d = State.Data
	if not d then
		return
	end
	if mergeMode then
		updateMergeBar()
	end
	local created = 0
	-- remove cards for hunters that are gone
	for uid, c in cards do
		if not d.Hunters[uid] then
			c.Frame:Destroy()
			cards[uid] = nil
			selected[uid] = nil
		end
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	for i, uid in sortedUids(d) do
		local h = d.Hunters[uid]
		local c = cards[uid]
		if not c then
			if created >= BATCH then
				-- finish the rest next frame
				if not rebuildQueued then
					rebuildQueued = true
					task.spawn(function()
						task.wait() -- next frame
						rebuildQueued = false
						if panel.IsOpen then
							rebuild()
						end
					end)
				end
				continue
			end
			created += 1
			c = makeCard(uid, h)
			cards[uid] = c
		end
		c.Frame.LayoutOrder = i
		c.Equip.Visible = eq[uid] == true
		c.Lock.Visible = h.Locked == true
		c.Select.Visible = (releaseMode or mergeMode) and selected[uid] == true
		c.Select.BackgroundColor3 = if mergeMode then Theme.Good else Theme.Bad
		c.SelectLabel.Text = if mergeMode then "✓" else "X"
	end
	local count = State.CountOwned()
	local slots = d.Slots or Config.Inventory.BaseSlots
	equippedLabel.Text = "EQUIPPED " .. #d.Equipped .. "/" .. slots
	Kit.IconText(powerLabel, "⚡ " .. Format.Short(d.CrewPower or 0))
	local maxHunters = (State.Data and State.Data.MaxHunters) or Config.Inventory.MaxHunters
	storageLabel.Text = "STORAGE " .. count .. "/" .. maxHunters
	storageLabel.TextColor3 = if count >= maxHunters - 5 then Theme.Bad else Theme.Muted
	if inspectUid and not d.Hunters[inspectUid] then
		inspectUid = nil
	end
	setInspect(inspectUid)
	if releaseMode then
		updateReleaseBar()
	end
	refreshKnocked()
end

local function setMode(release: boolean, merge: boolean)
	releaseMode, mergeMode = release, merge
	pickId = nil
	table.clear(selected)
	releaseBar.Visible = release
	mergeBar.Visible = merge
	Kit.SetButtonText(releaseButton, if release then "DONE" else "RELEASE")
	releaseButton:SetAttribute("Color", if release then "Gray" else "Red")
	Kit.SetButtonText(mergeButton, if merge then "DONE" else "MERGE")
	mergeButton:SetAttribute("Color", if merge then "Gray" else "Purple")
	rebuild()
end

local function act(action: string, ...: any)
	local res = State.Request(action, ...)
	if not res.ok then
		Kit.Toast(res.err or "Couldn't do that", "Bad")
	end
	return res
end

function HuntersPanel.Init()
	panel = Kit.Panel("Hunters", "GHOST HUNTERS", Vector2.new(860, 500), "Orange")
	local body = panel.Body
	-- top bar: counts on the left, actions on the right (actions drop to a 2nd row when narrow)
	top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 10), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	equippedLabel = Kit.Label(top, "EQUIPPED 0/4", { Size = UDim2.fromOffset(150, 22), Position = UDim2.fromOffset(0, 0), Align = Enum.TextXAlignment.Left, Style = "Heading", Fit = true, ZIndex = 62 })
	powerLabel = Kit.Label(top, "", { Size = UDim2.fromOffset(120, 22), Position = UDim2.fromOffset(152, 0), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, Style = "Heading", Fit = true, ZIndex = 62 })
	storageLabel = Kit.Label(top, "STORAGE 0/150", { Size = UDim2.fromOffset(200, 16), Position = UDim2.fromOffset(0, 25), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	actionsRow = Kit.new("Frame", { Size = UDim2.new(0, 480, 0, 40), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 61, Parent = top })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = actionsRow })
	local buttons = actionsRow
	sortButton = Kit.Button(buttons, {
		Text = "SORT: POWER",
		Color = "Blue",
		Size = UDim2.fromOffset(110, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			sortMode = if sortMode == "Power" then "Rarity" else "Power"
			Kit.SetButtonText(sortButton, "SORT: " .. string.upper(sortMode))
			rebuild()
		end,
	})
	releaseButton = Kit.Button(buttons, {
		Text = "RELEASE",
		Color = "Red",
		Size = UDim2.fromOffset(100, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			setMode(not releaseMode, false)
		end,
	})
	mergeButton = Kit.Button(buttons, {
		Text = "MERGE",
		Color = "Purple",
		Size = UDim2.fromOffset(90, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			setMode(false, not mergeMode)
		end,
	})
	equipBestButton = Kit.Button(buttons, {
		Text = "EQUIP BEST",
		Color = "Green",
		Size = UDim2.fromOffset(140, 38),
		ZIndex = 62,
		OnClick = function()
			local res = act("EquipBest")
			if res.ok then
				Kit.Toast("Best crew equipped! ⚡ " .. Format.Commas(res.Power or 0), "Good")
			end
		end,
	})
	equipBestButton.Name = "EquipBest"
	panel.Primary = equipBestButton
	-- grid
	grid = Kit.new("ScrollingFrame", {
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.5,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.Corner(grid, UDim.new(0, 12))
	Kit.Padding(grid, 8)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(100, 122),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	-- inspect pane (scrolls, so it fits short phone screens)
	side = Kit.new("Frame", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	emptyHint = Kit.Label(side, "Tap a hunter to inspect it.\n\nEQUIP BEST picks your strongest crew!", { Size = UDim2.new(1, -24, 0.6, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	inspect = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		ZIndex = 63,
		Parent = side,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = inspect })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = inspect })
	viewHolder = Kit.new("Frame", { Size = UDim2.fromOffset(150, 132), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 63, Parent = inspect })
	nameLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 64 })
	nameLabel.LayoutOrder = 2
	rarityRibbon = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 3, ZIndex = 64, Parent = inspect })
	Kit.Corner(rarityRibbon, UDim.new(1, 0))
	Kit.Stroke(rarityRibbon, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(rarityRibbon, Theme.Panel2, Theme.Panel, 0)
	rarityLabel = Kit.Label(rarityRibbon, "", { Style = "Small", ZIndex = 65 })
	statLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 20), Color = Theme.Gold, Style = "Body", Fit = true, ZIndex = 64 })
	statLabel.LayoutOrder = 4
	blurbLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 0), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	blurbLabel.AutomaticSize = Enum.AutomaticSize.Y
	blurbLabel.LayoutOrder = 5
	local actions: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), BackgroundTransparency = 1, LayoutOrder = 6, ZIndex = 63, Parent = inspect })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = actions })
	equipButton = Kit.Button(actions, {
		Text = "EQUIP",
		Color = "Green",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			if not d or not uid then
				return
			end
			if table.find(d.Equipped, uid) then
				act("Unequip", uid)
			else
				act("Equip", uid)
			end
		end,
	})
	equipButton.LayoutOrder = 1
	lockButton = Kit.Button(actions, {
		Text = "🔒 LOCK",
		Color = "Blue",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			local h = uid and d and d.Hunters[uid]
			if h then
				act("Lock", uid, not h.Locked)
			end
		end,
	})
	lockButton.LayoutOrder = 2
	relOneButton = Kit.Button(actions, {
		Text = "RELEASE",
		Color = "Red",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local uid = inspectUid
			if uid then
				act("Release", { uid })
			end
		end,
	})
	relOneButton.LayoutOrder = 3
	-- release bar (replaces the inspect pane in release mode)
	releaseBar = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	Kit.Label(releaseBar, "Tap hunters to select them. Released hunters give back a little Ectoplasm.", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 8), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	Kit.Button(releaseBar, {
		Text = "SELECT WEAK",
		Color = "Orange",
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.fromOffset(10, 74),
		ZIndex = 64,
		OnClick = function()
			-- every unequipped, unlocked, Normal-tier hunter no stronger than your weakest equipped
			-- one (spare copies of equipped hunters count: they used to be skipped, so it often
			-- picked nothing)
			-- (Shiny / Mega hunters cost merges: never bulk-picked, tap them to release one)
			local d = State.Data
			if not d then
				return
			end
			local weakest = math.huge
			for _, uid in d.Equipped do
				local h = d.Hunters[uid]
				if h then
					weakest = math.min(weakest, powerOf(h))
				end
			end
			table.clear(selected)
			for uid, h in d.Hunters do
				if not h.Locked and (h.Tier or 0) == 0 and not table.find(d.Equipped, uid) and powerOf(h) <= weakest then
					selected[uid] = true
				end
			end
			if next(selected) == nil then
				Kit.Toast("No weak hunters to select (locked, equipped and Shiny/Mega hunters are skipped)", "Bad")
			end
			rebuild()
		end,
	})
	-- select by rarity: every unequipped, unlocked, Normal-tier hunter of that rarity; tapping
	-- again when they're all selected unselects them (higher rarities: tap hunters one by one)
	local RARITY_BUTTONS = { { "Common", "Gray" }, { "Uncommon", "Green" }, { "Rare", "Blue" }, { "Epic", "Purple" }, { "Legendary", "Orange" } }
	for i, rb in RARITY_BUTTONS do
		local rarityId, color = rb[1], rb[2]
		local col, row = (i - 1) % 2, (i - 1) // 2
		Kit.Button(releaseBar, {
			Text = Config.Rarities[rarityId].Name,
			Color = color,
			TextStyle = "Small",
			Size = UDim2.new(0.5, -15, 0, 34),
			Position = UDim2.new(col * 0.5, if col == 0 then 10 else 5, 0, 122 + row * 40),
			ZIndex = 64,
			OnClick = function()
				local d = State.Data
				if not d then
					return
				end
				local matches = {}
				for uid, h in d.Hunters do
					local def = Config.Hunters[h.Id]
					if def and def.Rarity == rarityId and not h.Locked and (h.Tier or 0) == 0 and not table.find(d.Equipped, uid) then
						table.insert(matches, uid)
					end
				end
				if #matches == 0 then
					Kit.Toast("No " .. string.lower(rarityId) .. " hunters to select (locked, equipped and Shiny/Mega are skipped)", "Bad")
					return
				end
				local all = true
				for _, uid in matches do
					all = all and selected[uid] == true
				end
				for _, uid in matches do
					if all then
						selected[uid] = nil
					else
						selected[uid] = true
					end
				end
				rebuild()
			end,
		})
	end
	releaseConfirm = Kit.Button(releaseBar, {
		Text = "RELEASE 0",
		Color = "Gray",
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0, 10, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			local list = {}
			for uid in selected do
				table.insert(list, uid)
			end
			if #list == 0 then
				return
			end
			local res = act("Release", list)
			if res.ok then
				table.clear(selected)
				rebuild()
			end
		end,
	})
	-- merge bar (replaces the inspect pane in merge mode)
	mergeBar = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	mergeInfo = Kit.Label(mergeBar, "", { Size = UDim2.new(1, -20, 1, -116), Position = UDim2.fromOffset(10, 8), Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0, AlignY = Enum.TextYAlignment.Top })
	mergeConfirm = Kit.Button(mergeBar, {
		Text = "CONFIRM",
		Color = "Gray",
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0, 10, 1, -60),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local id = pickId
			if not d or not id then
				return
			end
			local picks = mergePicks(d)
			if #picks < Config.Merge.Count or pickTier >= Config.Merge.MaxTier then
				return
			end
			local res = act("Merge", picks)
			if res.ok then
				local t = Config.Tiers[res.Tier or pickTier + 1]
				local def = Config.Hunters[id]
				Kit.Toast("Merged! " .. t.Icon .. " " .. t.Name .. " " .. string.upper(def.Name) .. " ⚡" .. Format.Short(def.Power * t.Mult), "Gold")
				pickId = nil
				rebuild()
			end
		end,
	})
	Kit.Button(mergeBar, {
		Text = "CANCEL",
		Color = "Red",
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.new(0, 10, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			pickId = nil
			rebuild()
		end,
	})
	Hud.RegisterPanel("Hunters", function()
		panel:Toggle()
	end)
end

-- Responsive layout from the panel's actual (logical) width: the inspect pane takes ~30%,
-- and the action buttons move under the counters when the panel is narrow.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local narrow = w < 700
	local topH = if narrow then 88 else 44
	top.Size = UDim2.new(1, 0, 0, topH)
	if narrow then
		actionsRow.AnchorPoint = Vector2.zero
		actionsRow.Position = UDim2.fromOffset(0, 46)
		actionsRow.Size = UDim2.new(1, 0, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Left
		end
	else
		actionsRow.AnchorPoint = Vector2.new(1, 0)
		actionsRow.Position = UDim2.fromScale(1, 0)
		actionsRow.Size = UDim2.new(0, 480, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Right
		end
	end
	local sideW = math.clamp(math.floor(w * 0.3), 200, 260)
	local y = topH + 16
	grid.Position = UDim2.fromOffset(0, y)
	grid.Size = UDim2.new(1, -(sideW + 8), 1, -y)
	side.Position = UDim2.new(1, 0, 0, y)
	side.Size = UDim2.new(0, sideW, 1, -y)
end

function HuntersPanel.Start()
	local openToken = 0
	panel.OnOpen:Connect(function()
		layout()
		rebuild()
		-- knocked countdowns tick while the panel is open
		openToken += 1
		local token = openToken
		task.spawn(function()
			while panel.IsOpen and token == openToken do
				task.wait(1)
				if mergeMode and pickId then
					rebuild() -- a hunter waking up can make a merge possible
				else
					refreshKnocked()
				end
			end
		end)
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if releaseMode or mergeMode then
			setMode(false, false)
		end
		clearPreview()
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
end

function HuntersPanel.EquipBestButton(): TextButton
	return equipBestButton
end

function HuntersPanel.IsOpen(): boolean
	return panel.IsOpen
end

return HuntersPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTER INDEX: discovery tracking per zone ("HAUNTED NEIGHBORHOOD 3/4 DISCOVERED"),
-- overall completion %, silhouettes for unknown hunters, a 3D preview for known ones and a
-- NEW! indicator (menu badge + card sticker) for discoveries you haven't looked at yet.
-- Each hunter has three variants (NORMAL / ✨ SHINY / 💎 MEGA), discovered separately:
-- Normal = Data.Discovered[id], Shiny/Mega = Data.Variants["id:1"/"id:2"]. Cards show a chip per
-- variant; the detail pane has a tier toggle. Completion % still counts Normal discoveries only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)

-- max HP of a hunter with this power (incl. the equipped pets' HP bonus), as the server counts it
local function hpFor(power: number): number
	local d = State.Data
	local bonus = if d and d.PetBonuses then tonumber(d.PetBonuses.HP) or 0 else 0
	return Rules.HunterMaxHP(power, Config.Retaliation.HPPerPower, bonus)
end

local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local PetPortrait = require(Client.UI.PetPortrait)
local Hud = require(script.Parent.Hud)
local CratePanel = require(script.Parent.CratePanel)
local PetsPanel = require(script.Parent.PetsPanel)

local IndexPanel = {}

local panel: Kit.Panel
local scroll: ScrollingFrame
local totalLabel: TextLabel
local totalFill: Frame
local bar: Frame
local side: Frame
local detail: ScrollingFrame
local detailView: Frame
local detailName: TextLabel
local detailInfo: TextLabel
local detailBlurb: TextLabel
local menuBadge: Frame
local tierButtons: { [number]: TextButton } = {}
local detailHunter: Config.HunterDef? = nil
local detailTier = 0
local newIds: { [string]: boolean } = {}
local spinConn: RBXScriptConnection? = nil
local lastKey = ""
-- HUNTERS / PETS tabs
local tab = "Hunters"
local tabButtons: { [string]: TextButton } = {}
local petScroll: ScrollingFrame
local petTotal: TextLabel
local petKey = ""

local function hunterList(zoneId: string): { Config.HunterDef }
	local out = {}
	local crate = Config.Crates[(Config.ZoneById[zoneId] :: Config.ZoneDef).Crate]
	local pos: { [string]: number } = {}
	for i, e in crate.Pool do
		table.insert(out, Config.Hunters[e.Hunter])
		pos[e.Hunter] = i
	end
	-- weakest → strongest rarity (Ultra after Secret); pool order breaks ties
	table.sort(out, function(a, b)
		local ra, rb = Config.Rarities[a.Rarity].Order, Config.Rarities[b.Rarity].Order
		if ra ~= rb then
			return ra < rb
		end
		return pos[a.Id] < pos[b.Id]
	end)
	return out
end

type Section = { Id: string, Name: string, Accent: Color3, List: { Config.HunterDef }, Unlocked: boolean }

-- One section per area, then the Robux-only EXCLUSIVE hunters.
local function sections(d: any): { Section }
	local out: { Section } = {}
	for _, z in Config.Zones do
		table.insert(out, { Id = z.Id, Name = z.Name, Accent = z.Accent, List = hunterList(z.Id), Unlocked = d.Zones[z.Id] == true })
	end
	local ex = {}
	for _, z in Config.Zones do
		local id = Config.Exclusives[z.Id]
		if id and Config.Hunters[id] then
			table.insert(ex, Config.Hunters[id])
		end
	end
	if #ex > 0 then
		table.insert(out, { Id = "Exclusive", Name = "EXCLUSIVE (ROBUX CRATE)", Accent = Config.Rarities.Exclusive.Color, List = ex, Unlocked = true })
	end
	return out
end

-- Has this player discovered `id` in `tier` (0 Normal, 1 Shiny, 2 Mega)?
local function has(d: any, id: string, tier: number): boolean
	if tier == 0 then
		return d.Discovered[id] == true
	end
	return d.Variants ~= nil and d.Variants[id .. ":" .. tier] == true
end

-- "  ·  SHINY 3  ·  MEGA 1" in the tier colours (labels with RichText on)
local function tierCounts(shiny: number, mega: number): string
	local function part(t: number, n: number): string
		local c = Config.Tiers[t].Color
		return string.format('  ·  <font color="#%02X%02X%02X">%s %d</font>', math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5), Config.Tiers[t].Name, n)
	end
	return part(1, shiny) .. part(2, mega)
end

local function tierLabel(tier: number): string
	local t = Config.Tiers[tier]
	return if tier > 0 then t.Icon .. " " .. t.Name else t.Name
end

local function oddsOf(h: Config.HunterDef): number
	local zone = Config.ZoneById[h.Zone]
	local crate = Config.Crates[zone.Crate]
	local odds = Rules.Odds(crate.Pool :: any, function(id)
		return Config.Rarities[Config.Hunters[id].Rarity].Order
	end, 1, Config.LuckAffectsFromOrder)
	return odds[h.Id] or 0
end

local function showDetail(h: Config.HunterDef)
	local d = State.Data
	if not d then
		return
	end
	detailHunter = h
	local tier = detailTier
	local found = has(d, h.Id, tier)
	for t, b in tierButtons do
		local on = t == tier
		b.BackgroundColor3 = if on then Config.Tiers[t].Color else Theme.Bg
		b.TextColor3 = if on then Theme.Bg else (if has(d, h.Id, t) then Config.Tiers[t].Color else Theme.Muted)
	end
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in detailView:GetChildren() do
		c:Destroy()
	end
	detail.Visible = true
	local rar = Config.Rarities[h.Rarity]
	local crate = if h.Rarity == "Exclusive" then Config.Crates.Exclusive else Config.Crates[(Config.ZoneById[h.Zone] :: Config.ZoneDef).Crate]
	if found then
		local _, model = Portrait.Viewport(detailView, h.Id, false, tier)
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				model:PivotTo(CFrame.Angles(0, (os.clock() - t0) * 0.9, 0))
			end)
		end
		detailName.Text = (if tier > 0 then Config.Tiers[tier].Icon .. " " .. Config.Tiers[tier].Name .. " " else "") .. string.upper(h.Name)
		detailBlurb.Text = h.Blurb
	else
		Portrait.Viewport(detailView, h.Id, true, tier)
		detailName.Text = if tier > 0 then Config.Tiers[tier].Icon .. " ???" else "???"
		detailBlurb.Text = if tier == 0
			then "Not discovered yet. Keep opening crates!"
			else tierLabel(tier) .. " not discovered yet. Merge " .. Config.Merge.Count .. " " .. (if tier == 1 then "NORMAL" else "SHINY") .. " copies to make one!"
	end
	detailName.TextColor3 = if tier > 0 then Config.Tiers[tier].Color else Theme.RarityText(rar)
	-- one short fact per line (top aligned) so the power icon sits on a line that never wraps
	Kit.IconText(detailInfo, tierLabel(tier) .. "  ·  " .. rar.Name .. "\n⚡ " .. (if found then Format.Short(h.Power * Config.Tiers[tier].Mult) .. "  ·  ❤️ " .. Format.Short(hpFor(h.Power * Config.Tiers[tier].Mult)) .. " HP" else "?") .. "\n" .. (if h.Rarity == "Exclusive" then "EXCLUSIVE CRATE (ROBUX) · best unlocked area" else crate.Name .. "  ·  " .. Format.Percent(oddsOf(h))))
end

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local key = ""
	local secs = sections(d)
	for _, z in secs do
		key ..= if z.Unlocked then "u" else "l"
		for _, h in z.List do
			for t = 0, 2 do
				key ..= if has(d, h.Id, t) then "1" else "0"
			end
			key ..= if newIds[h.Id] then "n" else ""
		end
	end
	if key == lastKey then
		return
	end
	lastKey = key
	for _, c in scroll:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local total, found, shiny, mega = 0, 0, 0, 0
	for zi, z in secs do
		local list = z.List
		local zf, zs, zm = 0, 0, 0
		for _, h in list do
			if d.Discovered[h.Id] then
				zf += 1
			end
			zs += if has(d, h.Id, 1) then 1 else 0
			zm += if has(d, h.Id, 2) then 1 else 0
		end
		shiny += zs
		mega += zm
		if z.Id ~= "Exclusive" then -- paid hunters don't count toward completion
			total += #list
			found += zf
		end
		local section: Frame = Kit.new("Frame", {
			Size = UDim2.new(1, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.45,
			LayoutOrder = zi,
			ZIndex = 62,
			Parent = scroll,
		})
		Kit.Corner(section, UDim.new(0, 12))
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = section })
		Kit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = section })
		local unlocked = z.Unlocked
		local complete = zf == #list
		local header: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 62, Parent = section })
		-- area icon (or the Exclusive crate) left of the name; a locked area adds the lock icon
		Kit.Icon(header, if z.Id == "Exclusive" then "crate_exclusive" else Icons.ForZone(z.Id), "", { Size = UDim2.fromOffset(26, 26), Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), Style = "Icon", ZIndex = 63 })
		local zoneName = Kit.Label(header, "", { Size = UDim2.new(0.6, -30, 1, 0), Position = UDim2.fromOffset(30, 0), Align = Enum.TextXAlignment.Left, Color = z.Accent, Style = "Heading", Fit = true, ZIndex = 63 })
		Kit.IconText(zoneName, (if unlocked then "" else "🔒 ") .. z.Name)
		-- Shiny / Mega counts as coloured words (no tier icons uploaded yet)
		local counts = Kit.Label(header, "", { Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = if complete then Theme.Gold else Theme.Text, Style = "Small", Fit = true, ZIndex = 63 })
		counts.RichText = true
		counts.Text = (if complete then "⭐ " else "") .. zf .. "/" .. #list .. tierCounts(zs, zm)
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 62, Parent = section })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 142), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		for _, h in list do
			local rar = Config.Rarities[h.Rarity]
			local known = has(d, h.Id, 0) or has(d, h.Id, 1) or has(d, h.Id, 2)
			local card: TextButton = Kit.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 63,
				Parent = row,
			})
			Kit.Corner(card, UDim.new(0, 12))
			Kit.Stroke(card, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
			if known then
				Kit.Gradient(card, rar.Color, rar.Color2, 90)
			else
				Kit.Gradient(card, Color3.fromRGB(70, 60, 100), Color3.fromRGB(40, 32, 66), 90)
			end
			local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = card })
			Kit.Corner(pic, UDim.new(1, 0))
			Portrait.Face(pic, h.Id, not has(d, h.Id, 0))
			Kit.Label(card, if known then string.upper(h.Name) else "???", { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
			Kit.Label(card, rar.Name, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 100), ZIndex = 66, Color = if known then Color3.new(1, 1, 1) else Theme.RarityText(rar), Style = "Tiny", Fit = true })
			-- one chip per variant: lit in the tier colour when discovered, "?" when not
			for t = 0, 2 do
				local on = has(d, h.Id, t)
				local tc = Config.Tiers[t].Color
				local chip: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(28, 18), Position = UDim2.fromOffset(6 + t * 30, 118), BackgroundColor3 = if on then Theme.Bg else Color3.fromRGB(40, 32, 66), BackgroundTransparency = if on then 0.1 else 0.4, ZIndex = 66, Parent = card })
				Kit.Corner(chip, UDim.new(1, 0))
				Kit.Stroke(chip, 1.5, if on then tc else Theme.Outline, Enum.ApplyStrokeMode.Border)
				Kit.Label(chip, if not on then "?" else string.sub(Config.Tiers[t].Name, 1, 1), { Color = if on then tc else Theme.Muted, Style = "Tiny", Fit = true, ZIndex = 67, Stroke = 0 })
			end
			if newIds[h.Id] then
				local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(46, 18), Position = UDim2.new(1, 6, 0, -6), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 70, Stroke = 2 })
				stamp.Rotation = 12
			end
			card.Activated:Connect(function()
				Kit.Play("Click")
				if newIds[h.Id] then
					newIds[h.Id] = nil
					menuBadge.Visible = next(newIds) ~= nil
				end
				detailTier = 0
				showDetail(h)
			end)
		end
	end
	local pct = if total > 0 then found / total else 0
	totalLabel.Text = found .. " / " .. total .. " DISCOVERED  ·  " .. math.floor(pct * 100 + 0.5) .. "%" .. tierCounts(shiny, mega)
	Kit.Tween(totalFill, 0.4, { Size = UDim2.fromScale(math.max(pct, 0.02), 1) })
end

-- "Haunted Egg 40%" lines for every egg that can hatch this pet.
local function petSource(id: string): string
	local lines = {}
	for _, eggId in Config.EggOrder do
		local egg = Config.Eggs[eggId]
		for _, o in egg.Odds do
			if o.Pet == id then
				table.insert(lines, egg.Name .. " " .. o.Chance .. "%")
			end
		end
	end
	if #lines == 0 then
		return if id == Config.RarePetEvent.Pet then "Launch event reward" else "Special reward"
	end
	return table.concat(lines, "\n")
end

local function rebuildPets()
	local d = State.Data
	if not d then
		return
	end
	local owned: { [string]: boolean } = {}
	for _, p in d.Pets or {} do
		owned[p.Id] = true
	end
	local key = ""
	for _, id in Config.PetOrder do
		key ..= if owned[id] then "1" else "0"
	end
	if key == petKey then
		return
	end
	petKey = key
	for _, c in petScroll:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local found = 0
	for i, id in Config.PetOrder do
		local pet = Config.Pets[id]
		local rar = Config.Rarities[pet.Rarity]
		local known = owned[id] == true
		found += if known then 1 else 0
		local card: TextButton = Kit.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = i, ZIndex = 63, Parent = petScroll })
		Kit.Corner(card, UDim.new(0, 12))
		Kit.Stroke(card, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
		if known then
			Kit.Gradient(card, rar.Color, rar.Color2, 90)
		else
			Kit.Gradient(card, Color3.fromRGB(70, 60, 100), Color3.fromRGB(40, 32, 66), 90)
		end
		local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(62, 62), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = if known then pet.Glow else Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = card })
		Kit.Corner(pic, UDim.new(1, 0))
		PetPortrait.New(pic, id, not known) -- undiscovered: dark silhouette
		Kit.Label(card, if known then string.upper(pet.Name) else "???", { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 72), ZIndex = 66, Style = "Small", Fit = true })
		Kit.Label(card, rar.Name, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 90), ZIndex = 66, Color = if known then Color3.new(1, 1, 1) else Theme.RarityText(rar), Style = "Tiny", Fit = true })
		if known then
			Kit.Label(card, (string.gsub(PetsPanel.BonusText(pet.Bonus.Kind, pet.Bonus.Value), " for all hunters", "")), { Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 106), ZIndex = 66, Color = Theme.Ecto, Style = "Tiny", Fit = true })
		end
		Kit.Label(card, petSource(id), { Size = UDim2.new(1, -8, 0, 38), Position = UDim2.fromOffset(4, 134), ZIndex = 66, Color = Theme.Text, Font = Theme.Body, Style = "Tiny", Fit = true, Stroke = 0 })
	end
	petTotal.Text = (if found == #Config.PetOrder then "⭐ " else "") .. "PETS FOUND " .. found .. "/" .. #Config.PetOrder
end

local function setTab(t: string)
	tab = t
	for name, b in tabButtons do
		local on = name == t
		b.BackgroundColor3 = if on then Theme.Ecto else Theme.Bg
		b.TextColor3 = if on then Theme.Bg else Theme.Text
	end
	local hunters = t == "Hunters"
	bar.Visible = hunters
	scroll.Visible = hunters
	side.Visible = hunters
	petScroll.Visible = not hunters
	if hunters then
		rebuild()
	else
		rebuildPets()
	end
end

function IndexPanel.Init()
	panel = Kit.Panel("Index", "HUNTER INDEX", Vector2.new(860, 500), "Blue")
	local body = panel.Body
	-- HUNTERS / PETS tab row
	local tabRow: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 6), BackgroundTransparency = 1, ZIndex = 62, Parent = body })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabRow })
	for i, t in { "Hunters", "Pets" } do
		local b: TextButton = Kit.new("TextButton", {
			Text = if t == "Hunters" then "HUNTERS" else "PETS",
			Size = UDim2.fromOffset(130, 28),
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Bg,
			Font = Theme.Body,
			TextColor3 = Theme.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = i,
			ZIndex = 63,
			Parent = tabRow,
		})
		-- fixed size from the type scale (TextScaled made odd sizes that broke text on phones)
		Kit.FitText(b :: any, Theme.Type.Small, 0, true)
		Kit.Corner(b, UDim.new(1, 0))
		Kit.Stroke(b, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
		-- menu icon left of the tab name (text keeps clear of it)
		Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 26), Parent = b })
		Kit.Icon(b, if t == "Hunters" then "menu_hunters" else "menu_pets", "", { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, -20, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Style = "Icon", ZIndex = 64 })
		b.Activated:Connect(function()
			Kit.Play("Click")
			setTab(t)
		end)
		tabButtons[t] = b
	end
	petScroll = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -42),
		Position = UDim2.fromOffset(0, 42),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 62,
		Parent = body,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = petScroll })
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 176), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = petScroll })
	petTotal = Kit.Label(tabRow, "PETS FOUND 0/" .. #Config.PetOrder, { Size = UDim2.new(1, -276, 1, 0), Align = Enum.TextXAlignment.Right, Color = Theme.Gold, Style = "Small", Fit = true, ZIndex = 63 })
	petTotal.LayoutOrder = 3
	bar = Kit.new("Frame", { Size = UDim2.new(1, -270, 0, 28), Position = UDim2.fromOffset(0, 42), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	totalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(totalFill, UDim.new(1, 0))
	Kit.Gradient(totalFill, Theme.Ecto, Theme.Ecto2, 0)
	totalLabel = Kit.Label(bar, "COLLECTION", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Body", Fit = true, ZIndex = 64 })
	totalLabel.RichText = true
	scroll = Kit.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 80),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	side = Kit.new("Frame", { Position = UDim2.new(1, 0, 0, 42), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	Kit.Label(side, "Tap a card to take a closer look!", { Size = UDim2.new(1, -24, 0, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	detail = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 64,
		Parent = side,
	})
	Kit.Corner(detail, UDim.new(0, 12))
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = detail })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = detail })
	detailView = Kit.new("Frame", { Size = UDim2.fromOffset(160, 160), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 65, Parent = detail })
	-- NORMAL / ✨ SHINY / 💎 MEGA toggle
	local tierRow: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 65, Parent = detail })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tierRow })
	for t = 0, 2 do
		local b: TextButton = Kit.new("TextButton", {
			Text = tierLabel(t),
			Size = UDim2.new(1 / 3, -3, 1, 0),
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Bg,
			Font = Theme.Body,
			TextColor3 = Theme.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = t,
			ZIndex = 66,
			Parent = tierRow,
		})
		Kit.FitText(b :: any, Theme.Type.Tiny, 0, true)
		Kit.Corner(b, UDim.new(1, 0))
		Kit.Stroke(b, 1.5, Config.Tiers[t].Color, Enum.ApplyStrokeMode.Border)
		Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), Parent = b })
		b.Activated:Connect(function()
			Kit.Play("Click")
			detailTier = t
			if detailHunter then
				showDetail(detailHunter)
			end
		end)
		tierButtons[t] = b
	end
	detailName = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 66 })
	detailName.LayoutOrder = 3
	detailInfo = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Text, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailInfo.AutomaticSize = Enum.AutomaticSize.Y
	detailInfo.TextYAlignment = Enum.TextYAlignment.Top
	detailInfo.LayoutOrder = 4
	detailBlurb = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailBlurb.AutomaticSize = Enum.AutomaticSize.Y
	detailBlurb.LayoutOrder = 5
	-- NEW badge on the INDEX menu button
	menuBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(36, 18),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Ecto,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Index,
	})
	Kit.Corner(menuBadge, UDim.new(1, 0))
	Kit.Stroke(menuBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(menuBadge, "NEW", { Style = "Tiny", ZIndex = 11 })
	Hud.RegisterPanel("Index", function()
		panel:Toggle()
	end)
end

-- Side pane takes ~30% of the panel's actual width; sections wrap their cards.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local sideW = math.clamp(math.floor(w * 0.3), 190, 250)
	bar.Size = UDim2.new(1, -(sideW + 10), 0, 28)
	scroll.Size = UDim2.new(1, -(sideW + 10), 1, -80)
	side.Size = UDim2.new(0, sideW, 1, -42)
end

function IndexPanel.Start()
	panel.OnOpen:Connect(function()
		layout()
		lastKey = ""
		petKey = ""
		detail.Visible = false
		setTab(tab)
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
		-- looked at the index: discoveries are no longer "new"
		table.clear(newIds)
		menuBadge.Visible = false
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			if tab == "Hunters" then
				rebuild()
			else
				rebuildPets()
			end
		end
	end)
	CratePanel.Opened:Connect(function(res: any)
		if res.IsNew then
			newIds[res.Hunter] = true
			menuBadge.Visible = true
		end
	end)
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">LikeReminder</string>
              <string name="Source"><![CDATA[--!strict
-- A friendly reminder to like the game, shown once per session after a while of play.
-- No reward (Roblox doesn't allow rewards for likes) and nothing blocks the screen.
local Theme = require(script.Parent.Parent.UI.Theme)
local Hud = require(script.Parent.Hud)

local LikeReminder = {}

local FIRST_AFTER = 10 * 60 -- seconds of play before the reminder

function LikeReminder.Init() end

function LikeReminder.Start()
	task.delay(FIRST_AFTER, function()
		Hud.Banner("HAVING FUN? 👻", "Tap 👍 on the game page to help Ghost Hunters grow!", Theme.Ecto)
	end)
end

return LikeReminder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">MenuTour</string>
              <string name="Source"><![CDATA[--!strict
-- MENU TOUR: right after the tutorial (and from Settings > MENU TOUR) a short walk through the
-- HUD: one menu button / counter at a time gets a pulsing outline and a bobbing arrow, the
-- other buttons dim a little, and a small tip card has NEXT / SKIP TOUR. Nothing opens by
-- itself and nothing is blocked: the tour only draws on the overlay (its highlight pieces
-- never take input) and steps aside while a menu is open or the HUD is hidden.
-- Saved state: Settings.Tour = "tour still owed" (set when the tutorial is finished, cleared
-- when the tour ends), so a player who leaves mid-tour gets it again next time, and players
-- who finished the tutorial before the tour existed are never forced into it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)

local MenuTour = {}

type Step = { Title: string, Tip: string, Target: (() -> GuiObject?)? }

local function button(name: string): () -> GuiObject?
	return function()
		return Hud.Buttons[name]
	end
end

local function counter(name: string): () -> GuiObject?
	return function()
		return Hud.Counters[name]
	end
end

local function autoButton(): GuiObject?
	local stack = Hud.RightStack
	local b = stack and stack:FindFirstChild("AutoAttack")
	return if b and b:IsA("GuiObject") then b else nil
end

local STEPS: { Step } = {
	{ Title = "💚 ECTOPLASM", Tip = "Your money: defeat ghosts and collect it.", Target = counter("Ecto") },
	{ Title = "⚡ POWER", Tip = "Damage per second of your whole crew.", Target = counter("Power") },
	{ Title = "🔮 SPIRIT SHARDS", Tip = "Won in the Boss Tower.", Target = counter("Shards") },
	{ Title = "🔦 HUNTERS", Tip = "Your crew: equip, merge and release hunters.", Target = button("Hunters") },
	{ Title = "📖 INDEX", Tip = "Every hunter & pet you've found.", Target = button("Index") },
	{ Title = "🌍 WORLDS", Tip = "Travel to any area you've unlocked.", Target = button("Worlds") },
	{ Title = "🐾 PETS", Tip = "Equip pets for extra bonuses.", Target = button("Pets") },
	{ Title = "🧲 UPGRADES", Tip = "Spend Ectoplasm on permanent upgrades.", Target = button("Upgrades") },
	{ Title = "🛒 SHOP", Tip = "Boosts, passes and Ectoplasm packs.", Target = button("Shop") },
	{ Title = "🎁 DAILY", Tip = "A free reward every day!", Target = button("Daily") },
	{ Title = "🤖 AUTO", Tip = "Auto-attack nearby ghosts. Free for everyone!", Target = autoButton },
	{ Title = "💬 FEEDBACK", Tip = "Send ideas or report a bug.", Target = button("Feedback") },
	{ Title = "⚙ SETTINGS", Tip = "Music, sounds, names, and this tour again.", Target = button("Settings") },
	{ Title = "🏠 LOBBY BOOTHS", Tip = "Find the MERGE, TRADING, PET HATCHERY and BOSS TOWER booths in the lobby!" },
}

local BOX_H = 132
local DIM_TRANSPARENCY = 0.55

local running = false
local index = 0
local conn: RBXScriptConnection? = nil
local holder: Frame -- zero-size container on the overlay: draws, never covers anything
local box: Frame
local titleLabel: TextLabel
local tipLabel: TextLabel
local countLabel: TextLabel
local nextButton: TextButton
local ring: Frame
local ringStroke: UIStroke
local arrow: TextLabel
local dims: { [GuiObject]: Frame } = {}

-- On screen right now: every ancestor visible, its ScreenGui enabled and it has a size.
local function shown(g: GuiObject?): boolean
	if not g or g.AbsoluteSize.X < 1 then
		return false
	end
	local node: Instance? = g
	while node do
		if node:IsA("LayerCollector") then
			return node.Enabled
		elseif node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return false
end

local function targetOf(i: number): GuiObject?
	local s = STEPS[i]
	return if s and s.Target then s.Target() else nil
end

-- Steps with a target are skipped while that target is hidden (PETS before it's unlocked).
local function usable(i: number): boolean
	local s = STEPS[i]
	return s ~= nil and (s.Target == nil or shown(targetOf(i)))
end

-- Rect of a gui object in the overlay's logical coordinates.
local function rectOf(g: GuiObject): (Vector2, Vector2)
	local overlay = Kit.Overlay()
	local k = math.max(Kit.UIScale(), 0.05)
	return (g.AbsolutePosition - overlay.AbsolutePosition) / k, g.AbsoluteSize / k
end

local function finish(markDone: boolean)
	if not running then
		return
	end
	running = false
	if conn then
		conn:Disconnect()
		conn = nil
	end
	holder.Visible = false
	for _, f in dims do
		f:Destroy()
	end
	table.clear(dims)
	local d = State.Data
	if markDone and d and d.Settings.Tour == true then
		task.spawn(State.Request, "Setting", "Tour", false)
	end
end

local function show(i: number)
	while i <= #STEPS and not usable(i) do
		i += 1
	end
	if i > #STEPS then
		finish(true)
		return
	end
	index = i
	local s = STEPS[i]
	titleLabel.Text = s.Title
	Kit.EctoText(tipLabel, s.Tip)
	local total, at = 0, 0
	for j in STEPS do
		if usable(j) or j == i then
			total += 1
			if j <= i then
				at += 1
			end
		end
	end
	countLabel.Text = at .. " / " .. total
	Kit.SetButtonText(nextButton, if i == #STEPS then "DONE!" else "NEXT")
	Sound.Play("Select")
end

-- Keeps the highlight on its target every frame (menus rescale and move with the screen).
local function update()
	local hudOn = Kit.Screen().Enabled and Kit.CurrentPanel() == nil
	holder.Visible = hudOn
	if not hudOn then
		return
	end
	local logical = Kit.LogicalSize()
	local target = targetOf(index)
	local tPos, tSize = Vector2.zero, Vector2.zero
	if target and shown(target) then
		tPos, tSize = rectOf(target)
		ring.Visible = true
		ring.Position = UDim2.fromOffset(tPos.X + tSize.X / 2, tPos.Y + tSize.Y / 2)
		ring.Size = UDim2.fromOffset(tSize.X + 10, tSize.Y + 10)
		arrow.Visible = true
		local cx = tPos.X + tSize.X / 2
		if cx < logical.X * 0.35 then
			arrow.Text = "⬅" -- left column: arrow to its right
			arrow.Position = UDim2.fromOffset(tPos.X + tSize.X + 30, tPos.Y + tSize.Y / 2)
		elseif cx > logical.X * 0.65 then
			arrow.Text = "➡"
			arrow.Position = UDim2.fromOffset(tPos.X - 30, tPos.Y + tSize.Y / 2)
		else
			arrow.Text = "⬆" -- top counters: arrow underneath
			arrow.Position = UDim2.fromOffset(cx, tPos.Y + tSize.Y + 28)
		end
	else
		target = nil
		ring.Visible = false
		arrow.Visible = false
	end
	-- light dim over the other visible tour targets
	local seen: { [GuiObject]: boolean } = {}
	for j in STEPS do
		local g = targetOf(j)
		if g and g ~= target and shown(g) then
			seen[g] = true
			local frame = dims[g]
			if not frame then
				local f: Frame = Kit.new("Frame", {
					Name = "TourDim",
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.new(0, 0, 0),
					BackgroundTransparency = DIM_TRANSPARENCY,
					Active = false,
					Interactable = false,
					ZIndex = 80,
					Parent = holder,
				})
				Kit.Corner(f, UDim.new(0, 12))
				dims[g] = f
				frame = f
			end
			local p, sz = rectOf(g)
			frame.Position = UDim2.fromOffset(p.X + sz.X / 2, p.Y + sz.Y / 2)
			frame.Size = UDim2.fromOffset(sz.X, sz.Y)
		end
	end
	for g, f in dims do
		if not seen[g] then
			f:Destroy()
			dims[g] = nil
		end
	end
	-- tip card: centred, moved up/down when it would sit on the highlighted target
	local w = math.clamp(logical.X - 40, 260, 400)
	box.Size = UDim2.fromOffset(w, BOX_H)
	local x0 = (logical.X - w) / 2
	local function covers(y: number): boolean
		if not target then
			return false
		end
		return tPos.X < x0 + w and tPos.X + tSize.X > x0 and tPos.Y < y + BOX_H and tPos.Y + tSize.Y > y
	end
	local y = logical.Y * 0.45 - BOX_H / 2
	if covers(y) then
		y = if not covers(logical.Y * 0.2) then logical.Y * 0.2 else logical.Y * 0.7 - BOX_H
	end
	box.Position = UDim2.fromOffset(x0, math.max(8, y))
end

local function begin()
	if running then
		show(1)
		return
	end
	running = true
	holder.Visible = true
	show(1)
	conn = RunService.RenderStepped:Connect(update)
end

function MenuTour.Begin()
	begin()
end

function MenuTour.IsRunning(): boolean
	return running
end

-- Called by the tutorial when its last step is done: remember the tour is owed (a player who
-- leaves right away gets it next time), then start it once the screen is free.
function MenuTour.AfterTutorial()
	local d = State.Data
	if d and d.Settings.Tour ~= true then
		task.spawn(State.Request, "Setting", "Tour", true)
	end
	task.delay(3, function()
		Kit.WhenFree(begin)
	end)
end

function MenuTour.Init()
	local overlay = Kit.Overlay()
	holder = Kit.new("Frame", {
		Name = "MenuTour",
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		ZIndex = 80,
		Parent = overlay,
	})
	ring = Kit.new("Frame", {
		Name = "TourRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Active = false,
		Interactable = false,
		ZIndex = 82,
		Parent = holder,
	})
	Kit.Corner(ring, UDim.new(0, 16))
	ringStroke = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
	arrow = Kit.Label(holder, "⬅", { Size = UDim2.fromOffset(44, 44), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Ecto, Style = "Banner", ZIndex = 83 })
	arrow.Active = false
	arrow.Interactable = false
	-- the tip card
	box = Kit.new("Frame", {
		Name = "TourTip",
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 86,
		Parent = holder,
	})
	Kit.Corner(box, UDim.new(0, 16))
	Kit.Stroke(box, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(box, Theme.Panel2, Theme.Panel, 90)
	titleLabel = Kit.Label(box, "", { Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 8), Color = Theme.Ecto, Style = "Heading", Fit = true, ZIndex = 87 })
	tipLabel = Kit.Label(box, "", { Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 36), Style = "Body", Wrap = true, ZIndex = 87 })
	countLabel = Kit.Label(box, "", { Size = UDim2.fromOffset(70, 20), Position = UDim2.new(0.5, 0, 1, -28), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Tiny", Fit = true, ZIndex = 87 })
	Kit.Button(box, {
		Text = "SKIP TOUR",
		Color = "Gray",
		Size = UDim2.fromOffset(110, 38),
		Position = UDim2.new(0, 12, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		TextStyle = "Small",
		ZIndex = 88,
		OnClick = function()
			finish(true)
		end,
	})
	nextButton = Kit.Button(box, {
		Text = "NEXT",
		Color = "Green",
		Size = UDim2.fromOffset(110, 38),
		Position = UDim2.new(1, -12, 1, -10),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 88,
		OnClick = function()
			show(index + 1)
		end,
	})
	-- pulse the outline (size + stroke fade only; no text is scaled)
	task.spawn(function()
		while true do
			if running and ring.Visible then
				ringStroke.Transparency = 0
				Kit.Tween(ringStroke, 0.8, { Transparency = 0.85 })
				task.wait(0.9)
			else
				task.wait(0.3)
			end
		end
	end)
	-- bob the arrow toward its target
	local bob = Kit.new("UIPadding", { Parent = arrow })
	task.spawn(function()
		while true do
			if running and arrow.Visible then
				local horizontal = arrow.Text ~= "⬆"
				local sign = if arrow.Text == "➡" then 1 else -1
				Kit.Tween(bob, 0.4, if horizontal then { PaddingLeft = UDim.new(0, if sign > 0 then 10 else 0), PaddingRight = UDim.new(0, if sign < 0 then 10 else 0) } else { PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 0) }, Enum.EasingStyle.Sine)
				task.wait(0.4)
				Kit.Tween(bob, 0.4, { PaddingLeft = UDim.new(0, 0), PaddingRight = UDim.new(0, 0), PaddingBottom = UDim.new(0, 0), PaddingTop = UDim.new(0, 0) }, Enum.EasingStyle.Sine)
				task.wait(0.4)
			else
				task.wait(0.3)
			end
		end
	end)
	Hud.RegisterPanel("MenuTour", begin) -- Settings > MENU TOUR replays it
end

function MenuTour.Start()
	task.spawn(function()
		local d = State.WaitForData()
		-- owed from an earlier session (left mid-tour): show it again once things settle
		if d.Settings.Tour == true and (d.Tutorial or 1) > #Config.Tutorial.Steps then
			task.wait(5)
			Kit.WhenFree(function()
				local now = State.Data
				if now and now.Settings.Tour == true then
					begin()
				end
			end)
		end
	end)
end

return MenuTour
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[--!strict
-- Ectoplasm orbs (visual only; the server owns values and decides pickups).
--   Drops   → orbs pop out of the poof on an arc, bounce twice, then hover and glow.
--   Pickup  → as soon as an orb is inside your pickup radius it starts accelerating toward you
--             (predicted locally so it feels instant); it is "eaten" when the server confirms
--             the pickup (Collect). Unconfirmed orbs wait at your side briefly, then go back.
-- One RenderStepped loop moves every orb with BulkMoveTo; parts are pooled.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Orbs = {}

type Orb = {
	Id: number,
	Part: BasePart,
	Value: number,
	Start: Vector3,
	Land: Vector3,
	T0: number,
	FlyDur: number,
	Phase: string, -- Fly | Rest | Magnet | Held | Fade
	Confirmed: boolean,
	MagnetT0: number,
	MagnetFrom: Vector3,
	HeldT0: number,
	NoPredictUntil: number,
	ExpireAt: number,
	Spin: number,
	Size: number,
	Pos: Vector3,
}

local player = Players.LocalPlayer
local orbs: { [number]: Orb } = {}
local pool: { BasePart } = {}
local folder: Folder
local hidden = CFrame.new(0, -500, 0)
local streak = 0
local lastPickup = 0
local ring: Part
local ringGui: SurfaceGui
local ringStroke: UIStroke
local ringAlpha = 0
local collectedSignal = Signal.new()
Orbs.Collected = collectedSignal -- (amount)

local GREEN = Theme.Ecto
local CYAN = Theme.Ecto2

local function getPart(): BasePart
	local p = table.remove(pool)
	if p then
		p.Transparency = 0.05
		return p
	end
	local b = Instance.new("Part")
	b.Name = "Ecto"
	b.Shape = Enum.PartType.Ball
	b.Material = Enum.Material.Neon
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.CastShadow = false
	b.Transparency = 0.05
	b.CFrame = hidden
	b.Parent = folder
	return b
end

local function release(o: Orb)
	orbs[o.Id] = nil
	o.Part.CFrame = hidden
	if #pool < 300 then
		table.insert(pool, o.Part)
	else
		o.Part:Destroy()
	end
end

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function radius(): number
	local d = State.Data
	return if d and d.PickupRadius then d.PickupRadius else Config.Upgrades.PickupRadius.Levels[1]
end

local function spawnDrops(origin: Vector3, list: { any }, removed: { number }?)
	local now = os.clock()
	-- the server retired these (too many uncollected orbs): fade them out like a timeout. That
	-- includes orbs already flying to / waiting at the player (predicted, never confirmed): the
	-- server will never confirm them, so they'd otherwise bounce back as phantom orbs.
	if type(removed) == "table" then
		for _, id in removed do
			local old = orbs[id]
			if old and not old.Confirmed and old.Phase ~= "Fade" then
				if old.Phase == "Magnet" or old.Phase == "Held" then
					old.Land = old.Pos - Vector3.new(0, 0.35, 0) -- fade where it is now
				end
				old.Phase = "Fade"
				old.T0 = now
			end
		end
	end
	for i, item in list do
		local id, land, value = item[1], item[2], item[3]
		if type(id) ~= "number" or typeof(land) ~= "Vector3" or type(value) ~= "number" or orbs[id] then
			continue
		end
		-- size by value relative to your best area (ZoneMultiplier ~ typical income there), so
		-- boss and big drops stand out in every zone instead of all late orbs being max size
		local rel = value / math.max(1, (State.Data and State.Data.ZoneMultiplier) or 1)
		local size = math.clamp(0.9 + 0.35 * math.log10(math.max(1, rel)), 0.9, 1.9)
		local part = getPart()
		part.Size = Vector3.new(size, size, size)
		part.Color = GREEN:Lerp(CYAN, math.random() * 0.6)
		local o: Orb = {
			Id = id,
			Part = part,
			Value = value,
			Start = origin,
			Land = land,
			T0 = now + (i - 1) * 0.025, -- tiny stagger so a burst "sprays"
			FlyDur = 0.45 + math.random() * 0.25,
			Phase = "Fly",
			Confirmed = false,
			MagnetT0 = 0,
			MagnetFrom = origin,
			HeldT0 = 0,
			NoPredictUntil = 0,
			ExpireAt = now + Config.Drops.Lifetime,
			Spin = math.random() * 6.28,
			Size = size,
			Pos = origin,
		}
		orbs[id] = o
	end
	-- ectoplasm splash where the ghost popped
	Effects.Burst(origin, { Color = GREEN, Color2 = CYAN, Count = math.min(6 + #list * 2, 30), Size = 0.7, Speed = 14, Life = 0.5, Gravity = 25 })
	Sound.Play("Drop", 0.1)
end

local function startMagnet(o: Orb)
	if o.Phase == "Magnet" or o.Phase == "Held" or o.Phase == "Fade" then
		return
	end
	o.Phase = "Magnet"
	o.MagnetT0 = os.clock()
	o.MagnetFrom = o.Pos
end

local function eat(o: Orb, at: Vector3)
	local now = os.clock()
	if now - lastPickup < 0.6 then
		streak = math.min(streak + 1, 14)
	else
		streak = 0
	end
	lastPickup = now
	Effects.Burst(at, { Color = o.Part.Color, Count = 5, Size = 0.45, Speed = 6, Life = 0.35 })
	Sound.Play("Pickup", 0.02, 1 + streak * 0.045) -- rising pitch on a pickup streak
	release(o)
	collectedSignal:Fire(o.Value)
end

local function onCollect(ids: { number }, _total: number)
	for _, id in ids do
		local o = orbs[id]
		if o then
			o.Confirmed = true
			if o.Phase == "Held" then
				local r = rootPart()
				eat(o, if r then r.Position else o.Pos)
			else
				startMagnet(o)
			end
		end
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	local now = os.clock()
	local root = rootPart()
	local rpos = if root then root.Position else nil
	local rad = radius()
	local r2 = rad * rad
	local nearCount = 0
	table.clear(parts)
	table.clear(cframes)
	for _, o in orbs do
		local pos: Vector3
		if o.Phase == "Fly" then
			local a = math.clamp((now - o.T0) / o.FlyDur, 0, 1)
			local dist = (o.Land - o.Start).Magnitude
			local arc = (2.5 + dist * 0.35) * 4 * a * (1 - a)
			pos = o.Start:Lerp(o.Land, a) + Vector3.new(0, arc, 0)
			if a >= 1 then
				o.Phase = "Rest"
				o.T0 = now
			end
		elseif o.Phase == "Rest" then
			local b = now - o.T0
			local bounce = 0
			if b < 0.5 then
				local k = b / 0.5
				bounce = math.abs(math.sin(k * math.pi * 2)) * 1.3 * (1 - k)
			end
			pos = o.Land + Vector3.new(0, 0.35 + bounce + math.sin(now * 3 + o.Spin) * 0.22, 0)
			if now >= o.ExpireAt then
				o.Phase = "Fade"
				o.T0 = now
			elseif rpos and now >= o.NoPredictUntil then
				local dx, dz = pos.X - rpos.X, pos.Z - rpos.Z
				if dx * dx + dz * dz <= r2 and math.abs(pos.Y - rpos.Y) < 14 then
					startMagnet(o)
				end
			end
			if rpos and (pos - rpos).Magnitude < rad + 25 then
				nearCount += 1
			end
		elseif o.Phase == "Magnet" then
			local a = math.clamp((now - o.MagnetT0) / Config.Drops.FlyTime, 0, 1)
			local target = if rpos then rpos else o.MagnetFrom
			local e = a * a -- accelerate in
			pos = o.MagnetFrom:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 2, 0)
			if a >= 1 then
				if o.Confirmed then
					eat(o, target)
					continue
				end
				o.Phase = "Held"
				o.HeldT0 = now
			end
		elseif o.Phase == "Held" then
			pos = if rpos then rpos else o.Pos
			if now - o.HeldT0 > 1.2 then
				-- server didn't agree (moved away too fast?) - send it back to where it was
				o.Phase = "Rest"
				o.T0 = now - 1
				o.NoPredictUntil = now + 1.5
				pos = o.Land
			end
		else -- Fade
			local a = math.clamp((now - o.T0) / 0.4, 0, 1)
			local s = o.Size * (1 - a)
			o.Part.Size = Vector3.new(s, s, s) + Vector3.new(0.05, 0.05, 0.05)
			pos = o.Land + Vector3.new(0, 0.35, 0)
			if a >= 1 then
				release(o)
				continue
			end
		end
		o.Pos = pos
		table.insert(parts, o.Part)
		-- hidden while held at the player (waiting for the server)
		table.insert(cframes, if o.Phase == "Held" then hidden else CFrame.new(pos) * CFrame.Angles(0, now * 2 + o.Spin, 0))
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- pickup radius ring: fades in while orbs are lying around nearby
	local want = if nearCount > 0 and rpos then 1 else 0
	ringAlpha += (want - ringAlpha) * math.min(1, dt * 6)
	if rpos and ringAlpha > 0.02 then
		local d = rad * 2
		if math.abs(ring.Size.X - d) > 0.05 then
			ring.Size = Vector3.new(d, 0.1, d)
			local pps = math.clamp(math.floor(600 / d), 6, 30)
			ringGui.PixelsPerStud = pps
			ringStroke.Thickness = math.max(2, 0.4 * pps)
		end
		ring.CFrame = CFrame.new(rpos.X, rpos.Y - 2.85, rpos.Z)
		ringStroke.Transparency = 1 - 0.55 * ringAlpha
		ringGui.Enabled = true
	elseif ringGui.Enabled then
		ringGui.Enabled = false
		ring.CFrame = hidden
	end
end

function Orbs.Count(): number
	local n = 0
	for _, o in orbs do
		if o.Phase == "Rest" or o.Phase == "Fly" then
			n += 1
		end
	end
	return n
end

function Orbs.Nearest(pos: Vector3): Vector3?
	local best, bestD = nil, math.huge
	for _, o in orbs do
		if o.Phase == "Rest" then
			local d = (o.Pos - pos).Magnitude
			if d < bestD then
				best, bestD = o.Pos, d
			end
		end
	end
	return best
end

function Orbs.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHOrbs"
	folder.Parent = workspace
	ring = Instance.new("Part")
	ring.Name = "PickupRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(28, 0.1, 28)
	ring.CFrame = hidden
	ring.Parent = folder
	ringGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Brightness = 2,
		Enabled = false,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = ringGui })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 6, Color = GREEN, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
end

function Orbs.Start()
	Net.Event("Drops").OnClientEvent:Connect(spawnDrops)
	Net.Event("Collect").OnClientEvent:Connect(onCollect)
	RunService.RenderStepped:Connect(step)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">Payouts</string>
              <string name="Source"><![CDATA[--!strict
-- v1.6 combat toasts: your share of a shared ghost/boss kill, and crew knockouts/recoveries.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("GH").Logic.Format)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)

local Payouts = {}

function Payouts.Init() end

function Payouts.Start()
	State.OnFx("Payout", function(d: any)
		local text = string.format("%s: %s damage -> +💚%s", string.upper(tostring(d.Name)), Format.Percent(tonumber(d.Pct) or 0), Format.Short(tonumber(d.Ecto) or 0))
		local shards = tonumber(d.Shards)
		if shards and shards > 0 then
			text ..= " +🔮" .. Format.Short(shards) .. " SHARDS"
		end
		Kit.Toast(text, "Good")
	end)
	State.OnFx("Knocked", function(d: any)
		Kit.Toast(string.format("%s knocked out! Back in %s", tostring(d.Name), Format.Time((tonumber(d.Until) or 0) - State.Now())), "Bad")
	end)
	State.OnFx("Recovered", function(d: any)
		Kit.Toast(tostring(d.Name) .. " is back!", "Good")
	end)
end

return Payouts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">PetFollowers</string>
              <string name="Source"><![CDATA[--!strict
-- Pets floating beside every player (read from the player's "Pets" attribute, e.g.
-- "GlowWisp,BooBat", plus "PetNames": the server-filtered nicknames, one per line).
-- v2 lineup (23 pets): each pet id has its own look builder in LOOKS (haunted objects and a
-- few cute creatures; rarer pets are more elaborate). Every look is <= 30 anchored parts
-- with no collisions/queries/touch/shadows, built around the body centre (front = -Z) and
-- kept within the old ghost pets' bounds (~2 studs wide, ~2.4 tall), all moved by one
-- RenderStepped loop with a single BulkMoveTo. The original nine ids, rarities and bonuses are
-- unchanged (save data); only their looks and display names changed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local WorldLabel = require(script.Parent.Parent.UI.WorldLabel)

local PetFollowers = {}

type Piece = { Part: Part, Offset: CFrame }
type Pet = { Pieces: { Piece }, Cur: CFrame?, Slot: number }
type Entry = { Pets: { Pet }, Conns: { RBXScriptConnection } }

-- beside/behind the shoulders (root space: +X right, +Z behind)
local SLOTS = { Vector3.new(-2.6, 1.4, 1.6), Vector3.new(2.6, 1.4, 1.6), Vector3.new(0, 2.6, 2.8) }
local FAR = 200 -- don't bother moving pets this far from the camera

local folder: Folder
local entries: { [Player]: Entry } = {}

local function part(pieces: { Piece }, shape: Enum.PartType, size: Vector3, color: Color3, offset: CFrame, neon: boolean?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	table.insert(pieces, { Part = p, Offset = offset })
	return p
end

local BALL, BLOCK, WEDGE, CYL = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Wedge, Enum.PartType.Cylinder

-- all look coordinates are in "pet units" (the old ghost body had diameter 3.5), shrunk by S
local S = 0.4
local EYE = Color3.fromRGB(25, 15, 40)
local WHITE = Color3.fromRGB(255, 255, 255)
local MOUTH = Color3.fromRGB(70, 20, 50)
local BLUSH = Color3.fromRGB(255, 150, 190)
local GOLD = Color3.fromRGB(255, 205, 60)
local CREAM = Color3.fromRGB(255, 244, 220)
local PINK = Color3.fromRGB(255, 170, 200)
local ECTO = Color3.fromRGB(120, 255, 150)
local IRON = Color3.fromRGB(62, 52, 82)

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x * S, y * S, z * S)
end
local function rot(x: number, y: number, z: number): CFrame -- degrees
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

type FaceOpts = { Blush: boolean?, Mouth: boolean?, Eye: Color3? }
-- Builder kit handed to every look. Sizes are in pet units; cf comes from at()/rot().
type Kit = {
	ball: (d: number, cf: CFrame, col: Color3, neon: boolean?, tr: number?) -> Part,
	block: (x: number, y: number, z: number, cf: CFrame, col: Color3, neon: boolean?, tr: number?) -> Part,
	cyl: (h: number, d: number, cf: CFrame, col: Color3, neon: boolean?, tr: number?) -> Part, -- upright
	disc: (h: number, d: number, cf: CFrame, col: Color3, neon: boolean?, tr: number?) -> Part, -- faces the front
	wedge: (x: number, y: number, z: number, cf: CFrame, col: Color3, neon: boolean?) -> Part,
	-- triangle seen from the front (ears, horns, eyes); side = -1 tall edge on the right, 1 on the left
	spike: (cf: CFrame, w: number, h: number, side: number, col: Color3, neon: boolean?) -> Part,
	-- cute face on a front surface at depth z: eyes (+shine), blush, round mouth (scale k)
	face: (x: number, y: number, z: number, k: number, opts: FaceOpts?) -> (),
}
-- A look returns the light colour and the top of the model (pet units, for the name tag).
type Look = (K: Kit) -> (Color3, number)

local LOOKS: { [string]: Look } = {}

-- COMMON: a cute little candle with a ghost-green flame
LOOKS.GlowWisp = function(K)
	local WAX = Color3.fromRGB(236, 226, 255)
	K.cyl(3.4, 3.0, at(0, -0.2, 0), WAX) -- body (PrimaryPart)
	K.cyl(0.22, 2.5, at(0, 1.52, 0), Color3.fromRGB(214, 198, 248)) -- melted pool
	K.cyl(0.9, 0.5, at(-1.05, 1.0, -0.95), WAX) -- wax drips
	K.ball(0.62, at(-1.05, 0.5, -0.95), WAX)
	K.cyl(1.4, 0.5, at(1.2, 0.8, -0.65), WAX)
	K.ball(0.62, at(1.2, 0.1, -0.65), WAX)
	K.block(0.16, 0.5, 0.16, at(0, 1.85, 0), Color3.fromRGB(60, 50, 40)) -- wick
	K.ball(1.15, at(0, 2.55, 0), ECTO, true) -- flame
	K.ball(0.6, at(0.08, 3.2, 0.05), ECTO, true, 0.25)
	K.cyl(0.35, 4.1, at(0, -2.05, 0), Color3.fromRGB(235, 175, 80)) -- brass dish
	K.ball(0.75, at(2.2, -1.9, 0.2), Color3.fromRGB(235, 175, 80)) -- dish handle
	K.face(0, 0.1, -1.5, 1)
	return ECTO, 3.5
end

-- COMMON: a teacup with a little ghost peeking out of the tea
LOOKS.BooBat = function(K)
	local CUP = Color3.fromRGB(255, 160, 200)
	local CHINA = Color3.fromRGB(232, 222, 250)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local STEAM = Color3.fromRGB(205, 160, 255)
	K.cyl(2.3, 3.4, at(0, -0.6, 0), CUP) -- cup (PrimaryPart)
	K.cyl(0.32, 3.6, at(0, 0.6, 0), CHINA) -- rim
	K.cyl(0.08, 3.1, at(0, 0.62, 0), Color3.fromRGB(190, 120, 90)) -- tea
	K.cyl(0.45, 2.2, at(0, -1.95, 0), CUP) -- foot
	K.cyl(0.25, 4.7, at(0, -2.25, 0), CHINA) -- saucer
	K.block(0.75, 0.28, 0.3, at(1.95, 0.05, 0), CHINA) -- handle loop
	K.block(0.28, 1.15, 0.3, at(2.3, -0.5, 0), CHINA)
	K.block(0.75, 0.28, 0.3, at(1.95, -1.05, 0), CHINA)
	K.ball(0.55, at(-0.9, -0.6, -1.62), WHITE) -- polka dots
	K.ball(0.45, at(0.7, -1.2, -1.6), WHITE)
	K.ball(2.4, at(0, 1.3, 0), GHOST) -- the ghost
	K.ball(0.75, at(-1.2, 0.85, -0.6), GHOST) -- arms on the rim
	K.ball(0.75, at(1.2, 0.85, -0.6), GHOST)
	K.face(0, 1.45, -1.12, 0.7)
	K.ball(0.55, at(0.9, 2.85, 0.4), STEAM, true, 0.3) -- steam puffs
	K.ball(0.38, at(1.25, 3.4, 0.55), STEAM, true, 0.4)
	return STEAM, 3.6
end

-- UNCOMMON: a grinning jack-o'-lantern sprite with a curly vine
LOOKS.JellyGhost = function(K)
	local ORANGE = Color3.fromRGB(255, 145, 45)
	local DEEP = Color3.fromRGB(235, 115, 30)
	local GLOW = Color3.fromRGB(255, 225, 90)
	K.ball(3.6, CFrame.identity, ORANGE) -- body (PrimaryPart)
	K.ball(3.0, at(-1.0, -0.15, 0.15), DEEP) -- ribs
	K.ball(3.0, at(1.0, -0.15, 0.15), DEEP)
	for _, s in { -1, 1 } do -- carved triangle eyes, lit from inside
		K.spike(at(0.62 * s - 0.2, 0.4, -1.72), 0.42, 0.75, -1, GLOW, true)
		K.spike(at(0.62 * s + 0.2, 0.4, -1.72), 0.42, 0.75, 1, GLOW, true)
		K.ball(0.5, at(1.25 * s, -0.3, -1.3), BLUSH)
	end
	K.block(1.5, 0.4, 0.3, at(0, -0.55, -1.68), GLOW, true) -- grin
	K.block(0.3, 0.22, 0.32, at(-0.3, -0.42, -1.74), DEEP) -- teeth
	K.block(0.3, 0.22, 0.32, at(0.35, -0.68, -1.74), DEEP)
	K.cyl(0.9, 0.6, at(0.1, 1.95, 0.1) * rot(0, 0, -12), Color3.fromRGB(110, 150, 60)) -- stem
	K.wedge(0.12, 0.6, 1.1, at(0.75, 1.95, 0.1) * rot(0, 90, -20), Color3.fromRGB(120, 205, 90)) -- leaf
	K.ball(0.32, at(-0.45, 2.15, 0.15), Color3.fromRGB(120, 205, 90)) -- curly vine
	K.ball(0.28, at(-0.8, 2.45, 0.15), Color3.fromRGB(120, 205, 90))
	K.ball(0.24, at(-0.6, 2.8, 0.15), Color3.fromRGB(120, 205, 90))
	return Color3.fromRGB(255, 170, 60), 3.0
end

-- UNCOMMON: a black kitty in a witch hat with a little ghost tail
LOOKS.PhantomKitty = function(K)
	local FUR = Color3.fromRGB(78, 62, 112)
	local HAT = Color3.fromRGB(125, 65, 200)
	K.ball(3.4, CFrame.identity, FUR) -- body (PrimaryPart)
	for _, s in { -1, 1 } do
		K.spike(at(1.15 * s, 1.5, -0.1) * rot(0, 0, -24 * s), 0.95, 1.3, s, FUR) -- ears
		K.spike(at(1.13 * s, 1.42, -0.22) * rot(0, 0, -24 * s), 0.5, 0.7, s, PINK)
		K.ball(0.8, at(0.7 * s, -1.4, -0.85), FUR) -- paws
	end
	K.face(0, 0.1, -1.6, 1.05, { Eye = Color3.fromRGB(110, 230, 140), Mouth = false })
	K.wedge(0.3, 0.22, 0.25, at(0, -0.25, -1.68) * rot(180, 0, 0), PINK) -- nose
	-- witch hat, tipped to one side
	local hat = at(-0.15, 1.75, 0.35) * rot(-14, 0, 10)
	K.cyl(0.18, 2.5, hat, HAT) -- brim
	K.cyl(0.3, 1.65, hat * at(0, 0.25, 0), ECTO) -- band
	K.cyl(0.6, 1.5, hat * at(0, 0.65, 0), HAT)
	K.cyl(0.7, 1.2, hat * at(0.05, 1.25, 0) * rot(0, 0, 8), HAT)
	K.cyl(0.6, 0.7, hat * at(0.2, 1.85, 0) * rot(0, 0, 22), HAT)
	K.ball(0.45, hat * at(0.42, 2.2, 0), GOLD) -- star tip
	K.ball(0.75, at(1.1, -0.9, 1.4), FUR) -- curly tail ending in a ghost wisp
	K.ball(0.6, at(1.5, -0.3, 1.7), FUR)
	K.ball(0.55, at(1.5, 0.35, 1.8), ECTO, true, 0.2)
	return Color3.fromRGB(150, 230, 170), 3.9
end

-- RARE: a living spellbook with a moon emblem and floating runes
LOOKS.MoonOwl = function(K)
	local COVER = Color3.fromRGB(105, 70, 190)
	local SPINE = Color3.fromRGB(80, 50, 150)
	local PAGE = Color3.fromRGB(255, 246, 225)
	local RUNE = Color3.fromRGB(120, 210, 255)
	local tilt = rot(4, 0, 6)
	K.block(2.9, 3.6, 1.0, tilt, PAGE) -- pages (PrimaryPart)
	K.block(3.2, 3.9, 0.28, tilt * at(-0.12, 0, -0.62), COVER) -- front cover
	K.block(3.2, 3.9, 0.28, tilt * at(-0.12, 0, 0.62), COVER) -- back cover
	K.cyl(3.9, 1.5, tilt * at(-1.6, 0, 0), SPINE) -- rounded spine
	K.block(0.55, 0.55, 0.3, tilt * at(1.25, 1.7, -0.7), GOLD) -- corner guards
	K.block(0.55, 0.55, 0.3, tilt * at(1.25, -1.7, -0.7), GOLD)
	K.block(0.4, 0.7, 1.6, tilt * at(1.55, 0, 0), GOLD) -- clasp
	K.ball(0.5, tilt * at(1.55, 0, -0.82), ECTO, true) -- clasp gem
	K.ball(0.75, tilt * at(-0.1, 1.15, -0.8), GOLD, true) -- moon emblem
	K.ball(0.6, tilt * at(0.08, 1.25, -0.88), COVER) -- carves the crescent
	K.block(0.3, 1.0, 0.06, tilt * at(0.6, -2.3, 0.1) * rot(0, 0, 8), Color3.fromRGB(255, 90, 130)) -- bookmark
	-- the face sits on the tilted cover
	local f = tilt * at(-0.1, -0.15, -0.78)
	for _, s in { -1, 1 } do
		K.ball(0.8, f * at(0.55 * s, 0, 0), EYE)
		K.ball(0.3, f * at(0.55 * s + 0.15, 0.15, -0.3), WHITE)
		K.ball(0.4, f * at(0.95 * s, -0.42, -0.05), BLUSH)
	end
	K.disc(0.2, 0.45, f * at(0, -0.55, 0), MOUTH)
	K.ball(0.42, at(2.5, 1.5, 0.2), RUNE, true, 0.1) -- floating runes
	K.ball(0.32, at(-2.7, 0.9, 0.3), RUNE, true, 0.15)
	K.ball(0.36, at(2.3, -1.4, 0.4), ECTO, true, 0.1)
	return Color3.fromRGB(140, 140, 255), 2.4
end

-- RARE: a bubbling cauldron with a cheeky imp swimming in the ecto
LOOKS.SpiritFox = function(K)
	local IMP = Color3.fromRGB(255, 120, 140)
	local HORN = Color3.fromRGB(255, 236, 170)
	K.ball(3.5, at(0, -0.75, 0), IRON) -- pot (PrimaryPart)
	K.cyl(0.42, 3.1, at(0, 0.85, 0), Color3.fromRGB(85, 72, 110)) -- rim
	K.cyl(0.1, 2.7, at(0, 1.07, 0), ECTO, true) -- brew
	for i = 0, 2 do -- legs
		local a = math.rad(90 + i * 120)
		K.ball(0.75, at(math.cos(a) * 1.1, -2.45, math.sin(a) * 1.1), IRON)
	end
	K.ball(0.55, at(-1.85, -0.2, 0), Color3.fromRGB(85, 72, 110)) -- side lugs
	K.ball(0.55, at(1.85, -0.2, 0), Color3.fromRGB(85, 72, 110))
	K.ball(2.1, at(0, 1.55, 0.1), IMP) -- the imp
	for _, s in { -1, 1 } do
		K.spike(at(0.6 * s, 2.65, 0.1), 0.45, 0.75, s, HORN)
		K.ball(0.6, at(1.1 * s, 1.15, -0.85), IMP) -- hands on the rim
	end
	K.face(0, 1.6, -0.92, 0.62)
	K.ball(0.5, at(-1.0, 2.2, 0.5), ECTO, true, 0.2) -- bubbles
	K.ball(0.32, at(-1.3, 2.75, 0.55), ECTO, true, 0.3)
	K.ball(0.5, at(0.7, 0.55, -1.52), Color3.fromRGB(150, 245, 160)) -- spill
	K.ball(0.45, at(1.45, 1.75, 0.8), IMP) -- pointy tail
	K.spike(at(1.75, 2.15, 0.8), 0.45, 0.5, 1, IMP)
	return ECTO, 3.1
end

-- EPIC: a mini flying saucer with a ghost pilot under a glass dome
LOOKS.SpookyDrake = function(K)
	local HULL = Color3.fromRGB(200, 196, 230)
	local TRIM = Color3.fromRGB(150, 90, 235)
	K.cyl(0.65, 5.0, at(0, -0.45, 0), HULL) -- saucer (PrimaryPart)
	K.ball(3.0, at(0, -0.85, 0), Color3.fromRGB(165, 160, 205)) -- belly
	K.cyl(0.3, 4.1, at(0, -0.02, 0), TRIM) -- trim ring
	K.ball(1.9, at(0, 0.55, 0), WHITE) -- ghost pilot
	K.face(0, 0.65, -0.92, 0.55, { Blush = true })
	K.ball(0.55, at(1.0, 1.15, -0.25), WHITE) -- waving arm
	K.ball(2.9, at(0, 0.45, 0), Color3.fromRGB(170, 235, 255), false, 0.6) -- glass dome
	K.cyl(0.9, 0.15, at(0, 2.15, 0), Color3.fromRGB(120, 115, 150)) -- antenna
	K.ball(0.42, at(0, 2.65, 0), ECTO, true)
	for i = 0, 5 do -- rim lights, ecto green / candy pink
		local a = math.rad(i * 60 + 15)
		K.ball(0.45, at(math.cos(a) * 2.45, -0.45, math.sin(a) * 2.45), if i % 2 == 0 then ECTO else Color3.fromRGB(255, 120, 210), true)
	end
	K.cyl(1.5, 1.6, at(0, -2.2, 0), ECTO, true, 0.75) -- tractor beam
	return Color3.fromRGB(180, 130, 255), 2.9
end

-- LEGENDARY: a tiny crowned reaper with a glowing scythe and orbiting souls
LOOKS.GhostPhoenix = function(K)
	local ROBE = Color3.fromRGB(92, 70, 150)
	local VOID = Color3.fromRGB(18, 10, 32)
	local SOUL = Color3.fromRGB(140, 255, 190)
	K.ball(3.0, at(0, 0.75, 0), ROBE) -- hood (PrimaryPart)
	K.ball(3.2, at(0, -0.8, 0.1), ROBE) -- robe
	K.ball(1.2, at(-0.55, -2.15, 0.3), ROBE) -- wispy hem
	K.ball(1.0, at(0.55, -2.3, 0.25), ROBE)
	K.ball(0.8, at(0, -2.6, 0.55), ROBE)
	K.ball(1.0, at(0.2, 2.05, 0.75), ROBE) -- hood point
	K.ball(2.15, at(0, 0.65, -0.62), VOID) -- dark face
	for _, s in { -1, 1 } do
		K.ball(0.5, at(0.4 * s, 0.75, -1.6), SOUL, true) -- glowing eyes
		K.ball(0.3, at(0.72 * s, 0.35, -1.55), BLUSH)
		K.spike(at(0.42 * s, 2.5, -0.1), 0.4, 0.7, s, GOLD) -- crown points
	end
	K.ball(0.4, at(0, 2.75, -0.2), Color3.fromRGB(255, 90, 140), true) -- crown gem
	K.cyl(0.32, 1.45, at(0, 2.2, -0.05), GOLD) -- crown band
	K.ball(0.5, at(0, -0.05, -1.55), GOLD) -- cloak clasp
	-- scythe in the right hand
	local sc = at(2.0, -0.3, -0.6) * rot(0, 0, -6)
	K.cyl(5.2, 0.28, sc, Color3.fromRGB(125, 85, 60))
	K.ball(0.75, at(1.7, -0.5, -0.95), CREAM) -- hand
	local top = sc * at(0, 2.55, 0)
	K.ball(0.4, top, GOLD) -- scythe cap
	K.block(1.9, 0.55, 0.16, top * at(-0.85, 0.05, 0) * rot(0, 0, -8), SOUL, true) -- curved blade
	K.block(1.2, 0.45, 0.16, top * at(-2.15, -0.35, 0) * rot(0, 0, -32), SOUL, true)
	K.ball(0.4, at(-2.3, 1.4, 0.4), Color3.fromRGB(120, 220, 255), true, 0.1) -- orbiting souls
	K.ball(0.34, at(-2.0, -1.2, -0.6), Color3.fromRGB(255, 140, 220), true, 0.1)
	return Color3.fromRGB(255, 200, 90), 3.3
end

-- LEGENDARY (event): a haunted lantern with a little flame spirit inside
LOOKS.LanternSpirit = function(K)
	local FLAME = Color3.fromRGB(255, 210, 90)
	local BOW = Color3.fromRGB(170, 90, 255)
	K.cyl(2.9, 2.3, at(0, -0.1, 0), Color3.fromRGB(255, 240, 200), false, 0.82) -- glass (PrimaryPart)
	K.ball(1.7, at(0, -0.35, 0), FLAME) -- flame spirit
	K.ball(0.95, at(0.05, 0.6, 0.05), Color3.fromRGB(255, 170, 60), true)
	for _, s in { -1, 1 } do
		K.ball(0.42, at(0.33 * s, -0.25, -0.72), EYE)
		K.ball(0.3, at(0.62 * s, -0.55, -0.6), BLUSH)
	end
	K.disc(0.15, 0.3, at(0, -0.62, -0.8), MOUTH)
	for _, x in { -1, 1 } do -- cage bars
		for _, z in { -1, 1 } do
			K.block(0.22, 2.9, 0.22, at(0.82 * x, -0.1, 0.82 * z), IRON)
		end
	end
	K.cyl(0.42, 2.7, at(0, 1.55, 0), IRON) -- roof
	K.cyl(0.42, 1.7, at(0, 1.95, 0), IRON)
	K.block(0.8, 0.22, 0.22, at(0, 2.95, 0), IRON) -- handle arch
	K.block(0.22, 0.8, 0.22, at(-0.5, 2.55, 0) * rot(0, 0, -25), IRON)
	K.block(0.22, 0.8, 0.22, at(0.5, 2.55, 0) * rot(0, 0, 25), IRON)
	K.cyl(0.42, 2.7, at(0, -1.75, 0), IRON) -- base
	K.cyl(0.3, 1.8, at(0, -2.1, 0), IRON)
	K.ball(0.55, at(0, 2.05, -0.95), BOW) -- event bow
	K.wedge(0.15, 0.55, 0.6, at(-0.45, 2.05, -0.95) * rot(0, 90, 0), BOW)
	K.wedge(0.15, 0.55, 0.6, at(0.45, 2.05, -0.95) * rot(0, -90, 0), BOW)
	return Color3.fromRGB(255, 200, 80), 3.1
end

-- COMMON: a wobbly ecto slime with bubbles inside and a puddle
LOOKS.EctoSlime = function(K)
	local SLIME = Color3.fromRGB(120, 235, 140)
	local DEEP = Color3.fromRGB(80, 200, 110)
	K.ball(3.6, at(0, -0.5, 0), SLIME) -- body (PrimaryPart)
	K.ball(2.6, at(0, 0.7, 0.1), SLIME)
	K.ball(1.2, at(0, 1.85, 0.2), SLIME) -- the little top curl
	K.ball(0.7, at(0.3, 2.5, 0.25), SLIME)
	K.cyl(0.3, 4.6, at(0, -2.15, 0), DEEP) -- puddle
	K.ball(0.9, at(-1.6, -1.6, -0.6), SLIME) -- drips
	K.ball(0.7, at(1.7, -1.75, -0.3), SLIME)
	K.ball(0.7, at(-0.8, 1.15, -0.9), WHITE, false, 0.35) -- shine
	K.ball(0.45, at(1.15, 0.25, -1.15), ECTO, true, 0.2) -- bubbles inside
	K.ball(0.32, at(0.95, -1.15, -1.45), ECTO, true, 0.2)
	K.face(0, -0.15, -1.7, 1)
	return ECTO, 2.9
end

-- COMMON: a ghost-shaped balloon with little bat wings, on a string
LOOKS.BooBalloon = function(K)
	local SKY = Color3.fromRGB(150, 210, 255)
	local KNOT = Color3.fromRGB(110, 170, 235)
	K.ball(3.4, at(0, 0.9, 0), SKY) -- balloon (PrimaryPart)
	for i, x in { -0.9, 0, 0.9 } do -- scalloped ghost hem
		K.ball(1.1, at(x, if i == 2 then -0.65 else -0.45, 0.1), SKY)
	end
	K.ball(0.5, at(0, -1.15, 0.1), KNOT) -- knot
	K.block(0.1, 1.6, 0.1, at(0.08, -2.0, 0.1) * rot(0, 0, 5), Color3.fromRGB(240, 240, 250)) -- string
	K.ball(0.45, at(0.15, -2.85, 0.1), GOLD, true) -- star charm
	K.ball(0.8, at(-0.8, 1.6, -1.05), WHITE, false, 0.3) -- shine
	for _, s in { -1, 1 } do
		K.spike(at(1.95 * s, 1.45, 0.2) * rot(0, 0, -15 * s), 1.1, 0.95, s, Color3.fromRGB(120, 95, 185)) -- bat wings
		K.spike(at(2.0 * s, 1.0, 0.2) * rot(0, 0, 10 * s), 0.8, 0.6, s, Color3.fromRGB(120, 95, 185))
	end
	K.face(0, 0.75, -1.65, 1)
	return Color3.fromRGB(170, 220, 255), 2.6
end

-- UNCOMMON: a patchwork teddy with one button eye and a ghost wisp escaping a seam
LOOKS.CursedTeddy = function(K)
	local FUR = Color3.fromRGB(160, 120, 200)
	local INNER = Color3.fromRGB(255, 190, 215)
	local MUZZLE = Color3.fromRGB(245, 225, 235)
	local STITCH = Color3.fromRGB(45, 30, 60)
	K.ball(2.7, at(0, 0.7, 0), FUR) -- head (PrimaryPart)
	K.ball(2.6, at(0, -1.1, 0.15), FUR) -- tummy
	for _, s in { -1, 1 } do
		K.ball(1.0, at(1.05 * s, 1.85, 0.1), FUR) -- ears
		K.ball(0.55, at(1.05 * s, 1.85, -0.25), INNER)
		K.ball(0.9, at(1.3 * s, -0.8, -0.35), FUR) -- arms
		K.ball(1.0, at(0.65 * s, -2.15, -0.35), FUR) -- feet
		K.ball(0.35, at(0.95 * s, 0.4, -1.0), BLUSH)
	end
	K.ball(1.1, at(0, 0.3, -1.05), MUZZLE) -- muzzle
	K.ball(0.38, at(0, 0.55, -1.55), STITCH) -- nose
	K.block(0.42, 0.08, 0.1, at(0, 0.05, -1.55), STITCH) -- stitched smile
	K.disc(0.18, 0.62, at(0.55, 1.0, -1.18), Color3.fromRGB(110, 220, 210)) -- button eye
	K.block(0.6, 0.13, 0.1, at(-0.55, 1.0, -1.22) * rot(0, 0, 45), STITCH) -- stitched X eye
	K.block(0.6, 0.13, 0.1, at(-0.55, 1.0, -1.22) * rot(0, 0, -45), STITCH)
	K.block(0.75, 0.75, 0.1, at(0.55, -0.8, -1.33) * rot(0, 0, 15), Color3.fromRGB(150, 220, 140)) -- patch
	K.ball(0.5, at(-0.85, 2.3, 0.35), ECTO, true, 0.15) -- ghost wisp
	return Color3.fromRGB(190, 150, 255), 2.6
end

-- UNCOMMON: a round little mummy with glowing eyes peeking out of its wraps
LOOKS.MiniMummy = function(K)
	local WRAP = Color3.fromRGB(235, 225, 195)
	local WRAP2 = Color3.fromRGB(212, 198, 162)
	local GAP = Color3.fromRGB(55, 40, 45)
	local EYEGLOW = Color3.fromRGB(200, 255, 120)
	K.ball(3.4, CFrame.identity, WRAP) -- body (PrimaryPart)
	K.cyl(0.35, 3.4, at(0, -0.4, 0) * rot(0, 0, 8), WRAP2) -- bandage bands
	K.cyl(0.35, 2.95, at(0, 0.95, 0) * rot(0, 0, -7), WRAP2)
	K.cyl(0.35, 2.85, at(0, -1.1, 0) * rot(0, 0, 5), WRAP2)
	K.cyl(0.7, 3.44, at(0, 0.35, 0), GAP) -- the gap the eyes peek through
	for _, s in { -1, 1 } do
		K.ball(0.6, at(0.5 * s, 0.35, -1.72), EYEGLOW, true)
		K.ball(0.2, at(0.5 * s + 0.12, 0.47, -1.98), WHITE)
		K.ball(0.4, at(1.0 * s, -0.25, -1.4), BLUSH)
		K.ball(0.9, at(1.45 * s, -0.4, -1.0), WRAP) -- arms reaching for a hug
		K.ball(0.8, at(0.6 * s, -1.65, -0.5), WRAP) -- feet
	end
	K.disc(0.2, 0.42, at(0, -0.45, -1.66), MOUTH)
	K.block(0.45, 0.12, 1.3, at(0.9, 1.35, 1.3) * rot(25, 0, 0), WRAP2) -- trailing wrap
	K.ball(0.45, at(-0.95, 2.0, 0.3), EYEGLOW, true, 0.2) -- ghost wisps
	K.ball(0.3, at(-1.25, 2.45, 0.35), EYEGLOW, true, 0.35)
	return EYEGLOW, 2.7
end

-- RARE: an ornate hand mirror with a ghost looking back from the glass
LOOKS.HauntedMirror = function(K)
	local GLASS = Color3.fromRGB(200, 190, 255)
	local LILAC = Color3.fromRGB(215, 160, 255)
	K.disc(0.3, 3.5, at(0, 0.8, 0.08), GOLD) -- frame (PrimaryPart)
	K.disc(0.2, 3.0, at(0, 0.8, 0), GLASS) -- glass
	K.disc(0.1, 1.9, at(0, 1.0, -0.13), WHITE, false, 0.15) -- the ghost in the glass
	K.disc(0.1, 1.1, at(0.35, -0.05, -0.12), WHITE, false, 0.15)
	K.face(0, 0.95, -0.35, 0.7)
	K.ball(0.7, at(0, 2.75, 0), Color3.fromRGB(255, 90, 170), true) -- crest gem
	K.spike(at(-0.5, 2.6, 0.05), 0.45, 0.7, -1, GOLD)
	K.spike(at(0.5, 2.6, 0.05), 0.45, 0.7, 1, GOLD)
	K.ball(0.55, at(-1.85, 0.8, 0.05), GOLD) -- side knobs
	K.ball(0.55, at(1.85, 0.8, 0.05), GOLD)
	K.ball(0.6, at(0, -0.95, 0.05), GOLD) -- neck
	K.cyl(1.4, 0.5, at(0, -1.65, 0.05), GOLD) -- handle
	K.ball(0.7, at(0, -2.45, 0.05), Color3.fromRGB(150, 90, 235)) -- handle knob
	K.ball(0.35, at(2.15, 2.1, -0.2), LILAC, true, 0.1) -- sparkles
	K.ball(0.3, at(-2.2, -0.5, -0.1), LILAC, true, 0.1)
	return Color3.fromRGB(200, 150, 255), 3.1
end

-- RARE: a treasure chest mimic, lid open, tongue out, ecto gems spilling
LOOKS.TreasureMimic = function(K)
	local WOOD = Color3.fromRGB(150, 90, 50)
	local DARKWOOD = Color3.fromRGB(110, 62, 36)
	local TONGUE = Color3.fromRGB(255, 120, 160)
	K.block(3.6, 1.9, 2.6, at(0, -0.9, 0), WOOD) -- chest (PrimaryPart)
	local lid = at(0, 0.05, 1.3) * rot(40, 0, 0) -- hinge at the back top edge
	K.block(3.6, 0.6, 2.6, lid * at(0, 0.3, -1.3), WOOD)
	K.block(0.4, 0.66, 2.66, lid * at(-1.2, 0.3, -1.3), GOLD) -- lid trims
	K.block(0.4, 0.66, 2.66, lid * at(1.2, 0.3, -1.3), GOLD)
	K.block(0.4, 1.95, 2.65, at(-1.2, -0.9, 0), GOLD) -- chest trims
	K.block(0.4, 1.95, 2.65, at(1.2, -0.9, 0), GOLD)
	K.block(3.2, 0.12, 2.2, at(0, 0.02, 0), MOUTH) -- dark inside
	for i, x in { -0.75, 0.75 } do
		K.spike(at(x, 0.3, -1.15), 0.45, 0.5, if i == 1 then -1 else 1, WHITE) -- bottom teeth
		K.spike(lid * at(x, -0.2, -2.35) * rot(0, 0, 180), 0.45, 0.45, if i == 1 then 1 else -1, WHITE) -- top teeth
		K.ball(0.75, lid * at(x * 0.85, 0.35, -2.7), EYE) -- eyes on the lid
		K.ball(0.28, lid * at(x * 0.85 + 0.15, 0.5, -2.98), WHITE)
		K.ball(0.7, at(x * 1.7, -1.95, -0.8), DARKWOOD) -- stubby feet
	end
	K.ball(1.1, at(0.35, 0.05, -1.2), TONGUE) -- tongue
	K.ball(0.8, at(0.45, -0.45, -1.5), TONGUE)
	K.ball(0.7, at(-1.0, 0.3, -0.4), ECTO, true) -- gem inside
	K.ball(0.45, at(2.2, 1.4, 0.2), ECTO, true, 0.1) -- floating ecto gems
	K.ball(0.35, at(-2.1, 1.8, 0.4), ECTO, true, 0.1)
	return ECTO, 2.2
end

-- EPIC: a haunted alarm clock with bat wings, a ghost face and glowing hands
LOOKS.HauntedClock = function(K)
	local CASE = Color3.fromRGB(120, 70, 200)
	local HAND = Color3.fromRGB(255, 120, 210)
	local WING = Color3.fromRGB(80, 50, 140)
	K.disc(1.4, 3.6, at(0, 0.1, 0), CASE) -- case (PrimaryPart)
	K.disc(0.12, 3.25, at(0, 0.1, -0.66), ECTO, true) -- glowing rim
	K.disc(0.2, 3.0, at(0, 0.1, -0.68), CREAM) -- dial
	for _, s in { -1, 1 } do
		K.ball(1.2, at(1.15 * s, 1.95, 0.1), GOLD) -- bells
		K.block(0.3, 0.9, 0.3, at(1.0 * s, -1.8, 0) * rot(0, 0, 25 * s), GOLD) -- legs
		K.spike(at(2.0 * s, 0.85, 0.2) * rot(0, 0, -15 * s), 1.1, 1.0, s, WING) -- bat wings
	end
	local hub = at(0, 0.1, -0.84)
	K.block(0.15, 1.1, 0.08, hub * rot(0, 0, -30) * at(0, 0.55, 0), HAND, true) -- minute hand
	K.block(0.18, 0.7, 0.08, hub * rot(0, 0, 75) * at(0, 0.35, 0), HAND, true) -- hour hand
	K.ball(0.3, hub, GOLD)
	for _, p in { Vector2.new(0, 1.3), Vector2.new(1.25, 0.1), Vector2.new(-1.25, 0.1), Vector2.new(0, -1.15) } do
		K.block(0.16, 0.36, 0.08, at(p.X, p.Y, -0.8), Color3.fromRGB(90, 60, 130)) -- 12 / 3 / 9 / 6
	end
	K.face(0, -0.4, -0.95, 0.65)
	K.ball(0.4, at(-2.2, 2.2, -0.2), HAND, true, 0.15) -- time sparkle
	return Color3.fromRGB(255, 120, 210), 2.6
end

-- EPIC: a little ghost steam engine puffing ecto smoke, with a ghost driver
LOOKS.GhostTrain = function(K)
	local CAB = Color3.fromRGB(130, 60, 190)
	local BOILER = Color3.fromRGB(70, 60, 95)
	local WHEEL = Color3.fromRGB(255, 120, 210)
	K.disc(3.0, 2.4, at(0, -0.2, -0.4), BOILER) -- boiler (PrimaryPart)
	K.disc(0.2, 2.3, at(0, -0.2, -1.95), CREAM) -- ghost face plate
	K.face(0, -0.15, -2.1, 0.8)
	K.block(2.6, 2.4, 1.6, at(0, 0.3, 1.6), CAB) -- cab
	K.block(3.0, 0.3, 2.0, at(0, 1.6, 1.6), GOLD) -- cab roof
	K.ball(1.2, at(0.55, 0.95, 0.75), WHITE) -- ghost driver peeking out
	K.cyl(1.0, 0.7, at(0, 1.35, -1.2), BOILER) -- chimney
	K.cyl(0.3, 1.05, at(0, 1.9, -1.2), GOLD)
	K.ball(0.8, at(0.2, 2.55, -1.0), ECTO, true, 0.3) -- ecto smoke
	K.ball(0.6, at(0.7, 3.1, -0.6), ECTO, true, 0.4)
	K.ball(0.45, at(1.15, 3.5, -0.3), ECTO, true, 0.5)
	K.ball(0.8, at(0, 1.0, 0.1), GOLD) -- steam dome
	for _, x in { -1.25, 1.25 } do -- wheels
		for _, z in { -1.0, 1.4 } do
			K.cyl(0.3, 1.2, at(x, -1.55, z) * rot(0, 0, -90), WHEEL)
		end
	end
	K.wedge(2.2, 0.7, 0.9, at(0, -1.55, -2.1), GOLD) -- cowcatcher
	K.ball(0.5, at(0, 1.05, -1.75), Color3.fromRGB(255, 230, 120), true) -- headlamp
	return Color3.fromRGB(120, 255, 150), 3.7
end

-- LEGENDARY: a glowing crystal skull with a crystal crown and orbiting gems
LOOKS.CrystalSkull = function(K)
	local CRYSTAL = Color3.fromRGB(150, 230, 255)
	local CORE = Color3.fromRGB(120, 220, 255)
	local VOID = Color3.fromRGB(30, 20, 60)
	local GEM = Color3.fromRGB(255, 110, 200)
	K.ball(3.4, at(0, 0.4, 0), CRYSTAL, false, 0.25) -- skull (PrimaryPart)
	K.ball(1.6, at(0, 0.5, 0.25), CORE, true) -- glowing core
	K.block(2.0, 0.9, 1.6, at(0, -1.35, -0.35), CRYSTAL, false, 0.25) -- jaw
	for _, s in { -1, 1 } do
		K.ball(1.2, at(0.85 * s, -0.75, -0.45), CRYSTAL, false, 0.25) -- cheeks
		K.ball(1.0, at(0.62 * s, 0.25, -1.3), VOID) -- big eye sockets
		K.ball(0.45, at(0.62 * s, 0.22, -1.72), GEM, true) -- glowing pupils
		K.ball(0.22, at(0.62 * s + 0.15, 0.42, -1.85), WHITE)
		K.ball(0.35, at(1.15 * s, -0.4, -1.15), BLUSH)
	end
	K.wedge(0.3, 0.35, 0.3, at(0, -0.4, -1.62) * rot(180, 0, 0), VOID) -- nose
	for _, x in { -0.45, 0, 0.45 } do
		K.block(0.38, 0.34, 0.15, at(x, -1.05, -1.17), WHITE) -- teeth
	end
	K.cyl(0.35, 1.9, at(0, 1.95, 0.05), GOLD) -- crown band
	K.spike(at(0, 2.75, 0.05), 0.7, 1.3, 1, CORE, true) -- crystal crown
	K.spike(at(-0.65, 2.5, 0.1) * rot(0, 0, 18), 0.5, 1.0, -1, CORE, true)
	K.spike(at(0.65, 2.5, 0.1) * rot(0, 0, -18), 0.5, 1.0, 1, CORE, true)
	K.ball(0.45, at(2.3, 1.2, 0.2), GEM, true, 0.1) -- orbiting gems
	K.ball(0.4, at(-2.3, 0.3, -0.3), ECTO, true, 0.1)
	K.ball(0.38, at(1.9, -1.6, 0.4), GOLD, true, 0.1)
	return CORE, 3.3
end

-- Cursed Egg top tier (unlocked at Boss Tower checkpoint 50): 2 Mythic, 2 Secret, 1 Ultra
-- MYTHIC: a tiny ghost king sitting on a floating crimson-and-gold throne, holding a scepter
LOOKS.PhantomKing = function(K)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local VELVET = Color3.fromRGB(205, 45, 90)
	local RUBY = Color3.fromRGB(255, 70, 120)
	K.ball(2.5, at(0, 0.55, -0.35), GHOST) -- ghost king (PrimaryPart)
	K.ball(1.9, at(0, -0.4, -0.6), GHOST) -- ghost lap
	K.face(0, 0.5, -1.52, 0.8)
	K.cyl(0.4, 1.35, at(0, 1.85, -0.35), GOLD) -- crown band
	K.spike(at(0, 2.45, -0.35), 0.5, 0.9, 1, GOLD) -- crown points
	for _, s in { -1, 1 } do
		K.spike(at(0.48 * s, 2.3, -0.35), 0.4, 0.65, s, GOLD)
	end
	K.ball(0.38, at(0, 1.85, -1.05), RUBY, true) -- crown gem
	-- throne
	K.block(3.2, 3.4, 0.5, at(0, 0.75, 1.0), VELVET) -- back
	K.block(3.6, 0.45, 0.75, at(0, 2.55, 1.0), GOLD) -- top rail
	for _, s in { -1, 1 } do
		K.ball(0.7, at(1.8 * s, 2.85, 1.0), GOLD) -- finials
		K.block(0.55, 1.0, 2.5, at(1.65 * s, -0.55, 0.05), GOLD) -- armrests
	end
	K.ball(0.7, at(0, 3.0, 0.85), RUBY, true) -- throne jewel
	K.block(3.4, 0.8, 2.7, at(0, -1.3, 0.05), GOLD) -- seat base
	K.block(3.0, 0.35, 2.3, at(0, -0.8, -0.05), VELVET) -- cushion
	K.cyl(0.15, 3.2, at(0, -2.2, 0.05), RUBY, true, 0.35) -- floating glow under the throne
	-- scepter in the right hand
	K.ball(0.62, at(1.05, -0.2, -1.3), GHOST) -- hand
	K.cyl(2.4, 0.2, at(1.25, 0.45, -1.35) * rot(0, 0, -12), GOLD)
	K.ball(0.6, at(1.52, 1.75, -1.35), Color3.fromRGB(255, 120, 200), true) -- scepter orb
	K.ball(0.45, at(-2.45, 1.6, -0.3), GOLD, true, 0.05) -- orbiting coin-sparks
	K.ball(0.4, at(2.55, -1.0, 0.2), RUBY, true, 0.1)
	return Color3.fromRGB(255, 90, 130), 3.35
end

-- MYTHIC: a mini merry-go-round: tiny ghosts ride a pumpkin, a bat and a teacup under a striped
-- canopy ringed with warm bulbs
LOOKS.GhostCarousel = function(K)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local CANDY = Color3.fromRGB(255, 120, 170)
	local PLUM = Color3.fromRGB(120, 60, 170)
	local ORANGE = Color3.fromRGB(255, 145, 45)
	local BAT = Color3.fromRGB(85, 60, 125)
	local BULB = Color3.fromRGB(255, 225, 140)
	K.cyl(4.2, 0.45, CFrame.identity, GOLD) -- centre pole (PrimaryPart)
	K.cyl(0.45, 4.4, at(0, -1.85, 0), PLUM) -- platform
	K.cyl(0.2, 4.6, at(0, -2.1, 0), GOLD) -- gold trim
	K.cyl(0.4, 4.6, at(0, 1.9, 0), CANDY) -- striped canopy
	K.cyl(0.35, 3.4, at(0, 2.25, 0), CREAM)
	K.cyl(0.3, 2.2, at(0, 2.55, 0), CANDY)
	K.ball(0.6, at(0, 2.95, 0), GOLD) -- top finial
	for i = 0, 3 do -- warm bulbs around the canopy rim
		local a = math.rad(i * 90 + 45)
		K.ball(0.35, at(math.cos(a) * 2.3, 1.62, math.sin(a) * 2.3), BULB, true, 0.2)
	end
	-- front rider: a ghost on a pumpkin
	K.cyl(3.5, 0.15, at(0, 0, -1.5), GOLD)
	K.ball(1.1, at(0, -0.95, -1.5), ORANGE)
	K.ball(1.2, at(0, -0.1, -1.5), GHOST)
	K.face(0, -0.05, -2.08, 0.38)
	-- left rider: a ghost on a little bat
	K.cyl(3.5, 0.15, at(-1.3, 0, 0.75), GOLD)
	K.ball(0.95, at(-1.3, -0.55, 0.75), BAT)
	K.spike(at(-1.85, -0.45, 0.75), 0.6, 0.5, -1, BAT)
	K.spike(at(-0.75, -0.45, 0.75), 0.6, 0.5, 1, BAT)
	K.ball(1.0, at(-1.3, 0.25, 0.75), GHOST)
	-- right rider: a ghost in a teacup
	K.cyl(3.5, 0.15, at(1.3, 0, 0.75), GOLD)
	K.cyl(0.7, 1.1, at(1.3, -1.15, 0.75), PINK)
	K.ball(1.0, at(1.3, -0.45, 0.75), GHOST)
	return Color3.fromRGB(255, 200, 130), 3.25
end

-- SECRET: an open music box: a tiny ghost ballerina in a pink tutu twirls on a gold stage,
-- with floating music notes and a gold wind-up key
LOOKS.GhostMusicBox = function(K)
	local WOOD = Color3.fromRGB(150, 60, 110)
	local VELVET = Color3.fromRGB(255, 160, 205)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local TUTU = Color3.fromRGB(255, 185, 220)
	local NOTE = Color3.fromRGB(205, 175, 255)
	K.block(4.0, 1.6, 2.8, at(0, -1.3, 0), WOOD) -- box (PrimaryPart)
	K.block(4.0, 2.4, 0.25, at(0, 0.55, 1.5) * rot(15, 0, 0), WOOD) -- open lid
	K.block(3.5, 2.0, 0.08, at(0, 0.55, 1.36) * rot(15, 0, 0), VELVET) -- velvet inside the lid
	K.block(4.15, 0.2, 2.95, at(0, -0.5, 0), GOLD) -- gold trims
	K.block(4.15, 0.25, 2.95, at(0, -2.15, 0), GOLD)
	K.ball(0.5, at(0, -1.3, -1.42), GOLD) -- front medallion
	K.block(3.7, 0.1, 2.5, at(0, -0.42, 0), VELVET) -- velvet top
	K.cyl(0.25, 1.2, at(0, -0.3, -0.2), GOLD) -- little stage
	-- the ghost ballerina, arms up
	K.ball(1.5, at(0, 0.85, -0.2), GHOST)
	K.cyl(0.25, 2.0, at(0, 0.25, -0.2), TUTU) -- tutu
	K.cyl(0.18, 1.6, at(0, 0.1, -0.2), VELVET)
	K.ball(0.55, at(0, -0.05, -0.2), GHOST) -- wispy tail on the stage
	K.ball(0.38, at(-0.55, 1.75, -0.2), GHOST) -- hands over the head
	K.ball(0.38, at(0.55, 1.75, -0.2), GHOST)
	K.ball(0.3, at(0.45, 1.45, -0.6), Color3.fromRGB(255, 110, 170)) -- hair bow
	K.face(0, 0.85, -0.92, 0.5)
	-- floating music notes
	K.ball(0.45, at(-2.3, 1.0, -0.3), NOTE, true, 0.2)
	K.block(0.1, 0.8, 0.1, at(-2.12, 1.4, -0.3), NOTE, true, 0.2)
	K.ball(0.4, at(2.2, 1.9, 0), NOTE, true, 0.2)
	K.block(0.1, 0.7, 0.1, at(2.36, 2.25, 0), NOTE, true, 0.2)
	-- gold wind-up key on the side
	K.block(0.4, 0.15, 0.15, at(2.2, -1.3, 0), GOLD)
	K.block(0.1, 0.6, 0.6, at(2.45, -1.3, 0), GOLD)
	return Color3.fromRGB(255, 175, 220), 2.7
end

-- SECRET: a ghost galleon with glowing sails sailing tiny waves inside a corked glass bottle
LOOKS.GhostShipBottle = function(K)
	local GLASS = Color3.fromRGB(190, 240, 255)
	local SEA = Color3.fromRGB(60, 200, 230)
	local HULL = Color3.fromRGB(125, 70, 185)
	local MAST = Color3.fromRGB(120, 85, 70)
	local CORK = Color3.fromRGB(190, 140, 90)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local B = at(-0.45, 0, 0) * rot(0, 0, 10) -- the bottle lies on its side, neck up-right
	local X = rot(0, 0, -90) -- turns an upright K.cyl to lie along the bottle
	K.cyl(3.0, 2.5, B * X, GLASS, false, 0.8) -- glass (PrimaryPart)
	K.ball(2.5, B * at(-1.5, 0, 0), GLASS, false, 0.8) -- rounded bottom
	K.ball(2.5, B * at(1.5, 0, 0), GLASS, false, 0.8) -- shoulder
	K.cyl(0.9, 1.1, B * at(2.95, 0, 0) * X, GLASS, false, 0.6) -- neck
	K.cyl(0.75, 0.95, B * at(3.6, 0, 0) * X, CORK) -- cork
	K.cyl(0.22, 1.25, B * at(3.05, 0, 0) * X, GOLD) -- gold seal band
	K.block(3.3, 0.35, 1.6, B * at(-0.1, -0.95, 0), Color3.fromRGB(30, 90, 190), false, 0.1) -- tiny sea
	K.ball(0.55, B * at(-1.35, -0.78, -0.55), SEA, false, 0.1) -- waves
	K.ball(0.5, B * at(0.45, -0.8, -0.6), SEA, false, 0.1)
	K.block(2.1, 0.75, 0.95, B * at(-0.15, -0.3, 0), HULL) -- hull
	K.block(2.15, 0.16, 1.0, B * at(-0.15, -0.05, 0), GOLD) -- gold rail
	K.wedge(0.95, 0.65, 0.7, B * at(1.25, -0.35, 0) * rot(0, -90, 0), HULL) -- bow
	K.block(0.65, 0.4, 0.95, B * at(-0.9, 0.15, 0), Color3.fromRGB(150, 95, 210)) -- stern deck
	K.block(0.1, 1.35, 0.1, B * at(-0.1, 0.4, 0.1), MAST) -- masts
	K.block(0.1, 1.0, 0.1, B * at(0.7, 0.2, 0.1), MAST)
	K.block(0.95, 0.6, 0.08, B * at(-0.1, 0.3, 0.02), Color3.fromRGB(205, 255, 225), false, 0.15) -- ghostly sails (top one glows)
	K.block(0.7, 0.4, 0.08, B * at(-0.1, 0.85, 0.02), ECTO, true, 0.25)
	K.block(0.65, 0.5, 0.08, B * at(0.7, 0.25, 0.02), Color3.fromRGB(205, 255, 225), false, 0.15)
	K.spike(B * at(0.05, 1.0, 0.1), 0.3, 0.22, 1, Color3.fromRGB(255, 110, 200), true) -- flag
	K.ball(0.3, B * at(1.55, -0.1, -0.2), Color3.fromRGB(255, 220, 110), true) -- bow lantern
	local cap = B * at(-1.0, 0.72, -0.1)
	K.ball(0.85, cap, GHOST) -- ghost captain
	local f = cap.Position / S
	K.face(f.X, f.Y, f.Z - 0.36, 0.38)
	K.ball(0.42, at(-2.9, 1.35, -0.3), ECTO, true, 0.1) -- floating sparkles
	K.ball(0.34, at(2.3, -1.45, 0.2), Color3.fromRGB(255, 110, 200), true, 0.1)
	return Color3.fromRGB(170, 140, 255), 1.9
end

-- ULTRA: a tiny ghost waving from the wicker basket of a mini hot-air balloon with a pastel
-- purple/gold/mint striped envelope, a crescent moon emblem, little lanterns and orbiting stars
LOOKS.GhostBalloonRide = function(K)
	local LILAC = Color3.fromRGB(190, 160, 255)
	local SOFTGOLD = Color3.fromRGB(255, 215, 120)
	local MINT = Color3.fromRGB(150, 240, 205)
	local WICKER = Color3.fromRGB(190, 135, 80)
	local WICKER2 = Color3.fromRGB(150, 100, 60)
	local GHOST = Color3.fromRGB(246, 242, 255)
	local LANTERN = Color3.fromRGB(255, 205, 120)
	K.ball(3.6, at(0, 1.2, 0), LILAC) -- envelope (PrimaryPart)
	K.ball(2.2, at(0, -0.1, 0), LILAC) -- tapered bottom
	K.cyl(0.4, 1.3, at(0, -0.85, 0), SOFTGOLD) -- throat
	K.cyl(0.4, 3.32, at(0, 0.45, 0), SOFTGOLD) -- stripes
	K.cyl(0.4, 3.32, at(0, 1.95, 0), MINT)
	K.cyl(0.25, 2.42, at(0, 2.55, 0), SOFTGOLD)
	K.disc(0.12, 0.9, at(0, 1.2, -1.8), SOFTGOLD) -- crescent moon emblem...
	K.disc(0.14, 0.75, at(0.22, 1.3, -1.83), LILAC) -- ...cut by a lilac disc
	for _, x in { -0.65, 0.65 } do -- ropes
		for _, z in { -0.55, 0.55 } do
			K.block(0.08, 0.8, 0.08, at(x, -1.42, z), WICKER2)
		end
	end
	K.block(1.6, 0.9, 1.4, at(0, -2.3, 0), WICKER) -- basket
	K.block(1.7, 0.18, 1.5, at(0, -1.82, 0), WICKER2) -- basket rim
	K.ball(1.2, at(0, -1.45, -0.15), GHOST) -- the little ghost
	K.face(0, -1.4, -0.72, 0.38)
	K.ball(0.4, at(-0.85, -1.0, -0.4), GHOST) -- waving hand
	for _, s in { -1, 1 } do -- tiny lanterns hanging from the basket
		K.block(0.05, 0.4, 0.05, at(0.95 * s, -2.55, -0.6), WICKER2)
		K.ball(0.35, at(0.95 * s, -2.85, -0.6), LANTERN, true, 0.2)
	end
	K.ball(0.35, at(-2.4, 1.9, -0.2), SOFTGOLD, true, 0.15) -- orbiting stars
	K.ball(0.3, at(2.35, 0.6, 0.2), MINT, true, 0.15)
	K.ball(0.28, at(2.0, 2.8, -0.1), Color3.fromRGB(255, 180, 220), true, 0.15)
	return Color3.fromRGB(220, 200, 255), 3.1
end

-- unknown id (a pet added to Config before it has a look): a plain ghost blob
local function fallback(K: Kit, def: Config.PetDef): (Color3, number)
	K.ball(3.5, CFrame.identity, def.Color)
	K.ball(1.6, at(0.15, -1.6, 0.8), def.Color)
	K.face(0, 0.3, -1.55, 1)
	return def.Glow, 2.0
end

local function buildPet(def: Config.PetDef, slot: number, label: string): Pet
	local pieces: { Piece } = {}
	local K = {} :: Kit
	function K.ball(d, cf, col, neon, tr)
		return part(pieces, BALL, Vector3.one * (d * S), col, cf, neon, tr)
	end
	function K.block(x, y, z, cf, col, neon, tr)
		return part(pieces, BLOCK, Vector3.new(x, y, z) * S, col, cf, neon, tr)
	end
	function K.cyl(h, d, cf, col, neon, tr)
		return part(pieces, CYL, Vector3.new(h, d, d) * S, col, cf * CFrame.Angles(0, 0, math.pi / 2), neon, tr)
	end
	function K.disc(h, d, cf, col, neon, tr)
		return part(pieces, CYL, Vector3.new(h, d, d) * S, col, cf * CFrame.Angles(0, math.pi / 2, 0), neon, tr)
	end
	function K.wedge(x, y, z, cf, col, neon)
		return part(pieces, WEDGE, Vector3.new(x, y, z) * S, col, cf, neon)
	end
	function K.spike(cf, w, h, side, col, neon)
		return part(pieces, WEDGE, Vector3.new(0.3, h, w) * S, col, cf * CFrame.Angles(0, -side * math.pi / 2, 0), neon)
	end
	function K.face(x, y, z, k, opts)
		local o: FaceOpts = opts or {}
		for _, s in { -1, 1 } do
			K.ball(0.85 * k, at(x + 0.6 * k * s, y + 0.1 * k, z + 0.1), o.Eye or EYE)
			K.ball(0.3 * k, at(x + (0.6 * s + 0.16) * k, y + 0.28 * k, z - 0.22 * k), WHITE)
			if o.Blush ~= false then
				K.ball(0.4 * k, at(x + 1.05 * k * s, y - 0.35 * k, z + 0.1), BLUSH)
			end
		end
		if o.Mouth ~= false then
			K.disc(0.25 * k, 0.5 * k, at(x, y - 0.5 * k, z + 0.02), MOUTH)
		end
	end

	local look = LOOKS[def.Id]
	local glow: Color3, top: number
	if look then
		glow, top = look(K)
	else
		glow, top = fallback(K, def)
	end
	local body = pieces[1].Part

	-- rarity glow: a little wider for rarer pets, capped so Mythic/Secret/Ultra pets don't wash
	-- out (pale pets turned white under the old Secret/Ultra light)
	local r = Config.Rarities[def.Rarity]
	local order = if r then r.Order else 1
	local light = Instance.new("PointLight")
	light.Color = glow
	light.Range = math.min(4 + order, 8)
	light.Brightness = math.min(0.5 + order * 0.15, 1.1)
	light.Shadows = false
	light.Parent = body

	-- name tag (the nickname is filtered by the server before it is published)
	local gui = WorldLabel.New({
		Name = "PetTag",
		Adornee = body,
		Parent = body,
		Size = Vector2.new(140, 20),
		Offset = Vector3.new(0, top * S + 0.3, 0) - pieces[1].Offset.Position,
		MaxDistance = 60,
	})
	gui.Enabled = game:GetService("Players").LocalPlayer:GetAttribute("ShowNames") ~= false -- Settings: NAMES
	WorldLabel.Text(gui, label, { Style = "Small", Color = if r then (if r.Color.R + r.Color.G + r.Color.B >= r.Color2.R + r.Color2.G + r.Color2.B then r.Color else r.Color2) else nil })
	return { Pieces = pieces, Slot = slot }
end

-- A standalone pet Model (no name tag), pivot = the pet's centre. Used by the egg hatch reveal.
function PetFollowers.BuildPet(petId: string): Model?
	local def = Config.Pets[petId]
	if not def then
		return nil
	end
	local pet = buildPet(def, 1, def.Name)
	local m = Instance.new("Model")
	m.Name = "Pet_" .. petId
	for _, pc in pet.Pieces do
		local tag = pc.Part:FindFirstChild("PetTag")
		if tag then
			tag:Destroy()
		end
		pc.Part.CFrame = pc.Offset
		pc.Part.Parent = m
	end
	-- the body part may be offset or turned (e.g. an upright cylinder): keep the pivot at the
	-- pet's centre, facing the front, like the old ghost pets
	local body = pet.Pieces[1].Part
	body.PivotOffset = body.CFrame:Inverse()
	m.PrimaryPart = body
	return m
end
local function clear(e: Entry)
	for _, pet in e.Pets do
		for _, pc in pet.Pieces do
			pc.Part:Destroy()
		end
	end
	e.Pets = {}
end

local function rebuild(plr: Player)
	local e = entries[plr]
	if not e then
		return
	end
	clear(e)
	if not plr.Character then
		return
	end
	local list = plr:GetAttribute("Pets")
	if type(list) ~= "string" or list == "" then
		return
	end
	local rawNames = plr:GetAttribute("PetNames")
	local names = if type(rawNames) == "string" then string.split(rawNames, "\n") else {}
	for i, id in string.split(list, ",") do
		local def = Config.Pets[id]
		if def and #e.Pets < #SLOTS then
			local nick = names[i]
			table.insert(e.Pets, buildPet(def, #e.Pets + 1, if nick and nick ~= "" then nick else def.Name))
		end
	end
end

local function track(plr: Player)
	local e: Entry = { Pets = {}, Conns = {} }
	entries[plr] = e
	local function re()
		rebuild(plr)
	end
	table.insert(e.Conns, plr:GetAttributeChangedSignal("Pets"):Connect(re))
	table.insert(e.Conns, plr:GetAttributeChangedSignal("PetNames"):Connect(re))
	table.insert(e.Conns, plr.CharacterAdded:Connect(re))
	table.insert(e.Conns, plr.CharacterRemoving:Connect(function()
		clear(e)
	end))
	re()
end

local function untrack(plr: Player)
	local e = entries[plr]
	if e then
		clear(e)
		for _, c in e.Conns do
			c:Disconnect()
		end
		entries[plr] = nil
	end
end

function PetFollowers.Start()
	folder = Instance.new("Folder")
	folder.Name = "PetFollowers"
	folder.Parent = workspace
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	for _, plr in Players:GetPlayers() do
		track(plr)
	end
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	RunService.RenderStepped:Connect(function(dt: number)
		table.clear(parts)
		table.clear(cfs)
		local cam = workspace.CurrentCamera
		local camPos = if cam then cam.CFrame.Position else Vector3.zero
		local t = os.clock()
		local alpha = math.min(1, dt * 8)
		for plr, e in entries do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root or #e.Pets == 0 or (root.Position - camPos).Magnitude > FAR then
				continue
			end
			local base = root.CFrame
			for _, pet in e.Pets do
				local bob = math.sin(t * 2.2 + pet.Slot * 1.7) * 0.25
				local target = base * CFrame.new(SLOTS[pet.Slot] + Vector3.new(0, bob, 0))
				-- snap after a teleport / respawn instead of streaking across the map
				local prev = pet.Cur
				local cur = if prev and (prev.Position - target.Position).Magnitude < 40 then prev:Lerp(target, alpha) else target
				pet.Cur = cur
				for _, pc in pet.Pieces do
					table.insert(parts, pc.Part)
					table.insert(cfs, cur * pc.Offset)
				end
			end
		end
		if #parts > 0 then
			workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

return PetFollowers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">PetsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- GHOST PETS: owned pets, equip up to 3 and rename. Pets come from eggs at the PET HATCHERY
-- near the Boss Tower (Controllers/Hatchery; v1.8 removed direct purchases). Each equipped
-- pet gives a crew-wide bonus; the server validates every equip/rename. Nicknames shown here
-- come back from the server already text-filtered.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local PetPortrait = require(Client.UI.PetPortrait)
local Hud = require(script.Parent.Hud)

local PetsPanel = {}

local SHARD = Color3.fromRGB(200, 160, 255)

local panel: Kit.Panel
local shardLabel: TextLabel
local bonusLabel: TextLabel
local equippedHead: TextLabel
local equippedNames: Frame
local equippedLabel: TextLabel
local ownedRow: Frame
local renameRow: Frame
local renameTitle: TextLabel
local renameBox: TextBox
local renameUid: string? = nil
local NICK_MAX = 20
local busy = false

local function bonusText(kind: string, value: number): string
	local pct = math.floor(value * 100 + 0.5) .. "%"
	if kind == "Power" then
		return "+" .. pct .. " POWER for all hunters"
	elseif kind == "Ecto" then
		return "+" .. pct .. " ECTOPLASM"
	elseif kind == "HP" then
		return "+" .. pct .. " HUNTER HP"
	end
	return pct .. " FASTER RECOVERY"
end

-- shared with the egg panel (Controllers/Hatchery)
PetsPanel.BonusText = bonusText

local function rarityName(pet: Config.PetDef): string
	local r = Config.Rarities[pet.Rarity]
	return string.upper(r and r.Name or pet.Rarity)
end

-- "Spooky (Boo Brew · COMMON)" or just "Boo Brew"
local function displayName(pet: Config.PetDef, nick: string?): string
	return if nick and nick ~= "" then nick .. " (" .. pet.Name .. " · " .. rarityName(pet) .. ")" else pet.Name
end

-- One pet card (nick: owned pet's filtered nickname); the caller adds the button.
local function card(parent: Instance, order: number, pet: Config.PetDef, nick: string?): Frame
	local r = Config.Rarities[pet.Rarity]
	local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = parent })
	Kit.Corner(f, UDim.new(0, 14))
	Kit.Stroke(f, 3, if r then Theme.RarityText(r) else Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, Theme.Panel3, Theme.Panel, 90)
	local orb: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = pet.Color:Lerp(Color3.new(0, 0, 0), 0.5), ZIndex = 63, Parent = f })
	Kit.Corner(orb, UDim.new(1, 0))
	Kit.Stroke(orb, 2.5, pet.Glow, Enum.ApplyStrokeMode.Border)
	PetPortrait.New(orb, pet.Id)
	local named = nick ~= nil and nick ~= ""
	Kit.Label(f, if named then nick :: string else string.upper(pet.Name), { Size = UDim2.new(1, -10, 0, 22), Position = UDim2.fromOffset(5, 56), Style = "Body", Fit = true, ZIndex = 63 })
	Kit.Label(f, if named then pet.Name .. " · " .. rarityName(pet) else (r and r.Name or pet.Rarity), { Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 78), Color = if r then Theme.RarityText(r) else Theme.Text, Style = "Tiny", Fit = true, ZIndex = 63 })
	Kit.Label(f, bonusText(pet.Bonus.Kind, pet.Bonus.Value), { Size = UDim2.new(1, -10, 0, 32), Position = UDim2.fromOffset(5, 96), Color = Theme.Ecto, Font = Theme.Body, Style = "Tiny", Wrap = true, ZIndex = 63 })
	return f
end

local function cardButton(f: Frame, text: string, color: string, onClick: () -> ()): TextButton
	return Kit.Button(f, {
		Text = text,
		Color = color,
		Size = UDim2.new(1, -16, 0, 38),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 64,
		OnClick = onClick,
	})
end

local function request(action: string, ...: any): any
	if busy then
		return nil
	end
	busy = true
	local res = State.Request(action, ...)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Can't do that right now", "Bad")
	end
	return res
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local shards = d.Shards or 0
	Kit.IconText(shardLabel, "🔮 " .. Format.Short(shards) .. " SPIRIT SHARDS")
	local parts = {}
	for _, kind in { "Power", "Ecto", "HP", "Recovery" } do
		local v = d.PetBonuses and d.PetBonuses[kind]
		if v and v > 0 then
			table.insert(parts, bonusText(kind, v))
		end
	end
	bonusLabel.Text = if #parts > 0 then "TO ALL HUNTERS: " .. table.concat(parts, "  •  ") else "No pet bonuses yet: equip a pet!"
	-- owned: rebuilt each refresh (at most MaxOwned small cards), equipped first
	local equipped: { [string]: boolean } = {}
	for _, uid in d.EquippedPets or {} do
		equipped[uid] = true
	end
	local nEquipped = 0
	for _ in equipped do
		nEquipped += 1
	end
	equippedLabel.Text = "OWNED  •  EQUIPPED " .. nEquipped .. "/" .. Config.PetRules.MaxEquipped
	equippedHead.Text = "EQUIPPED " .. nEquipped .. "/" .. Config.PetRules.MaxEquipped
	-- equipped line: a small live portrait + name per pet (rebuilt like the cards below)
	for _, c in equippedNames:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local shown = 0
	for i, uid in d.EquippedPets or {} do
		local rec = d.Pets and d.Pets[uid]
		local pet = rec and Config.Pets[rec.Id]
		if rec and pet then
			shown += 1
			local item: Frame = Kit.new("Frame", { Size = UDim2.new(1 / Config.PetRules.MaxEquipped, -6, 1, 0), BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 62, Parent = equippedNames })
			local dot: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(24, 24), Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = pet.Color:Lerp(Color3.new(0, 0, 0), 0.5), ZIndex = 62, Parent = item })
			Kit.Corner(dot, UDim.new(1, 0))
			PetPortrait.New(dot, pet.Id)
			Kit.Label(item, if rec.Nick and rec.Nick ~= "" then rec.Nick else pet.Name, { Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(28, 0), Align = Enum.TextXAlignment.Left, Font = Theme.Body, Style = "Small", Fit = true, ZIndex = 62 })
		end
	end
	if shown == 0 then
		Kit.Label(equippedNames, "None: equip pets below", { Font = Theme.Body, Style = "Small", Fit = true, ZIndex = 62 })
	end
	if renameUid and not (d.Pets and d.Pets[renameUid]) then
		renameUid = nil
	end
	renameRow.Visible = renameUid ~= nil
	for _, c in ownedRow:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local uids = {}
	for uid in d.Pets or {} do
		table.insert(uids, uid)
	end
	table.sort(uids, function(a, b)
		local ta, tb = d.Pets[a].T or 0, d.Pets[b].T or 0
		if equipped[a] ~= equipped[b] then
			return equipped[a] == true
		end
		return if ta ~= tb then ta < tb else a < b
	end)
	for i, uid in uids do
		local rec = d.Pets[uid]
		local pet = Config.Pets[rec.Id]
		if pet then
			local on = equipped[uid] == true
			local f = card(ownedRow, i, pet, rec.Nick)
			cardButton(f, if on then "UNEQUIP" else "EQUIP", if on then "Orange" else "Green", function()
				request("EquipPet", uid, not on)
			end)
			Kit.Button(f, {
				Text = "✏️",
				Color = "Purple",
				Size = UDim2.fromOffset(36, 36),
				Position = UDim2.new(1, -4, 0, 4),
				AnchorPoint = Vector2.new(1, 0),
				ZIndex = 64,
				OnClick = function()
					renameUid = uid
					renameTitle.Text = "RENAME " .. displayName(pet, rec.Nick)
					renameBox.Text = rec.Nick or ""
					renameRow.Visible = true
					renameBox:CaptureFocus()
				end,
			})
		end
	end
	if #uids == 0 then
		local f: Frame = Kit.new("Frame", { BackgroundTransparency = 1, ZIndex = 62, Parent = ownedRow })
		Kit.Label(f, "No pets yet", { Color = Theme.Muted, Style = "Small", ZIndex = 63 })
	end
end

function PetsPanel.Init()
	panel = Kit.Panel("Pets", "GHOST PETS", Vector2.new(780, 500), "Purple")
	local scroll: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 10),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	shardLabel = Kit.Label(scroll, "", { Size = UDim2.new(1, -6, 0, 30), Color = SHARD, Style = "Currency", Fit = true, ZIndex = 62 })
	shardLabel.LayoutOrder = 1
	Kit.Label(scroll, "Earn shards in the Boss Tower", { Size = UDim2.new(1, -6, 0, 18), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Fit = true, Stroke = 0, ZIndex = 62 }).LayoutOrder = 2
	equippedHead = Kit.Label(scroll, "", { Size = UDim2.new(1, 0, 0, 24), Style = "Heading", ZIndex = 62 })
	equippedHead.LayoutOrder = 3
	equippedNames = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundTransparency = 1, LayoutOrder = 4, ZIndex = 62, Parent = scroll })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = equippedNames })
	bonusLabel = Kit.Label(scroll, "", { Size = UDim2.new(1, -6, 0, 20), Color = Theme.Ecto, Style = "Small", Fit = true, ZIndex = 62 })
	bonusLabel.LayoutOrder = 5
	local function section(order: number, title: string): (TextLabel, Frame)
		local l = Kit.Label(scroll, title, { Size = UDim2.new(1, 0, 0, 24), Style = "Heading", ZIndex = 62 })
		l.LayoutOrder = order
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, ZIndex = 61, Parent = scroll })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 176), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		return l, row
	end
	local hint = Kit.Label(scroll, "Get pets from eggs at the PET HATCHERY in the lobby, next to the Boss Tower", { Size = UDim2.new(1, -6, 0, 36), Color = SHARD, Font = Theme.Body, Style = "Small", Wrap = true, ZIndex = 62 })
	hint.LayoutOrder = 10
	equippedLabel, ownedRow = section(20, "OWNED")
	ownedRow.LayoutOrder = 22
	-- rename bar (opened by a card's pencil button): text box + SAVE / DEFAULT / X
	renameRow = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 76), BackgroundColor3 = Theme.Bg, LayoutOrder = 21, Visible = false, ZIndex = 61, Parent = scroll })
	Kit.Corner(renameRow, UDim.new(0, 12))
	Kit.Stroke(renameRow, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	renameTitle = Kit.Label(renameRow, "", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 4), Align = Enum.TextXAlignment.Left, Style = "Small", Fit = true, ZIndex = 62 })
	local boxBg: Frame = Kit.new("Frame", { Size = UDim2.new(1, -290, 0, 38), Position = UDim2.fromOffset(10, 30), BackgroundColor3 = Theme.Panel, ZIndex = 62, Parent = renameRow })
	Kit.Corner(boxBg, UDim.new(0, 10))
	renameBox = Kit.new("TextBox", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.Body,
		TextSize = Theme.Type.Body,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		PlaceholderText = "Pet name (up to " .. NICK_MAX .. " letters)",
		Text = "",
		ZIndex = 63,
		Parent = boxBg,
	})
	renameBox:GetPropertyChangedSignal("Text"):Connect(function()
		local n = utf8.len(renameBox.Text)
		if not n or n > NICK_MAX then
			renameBox.Text = string.sub(renameBox.Text, 1, (utf8.offset(renameBox.Text, NICK_MAX + 1) or 1) - 1)
		end
	end)
	local function rename(text: string)
		local uid = renameUid
		if not uid then
			return
		end
		local res = request("RenamePet", uid, text)
		if res and res.ok then
			renameUid = nil
			renameRow.Visible = false
			Kit.Toast(if res.Nick then "Renamed to " .. res.Nick else "Name reset", "Good")
		end
	end
	local function barButton(text: string, color: string, x: number, w: number, onClick: () -> ())
		Kit.Button(renameRow, { Text = text, Color = color, Size = UDim2.fromOffset(w, 38), Position = UDim2.new(1, x, 0, 30), AnchorPoint = Vector2.new(1, 0), TextStyle = "Body", ZIndex = 63, OnClick = onClick })
	end
	barButton("SAVE", "Green", -184, 90, function()
		rename(renameBox.Text)
	end)
	barButton("DEFAULT", "Gray", -58, 120, function()
		rename("")
	end)
	barButton("X", "Red", -8, 44, function()
		renameUid = nil
		renameRow.Visible = false
	end)
	Hud.RegisterPanel("Pets", function()
		panel:Toggle()
	end)
end

function PetsPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return PetsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">RarePetEvent</string>
              <string name="Source"><![CDATA[--!strict
-- FREE RARE PET launch event (client). While the global event is active (workspace attributes
-- RarePetStart / RarePetEnd, set by RarePetEventService) a small chip under the counters shows
-- the time left and this player's progress ("12/30 MIN"); tapping it opens a panel with the
-- reward preview. Progress comes from player attribute "RarePetPlay" (live, every few seconds)
-- with State.Data.EventPlay as the fallback. The server decides everything; this only shows it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)

local RarePetEvent = {}

local E = Config.RarePetEvent
local player = Players.LocalPlayer

local chip: TextButton
local chipLabel: TextLabel
local panel: Kit.Panel
local barFill: Frame
local progressLabel: TextLabel
local timeLabel: TextLabel
local noteLabel: TextLabel

local function window(): (number?, number?)
	local s = workspace:GetAttribute("RarePetStart")
	local e = workspace:GetAttribute("RarePetEnd")
	if workspace:GetAttribute("RarePetEventId") == E.Id and type(s) == "number" and type(e) == "number" then
		return s, e
	end
	return nil, nil
end

local function progress(): (number, boolean)
	local s = player:GetAttribute("RarePetPlay")
	local g = player:GetAttribute("RarePetGot")
	local seconds = if type(s) == "number" then s else 0
	local got = g == true
	local d = State.Data
	local ev = d and d.EventPlay and d.EventPlay[E.Id]
	if type(ev) == "table" then
		if type(ev.S) == "number" then
			seconds = math.max(seconds, ev.S)
		end
		got = got or ev.G == true
	end
	return seconds, got
end

local function bonusText(kind: string, value: number): string
	local names: { [string]: string } = { Power = "Power", Ecto = "Ectoplasm", HP = "Hunter HP", Recovery = "Recovery" }
	return "+" .. Format.Percent(value) .. " " .. (names[kind] or kind) .. " for ALL hunters"
end

local function update()
	local startT, endT = window()
	local now = State.Now()
	local active = startT ~= nil and endT ~= nil and now >= (startT :: number) and now < (endT :: number)
	chip.Visible = active
	if not active and panel.IsOpen then
		panel:Close()
	end
	if not active then
		return
	end
	local left = (endT :: number) - now
	local seconds, got = progress()
	local req = E.RequiredSeconds
	local mins = math.min(seconds, req) // 60
	local reqMins = req // 60
	if got then
		chipLabel.Text = "🏮 LEGENDARY PET EARNED!  ·  " .. Format.Time(left)
	else
		chipLabel.Text = string.format("🏮 FREE LEGENDARY PET %d/%d MIN  ·  %s", mins, reqMins, Format.Time(left))
	end
	if panel.IsOpen then
		local frac = math.clamp(seconds / req, 0, 1)
		barFill.Size = UDim2.fromScale(if got then 1 else frac, 1)
		progressLabel.Text = if got then "✅ EARNED - check your pets!" else string.format("%d / %d MIN PLAYED", mins, reqMins)
		timeLabel.Text = "Event ends in " .. Format.Time(left)
		noteLabel.Text = if got then "Thanks for playing the launch event!" else string.format("Play %d minutes before the event ends. Idle time doesn't count.", reqMins)
	end
end

function RarePetEvent.Init()
	local def = Config.Pets[E.Pet]
	local rarity = def and Config.Rarities[def.Rarity]
	local parent: Instance = Hud.TopStack or Kit.Screen()
	chip = Kit.new("TextButton", {
		Name = "RarePetChip",
		Size = UDim2.fromOffset(250, 24),
		BackgroundColor3 = Theme.Panel2,
		BackgroundTransparency = 0.05,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = 4,
		Visible = false,
		Parent = parent,
	})
	if parent ~= Hud.TopStack then
		chip.Position = UDim2.new(0.5, 0, 0, 120)
		chip.AnchorPoint = Vector2.new(0.5, 0)
	end
	Kit.Corner(chip, UDim.new(1, 0))
	Kit.Stroke(chip, 2, Theme.Gold, Enum.ApplyStrokeMode.Border)
	chipLabel = Kit.Label(chip, "", { Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), Color = Theme.Gold, Style = "Tiny", Fit = true })
	chip.Activated:Connect(function()
		panel:Open()
		update()
	end)

	panel = Kit.Panel("RarePetEvent", "🏮 FREE LEGENDARY PET!", Vector2.new(480, 320), "Orange")
	local body = panel.Body
	Kit.Label(body, if def then def.Name else E.Pet, { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 14), Color = if rarity then Theme.RarityText(rarity) else Theme.Gold, Style = "Heading", TextSize = 26, ZIndex = 62 })
	local sub = (if rarity then rarity.Name else (if def then def.Rarity else "Legendary")) .. " ghost pet  ·  " .. (if def then bonusText(def.Bonus.Kind, def.Bonus.Value) else "")
	Kit.Label(body, sub, { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 50), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, Fit = true, ZIndex = 62 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 88), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	barFill = Kit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Gold, ZIndex = 63, Parent = bar })
	Kit.Corner(barFill, UDim.new(1, 0))
	progressLabel = Kit.Label(bar, "", { Size = UDim2.fromScale(1, 1), Style = "Tiny", ZIndex = 64 })
	timeLabel = Kit.Label(body, "", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 118), Color = Theme.Gold, Style = "Body", ZIndex = 62 })
	noteLabel = Kit.Label(body, "", { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 146), Font = Theme.Body, Style = "Small", Stroke = 0, Wrap = true, ZIndex = 62 })
	local ok = Kit.Button(body, {
		Text = "LET'S HUNT!",
		Color = "Orange",
		Size = UDim2.fromOffset(220, 46),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			panel:Close()
		end,
	})
	panel.Primary = ok
end

function RarePetEvent.Start()
	State.OnFx("RarePetGranted", function(data: any)
		local name = if type(data) == "table" and type(data.Name) == "string" then data.Name else "a Legendary pet"
		Sound.Play("ZoneUnlock")
		Kit.Toast("🏮 You earned " .. name .. "! It's in your pets.", "Gold")
		update()
	end)
	State.OnFx("RarePetEventStarted", function(_data: any)
		update()
		-- shown once the player isn't using a menu / watching a reveal (never closes one)
		Kit.WhenFree(function()
			update()
			if chip.Visible and not panel.IsOpen then
				panel:Open()
				update()
			end
		end)
	end)
	for _, attr in { "RarePetEventId", "RarePetStart", "RarePetEnd" } do
		workspace:GetAttributeChangedSignal(attr):Connect(update)
	end
	player:GetAttributeChangedSignal("RarePetPlay"):Connect(update)
	player:GetAttributeChangedSignal("RarePetGot"):Connect(update)
	State.OnData(function(_d: any)
		update()
	end)
	task.spawn(function()
		while true do
			update()
			task.wait(1)
		end
	end)
end

return RarePetEvent
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Crate opening cinematic. Plays on a private stage far from the map with a scripted camera:
--   crate drops in → bounces → shakes (rare+: levitates while rarity energy converges) →
--   locks pop → lid flies open → light burst → the hunter leaps out and poses → result card.
-- Intensity comes from Config.Rarities (RevealPause, ShakeIntensity, Particles, Darken,
-- CameraPunch). Commons are quick; "Fast crate opening" in settings shortens everything; SKIP
-- jumps straight to the result. Every step is written as anim(duration, apply(alpha)) so a
-- skip simply applies each step's end state.
-- Reveal.PlayPet runs the same sequence for a PET EGG: the egg shakes and cracks, the shell
-- pops and the hatched pet (PetFollowers.BuildPet) pops out.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Signal = require(GH.Signal)
local HunterRig = require(GH.Rigs.HunterRig)
local CrateRig = require(GH.Rigs.CrateRig)
local Client = script.Parent.Parent
local State = require(Client.State)

-- max HP of a hunter with this power (incl. the equipped pets' HP bonus), as the server counts it

-- price shown on the reveal's buy-a-skip button (the real price is set on Roblox)
local SINGLE_SKIP_PRICE = "R$ 9"
for _, p in Config.Products do
	if p.Key == "SingleSkip" and p.PriceLabel then
		SINGLE_SKIP_PRICE = p.PriceLabel
	end
end
local function hpFor(power: number): number
	local d = State.Data
	local bonus = if d and d.PetBonuses then tonumber(d.PetBonuses.HP) or 0 else 0
	return Rules.HunterMaxHP(power, Config.Retaliation.HPPerPower, bonus)
end

local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local Targeting = require(script.Parent.Targeting)
local PetFollowers = require(script.Parent.PetFollowers)
local PetsPanel = require(script.Parent.PetsPanel)
local PetPortrait = require(Client.UI.PetPortrait)

local Reveal = {}

export type Result = {
	Crate: string,
	Hunter: string,
	Uid: string,
	IsNew: boolean,
}

local player = Players.LocalPlayer
local STAGE = Vector3.new(0, 900, -2500)
local CAM_FOV = 50

local playing = false
local skipping = false
local stage: Folder? = nil
local gui: ScreenGui? = nil
local cc: ColorCorrectionEffect? = nil
local rays: Frame? = nil
local raySpeed = 20
local poseConn: RBXScriptConnection? = nil
local hunterRig: HunterRig.Rig? = nil
local hunterState = "Idle"
local hunterT0 = 0
local idleFn: ((number) -> ())? = nil -- per-frame idle of a hatched pet
local againFn: (() -> ())? = nil
local petEggId: string? = nil -- egg of the current hatch (HATCH AGAIN price)
local liveTweens: { Tween } = {}
local shakeToken = 0
local cardShown = false
local okButton: TextButton? = nil

-- Tweens the reveal starts are tracked so closing it can stop them (no lingering darkening
-- or FOV changes after a quick SKIP + OK).
local function tween(obj: Instance, info: TweenInfo, props: { [string]: any }): Tween
	local tw = TweenService:Create(obj, info, props)
	table.insert(liveTweens, tw)
	tw:Play()
	return tw
end
local finishedSignal = Signal.new()
Reveal.Finished = finishedSignal -- (result)
local startedSignal = Signal.new()
Reveal.Started = startedSignal
local stopAutoSignal = Signal.new()
Reveal.AutoStopped = stopAutoSignal -- the player pressed STOP AUTO OPEN

function Reveal.IsPlaying(): boolean
	return playing
end

local function hasPermanentSkip(): boolean
	local d = State.Data
	return d ~= nil and d.Passes ~= nil and d.Passes[Config.CrateSkip.Pass] == true
end

-- "Fast crate opening" is part of Permanent Crate Skip (skipping is paid now).
local function fast(): boolean
	local d = State.Data
	return d ~= nil and d.Settings.FastReveal == true and hasPermanentSkip()
end

-- SKIP: Permanent Crate Skip owners skip free; others use a bought Single Crate Skip (10 R$).
-- The server checks and spends; the reveal is only a cinematic of a hunter that's already saved.
local skipBusy = false
local pendingSkip = false
local skipButton: TextButton? = nil
local autoMode = false

local petMode = false -- egg hatches skip for free (crate skips are a paid product)

-- A SKIP button is only offered when it can actually skip: egg hatches (free), Permanent Crate
-- Skip owners, players holding skip tokens, or when the Single Crate Skip product is on sale.
local function skipProductOnSale(): boolean
	for _, p in Config.Products do
		if p.Key == Config.CrateSkip.Product then
			return p.ProductId ~= nil
		end
	end
	return false
end

-- the Permanent Crate Skip pass, when it's on sale: offered on the SKIP button to non-owners
local PERMANENT_SKIP: any = nil
for _, pass in Config.GamePasses do
	if pass.Key == "PermanentSkip" and pass.PassId then
		PERMANENT_SKIP = pass
	end
end

local function canSkip(): boolean
	if petMode or hasPermanentSkip() then
		return true
	end
	local d = State.Data
	return (d ~= nil and (d.SkipTokens or 0) > 0) or skipProductOnSale() or PERMANENT_SKIP ~= nil
end

local function skipLabel(): string
	local d = State.Data
	if petMode then
		return "SKIP ⏩"
	end
	if hasPermanentSkip() then
		return "SKIP ⏩"
	end
	local tokens = if d then d.SkipTokens or 0 else 0
	if tokens > 0 then
		return "SKIP ⏩ (" .. tokens .. ")"
	end
	local price = if skipProductOnSale() then SINGLE_SKIP_PRICE elseif PERMANENT_SKIP then PERMANENT_SKIP.PriceLabel else SINGLE_SKIP_PRICE
	return "SKIP ⏩ " .. string.gsub(price, " ", "")
end

local function requestSkip()
	if skipping or cardShown or not playing or skipBusy then
		return
	end
	if petMode then
		skipping = true
		return
	end
	if not canSkip() then
		return -- gamepad B with no skip available
	end
	local myStage = stage
	skipBusy = true
	local res = State.Request("UseSkip")
	skipBusy = false
	if cardShown or not playing or stage ~= myStage then
		-- the reveal finished while we waited: nothing left to skip, so hand the token back
		if res.ok and not res.Permanent then
			task.spawn(State.Request, "RefundSkip")
		end
		return
	end
	if res.ok then
		pendingSkip = false
		skipping = true
		return
	end
	if res.err == "NeedSkip" and not skipProductOnSale() and PERMANENT_SKIP then
		-- no single skips for sale: offer the Permanent Crate Skip pass (skips from then on)
		local buy = State.Request("Buy", PERMANENT_SKIP.Key)
		if not buy.ok then
			Kit.Toast(buy.err or "Skip isn't available", "Bad")
		end
	elseif res.err == "NeedSkip" then
		local buy = State.Request("Buy", Config.CrateSkip.Product)
		if buy.ok then
			pendingSkip = true -- the purchase arrives as a SkipGranted message
		else
			Kit.Toast(buy.err or "Skip isn't available", "Bad")
		end
	else
		Kit.Toast(res.err or "Couldn't skip", "Bad")
	end
end

-- Runs fn(alpha) every frame for `t` seconds (alpha 0→1). On skip: fn(1) immediately.
local function anim(t: number, fn: (number) -> ())
	if skipping or t <= 0 then
		fn(1)
		return
	end
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / t, 0, 1)
		fn(a)
		if a >= 1 or skipping then
			if skipping then
				fn(1)
			end
			return
		end
		RunService.RenderStepped:Wait()
	end
end

local function easeOutBack(a: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end

local function easeOutBounce(a: number): number
	local n1, d1 = 7.5625, 2.75
	if a < 1 / d1 then
		return n1 * a * a
	elseif a < 2 / d1 then
		a -= 1.5 / d1
		return n1 * a * a + 0.75
	elseif a < 2.5 / d1 then
		a -= 2.25 / d1
		return n1 * a * a + 0.9375
	end
	a -= 2.625 / d1
	return n1 * a * a + 0.984375
end

local controls: any = nil
local function setControls(on: boolean)
	if not controls then
		local ok, mod = pcall(function()
			local ps = player:WaitForChild("PlayerScripts")
			return (require :: any)(ps:WaitForChild("PlayerModule"))
		end)
		if ok and mod then
			controls = mod:GetControls()
		end
	end
	if controls then
		pcall(function()
			if on then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = stage
	return p
end

local function buildStage(rarity: Config.RarityDef)
	local f = Instance.new("Folder")
	f.Name = "GHReveal"
	f.Parent = workspace
	stage = f
	-- floor disc with glowing trim
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 18, 18), Color = Color3.fromRGB(45, 28, 80), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 19, 19), Color = rarity.Color, Material = Enum.Material.Neon, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	-- backdrop with spinning rays (SurfaceGui, unaffected by lighting)
	local back = part({ Size = Vector3.new(70, 44, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 6, 14)) })
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 14,
		LightInfluence = 0,
		Brightness = 0.45,
		Parent = back,
	})
	local bg: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sg })
	Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 40)),
			ColorSequenceKeypoint.new(0.5, rarity.Color2:Lerp(Color3.fromRGB(40, 20, 70), 0.55)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 10, 40)),
		}),
		Rotation = 90,
		Parent = bg,
	})
	local holder: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(1400, 1400),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = bg,
	})
	-- six full-length bars through the centre = twelve rays (GUI rotation pivots on the centre)
	for i = 0, 5 do
		local ray: Frame = Kit.new("Frame", {
			Size = UDim2.new(0, 110, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			Rotation = i * 30,
			Parent = holder,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.58, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
	end
	rays = holder
	-- lights
	local l1 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 7, -6)) })
	Kit.new("PointLight", { Range = 14, Brightness = 0.55, Color = Color3.fromRGB(255, 240, 255), Parent = l1 }) -- owner: chests washed out (was 1.4)
	local l2 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 3, 3)) })
	Kit.new("PointLight", { Name = "RarityLight", Range = 12, Brightness = 0, Color = rarity.Color, Parent = l2 })
end

local function buildGui(): (ScreenGui, TextButton)
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = "GHRevealGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- buttons stay clear of notches / rounded corners / the Roblox top bar (set after creation:
	-- IgnoreGuiInset would otherwise override it); full-screen flashes overflow the insets anyway
	g.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	Kit.new("UIScale", { Scale = Kit.UIScale(), Parent = g })
	-- touch screens: lift SKIP above where the jump button sits (same reserve as the HUD)
	local lift = 16
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local cam = workspace.CurrentCamera
		local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
		lift = (if math.min(vp.X, vp.Y) < 500 then 100 else 225) / Kit.UIScale()
	end
	local skip = Kit.Button(g, {
		Text = skipLabel(),
		Color = if hasPermanentSkip() then "Gray" else "Orange",
		Size = UDim2.fromOffset(150, 40),
		Position = UDim2.new(1, -16, 1, -lift),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 5,
		OnClick = function()
			task.spawn(requestSkip)
		end,
	})
	skipButton = skip
	-- no "SKIP R$9" while the Single Crate Skip product isn't on sale (it could only fail)
	skip.Visible = canSkip()
	if autoMode then
		Kit.Button(g, {
			Text = "STOP AUTO OPEN",
			Color = "Red",
			Size = UDim2.fromOffset(180, 40),
			Position = UDim2.new(0, 16, 1, -16),
			AnchorPoint = Vector2.new(0, 1),
			ZIndex = 5,
			OnClick = function()
				Reveal.StopAuto()
			end,
		})
	end
	gui = g
	return g, skip
end

local function flash(color: Color3, t: number)
	local g = gui
	if not g then
		return
	end
	local f: Frame = Kit.new("Frame", { Size = UDim2.fromScale(4, 4), Position = UDim2.fromScale(-1.5, -1.5), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 20, Parent = g })
	Kit.Tween(f, t, { BackgroundTransparency = 1 })
	task.delay(t, function()
		f:Destroy()
	end)
end

local function cameraShake(intensity: number, t: number)
	local cam = workspace.CurrentCamera
	if not cam or skipping then
		return
	end
	local my = shakeToken
	local base = cam.CFrame
	anim(t, function(a)
		if my ~= shakeToken or not playing then
			return
		end
		local k = intensity * (1 - a)
		cam.CFrame = base * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end)
	if my == shakeToken and playing then
		cam.CFrame = base
	end
end

local function resultCard(g: ScreenGui, res: Result, rarity: Config.RarityDef)
	local def = Config.Hunters[res.Hunter]
	local d = State.Data
	-- right side of the screen, so the hunter (shifted left by the camera) stays the focus
	local card: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 232),
		Position = UDim2.new(1, -20, 0.5, 10),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = g,
	})
	Kit.Corner(card, UDim.new(0, 18))
	Kit.Stroke(card, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, Theme.Panel2, Theme.Bg, 90)
	-- slide in from the right edge (no scale pop: scaling text renders it at many sizes)
	card.Position = UDim2.new(1, 380, 0.5, 10)
	Kit.Tween(card, 0.35, { Position = UDim2.new(1, -20, 0.5, 10) }, Enum.EasingStyle.Back)
	-- rarity ribbon
	local ribbon: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(200, 32),
		Position = UDim2.new(0.5, 0, 0, -16),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 12,
		Parent = card,
	})
	Kit.Corner(ribbon, UDim.new(0, 10))
	Kit.Stroke(ribbon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ribbon, rarity.Color, rarity.Color2, 0)
	Kit.Label(ribbon, rarity.Name, { Style = "Heading", ZIndex = 13 })
	Kit.Label(card, string.upper(def.Name), { Size = UDim2.new(1, -30, 0, 30), Position = UDim2.fromOffset(15, 22), Style = "Title", Fit = true, ZIndex = 11 })
	Kit.IconText(Kit.Label(card, "", { Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 54), Color = Theme.Gold, Style = "Body", Fit = true, ZIndex = 11 }), "⚡ " .. Format.Short(def.Power) .. " POWER  ·  ❤️ " .. Format.Short(hpFor(def.Power)) .. " HP")
	Kit.Label(card, def.Blurb, { Size = UDim2.new(1, -30, 0, 52), Position = UDim2.fromOffset(15, 78), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 11, Stroke = 0 })
	if res.IsNew then
		local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(80, 30), Position = UDim2.new(1, 8, 0, -26), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Title", ZIndex = 14 })
		stamp.Rotation = 14
		-- drops into place and fades in (one text size throughout)
		stamp.TextTransparency = 1
		Kit.Tween(stamp, 0.3, { Position = UDim2.new(1, 8, 0, 4), TextTransparency = 0 }, Enum.EasingStyle.Back)
	end
	-- buttons
	local row: Frame = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0, 10, 1, -58),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = card,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = row })
	local equipped = d and table.find(d.Equipped, res.Uid) ~= nil
	local slots = if d then d.Slots or Config.Inventory.BaseSlots else Config.Inventory.BaseSlots
	if d and not equipped then
		local free = #d.Equipped < slots
		-- with full slots, offer EQUIP BEST only if this hunter beats the weakest equipped one
		-- tier power, as the server's EquipBest ranks hunters (a Shiny/Mega can beat a new pull)
		local function tierPower(h: any): number
			local hd = h and Config.Hunters[h.Id]
			local t = Config.Tiers[h and h.Tier or 0] or Config.Tiers[0]
			return if hd then Rules.HunterPower(hd.Power, t.Mult) else 0
		end
		local weakest = math.huge
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h then
				weakest = math.min(weakest, tierPower(h))
			end
		end
		local mine = d.Hunters[res.Uid]
		local newPower = if mine then tierPower(mine) else Rules.HunterPower(def.Power, 1)
		if free or newPower > weakest then
			local b: TextButton
			b = Kit.Button(row, {
				Text = if free then "EQUIP" else "EQUIP BEST",
				Color = "Green",
				Size = UDim2.fromOffset(118, 44),
				ZIndex = 12,
				OnClick = function()
					if not b.Active then
						return -- already equipped / request in flight (double tap)
					end
					b.Active = false
					local r = if free then State.Request("Equip", res.Uid) else State.Request("EquipBest")
					if r.ok then
						Kit.SetButtonText(b, "EQUIPPED ✅")
						b:SetAttribute("Color", "Gray")
					else
						b.Active = true
						Kit.Toast(r.err or "Couldn't equip", "Bad")
					end
				end,
			})
			b.Name = "EquipButton"
		end
	end
	if againFn then
		local crate = Config.Crates[res.Crate]
		local fnAgain = againFn
		Kit.Button(row, {
			Text = "AGAIN 💚" .. Format.Short(crate.Price),
			Color = "Purple",
			Size = UDim2.fromOffset(122, 44),
			ZIndex = 12,
			OnClick = function()
				fnAgain()
			end,
		})
	end
	okButton = Kit.Button(row, {
		Text = "OK",
		Color = "Blue",
		Size = UDim2.fromOffset(84, 44),
		ZIndex = 12,
		OnClick = function()
			Reveal.Close()
		end,
	})
end

-- Pet hatch result card: same look as the hunter card (rarity ribbon, name, bonus, OK).
local function petCard(g: ScreenGui, pet: Config.PetDef, rarity: Config.RarityDef)
	local card: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 200),
		Position = UDim2.new(1, 380, 0.5, 10),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = g,
	})
	Kit.Corner(card, UDim.new(0, 18))
	Kit.Stroke(card, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, Theme.Panel2, Theme.Bg, 90)
	Kit.Tween(card, 0.35, { Position = UDim2.new(1, -20, 0.5, 10) }, Enum.EasingStyle.Back)
	local ribbon: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(200, 32),
		Position = UDim2.new(0.5, 0, 0, -16),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 12,
		Parent = card,
	})
	Kit.Corner(ribbon, UDim.new(0, 10))
	Kit.Stroke(ribbon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ribbon, rarity.Color, rarity.Color2, 0)
	Kit.Label(ribbon, rarity.Name, { Style = "Heading", ZIndex = 13 })
	Kit.Label(card, string.upper(pet.Name), { Size = UDim2.new(1, -30, 0, 30), Position = UDim2.fromOffset(15, 22), Style = "Title", Fit = true, ZIndex = 11 })
	Kit.Label(card, PetsPanel.BonusText(pet.Bonus.Kind, pet.Bonus.Value), { Size = UDim2.new(1, -30, 0, 22), Position = UDim2.fromOffset(15, 56), Color = Theme.Ecto, Style = "Body", Fit = true, ZIndex = 11 })
	Kit.Label(card, "Equip it in PETS", { Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 84), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 11 })
	-- the hatched pet's portrait in the free bottom-left corner (left of the OK button)
	local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(0, 16, 1, -10), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = pet.Color:Lerp(Color3.new(0, 0, 0), 0.5), ZIndex = 11, Parent = card })
	Kit.Corner(pic, UDim.new(1, 0))
	Kit.Stroke(pic, 2.5, pet.Glow, Enum.ApplyStrokeMode.Border)
	PetPortrait.New(pic, pet.Id)
	-- HATCH AGAIN (same egg) between the portrait and OK, like the crates' AGAIN button
	local fnAgain = againFn
	if fnAgain then
		local egg = Config.Eggs[petEggId or ""]
		Kit.Button(card, {
			Text = "HATCH AGAIN" .. (if egg then " 🔮" .. Format.Short(egg.Price) else ""),
			Color = "Purple",
			TextStyle = "Small",
			Size = UDim2.fromOffset(150, 44),
			Position = UDim2.new(0, 92, 1, -12),
			AnchorPoint = Vector2.new(0, 1),
			ZIndex = 12,
			OnClick = function()
				fnAgain()
			end,
		})
	end
	okButton = Kit.Button(card, {
		Text = "OK",
		Color = "Blue",
		Size = UDim2.fromOffset(if fnAgain then 90 else 120, 44),
		Position = if fnAgain then UDim2.new(1, -14, 1, -12) else UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = if fnAgain then Vector2.new(1, 1) else Vector2.new(0.5, 1),
		ZIndex = 12,
		OnClick = function()
			Reveal.Close()
		end,
	})
end

local function teardownStage()
	shakeToken += 1
	for _, tw in liveTweens do
		tw:Cancel()
	end
	table.clear(liveTweens)
	cardShown = false
	okButton = nil
	if poseConn then
		poseConn:Disconnect()
		poseConn = nil
	end
	if stage then
		stage:Destroy()
		stage = nil
	end
	if gui then
		gui:Destroy()
		gui = nil
	end
	hunterRig = nil
	idleFn = nil
	rays = nil
end

-- Ends the reveal and gives the camera back.
function Reveal.Close()
	if not playing then
		return
	end
	-- a skip bought for THIS reveal that arrives later is kept as a token, not spent on the next one
	pendingSkip = false
	teardownStage()
	if cc then
		cc.Brightness = 0
		cc.Saturation = 0
		cc.Contrast = 0
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
	Kit.Screen().Enabled = true
	setControls(true)
	Targeting.SetBlocked(false)
	ProximityPromptService.Enabled = Kit.CurrentPanel() == nil
	ContextActionService:UnbindAction("GHRevealB")
	if GuiService.SelectedObject and not GuiService.SelectedObject:IsDescendantOf(Kit.Screen()) then
		GuiService.SelectedObject = nil
	end
	playing = false
	Kit.SetBusy("Reveal", false)
	finishedSignal:Fire()
end

export type PlayOpts = { Auto: boolean? }

-- Shared opening: locks input, builds the stage + GUI, frames the camera, starts the spin loop.
local function begin(rarity: Config.RarityDef): (ScreenGui, TextButton, Camera, CFrame, number)
	if playing then
		teardownStage() -- "AGAIN": keep the camera, rebuild the stage
	end
	playing = true
	Kit.SetBusy("Reveal", true) -- popups wait until the reveal is over
	skipping = autoMode and hasPermanentSkip() -- Auto Open + Permanent Skip: quick reveals
	startedSignal:Fire()
	Targeting.SetBlocked(true)
	setControls(false)
	Kit.Screen().Enabled = false
	ProximityPromptService.Enabled = false -- station prompts would float over the cinematic
	ContextActionService:BindActionAtPriority("GHRevealB", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			if cardShown then
				Reveal.Close()
			else
				task.spawn(requestSkip)
			end
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.ButtonB)
	buildStage(rarity)
	local g, skip = buildGui()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = CAM_FOV
	local camCF = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13), STAGE + Vector3.new(0, 2.6, 0))
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0)) -- lighting detail follows Focus
	flash(Color3.new(1, 1, 1), 0.35)
	-- rays spin + the hunter poses / the pet bobs
	raySpeed = 20
	hunterT0 = os.clock()
	poseConn = RunService.RenderStepped:Connect(function(dt: number)
		if rays then
			rays.Rotation = (rays.Rotation + dt * raySpeed) % 360
		end
		if hunterRig then
			HunterRig.Pose(hunterRig, hunterState, os.clock() - hunterT0, 1)
		end
		if idleFn then
			idleFn(os.clock() - hunterT0)
		end
	end)
	return g, skip, cam, camCF, if fast() then 0.5 else 1
end

-- Build-up: shake (+ levitate, darken and converging energy for rarer pulls). onAlpha(a) runs
-- every frame (egg cracks). Returns the levitation height.
local function shakePhase(rarity: Config.RarityDef, f: number, base: CFrame, place: (CFrame) -> (), onAlpha: ((number) -> ())?): number
	local shakeT = (0.55 + rarity.RevealPause) * f
	local levitate = if rarity.Order >= 3 then 1.4 else 0
	local charge: ParticleEmitter? = nil
	if rarity.RevealPause > 0.3 and not skipping then
		local sphere = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 2.5, 0)) })
		local e = Instance.new("ParticleEmitter")
		e.Shape = Enum.ParticleEmitterShape.Sphere
		e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Texture = Effects.Textures.Sparkle
		e.Color = ColorSequence.new(rarity.Color, rarity.Color2)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) })
		e.Speed = NumberRange.new(9, 12)
		e.Lifetime = NumberRange.new(0.45, 0.6)
		e.Rate = 0
		e.Parent = sphere
		charge = e
	end
	if cc and rarity.Darken > 0 and not skipping then
		tween(cc, TweenInfo.new(shakeT * 0.6), { Brightness = -rarity.Darken * 0.35, Saturation = -rarity.Darken * 0.4 })
	end
	local rl = (if stage then stage:FindFirstChild("RarityLight", true) else nil) :: any
	if not skipping then
		Sound.Play("CrateShake")
	end
	local nextShakeSound = os.clock() + 0.45
	anim(shakeT, function(a)
		local k = rarity.ShakeIntensity * (0.4 + a)
		local tt = os.clock()
		local wob = CFrame.Angles(math.sin(tt * 38) * 0.06 * k, math.sin(tt * 29) * 0.1 * k, math.sin(tt * 47) * 0.09 * k)
		local lift = levitate * math.sin(math.min(a * 1.6, 1) * math.pi / 2)
		place(base * CFrame.new(math.sin(tt * 53) * 0.12 * k, lift, 0) * wob)
		raySpeed = 20 + 160 * a * math.min(rarity.Order, 8) / 5 -- capped: Ultra/Exclusive don't keep scaling
		if charge then
			charge.Rate = 15 + 110 * a
		end
		if rl then
			rl.Brightness = 0.8 * a * math.min(1, rarity.Order / 3)
		end
		if onAlpha then
			onAlpha(a)
		end
		if tt >= nextShakeSound and a < 0.95 then
			nextShakeSound = tt + 0.45
			Sound.Play("CrateShake", 0.1)
		end
	end)
	if charge then
		charge.Rate = 0
	end
	place(base + Vector3.new(0, levitate, 0))
	return levitate
end

-- The pop: rarity sound, a short tinted flash, sparks and a ring (brightness kept low).
local function burstFx(rarity: Config.RarityDef, burstPos: Vector3, cam: Camera)
	if skipping then
		return
	end
	Sound.Play(rarity.Sound)
	flash(rarity.Color, 0.45)
	Effects.Flash(burstPos, rarity.Color, 3 + math.min(rarity.Order, 8) * 0.6, 0.4)
	Effects.Burst(burstPos, { Color = rarity.Color, Color2 = Color3.new(1, 1, 1), Count = math.floor(rarity.Particles * 0.6), Size = 0.65, Speed = 26, Life = 1.1, Gravity = 18 })
	Effects.Ring(STAGE + Vector3.new(0, 0.2, 0), rarity.Color, 10, 0.6)
	if cc then
		tween(cc, TweenInfo.new(0.5), { Brightness = -0.06, Saturation = 0.1, Contrast = 0.06 }) -- crisper, not washed out
		task.delay(0.5, function()
			if cc then
				tween(cc, TweenInfo.new(0.6), { Brightness = 0, Saturation = 0 })
			end
		end)
	end
	if rarity.CameraPunch then
		cam.FieldOfView = CAM_FOV - 10
		tween(cam, TweenInfo.new(0.45, Enum.EasingStyle.Back), { FieldOfView = CAM_FOV })
		task.spawn(cameraShake, 0.5 * rarity.ShakeIntensity, 0.35)
	end
end

-- Landing: ring + sparks, then spotlight the winner (neutral key light; rarity light and rays dimmed).
local function landFx(rarity: Config.RarityDef, to: Vector3)
	if not skipping then
		Effects.Ring(to + Vector3.new(0, 0.15, 0), Color3.new(1, 1, 1), 5, 0.4)
		Effects.Burst(to + Vector3.new(0, 3, 0), { Color = rarity.Color, Count = math.floor(rarity.Particles / 5), Size = 0.45, Speed = 14, Life = 0.7 })
	end
	local key = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(to + Vector3.new(0, 4.5, -4)) })
	Kit.new("PointLight", { Range = 10, Brightness = 0.5, Color = Color3.new(1, 1, 1), Shadows = false, Parent = key }) -- was 1.3
	local rl = (if stage then stage:FindFirstChild("RarityLight", true) else nil) :: any
	if rl then
		tween(rl, TweenInfo.new(0.5), { Brightness = 0.3 })
	end
	if rays then
		for _, ray in rays:GetChildren() do
			if ray:IsA("Frame") then
				tween(ray, TweenInfo.new(0.5), { BackgroundTransparency = 0.8 })
			end
		end
	end
end

-- Shared ending: legendary title slam, camera slides left, the result card, auto-close.
local function finish(g: ScreenGui, skip: TextButton, cam: Camera, camCF: CFrame, rarity: Config.RarityDef, card: () -> ())
	if rarity.Order >= 5 and not skipping then
		local title = Kit.Label(g, rarity.Name .. "!", { Size = UDim2.fromOffset(600, 70), Position = UDim2.new(0.5, 0, 0.2, -60), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.RarityText(rarity), Style = "Banner", ZIndex = 8, Stroke = 4 })
		-- solid colour (a UIGradient on big text dropped letters on phones); slams down and fades
		-- in rather than scaling, so the text renders at one size
		title.TextTransparency = 1
		Kit.Tween(title, 0.35, { Position = UDim2.fromScale(0.5, 0.2), TextTransparency = 0 }, Enum.EasingStyle.Back)
		task.spawn(cameraShake, 0.35, 0.3)
	end
	skip.Visible = false
	skipping = false
	raySpeed = 25
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0))
	-- slide the camera so the winner sits left of centre, clear of the info card on the right
	local side = Vector3.new(-3.6, 0, 0)
	tween(cam, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { CFrame = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13) + side, STAGE + Vector3.new(0, 2.6, 0) + side) })
	card()
	cardShown = true
	if autoMode then
		-- Auto Open: the card closes by itself so the next crate can play
		local myStage = stage
		task.delay(if hasPermanentSkip() then 0.6 else 1.4, function()
			if playing and stage == myStage then
				Reveal.Close()
			end
		end)
	end
	if okButton and UserInputService.GamepadEnabled and UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then
		GuiService.SelectedObject = okButton
	end
end

-- Plays the opening for a server-confirmed result. `again` (optional) re-buys the same crate.
-- opts.Auto: Auto Open reveal (STOP button, the card closes by itself).
function Reveal.Play(res: Result, again: (() -> ())?, opts: PlayOpts?)
	petMode = false
	local def = Config.Hunters[res.Hunter]
	local crateDef = Config.Crates[res.Crate]
	if not def or not crateDef then
		return
	end
	autoMode = opts ~= nil and opts.Auto == true
	local rarity = Config.Rarities[def.Rarity]
	againFn = again
	local g, skip, cam, camCF, f = begin(rarity)
	local my = stage

	-- crate
	local crate = CrateRig.Build(res.Crate)
	crate.Model:ScaleTo(1.25)
	crate.Model.Parent = stage
	local base = CFrame.new(STAGE)
	local function placeCrate(cf: CFrame)
		crate.Model:PivotTo(cf)
	end
	placeCrate(base + Vector3.new(0, 9, 0))

	Sound.Play("CrateBuy")
	-- 1) drop in with a bounce
	anim(0.45 * f, function(a)
		placeCrate(base + Vector3.new(0, 9 * (1 - easeOutBounce(a)), 0))
	end)
	if stage ~= my then
		return
	end
	-- 2) shake
	local levitate = shakePhase(rarity, f, base, placeCrate)
	if stage ~= my then
		return
	end
	-- 3) locks pop off
	if not skipping then
		Sound.Play("LockPop")
	end
	anim(0.22 * f, function(a)
		local e = easeOutBack(a)
		crate.Motors.LockL.Transform = CFrame.new(-1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, 2.5 * a)
		crate.Motors.LockR.Transform = CFrame.new(1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, -2.5 * a)
	end)
	-- drop the padlocks (and their welded shackles) out of sight
	crate.Motors.LockL.Transform = CFrame.new(0, -60, 0)
	crate.Motors.LockR.Transform = CFrame.new(0, -60, 0)
	-- 4) lid flies open + light burst
	burstFx(rarity, crate.Burst.WorldPosition, cam)
	crate.Glow.Color = rarity.Color
	anim(0.3 * f, function(a)
		crate.Motors.Lid.Transform = CFrame.Angles(math.rad(115) * easeOutBack(a), 0, 0)
		crate.Glow.Transparency = 1 - 0.6 * a
	end)
	if stage ~= my then
		return
	end
	-- 5) hunter leaps out
	local rig = HunterRig.Build(res.Hunter)
	rig.Model:ScaleTo(1.2)
	rig.Model.Parent = stage
	hunterRig = rig
	hunterState = "Celebrate"
	hunterT0 = os.clock()
	local from = STAGE + Vector3.new(0, levitate + 0.6, 0.2)
	local to = STAGE + Vector3.new(0, 0, -4.6)
	anim(0.55 * f, function(a)
		local p = from:Lerp(to, a) + Vector3.new(0, 5.5 * 4 * a * (1 - a), 0)
		local spin = (1 - a) * math.pi * 2
		rig.Model:PivotTo(CFrame.new(p) * CFrame.Angles(0, spin, 0))
	end)
	rig.Model:PivotTo(CFrame.new(to))
	-- the crate settles back down behind the hunter
	placeCrate(base)
	landFx(rarity, to)
	tween(crate.Glow, TweenInfo.new(0.5), { Transparency = 0.75 })
	if stage ~= my then
		return
	end
	-- 6) title slam + result card
	finish(g, skip, cam, camCF, rarity, function()
		resultCard(g, res, rarity)
	end)
end

--------------------------------------------------------------------------------
-- PET EGG HATCH: same stage, camera and pacing as a crate, with the egg in the crate's place.
-- The egg copies the hatchery pedestal looks (World/Hatchery); its front faces the camera (-Z).
--------------------------------------------------------------------------------
type EggPiece = { Part: Part, Offset: CFrame, Top: boolean, Tr: number }

local function buildEgg(egg: Config.EggDef): ({ EggPiece }, { Part })
	local pieces: { EggPiece } = {}
	local cracks: { Part } = {}
	local SMOOTH, NEON, GLASS = Enum.Material.SmoothPlastic, Enum.Material.Neon, Enum.Material.Glass
	local function add(props: { [string]: any }, offset: CFrame): Part
		local p = part(props)
		table.insert(pieces, { Part = p, Offset = offset, Top = offset.Y > 3.1, Tr = p.Transparency })
		return p
	end
	local function ball(d: number, x: number, y: number, z: number, col: Color3, mat: Enum.Material?, tr: number?): Part
		return add({ Shape = Enum.PartType.Ball, Size = Vector3.one * d, Color = col, Material = mat or SMOOTH, Transparency = tr or 0 }, CFrame.new(x, y, z))
	end
	local function block(size: Vector3, cf: CFrame, col: Color3, mat: Enum.Material?, shape: Enum.PartType?): Part
		return add({ Shape = shape or Enum.PartType.Block, Size = size, Color = col, Material = mat or SMOOTH }, cf)
	end
	local glass = egg.Id == "PhantomEgg"
	local shellMat = if glass then GLASS else SMOOTH
	local shellTr = if glass then 0.3 else 0
	local low = ball(4.2, 0, 2.1, 0, egg.Color, shellMat, shellTr)
	local high = ball(3.4, 0, 3.6, 0, egg.Color, shellMat, shellTr)
	low.Reflectance = if glass then 0.1 else 0.15
	high.Reflectance = low.Reflectance
	if egg.Id == "HauntedEgg" then
		-- green ecto cracks across the front and dark speckles
		for _, c in { { -0.9, 2.4, 25 }, { 0.2, 2.9, -35 }, { 0.9, 2.2, 40 }, { -0.2, 3.9, 60 } } do
			block(Vector3.new(0.18, 1.2, 0.2), CFrame.new(c[1], c[2], -2.05) * CFrame.Angles(0, 0, math.rad(c[3])), egg.Accent, NEON)
		end
		for _, sp in { { -1.3, 1.6 }, { 1.2, 3.4 }, { 0.6, 1.2 } } do
			ball(0.6, sp[1], sp[2], -1.75, Color3.fromRGB(70, 30, 120))
		end
	elseif egg.Id == "PhantomEgg" then
		-- soft inner core and a ghost face
		ball(2.4, 0, 2.5, 0, egg.Accent, SMOOTH, 0.4)
		local dark = Color3.fromRGB(30, 30, 60)
		ball(0.8, -0.7, 3.4, -1.55, dark)
		ball(0.8, 0.7, 3.4, -1.55, dark)
		block(Vector3.new(0.9, 0.6, 0.3), CFrame.new(0, 2.4, -2.0), dark)
	elseif egg.Id == "MoonlightEgg" then
		-- crescent moon (pale disc partly covered by an egg-coloured disc) and stars
		local cyl = Enum.PartType.Cylinder
		block(Vector3.new(0.2, 1.6, 1.6), CFrame.new(0.2, 3.0, -2.0) * CFrame.Angles(0, math.pi / 2, 0), egg.Accent, SMOOTH, cyl)
		block(Vector3.new(0.2, 1.4, 1.4), CFrame.new(-0.2, 3.15, -2.08) * CFrame.Angles(0, math.pi / 2, 0), egg.Color, SMOOTH, cyl)
		for _, s in { { -1.2, 1.7 }, { 1.1, 2.0 }, { 0.8, 4.1 }, { -0.9, 4.0 }, { 0.1, 1.2 } } do
			ball(0.35, s[1], s[2], -1.85, Color3.fromRGB(255, 245, 200), NEON)
		end
	end
	-- hatch cracks: a zigzag around the waist that shows up bit by bit while the egg shakes
	for i, c in { { -1.5, 3.0, 40 }, { -0.75, 3.15, -40 }, { 0, 3.0, 40 }, { 0.75, 3.15, -40 }, { 1.5, 3.0, 40 } } do
		local z = -math.sqrt(math.max(0, 1.87 ^ 2 - c[1] ^ 2)) - 0.05 -- shell radius at the waist (y 3)
		local p = block(Vector3.new(0.16, 0.95, 0.16), CFrame.new(c[1], c[2], z) * CFrame.Angles(0, 0, math.rad(c[3])), egg.Accent, NEON)
		p.Transparency = 1
		cracks[i] = p
	end
	return pieces, cracks
end

export type PetResult = { Egg: string, Pet: string }

-- Hatch cinematic for a pet the server already granted (presentation only).
function Reveal.PlayPet(res: PetResult, again: (() -> ())?)
	local egg = Config.Eggs[res.Egg]
	local pet = Config.Pets[res.Pet]
	local rarity = pet and Config.Rarities[pet.Rarity]
	if not egg or not pet or not rarity then
		return
	end
	autoMode = false
	againFn = again
	petEggId = res.Egg
	petMode = true
	local g, skip, cam, camCF, f = begin(rarity)
	local my = stage

	local pieces, cracks = buildEgg(egg)
	local base = CFrame.new(STAGE)
	local topCF = CFrame.identity
	local function placeEgg(cf: CFrame)
		for _, pc in pieces do
			pc.Part.CFrame = if pc.Top then cf * topCF * pc.Offset else cf * pc.Offset
		end
	end
	placeEgg(base + Vector3.new(0, 9, 0))

	Sound.Play("CrateBuy")
	-- 1) drop in with a bounce
	anim(0.45 * f, function(a)
		placeEgg(base + Vector3.new(0, 9 * (1 - easeOutBounce(a)), 0))
	end)
	if stage ~= my then
		return
	end
	-- 2) shake while the cracks spread
	local levitate = shakePhase(rarity, f, base, placeEgg, function(a)
		for i, c in cracks do
			c.Transparency = if a >= i / (#cracks + 1) then 0 else 1
		end
	end)
	for _, c in cracks do
		c.Transparency = 0
	end
	if stage ~= my then
		return
	end
	-- 3) the shell pops: the top flies off, the bottom fades
	local eggCF = base + Vector3.new(0, levitate, 0)
	burstFx(rarity, eggCF.Position + Vector3.new(0, 3.2, 0), cam)
	anim(0.3 * f, function(a)
		local e = easeOutBack(a)
		topCF = CFrame.new(1.2 * a, 3.5 * e, 1.5 * a) * CFrame.Angles(-1.4 * a, 0, -0.9 * a)
		for _, pc in pieces do
			pc.Part.Transparency = if pc.Top then pc.Tr + (1 - pc.Tr) * a else pc.Tr
		end
		placeEgg(eggCF)
	end)
	for _, pc in pieces do
		if not pc.Top then
			tween(pc.Part, TweenInfo.new(0.45 * f), { Transparency = 1 })
		end
	end
	if stage ~= my then
		return
	end
	-- 4) the pet pops out (PetFollowers' ghost, scaled up, rarity glow kept soft)
	local model = PetFollowers.BuildPet(pet.Id)
	if not model then
		return
	end
	model:ScaleTo(3)
	for _, d in model:GetDescendants() do
		if d:IsA("PointLight") then -- ScaleTo widened the range 3x: keep the rarity glow soft
			d.Brightness = math.min(d.Brightness, 0.9)
			d.Range = math.min(d.Range, 12)
		end
	end
	model.Parent = stage
	local from = eggCF.Position + Vector3.new(0, 2.5, 0)
	local to = STAGE + Vector3.new(0, 3, -4.6)
	anim(0.55 * f, function(a)
		local p = from:Lerp(to, a) + Vector3.new(0, 5.5 * 4 * a * (1 - a), 0)
		model:PivotTo(CFrame.new(p) * CFrame.Angles(0, (1 - a) * math.pi * 2, 0))
	end)
	model:PivotTo(CFrame.new(to))
	hunterT0 = os.clock()
	idleFn = function(t: number)
		model:PivotTo(CFrame.new(to + Vector3.new(0, math.sin(t * 2.2) * 0.3, 0)) * CFrame.Angles(0, math.sin(t * 1.3) * 0.35, 0))
	end
	landFx(rarity, to - Vector3.new(0, 3, 0))
	if stage ~= my then
		return
	end
	-- 5) title slam + pet card
	finish(g, skip, cam, camCF, rarity, function()
		petCard(g, pet, rarity)
	end)
end

function Reveal.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "GHRevealCC"
	effect.Parent = Lighting
	cc = effect
end

function Reveal.StopAuto()
	autoMode = false
	task.spawn(function()
		State.Request("AutoOpen", nil)
	end)
	stopAutoSignal:Fire()
end

function Reveal.Start()
	-- a Single Crate Skip bought during a reveal is used right away
	State.OnFx("SkipGranted", function()
		if skipButton and skipButton.Parent then
			Kit.SetButtonText(skipButton, skipLabel())
			skipButton.Visible = not cardShown and canSkip()
		end
		if pendingSkip and playing and not cardShown then
			task.spawn(requestSkip)
		end
	end)
	-- respawning mid-reveal must not leave the camera stuck
	player.CharacterAdded:Connect(function()
		if playing then
			Reveal.Close()
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- SHOP: Robux products (Ectoplasm packs, boosts) and game passes. Items without an id in
-- Config aren't listed (a pass without an id only shows, as OWNED, to players who have it).
-- Purchases are prompted and granted by the server only.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local ShopPanel = {}

local panel: Kit.Panel
local passButtons: { [string]: TextButton } = {}
local ectoLabels: { [string]: TextLabel } = {}
local unsoldPasses: { [string]: GuiObject } = {} -- pass cards with no PassId yet: owners only

local function card(parent: Instance, order: number, iconKey: string?, icon: string, name: string, sub: string, price: string, available: boolean, color: string, onBuy: () -> ()): (TextButton, TextLabel)
	local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = parent })
	Kit.Corner(f, UDim.new(0, 14))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local c = Theme.Buttons[color] or Theme.Buttons.Purple
	Kit.Gradient(f, c[1], c[2], 90)
	Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), Style = "Icon", TextSize = 32, ZIndex = 63, Stroke = 0 })
	Kit.Label(f, name, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 48), Style = "Body", ZIndex = 63 })
	local subLabel = Kit.Label(f, sub, { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 84), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Font = Theme.Body, Style = "Tiny", Stroke = 1 })
	local b = Kit.Button(f, {
		Text = if available then price else "SOON",
		Color = if available then "Green" else "Gray",
		Size = UDim2.new(1, -16, 0, 38),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 64,
		OnClick = onBuy,
	})
	return b, subLabel
end

-- Live Robux prices: Roblox "managed pricing" can change them, so ask Roblox once per item
-- and show what it says (the Config PriceLabel is only the fallback).
local priceButtons: { [string]: TextButton } = {}
local function fetchPrices()
	local function fetch(key: string, id: number, kind: Enum.InfoType)
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, kind)
		end)
		local b = priceButtons[key]
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" and b then
			local d = State.Data
			if not (d and d.Passes and d.Passes[key]) then
				Kit.SetButtonText(b, "R$ " .. info.PriceInRobux)
			end
		end
	end
	for _, p in Config.Products do
		if p.ProductId and priceButtons[p.Key] then
			task.spawn(fetch, p.Key, p.ProductId, Enum.InfoType.Product)
		end
	end
	for _, pass in Config.GamePasses do
		if pass.PassId then
			task.spawn(fetch, pass.Key, pass.PassId, Enum.InfoType.GamePass)
		end
	end
end

local function buy(key: string)
	local res = State.Request("Buy", key)
	if not res.ok then
		Kit.Toast(res.err or "Can't buy that right now", "Bad")
	end
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local mult = d.ZoneMultiplier or 1
	for _, p in Config.Products do
		local l = ectoLabels[p.Key]
		if l and p.Amount then
			-- the amount the player really gets now; it grows with their best unlocked area
			l.Text = "+" .. Format.Short(p.Amount * mult) .. " ECTOPLASM\nGrows with your best area!"
		end
	end
	for _, pass in Config.GamePasses do
		local b = passButtons[pass.Key]
		local unsold = unsoldPasses[pass.Key]
		if unsold then
			unsold.Visible = d.Passes ~= nil and d.Passes[pass.Key] == true
		end
		if b and d.Passes and d.Passes[pass.Key] then
			Kit.SetButtonText(b, "OWNED ✅")
			b:SetAttribute("Color", "Gray")
		end
	end
end

function ShopPanel.Init()
	panel = Kit.Panel("Shop", "SHOP", Vector2.new(780, 500), "Pink")
	local scroll: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 10),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	-- cards wrap to as many rows as the panel width needs
	local function section(order: number, title: string): Frame
		Kit.Label(scroll, title, { Size = UDim2.new(1, 0, 0, 24), Style = "Heading", ZIndex = 62 }).LayoutOrder = order
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, ZIndex = 61, Parent = scroll })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 168), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		return row
	end
	local prodRow = section(1, "BOOSTS & ECTOPLASM")
	for i, p in Config.Products do
		if p.Kind == "SummonEvent" then
			continue -- retired with the Giant Poltergeist event (no longer sold)
		end
		if p.ProductId == nil then
			continue -- not on sale yet (no "SOON" buttons)
		end
		local sub = if p.Blurb then p.Blurb elseif p.Kind == "Ecto" then "+" .. Format.Short(p.Amount or 0) .. " ECTOPLASM" else Format.Time(p.Seconds or 0) .. " BOOST"
		local prodButton, subLabel = card(prodRow, i, Icons.ForProduct[p.Key], p.Icon, p.Name, sub, p.PriceLabel, p.ProductId ~= nil, if p.Kind == "Ecto" then "Green" else "Purple", function()
			buy(p.Key)
		end)
		if p.Kind == "Ecto" then
			ectoLabels[p.Key] = subLabel
		end
		priceButtons[p.Key] = prodButton
	end
	local passRow = section(3, "GAME PASSES (FOREVER)")
	for i, pass in Config.GamePasses do
		if pass.Hidden then
			continue -- no longer sold (e.g. the old Auto Attack pass: Auto Attack is free now)
		end
		local sub = if pass.Blurb then pass.Blurb elseif pass.Slots then "+" .. pass.Slots .. " EQUIPPED HUNTERS" else "x" .. tostring(pass.Multiplier or 2) .. " GHOST & TOWER ECTOPLASM"
		local b = card(passRow, i, Icons.ForProduct[pass.Key], pass.Icon, pass.Name, sub, pass.PriceLabel, pass.PassId ~= nil, "Orange", function()
			buy(pass.Key)
		end)
		passButtons[pass.Key] = b
		priceButtons[pass.Key] = b
		if pass.PassId == nil then
			local f = b.Parent :: GuiObject
			f.Visible = false
			unsoldPasses[pass.Key] = f
		end
	end
	Kit.Label(scroll, "Ectoplasm packs grow with the furthest area you've unlocked.", { Size = UDim2.new(1, -10, 0, 36), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 }).LayoutOrder = 5
	Hud.RegisterPanel("Shop", function()
		panel:Toggle()
	end)
end

function ShopPanel.Start()
	panel.OnOpen:Connect(refresh)
	-- prices: once when the shop first opens, then every few minutes while it's opened again
	local lastFetch = -math.huge
	panel.OnOpen:Connect(function()
		if os.clock() - lastFetch > 300 then
			lastFetch = os.clock()
			fetchPrices()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds by key from GH.Sounds; respects the player's Music/SFX settings.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Sounds = require(GH.Sounds)
local State = require(script.Parent.Parent.State)

local Sound = {}

local pool: { [string]: { Sound } } = {}
local folder: Folder
local music: Sound? = nil
local bossMusic: Sound? = nil
local lastPlay: { [string]: number } = {}

local function sfxOn(): boolean
	local d = State.Data
	return not d or d.Settings.Sfx ~= false
end

local function make(key: string): Sound?
	local def = Sounds[key]
	if not def or not def.Id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch or 1
	s.Looped = def.Looped == true
	s.Parent = folder
	return s
end

-- pitchJitter adds small random variation; pitchMul shifts the pitch (pickup streaks).
function Sound.Play(key: string, pitchJitter: number?, pitchMul: number?)
	if not sfxOn() then
		return
	end
	local now = os.clock()
	if now - (lastPlay[key] or 0) < 0.035 then
		return -- de-dupe bursts (e.g. 20 orbs landing at once)
	end
	lastPlay[key] = now
	local list = pool[key]
	if not list then
		list = {}
		pool[key] = list
	end
	local s: Sound? = nil
	for _, c in list do
		if not c.IsPlaying then
			s = c
			break
		end
	end
	if not s and #list < 4 then
		s = make(key)
		if s then
			table.insert(list, s)
		end
	end
	if s then
		local def = Sounds[key]
		s.PlaybackSpeed = (def.Pitch or 1) * (pitchMul or 1) * (1 + (if pitchJitter then (math.random() * 2 - 1) * pitchJitter else 0))
		s.TimePosition = 0
		s:Play()
	end
end

local function refreshMusic()
	local d = State.Data
	local on = not d or d.Settings.Music ~= false
	for _, m in { music, bossMusic } do
		if m then
			m.Volume = if on then (Sounds[m.Name].Volume) else 0
		end
	end
end

function Sound.Boss(active: boolean)
	if bossMusic and music then
		if active then
			bossMusic:Play()
			music:Pause()
		else
			bossMusic:Stop()
			music:Resume()
		end
	end
end

function Sound.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHSounds"
	folder.Parent = SoundService
end

function Sound.Start()
	music = make("Music")
	bossMusic = make("BossMusic")
	if music then
		music:Play()
	end
	State.OnData(function()
		refreshMusic()
	end)
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Targeting</string>
              <string name="Source"><![CDATA[--!strict
-- Ghost selection. PC: click a ghost. Mobile: tap a ghost. Console: ButtonX (or F on a
-- keyboard) targets the ghost nearest the centre of the screen and cycles on repeat presses.
-- The selection is optimistic (instant highlight + sound) and then follows the server's
-- authoritative "Target" attribute.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Targeting = {}

local player = Players.LocalPlayer
local selectRemote: RemoteEvent
local selectHL: Highlight
local hoverHL: Highlight
local pending: number? = nil
local pendingAt = 0
local blocked = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local selectedSignal = Signal.new()
Targeting.Selected = selectedSignal -- (uid) fired on a local selection

function Targeting.SetBlocked(on: boolean)
	blocked = on
end

function Targeting.Current(): number
	return (player:GetAttribute("Target") :: number?) or 0
end

-- The target your crew should be heading for right now: your fresh tap (before the server
-- confirms it) or the server's choice. Lets your hunters react the instant you tap.
function Targeting.LocalTarget(): number
	return pending or Targeting.Current()
end

local function showHighlight(uid: number)
	local e = if uid ~= 0 then Ghosts.Get(uid) else nil
	if e then
		selectHL.Adornee = e.Model
		selectHL.OutlineColor = e.Def.Glow
		selectHL.FillColor = e.Def.Glow
		selectHL.Enabled = true
		Ghosts.SetSelected(uid)
	else
		selectHL.Adornee = nil
		selectHL.Enabled = false
		Ghosts.SetSelected(0)
	end
end

local function rootPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

function Targeting.Select(uid: number)
	if blocked then
		return
	end
	local e = Ghosts.Get(uid)
	if not e then
		return
	end
	local zone = Config.ZoneById[e.Def.Zone]
	local d = State.Data
	if d and zone and not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " first!", "Bad")
		return
	end
	local p = rootPos()
	if p and (e.Pos - p).Magnitude > Config.Combat.MaxRange + 10 then
		Kit.Toast("Get closer to that ghost!", "Bad")
		return
	end
	pending = uid
	pendingAt = os.clock()
	showHighlight(uid)
	Sound.Play("Select")
	Effects.Ring(e.Pos, e.Def.Glow, 4 * e.Def.Scale, 0.35)
	-- re-tapping the current ghost still tells the server while Auto Attack is on, so the pick
	-- becomes manual and turning Auto Attack off keeps it
	if Targeting.Current() ~= uid or player:GetAttribute("AutoAttack") == true then
		selectRemote:FireServer(uid)
	end
	selectedSignal:Fire(uid)
end

-- `pos` is in GUI coordinates (InputObject.Position, TouchTap) unless `viewport` is true
-- (GetMouseLocation); the matching camera functions keep the top-bar inset consistent.
local function ghostAtScreen(pos: Vector2, viewport: boolean?): Ghosts.Entry?
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Ghosts")
	if not cam or not folder then
		return nil
	end
	rayParams.FilterDescendantsInstances = { folder }
	local ray = if viewport then cam:ViewportPointToRay(pos.X, pos.Y) else cam:ScreenPointToRay(pos.X, pos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams)
	-- (a culled ghost's hitbox isn't moved while parked, so a hit on it is a stale position)
	local hitEntry = if hit then Ghosts.FromInstance(hit.Instance) else nil
	if hitEntry and not hitEntry.Culled then
		return hitEntry
	end
	-- Forgiving fallback (no surgical taps needed): the ghost whose centre is nearest the tap,
	-- within ~8% of the screen. When ghosts overlap, the one nearer the camera wins ties.
	local vp = cam.ViewportSize
	local radius = math.clamp(math.min(vp.X, vp.Y) * 0.08, 40, 72)
	local camPos = cam.CFrame.Position
	local best, bestScore = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Dying or e.Culled then
			continue
		end
		local sp, onScreen
		if viewport then
			sp, onScreen = cam:WorldToViewportPoint(e.Pos)
		else
			sp, onScreen = cam:WorldToScreenPoint(e.Pos)
		end
		if onScreen then
			-- bigger ghosts are bigger targets on screen
			local reach = radius + 12 * e.Def.Scale
			local dist = (Vector2.new(sp.X, sp.Y) - pos).Magnitude
			if dist <= reach then
				local score = dist + 0.15 * (e.Pos - camPos).Magnitude
				if score < bestScore then
					best, bestScore = e, score
				end
			end
		end
	end
	return best
end

-- Console / keyboard: pick the ghost closest to screen centre (within range), cycling.
local function cycleTarget()
	local cam = workspace.CurrentCamera
	local p = rootPos()
	if not cam or not p then
		return
	end
	local list = {}
	local d = State.Data
	for uid, e in Ghosts.All() do
		if e.Dying or (d and not d.Zones[e.Def.Zone]) then
			continue
		end
		if (e.Pos - p).Magnitude <= Config.Combat.MaxRange then
			local sp, onScreen = cam:WorldToViewportPoint(e.Pos)
			if onScreen then
				local c = cam.ViewportSize / 2
				table.insert(list, { Uid = uid, Score = (Vector2.new(sp.X, sp.Y) - c).Magnitude })
			end
		end
	end
	if #list == 0 then
		Kit.Toast("No ghosts nearby!", "Bad")
		return
	end
	table.sort(list, function(a, b)
		return a.Score < b.Score
	end)
	local cur = pending or Targeting.Current()
	local idx = 1
	for i, item in list do
		if item.Uid == cur then
			idx = (i % #list) + 1
			break
		end
	end
	Targeting.Select(list[idx].Uid)
end

function Targeting.Init()
	selectHL = Instance.new("Highlight")
	selectHL.Name = "GHSelect"
	selectHL.FillTransparency = 0.75
	selectHL.OutlineTransparency = 0
	selectHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	selectHL.Enabled = false
	selectHL.Parent = workspace
	hoverHL = Instance.new("Highlight")
	hoverHL.Name = "GHHover"
	hoverHL.FillTransparency = 1
	hoverHL.OutlineColor = Color3.new(1, 1, 1)
	hoverHL.OutlineTransparency = 0.3
	hoverHL.DepthMode = Enum.HighlightDepthMode.Occluded
	hoverHL.Enabled = false
	hoverHL.Parent = workspace
end

function Targeting.Start()
	selectRemote = Net.Event("SelectTarget")

	-- Mouse click (PC). Taps use TouchTap so camera drags never select by accident.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or blocked then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local e = ghostAtScreen(Vector2.new(input.Position.X, input.Position.Y))
			if e then
				Targeting.Select(e.Uid)
			end
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or blocked or #positions == 0 then
			return
		end
		local e = ghostAtScreen(positions[1])
		if e then
			Targeting.Select(e.Uid)
		end
	end)
	ContextActionService:BindAction("GHTarget", function(_, state)
		if state == Enum.UserInputState.Begin and not blocked then
			cycleTarget()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonX, Enum.KeyCode.F)

	-- authoritative target from the server
	player:GetAttributeChangedSignal("Target"):Connect(function()
		local uid = Targeting.Current()
		pending = nil
		showHighlight(uid)
	end)
	Ghosts.Died:Connect(function(uid)
		if selectHL.Adornee and Targeting.Current() == uid then
			showHighlight(0)
		end
	end)

	-- hover outline (mouse only) + reconcile a rejected optimistic selection
	RunService.RenderStepped:Connect(function()
		if pending and os.clock() - pendingAt > 0.8 then
			pending = nil
			showHighlight(Targeting.Current())
		end
		if not UserInputService.MouseEnabled or blocked then
			hoverHL.Enabled = false
			return
		end
		local m = UserInputService:GetMouseLocation()
		local e = ghostAtScreen(m, true)
		if e and e.Model ~= selectHL.Adornee then
			hoverHL.Adornee = e.Model
			hoverHL.Enabled = true
		else
			hoverHL.Enabled = false
		end
	end)
end

return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">TowerHud</string>
              <string name="Source"><![CDATA[--!strict
-- ENDLESS BOSS TOWER HUD. Everything here only shows what the server says (Fx "Tower",
-- Fx "TowerRoomCleared", player attributes InTower / TowerRoom); the buttons only send
-- "TowerStart"(startRoom), "TowerContinue" and "TowerLeave" requests, the server decides the rest.
--   * on the entrance pad: checkpoint info + ENTER (Room 1) / START AT ROOM n (checkpoint + 1)
--     buttons, then a countdown pill with the party size and start room;
--   * in a room: a top bar (ROOM n + boss name, timer, boss Spirit bar, earned this run) and a
--     LEAVE button (tap twice: leaving mid-fight ends your run, rewards you already got are kept);
--   * boss beaten: "BOSS DEFEATED! Rewards collected" banner with your payout, shard orbs pop
--     out of the chest and float to you, then shard icons fly to the top-bar shards counter
--     (presentation only: the server already credited everything);
--   * between rooms: CONTINUE (vote) and LEAVE with the time left and votes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Effects = require(script.Parent.Effects)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)

local TowerHud = {}

local player = Players.LocalPlayer
local PURPLE_A, PURPLE_B = Color3.fromRGB(80, 50, 140), Color3.fromRGB(40, 20, 70)

-- "Idle" | "Fight" | "Between"
local phase = "Idle"
local room = 0
local bossUid = 0
local endsAt = 0
local padEndsAt = 0 -- countdown on the pad (0 = none)
local padBase = ""
local leaveArmedUntil = 0
local votes, party = 0, 1
local voted = false
local devRun = false -- DEV test run: no rewards
local SHARD = Color3.fromRGB(200, 160, 255)

local bar: Frame
local titleLabel: TextLabel
local timerLabel: TextLabel
local fill: Frame
local spiritLabel: TextLabel
local earnedLabel: TextLabel
local padPill: Frame
local padLabel: TextLabel
local enterButton: TextButton
local checkpointButton: TextButton
local padInfo: TextLabel
local padBox: Frame
local actions: Frame
local infoLabel: TextLabel
local continueButton: TextButton
local leaveButton: TextButton

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function setEarned(e: any)
	if devRun then
		Kit.IconText(earnedLabel, "DEV RUN - no rewards")
	elseif type(e) == "table" then
		Kit.IconText(earnedLabel, string.format("This run: +💚%s Ecto  ·  +🔮%s Shards", Format.Short(tonumber(e.Ecto) or 0), Format.Commas(tonumber(e.Shards) or 0)))
	end
end

local function bossModel(): Model?
	local folder = workspace:FindFirstChild("Ghosts")
	local m = folder and folder:FindFirstChild("Ghost_" .. bossUid)
	return if m and m:IsA("Model") then m else nil
end

local function refreshButtons()
	local inRun = phase ~= "Idle"
	bar.Visible = inRun
	actions.Visible = inRun
	continueButton.Visible = phase == "Between"
	if phase == "Between" then
		Kit.SetButtonText(continueButton, if voted then "✔ WAITING..." else "▶ CONTINUE")
	end
	Kit.SetButtonText(leaveButton, if os.clock() < leaveArmedUntil then "SURE? TAP AGAIN" else "🚪 LEAVE")
end

local function setPhase(p: string)
	phase = p
	if p ~= "Between" then
		voted = false
	end
	refreshButtons()
end

local function onTower(data: any)
	if type(data) ~= "table" then
		return
	end
	local s = data.State
	if s == "Pad" then
		padEndsAt = tonumber(data.EndsAt) or 0
		padBase = string.format("👻 BOSS TOWER  ·  party %d/%d  ·  Room %d", tonumber(data.Count) or 1, tonumber(data.Max) or Config.Tower.MaxParty, tonumber(data.StartRoom) or 1)
		padPill.Visible = true
	elseif s == "PadCancel" then
		padEndsAt = 0
		padPill.Visible = false
	elseif s == "Fight" then
		padEndsAt = 0
		padPill.Visible = false
		room = tonumber(data.Room) or room
		bossUid = tonumber(data.Uid) or 0
		endsAt = tonumber(data.EndsAt) or 0
		party = tonumber(data.Party) or party
		devRun = data.Dev == true
		titleLabel.Text = string.format("🏰 ROOM %d  ·  %s", room, tostring(data.Boss or "BOSS"))
		fill.Size = UDim2.fromScale(1, 1)
		setEarned(data.Earned)
		setPhase("Fight")
		Sound.Play("BossAppear")
		Hud.Banner("ROOM " .. room, "Tap the boss to attack it!", Theme.Ecto)
	elseif s == "Votes" then
		votes = tonumber(data.Votes) or 0
		party = tonumber(data.Party) or party
	elseif s == "Ended" then
		setPhase("Idle")
		bossUid = 0
		local e = data.Earned
		local sub = tostring(data.Reason or "")
		if devRun then
			sub ..= "\nDEV RUN - no rewards"
		elseif type(e) == "table" then
			sub ..= string.format("\nBest room: %d  ·  +%s Ecto  ·  +%s Shards", tonumber(data.Best) or 0, Format.Short(tonumber(e.Ecto) or 0), Format.Commas(tonumber(e.Shards) or 0))
		end
		Hud.Banner("TOWER RUN OVER", sub, Theme.Gold)
		devRun = false
	end
end

-- UI: a few shard icons fly from the middle of the screen (your character) to the top-bar
-- shards counter; a small "+N" under it ticks up as each one lands. Presentation only.
local function flyToCounter(icons: number, total: number)
	local pill = Hud.ShardsPill
	local gui = pill and pill:FindFirstAncestorOfClass("ScreenGui")
	if not pill or not gui or icons <= 0 then
		return
	end
	local target: Frame = pill
	local sc = gui:FindFirstChildOfClass("UIScale")
	local k = if sc and sc.Scale > 0 then sc.Scale else 1
	local tick = Kit.Label(target, "+0", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, 4), Color = SHARD, Style = "Body", ZIndex = 6 })
	local shown = 0
	for i = 1, icons do
		task.delay((i - 1) * 0.12, function()
			if not target.Parent then
				return
			end
			local from = (gui.AbsoluteSize * Vector2.new(0.5, 0.55)) / k
			local to = (target.AbsolutePosition + target.AbsoluteSize / 2 - gui.AbsolutePosition) / k
			local icon = Kit.Icon(gui, "shards", "🔮", { Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Icon", TextSize = 26, Stroke = 0, ZIndex = 40 })
			icon.Position = UDim2.fromOffset(from.X + (math.random() - 0.5) * 60, from.Y + (math.random() - 0.5) * 30)
			Kit.Tween(icon, 0.65, { Position = UDim2.fromOffset(to.X, to.Y), Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.65, function()
				icon:Destroy()
				shown = if i == icons then total else math.min(total, shown + math.max(1, math.floor(total / icons)))
				tick.Text = "+" .. Format.Commas(shown)
				local ps = target:FindFirstChildOfClass("UIScale")
				if ps then
					ps.Scale = 1.06
					Kit.Tween(ps, 0.2, { Scale = 1 })
				end
				if i == icons then
					task.delay(1.2, function()
						Kit.Tween(tick, 0.4, { TextTransparency = 1 })
						task.delay(0.45, function()
							tick:Destroy()
						end)
					end)
				end
			end)
		end)
	end
end

-- World: soft shard orbs pop out of the opened chest, hover, then float to your character.
-- `done` runs once the last orb arrived.
local function chestOrbs(chestPos: Vector3, count: number, done: () -> ())
	local orbs = {}
	for i = 1, count do
		local o = Instance.new("Part")
		o.Shape = Enum.PartType.Ball
		o.Size = Vector3.new(0.9, 0.9, 0.9)
		o.Material = Enum.Material.Neon
		o.Color = SHARD
		o.Anchored = true
		o.CanCollide = false
		o.CanQuery = false
		o.CanTouch = false
		o.CastShadow = false
		o.Transparency = 1
		o.CFrame = CFrame.new(chestPos)
		o.Parent = Effects.Folder()
		local a = (i / count) * math.pi * 2
		table.insert(orbs, { Part = o, Apex = chestPos + Vector3.new(math.cos(a) * 2.5, 6 + math.random() * 2, math.sin(a) * 2.5), Delay = (i - 1) * 0.08 })
	end
	local t0 = os.clock()
	local POP, HOVER, FLY = 0.5, 0.35, 0.8
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local now = os.clock() - t0
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local home = if root then root.Position else chestPos
		local alive = 0
		for _, o in orbs do
			local p = o.Part
			if not p.Parent then
				continue
			end
			local t = now - o.Delay
			if t < 0 then
				alive += 1
				continue
			end
			p.Transparency = 0.15
			if t < POP then
				local u = 1 - (1 - t / POP) ^ 2
				p.CFrame = CFrame.new(chestPos:Lerp(o.Apex, u))
			elseif t < POP + HOVER then
				p.CFrame = CFrame.new(o.Apex + Vector3.new(0, math.sin((t - POP) * 8) * 0.25, 0))
			elseif t < POP + HOVER + FLY then
				local u = ((t - POP - HOVER) / FLY) ^ 2
				p.CFrame = CFrame.new(o.Apex:Lerp(home, u))
			else
				Effects.Burst(home, { Color = SHARD, Count = 4, Size = 0.4, Speed = 4, Life = 0.4 })
				p:Destroy()
				continue
			end
			alive += 1
		end
		if alive == 0 and conn then
			conn:Disconnect()
			conn = nil
			done()
		end
	end)
end

local function onCleared(data: any)
	if type(data) ~= "table" then
		return
	end
	room = tonumber(data.Room) or room
	endsAt = tonumber(data.EndsAt) or 0
	party = tonumber(data.Party) or party
	votes = 0
	bossUid = 0
	setEarned(data.Earned)
	titleLabel.Text = string.format("🏆 ROOM %d CLEARED!", room)
	fill.Size = UDim2.fromScale(0.01, 1)
	spiritLabel.Text = if devRun then "DEV RUN - no rewards" else "Rewards collected!"
	setPhase("Between")
	Sound.Play("ZoneUnlock")
	local ecto, shards = tonumber(data.Ecto) or 0, tonumber(data.Shards) or 0
	local pct = math.floor((tonumber(data.Pct) or 0) * 100 + 0.5)
	local sub
	if devRun then
		sub = "DEV RUN - no rewards"
	elseif ecto > 0 or shards > 0 then
		sub = string.format("+🔮%s Spirit Shards  +💚%s Ectoplasm  (you did %d%% of the damage)", Format.Commas(shards), Format.Commas(ecto), pct)
	else
		sub = "You didn't hit this boss, so no share this time. Attack it to earn rewards!"
	end
	Hud.Banner("BOSS DEFEATED! Rewards collected", sub, Theme.Gold)
	local cp = tonumber(data.Checkpoint)
	if cp and cp > 0 then
		Kit.Toast(string.format("🚩 Checkpoint saved! Your next run can start at Room %d", cp + 1), "Good")
	end
	-- the chest lid opens ~0.8 s after the kill (server); orbs pop out right after
	local pos = data.Pos
	if shards > 0 and typeof(pos) == "Vector3" then
		local icons = math.clamp(math.ceil(shards / 5), 3, 8)
		task.delay(1, function()
			chestOrbs(pos + Vector3.new(0, 2.5, 0), icons, function()
				flyToCounter(icons, shards)
			end)
		end)
	end
end

local function onLeave()
	if os.clock() >= leaveArmedUntil then
		leaveArmedUntil = os.clock() + 3
		refreshButtons()
		return
	end
	leaveArmedUntil = 0
	local res = State.Request("TowerLeave")
	if not res.ok and res.err then
		Kit.Toast(res.err, "Bad")
	end
	refreshButtons()
end

local function onContinue()
	if voted then
		return
	end
	local res = State.Request("TowerContinue")
	if res.ok then
		voted = true
	elseif res.err then
		Kit.Toast(res.err, "Bad")
	end
	refreshButtons()
end

local function checkpointOf(): number
	local d = State.Data
	return if d then tonumber(d.TowerCheckpoint) or 0 else 0
end

local function onEnter(startRoom: number)
	local res = State.Request("TowerStart", startRoom)
	if not res.ok and res.err then
		Kit.Toast(res.err, "Bad")
	end
end

function TowerHud.Init()
	local screen = Kit.Screen()
	local stack = Hud.TopStack

	-- top bar (room, timer, boss Spirit, earned this run)
	bar = Kit.new("Frame", {
		Name = "TowerBar",
		Size = UDim2.fromOffset(420, 84),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		LayoutOrder = 2,
		Parent = stack or screen,
	})
	if not stack then
		bar.Position = UDim2.new(0.5, 0, 0, 60)
		bar.AnchorPoint = Vector2.new(0.5, 0)
	end
	Kit.Corner(bar, UDim.new(0, 14))
	Kit.Stroke(bar, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(bar, PURPLE_A, PURPLE_B, 90)
	titleLabel = Kit.Label(bar, "🏰 ROOM 1", { Size = UDim2.new(0.7, 0, 0, 22), Position = UDim2.fromOffset(10, 4), Align = Enum.TextXAlignment.Left, Color = Theme.Ecto, Style = "Heading", Fit = true, ZIndex = 31 })
	timerLabel = Kit.Label(bar, "", { Size = UDim2.new(0.28, 0, 0, 22), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Style = "Body", Fit = true, ZIndex = 31 })
	local track: Frame = Kit.new("Frame", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 31), BackgroundColor3 = Color3.fromRGB(30, 12, 45), ZIndex = 31, Parent = bar })
	Kit.Corner(track, UDim.new(1, 0))
	Kit.Stroke(track, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 32, Parent = track })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Color3.fromRGB(110, 255, 160), Color3.fromRGB(170, 120, 255), 0)
	spiritLabel = Kit.Label(track, "", { Style = "Small", ZIndex = 33 })
	earnedLabel = Kit.Label(bar, "This run: +0 Ecto  ·  +0 Shards", { Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 60), Style = "Small", Color = Theme.Gold, Fit = true, ZIndex = 31 })

	-- pad countdown pill
	padPill = Kit.new("Frame", {
		Name = "TowerPadPill",
		Size = UDim2.fromOffset(320, 34),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		LayoutOrder = 2,
		Parent = stack or screen,
	})
	if not stack then
		padPill.Position = UDim2.new(0.5, 0, 0, 60)
		padPill.AnchorPoint = Vector2.new(0.5, 0)
	end
	Kit.Corner(padPill, UDim.new(1, 0))
	Kit.Stroke(padPill, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(padPill, PURPLE_A, PURPLE_B, 90)
	padLabel = Kit.Label(padPill, "", { Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), Style = "Body", Fit = true, ZIndex = 31 })

	-- bottom-centre: checkpoint info + ENTER / START AT CHECKPOINT (on the pad) and the run actions
	padBox = Kit.new("Frame", {
		Name = "TowerPadBox",
		Size = UDim2.fromOffset(480, 78),
		Position = UDim2.new(0.5, 0, 1, -96),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 25,
		Parent = screen,
	})
	padInfo = Kit.Label(padBox, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Small", Color = Theme.Gold, Fit = true, ZIndex = 26 })
	enterButton = Kit.Button(padBox, {
		Text = "🏰 ENTER BOSS TOWER",
		Color = "Purple",
		Size = UDim2.fromOffset(230, 48),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 26,
		OnClick = function()
			onEnter(1)
		end,
	})
	checkpointButton = Kit.Button(padBox, {
		Text = "⏩ START AT ROOM 6",
		Color = "Green",
		Size = UDim2.fromOffset(230, 48),
		Position = UDim2.new(0.5, 6, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 26,
		OnClick = function()
			onEnter(checkpointOf() + 1)
		end,
	})
	checkpointButton.Visible = false
	actions = Kit.new("Frame", {
		Name = "TowerActions",
		Size = UDim2.fromOffset(340, 82),
		Position = UDim2.new(0.5, 0, 1, -90),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 25,
		Parent = screen,
	})
	infoLabel = Kit.Label(actions, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Body", Fit = true, ZIndex = 26 })
	continueButton = Kit.Button(actions, {
		Text = "▶ CONTINUE",
		Color = "Green",
		Size = UDim2.fromOffset(160, 48),
		Position = UDim2.new(0.5, -6, 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 26,
		OnClick = onContinue,
	})
	leaveButton = Kit.Button(actions, {
		Text = "🚪 LEAVE",
		Color = "Red",
		Size = UDim2.fromOffset(160, 48),
		Position = UDim2.new(0.5, 6, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 26,
		OnClick = onLeave,
	})
	continueButton.Visible = false
end

local padPart: BasePart? = nil
local function findPad(): BasePart?
	if padPart and padPart.Parent then
		return padPart
	end
	local map = workspace:FindFirstChild("Map")
	local plaza = map and map:FindFirstChild("TowerEntrance")
	local pad = plaza and plaza:FindFirstChild("TowerPad")
	padPart = if pad and pad:IsA("BasePart") then pad else nil
	return padPart
end

local function onPad(): boolean
	local pad = findPad()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not pad or not root then
		return false
	end
	local d = root.Position - pad.Position
	return math.abs(d.Y) < 10 and Vector3.new(d.X, 0, d.Z).Magnitude <= Config.Tower.PadRadius
end

function TowerHud.Start()
	State.OnFx("Tower", onTower)
	State.OnFx("TowerRoomCleared", onCleared)
	-- the server clears InTower when a run ends for us (also on respawn / errors)
	player:GetAttributeChangedSignal("InTower"):Connect(function()
		if player:GetAttribute("InTower") ~= true and phase ~= "Idle" then
			setPhase("Idle")
		end
	end)

	local nextPadCheck = 0
	RunService.Heartbeat:Connect(function()
		local t = serverNow()
		local clock = os.clock()
		-- pad: ENTER button / countdown
		if clock >= nextPadCheck then
			nextPadCheck = clock + 0.25
			local inTower = player:GetAttribute("InTower") == true
			local here = not inTower and onPad()
			padBox.Visible = here and padEndsAt == 0
			if padBox.Visible then
				local cp = checkpointOf()
				local every = Config.Tower.CheckpointEvery
				checkpointButton.Visible = cp > 0
				enterButton.Position = if cp > 0 then UDim2.new(0.5, -6, 1, 0) else UDim2.new(0.5, 0, 1, 0)
				enterButton.AnchorPoint = if cp > 0 then Vector2.new(1, 1) else Vector2.new(0.5, 1)
				Kit.SetButtonText(enterButton, if cp > 0 then "▶ START AT ROOM 1" else "🏰 ENTER BOSS TOWER")
				Kit.SetButtonText(checkpointButton, "⏩ START AT ROOM " .. (cp + 1))
				padInfo.Text = if cp > 0
					then string.format("🚩 Checkpoint: Room %d cleared  ·  skipped rooms give no rewards", cp)
					else string.format("🚩 Clear Room %d to save a checkpoint", every)
			end
			if padEndsAt > 0 and (inTower or t > padEndsAt + 3) then
				padEndsAt = 0
				padPill.Visible = false
			end
			if leaveArmedUntil > 0 and clock >= leaveArmedUntil then
				leaveArmedUntil = 0
				refreshButtons()
			end
		end
		if padEndsAt > 0 then
			local left = math.max(0, math.ceil(padEndsAt - t))
			padLabel.Text = padBase .. "  ·  starts in " .. left
		end
		if phase == "Fight" then
			local left = math.max(0, endsAt - t)
			timerLabel.Text = "⏱ " .. Format.Time(left)
			timerLabel.TextColor3 = if left < 20 then Theme.Bad else Theme.Text
			local m = bossModel()
			if m then
				local hp = tonumber(m:GetAttribute("Spirit")) or 0
				local max = math.max(tonumber(m:GetAttribute("MaxSpirit")) or 1, 1)
				fill.Size = UDim2.fromScale(math.clamp(hp / max, 0.01, 1), 1)
				spiritLabel.Text = Format.Short(hp) .. " / " .. Format.Short(max) .. " SPIRIT"
			end
			infoLabel.Text = if party > 1 then string.format("Party of %d  ·  beat the boss before time runs out!", party) else "Beat the boss before time runs out!"
		elseif phase == "Between" then
			local left = math.max(0, endsAt - t)
			timerLabel.Text = "⏱ " .. Format.Time(left)
			timerLabel.TextColor3 = Theme.Text
			infoLabel.Text = if party > 1
				then string.format("Room %d next in %s  ·  votes %d/%d", room + 1, Format.Time(left), votes, party)
				else string.format("Room %d next? %s left to choose", room + 1, Format.Time(left))
		end
	end)
end

return TowerHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">TradePanel</string>
              <string name="Source"><![CDATA[--!strict
-- TRADE: hunters-only trading between two players in the same server. With no trade open the
-- panel lists the other players with a TRADE button. An incoming request shows a small
-- ACCEPT / DECLINE popup with a countdown. While a trade is open: your hunters (tap to offer),
-- YOU GIVE (tap to take back), THEY GIVE, both confirmation marks, CONFIRM and CANCEL.
-- The server is the authority; this only sends requests and draws the "Trade" Fx state.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)

local TradePanel = {}

local panel: Kit.Panel
local lobbyView: ScrollingFrame
local tradeView: Frame
local pickGrid: ScrollingFrame
local giveGrid: ScrollingFrame
local getGrid: ScrollingFrame
local giveTitle: TextLabel
local getTitle: TextLabel
local statusLabel: TextLabel
local confirmButton: TextButton
local cancelButton: TextButton
-- incoming request popup
local invite: Kit.Panel
local inviteText: TextLabel
local inviteTimer: TextLabel
local inviteFrom = 0
local inviteEnds = 0

local trade: any = nil -- latest "Trade" Fx while Open / Committing
local lastSig = ""
local lastChange = 0

local function request(action: string, ...: any): any
	local res = State.Request(action, ...)
	if not res.ok then
		Kit.Toast(res.err or "Couldn't do that", "Bad")
	end
	return res
end

local function clear(grid: Instance)
	for _, c in grid:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function makeGrid(parent: Instance): ScrollingFrame
	local g: ScrollingFrame = Kit.new("ScrollingFrame", {
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.5,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = parent,
	})
	Kit.Corner(g, UDim.new(0, 12))
	Kit.Padding(g, 6)
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(72, 92), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = g })
	return g
end

-- small hunter card: portrait, tier, tiered power
local function miniCard(parent: Instance, id: string, tierN: number, order: number, onClick: (() -> ())?)
	local def = Config.Hunters[id]
	if not def then
		return
	end
	local rar = Config.Rarities[def.Rarity]
	local tier = Config.Tiers[tierN] or Config.Tiers[0]
	local f: TextButton = Kit.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 63, Parent = parent })
	Kit.Corner(f, UDim.new(0, 12))
	Kit.Stroke(f, if tierN > 0 then 4 else 2, if tierN > 0 then tier.Color else Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, rar.Color, rar.Color2, 90)
	local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(50, 50), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = f })
	Kit.Corner(pic, UDim.new(1, 0))
	Portrait.Face(pic, id, false)
	if tierN > 0 then
		Kit.Label(f, tier.Icon .. " " .. tier.Name, { Size = UDim2.new(1, -6, 0, 12), Position = UDim2.fromOffset(3, 44), Color = tier.Color, Style = "Small", Fit = true, ZIndex = 66 })
	end
	Kit.Label(f, string.upper(def.Name), { Size = UDim2.new(1, -6, 0, 14), Position = UDim2.fromOffset(3, 57), Style = "Small", Fit = true, ZIndex = 66 })
	Kit.IconText(Kit.Label(f, "", { Size = UDim2.new(1, -6, 0, 16), Position = UDim2.fromOffset(3, 72), Color = Theme.Gold, Style = "Small", Fit = true, ZIndex = 66 }), "⚡" .. Format.Short(def.Power * tier.Mult))
	if onClick then
		f.Activated:Connect(function()
			Kit.Play("Click")
			onClick()
		end)
	end
end

local function setOffer(list: { string })
	if trade then
		request("TradeOffer", list)
	end
end

-- only players standing at the TRADING booth can be asked (the server checks again)
local function atBooth(p: Player): boolean
	local char = p.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - Config.Layout.TradeBooth).Magnitude <= Config.Trade.BoothRadius
end

local lobbyKey = "" -- who was listed last time (the 2 s refresh only redraws when it changes)
local function boothKey(): string
	local ids = {}
	for _, p in Players:GetPlayers() do
		if p ~= Players.LocalPlayer and atBooth(p) then
			table.insert(ids, tostring(p.UserId))
		end
	end
	return table.concat(ids, ",")
end

local function renderLobby()
	lobbyKey = boothKey()
	clear(lobbyView)
	local n = 0
	for _, p in Players:GetPlayers() do
		if p == Players.LocalPlayer or not atBooth(p) then
			continue
		end
		n += 1
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, LayoutOrder = n, ZIndex = 62, Parent = lobbyView })
		Kit.Corner(row, UDim.new(0, 10))
		Kit.Label(row, p.DisplayName, { Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(12, 0), Align = Enum.TextXAlignment.Left, Style = "Body", Fit = true, ZIndex = 63 })
		local userId = p.UserId
		local name = p.DisplayName
		Kit.Button(row, {
			Text = "TRADE",
			Color = "Teal",
			Size = UDim2.fromOffset(110, 38),
			Position = UDim2.new(1, -6, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			TextStyle = "Small",
			ZIndex = 63,
			OnClick = function()
				if request("TradeRequest", userId).ok then
					Kit.Toast("Trade request sent to " .. name, "Good")
				end
			end,
		})
	end
	if n == 0 then
		Kit.Label(lobbyView, "Nobody else is at the TRADING booth yet. Invite a friend over!", { Size = UDim2.new(1, 0, 0, 40), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	end
end

local function updateConfirm()
	local t = trade
	if not t then
		return
	end
	local wait = Config.Trade.ConfirmCooldown - (os.clock() - lastChange)
	cancelButton.Visible = t.State == "Open"
	if t.State ~= "Open" then
		Kit.SetButtonText(confirmButton, "TRADING...")
		confirmButton:SetAttribute("Color", "Gray")
	elseif t.MeOk then
		Kit.SetButtonText(confirmButton, "CONFIRMED ✅")
		confirmButton:SetAttribute("Color", "Gray")
	elseif wait > 0 then
		Kit.SetButtonText(confirmButton, "CONFIRM (" .. math.ceil(wait) .. ")")
		confirmButton:SetAttribute("Color", "Gray")
	else
		Kit.SetButtonText(confirmButton, "CONFIRM")
		confirmButton:SetAttribute("Color", "Green")
	end
end

local function render()
	local t = trade
	lobbyView.Visible = t == nil
	tradeView.Visible = t ~= nil
	if not t then
		renderLobby()
		return
	end
	local d = State.Data
	local mine: { string } = t.Mine or {}
	local inOffer: { [string]: boolean } = {}
	clear(giveGrid)
	for i, uid in mine do
		inOffer[uid] = true
		local h = d and d.Hunters[uid]
		if h then
			miniCard(giveGrid, h.Id, h.Tier or 0, i, function()
				local list = table.clone(mine)
				table.remove(list, table.find(list, uid) :: number)
				setOffer(list)
			end)
		end
	end
	clear(getGrid)
	for i, h in t.Theirs or {} do
		miniCard(getGrid, h.Id, h.Tier or 0, i, nil)
	end
	clear(pickGrid)
	if d then
		local now = State.Now()
		local uids = {}
		for uid, h in d.Hunters do
			if not inOffer[uid] and not h.Locked and ((d.Knocked and d.Knocked[uid]) or 0) <= now then
				table.insert(uids, uid)
			end
		end
		local function power(uid: string): number
			local h = d.Hunters[uid]
			local def = Config.Hunters[h.Id]
			return (if def then def.Power else 0) * (Config.Tiers[h.Tier or 0] or Config.Tiers[0]).Mult
		end
		table.sort(uids, function(a, b)
			return power(a) > power(b)
		end)
		for i, uid in uids do
			local h = d.Hunters[uid]
			miniCard(pickGrid, h.Id, h.Tier or 0, i, function()
				if #mine >= Config.Trade.MaxOffer then
					Kit.Toast("You can offer up to " .. Config.Trade.MaxOffer .. " hunters", "Bad")
					return
				end
				local list = table.clone(mine)
				table.insert(list, uid)
				setOffer(list)
			end)
		end
	end
	local other = string.upper(tostring(t.Other or "THEY"))
	giveTitle.Text = "YOU GIVE (" .. #mine .. "/" .. Config.Trade.MaxOffer .. ")"
	getTitle.Text = other .. " GIVES"
	statusLabel.Text = "You: " .. (if t.MeOk then "✅" else "⏳ waiting") .. "    " .. other .. ": " .. (if t.ThemOk then "✅" else "⏳ waiting")
	updateConfirm()
end

local function onTrade(data: any)
	if type(data) ~= "table" then
		return
	end
	if data.State == "Done" or data.State == "Cancelled" then
		trade = nil
		if data.State == "Done" then
			Kit.Toast("Trade complete! 🤝", "Good")
		else
			Kit.Toast("Trade cancelled" .. (if data.Reason then ": " .. tostring(data.Reason) else ""), "Bad")
		end
		render()
		return
	end
	-- any change to either offer resets confirmations and restarts the CONFIRM cooldown
	local theirs = {}
	for _, h in data.Theirs or {} do
		table.insert(theirs, tostring(h.Uid))
	end
	local sig = tostring(data.Id) .. "|" .. table.concat(data.Mine or {}, ",") .. "|" .. table.concat(theirs, ",")
	if sig ~= lastSig then
		lastSig = sig
		lastChange = os.clock()
	end
	trade = data
	if invite.IsOpen then
		invite:Close()
	end
	if not panel.IsOpen then
		panel:Open()
	end
	render()
end

local function respond(accept: boolean)
	local from = inviteFrom
	invite:Close()
	request("TradeRespond", from, accept)
end

function TradePanel.Init()
	panel = Kit.Panel("Trade", "TRADE", Vector2.new(780, 480), "Teal")
	local body = panel.Body
	-- no trade: other players
	lobbyView = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 10),
		BackgroundTransparency = 1,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = lobbyView })
	-- open trade
	tradeView = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 61, Parent = body })
	Kit.Label(tradeView, "⚠️ Both players must confirm. Any change resets confirmations.", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 10), Color = Theme.Gold, Style = "Small", Fit = true, ZIndex = 62 })
	local cols = { "YOUR HUNTERS (tap to offer)", "YOU GIVE", "THEY GIVE" }
	local titles: { TextLabel } = {}
	local grids: { ScrollingFrame } = {}
	for i, text in cols do
		local x = (i - 1) / 3
		titles[i] = Kit.Label(tradeView, text, { Size = UDim2.new(1 / 3, -8, 0, 18), Position = UDim2.new(x, 4, 0, 36), Style = "Small", Fit = true, ZIndex = 62 })
		local g = makeGrid(tradeView)
		g.Size = UDim2.new(1 / 3, -8, 1, -118)
		g.Position = UDim2.new(x, 4, 0, 58)
		grids[i] = g
	end
	pickGrid, giveGrid, getGrid = grids[1], grids[2], grids[3]
	giveTitle, getTitle = titles[2], titles[3]
	statusLabel = Kit.Label(tradeView, "", { Size = UDim2.new(1, -300, 0, 44), Position = UDim2.new(0, 4, 1, -2), AnchorPoint = Vector2.new(0, 1), Align = Enum.TextXAlignment.Left, Style = "Small", Fit = true, ZIndex = 62 })
	cancelButton = Kit.Button(tradeView, {
		Text = "CANCEL",
		Color = "Red",
		Size = UDim2.fromOffset(120, 44),
		Position = UDim2.new(1, 0, 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 62,
		OnClick = function()
			request("TradeCancel")
		end,
	})
	confirmButton = Kit.Button(tradeView, {
		Text = "CONFIRM",
		Color = "Gray",
		Size = UDim2.fromOffset(160, 44),
		Position = UDim2.new(1, -128, 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 62,
		OnClick = function()
			local t = trade
			if t and t.State == "Open" and not t.MeOk then
				request("TradeConfirm", t.Id)
			end
		end,
	})
	panel.Primary = confirmButton
	-- incoming request popup
	invite = Kit.Panel("TradeInvite", "TRADE REQUEST", Vector2.new(420, 230), "Teal")
	inviteText = Kit.Label(invite.Body, "", { Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 14), Style = "Body", ZIndex = 62 })
	inviteTimer = Kit.Label(invite.Body, "", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 68), Color = Theme.Muted, Style = "Small", ZIndex = 62 })
	invite.Primary = Kit.Button(invite.Body, {
		Text = "ACCEPT",
		Color = "Green",
		Size = UDim2.new(0.5, -10, 0, 46),
		Position = UDim2.new(0, 4, 1, -4),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 63,
		OnClick = function()
			respond(true)
		end,
	})
	Kit.Button(invite.Body, {
		Text = "DECLINE",
		Color = "Red",
		Size = UDim2.new(0.5, -10, 0, 46),
		Position = UDim2.new(1, -4, 1, -4),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 63,
		OnClick = function()
			respond(false)
		end,
	})
	Hud.RegisterPanel("Trade", function()
		panel:Toggle()
	end)
end

function TradePanel.Start()
	panel.OnOpen:Connect(render)
	-- players walk up to / away from the booth: refresh the list while it's showing
	task.spawn(function()
		while true do
			task.wait(2)
			if panel.IsOpen and not trade and boothKey() ~= lobbyKey then
				renderLobby()
			end
		end
	end)
	Players.PlayerAdded:Connect(function()
		if panel.IsOpen and not trade then
			renderLobby()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if panel.IsOpen and not trade then
				renderLobby()
			end
		end)
	end)
	State.Changed:Connect(function()
		if panel.IsOpen and trade then
			render()
		end
	end)
	State.OnFx("Trade", onTrade)
	State.OnFx("TradeRequest", function(data: any)
		if type(data) ~= "table" or trade then
			return
		end
		inviteFrom = tonumber(data.FromId) or 0
		inviteEnds = os.clock() + (tonumber(data.Seconds) or Config.Trade.RequestSeconds)
		local from = tostring(data.From or "Someone")
		local fromId = inviteFrom
		local ends = inviteEnds
		-- never close a menu the player is using: wait until it's free (a toast says who asked)
		if not Kit.IsFree() then
			Kit.Toast("🤝 " .. from .. " wants to trade! Close this menu to answer.", "Gold")
		end
		Kit.WhenFree(function()
			if trade or invite.IsOpen or inviteFrom ~= fromId or os.clock() >= ends then
				return -- expired, replaced or already trading
			end
			inviteText.Text = from .. " wants to trade hunters with you!"
			invite:Open()
		end)
	end)
	-- countdowns: CONFIRM cooldown and the request popup
	while true do
		task.wait(0.25)
		if trade and panel.IsOpen then
			updateConfirm()
		end
		if invite.IsOpen then
			local left = inviteEnds - os.clock()
			if left <= 0 then
				invite:Close()
			else
				inviteTimer.Text = "Expires in " .. math.ceil(left) .. "s"
			end
		end
	end
end

return TradePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time guidance without walls of text:
--   1 TAP A GHOST!  →  2 COLLECT ECTOPLASM!  →  3 OPEN A HUNTER CRATE!  →
--   4 EQUIP YOUR NEW HUNTER!  →  5 UNLOCK THE CEMETERY!  →  done  →  MENU TOUR (MenuTour)
-- A glowing breadcrumb trail on the ground + a bouncing arrow over the target show where to
-- go; menu buttons pulse when they're the next step. After the tutorial a small NEXT GOAL
-- chip keeps the next zone in view. Progress is saved (server only accepts forward steps).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Orbs = require(script.Parent.Orbs)
local Reveal = require(script.Parent.Reveal)
local CratePanel = require(script.Parent.CratePanel)
local HuntersPanel = require(script.Parent.HuntersPanel)
local Sound = require(script.Parent.Sound)
local MenuTour = require(script.Parent.MenuTour)

local Tutorial = {}

local player = Players.LocalPlayer
local STEPS = #Config.Tutorial.Steps
local step = 0 -- 0 = not loaded yet
local promptFrame: Frame
local promptLabel: TextLabel
local promptSub: TextLabel
local goalChip: Frame
local goalLabel: TextLabel
local goalFill: Frame
local dots: { BasePart } = {}
local marker: BillboardGui
local markerPart: Part
local guideTarget: (() -> Vector3?)? = nil
local guideUntil = math.huge
local framed = false

local DOTS = 12
local SPACING = 3.6

--------------------------------------------------------------------------------
-- guide (breadcrumbs + marker)
--------------------------------------------------------------------------------
local function setGuide(fn: (() -> Vector3?)?, seconds: number?)
	guideTarget = fn
	guideUntil = if seconds then os.clock() + seconds else math.huge
end
Tutorial.SetGuide = setGuide

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local hidden = CFrame.new(0, -400, 0)
local dotsHidden = true
local parts: { BasePart } = {}
local cfs: { CFrame } = {}

local function hideDots()
	if dotsHidden then
		return -- nothing to do: no per-frame writes while the guide is off
	end
	dotsHidden = true
	for _, d in dots do
		d.CFrame = hidden
	end
end

local function updateGuide()
	local root = rootPart()
	local target = if guideTarget and os.clock() < guideUntil then guideTarget() else nil
	if not root or not target or Reveal.IsPlaying() then
		hideDots()
		if marker.Enabled then
			marker.Enabled = false
		end
		return
	end
	markerPart.CFrame = CFrame.new(target)
	marker.Enabled = true
	local from = root.Position - Vector3.new(0, 2.7, 0)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 6 then
		hideDots()
		return
	end
	dotsHidden = false
	local dir = flat.Unit
	local t = os.clock()
	local offset = (t * 6) % SPACING -- dots flow toward the target
	local groundEnd = math.min(target.Y, from.Y + 2)
	table.clear(parts)
	table.clear(cfs)
	for i, d in dots do
		local along = 2.5 + (i - 1) * SPACING + offset
		if along > dist - 2 then
			table.insert(parts, d)
			table.insert(cfs, hidden)
		else
			local k = along / dist
			local y = from.Y + (groundEnd - from.Y) * k + 0.35
			local pulse = 0.75 + 0.25 * math.sin(t * 6 - i * 0.6)
			d.Size = Vector3.new(pulse, pulse, pulse)
			table.insert(parts, d)
			table.insert(cfs, CFrame.new(from.X + dir.X * along, y, from.Z + dir.Z * along))
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

--------------------------------------------------------------------------------
-- prompts
--------------------------------------------------------------------------------
local shownText = ""
local function setPrompt(text: string?, sub: string?)
	if not text then
		if promptFrame.Visible then
			promptFrame.Visible = false
			shownText = ""
		end
		return
	end
	promptSub.Text = sub or ""
	promptSub.Visible = sub ~= nil
	if text ~= shownText then
		shownText = text
		promptLabel.Text = text
		promptFrame.Visible = true
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		sc.Scale = 0.5
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.Play("Select")
	end
end

local function tapWord(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Gamepad1 then
		return "PRESS (X) TO TARGET A GHOST!"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "TAP A GHOST!"
	end
	return "CLICK A GHOST!"
end

local function nearestGhost(): Vector3?
	local root = rootPart()
	if not root then
		return nil
	end
	local d = State.Data
	local best, bestD = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Def.Kind ~= "Event" and (not d or d.Zones[e.Def.Zone]) then
			local dist = (e.Pos - root.Position).Magnitude
			if dist < bestD then
				best, bestD = e, dist
			end
		end
	end
	return if best then best.Pos + Vector3.new(0, 2.5 * best.Def.Scale + 1, 0) else nil
end

local function cratePos(): Vector3?
	local p = Config.Layout.CrateStations.Beginner
	return p + Vector3.new(0, 8, 0)
end

local function gatePos(): Vector3?
	local g = Config.Layout.Gates.Cemetery
	return if g then Vector3.new(0, 10, g.Z - 4) else nil
end

-- Boss Tower intro goal (after the tutorial): grants nothing, just points the way once the
-- player is strong enough. Hidden for good after their first tower run.
local TOWER_GUIDE_SECONDS = 15
local TOWER_CYCLE = 30 -- the chip shows the tower for the first TOWER_SHOW s of each cycle
local TOWER_SHOW = 10
local towerPointed = false

local function towerPos(): Vector3?
	return Config.Layout.TowerEntrance.Pad + Vector3.new(0, 8, 0) -- the party pad in the lobby
end

local function wantsTowerGoal(d: any): boolean
	if (tonumber(d.TowerRuns) or 0) > 0 then
		return false
	end
	local school = Config.Zones[3]
	return (school ~= nil and d.Zones[school.Id] == true) or State.CountOwned() >= 6
end

local function advance(to: number, skipped: boolean?)
	if to <= step then
		return
	end
	step = to
	task.spawn(State.Request, "Tutorial", to)
	if to > STEPS then
		setPrompt(nil)
		setGuide(nil)
		Hud.Pulse("Hunters", false)
		Hud.Banner("TUTORIAL COMPLETE!", "Keep hunting, collecting and unlocking!", Theme.Gold)
		if not skipped then
			MenuTour.AfterTutorial() -- then a quick tour of the menu buttons (SKIP leaves it out)
		end
	end
end

-- Pulsing ring on a button inside a menu: while a menu is open the guidance lives on the
-- button itself (a prompt pill would sit under/over the menu).
local rings: { [GuiObject]: Frame } = {}
local function pulseRing(b: GuiObject, on: boolean)
	local existing = rings[b]
	if on and not existing then
		local ring: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 80, Parent = b })
		Kit.Corner(ring, UDim.new(0, 12))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		rings[b] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.new(1, 20, 1, 20) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and existing then
		existing:Destroy()
		rings[b] = nil
	end
end

local function setEquipRing(on: boolean)
	pulseRing(HuntersPanel.EquipBestButton(), on)
end

-- One-time camera framing of the nearest ghost for brand-new players.
local function frameGhost()
	if framed then
		return
	end
	framed = true
	local root = rootPart()
	local target = nearestGhost()
	local cam = workspace.CurrentCamera
	if not root or not target or not cam then
		return
	end
	local start = cam.CFrame
	local eye = root.Position + Vector3.new(0, 5, 0) - (target - root.Position).Unit * 10
	local look = CFrame.lookAt(eye, target)
	cam.CameraType = Enum.CameraType.Scriptable
	local tw = TweenService:Create(cam, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { CFrame = look })
	tw:Play()
	tw.Completed:Wait()
	task.wait(0.8)
	local back = TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { CFrame = start })
	back:Play()
	back.Completed:Wait()
	if not Reveal.IsPlaying() then
		cam.CameraType = Enum.CameraType.Custom
	end
end

local collectedOnce = false

local function tick()
	local d = State.Data
	if not d or step == 0 then
		return
	end
	local panel = Kit.CurrentPanel()
	if step > STEPS then
		-- NEXT GOAL chip
		local nextZone: Config.ZoneDef? = nil
		for _, z in Config.Zones do
			if not d.Zones[z.Id] then
				nextZone = z
				break
			end
		end
		local calm = not panel and not Reveal.IsPlaying()
		if calm and wantsTowerGoal(d) and (not towerPointed or os.clock() % TOWER_CYCLE < TOWER_SHOW) then
			goalChip.Visible = true
			goalLabel.Text = "TRY THE BOSS TOWER (east of spawn)!"
			goalFill.Size = UDim2.fromScale(1, 1)
			if not towerPointed then
				-- point the trail at it once per session; it then fades on its own
				towerPointed = true
				setGuide(towerPos, TOWER_GUIDE_SECONDS)
			end
		elseif nextZone and calm then
			goalChip.Visible = true
			goalLabel.Text = "NEXT: UNLOCK " .. nextZone.Name .. "  " .. Format.Short(math.min(d.Ecto, nextZone.Cost)) .. " / " .. Format.Short(nextZone.Cost)
			goalFill.Size = UDim2.fromScale(math.clamp(d.Ecto / nextZone.Cost, 0.02, 1), 1)
		elseif not nextZone and calm then
			-- every area open: the goal becomes the full Hunter Index
			local total, found = 0, 0
			for id, h in Config.Hunters do
				if h.Rarity == "Exclusive" then
					continue -- Robux-only hunters are never a required goal
				end
				total += 1
				if d.Discovered[id] then
					found += 1
				end
			end
			goalChip.Visible = found < total
			goalLabel.Text = "NEXT: DISCOVER EVERY HUNTER  " .. found .. " / " .. total
			goalFill.Size = UDim2.fromScale(math.clamp(found / math.max(total, 1), 0.02, 1), 1)
		else
			goalChip.Visible = false
		end
		return
	end
	goalChip.Visible = false
	if Reveal.IsPlaying() or (panel ~= nil and panel ~= "Crate" and panel ~= "Hunters") then
		setPrompt(nil)
		return
	end
	local target = (player:GetAttribute("Target") :: number?) or 0
	if step == 1 then
		setPrompt(tapWord(), "to send your hunters!")
		setGuide(nearestGhost)
		if target ~= 0 then
			advance(2)
		end
	elseif step == 2 then
		if Orbs.Count() > 0 then
			setPrompt("COLLECT ECTOPLASM!", "Walk close - it flies to you!")
			setGuide(function()
				local root = rootPart()
				return if root then Orbs.Nearest(root.Position) else nil
			end)
		elseif target ~= 0 then
			setPrompt("YOUR HUNTER IS ON IT!", "Ghosts POOF into Ectoplasm")
			setGuide(nil)
		else
			setPrompt(tapWord())
			setGuide(nearestGhost)
		end
		if collectedOnce then
			advance(3)
		end
	elseif step == 3 then
		local price = Config.Crates.Beginner.Price
		if (d.Stats.Crates or 0) >= 1 then
			pulseRing(CratePanel.Button(), false)
			advance(4)
		elseif d.Ecto >= price or (d.FreeCrates.Beginner or 0) > 0 then
			if CratePanel.IsOpen() then
				setPrompt(nil)
				pulseRing(CratePanel.Button(), true)
				setGuide(nil)
			else
				pulseRing(CratePanel.Button(), false)
				setPrompt("OPEN A HUNTER CRATE!", "Follow the trail to the crate")
				setGuide(cratePos)
			end
		else
			setPrompt("COLLECT " .. price .. " ECTOPLASM", Format.Commas(d.Ecto) .. " / " .. price .. "  -  tap more ghosts!")
			setGuide(if target == 0 then nearestGhost else nil)
		end
	elseif step == 4 then
		-- done once a second hunter is equipped (or all you own, if you released the new one)
		if #d.Equipped >= math.min(2, State.CountOwned()) then
			Hud.Pulse("Hunters", false)
			setEquipRing(false)
			advance(5)
		elseif panel == "Hunters" then
			setPrompt(nil)
			Hud.Pulse("Hunters", false)
			setEquipRing(true)
		else
			setPrompt("EQUIP YOUR NEW HUNTER!", "Open HUNTERS")
			Hud.Pulse("Hunters", true)
			setEquipRing(false)
		end
		setGuide(nil)
	elseif step == 5 then
		local zone = Config.ZoneById.Cemetery
		if d.Zones.Cemetery then
			advance(6)
		elseif panel then
			setPrompt(nil)
		elseif d.Ecto >= zone.Cost then
			setPrompt("UNLOCK THE CEMETERY!", "Follow the trail to the gate")
			setGuide(gatePos)
		else
			setPrompt("UNLOCK THE CEMETERY!", "Defeat ghosts to save up - " .. Format.Commas(d.Ecto) .. " / " .. Format.Commas(zone.Cost))
			setGuide(nil)
		end
	end
end

function Tutorial.Init()
	local screen = Kit.Screen()
	-- compact pill low in the middle of the screen (between the thumbstick and jump button)
	promptFrame = Kit.new("Frame", {
		Name = "TutorialPrompt",
		Size = UDim2.fromOffset(400, 58),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = screen,
	})
	Kit.Corner(promptFrame, UDim.new(0, 14))
	Kit.new("UIScale", { Parent = promptFrame })
	promptLabel = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 28), Position = UDim2.fromOffset(12, 4), Color = Theme.Ecto, Style = "Heading", Fit = true, ZIndex = 41 })
	promptSub = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(12, 32), Color = Theme.Text, Style = "Small", Fit = true, ZIndex = 41 })
	Kit.Button(promptFrame, {
		Text = "SKIP",
		Color = "Gray",
		Size = UDim2.fromOffset(58, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Tiny",
		ZIndex = 42,
		OnClick = function()
			advance(STEPS + 1, true)
		end,
	})
	-- pulse the prompt gently
	task.spawn(function()
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		while true do
			if promptFrame.Visible then
				Kit.Tween(sc, 0.5, { Scale = 1.04 }, Enum.EasingStyle.Sine)
				task.wait(0.5)
				Kit.Tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Sine)
			end
			task.wait(0.5)
		end
	end)
	-- NEXT GOAL bar: directly under the Ectoplasm / Power counters (Hud.TopStack)
	goalChip = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 24),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 20,
		LayoutOrder = 1,
		Parent = Hud.TopStack or screen,
	})
	Kit.Corner(goalChip, UDim.new(1, 0))
	Kit.Stroke(goalChip, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	goalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Theme.Ecto, BackgroundTransparency = 0.55, ZIndex = 21, Parent = goalChip })
	Kit.Corner(goalFill, UDim.new(1, 0))
	goalLabel = Kit.Label(goalChip, "", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Small", Fit = true, ZIndex = 22 })

	-- breadcrumbs + marker
	local folder = Instance.new("Folder")
	folder.Name = "GHGuide"
	folder.Parent = workspace
	for _ = 1, DOTS do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.9, 0.9, 0.9)
		p.Material = Enum.Material.Neon
		p.Color = Theme.Ecto
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = hidden
		p.Parent = folder
		table.insert(dots, p)
	end
	markerPart = Instance.new("Part")
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(1, 1, 1)
	markerPart.CFrame = hidden
	markerPart.Parent = folder
	-- device-scaled bouncing arrow over the target (always readable, never huge)
	marker = WorldLabel.New({
		Name = "GuideArrow",
		Adornee = markerPart,
		Parent = folder,
		Size = Vector2.new(Theme.World.Marker, Theme.World.Marker),
		Offset = Vector3.new(0, 2.5, 0),
		MaxDistance = 600,
		AlwaysOnTop = true,
	})
	marker.Enabled = false
	local arrow = WorldLabel.Text(marker, "⬇", { Color = Theme.Ecto, Style = "Banner", Stroke = 3 })
	task.spawn(function()
		while true do
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0.2) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
		end
	end)
end

function Tutorial.Start()
	Orbs.Collected:Connect(function()
		collectedOnce = true
	end)
	RunService.RenderStepped:Connect(updateGuide)
	task.spawn(function()
		local d = State.WaitForData()
		step = math.clamp(d.Tutorial or 1, 1, STEPS + 1)
		if step == 1 then
			-- let the world settle, then frame the first ghost
			task.wait(2)
			if (player:GetAttribute("Target") or 0) == 0 then
				frameGhost()
			end
		end
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">UpdatePopup</string>
              <string name="Source"><![CDATA[--!strict
-- WHAT'S NEW popup (Config.UpdateNotes): once per update version, a short list of what changed.
-- Waits until no menu or crate reveal is open; closing it tells the server it was seen.
-- Brand-new players (tutorial not finished) skip it: everything is new to them anyway.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local UpdatePopup = {}

local panel: Kit.Panel
local notes = Config.UpdateNotes

function UpdatePopup.Init()
	local lines = #notes.Lines
	panel = Kit.Panel("UpdateNotes", notes.Title, Vector2.new(480, 130 + lines * 34), "Purple")
	local body = panel.Body
	Kit.Label(body, "Update " .. notes.Version, { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 6), Color = Theme.Gold, Style = "Body", ZIndex = 62 })
	for i, text in notes.Lines do
		Kit.Label(body, text, {
			Size = UDim2.new(1, -24, 0, 30),
			Position = UDim2.fromOffset(12, 6 + i * 34),
			Align = Enum.TextXAlignment.Left,
			Font = Theme.Body,
			Style = "Small",
			Wrap = true,
			ZIndex = 62,
			Stroke = 0,
		})
	end
	local ok = Kit.Button(body, {
		Text = "LET'S GO!",
		Color = "Green",
		Size = UDim2.fromOffset(200, 46),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			panel:Close()
		end,
	})
	panel.Primary = ok
end

-- DEV panel preview
function UpdatePopup.Show()
	panel:Open()
end

function UpdatePopup.Start()
	task.spawn(function()
		local d = State.WaitForData()
		if d.SeenUpdate == notes.Version then
			return
		end
		if (d.Tutorial or 1) <= #Config.Tutorial.Steps then
			State.Request("SeenUpdate") -- new player: nothing to catch up on
			return
		end
		task.wait(3)
		Kit.WhenFree(function()
			Sound.Play("ZoneUnlock")
			panel:Open()
			State.Request("SeenUpdate")
		end)
	end)
end

return UpdatePopup
]]></string>
            </Properties>
