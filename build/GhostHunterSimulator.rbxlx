  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">GHServer</string>
      </Properties>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR server entry. Builds the world, then initialises services in order.
-- Every step is protected: one failing system logs a warning instead of stopping the others.
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)

Net.Init()

-- Players pass through each other (busy crate stations); hunters are client-side and non-colliding.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

local okWorld, errWorld = pcall(function()
	require(script.Parent.World.Builder).Build()
end)
if not okWorld then
	warn("[Main] world build failed: " .. tostring(errWorld))
end

local Services = script.Parent.Services
local order = {
	"Fx",
	"Remotes",
	"DataService",
	"PlayerInfo",
	"HunterService",
	"DropService",
	"GhostService",
	"ProgressService",
	"EventService",
	"ShopService",
	"StationService",
	"GlobalEventService",
	"DevService",
	"FeedbackService",
	"LeaderboardService",
}
local loaded: { [string]: any } = {}
for _, name in order do
	local ok, mod = pcall(require, Services:FindFirstChild(name) :: ModuleScript)
	if not ok then
		warn("[Main] couldn't load " .. name .. ": " .. tostring(mod))
		continue
	end
	loaded[name] = mod
	if (mod :: any).Init then
		local okInit, err = pcall((mod :: any).Init)
		if not okInit then
			warn("[Main] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end
for _, name in order do
	local mod = loaded[name]
	if mod and mod.Start then
		local okStart, err = pcall(mod.Start)
		if not okStart then
			warn("[Main] " .. name .. ".Start failed: " .. tostring(err))
		end
	end
end

-- Developer tools (DEV button + chat commands) live in Services/DevService.
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load/save with retries, a per-session lock (prevents duplication when a
-- player hops or rejoins quickly), autosave, BindToClose and schema migration. Every other
-- service reads and writes data ONLY through DataService.Get(player) on the server.
--
-- Safety rules:
--  * a save only writes while OUR session holds the lock; otherwise it reports failure
--  * the save snapshot is a deep copy taken at save time (consistent even if the write retries)
--  * once a player is leaving, only the final releasing save runs
--  * a join waits for this server's in-flight leave-save of the same user
--  * the no-saving fallback exists only in Studio; live servers kick instead of using a blank profile
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)

local DataService = {}

export type HunterRecord = { Id: string, Locked: boolean?, T: number? }
export type Data = {
	Version: number,
	Ecto: number,
	TotalEcto: number,
	Hunters: { [string]: HunterRecord },
	NextUid: number,
	Equipped: { string },
	Discovered: { [string]: boolean },
	Zones: { [string]: boolean },
	Upgrades: { [string]: number },
	Daily: { Last: number, Streak: number },
	Boosts: { [string]: number }, -- boost id -> os.time expiry
	FreeCrates: { [string]: number },
	Settings: { Music: boolean, Sfx: boolean, FastReveal: boolean },
	Tutorial: number,
	Stats: { Ghosts: number, Crates: number, Events: number, Seconds: number },
	Purchases: { string }, -- recent receipt ids (ring buffer)
	SkipTokens: number, -- bought Single Crate Skips not used yet (added in 1.4; old saves get 0)
	LuckyOpens: { [string]: number }, -- crate id -> lucky opens left (added in 1.5; old saves get {})
	Orphans: { [string]: any }, -- hunters whose id no longer exists in Config (kept, not used)
	Extra: { [string]: any }, -- unknown top-level keys from a newer/older version (kept as-is)
}

local IS_STUDIO = RunService:IsStudio()

local function defaults(): Data
	local d: Data = {
		Version = Config.DataSchemaVersion,
		Ecto = 0,
		TotalEcto = 0,
		Hunters = {},
		NextUid = 1,
		Equipped = {},
		Discovered = {},
		Zones = { [Config.Zones[1].Id] = true },
		Upgrades = {},
		Daily = { Last = 0, Streak = 0 },
		Boosts = {},
		FreeCrates = {},
		Settings = { Music = true, Sfx = true, FastReveal = false },
		Tutorial = 1,
		Stats = { Ghosts = 0, Crates = 0, Events = 0, Seconds = 0 },
		Purchases = {},
		SkipTokens = 0,
		LuckyOpens = {},
		Orphans = {},
		Extra = {},
	}
	for id in Config.Upgrades do
		d.Upgrades[id] = 1
	end
	return d
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

-- Fills missing fields (new features) and upgrades old schemas. Never deletes player data:
-- unknown keys go to Extra, hunters that no longer exist go to Orphans.
local function migrate(raw: any): Data
	local d = defaults()
	if type(raw) ~= "table" then
		return d
	end
	for k, v in raw do
		if k == "_lock" then
			continue
		end
		local cur = (d :: any)[k]
		if cur ~= nil then
			if type(v) == type(cur) and k ~= "Extra" then
				(d :: any)[k] = v
			end
		elseif type(k) == "string" then
			d.Extra[k] = v
		end
	end
	if type(raw.Extra) == "table" then
		for k, v in raw.Extra do
			if d.Extra[k] == nil and (d :: any)[k] == nil then
				d.Extra[k] = v
			elseif raw[k] == nil and k ~= "Extra" and type(v) == type((d :: any)[k]) then
				-- a field this version knows was parked in Extra by an older server (e.g. a
				-- player hopped to a not-yet-updated server): restore it instead of dropping it
				(d :: any)[k] = v
			end
		end
	end
	-- nested defaults
	local base = defaults()
	local settings = d.Settings :: any
	for k, v in base.Settings :: any do
		if type(settings[k]) ~= type(v) then
			settings[k] = v
		end
	end
	for k in settings do
		if (base.Settings :: any)[k] == nil then
			settings[k] = nil -- retired setting (e.g. the old free auto-target)
		end
	end
	for k, v in base.Stats do
		if type((d.Stats :: any)[k]) ~= "number" then
			(d.Stats :: any)[k] = v
		end
	end
	for k, v in base.Daily do
		if type((d.Daily :: any)[k]) ~= "number" then
			(d.Daily :: any)[k] = v
		end
	end
	for id in Config.Upgrades do
		local lv = d.Upgrades[id]
		d.Upgrades[id] = if type(lv) == "number" and lv == lv then math.clamp(math.floor(lv), 1, #Config.Upgrades[id].Levels) else 1
	end
	if type(d.Ecto) ~= "number" or d.Ecto ~= d.Ecto then
		d.Ecto = 0
	end
	if d.SkipTokens ~= d.SkipTokens or d.SkipTokens < 0 then
		d.SkipTokens = 0
	end
	d.SkipTokens = math.floor(d.SkipTokens)
	for id, n in d.LuckyOpens do
		if type(id) ~= "string" or type(n) ~= "number" or n ~= n or n < 1 then
			d.LuckyOpens[id] = nil
		else
			d.LuckyOpens[id] = math.min(math.floor(n), Config.LuckyOpens.MaxStack)
		end
	end
	d.Zones[Config.Zones[1].Id] = true
	-- hunters whose definition was removed are parked in Orphans (restored if the id returns)
	for uid, h in d.Orphans do
		if type(h) == "table" and Config.Hunters[h.Id] and d.Hunters[uid] == nil then
			d.Hunters[uid] = h
			d.Orphans[uid] = nil
		end
	end
	for uid, h in d.Hunters do
		if type(h) ~= "table" or not Config.Hunters[h.Id] then
			d.Orphans[uid] = h
			d.Hunters[uid] = nil
		end
	end
	local eq = {}
	local seen = {}
	for _, uid in d.Equipped do
		if d.Hunters[uid] and not seen[uid] then
			seen[uid] = true
			table.insert(eq, uid)
		end
	end
	d.Equipped = eq
	-- uids must never be reused: NextUid stays above every existing numeric uid
	local maxUid = 0
	for _, list in { d.Hunters :: any, d.Orphans } do
		for uid in list do
			local n = tonumber(uid)
			if n and n > maxUid then
				maxUid = n
			end
		end
	end
	d.NextUid = math.max(math.floor(tonumber(d.NextUid) or 1), maxUid + 1)
	-- (future) if d.Version < 2 then ... end
	d.Version = Config.DataSchemaVersion
	return d
end

type Profile = {
	Data: Data,
	Key: string,
	Session: string,
	Loaded: boolean,
	Leaving: boolean,
	Saving: boolean,
	SyncQueued: boolean,
	JoinedAt: number,
}

local profiles: { [Player]: Profile } = {}
local leavingSaves: { [number]: boolean } = {} -- userId -> final save in flight on this server
local inflight = 0
local store: DataStore? = nil
local storeOk = false
local loadedSignal = Signal.new()
DataService.Loaded = loadedSignal -- (player, data) by reference

local syncRemote: RemoteEvent
local ectoRemote: RemoteEvent
-- Extra values other services add to the client snapshot (crew power, slots, ...).
local decorators: { (Player, any) -> () } = {}

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local delayS = 1
	for attempt = 1, Config.Data.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[Data] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < Config.Data.Retries then
			task.wait(delayS)
			delayS = math.min(delayS * 2, 8)
		end
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

local function lockFresh(lock: any, session: string): boolean
	return type(lock) == "table" and lock.session ~= session and os.time() - (tonumber(lock.t) or 0) < Config.Data.SessionLockSeconds
end

-- Loads with a session lock. Returns data, or nil if the player should be kicked.
local function loadProfile(player: Player, p: Profile): Data?
	if not storeOk or not store then
		return if IS_STUDIO then migrate(nil) else nil
	end
	local ds = store :: DataStore
	local key = p.Key
	for attempt = 1, 6 do
		local locked = false
		local ok, result = retry("load " .. key, function()
			return ds:UpdateAsync(key, function(old: any)
				old = if type(old) == "table" then old else {}
				if lockFresh(old._lock, p.Session) then
					locked = true
					return nil -- don't write
				end
				old._lock = { job = jobId(), session = p.Session, t = os.time() }
				return old
			end)
		end)
		if not ok then
			return nil
		end
		if not locked then
			return migrate(result)
		end
		-- Another session still holds the lock (player just hopped). Wait for it to save.
		task.wait(math.min(2 + attempt * 2, 8))
		if not player.Parent then
			return nil
		end
	end
	warn("[Data] session lock never released for " .. key .. "; taking over")
	local ok, result = retry("steal " .. key, function()
		return ds:UpdateAsync(key, function(old: any)
			old = if type(old) == "table" then old else {}
			old._lock = { job = jobId(), session = p.Session, t = os.time() }
			return old
		end)
	end)
	return if ok then migrate(result) else nil
end

-- Writes the profile. Returns true only if the data really reached the DataStore.
local function saveProfile(player: Player, release: boolean): boolean
	local p = profiles[player]
	if not p or not p.Loaded then
		return false
	end
	if not storeOk or not store then
		return IS_STUDIO -- Studio without API access: nothing to save
	end
	if p.Leaving and not release then
		return false -- only the final, releasing save runs for a leaving player
	end
	if p.Saving then
		local t0 = os.clock()
		while p.Saving and os.clock() - t0 < 20 do
			task.wait(0.2)
		end
		if p.Saving then
			return false -- never run two writes for the same profile in parallel
		end
	end
	p.Saving = true
	inflight += 1
	local ds = store :: DataStore
	p.Data.Stats.Seconds += math.floor(os.clock() - p.JoinedAt)
	p.JoinedAt = os.clock()
	local snapshot = deepCopy(p.Data)
	local aborted = false
	local ok = retry("save " .. p.Key, function()
		aborted = false
		return ds:UpdateAsync(p.Key, function(old: any)
			if type(old) == "table" and lockFresh(old._lock, p.Session) then
				-- another session owns this profile now: never overwrite its newer data
				aborted = true
				return nil
			end
			snapshot._lock = if release then nil else { job = jobId(), session = p.Session, t = os.time() }
			return snapshot
		end)
	end)
	p.Saving = false
	inflight -= 1
	if ok and aborted then
		warn("[Data] save skipped for " .. p.Key .. ": another session owns the profile")
	end
	return ok and not aborted
end

function DataService.Get(player: Player): Data?
	local p = profiles[player]
	return if p and p.Loaded and not p.Leaving then p.Data else nil
end

-- DEV ONLY (DevService checks): wipes this player's progress back to a new profile, in place
-- (other services keep the same table). Keeps purchase receipts (so Robux products are never
-- granted twice), bought Crate Skips and settings. Game passes live on Roblox, not in the save.
function DataService.ResetProgress(player: Player): boolean
	local d = DataService.Get(player)
	if not d then
		return false
	end
	local keep = { Purchases = d.Purchases, Settings = d.Settings, SkipTokens = d.SkipTokens }
	local fresh = defaults()
	table.clear(d :: any)
	for k, v in fresh :: any do
		(d :: any)[k] = v
	end
	d.Purchases = keep.Purchases
	d.Settings = keep.Settings
	d.SkipTokens = keep.SkipTokens
	DataService.Changed(player)
	return true
end

-- Waits (up to timeout) for the player's data.
function DataService.WaitFor(player: Player, timeout: number?): Data?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < (timeout or 30) do
		local d = DataService.Get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return nil
end

function DataService.AddDecorator(fn: (Player, any) -> ())
	table.insert(decorators, fn)
end

local function snapshot(player: Player, d: Data): any
	local s = {
		Ecto = d.Ecto,
		Hunters = d.Hunters,
		Equipped = d.Equipped,
		Discovered = d.Discovered,
		Zones = d.Zones,
		Upgrades = d.Upgrades,
		Daily = d.Daily,
		Boosts = d.Boosts,
		FreeCrates = d.FreeCrates,
		LuckyOpens = d.LuckyOpens,
		Settings = d.Settings,
		Tutorial = d.Tutorial,
		Stats = d.Stats,
		ServerTime = os.time(),
	}
	for _, fn in decorators do
		local ok, err = pcall(function()
			fn(player, s)
		end)
		if not ok then
			warn("[Data] snapshot decorator failed: " .. tostring(err))
		end
	end
	return s
end

-- Sends the client a fresh snapshot (batched: many changes in one frame = one message).
function DataService.Changed(player: Player)
	local p = profiles[player]
	if not p or not p.Loaded or p.SyncQueued then
		return
	end
	p.SyncQueued = true
	task.defer(function()
		p.SyncQueued = false
		if player.Parent and profiles[player] == p and not p.Leaving then
			syncRemote:FireClient(player, snapshot(player, p.Data))
		end
	end)
end

-- Currency changes are frequent: send only the number.
function DataService.AddEcto(player: Player, amount: number)
	local p = profiles[player]
	if not p or not p.Loaded or p.Leaving or amount ~= amount or math.abs(amount) == math.huge then
		return
	end
	amount = math.floor(amount)
	p.Data.Ecto = math.max(0, p.Data.Ecto + amount)
	if amount > 0 then
		p.Data.TotalEcto += amount
	end
	ectoRemote:FireClient(player, p.Data.Ecto)
	player:SetAttribute("Ecto", p.Data.Ecto)
end

-- Spends Ectoplasm. Returns false if the player can't afford it.
function DataService.Spend(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or amount ~= amount or amount < 0 or d.Ecto < amount then
		return false
	end
	DataService.AddEcto(player, -amount)
	return true
end

-- Next unique hunter id (never reuses an id that is already owned).
function DataService.NewUid(d: Data): string
	local uid = tostring(d.NextUid)
	while d.Hunters[uid] ~= nil or d.Orphans[uid] ~= nil do
		d.NextUid += 1
		uid = tostring(d.NextUid)
	end
	d.NextUid += 1
	return uid
end

function DataService.Save(player: Player)
	task.spawn(saveProfile, player, false)
end

-- Saves now and waits; used by ProcessReceipt. True only if the write really happened.
function DataService.SaveNow(player: Player): boolean
	return saveProfile(player, false)
end

function DataService.Init()
	syncRemote = Net.Event("Sync")
	ectoRemote = Net.Event("Ecto")
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		store = result
		if IS_STUDIO then
			-- Studio without "Enable Studio Access to API Services" errors on any request
			storeOk = pcall(function()
				(result :: DataStore):GetAsync("__probe")
			end)
		else
			storeOk = true -- live: per-player loads retry and kick on failure
		end
	end
	if not storeOk then
		warn(if IS_STUDIO
			then "[Data] DataStores unavailable in Studio (turn on API access). Progress will NOT be saved this test."
			else "[Data] DataStore unavailable: players will be asked to rejoin.")
	end
end

local function onPlayerAdded(player: Player)
	local p: Profile = {
		Data = defaults(),
		Key = keyFor(player),
		Session = HttpService:GenerateGUID(false),
		Loaded = false,
		Leaving = false,
		Saving = false,
		SyncQueued = false,
		JoinedAt = os.clock(),
	}
	profiles[player] = p
	-- rejoined this same server while the previous session was still saving: wait for it
	local t0 = os.clock()
	while leavingSaves[player.UserId] and os.clock() - t0 < 30 do
		task.wait(0.2)
	end
	local data = loadProfile(player, p)
	if not player.Parent or profiles[player] ~= p then
		-- left while loading: release OUR lock (only if it is still ours) without writing data
		if data and storeOk and store then
			local ds = store :: DataStore
			pcall(function()
				ds:UpdateAsync(p.Key, function(old: any)
					if type(old) == "table" and type(old._lock) == "table" and old._lock.session == p.Session then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		if profiles[player] == p then
			profiles[player] = nil
		end
		return
	end
	if not data then
		profiles[player] = nil
		player:Kick("Couldn't load your Ghost Hunter data. Please rejoin in a moment - your progress is safe.")
		return
	end
	p.Data = data
	p.Loaded = true
	player:SetAttribute("Ecto", data.Ecto)
	loadedSignal:Fire(player, data)
	DataService.Changed(player)
end

local function onPlayerRemoving(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	p.Leaving = true
	if p.Loaded then
		leavingSaves[player.UserId] = true
		saveProfile(player, true)
		leavingSaves[player.UserId] = nil
	end
	if profiles[player] == p then
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, pl in Players:GetPlayers() do
		task.spawn(onPlayerAdded, pl)
	end
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveSeconds)
			for player, p in profiles do
				if p.Loaded and not p.Leaving then
					task.spawn(saveProfile, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		if not storeOk then
			return
		end
		for player, p in profiles do
			if p.Loaded and not p.Leaving then
				p.Leaving = true
				task.spawn(saveProfile, player, true)
			end
		end
		task.wait() -- let the saves start
		local t0 = os.clock()
		while inflight > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

-- Records a processed receipt id so a purchase is never granted twice.
function DataService.HasPurchase(d: Data, receipt: string): boolean
	return table.find(d.Purchases, receipt) ~= nil
end

function DataService.AddPurchase(d: Data, receipt: string)
	table.insert(d.Purchases, receipt)
	while #d.Purchases > 100 do
		table.remove(d.Purchases, 1)
	end
end

-- exposed for the save-compatibility test (tools/datacompat.sh); not used by the game
DataService._Migrate = migrate

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!strict
-- Owner-only developer tools (DEV button + Studio chat commands). A player is a dev when the
-- game runs in Studio, when they created the game (or own the group that did), or when their
-- UserId is in Config.DevUserIds. Every command is re-checked here on the server, so the
-- button showing up on a client means nothing by itself.
-- NOTE: in a live server these change the dev's REAL saved profile.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local EventService = require(script.Parent.EventService)
local GlobalEventService = require(script.Parent.GlobalEventService)
local Remotes = require(script.Parent.Remotes)

local DevService = {}

local devs: { [Player]: boolean } = {}

local function checkDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.DevUserIds, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank == 255
end

function DevService.IsDev(player: Player): boolean
	return devs[player] == true
end

local MAX_ECTO_GRANT = 1e12

-- Runs one dev command; returns an error text or nil.
function DevService.Run(player: Player, cmd: string, arg: any): string?
	if not devs[player] then
		return "Not allowed"
	end
	local d = DataService.Get(player)
	if not d then
		return "Loading..."
	end
	if cmd == "Ecto" then
		local n = tonumber(arg)
		if not n or n ~= n or n <= 0 then
			return "Bad amount"
		end
		DataService.AddEcto(player, math.min(math.floor(n), MAX_ECTO_GRANT))
	elseif cmd == "Zones" then
		for _, z in Config.Zones do
			d.Zones[z.Id] = true
		end
		DataService.Changed(player)
	elseif cmd == "Hunters" then
		local count = 0
		for _ in d.Hunters do
			count += 1
		end
		for id in Config.Hunters do
			if count >= PlayerInfo.MaxHunters(player) then
				break
			end
			HunterService.Add(player, id)
			count += 1
		end
		HunterService.Refresh(player)
	elseif cmd == "MaxUpgrades" then
		for id, up in Config.Upgrades do
			d.Upgrades[id] = #up.Levels
		end
		DataService.Changed(player)
	elseif cmd == "Ecto2x" then
		-- GLOBAL 2X Ectoplasm (all servers); arg = true (until OFF) / false / hours (timed, 1-168)
		local err
		if type(arg) == "number" and arg == arg then
			err = GlobalEventService.SetEcto2x(true, math.clamp(arg, 1, 168) * 3600)
		else
			err = GlobalEventService.SetEcto2x(arg == true)
		end
		if err then
			return err
		end
	elseif cmd == "ResetProgress" then
		-- the dev's OWN progress only (back to a new player); purchases/passes are kept
		if not DataService.ResetProgress(player) then
			return "Couldn't reset"
		end
		HunterService.Refresh(player)
		player:LoadCharacter() -- back to spawn (the old area may be locked now)
	elseif cmd == "Event" then
		EventService.TriggerNow()
	elseif cmd == "ResetDaily" then
		d.Daily.Last = 0
		DataService.Changed(player)
	elseif cmd == "AutoAttack" then
		PlayerInfo.SetPass(player, "AutoAttack", true)
		HunterService.Refresh(player)
	elseif cmd == "AllPasses" then
		-- every game pass for this session only (testing; nothing is saved or bought)
		for _, pass in Config.GamePasses do
			PlayerInfo.SetPass(player, pass.Key, true)
		end
		local shop = (script.Parent :: any).ShopService
		if shop then
			local ok, mod = pcall(require, shop)
			if ok and mod.ApplyPassLooks then
				mod.ApplyPassLooks(player)
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "ServerLuck" then
		PlayerInfo.AddServerLuck(900)
		for _, other in Players:GetPlayers() do
			DataService.Changed(other)
		end
	elseif cmd == "Exclusive" then
		HunterService.GrantExclusive(player)
	elseif cmd == "Tutorial" then
		d.Tutorial = 1
		DataService.Changed(player)
	else
		return "Unknown command"
	end
	return nil
end

function DevService.Init()
	Remotes.Register("Dev", "Default", function(player, cmd, arg)
		if type(cmd) ~= "string" then
			return Remotes.Fail("Bad command")
		end
		local err = DevService.Run(player, cmd, arg)
		if err then
			return Remotes.Fail(err)
		end
		return { ok = true }
	end)
end

local CHAT: { [string]: string } = {
	["/event"] = "Event",
	["/reset-daily"] = "ResetDaily",
	["/autoattack"] = "AutoAttack",
	["/zones"] = "Zones",
	["/hunters"] = "Hunters",
	["/maxupgrades"] = "MaxUpgrades",
	["/tutorial"] = "Tutorial",
}

function DevService.Start()
	local function hook(player: Player)
		task.spawn(function()
			devs[player] = checkDev(player)
			-- the client shows the DEV button for this attribute; the server still checks every call
			player:SetAttribute("IsDev", devs[player])
		end)
		player.Chatted:Connect(function(msg)
			if not devs[player] then
				return
			end
			local n = msg:match("^/ecto%s+(%d+)")
			if n then
				DevService.Run(player, "Ecto", tonumber(n))
			elseif CHAT[msg] then
				DevService.Run(player, CHAT[msg], nil)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		devs[player] = nil
	end)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DropService</string>
            <string name="Source"><![CDATA[--!strict
-- Physical Ectoplasm orbs. The SERVER decides where each orb lands, what it is worth and
-- when it is picked up (player's root within their pickup radius). Clients only draw orbs
-- (bounce, glow, magnet flight). Orbs are per player, so nobody can steal another's loot.
-- One loop checks every player's orbs on a short interval; no per-orb connections.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)

local DropService = {}

type Drop = { Id: number, Pos: Vector3, Value: number, Expires: number }
type Bag = { List: { Drop }, NextId: number }

local bags: { [Player]: Bag } = {}
local dropsRemote: RemoteEvent
local collectRemote: RemoteEvent
local rng = Random.new()
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local collectedSignal = Signal.new()
DropService.Collected = collectedSignal -- (player, amount)

-- Ground raycasts ignore ghosts and characters (filter built once per Spawn call).
local function refreshFilter()
	local filter: { Instance } = {}
	local ghosts = workspace:FindFirstChild("Ghosts")
	if ghosts then
		table.insert(filter, ghosts)
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(filter, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
end

local function groundAt(x: number, y: number, z: number): number
	local hit = workspace:Raycast(Vector3.new(x, y + 4, z), Vector3.new(0, -80, 0), rayParams)
	return if hit then hit.Position.Y else 0
end

-- Spawns `total` Ectoplasm split into `count` orbs around `origin` for `player`.
-- scatter = {min, max} studs (defaults from Config.Drops).
function DropService.Spawn(player: Player, origin: Vector3, total: number, count: number, scatter: { number }?)
	local bag = bags[player]
	if not bag then
		return
	end
	local values = Rules.Split(total, math.max(1, count))
	local sMin = if scatter then scatter[1] else Config.Drops.ScatterMin
	local sMax = if scatter then scatter[2] else Config.Drops.ScatterMax
	local expires = os.clock() + Config.Drops.Lifetime
	local out: { { any } } = {}
	local removed: { number } = {}
	refreshFilter()
	for _, v in values do
		-- over the cap (nobody is collecting): the oldest orb fades away to make room,
		-- exactly as if it had timed out
		if #bag.List >= Config.Drops.MaxPerPlayer then
			local oldest = 1
			for i, d in bag.List do
				if d.Expires < bag.List[oldest].Expires then
					oldest = i
				end
			end
			table.insert(removed, bag.List[oldest].Id)
			bag.List[oldest] = bag.List[#bag.List]
			bag.List[#bag.List] = nil
		end
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber(sMin, sMax)
		local x = origin.X + math.cos(a) * r
		local z = origin.Z + math.sin(a) * r
		-- keep orbs inside the playable area
		x = math.clamp(x, -Config.Layout.HalfWidth + 4, Config.Layout.HalfWidth - 4)
		local y = groundAt(x, origin.Y, z) + 1.1
		local drop: Drop = { Id = bag.NextId, Pos = Vector3.new(x, y, z), Value = v, Expires = expires }
		bag.NextId += 1
		table.insert(bag.List, drop)
		table.insert(out, { drop.Id, drop.Pos, drop.Value } :: { any })
	end
	if #out > 0 then
		dropsRemote:FireClient(player, origin, out, removed)
	end
end

local function pickupTick()
	local t = os.clock()
	for player, bag in bags do
		if #bag.List == 0 then
			continue
		end
		local root = Remotes.Root(player)
		local radius = PlayerInfo.PickupRadius(player) + 1.5 -- latency slack
		local r2 = radius * radius
		local got = 0
		local ids = {}
		local i = 1
		while i <= #bag.List do
			local d = bag.List[i]
			local take = false
			if root then
				local dx = d.Pos.X - root.Position.X
				local dz = d.Pos.Z - root.Position.Z
				take = dx * dx + dz * dz <= r2 and math.abs(d.Pos.Y - root.Position.Y) < 14
			end
			if take then
				got += d.Value
				table.insert(ids, d.Id)
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			elseif t >= d.Expires then
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			else
				i += 1
			end
		end
		if got > 0 then
			DataService.AddEcto(player, got)
			collectRemote:FireClient(player, ids, got)
			collectedSignal:Fire(player, got)
		end
	end
end

function DropService.Init()
	dropsRemote = Net.Event("Drops")
	collectRemote = Net.Event("Collect")
end

function DropService.Start()
	local function add(player: Player)
		bags[player] = { List = {}, NextId = 1 }
	end
	Players.PlayerAdded:Connect(add)
	for _, pl in Players:GetPlayers() do
		add(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		bags[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Drops.PickupTick)
			local ok, err = pcall(function()
				pickupTick()
			end)
			if not ok then
				warn("[Drops] tick error: " .. tostring(err))
			end
		end
	end)
end

return DropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST: a periodic server-wide boss everyone can attack. Spirit scales with the
-- crews in the server; rewards scale with each participant's share of the damage.
-- Client messages (Fx "Boss"): { State = "Warning"|"Active"|"Defeated"|"Escaped", At = serverTime, Uid?, EndsAt? }
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local GhostService = require(script.Parent.GhostService)
local DropService = require(script.Parent.DropService)
local Fx = require(script.Parent.Fx)

local EventService = {}

local current: GhostService.Ghost? = nil
local state = "Idle"
local endsAt = 0
local rng = Random.new()

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function spiritFor(): number
	-- only crews near the arena count (late-game players elsewhere on the map must not make
	-- the boss unbeatable for the players who are actually there)
	local sum = 0
	local arena = Config.Layout.EventArena.Center
	for _, pl in Players:GetPlayers() do
		local char = pl.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - arena).Magnitude <= Config.Event.JoinRadius then
			sum += math.min(HunterService.CrewPower(pl), Config.Event.PowerCap)
		end
	end
	return Config.Event.SpiritBase + Config.Event.SpiritPerPower * sum
end

local function reward(g: GhostService.Ghost)
	local total = 0
	local participants = {}
	for player, dmg in g.Damage do
		-- counts if they dealt 1% of the boss, or ~MinSeconds of their own crew's damage (so a
		-- small crew fighting next to a huge one still participates)
		local ownShare = HunterService.CrewPower(player) * Config.Event.MinSeconds
		if player.Parent and dmg > 0 and (dmg >= g.Max * Config.Event.MinContribution or dmg >= ownShare) then
			table.insert(participants, player)
			total += dmg
		end
	end
	local arena = Config.Layout.EventArena
	for _, player in participants do
		local d = DataService.Get(player)
		if d then
			local share = Rules.EventShare(g.Damage[player], total, #participants, Config.Event.MinShare, Config.Event.MaxShare)
			local amount = Config.Event.RewardBase * PlayerInfo.ZoneMultiplier(player) * share * PlayerInfo.EctoMultiplier(player)
			amount = math.floor(amount + 0.5)
			-- Ectoplasm shower over the arena
			DropService.Spawn(player, arena.Center + Vector3.new(0, 12, 0), amount, Config.Event.RewardDrops, { 4, arena.Radius - 4 })
			d.Stats.Events += 1
			Fx.Toast(player, "GIANT POLTERGEIST DEFEATED! +" .. Format.Commas(amount) .. " Ectoplasm incoming!", "Good")
		end
	end
end

local function runEvent()
	if state ~= "Idle" then
		return
	end
	local arena = Config.Layout.EventArena
	state = "Warning"
	Fx.All("Boss", { State = "Warning", At = serverNow() + Config.Event.WarningSeconds, Pos = arena.Center })
	task.wait(Config.Event.WarningSeconds)
	if #Players:GetPlayers() == 0 then
		state = "Idle"
		return
	end
	local def = Config.Ghosts[Config.Event.Ghost]
	local g = GhostService.Spawn(def, arena.Center, arena.Radius * 0.35, { Spirit = spiritFor(), Event = true })
	current = g
	state = "Active"
	endsAt = serverNow() + Config.Event.Duration
	g.Model:SetAttribute("EndsAt", endsAt)
	Fx.All("Boss", { State = "Active", Uid = g.Uid, EndsAt = endsAt, Pos = arena.Center })
	while g.Alive and serverNow() < endsAt do
		task.wait(0.2)
	end
	-- `g` is our own reference, so this works no matter how the ghost was removed
	if g.Alive then
		GhostService.Remove(g, nil, false)
		Fx.All("Boss", { State = "Escaped" })
	else
		Fx.All("Boss", { State = "Defeated", Pos = GhostService.Position(g) })
		reward(g)
	end
	current = nil
	state = "Idle"
end

-- Runs one event safely: an error can never leave the event system stuck.
local function runSafely()
	local ok, err = pcall(function()
		runEvent()
	end)
	if not ok then
		warn("[Event] " .. tostring(err))
		if current and current.Alive then
			pcall(GhostService.Remove, current, nil, false)
		end
		Fx.All("Boss", { State = "Escaped" })
		state = "Idle"
		current = nil
	end
end

-- Start an event now (DEV button / Summon product). While one is running the request is
-- queued and starts shortly after the current one ends.
local queued = 0
local running = false

local function runGuarded()
	if running then
		queued += 1
		return
	end
	running = true
	runSafely()
	while queued > 0 do
		queued -= 1
		task.wait(8)
		runSafely()
	end
	running = false
end

function EventService.Init()
	-- late joiners see the current boss
	DataService.Loaded:Connect(function(player)
		if state == "Active" and current then
			Fx.To(player, "Boss", { State = "Active", Uid = current.Uid, EndsAt = endsAt, Pos = Config.Layout.EventArena.Center })
		end
	end)
end

function EventService.Start()
	task.spawn(function()
		task.wait(Config.Event.FirstDelay)
		while true do
			-- a summoned event may already be running: skip this slot instead of queueing a second one
			if not running then
				runGuarded()
			end
			task.wait(Config.Event.Interval + rng:NextNumber(-30, 30))
		end
	end)
end

function EventService.TriggerNow()
	task.spawn(runGuarded)
end

function EventService.IsBusy(): boolean
	return running
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">FeedbackService</string>
            <string name="Source"><![CDATA[--!strict
-- Player feedback (bug reports + ideas). Players send short text from the FEEDBACK panel; it is
-- run through Roblox's text filter and kept in a DataStore inbox (newest first, capped) that
-- only developers can read from the DEV panel. Cooldown + per-server cap stop spam.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local DevService = require(script.Parent.DevService)
local Remotes = require(script.Parent.Remotes)

local FeedbackService = {}

export type Entry = { T: number, UserId: number, Name: string, Kind: string, Text: string, Zone: string, Version: string }

local KEY = "Inbox"
local store: DataStore? = nil
local memory: { Entry } = {} -- Studio without API access: keep this session's feedback here
local lastSent: { [Player]: number } = {}
local sentCount: { [Player]: number } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function zoneOf(player: Player): string
	local root = Remotes.Root(player)
	if not root then
		return "?"
	end
	local z = Config.Zones[Rules.ZoneIndexAt(root.Position.Z, zoneRanges)]
	return if z then z.Id else "?"
end

local function filter(player: Player, text: string): string?
	local ok, result = pcall(function()
		local r = TextService:FilterStringAsync(text, player.UserId)
		return r:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	-- the filter is unavailable in some Studio setups; never store unfiltered text live
	return if RunService:IsStudio() then text else nil
end

local function save(entry: Entry): boolean
	local s = store
	if not s then
		table.insert(memory, 1, entry)
		return true
	end
	local ok = pcall(function()
		s:UpdateAsync(KEY, function(old: any)
			local list = if type(old) == "table" then old else {}
			table.insert(list, 1, entry)
			while #list > Config.Feedback.InboxSize do
				table.remove(list)
			end
			return list
		end)
	end)
	return ok
end

local function load(): { Entry }
	local s = store
	if not s then
		return memory
	end
	local ok, list = pcall(function()
		return s:GetAsync(KEY)
	end)
	return if ok and type(list) == "table" then list :: any else {}
end

function FeedbackService.Init()
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(Config.Feedback.DataStoreName)
	end)
	store = if ok then ds else nil

	Remotes.Register("Feedback", "Default", function(player, kind, text)
		local fb = Config.Feedback
		if kind ~= "Bug" and kind ~= "Idea" then
			return Remotes.Fail("Pick BUG or IDEA")
		end
		if type(text) ~= "string" then
			return Remotes.Fail("Write something first")
		end
		local clean = text:gsub("%c", " "):gsub("^%s+", ""):gsub("%s+$", "")
		if #clean < fb.MinLength then
			return Remotes.Fail("Tell us a bit more (" .. fb.MinLength .. "+ letters)")
		end
		if #clean > fb.MaxLength then
			clean = clean:sub(1, fb.MaxLength)
		end
		local now = os.clock()
		if now - (lastSent[player] or -math.huge) < fb.Cooldown then
			return Remotes.Fail("Thanks! Wait a minute before sending more.")
		end
		if (sentCount[player] or 0) >= fb.PerServer then
			return Remotes.Fail("Thanks! You've sent a lot already today.")
		end
		lastSent[player] = now
		local filtered = filter(player, clean)
		if not filtered then
			return Remotes.Fail("Couldn't send right now, try again later")
		end
		local entry: Entry = {
			T = os.time(),
			UserId = player.UserId,
			Name = player.Name,
			Kind = kind,
			Text = filtered,
			Zone = zoneOf(player),
			Version = Config.Version,
		}
		if not save(entry) then
			lastSent[player] = nil
			return Remotes.Fail("Couldn't send right now, try again later")
		end
		sentCount[player] = (sentCount[player] or 0) + 1
		return { ok = true }
	end)

	-- developers read the inbox from the DEV panel
	Remotes.Register("FeedbackInbox", "Default", function(player)
		if not DevService.IsDev(player) then
			return Remotes.Fail("Not allowed")
		end
		local list = load()
		local out = {}
		for i = 1, math.min(#list, 60) do
			table.insert(out, list[i])
		end
		return { ok = true, Entries = out }
	end)
end

function FeedbackService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastSent[player] = nil
		sentCount[player] = nil
	end)
	local _ = DataService
end

return FeedbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Server → client effect/announcement messages over the "Fx" remote.
-- Kinds: Poof, Announce, ZoneUnlocked, Boss, Toast, Upgrade, Daily (see docs/ARCHITECTURE.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("GH").Net)

local Fx = {}
local remote: RemoteEvent

function Fx.Init()
	remote = Net.Event("Fx")
end

function Fx.All(kind: string, data: any?)
	remote:FireAllClients(kind, data)
end

-- Everyone except one player (e.g. the opener of a legendary crate, who sees the reveal).
function Fx.AllExcept(except: Player, kind: string, data: any?)
	for _, pl in game:GetService("Players"):GetPlayers() do
		if pl ~= except then
			remote:FireClient(pl, kind, data)
		end
	end
end

function Fx.To(player: Player, kind: string, data: any?)
	remote:FireClient(player, kind, data)
end

function Fx.Toast(player: Player, text: string, color: string?)
	remote:FireClient(player, "Toast", { Text = text, Color = color })
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">GhostService</string>
            <string name="Source"><![CDATA[--!strict
-- Ghost spawning, wandering, targeting and server-authoritative damage.
--
-- Movement is NOT simulated per frame on the server. Each ghost has a straight wander segment
-- (attributes From, To, T0, Dur in server time); the server evaluates the position only when it
-- needs it (range checks, drops) and every client animates the model locally along the same
-- segment. One loop handles all ghosts, so there is no per-ghost Heartbeat connection.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)
local Signal = require(GH.Signal)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local DropService = require(script.Parent.DropService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local GhostService = {}

export type Ghost = {
	Uid: number,
	Def: Config.GhostDef,
	Model: Model,
	Spirit: number,
	Max: number,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	NextMove: number,
	Center: Vector3,
	Radius: number,
	Alive: boolean,
	Event: boolean,
	Area: number?, -- index into Config.Layout.GhostAreas (nil for event ghosts)
	Damage: { [Player]: number },
	DirtySpirit: boolean,
}

local buildHitbox: (Config.GhostDef, Vector3) -> Model
local ghosts: { [number]: Ghost } = {}
local nextUid = 1
local folder: Folder
local rng = Random.new()

-- Ready = os.clock() when damage may start (hunters need time to run over).
-- Auto = picked by the Auto Attack pass (manual picks are never replaced automatically).
type Target = { Uid: number, Ready: number, Auto: boolean }
local targets: { [Player]: Target } = {}

-- Auto Attack toggle (session only, default OFF). Only honoured while the player owns the pass.
local autoOn: { [Player]: boolean } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local killedSignal = Signal.new()
GhostService.Killed = killedSignal -- (ghost: Ghost, killer: Player?) by reference

local function now(): number
	return workspace:GetServerTimeNow()
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function GhostService.Position(g: Ghost, t: number?): Vector3
	local a = if g.Dur > 0 then math.clamp(((t or now()) - g.T0) / g.Dur, 0, 1) else 1
	return g.From:Lerp(g.To, smooth(a))
end

function GhostService.Get(uid: number): Ghost?
	return ghosts[uid]
end

function GhostService.All(): { [number]: Ghost }
	return ghosts
end

local function randomPoint(center: Vector3, radius: number, hover: number): Vector3
	local a = rng:NextNumber() * math.pi * 2
	local r = math.sqrt(rng:NextNumber()) * radius
	return Vector3.new(center.X + math.cos(a) * r, center.Y + hover, center.Z + math.sin(a) * r)
end

-- A random point that keeps clear of the other live ghosts of the same spawn area (first try
-- that leaves `spacing` studs, else the roomiest of a few tries), so ghosts don't stack and
-- each one stays easy to tap.
local SPREAD_TRIES = 5
local function spacedPoint(center: Vector3, radius: number, hover: number, area: number?, self: Ghost?, spacing: number): Vector3
	local best, bestGap = randomPoint(center, radius, hover), -1
	if area == nil then
		return best
	end
	local want = spacing * spacing
	for i = 1, SPREAD_TRIES do
		local p = if i == 1 then best else randomPoint(center, radius, hover)
		local gap = math.huge
		for _, o in ghosts do
			if o ~= self and o.Alive and o.Area == area then
				local q = o.To
				local dx, dz = p.X - q.X, p.Z - q.Z
				gap = math.min(gap, dx * dx + dz * dz)
			end
		end
		if gap >= want then
			return p
		end
		if gap > bestGap then
			best, bestGap = p, gap
		end
	end
	return best
end

local function setSegment(g: Ghost, to: Vector3)
	local t = now()
	local from = GhostService.Position(g, t)
	g.From = from
	g.To = to
	g.T0 = t
	g.Dur = math.max(0.5, (to - from).Magnitude / math.max(g.Def.Speed, 0.1))
	g.NextMove = t + g.Dur + rng:NextNumber(0.4, g.Def.Wander)
	local m = g.Model
	m:SetAttribute("From", g.From)
	m:SetAttribute("To", g.To)
	m:SetAttribute("T0", g.T0)
	m:SetAttribute("Dur", g.Dur)
end

-- The server's ghost is only an invisible, generously sized tap target (Core) with the
-- attachments beams and labels use. Every client builds the visual rig (GhostRig) locally,
-- so a kill/respawn replicates one part instead of a whole model.
function buildHitbox(def: Config.GhostDef, pos: Vector3): Model
	local s = def.Scale
	local model = Instance.new("Model")
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(1, 1, 1) * (Config.Combat.HitboxDiameter * s)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = true
	core.CastShadow = false
	core.CFrame = CFrame.new(pos)
	core.Parent = model
	local attachments: { [string]: number } = { Center = 0, Top = 2.4 * s, Bottom = -2.1 * s }
	for name, y in attachments do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = Vector3.new(0, y, 0)
		a.Parent = core
	end
	model.PrimaryPart = core
	return model
end

-- Creates a ghost. `spirit` overrides the config value (event ghost scaling).
export type SpawnOpts = { Spirit: number?, Event: boolean?, Area: number? }

function GhostService.Spawn(def: Config.GhostDef, center: Vector3, radius: number, opts: SpawnOpts?): Ghost
	local o: SpawnOpts = opts or {}
	local uid = nextUid
	nextUid += 1
	local spirit = math.floor(o.Spirit or def.Spirit)
	local pos = spacedPoint(center, radius, def.Hover, o.Area, nil, Config.Combat.HitboxDiameter * def.Scale * 1.4)
	local model = buildHitbox(def, pos)
	model.Name = "Ghost_" .. uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("GhostId", def.Id)
	model:SetAttribute("Spirit", spirit)
	model:SetAttribute("MaxSpirit", spirit)
	model:SetAttribute("Zone", def.Zone)
	model:SetAttribute("Event", o.Event == true)
	local g: Ghost = {
		Uid = uid,
		Def = def,
		Model = model,
		Spirit = spirit,
		Max = spirit,
		From = pos,
		To = pos,
		T0 = now(),
		Dur = 0,
		NextMove = 0,
		Center = center,
		Radius = radius,
		Alive = true,
		Event = o.Event == true,
		Area = o.Area,
		Damage = {},
		DirtySpirit = false,
	}
	ghosts[uid] = g
	setSegment(g, pos)
	g.NextMove = now() + rng:NextNumber(0, def.Wander)
	model.Parent = folder
	return g
end

local function rootPos(player: Player): Vector3?
	local root = Remotes.Root(player)
	return if root then root.Position else nil
end

local function setTarget(player: Player, uid: number?, auto: boolean?)
	local g = uid and ghosts[uid]
	if uid and g then
		-- damage starts once the crew could plausibly have run to the ghost
		local p = rootPos(player)
		local run = if p then (GhostService.Position(g) - p).Magnitude / Config.Combat.HunterRunSpeed else 0
		targets[player] = { Uid = uid, Ready = os.clock() + Config.Combat.EngageDelay + math.min(run, 2), Auto = auto == true }
		player:SetAttribute("Target", uid)
	else
		targets[player] = nil
		player:SetAttribute("Target", 0)
	end
end

function GhostService.AutoActive(player: Player): boolean
	return autoOn[player] == true -- FREE for every player (no pass)
end

-- Auto Attack pick: nearest living ghost the player may fight, in the zone the player is
-- standing in (so hunters never run through zone walls), within Config.AutoAttack.Range.
local function autoCandidate(player: Player): Ghost?
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not d or not p then
		return nil
	end
	local here = Rules.ZoneIndexAt(p.Z, zoneRanges)
	local best, bestDist = nil, Config.AutoAttack.Range
	local t = now()
	for _, g in ghosts do
		local zone = Config.ZoneById[g.Def.Zone]
		if g.Alive and zone and zone.Order == here and d.Zones[zone.Id] then
			local dist = (GhostService.Position(g, t) - p).Magnitude
			if dist < bestDist then
				best, bestDist = g, dist
			end
		end
	end
	return best
end

-- Removes a ghost. reward=false for escapes/cleanup.
function GhostService.Remove(g: Ghost, killer: Player?, reward: boolean)
	if not g.Alive then
		return
	end
	g.Alive = false
	ghosts[g.Uid] = nil
	local pos = GhostService.Position(g)
	g.Model:SetAttribute("Spirit", 0)
	g.Model:SetAttribute("Dead", true)
	Fx.All("Poof", {
		Uid = g.Uid,
		Pos = pos,
		Scale = g.Def.Scale,
		Color = g.Def.Glow,
		Big = g.Def.Kind ~= "Normal",
		Escaped = not reward,
	})
	task.delay(1.2, function()
		g.Model:Destroy()
	end)

	if reward and not g.Event then
		-- helpers get their own drops; the bar to count as a helper drops when many crews pile on
		local helpers = 0
		for player in g.Damage do
			if player.Parent then
				helpers += 1
			end
		end
		local minShare = g.Max * math.min(Config.Combat.ContributorShare, 0.5 / math.max(helpers, 1))
		-- bosses (MiniBoss / Boss): the reward is split by damage, so each helper gets the
		-- percentage of the reward that matches the percentage of the damage they dealt
		local isBoss = g.Def.Kind ~= "Normal"
		local totalDmg = 0
		for player, dmg in g.Damage do
			if player.Parent then
				totalDmg += dmg
			end
		end
		for player, dmg in g.Damage do
			if player.Parent and (player == killer or dmg >= minShare or (isBoss and dmg > 0)) then
				local d = DataService.Get(player)
				if d then
					local base = g.Def.Reward -- fixed per ghost type
					if isBoss then
						base *= Rules.DamageShare(dmg, totalDmg)
					end
					local total = math.max(1, math.floor(base * PlayerInfo.EctoMultiplier(player) + 0.5))
					DropService.Spawn(player, pos, total, g.Def.Drops, nil)
					d.Stats.Ghosts += 1
				end
			end
		end
	end
	if reward then
		killedSignal:Fire(g, killer)
	end

	-- Hunters on this ghost come home. Only Auto Attack owners with the toggle ON get a new
	-- ghost picked for them; everyone else chooses their next ghost by clicking/tapping it.
	for player, tg in targets do
		if tg.Uid == g.Uid then
			local nextG = if GhostService.AutoActive(player) then autoCandidate(player) else nil
			setTarget(player, if nextG then nextG.Uid else nil, true)
		end
	end

	if g.Area then
		local area = Config.Layout.GhostAreas[g.Area]
		task.delay(g.Def.Respawn, function()
			GhostService.Spawn(g.Def, area.Center, area.Radius, { Area = g.Area })
		end)
	end
end

local function onSelect(player: Player, uid: any)
	if not Remotes.Allow(player, "SelectTarget") then
		return
	end
	if uid == nil or uid == 0 then
		setTarget(player, nil)
		return
	end
	if type(uid) ~= "number" then
		return
	end
	local g = ghosts[uid]
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not g or not g.Alive or not d or not p then
		return
	end
	if not d.Zones[g.Def.Zone] then
		Fx.Toast(player, "Unlock " .. (Config.ZoneById[g.Def.Zone] :: Config.ZoneDef).Name .. " first!", "Bad")
		return
	end
	if (GhostService.Position(g) - p).Magnitude > Config.Combat.MaxRange + 15 then
		Fx.Toast(player, "Get closer to that ghost!", "Bad")
		return
	end
	local cur = targets[player]
	if cur and cur.Uid == uid then
		cur.Auto = false -- the player chose it: Auto Attack OFF won't drop it
		return
	end
	setTarget(player, uid, false)
end

-- Gives Auto Attack players a ghost whenever their crew is idle.
local function autoTick()
	for player, on in autoOn do
		if on and not targets[player] and player.Parent and GhostService.AutoActive(player) then
			local g = autoCandidate(player)
			if g then
				setTarget(player, g.Uid, true)
			end
		end
	end
end

local function damageTick(dt: number)
	local t = now()
	local clock = os.clock()
	for player, tg in targets do
		local g = ghosts[tg.Uid]
		if not g or not g.Alive or not player.Parent then
			targets[player] = nil
			if player.Parent then
				player:SetAttribute("Target", 0)
			end
			continue
		end
		local p = rootPos(player)
		if not p then
			continue
		end
		local dist = (GhostService.Position(g, t) - p).Magnitude
		if dist > Config.Combat.MaxRange * 1.4 then
			setTarget(player, nil) -- walked away: hunters come home
			continue
		end
		if dist > Config.Combat.MaxRange or clock < tg.Ready then
			continue
		end
		local power = HunterService.CrewPower(player)
		if power <= 0 then
			continue
		end
		local dmg = power * dt
		g.Spirit -= dmg
		g.Damage[player] = (g.Damage[player] or 0) + dmg
		g.DirtySpirit = true
		if g.Spirit <= 0 then
			GhostService.Remove(g, player, true)
		end
	end
	for _, g in ghosts do
		if g.DirtySpirit and g.Alive then
			g.DirtySpirit = false
			g.Model:SetAttribute("Spirit", math.max(0, math.ceil(g.Spirit)))
		end
	end
end

local function moveTick()
	local t = now()
	for _, g in ghosts do
		if g.Alive and t >= g.NextMove then
			setSegment(g, spacedPoint(g.Center, g.Radius, g.Def.Hover, g.Area, g, Config.Combat.HitboxDiameter * g.Def.Scale * 1.4))
		end
	end
end

function GhostService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Ghosts"
	folder.Parent = workspace
	Net.Event("SelectTarget").OnServerEvent:Connect(onSelect)

	-- AUTO ATTACK toggle: FREE for everyone. It only automates picking targets: damage,
	-- rewards and pickups are exactly the same as tapping ghosts yourself.
	Remotes.Register("AutoAttack", "Default", function(player, on)
		if type(on) ~= "boolean" then
			return Remotes.Fail("Bad value")
		end
		if on then
			autoOn[player] = true
		else
			autoOn[player] = nil
		end
		player:SetAttribute("AutoAttack", on)
		if not on then
			-- back to manual: a ghost Auto Attack picked is dropped, one you chose is kept
			local tg = targets[player]
			if tg and tg.Auto then
				setTarget(player, nil)
			end
		end
		return { ok = true, On = on }
	end)
end

function GhostService.Start()
	for i, area in Config.Layout.GhostAreas do
		local def = Config.Ghosts[area.Ghost]
		for _ = 1, area.Count do
			GhostService.Spawn(def, area.Center, area.Radius, { Area = i })
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		autoOn[player] = nil
		for _, g in ghosts do
			g.Damage[player] = nil
		end
	end)
	task.spawn(function()
		local tick = Config.Combat.TickSeconds
		local last = os.clock()
		local nextAuto = 0
		while true do
			task.wait(tick)
			local c = os.clock()
			-- cap dt so a server hitch can't produce a burst of damage
			local dt = math.min(c - last, tick * 2)
			last = c
			local ok, err = pcall(function()
				damageTick(dt)
				moveTick()
				if c >= nextAuto then
					nextAuto = c + Config.AutoAttack.ScanSeconds
					autoTick()
				end
			end)
			if not ok then
				warn("[Ghosts] tick error: " .. tostring(err))
			end
		end
	end)
end

return GhostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">GlobalEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Developer-controlled GLOBAL events (currently: 2X ECTOPLASM). Never automatic: the state is
-- OFF unless a developer turns it on from the DEV panel, and it stays whatever was last set.
--   * state is stored in a DataStore (Config.GlobalEvents) so NEW servers read it at start
--   * a change is broadcast with MessagingService so RUNNING servers update within seconds
--   * every server also re-reads the DataStore every RefreshSeconds (a missed message heals)
--   * clients see workspace attribute "Ecto2x" (indicator) and get an "Ecto2xEvent" message
--   * an event can have an end time (Ends, unix seconds; 0 = until turned off). Every server
--     switches itself OFF when it passes, so a timed event needs no further action
-- Only DevService (server-checked developer UserIds) can change it. In Studio changes stay in
-- the test server, so a Studio test can never switch the event on for live players.
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Fx = require(script.Parent.Fx)

local GlobalEventService = {}

type State = { Ecto2x: boolean, T: number, Ends: number }

local G = Config.GlobalEvents
local IS_STUDIO = RunService:IsStudio()
local store: DataStore? = nil
local current: State = { Ecto2x = false, T = 0, Ends = 0 }

local function sanitize(v: any): State
	if type(v) == "table" then
		return {
			Ecto2x = v.Ecto2x == true,
			T = if type(v.T) == "number" then v.T else 0,
			Ends = if type(v.Ends) == "number" then v.Ends else 0,
		}
	end
	return { Ecto2x = false, T = 0, Ends = 0 }
end

local function active(st: State): boolean
	return st.Ecto2x and (st.Ends <= 0 or os.time() < st.Ends)
end

local shownOn = false -- what this server currently applies (saved state + end time)

-- Applies a state in this server (idempotent; older states are ignored).
local function apply(new: State, announce: boolean)
	if new.T < current.T then
		return
	end
	current = new
	local on = active(new)
	local was = shownOn
	shownOn = on
	PlayerInfo.SetGlobalEctoMultiplier(if on then G.Ecto2xMultiplier else 1)
	workspace:SetAttribute("Ecto2x", on)
	workspace:SetAttribute("Ecto2xEnds", if on then new.Ends else 0)
	if was ~= on then
		for _, p in Players:GetPlayers() do
			DataService.Changed(p) -- refresh the multiplier shown in their HUD
		end
		if announce then
			Fx.All("Ecto2xEvent", { On = on })
		end
	end
end

local function load(): State?
	local s = store
	if not s then
		return nil
	end
	local ok, v = pcall(function()
		return s:GetAsync(G.Key)
	end)
	return if ok then sanitize(v) else nil
end

function GlobalEventService.Ecto2x(): boolean
	return shownOn
end

-- Developer action (DevService checks the player first). `seconds` > 0 makes a timed event
-- that ends by itself on every server. Returns an error text or nil.
function GlobalEventService.SetEcto2x(on: boolean, seconds: number?): string?
	local now = os.time()
	local ends = if on and seconds and seconds > 0 then now + math.floor(seconds) else 0
	local new: State = { Ecto2x = on, T = now, Ends = ends }
	if IS_STUDIO or not store then
		apply(new, true)
		return nil
	end
	local s = store :: DataStore
	local ok, err = pcall(function()
		-- the stamp always grows past the saved one (and this server's), so servers whose clocks
		-- differ by a few seconds never ignore a quick ON -> OFF as "older"
		s:UpdateAsync(G.Key, function(old: any)
			new.T = math.max(new.T, sanitize(old).T + 1, current.T + 1)
			return new
		end)
	end)
	if not ok then
		return "Couldn't save the event state: " .. tostring(err)
	end
	apply(new, true)
	pcall(function()
		MessagingService:PublishAsync(G.Topic, new)
	end)
	return nil
end

function GlobalEventService.Init()
	if not IS_STUDIO then
		local ok, ds = pcall(function()
			return DataStoreService:GetDataStore(G.DataStoreName)
		end)
		store = if ok then ds else nil
	end
	workspace:SetAttribute("Ecto2x", false)
end

function GlobalEventService.Start()
	-- new server: read the saved state (missing = OFF; nothing ever turns it on by itself)
	task.spawn(function()
		local s = load()
		if s then
			apply(s, false)
		end
	end)
	-- timed events: switch OFF locally once the end time passes (the saved state stays as is;
	-- every server and every new server reaches the same answer from Ends)
	task.spawn(function()
		while true do
			task.wait(5)
			if shownOn and not active(current) then
				apply(current, true)
			end
		end
	end)
	if not IS_STUDIO then
		pcall(function()
			MessagingService:SubscribeAsync(G.Topic, function(msg)
				apply(sanitize(msg.Data), true)
			end)
		end)
		task.spawn(function()
			while true do
				task.wait(G.RefreshSeconds)
				local s = load()
				if s then
					apply(s, true)
				end
			end
		end)
	end
end

return GlobalEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">HunterService</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter inventory, equipping and crate opening (server-authoritative rolls).
-- Replicates each player's crew to everyone through player attributes:
--   Crew = "HunterId,HunterId,..." (equipped order), CrewPower = number.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local HunterService = {}
-- player -> token of their running Auto Open loop (a new token stops the old loop)
local autoOpen: { [Player]: {} } = {}
-- player -> os.clock() before which their Auto Open may not open again (OFF/ON spam can't speed it up)
local autoNext: { [Player]: number } = {}
HunterService.GrantExclusive = nil :: any

local rng = Random.new()
local STATION_RANGE = 30

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	local r = h and Config.Rarities[h.Rarity]
	return if r then r.Order else 1
end
HunterService.PowerOf = powerOf
HunterService.RarityOrder = rarityOrder

local function countOwned(d: DataService.Data): number
	local n = 0
	for _ in d.Hunters do
		n += 1
	end
	return n
end

function HunterService.CrewPower(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	return Rules.CrewPower(d.Equipped, d.Hunters, powerOf)
end

-- Pushes the crew to attributes (for everyone's visuals) and re-syncs the owner.
function HunterService.Refresh(player: Player)
	local d = DataService.Get(player)
	if not d then
		return
	end
	local ids = {}
	for _, uid in d.Equipped do
		local h = d.Hunters[uid]
		if h then
			table.insert(ids, h.Id)
		end
	end
	player:SetAttribute("Crew", table.concat(ids, ","))
	player:SetAttribute("CrewPower", Rules.CrewPower(d.Equipped, d.Hunters, powerOf))
	DataService.Changed(player)
end

function HunterService.Add(player: Player, hunterId: string): (string?, boolean)
	local d = DataService.Get(player)
	if not d or not Config.Hunters[hunterId] then
		return nil, false
	end
	local uid = DataService.NewUid(d)
	d.Hunters[uid] = { Id = hunterId, Locked = false, T = os.time() }
	local isNew = not d.Discovered[hunterId]
	d.Discovered[hunterId] = true
	return uid, isNew
end

-- A profile with nothing equipped (new player) gets its best hunters equipped.
local function ensureEquipped(player: Player, d: DataService.Data)
	if #d.Equipped == 0 then
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
	end
end

local function crateRoll(player: Player, crate: Config.CrateDef, extraLuck: number): string
	return Rules.Roll(crate.Pool :: any, rarityOrder, PlayerInfo.LuckMultiplier(player) * extraLuck, Config.LuckAffectsFromOrder, rng:NextNumber())
end

-- Opens one crate. `free` = paid by a free-crate token (daily day 7) instead of Ectoplasm.
local function openCrate(player: Player, crateId: any): any
	if type(crateId) ~= "string" then
		return Remotes.Fail("Bad crate")
	end
	local crate = Config.Crates[crateId]
	local d = DataService.Get(player)
	if not crate or not d then
		return Remotes.Fail("Bad crate")
	end
	if not d.Zones[crate.Zone] then
		return Remotes.Fail("Unlock this zone first!")
	end
	local station = Config.Layout.CrateStations[crateId]
	if not station or not Remotes.Near(player, station, STATION_RANGE) then
		return Remotes.Fail("Walk to the crate first!")
	end
	if countOwned(d) >= PlayerInfo.MaxHunters(player) then
		return Remotes.Fail("Hunter storage full! Release some hunters.")
	end
	local usedFree = false
	if (d.FreeCrates[crateId] or 0) > 0 then
		d.FreeCrates[crateId] -= 1
		if d.FreeCrates[crateId] <= 0 then
			d.FreeCrates[crateId] = nil
		end
		usedFree = true
	elseif not DataService.Spend(player, crate.Price) then
		return Remotes.Fail("Not enough Ectoplasm!")
	end
	-- a bought Lucky Open for this crate is used up by this (paid or free) open
	local lucky = (d.LuckyOpens[crateId] or 0) > 0
	if lucky then
		d.LuckyOpens[crateId] -= 1
		if d.LuckyOpens[crateId] <= 0 then
			d.LuckyOpens[crateId] = nil
		end
	end
	local hunterId = crateRoll(player, crate, if lucky then Config.LuckyOpens.Multiplier else 1)
	local uid, isNew = HunterService.Add(player, hunterId)
	d.Stats.Crates += 1
	local def = Config.Hunters[hunterId]
	local rarity = Config.Rarities[def.Rarity]
	if rarity.Announce then
		Fx.AllExcept(player, "Announce", {
			Text = string.format("%s hatched a %s %s!", player.DisplayName, rarity.Name, string.upper(def.Name)),
			Color = def.Rarity,
		})
	end
	DataService.Changed(player)
	return { ok = true, Uid = uid, Hunter = hunterId, IsNew = isNew, Free = usedFree, Crate = crateId, Lucky = lucky }
end

local function validUid(d: DataService.Data, uid: any): boolean
	return type(uid) == "string" and #uid < 20 and d.Hunters[uid] ~= nil
end

function HunterService.Init()
	DataService.AddDecorator(function(player, s)
		s.CrewPower = HunterService.CrewPower(player)
	end)

	-- (crateId, count?): count 3 only with the Triple Open pass; stops early when money or storage
	-- runs out. Returns the first result plus `More` = the extra results.
	Remotes.Register("OpenCrate", "OpenCrate", function(player, crateId, count)
		local n = if count == Config.TripleOpen.Count and PlayerInfo.HasPass(player, Config.TripleOpen.Pass) then count else 1
		local first = openCrate(player, crateId)
		if not first.ok or n == 1 then
			return first
		end
		local more = {}
		for _ = 2, n do
			local r = openCrate(player, crateId)
			if not r.ok then
				break
			end
			table.insert(more, { Uid = r.Uid, Hunter = r.Hunter, IsNew = r.IsNew })
		end
		first.More = more
		return first
	end)

	-- LUCKY OPENS: pay Ectoplasm (crate price x PriceMultiplier) for the next few opens of this
	-- crate at higher luck. Bound to the crate, so cheap crates can't buy luck for expensive ones.
	Remotes.Register("BuyLuckyOpens", "Default", function(player, crateId)
		if type(crateId) ~= "string" then
			return Remotes.Fail("Bad crate")
		end
		local crate = Config.Crates[crateId]
		local d = DataService.Get(player)
		if not crate or not d or not Config.Layout.CrateStations[crateId] then
			return Remotes.Fail("Bad crate")
		end
		if not d.Zones[crate.Zone] then
			return Remotes.Fail("Unlock this zone first!")
		end
		local L = Config.LuckyOpens
		local have = d.LuckyOpens[crateId] or 0
		if have + L.Opens > L.MaxStack then
			return Remotes.Fail("You already have plenty of lucky opens for this crate!")
		end
		if not DataService.Spend(player, crate.Price * L.PriceMultiplier) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.LuckyOpens[crateId] = have + L.Opens
		DataService.Changed(player)
		return { ok = true, Left = d.LuckyOpens[crateId] }
	end)

	-- CRATE SKIP: the reveal is client-side only (the hunter is already rolled and saved), so a
	-- skip never touches the reward. Permanent Crate Skip owners skip for free; otherwise one
	-- bought Single Crate Skip token is used.
	Remotes.Register("UseSkip", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		if PlayerInfo.HasPermanentSkip(player) then
			return { ok = true, Permanent = true }
		end
		if (d.SkipTokens or 0) > 0 then
			d.SkipTokens -= 1
			DataService.Changed(player)
			return { ok = true, Left = d.SkipTokens }
		end
		return { ok = false, err = "NeedSkip" }
	end)

	-- AUTO OPEN (game pass): one server loop per player re-opens the chosen crate through the
	-- normal openCrate checks (zone, distance, price, storage), so it can't bypass anything or
	-- run twice at once. Stops on OFF, failure, leaving, or when the pass is missing.
	Remotes.Register("AutoOpen", "Default", function(player, crateId)
		if crateId == nil or crateId == false then
			autoOpen[player] = nil
			player:SetAttribute("AutoOpen", nil)
			return { ok = true, On = false }
		end
		if not PlayerInfo.HasAutoOpen(player) then
			return Remotes.Fail("NeedPass")
		end
		if type(crateId) ~= "string" or not Config.Crates[crateId] or not Config.Layout.CrateStations[crateId] then
			return Remotes.Fail("Bad crate")
		end
		local token = {}
		autoOpen[player] = token
		player:SetAttribute("AutoOpen", crateId)
		task.spawn(function()
			local waitLeft = (autoNext[player] or 0) - os.clock()
			if waitLeft > 0 then
				task.wait(waitLeft)
			end
			while autoOpen[player] == token and player.Parent do
				local interval = if PlayerInfo.HasPermanentSkip(player) then Config.AutoOpen.FastInterval else Config.AutoOpen.Interval
				autoNext[player] = os.clock() + interval
				local r = openCrate(player, crateId)
				if autoOpen[player] ~= token then
					break
				end
				if not r.ok then
					autoOpen[player] = nil
					player:SetAttribute("AutoOpen", nil)
					Fx.To(player, "AutoOpenStopped", { Reason = r.err })
					break
				end
				Fx.To(player, "AutoOpened", { Crate = crateId, Hunter = r.Hunter, Uid = r.Uid, IsNew = r.IsNew })
				task.wait(interval)
			end
		end)
		return { ok = true, On = true }
	end)

	-- Robux Exclusive Crate (granted by ShopService after a purchase)
	HunterService.GrantExclusive = function(p: Player): (string?, string?, boolean)
		local zone = Config.Zones[PlayerInfo.BestZone(p)]
		local hunterId = zone and Config.Exclusives[zone.Id]
		if not hunterId then
			return nil, nil, false
		end
		local uid, isNew = HunterService.Add(p, hunterId)
		local d = DataService.Get(p)
		if uid and d and d.Hunters[uid] then
			d.Hunters[uid].Locked = true -- paid hunter: protect it from an accidental release
		end
		HunterService.Refresh(p)
		local def = Config.Hunters[hunterId]
		Fx.All("Announce", { Text = string.format("%s got the EXCLUSIVE %s!", p.DisplayName, string.upper(def.Name)), Color = "Exclusive" })
		return uid, hunterId, isNew
	end

	Remotes.Register("Equip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		if table.find(d.Equipped, uid) then
			return { ok = true }
		end
		if #d.Equipped >= PlayerInfo.Slots(player) then
			return Remotes.Fail("All slots full! Unequip one first.")
		end
		table.insert(d.Equipped, uid)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("Unequip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		local i = table.find(d.Equipped, uid)
		if not i then
			return { ok = true }
		end
		if #d.Equipped <= 1 then
			return Remotes.Fail("Keep at least one hunter equipped!")
		end
		table.remove(d.Equipped, i)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("EquipBest", "Inventory", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
		HunterService.Refresh(player)
		return { ok = true, Power = HunterService.CrewPower(player) }
	end)

	Remotes.Register("Lock", "Inventory", function(player, uid, locked)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) or type(locked) ~= "boolean" then
			return Remotes.Fail("Unknown hunter")
		end
		d.Hunters[uid].Locked = locked
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Releases (deletes) unlocked, unequipped hunters for a small refund.
	Remotes.Register("Release", "Inventory", function(player, uids)
		local d = DataService.Get(player)
		if not d or type(uids) ~= "table" or #uids == 0 or #uids > PlayerInfo.MaxHunters(player) then
			return Remotes.Fail("Nothing selected")
		end
		local refund = 0
		local released = 0
		local total = countOwned(d)
		for _, uid in uids do
			if total - released <= 1 then
				break
			end
			if validUid(d, uid) and not table.find(d.Equipped, uid) and not d.Hunters[uid].Locked then
				local def = Config.Hunters[d.Hunters[uid].Id]
				local crate = Config.Crates[(Config.ZoneById[def.Zone] :: Config.ZoneDef).Crate]
				refund += math.floor((if crate then crate.Price else 0) * Config.Inventory.ReleaseRefund)
				d.Hunters[uid] = nil
				released += 1
			end
		end
		if released == 0 then
			return Remotes.Fail("Can't release equipped or locked hunters")
		end
		if refund > 0 then
			DataService.AddEcto(player, refund)
		end
		DataService.Changed(player)
		Fx.Toast(player, string.format("Released %d hunter%s (+%s Ectoplasm)", released, if released == 1 then "" else "s", Format.Commas(refund)))
		return { ok = true, Released = released, Refund = refund }
	end)

	DataService.Loaded:Connect(function(player: Player)
		-- always work on the live profile (never a copy)
		local d = DataService.Get(player)
		if not d then
			return
		end
		if next(d.Hunters) == nil then
			HunterService.Add(player, Config.StarterHunter)
		end
		ensureEquipped(player, d)
		HunterService.Refresh(player)
	end)
end

function HunterService.Start()
	Players.PlayerRemoving:Connect(function(player)
		autoOpen[player] = nil -- stops their Auto Open loop
		autoNext[player] = nil
		PlayerInfo.Forget(player)
	end)
end

return HunterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Fills the spawn TOP GHOST HUNTERS board: every RefreshSeconds it writes each online player's
-- all-time Ectoplasm to an OrderedDataStore and reads the top rows back. Without DataStore
-- access (Studio with API off) it ranks the players in this server instead.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

type Row = { Name: string, Value: number }

local store: OrderedDataStore? = nil
local names: { [number]: string } = {}
local MAX_VALUE = 2 ^ 53

local function nameOf(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local n = if ok and type(name) == "string" then name else "Hunter"
	names[userId] = n
	return n
end

local function valueOf(player: Player): number?
	local d = DataService.Get(player)
	if not d then
		return nil
	end
	return math.clamp(math.floor(d.TotalEcto), 0, MAX_VALUE)
end

local function localRows(): { Row }
	local rows: { Row } = {}
	for _, pl in Players:GetPlayers() do
		local v = valueOf(pl)
		if v then
			table.insert(rows, { Name = pl.Name, Value = v })
		end
	end
	table.sort(rows, function(a: Row, b: Row)
		return a.Value > b.Value
	end)
	return rows
end

local function globalRows(): { Row }?
	local s = store
	if not s then
		return nil
	end
	for _, pl in Players:GetPlayers() do
		local v = valueOf(pl)
		if v and v > 0 then
			names[pl.UserId] = pl.Name
			pcall(function()
				s:SetAsync(tostring(pl.UserId), v)
			end)
		end
	end
	local ok, pages = pcall(function()
		return s:GetSortedAsync(false, Config.Leaderboard.Rows)
	end)
	if not ok or not pages then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local id = tonumber(entry.key)
		if id then
			table.insert(rows, { Name = nameOf(id), Value = tonumber(entry.value) or 0 })
		end
	end
	return rows
end

local function render(rows: { Row })
	local map = workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild("Board", true)
	local gui = board and board:FindFirstChild("BoardGui")
	if not gui then
		return
	end
	for i = 1, Config.Leaderboard.Rows do
		local row = gui:FindFirstChild("Row" .. i)
		if row then
			local r = rows[i]
			local nameLabel = row:FindFirstChild("PlayerName") :: TextLabel?
			local valueLabel = row:FindFirstChild("Value") :: TextLabel?
			if nameLabel then
				-- VIP pass owners who are in this server show in gold with a crown
				local online = r and Players:FindFirstChild(r.Name)
				local vip = online ~= nil and online:IsA("Player") and online:GetAttribute("VIP") == true
				nameLabel.Text = if r then (if vip then "👑 " else "") .. r.Name else "..."
				nameLabel.TextColor3 = if vip then Color3.fromRGB(255, 215, 80) else Color3.fromRGB(255, 255, 255)
			end
			if valueLabel then
				valueLabel.Text = if r then Format.Short(r.Value) else ""
			end
		end
	end
end

local function refresh()
	local rows = globalRows() or localRows()
	render(rows)
end

function LeaderboardService.Init()
	local ok, ds = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Leaderboard.DataStoreName)
	end)
	store = if ok then ds else nil
end

function LeaderboardService.Start()
	task.spawn(function()
		task.wait(8) -- let the first profiles load
		while true do
			local ok, err = pcall(function()
				refresh()
			end)
			if not ok then
				warn("[Leaderboard] " .. tostring(err))
				-- e.g. no API access in Studio: show this server's players
				pcall(function()
					render(localRows())
				end)
			end
			task.wait(Config.Leaderboard.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PlayerInfo</string>
            <string name="Source"><![CDATA[--!strict
-- Derived per-player numbers (slots, multipliers, radius) from data + game passes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)

local PlayerInfo = {}

-- Game passes owned this session (filled by ShopService).
local passes: { [Player]: { [string]: boolean } } = {}

function PlayerInfo.SetPass(player: Player, key: string, owned: boolean)
	passes[player] = passes[player] or {}
	passes[player][key] = owned
end

function PlayerInfo.HasPass(player: Player, key: string): boolean
	local p = passes[player]
	return p ~= nil and p[key] == true
end

-- Global Ectoplasm multiplier (2X ECTOPLASM event, set by GlobalEventService; 1 = off).
local globalEcto = 1
function PlayerInfo.SetGlobalEctoMultiplier(m: number)
	globalEcto = m
end

-- Server-wide luck (Robux product): os.time() expiry, shared by everyone in this server.
local serverLuckUntil = 0

function PlayerInfo.ServerLuckUntil(): number
	return serverLuckUntil
end

function PlayerInfo.AddServerLuck(seconds: number)
	local now = os.time()
	serverLuckUntil = math.min(math.max(serverLuckUntil, now) + seconds, now + Config.ServerLuck.MaxStackSeconds)
end

-- AUTO OPEN pass (or the legacy Auto Attack pass, now that Auto Attack is free)
function PlayerInfo.HasAutoOpen(player: Player): boolean
	return PlayerInfo.HasPass(player, Config.AutoOpen.Pass)
		or (Config.LegacyAutoAttackGrantsAutoOpen and PlayerInfo.HasPass(player, "AutoAttack"))
end

function PlayerInfo.HasPermanentSkip(player: Player): boolean
	return PlayerInfo.HasPass(player, Config.CrateSkip.Pass)
end

function PlayerInfo.Forget(player: Player)
	passes[player] = nil
end

local function passDef(key: string): Config.PassDef?
	for _, p in Config.GamePasses do
		if p.Key == key then
			return p
		end
	end
	return nil
end

function PlayerInfo.Slots(player: Player): number
	local extra = 0
	local def = passDef("ExtraSlots")
	if def and PlayerInfo.HasPass(player, "ExtraSlots") then
		extra = def.Slots or 0
	end
	return Config.Inventory.BaseSlots + extra
end

function PlayerInfo.BoostActive(d: DataService.Data, boost: string): boolean
	local t = d.Boosts[boost]
	return t ~= nil and t > os.time()
end

function PlayerInfo.AddBoost(d: DataService.Data, boost: string, seconds: number)
	local now = os.time()
	local cur = math.max(d.Boosts[boost] or 0, now)
	d.Boosts[boost] = math.min(cur + seconds, now + Config.Boosts.MaxStackSeconds)
end

function PlayerInfo.EctoMultiplier(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 1
	end
	local up = Config.Upgrades.EctoBonus
	local bonus = Rules.UpgradeValue(up.Levels, d.Upgrades.EctoBonus or 1)
	local passMul = 1
	local def = passDef("DoubleEcto")
	if def and PlayerInfo.HasPass(player, "DoubleEcto") then
		passMul = def.Multiplier or 1
	end
	local vip = passDef("VIP")
	if vip and PlayerInfo.HasPass(player, "VIP") then
		passMul *= vip.Multiplier or 1
	end
	-- FinalReward = BaseGhostReward * this (upgrades, boost, passes, global event)
	return Rules.EctoMultiplier(bonus, PlayerInfo.BoostActive(d, "Ecto"), Config.Boosts.Ecto.Multiplier, passMul) * globalEcto
end

function PlayerInfo.LuckMultiplier(player: Player): number
	local d = DataService.Get(player)
	local m = 1
	if d and PlayerInfo.BoostActive(d, "Luck") then
		m *= Config.Boosts.Luck.Multiplier
	end
	local lucky = passDef("LuckyHunter")
	if lucky and PlayerInfo.HasPass(player, "LuckyHunter") then
		m *= lucky.Multiplier or 1
	end
	if serverLuckUntil > os.time() then
		m *= Config.ServerLuck.Multiplier
	end
	return m
end

function PlayerInfo.MaxHunters(player: Player): number
	local def = passDef("Storage")
	if def and PlayerInfo.HasPass(player, "Storage") then
		return Config.Inventory.MaxHunters + (def.Storage or 0)
	end
	return Config.Inventory.MaxHunters
end

function PlayerInfo.PickupRadius(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.PickupRadius or 1 else 1
	local r = Rules.UpgradeValue(Config.Upgrades.PickupRadius.Levels, lv)
	local magnet = passDef("SuperMagnet")
	if magnet and PlayerInfo.HasPass(player, "SuperMagnet") then
		r *= magnet.Multiplier or 1
	end
	return r
end

function PlayerInfo.WalkSpeed(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.MoveSpeed or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.MoveSpeed.Levels, lv)
end

-- Index (1-based) of the furthest unlocked zone, used to scale flat rewards.
function PlayerInfo.BestZone(player: Player): number
	local d = DataService.Get(player)
	local best = 1
	if d then
		for i, z in Config.Zones do
			if d.Zones[z.Id] then
				best = math.max(best, i)
			end
		end
	end
	return best
end

function PlayerInfo.ZoneMultiplier(player: Player): number
	local m = Config.Daily.ZoneMultiplier
	return m[math.min(PlayerInfo.BestZone(player), #m)]
end

function PlayerInfo.Init()
	DataService.AddDecorator(function(player, s)
		s.Slots = PlayerInfo.Slots(player)
		s.EctoMultiplier = PlayerInfo.EctoMultiplier(player)
		s.LuckMultiplier = PlayerInfo.LuckMultiplier(player)
		s.PickupRadius = PlayerInfo.PickupRadius(player)
		s.ZoneMultiplier = PlayerInfo.ZoneMultiplier(player)
		s.MaxHunters = PlayerInfo.MaxHunters(player)
		s.ServerLuckUntil = serverLuckUntil
		local owned = {}
		for _, p in Config.GamePasses do
			owned[p.Key] = PlayerInfo.HasPass(player, p.Key)
		end
		owned[Config.AutoOpen.Pass] = PlayerInfo.HasAutoOpen(player)
		s.Passes = owned
	end)
end

return PlayerInfo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
-- Zone unlocks (+ keeping players out of locked zones), upgrades, daily reward,
-- settings and tutorial progress.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ProgressService = {}

local GATE_RANGE = 40
local TRAVEL_COOLDOWN = 3 -- seconds between Fast Travel jumps
local lastTravel: { [Player]: number } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function applyWalkSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = PlayerInfo.WalkSpeed(player)
	end
end

-- Daily reward grant (also used by Day 7 crate token).
local function grantReward(player: Player, d: DataService.Data, reward: Config.RewardDef): string
	local mult = PlayerInfo.ZoneMultiplier(player)
	if reward.Amount and reward.Amount > 0 then
		DataService.AddEcto(player, reward.Amount * mult)
	end
	if reward.Boost and reward.Seconds then
		PlayerInfo.AddBoost(d, reward.Boost, reward.Seconds)
	end
	if reward.Crate then
		d.FreeCrates[reward.Crate] = (d.FreeCrates[reward.Crate] or 0) + 1
	end
	if reward.Amount and mult > 1 then
		return (reward.Label:gsub(Format.Commas(reward.Amount), Format.Commas(reward.Amount * mult)))
	end
	return reward.Label
end
ProgressService.GrantReward = grantReward

function ProgressService.Init()
	DataService.AddDecorator(function(_player, s)
		local d = s :: any
		local info = Rules.Daily(os.time(), d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		s.DailyInfo = info
	end)

	Remotes.Register("UnlockZone", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if d.Zones[zone.Id] then
			return { ok = true }
		end
		local prev = Config.Zones[zone.Order - 1]
		if prev and not d.Zones[prev.Id] then
			return Remotes.Fail("Unlock " .. prev.Name .. " first!")
		end
		local gate = Config.Layout.Gates[zone.Id]
		if gate and not Remotes.Near(player, Vector3.new(0, 3, gate.Z), GATE_RANGE) then
			return Remotes.Fail("Walk to the gate first!")
		end
		if not DataService.Spend(player, zone.Cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Zones[zone.Id] = true
		DataService.Changed(player)
		Fx.To(player, "ZoneUnlocked", { Zone = zone.Id })
		return { ok = true }
	end)

	-- Fast Travel (WORLDS menu): only to zones this profile owns, onto the zone's arrival pad.
	Remotes.Register("Travel", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if not d.Zones[zone.Id] then
			return Remotes.Fail("Unlock " .. zone.Name .. " first!")
		end
		local now = os.clock()
		if now - (lastTravel[player] or -math.huge) < TRAVEL_COOLDOWN then
			return Remotes.Fail("Wait a moment...")
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = Remotes.Root(player)
		if not char or not hum or hum.Health <= 0 or not root then
			return Remotes.Fail("Can't travel right now")
		end
		local spawnPos = (Config.Layout.ZoneSpawns :: any)[zone.Id] :: Vector3?
		if not spawnPos then
			return Remotes.Fail("Unknown area")
		end
		lastTravel[player] = now
		-- small random offset so a group travelling together doesn't stack
		local a = math.random() * math.pi * 2
		local r = math.random() * 3
		local pos = spawnPos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		root.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)))
		return { ok = true }
	end)

	Remotes.Register("BuyUpgrade", "Default", function(player, upgradeId)
		local d = DataService.Get(player)
		local up = type(upgradeId) == "string" and Config.Upgrades[upgradeId] or nil
		if not d or not up then
			return Remotes.Fail("Unknown upgrade")
		end
		local level = d.Upgrades[up.Id] or 1
		local cost = Rules.UpgradeCost(up.Costs, level)
		if not cost then
			return Remotes.Fail("Already maxed!")
		end
		if not DataService.Spend(player, cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Upgrades[up.Id] = level + 1
		if up.Id == "MoveSpeed" then
			applyWalkSpeed(player)
		end
		DataService.Changed(player)
		return { ok = true, Level = level + 1 }
	end)

	Remotes.Register("ClaimDaily", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		local now = os.time()
		local info = Rules.Daily(now, d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		if not info.CanClaim then
			return Remotes.Fail("Come back in " .. Format.Time(info.Wait))
		end
		local reward = Config.Daily.Rewards[info.Day]
		local streak = if info.Day == 1 then 1 else d.Daily.Streak + 1
		d.Daily.Last = now
		d.Daily.Streak = streak
		local label = grantReward(player, d, reward)
		DataService.Changed(player)
		DataService.Save(player)
		return { ok = true, Day = info.Day, Label = label }
	end)

	Remotes.Register("Setting", "Default", function(player, key, value)
		local d = DataService.Get(player)
		if not d or type(key) ~= "string" or type(value) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		if type((d.Settings :: any)[key]) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		(d.Settings :: any)[key] = value
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Tutorial progress is cosmetic (client-driven guidance); only allow moving forward.
	Remotes.Register("Tutorial", "Default", function(player, step)
		local d = DataService.Get(player)
		if not d or type(step) ~= "number" or step ~= step then
			return Remotes.Fail("Bad step")
		end
		step = math.clamp(math.floor(step), 1, #Config.Tutorial.Steps + 1)
		if step > d.Tutorial then
			d.Tutorial = step
			DataService.Changed(player)
		end
		return { ok = true }
	end)
end

-- Server-side guard: anyone standing in a zone they don't own is moved back to the gate.
local function zoneGuardTick()
	for _, player in Players:GetPlayers() do
		local d = DataService.Get(player)
		local root = Remotes.Root(player)
		if not d or not root then
			continue
		end
		local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
		local zone = Config.Zones[idx]
		if zone and not d.Zones[zone.Id] then
			-- find the furthest owned zone and drop them in front of its exit gate
			local safeZ = Config.Layout.Spawn.Z
			for i = idx - 1, 1, -1 do
				local z = Config.Zones[i]
				if d.Zones[z.Id] then
					local nextZone = Config.Zones[i + 1]
					local gate = nextZone and Config.Layout.Gates[nextZone.Id]
					safeZ = if gate then gate.Z - 12 else z.MinZ + 20
					break
				end
			end
			local char = player.Character
			if char then
				char:PivotTo(CFrame.new(math.clamp(root.Position.X, -10, 10), 4, safeZ))
			end
		end
	end
end

function ProgressService.Start()
	local function setup(player: Player, char: Model)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			applyWalkSpeed(player)
			-- players pass through each other: characters go in their own collision group
			for _, part in char:GetDescendants() do
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end
			char.DescendantAdded:Connect(function(part)
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end)
		end
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			setup(player, char)
		end)
		-- a character that spawned while the world was still building
		if player.Character then
			task.spawn(setup, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(player)
		lastTravel[player] = nil
	end)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	DataService.Loaded:Connect(function(player)
		applyWalkSpeed(player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				zoneGuardTick()
			end)
			if not ok then
				warn("[Zones] guard error: " .. tostring(err))
			end
		end
	end)
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Validated, rate-limited request dispatcher. Clients call
--   Request:InvokeServer(action, ...) -> { ok: boolean, err: string?, ... }
-- Handlers never trust arguments: they type-check everything they receive.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)

local Remotes = {}

type Handler = (Player, ...any) -> any
local handlers: { [string]: { fn: Handler, bucket: string } } = {}
local limiters: { [string]: Rules.Limiter } = {}

local function limiter(bucket: string): Rules.Limiter
	local l = limiters[bucket]
	if not l then
		local def = (Config.RateLimits :: any)[bucket] or Config.RateLimits.Default
		l = Rules.NewLimiter(def.Count, def.Window)
		limiters[bucket] = l
	end
	return l
end

function Remotes.Allow(player: Player, bucket: string): boolean
	return Rules.Allow(limiter(bucket), tostring(player.UserId), os.clock())
end

function Remotes.Register(action: string, bucket: string, fn: Handler)
	assert(not handlers[action], "duplicate action " .. action)
	handlers[action] = { fn = fn, bucket = bucket }
end

function Remotes.Init()
	local rf = Net.Function("Request")
	rf.OnServerInvoke = function(player: Player, action: any, ...: any): any
		if type(action) ~= "string" then
			return { ok = false, err = "Bad request" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, err = "Unknown action" }
		end
		if not Remotes.Allow(player, h.bucket) then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(h.fn, player, ...)
		if not ok then
			warn(string.format("[Remotes] %s from %s errored: %s", action, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		if type(result) ~= "table" then
			return { ok = result == true }
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		local key = tostring(player.UserId)
		for _, l in limiters do
			l.hits[key] = nil
		end
	end)
end

-- Helpers for handlers
function Remotes.Fail(err: string): any
	return { ok = false, err = err }
end

function Remotes.Root(player: Player): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Remotes.Near(player: Player, pos: Vector3, maxDist: number): boolean
	local root = Remotes.Root(player)
	return root ~= nil and (root.Position - pos).Magnitude <= maxDist
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux shop: developer products (Ectoplasm packs, boosts) and game passes.
-- ProcessReceipt is idempotent: receipts are recorded in the profile and saved before
-- returning PurchaseGranted, so a purchase is never lost or granted twice.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)
local EventService = require(script.Parent.EventService)

local ShopService = {}

local function productById(id: number): Config.ProductDef?
	for _, p in Config.Products do
		if p.ProductId == id then
			return p
		end
	end
	return nil
end

local function nextLockedZone(d: DataService.Data): Config.ZoneDef?
	for _, z in Config.Zones do
		if not d.Zones[z.Id] then
			return z
		end
	end
	return nil
end

local function grantProduct(player: Player, d: DataService.Data, p: Config.ProductDef)
	if p.Kind == "Ecto" and p.Amount then
		DataService.AddEcto(player, p.Amount * PlayerInfo.ZoneMultiplier(player))
	elseif p.Kind == "Boost" and p.Boost and p.Seconds then
		PlayerInfo.AddBoost(d, p.Boost, p.Seconds)
	elseif p.Kind == "CrateSkip" then
		-- never cap here: this skip is already paid for (the cap is enforced before prompting)
		d.SkipTokens = (d.SkipTokens or 0) + 1
		Fx.To(player, "SkipGranted", {})
	elseif p.Kind == "SkipArea" then
		local z = nextLockedZone(d)
		if z then
			d.Zones[z.Id] = true
			Fx.To(player, "ZoneUnlocked", { Zone = z.Id })
		else
			-- everything was already open (bought twice quickly): pay out a big Ectoplasm pack instead
			DataService.AddEcto(player, (p.Amount or 0) * PlayerInfo.ZoneMultiplier(player))
		end
	elseif p.Kind == "ExclusiveCrate" then
		local uid, hunterId, isNew = HunterService.GrantExclusive(player)
		if uid and hunterId then
			Fx.To(player, "Exclusive", { Uid = uid, Hunter = hunterId, IsNew = isNew })
		end
	elseif p.Kind == "ServerLuck" and p.Seconds then
		PlayerInfo.AddServerLuck(p.Seconds)
		Fx.All("Announce", { Text = player.DisplayName .. " turned on SERVER LUCK for everyone! 🍀", Color = "Rare" })
		for _, other in Players:GetPlayers() do
			DataService.Changed(other)
		end
	elseif p.Kind == "SummonEvent" then
		Fx.All("Announce", { Text = player.DisplayName .. " summoned the GIANT POLTERGEIST! 👻", Color = "Legendary" })
		EventService.TriggerNow()
	end
	DataService.Changed(player)
	Fx.Toast(player, "Thanks! " .. p.Name .. " added!", "Good")
end

-- Cosmetic / social pass effects that other players can see.
local function applyPassLooks(player: Player)
	player:SetAttribute("VIP", PlayerInfo.HasPass(player, "VIP"))
	player:SetAttribute("RainbowBeams", PlayerInfo.HasPass(player, "RainbowBeams"))
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local old = root:FindFirstChild("GHSparkleTrail")
	if PlayerInfo.HasPass(player, "SparkleTrail") and not old then
		local a0 = Instance.new("Attachment")
		a0.Name = "GHTrailA"
		a0.Position = Vector3.new(0, 0.6, 0.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "GHTrailB"
		a1.Position = Vector3.new(0, -1.6, 0.4)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "GHSparkleTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.6
		t.LightEmission = 0.6
		t.FaceCamera = true
		t.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 220)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 240, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 255, 140)),
		})
		t.Transparency = NumberSequence.new(0.2, 1)
		t.Parent = root
	end
	-- VIP tag over the head
	local head = (char :: Model):FindFirstChild("Head")
	if head and PlayerInfo.HasPass(player, "VIP") and not head:FindFirstChild("GHVipTag") then
		local bb = Instance.new("BillboardGui")
		bb.Name = "GHVipTag"
		bb.Size = UDim2.fromOffset(60, 20)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.MaxDistance = 70
		bb.LightInfluence = 0
		bb.Parent = head
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Text = "👑 VIP"
		l.Font = Enum.Font.FredokaOne
		l.TextSize = 16
		l.TextColor3 = Color3.fromRGB(255, 215, 80)
		l.TextStrokeTransparency = 0.3
		l.Parent = bb
	end
end
ShopService.ApplyPassLooks = applyPassLooks

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = DataService.WaitFor(player, 20)
	if not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipt = tostring(info.PurchaseId)
	if DataService.HasPurchase(d, receipt) then
		-- already granted in this session; only confirm once it is really saved
		return if DataService.SaveNow(player)
			then Enum.ProductPurchaseDecision.PurchaseGranted
			else Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = productById(info.ProductId)
	if not p then
		warn("[Shop] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(player, d, p)
	DataService.AddPurchase(d, receipt)
	if not DataService.SaveNow(player) then
		-- Roblox will retry the receipt later; our record prevents a double grant in this session
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.PassId then
			local ok, owned = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.PassId :: number)
			end)
			if not player.Parent then
				return -- left while we were asking Roblox
			end
			PlayerInfo.SetPass(player, pass.Key, ok and owned == true)
		end
	end
	applyPassLooks(player)
	HunterService.Refresh(player)
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.PassId == passId then
				PlayerInfo.SetPass(player, pass.Key, true)
				applyPassLooks(player)
				HunterService.Refresh(player)
				Fx.Toast(player, "Thanks! " .. pass.Name .. " unlocked!", "Good")
			end
		end
	end)

	-- Client asks to buy: server validates the key and prompts (ids never come from the client).
	Remotes.Register("Buy", "Default", function(player, key)
		if type(key) ~= "string" then
			return Remotes.Fail("Bad item")
		end
		for _, p in Config.Products do
			if p.Key == key then
				if not p.ProductId then
					return Remotes.Fail("Coming soon!")
				end
				local d = DataService.Get(player)
				if p.Kind == "CrateSkip" and PlayerInfo.HasPermanentSkip(player) then
					return Remotes.Fail("You already have Permanent Crate Skip!")
				end
				if p.Kind == "CrateSkip" and d and (d.SkipTokens or 0) >= Config.CrateSkip.MaxTokens then
					return Remotes.Fail("You already have the most skips you can hold!")
				end
				if p.Kind == "SkipArea" and d and not nextLockedZone(d) then
					return Remotes.Fail("Every area is already unlocked!")
				end
				if p.Kind == "ExclusiveCrate" and d then
					local count = 0
					for _ in d.Hunters do
						count += 1
					end
					if count >= PlayerInfo.MaxHunters(player) then
						return Remotes.Fail("Hunter storage full! Release some hunters first.")
					end
				end
				if p.Kind == "ServerLuck" and PlayerInfo.ServerLuckUntil() - os.time() + (p.Seconds or 0) > Config.ServerLuck.MaxStackSeconds then
					return Remotes.Fail("Server luck is already maxed!")
				end
				if p.Kind == "SummonEvent" and EventService.IsBusy() then
					return Remotes.Fail("The Giant Poltergeist is already here!")
				end
				if p.Kind == "Boost" and p.Boost and p.Seconds then
					-- boosts stack up to a cap; don't sell time that would be thrown away
					local left = if d then (d.Boosts[p.Boost] or 0) - os.time() else 0
					if left + p.Seconds > Config.Boosts.MaxStackSeconds then
						return Remotes.Fail("That boost is already stacked to the max!")
					end
				end
				MarketplaceService:PromptProductPurchase(player, p.ProductId)
				return { ok = true }
			end
		end
		for _, pass in Config.GamePasses do
			if pass.Key == key then
				if not pass.PassId then
					return Remotes.Fail("Coming soon!")
				end
				if PlayerInfo.HasPass(player, pass.Key) then
					return Remotes.Fail("You already own this!")
				end
				if pass.Key == Config.AutoOpen.Pass and PlayerInfo.HasAutoOpen(player) then
					return Remotes.Fail("You already have Auto Open!")
				end
				if pass.Hidden then
					return Remotes.Fail("This isn't sold anymore")
				end
				MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
				return { ok = true }
			end
		end
		return Remotes.Fail("Bad item")
	end)

	DataService.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
	-- trail / VIP tag again after every respawn
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart", 10)
			char:WaitForChild("Head", 10)
			applyPassLooks(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
end

function ShopService.Start() end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">StationService</string>
            <string name="Source"><![CDATA[--!strict
-- Dresses the stations the world builder made: crate display models, odds boards and
-- ProximityPrompts (crates, upgrades, gates). Prompts only open client UI; every purchase
-- goes through validated Requests.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local CrateRig = require(GH.Rigs.CrateRig)

local StationService = {}

local function find(path: { string }): Instance?
	local cur: Instance? = workspace
	for _, name in path do
		cur = cur and cur:FindFirstChild(name)
	end
	return cur
end

local function prompt(parent: Instance, action: string, object: string, attrs: { [string]: any }): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "GHPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonY
	p.Style = Enum.ProximityPromptStyle.Default
	for k, v in attrs do
		p:SetAttribute(k, v)
	end
	p.Parent = parent
	return p
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(25, 10, 45)
	stroke.Parent = t
	t.Parent = parent
	return t
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function buildOddsBoard(board: BasePart, crate: Config.CrateDef)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Odds"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 1.15
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(70, 40, 120), Color3.fromRGB(25, 15, 45))
	grad.Rotation = 90
	grad.Parent = bg
	label(bg, crate.Name, UDim2.fromScale(0.94, 0.13), UDim2.fromScale(0.03, 0.03), crate.Trim)
	label(bg, Format.Short(crate.Price) .. " ECTOPLASM", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.1, 0.17), Color3.fromRGB(150, 255, 150))
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, 1, Config.LuckAffectsFromOrder)
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local row = Instance.new("Frame")
		row.Size = UDim2.fromScale(0.92, 0.155)
		row.Position = UDim2.fromScale(0.04, 0.29 + (i - 1) * 0.175)
		row.BackgroundColor3 = rar.Color
		row.BackgroundTransparency = 0.15
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = row
		local g2 = Instance.new("UIGradient")
		g2.Color = ColorSequence.new(rar.Color, rar.Color2)
		g2.Parent = row
		row.Parent = bg
		label(row, string.upper(def.Name), UDim2.fromScale(0.55, 0.55), UDim2.fromScale(0.03, 0.05), Color3.new(1, 1, 1))
		label(row, rar.Name .. "  ·  ⚡" .. Format.Commas(def.Power), UDim2.fromScale(0.55, 0.38), UDim2.fromScale(0.03, 0.58), Color3.fromRGB(255, 255, 230))
		label(row, Format.Percent(odds[e.Hunter]), UDim2.fromScale(0.35, 0.8), UDim2.fromScale(0.62, 0.1), Color3.new(1, 1, 1))
	end
	gui.Parent = board
end

function StationService.Init() end

function StationService.Start()
	for crateId, crate in Config.Crates do
		if not Config.Layout.CrateStations[crateId] then
			continue -- no station (Exclusive Crate is Robux-only)
		end
		local station = find({ "Map", "Stations", "CrateStation_" .. crateId })
		if not station then
			warn("[Stations] missing CrateStation_" .. crateId)
			continue
		end
		local slot = station:FindFirstChild("DisplaySlot") :: BasePart?
		if slot then
			local rig = CrateRig.Build(crateId)
			rig.Model.Name = "DisplayCrate"
			rig.Model:ScaleTo(1.3)
			rig.Model:PivotTo(CFrame.new(slot.Position - Vector3.new(0, 1.6, 0)))
			rig.Model.Parent = station
			CollectionService:AddTag(rig.Base, "SpinProp")
		end
		local board = station:FindFirstChild("OddsBoard") :: BasePart?
		if board then
			buildOddsBoard(board, crate)
		end
		local anchor = station:FindFirstChild("PromptAnchor")
		if anchor then
			prompt(anchor, "Open Crate", crate.Name .. " · " .. Format.Commas(crate.Price), { Crate = crateId })
		end
	end
	local up = find({ "Map", "Stations", "UpgradeStation", "PromptAnchor" })
	if up then
		prompt(up, "Upgrades", "Upgrade Station", { Station = "Upgrades" })
	end
	for _, zone in Config.Zones do
		local anchor = find({ "Map", "Gates", "Gate_" .. zone.Id, "PromptAnchor" })
		if anchor then
			prompt(anchor, "Unlock", zone.Name .. " · " .. Format.Commas(zone.Cost), { Zone = zone.Id })
		end
	end
end

return StationService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!strict
-- Giant Ghost event arena (workspace.Map.EventArena): a flat rune circle that stays clear
-- (nothing above 0.3 studs inside the radius, nothing in the air up to Y=40), with pumpkin
-- spectators, bleachers on the north/south edges and an entrance sign over the cross street.
-- The rune circle is painted in solid candy colours; only the lamps, the small rim lights
-- and the rim jack-o'-lanterns glow.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Arena = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local function ring(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.4
	local paint = Kit.Vivid(color)
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.1, cz + math.sin(a) * r)
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Kit.Part(parent, V(w, 0.2, segLen), CFrame.lookAt(p, p + tangent), paint)
	end
end

local function bleachers(parent: Instance, cx: number, z0: number, outward: number)
	-- 3 steps rising away from the arena; outward = +1 (north) or -1 (south)
	local cols = { C(160, 90, 255), C(255, 150, 60), C(110, 230, 160) }
	for i = 0, 2 do
		local zA = z0 + outward * (i * 3.5)
		local zB = z0 + outward * 11
		Kit.Box(parent, V(cx - 14, 0, zA), V(cx + 14, 1.6 * (i + 1), zB), cols[i + 1], { Mat = Enum.Material.WoodPlanks, Solid = true })
	end
	-- pumpkin audience on the steps
	for i = 0, 2 do
		for k = -2, 2 do
			if (i + k) % 2 == 0 then
				local z = z0 + outward * (i * 3.5 + 1.75)
				Props.Pumpkin(parent, V(cx + k * 5, 1.6 * (i + 1), z), 2.6, 0, -outward)
			end
		end
	end
	Kit.AddRect(cx - 15, z0, cx + 15, z0 + outward * 12)
end

function Arena.Build(map: Instance)
	local ea = Config.Layout.EventArena
	local cx, cz, r = ea.Center.X, ea.Center.Z, ea.Radius
	local m = Kit.Model(map, "EventArena")

	-- Field (flat, top 0.12)
	local field = Kit.Disc(m, cx, cz, 0.12, r * 2 + 4, 0.4, C(90, 60, 140), { Mat = Enum.Material.Slate, Solid = true, Name = "Field" })
	Kit.Disc(m, cx, cz, 0.16, r * 2 - 6, 0.1, C(120, 80, 190), { Solid = true })
	ring(m, cx, cz, r, 36, 1.4, C(150, 255, 120), 0.32)
	ring(m, cx, cz, r * 0.62, 24, 0.9, C(255, 110, 220), 0.3)
	Kit.Disc(m, cx, cz, 0.3, 10, 0.12, Kit.Vivid(C(150, 255, 160)))
	-- rune spokes and a star
	local spoke, dot = Kit.Vivid(C(190, 120, 255)), Kit.Vivid(C(255, 230, 90))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local p1 = V(cx + math.cos(a) * r * 0.62, 0.25, cz + math.sin(a) * r * 0.62)
		local a2 = a + math.pi * 2 / 6 * 2
		local p2 = V(cx + math.cos(a2) * r * 0.62, 0.25, cz + math.sin(a2) * r * 0.62)
		Props.Beam(m, p1, p2, 0.6, 0.12, spoke)
		local outer = V(cx + math.cos(a) * (r - 3), 0.25, cz + math.sin(a) * (r - 3))
		Kit.Disc(m, outer.X, outer.Z, 0.3, 3, 0.12, dot)
	end

	-- Edge decorations (outside the radius)
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local px, pz = cx + math.cos(a) * (r + 3.5), cz + math.sin(a) * (r + 3.5)
		if math.abs(px) < 134 and not (px < cx and pz > cz - 10 and pz < cz + 26) then
			if i % 2 == 0 then
				Props.Pumpkin(m, V(px, 0, pz), 3.4, cx - px, cz - pz, true)
			else
				Kit.Box(m, V(px - 0.6, 0, pz - 0.6), V(px + 0.6, 4, pz + 0.6), C(60, 40, 90), { Mat = Enum.Material.Metal })
				Kit.Ball(m, 2, V(px, 5, pz), C(150, 255, 140), { Mat = NEON })
			end
		end
	end
	bleachers(m, cx, cz + r + 4, 1)
	bleachers(m, cx, cz - r - 4, -1)

	-- Entrance arch over the cross street on the west side, sign facing -X (toward the road)
	local ax = cx - r - 5
	for _, sz in { -1, 1 } do
		local pz = cz + 7 + sz * 13
		Kit.Box(m, V(ax - 1.2, 0, pz - 1.2), V(ax + 1.2, 22, pz + 1.2), C(110, 70, 200), { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(m, 3, V(ax, 23, pz), Kit.Vivid(C(255, 150, 60)))
	end
	local signCF = CFrame.new(ax, 19, cz + 7) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local sign = Kit.Part(m, V(24, 5, 0.8), signCF, C(45, 25, 80))
	Kit.Part(m, V(25, 6, 0.4), signCF * CFrame.new(0, 0, 0.5), Kit.Vivid(C(255, 110, 220)))
	Kit.Sign(sign, Enum.NormalId.Front, "👻 GIANT GHOST EVENT 👻", C(255, 230, 90))
	-- second sign facing into the arena from the east wall side
	local sign2CF = CFrame.new(cx + r + 4, 9, cz) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local s2 = Kit.Part(m, V(16, 5, 0.6), sign2CF, C(45, 25, 80))
	Kit.Part(m, V(17, 6, 0.3), sign2CF * CFrame.new(0, 0, 0.4), Kit.Vivid(C(150, 255, 120)))
	Kit.Box(m, V(cx + r + 4.6, 0, cz - 0.5), V(cx + r + 5.6, 7, cz + 0.5), C(60, 40, 90))
	Kit.Sign(s2, Enum.NormalId.Front, "GIANT GHOST EVENT", C(150, 255, 140))

	-- lights on two tall poles at the edge
	for _, sz in { -1, 1 } do
		local p = V(cx + r * 0.75, 0, cz + sz * (r + 9))
		Kit.Cyl(m, 26, 1, CFrame.new(p + V(0, 13, 0)), C(60, 40, 90), { Mat = Enum.Material.Metal })
		local lamp = Kit.Ball(m, 3, p + V(0, 27, 0), C(255, 160, 230), { Mat = NEON })
		Kit.Light(lamp, C(255, 170, 230), 40, 1.4)
	end
	-- low, faint haze (a big bright cloud here washed out the rune circle)
	local haze = Kit.Emitter(field, C(200, 140, 255), 1.5, 6, 0.3)
	if haze then
		haze.LightEmission = 0.25
	end

	Kit.AddCircle(cx, cz, r + 6)
	m.PrimaryPart = field
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Boundary</string>
            <string name="Source"><![CDATA[--!strict
-- Ground slabs (top at Y=0), themed outer walls, the two zone-separation walls and the
-- invisible collision walls up to Y=80 that keep players inside and in front of locked gates.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Boundary = {}

local C = Color3.fromRGB
local V = Vector3.new
local INVIS_TOP = 80
local HW = Config.Layout.HalfWidth -- 140
local END = Config.Zones[#Config.Zones].MaxZ -- far end of the map

-- Zone-separation wall look per gate (wall / cap stone / cap ball / painted band).
type WallLook = { Wall: Color3, Cap: Color3, Ball: Color3, Band: Color3, Pumpkins: boolean }
local WALLS: { [string]: WallLook } = {
	Cemetery = { Wall = C(135, 115, 175), Cap = C(185, 170, 220), Ball = C(255, 160, 60), Band = C(150, 255, 120), Pumpkins = true },
	School = { Wall = C(215, 110, 95), Cap = C(250, 230, 210), Ball = C(200, 130, 255), Band = C(200, 120, 255), Pumpkins = true },
	Carnival = { Wall = C(230, 70, 80), Cap = C(255, 240, 215), Ball = C(255, 205, 60), Band = C(70, 140, 255), Pumpkins = false },
	Hospital = { Wall = C(225, 230, 238), Cap = C(150, 200, 235), Ball = C(140, 220, 180), Band = C(110, 190, 255), Pumpkins = false },
	Harbor = { Wall = C(120, 85, 55), Cap = C(70, 110, 150), Ball = C(220, 80, 70), Band = C(60, 200, 200), Pumpkins = false },
	Castle = { Wall = C(140, 140, 155), Cap = C(95, 95, 115), Ball = C(255, 200, 70), Band = C(150, 40, 70), Pumpkins = false },
	SpiritRealm = { Wall = C(60, 50, 95), Cap = C(90, 80, 140), Ball = C(110, 230, 255), Band = C(170, 100, 255), Pumpkins = false },
	Swamp = { Wall = C(90, 110, 70), Cap = C(120, 95, 65), Ball = C(170, 255, 120), Band = C(150, 230, 90), Pumpkins = false },
	Frost = { Wall = C(200, 225, 245), Cap = C(150, 190, 230), Ball = C(170, 240, 255), Band = C(110, 190, 255), Pumpkins = false },
	Tomb = { Wall = C(220, 185, 120), Cap = C(190, 150, 90), Ball = C(70, 200, 220), Band = C(255, 210, 90), Pumpkins = false },
	ToyFactory = { Wall = C(255, 150, 190), Cap = C(255, 225, 90), Ball = C(90, 180, 255), Band = C(150, 90, 230), Pumpkins = false },
	Sunken = { Wall = C(80, 140, 160), Cap = C(200, 190, 150), Ball = C(255, 220, 120), Band = C(90, 255, 230), Pumpkins = false },
	Clockwork = { Wall = C(150, 110, 75), Cap = C(200, 170, 110), Ball = C(230, 200, 120), Band = C(120, 90, 60), Pumpkins = false },
	Inferno = { Wall = C(80, 50, 50), Cap = C(110, 70, 60), Ball = C(255, 150, 60), Band = C(255, 110, 50), Pumpkins = false },
	Throne = { Wall = C(240, 235, 255), Cap = C(200, 180, 240), Ball = C(255, 215, 90), Band = C(150, 100, 230), Pumpkins = false },
}

local invisible: (Instance, Vector3, Vector3) -> ()
function invisible(parent: Instance, a: Vector3, b: Vector3)
	-- Roblox caps a part at 2048 studs per axis: split long walls along Z into pieces
	local lo, hi = a:Min(b), a:Max(b)
	if hi.Z - lo.Z > 1000 then
		local n = math.ceil((hi.Z - lo.Z) / 1000)
		local step = (hi.Z - lo.Z) / n
		for i = 0, n - 1 do
			invisible(parent, Vector3.new(lo.X, lo.Y, lo.Z + i * step), Vector3.new(hi.X, hi.Y, lo.Z + (i + 1) * step))
		end
		return
	end
	local p = Kit.Box(parent, a, b, C(255, 255, 255), { Transp = 1, Solid = true, Name = "InvisibleWall", Shadow = false })
	p.CanQuery = false -- never block taps / ground raycasts
end

local function hedgeRun(f: Instance, a: Vector3, b: Vector3)
	-- a/b: opposite corners of the hedge box (Y 0..14)
	Kit.Box(f, a, b, C(70, 160, 85), { Mat = Enum.Material.Grass, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / 16)
	local greens = { C(80, 175, 90), C(95, 190, 100), C(70, 150, 95) }
	for i = 0, n do
		local t = (i + 0.5) / (n + 1)
		local pos = if alongX
			then V(lo.X + (hi.X - lo.X) * t, hi.Y, (lo.Z + hi.Z) / 2)
			else V((lo.X + hi.X) / 2, hi.Y, lo.Z + (hi.Z - lo.Z) * t)
		Kit.Ball(f, 7.5, pos, Kit.Pick(greens), { Mat = Enum.Material.Grass })
	end
end

local function stoneRun(f: Instance, a: Vector3, b: Vector3, wall: Color3, cap: Color3, topBall: Color3, spacing: number)
	Kit.Box(f, a, b, wall, { Mat = Enum.Material.Cobblestone, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	Kit.Box(f, V(lo.X - 0.5, hi.Y, lo.Z - 0.5), V(hi.X + 0.5, hi.Y + 1.2, hi.Z + 0.5), cap, { Mat = Enum.Material.Slate })
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / spacing)
	local ball = Kit.Vivid(topBall)
	for i = 0, n do
		local t = i / math.max(n, 1)
		local cx = if alongX then lo.X + (hi.X - lo.X) * t else (lo.X + hi.X) / 2
		local cz = if alongX then (lo.Z + hi.Z) / 2 else lo.Z + (hi.Z - lo.Z) * t
		local half = if alongX then V(2.5, 0, (hi.Z - lo.Z) / 2 + 1) else V((hi.X - lo.X) / 2 + 1, 0, 2.5)
		Kit.Box(f, V(cx, 0, cz) - half, V(cx, hi.Y + 3, cz) + half, cap, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(f, 2.6, V(cx, hi.Y + 4.3, cz), ball) -- candy-coloured cap ball (solid, not glowing)
	end
end

local function brickRun(f: Instance, a: Vector3, b: Vector3, spacing: number)
	stoneRun(f, a, b, C(215, 110, 95), C(250, 230, 210), C(200, 130, 255), spacing)
end

function Boundary.Build(map: Instance)
	local f = Kit.Folder(map, "Boundary")
	local W = HW + 6 -- outer face of the visible walls

	-- Ground (top surface Y = 0), wider than the play area so the walls sit on grass.
	Kit.Box(f, V(-190, -4, -100), V(190, 0, 260), C(105, 195, 100), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Neighborhood" })
	Kit.Box(f, V(-190, -4, 260), V(190, 0, 540), C(80, 160, 120), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Cemetery" })
	Kit.Box(f, V(-190, -4, 540), V(190, 0, 880), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_School" })

	-- Neighborhood: hedges (sides + behind spawn)
	hedgeRun(f, V(-W, 0, -66), V(-HW, 14, 260))
	hedgeRun(f, V(HW, 0, -66), V(W, 14, 260))
	hedgeRun(f, V(-W, 0, -66), V(W, 14, -60))
	-- Cemetery: mossy stone with mint cap balls
	stoneRun(f, V(-W, 0, 263), V(-HW, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	stoneRun(f, V(HW, 0, 263), V(W, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	-- School: brick with purple tops (sides + far end)
	brickRun(f, V(-W, 0, 543), V(-HW, 14, 877), 30)
	brickRun(f, V(HW, 0, 543), V(W, 14, 877), 30)
	-- Zones 4-8 build their own ground, side walls and outside scenery (see their builders).

	-- Zone separation walls with the gate opening centred on X = 0.
	for id, gate in Kit.Gates(Config.Layout) do
		local z = gate.Z
		local half = gate.Width / 2
		local h = 18
		local look = WALLS[id] or WALLS.School
		for _, s in { -1, 1 } do
			stoneRun(f, V(s * (half + 8), 0, z - 3), V(s * W, h, z + 3), look.Wall, look.Cap, look.Ball, 24)
		end
		-- painted band along the wall faces
		local band = Kit.Vivid(look.Band)
		for _, s in { -1, 1 } do
			for _, fz in { -1, 1 } do
				Kit.Box(f, V(s * (half + 6), 3, z + fz * 3.05), V(s * (W - 1), 3.6, z + fz * 3.25), band)
			end
			invisible(f, V(s * half, 0, z - 3), V(s * W, INVIS_TOP, z + 3))
		end
		-- above the arch beam (beam fills Y 30..36 of the opening)
		invisible(f, V(-half, 36, z - 3), V(half, INVIS_TOP, z + 3))
		-- pumpkins along the wall top on the approach side (the spooky-town zones only)
		for i = 1, if look.Pumpkins then 4 else 0 do
			for _, s in { -1, 1 } do
				local x = s * (half + 12 + i * 26)
				Props.Pumpkin(f, V(x, h + 1.2, z - 1.5), 3.6, 0, -1)
			end
		end
	end

	-- Invisible outer walls (play area is |X| <= 140, Z -60..END)
	invisible(f, V(-W, 0, -66), V(-HW, INVIS_TOP, END + 6))
	invisible(f, V(HW, 0, -66), V(W, INVIS_TOP, END + 6))
	invisible(f, V(-W, 0, -66), V(W, INVIS_TOP, -60))
	invisible(f, V(-W, 0, END), V(W, INVIS_TOP, END + 6))

	-- Outer scenery: soft purple hills and big trees just beyond the walls.
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i = 0, 9 do -- zones 1-3 (Z < 880)
		local z = -40 + i * 95
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 185, -12, z + s * 20), Kit.Pick(hill), { Mat = Enum.Material.Grass })
		end
	end
	for i = 0, 6 do
		local z = -30 + i * 140
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 156, 0, z), 22 + Kit.Rng:NextNumber(0, 10))
		end
	end
end

return Boundary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GHOST HUNTER SIMULATOR: procedural world builder. Call Builder.Build() once at server start.

	Layout (studs, +Z forward; ground top is Y = 0 everywhere walkable; play area |X| <= 140):

	  Z -60 ........ hedge wall behind spawn
	  Z -60..-36     Ghost Hunter HQ building (behind spawn)
	  Z   0          Spawn plaza (SpawnLocation at Config.Layout.Spawn, faces +Z)
	  Z  28          Beginner crate station (X -28, beacon) | Upgrade booth (X +28)
	  Z -36..260     ZONE 1 NEIGHBORHOOD: main road X -10..10 up to the gate, cross street
	                 Z 110..124 east to the Event Arena (95, 110, r32); houses on a 30-stud grid
	                 wherever ghost areas / roads / stations leave room.
	  Z 260          Stone wall + Gate_Cemetery (34-wide opening at X = 0)
	  Z 260..540     ZONE 2 CEMETERY: cobble path X -8..8, Haunted station (X -28, Z 292),
	                 giant mausoleum (X -122..-78, Z 477..513, spire to Y ~66), crypts, graves.
	  Z 540          Brick wall + Gate_School
	  Z 540..600     School courtyard: Elite station (X -28, Z 572), ghost bus, flagpole.
	  Z 600..860     ZONE 3 SCHOOL building (open-topped, see School.luau), clock tower to Y ~104.
	  Z 880          Gate_Carnival
	  Z 880..1220    ZONE 4 ABANDONED CARNIVAL (Carnival.luau)
	  Z 1220..1560   ZONE 5 HAUNTED HOSPITAL (Hospital.luau)
	  Z 1560..1920   ZONE 6 GHOST SHIP HARBOR (Harbor.luau)
	  Z 1920..2280   ZONE 7 CURSED CASTLE (Castle.luau)
	  Z 2280..2680   ZONE 8 SPIRIT REALM (SpiritRealm.luau)
	  Z 2680..5560   ZONES 9-16, 360 each: Swamp, Frost, Tomb, ToyFactory, Sunken, Clockwork,
	                 Inferno, Throne (one file each); far wall at the last zone's MaxZ.
	  Every zone from the Cemetery on: gate wall at its MinZ (Boundary + Gates), crate station at
	  (-28, MinZ + 32), Fast Travel arrival pad at Config.Layout.ZoneSpawns (kept free), main path
	  along X = 0 to the next gate.

	Every ghost area circle from Config.Layout.GhostAreas is registered as a keep-out, so no
	prop taller than ~0.3 studs is placed inside one (flat road paint / cracks / rune lines only).
	Instance tree:
	  workspace.Map.{Boundary, Gates, Stations, EventArena, Neighborhood, Cemetery, School, Carnival,
	                 Hospital, Harbor, Castle, SpiritRealm}
]]

local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local LightingSetup = require(script.Parent.Lighting)
local Boundary = require(script.Parent.Boundary)
local Gates = require(script.Parent.Gates)
local Stations = require(script.Parent.Stations)
local Leaderboard = require(script.Parent.Leaderboard)
local Arena = require(script.Parent.Arena)
local Neighborhood = require(script.Parent.Neighborhood)
local Cemetery = require(script.Parent.Cemetery)
local School = require(script.Parent.School)
local Carnival = require(script.Parent.Carnival)
local Hospital = require(script.Parent.Hospital)
local Harbor = require(script.Parent.Harbor)
local Castle = require(script.Parent.Castle)
local SpiritRealm = require(script.Parent.SpiritRealm)
local Swamp = require(script.Parent.Swamp)
local Frost = require(script.Parent.Frost)
local Tomb = require(script.Parent.Tomb)
local ToyFactory = require(script.Parent.ToyFactory)
local Sunken = require(script.Parent.Sunken)
local Clockwork = require(script.Parent.Clockwork)
local Inferno = require(script.Parent.Inferno)
local Throne = require(script.Parent.Throne)

local Builder = {}

local function registerKeepOuts()
	for _, area in Config.Layout.GhostAreas do
		Kit.AddCircle(area.Center.X, area.Center.Z, area.Radius + 1)
	end
	local spawnPos = Config.Layout.Spawn
	Kit.AddCircle(spawnPos.X, spawnPos.Z, 27)
	for _, gate in Kit.Gates(Config.Layout) do
		Kit.AddRect(-30, gate.Z - 24, 30, gate.Z + 24)
	end
	-- Fast Travel arrival pads
	for _, p in Kit.ZoneSpawns(Config.Layout) do
		Kit.AddCircle(p.X, p.Z, 9)
	end
	-- main path along X = 0 through zones 4-8 (zones 1-3 register their own roads)
	Kit.AddRect(-10, 880, 10, Config.Zones[#Config.Zones].MaxZ, true)
end

function Builder.Build()
	local old = Workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	Kit.Reset()
	registerKeepOuts()

	local map: Folder = Instance.new("Folder")
	map.Name = "Map"

	LightingSetup.Apply()
	Boundary.Build(map)
	Gates.Build(map)
	Stations.Build(map)
	Leaderboard.Build(map)
	Arena.Build(map)
	Neighborhood.Build(map)
	Cemetery.Build(map)
	School.Build(map)
	Carnival.Build(map)
	Hospital.Build(map)
	Harbor.Build(map)
	Castle.Build(map)
	SpiritRealm.Build(map)
	Swamp.Build(map)
	Frost.Build(map)
	Tomb.Build(map)
	ToyFactory.Build(map)
	Sunken.Build(map)
	Clockwork.Build(map)
	Inferno.Build(map)
	Throne.Build(map)

	map.Parent = Workspace
	local s = Kit.Stats
	print(string.format("[GH World] built %d parts (%d neon), %d lights, %d emitters, %d floating, %d flicker", s.Parts, s.Neon, s.Lights, s.Emitters, s.Floating, s.Flicker))
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Carnival</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 4: Abandoned Carnival (Z 880..1220). Bright, candy-striped and only a little spooky.
--   Ground + boardwalk midway along X = 0 (flat paint), painted sawdust rings on the ghost areas
--   ((0,965) r30, (-82,1000) r24, (75,1055) r26, (-62,1115) r24, boss ring (0,1165) r22).
--   Entrance arch at Z 926 (pillars X ±13..19, beam Y 30..38) with two ticket booths.
--   Game stalls along the east side (X 52, Z 948..1006) and one west (X -48, Z 1062),
--   popcorn cart, balloon cart, high striker, prize booth with giant plushies (X ~-96, Z 1058).
--   String lights over the midway between the first ghost area and the boss ring (Z 1005..1130).
--   Landmarks seen from the School: ferris wheel (100, 1182, top ~Y 82), big top (-100, 1180,
--   top ~Y 52) and the carousel (78, 1125).
--   Side walls: red/cream board fence along X ±140..146 with blue posts; outside: hills, a
--   wooden roller coaster and two far tents.
-- Glow is kept to a few bulbs (arch, wheel, carousel, string lights), two lanterns, the striker
-- bell and small purple ectoplasm puddles; everything else is painted wood, fabric and plastic.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Carnival = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.WoodPlanks
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal

local MIN_Z, MAX_Z = 880, 1220
local RED = C(225, 60, 70)
local CREAM = C(255, 240, 215)
local YELLOW = C(255, 205, 60)
local BLUE = C(70, 140, 235)
local PURPLE = C(165, 100, 235)
local PINK = C(255, 140, 190)
local MINT = C(120, 220, 150)
local DARK = C(60, 35, 90)
local ECTO = C(200, 130, 255)
local BULB = C(255, 225, 130)
local WOODC = C(190, 135, 90)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

-- Straight bar between two points in the X/Y plane (wheel rims, spokes, legs).
local function bar(parent: Instance, a: Vector3, b: Vector3, w: number, color: Color3, opts: Kit.Opts?): Part
	local mid = (a + b) / 2
	return Kit.Part(parent, V(w, w, (b - a).Magnitude), CFrame.lookAt(mid, b, V(0, 0, 1)), color, opts)
end

local function glowOpts(glow: boolean): Kit.Opts?
	return if glow then { Mat = NEON } else nil
end

--==================================================================
-- GROUND, WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	-- Same grass as the School slab, which also covers Z 880..920 (no colour flicker there).
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Carnival" })
	-- boardwalk midway with red edges (flat paint)
	Kit.Box(f, V(-9, 0, MIN_Z), V(9, 0.05, MAX_Z), C(220, 170, 120), { Mat = WOOD, Name = "Midway" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, MIN_Z), V(s * 10, 0.06, MAX_Z), Kit.Vivid(RED))
	end
	-- sawdust rings on the ghost areas (flat; ghosts float above them)
	local sawdust = C(240, 215, 165)
	Kit.Disc(f, 0, 965, 0.08, 63, 0.04, Kit.Vivid(YELLOW))
	Kit.Disc(f, 0, 965, 0.1, 58, 0.04, sawdust)
	Kit.Disc(f, -82, 1000, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -82, 1000, 0.1, 47, 0.04, sawdust)
	Kit.Disc(f, 75, 1055, 0.08, 55, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 75, 1055, 0.1, 51, 0.04, sawdust)
	Kit.Disc(f, -62, 1115, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -62, 1115, 0.1, 47, 0.04, sawdust)
	-- boss: circus ring
	Kit.Disc(f, 0, 1165, 0.08, 47, 0.04, Kit.Vivid(RED))
	Kit.Disc(f, 0, 1165, 0.1, 42, 0.04, CREAM)
	Kit.Disc(f, 0, 1165, 0.12, 14, 0.04, Kit.Vivid(YELLOW))
	-- small purple ectoplasm puddles (flat neon accents)
	for _, p in { V(12, 0, 975), V(-75, 0, 1010), V(82, 0, 1046), V(-55, 0, 1122), V(-9, 0, 1172) } do
		Kit.Disc(f, p.X, p.Z, 0.16, 5, 0.04, ECTO, { Mat = NEON, Transp = 0.2 })
	end
end

local function sideWalls(f: Instance)
	-- red/cream board fence, leaving Z MinZ..MinZ+3 and MaxZ-3..MaxZ for the gate walls
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	local n = 16
	local step = (z1 - z0) / n
	local post = Kit.Vivid(BLUE)
	local ball = Kit.Vivid(YELLOW)
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local a = z0 + i * step
			Kit.Box(f, V(s * 140, 0, a), V(s * 146, 12, a + step), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = WOOD, Solid = true })
		end
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13, z1), ball, { Mat = WOOD })
		for i = 2, n - 2, 2 do
			local z = z0 + i * step
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), post, SOLID)
			Kit.Ball(f, 4, V(s * 143, 17, z), ball)
		end
	end
end

-- Round tent: fabric drum + stacked striped tiers + flag. Door faces the midway.
local function tent(f: Instance, x: number, z: number, d: number, c1: Color3, c2: Color3)
	local m = Kit.Model(f, "Tent")
	local fx = if x > 0 then -1 else 1
	Kit.Cyl(m, 8, d, CFrame.new(x, 4, z), c2, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Part(m, V(1.6, 7, d * 0.3), CFrame.new(x + fx * (d / 2 - 0.6), 3.5, z), DARK)
	local sizes = { 1.12, 0.86, 0.6, 0.34 }
	for i, k in sizes do
		Kit.Disc(m, x, z, 8 + i * 2.2, d * k, 2.2, if i % 2 == 1 then c1 else c2, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 3, 0.4, CFrame.new(x, 18.3, z), CREAM)
	Kit.Ball(m, 1.3, V(x, 20, z), Kit.Vivid(YELLOW))
	Kit.Box(m, V(x - 0.1, 18.4, z), V(x + 0.1, 19.8, z + 2.4), c1)
	Kit.AddCircle(x, z, d / 2 + 1.5)
end

local function outside(f: Instance)
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i, z in { 935, 1050, 1165 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 188, -14, z + s * 12), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- wooden roller coaster beyond the east wall
	local heights = { 12, 26, 34, 22, 14, 28, 20, 12 }
	local prev: Vector3? = nil
	for i, h in heights do
		local z = 975 + (i - 1) * 22
		Kit.Box(f, V(171.4, 0, z - 0.6), V(172.6, h, z + 0.6), CREAM, { Mat = WOOD })
		local top = V(172, h + 0.4, z)
		if prev then
			Props.Beam(f, prev, top, 2.6, 0.8, Kit.Vivid(RED))
		end
		prev = top
	end
	-- far tents beyond the west wall
	tent(f, -170, 990, 22, Kit.Vivid(RED), CREAM)
	tent(f, -172, 1105, 20, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	for _, z in { 905, 1205 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 22 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
end

--==================================================================
-- ENTRANCE
--==================================================================
local function entranceArch(f: Instance)
	local m = Kit.Model(f, "CarnivalArch")
	local z = 926
	for _, s in { -1, 1 } do
		for i = 0, 5 do
			Kit.Box(m, V(s * 13, i * 6, z - 3), V(s * 19, i * 6 + 6, z + 3), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, SOLID)
		end
		Kit.Box(m, V(s * 12.4, 0, z - 3.6), V(s * 19.6, 2.5, z + 3.6), Kit.Vivid(BLUE), SOLID)
		Kit.Cyl(m, 4, 8, CFrame.new(s * 16, 40, z), Kit.Vivid(YELLOW))
		Kit.Ball(m, 4.5, V(s * 16, 44, z), Kit.Vivid(RED))
		Kit.AddRect(s * 12, z - 4, s * 20.5, z + 4)
	end
	-- beam (bottom Y 30) + round crest
	Kit.Box(m, V(-22, 30, z - 3.5), V(22, 38, z + 3.5), Kit.Vivid(BLUE), SOLID)
	Kit.CylFlat(m, 3, 20, V(0, 40, z), "Z", Kit.Vivid(YELLOW))
	Kit.Ball(m, 4, V(0, 52, z), Kit.Vivid(RED))
	local sign = Kit.Part(m, V(38, 6, 0.4), CFrame.new(0, 34, z - 3.75), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎪 SPOOKY CARNIVAL 🎪", Kit.Vivid(YELLOW))
	local back = Kit.Part(m, V(30, 4.4, 0.4), CFrame.new(0, 34, z + 3.75) * CFrame.Angles(0, math.pi, 0), DARK)
	Kit.Sign(back, Enum.NormalId.Front, "COME BACK SOON... 👻", CREAM)
	-- bulbs under the beam (every other one glows)
	for i = 0, 8 do
		local glow = i % 2 == 0
		local b = Kit.Ball(m, 1.6, V(-18 + i * 4.5, 29.6, z - 3.6), if glow then BULB else Kit.Vivid(RED), glowOpts(glow))
		if i == 4 then
			Kit.Light(b, C(255, 210, 140), 26, 1.4)
		end
	end
	-- giant "ADMIT ONE" ticket by the gate
	local t = Kit.Part(m, V(12, 5, 0.6), CFrame.new(-62, 3.2, 905) * CFrame.Angles(0, 0.3, 0.1), Kit.Vivid(YELLOW))
	Kit.Sign(t, Enum.NormalId.Front, "ADMIT ONE\n👻 BOO 👻", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-62.5, 0, 904.5), V(-61.5, 1, 905.5), WOODC)
	Kit.AddCircle(-62, 905, 7)
end

local function ticketBooth(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TicketBooth")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	Kit.Part(m, V(7, 8, 6), base * CFrame.new(0, 4, 0), Kit.Vivid(RED), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(m, V(7.4, 1, 6.4), base * CFrame.new(0, 1.5, 0), CREAM)
	Kit.Part(m, V(4.4, 3, 0.3), base * CFrame.new(0, 5, -3.05), C(255, 235, 175))
	Kit.Part(m, V(5.6, 0.5, 1.4), base * CFrame.new(0, 3.3, -3.5), CREAM)
	local sign = Kit.Part(m, V(6.6, 1.5, 0.4), base * CFrame.new(0, 7.3, -3.15), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎟️ TICKETS", Kit.Vivid(YELLOW))
	Kit.Part(m, V(8.4, 1, 7.4), base * CFrame.new(0, 8.5, 0), Kit.Vivid(YELLOW))
	Kit.Cyl(m, 1.6, 7, CFrame.new(x, 9.8, z), Kit.Vivid(RED))
	Kit.Cyl(m, 1.6, 5, CFrame.new(x, 11.4, z), CREAM)
	Kit.Cyl(m, 1.6, 3, CFrame.new(x, 13, z), Kit.Vivid(RED))
	Kit.Ball(m, 1.4, V(x, 14.4, z), Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 6)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ferrisWheel(f: Instance)
	local m = Kit.Model(f, "FerrisWheel")
	local cx, cy, cz = 100, 47, 1182
	local R, N = 34, 20
	Kit.Box(m, V(70, 0, 1170), V(130, 1, 1194), WOODC, { Mat = WOOD, Solid = true })
	local function rim(a: number, dz: number): Vector3
		return V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz + dz)
	end
	local rimCol = Kit.Vivid(RED)
	for _, dz in { -3, 3 } do
		for i = 0, N - 1 do
			bar(m, rim(i / N * math.pi * 2, dz), rim((i + 1) / N * math.pi * 2, dz), 1.2, rimCol, { Mat = METAL })
		end
		for i = 0, 4 do
			local a = i / 5 * math.pi
			bar(m, rim(a, dz), rim(a + math.pi, dz), 0.7, CREAM)
		end
	end
	local hub = Kit.CylFlat(m, 9, 5, V(cx, cy, cz), "Z", Kit.Vivid(YELLOW))
	Kit.CylFlat(m, 10, 2, V(cx, cy, cz), "Z", Kit.Vivid(PURPLE))
	Kit.Light(hub, C(255, 200, 150), 34, 1.3)
	-- A-frame legs + braces
	local leg = C(240, 240, 250)
	for _, dz in { -6, 6 } do
		for _, sx in { -1, 1 } do
			bar(m, V(cx + sx * 22, 1, cz + dz), V(cx, cy, cz + dz * 0.6), 1.6, leg, { Mat = METAL, Solid = true })
		end
		Kit.Box(m, V(cx - 15, 15.5, cz + dz * 0.87 - 0.5), V(cx + 15, 16.5, cz + dz * 0.87 + 0.5), Kit.Vivid(BLUE))
	end
	-- gondolas hang from the spoke ends
	local cabs = { Kit.Vivid(BLUE), Kit.Vivid(YELLOW), Kit.Vivid(MINT), Kit.Vivid(PURPLE), Kit.Vivid(PINK) }
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local p = V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz)
		Kit.CylFlat(m, 6.4, 0.6, p, "Z", C(200, 200, 215))
		Kit.Box(m, p + V(-0.2, -3, -0.2), p + V(0.2, 0, 0.2), C(200, 200, 215))
		Kit.Box(m, p + V(-2.6, -7.2, -2.2), p + V(2.6, -3, 2.2), cabs[i % #cabs + 1], { Shadow = true })
		Kit.Disc(m, p.X, p.Z, p.Y - 2.2, 6.2, 0.8, CREAM)
	end
	-- bulbs between the gondolas on the front rim (half glow)
	for i = 0, 9 do
		local glow = i % 2 == 0
		Kit.Ball(m, 1.8, rim((i + 0.5) / 10 * math.pi * 2, -3.8), if glow then BULB else Kit.Vivid(YELLOW), glowOpts(glow))
	end
	Props.SignBoard(m, V(cx, 6, 1167.5), 16, 3, 0, -1, "🎡 BOO-RIS WHEEL", DARK, Kit.Vivid(YELLOW), RED)
	for _, sx in { -7, 7 } do
		Kit.Box(m, V(cx + sx - 0.4, 0, 1167.4), V(cx + sx + 0.4, 4.5, 1168.2), CREAM)
	end
	Kit.AddRect(66, 1163, 136, 1197)
end

local function carousel(f: Instance)
	local m = Kit.Model(f, "Carousel")
	local cx, cz = 78, 1125
	Kit.Disc(m, cx, cz, 0.6, 32, 0.6, Kit.Vivid(RED), { Solid = true })
	Kit.Disc(m, cx, cz, 1.2, 29, 0.6, CREAM, { Mat = WOOD, Solid = true })
	local column = Kit.Cyl(m, 13, 5, CFrame.new(cx, 7.7, cz), Kit.Vivid(YELLOW), SOLID)
	Kit.Light(column, C(255, 215, 150), 24, 1.2)
	local horses = { CREAM, Kit.Vivid(PINK), Kit.Vivid(C(150, 200, 255)), Kit.Vivid(MINT) }
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local px, pz = cx + math.cos(a) * 10, cz + math.sin(a) * 10
		Kit.Cyl(m, 13, 0.5, CFrame.new(px, 7.7, pz), C(255, 215, 120), { Mat = METAL })
		local base = faced(V(px, 5 + (i % 2) * 1.5, pz), -math.sin(a), math.cos(a))
		local col = horses[i % #horses + 1]
		Kit.Part(m, V(1.6, 1.8, 4.2), base, col)
		Kit.Part(m, V(1.3, 2.6, 1.5), base * CFrame.new(0, 1.6, -2) * CFrame.Angles(0.35, 0, 0), col)
		Kit.Part(m, V(1.2, 2.2, 3.4), base * CFrame.new(0, -1.9, 0), col:Lerp(C(0, 0, 0), 0.15))
	end
	-- striped roof: valance + 12 wedge panels
	Kit.Cyl(m, 2, 32, CFrame.new(cx, 15, cz), CREAM, { Mat = FABRIC })
	local L, h = 16, 7
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local dx, dz = math.cos(a), math.sin(a)
		local cf = CFrame.new(cx + dx * L / 2, 16 + h / 2, cz + dz * L / 2) * CFrame.Angles(0, Kit.FaceYaw(dx, dz), 0)
		Kit.Wedge(m, V(8.8, h, L), cf, if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 2, 3, CFrame.new(cx, 24, cz), Kit.Vivid(YELLOW))
	Kit.Ball(m, 2.6, V(cx, 26, cz), Kit.Vivid(BLUE))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local glow = i % 2 == 0
		Kit.Ball(m, 1.3, V(cx + math.cos(a) * 16.2, 15, cz + math.sin(a) * 16.2), if glow then BULB else Kit.Vivid(BLUE), glowOpts(glow))
	end
	Props.SignBoard(m, V(58.5, 7, cz), 12, 2.6, -1, 0, "🎠 MERRY-GO-BOO", DARK, Kit.Vivid(YELLOW), BLUE)
	for _, dz in { -5, 5 } do
		Kit.Box(m, V(58.2, 0, cz + dz - 0.4), V(59, 5.7, cz + dz + 0.4), CREAM)
	end
	Kit.AddCircle(cx, cz, 17)
	Kit.AddCircle(58.5, cz, 7)
end

local function bigTop(f: Instance)
	local m = Kit.Model(f, "BigTop")
	local cx, cz = -100, 1180
	Kit.Cyl(m, 16, 44, CFrame.new(cx, 8, cz), CREAM, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Cyl(m, 2, 44.6, CFrame.new(cx, 2, cz), Kit.Vivid(RED), { Mat = FABRIC })
	for i, d in { 48, 40, 32, 24, 16, 8 } do
		Kit.Disc(m, cx, cz, 16 + i * 4, d, 4, if i % 2 == 1 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 10, 1, CFrame.new(cx, 45, cz), C(240, 240, 250))
	Kit.Ball(m, 2.2, V(cx, 50.6, cz), Kit.Vivid(YELLOW))
	local flag = Kit.Box(m, V(cx + 0.5, 44, cz - 0.1), V(cx + 8.5, 48.5, cz + 0.1), Kit.Vivid(PURPLE))
	Kit.Sign(flag, Enum.NormalId.Front, "BOO", CREAM)
	-- doorway toward the midway (+X)
	local door = Kit.Box(m, V(cx + 20.5, 0, cz - 6), V(cx + 22.4, 13, cz + 6), DARK)
	Kit.Light(door, ECTO, 22, 1.2)
	for _, dz in { -1, 1 } do
		Kit.Part(m, V(0.6, 13, 3.2), CFrame.new(cx + 22.7, 6.5, cz + dz * 5.4) * CFrame.Angles(0, 0, dz * 0.08), Kit.Vivid(RED), { Mat = FABRIC })
	end
	Props.SignBoard(m, V(cx + 23.2, 14.2, cz), 18, 3.5, 1, 0, "🎪 THE BIG TOP", DARK, Kit.Vivid(YELLOW), RED)
	Kit.AddCircle(cx, cz, 25)
	Props.Wisp(f, V(-68, 0, cz), ECTO, 10, true)
	Kit.AddCircle(-68, cz, 5)
end

--==================================================================
-- STALLS, BOOTHS, CARTS
--==================================================================
local function stall(f: Instance, x: number, z: number, color: Color3, title: string)
	local m = Kit.Model(f, "GameStall")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	local col = Kit.Vivid(color)
	Kit.Part(m, V(12, 10, 1), base * CFrame.new(0, 5, 3.5), col, { Mat = WOOD, Solid = true, Shadow = true })
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 10, 8), base * CFrame.new(sx * 5.5, 5, 0), CREAM, { Mat = WOOD, Solid = true })
	end
	Kit.Part(m, V(10, 3.5, 1.6), base * CFrame.new(0, 1.75, -3.2), CREAM, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(10.2, 0.5, 2), base * CFrame.new(0, 3.75, -3.2), col)
	for i = 0, 3 do
		local cf = base * CFrame.new(-4.875 + i * 3.25, 11, -1) * CFrame.Angles(-0.25, 0, 0)
		Kit.Part(m, V(3.25, 0.5, 10), cf, if i % 2 == 0 then col else CREAM, { Mat = FABRIC })
	end
	Kit.Part(m, V(10, 0.5, 1.4), base * CFrame.new(0, 5.5, 2.4), CREAM)
	local prizes = { Kit.Vivid(PINK), Kit.Vivid(YELLOW), Kit.Vivid(MINT) }
	for i = 0, 2 do
		Kit.Ball(m, 1.9, (base * CFrame.new(-3 + i * 3, 6.7, 2.4)).Position, prizes[i + 1])
	end
	local sign = Kit.Part(m, V(10, 2.4, 0.5), base * CFrame.new(0, 13.6, 3.2), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, title, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 8)
end

local function plushBear(parent: Instance, pos: Vector3, s: number, color: Color3, fx: number, fz: number)
	local base = faced(pos, fx, fz)
	Kit.Ball(parent, s, (base * CFrame.new(0, s * 0.45, 0)).Position, color, { Mat = FABRIC })
	local head = base * CFrame.new(0, s * 1.15, 0)
	Kit.Ball(parent, s * 0.75, head.Position, color, { Mat = FABRIC })
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, s * 0.28, (head * CFrame.new(sx * s * 0.3, s * 0.3, 0)).Position, color, { Mat = FABRIC })
		Kit.Ball(parent, s * 0.1, (head * CFrame.new(sx * s * 0.14, s * 0.06, -s * 0.34)).Position, C(40, 30, 50))
	end
	Kit.Ball(parent, s * 0.28, (head * CFrame.new(0, -s * 0.1, -s * 0.3)).Position, CREAM)
	Kit.Part(parent, V(s * 0.5, s * 0.22, s * 0.15), base * CFrame.new(0, s * 0.85, -s * 0.38), Kit.Vivid(RED))
end

local function plushGhost(parent: Instance, pos: Vector3, s: number)
	Kit.Cyl(parent, s * 0.6, s, CFrame.new(pos + V(0, s * 0.3, 0)), CREAM, { Mat = FABRIC })
	Kit.Ball(parent, s, pos + V(0, s * 0.7, 0), CREAM, { Mat = FABRIC })
	for _, sz in { -1, 1 } do
		Kit.Ball(parent, s * 0.14, pos + V(s * 0.44, s * 0.8, sz * s * 0.16), C(40, 30, 50))
		Kit.Ball(parent, s * 0.12, pos + V(s * 0.42, s * 0.62, sz * s * 0.3), Kit.Vivid(PINK))
	end
end

local function prizeBooth(f: Instance)
	local m = Kit.Model(f, "PrizeBooth")
	Kit.Box(m, V(-106, 0, 1045), V(-86, 1, 1071), WOODC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(-108, 0, 1044), V(-106, 16, 1072), Kit.Vivid(BLUE), { Mat = WOOD, Solid = true })
	for _, z in { 1045, 1071 } do
		Kit.Box(m, V(-87, 1, z - 0.6), V(-85.8, 15, z + 0.6), Kit.Vivid(YELLOW), SOLID)
	end
	Kit.Box(m, V(-108, 15, 1044), V(-84, 17, 1072), Kit.Vivid(RED), { Mat = WOOD })
	local valance = Kit.Box(m, V(-84.4, 13, 1044), V(-84, 15, 1072), CREAM)
	Kit.Sign(valance, Enum.NormalId.Right, "🧸 PRIZES! 🧸", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-106, 1, 1047), V(-100, 4, 1069), CREAM, { Mat = WOOD, Solid = true })
	plushBear(m, V(-102.5, 4, 1058), 7, Kit.Vivid(PINK), 1, 0)
	plushBear(m, V(-95, 1, 1050), 5, Kit.Vivid(C(150, 200, 255)), 1, 0)
	plushGhost(m, V(-95, 1, 1066), 5)
	Kit.AddRect(-109, 1043, -83, 1073)
end

local function popcorn(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "PopcornCart")
	Kit.Box(m, V(x - 3, 1.2, z - 2.2), V(x + 3, 4.6, z + 2.2), Kit.Vivid(RED), { Solid = true })
	Kit.Box(m, V(x - 3.1, 3.2, z - 2.3), V(x + 3.1, 3.8, z + 2.3), CREAM)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 0.5, 2.4, V(x + sx * 1.8, 1.2, z + sz * 2.4), "Z", DARK)
		end
	end
	local glass = Kit.Box(m, V(x - 2.8, 4.6, z - 2), V(x + 2.8, 8.6, z + 2), C(220, 240, 255), { Transp = 0.5, Refl = 0.1 })
	Kit.Light(glass, C(255, 220, 150), 20, 1.2)
	for i = 0, 2 do
		Kit.Ball(m, 2.4, V(x - 1.4 + i * 1.4, 5.8 + (i % 2) * 0.6, z), C(255, 240, 190))
	end
	Kit.Box(m, V(x - 3.4, 8.6, z - 2.6), V(x + 3.4, 9.2, z + 2.6), Kit.Vivid(RED))
	Kit.Cyl(m, 1.4, 4, CFrame.new(x, 9.9, z), CREAM)
	Kit.Box(m, V(x - 0.2, 10.6, z - 0.2), V(x + 0.2, 11.7, z + 0.2), CREAM)
	local sign = Kit.Part(m, V(6, 1.8, 0.4), faced(V(x + 0.2, 12.6, z), 1, 0), Kit.Vivid(YELLOW))
	Kit.Sign(sign, Enum.NormalId.Front, "🍿 POPCORN", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.AddCircle(x, z, 5)
end

local function balloonCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "BalloonCart")
	Kit.Box(m, V(x - 2, 1, z - 1.5), V(x + 2, 4, z + 1.5), Kit.Vivid(BLUE), { Solid = true })
	Kit.Box(m, V(x - 2.2, 4, z - 1.7), V(x + 2.2, 4.4, z + 1.7), Kit.Vivid(YELLOW))
	for _, sz in { -1, 1 } do
		Kit.CylFlat(m, 0.4, 2.2, V(x, 1.1, z + sz * 1.7), "Z", DARK)
	end
	local cols = { RED, YELLOW, BLUE, PURPLE, PINK, MINT, CREAM }
	local top = V(x, 4.4, z)
	for i, col in cols do
		local a = i / #cols * math.pi * 2
		local p = V(x + math.cos(a) * 2.4, 11 + (i % 3) * 1.4, z + math.sin(a) * 2.4)
		Props.Beam(m, top, p - V(0, 1.4, 0), 0.1, 0.1, C(245, 245, 245))
		Kit.Ball(m, 2.8, p, Kit.Vivid(col), { Refl = 0.05 })
	end
	Kit.AddCircle(x, z, 5)
end

local function highStriker(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "HighStriker")
	Kit.Box(m, V(x - 3, 0, z - 3), V(x + 3, 1, z + 3), Kit.Vivid(RED), { Mat = WOOD, Solid = true })
	Kit.Box(m, V(x - 0.8, 1, z - 0.8), V(x + 0.8, 25, z + 0.8), CREAM, { Mat = WOOD, Solid = true })
	for i, col in { YELLOW, BLUE, RED } do
		local y = 2 + i * 6
		Kit.Box(m, V(x + 0.8, y, z - 1), V(x + 1, y + 3, z + 1), Kit.Vivid(col))
	end
	Kit.Ball(m, 2.6, V(x, 26.3, z), C(255, 230, 120), { Mat = NEON })
	Kit.Box(m, V(x + 0.8, 11, z - 0.5), V(x + 1.6, 12, z + 0.5), DARK)
	Kit.Box(m, V(x + 1, 1, z - 0.8), V(x + 2.8, 1.4, z + 0.8), Kit.Vivid(YELLOW))
	-- giant mallet leaning on the tower
	Props.Beam(m, V(x + 3.5, 0.2, z + 3), V(x + 1.5, 7, z + 3.6), 0.6, 0.6, WOODC)
	Kit.Part(m, V(3, 1.8, 1.8), CFrame.new(x + 1.4, 7.4, z + 3.6), Kit.Vivid(RED))
	Props.SignBoard(m, V(x + 1.2, 4.6, z), 5, 2.2, 1, 0, "BOO-O-METER", DARK, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 5)
end

--==================================================================
-- STREET FURNITURE + DECOR
--==================================================================
local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), WOODC, { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), WOODC, { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(RED))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function fence(f: Instance, a: Vector3, b: Vector3)
	local d = b - a
	local len = d.Magnitude
	local dir = d.Unit
	local yaw = Kit.FaceYaw(dir.X, dir.Z)
	for _, ry in { 1.2, 2.8 } do
		Kit.Part(f, V(0.3, 0.5, len), CFrame.new(a + d / 2 + V(0, ry, 0)) * CFrame.Angles(0, yaw, 0), Kit.Vivid(RED), { Mat = WOOD })
	end
	local n = math.max(1, math.floor(len / 4))
	for i = 0, n do
		local p = a + dir * (i * len / n)
		Kit.Box(f, p + V(-0.35, 0, -0.35), p + V(0.35, 3.8, 0.35), CREAM, { Mat = WOOD })
	end
	Kit.AddRect(math.min(a.X, b.X) - 1, math.min(a.Z, b.Z) - 1, math.max(a.X, b.X) + 1, math.max(a.Z, b.Z) + 1)
end

local function stringLights(f: Instance)
	local zs = { 1005, 1030, 1055, 1080, 1105, 1130 }
	local top = 17.5
	local cols = { Kit.Vivid(RED), Kit.Vivid(YELLOW), Kit.Vivid(BLUE), CREAM }
	for _, z in zs do
		for _, s in { -1, 1 } do
			Kit.Cyl(f, top + 0.5, 0.7, CFrame.new(s * 13, (top + 0.5) / 2, z), C(150, 100, 70), { Mat = WOOD })
			Kit.Ball(f, 1.4, V(s * 13, top + 0.9, z), Kit.Vivid(YELLOW))
			Kit.AddCircle(s * 13, z, 1.5)
		end
	end
	local nb = 0
	local lit = false
	local function wire(a: Vector3, b: Vector3)
		local mid = (a + b) / 2 - V(0, 2, 0)
		Props.Beam(f, a, mid, 0.15, 0.15, DARK)
		Props.Beam(f, mid, b, 0.15, 0.15, DARK)
		for k = 1, 4 do
			local t = k / 5
			local sag = 2 * (1 - math.abs(2 * t - 1))
			local p = a:Lerp(b, t) - V(0, sag + 0.5, 0)
			nb += 1
			local glow = nb % 4 == 0
			local bulb = Kit.Ball(f, 0.9, p, if glow then BULB else cols[nb % #cols + 1], glowOpts(glow))
			if glow and not lit then
				lit = true
				Kit.Light(bulb, C(255, 215, 150), 30, 1.1)
			end
		end
	end
	for i, z in zs do
		wire(V(-13, top, z), V(13, top, z))
		local nextZ = zs[i + 1]
		if nextZ then
			local s = if i % 2 == 1 then 1 else -1
			wire(V(-13 * s, top, z), V(13 * s, top, nextZ))
		end
	end
end

local function lollipop(f: Instance, x: number, z: number, color: Color3)
	Kit.Cyl(f, 12, 0.8, CFrame.new(x, 6, z), CREAM)
	Kit.CylFlat(f, 1.2, 7, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.CylFlat(f, 1.4, 4, V(x, 14, z), "Z", CREAM)
	Kit.CylFlat(f, 1.6, 1.6, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.AddCircle(x, z, 2)
end

local function circusBall(f: Instance, x: number, z: number, color: Color3, band: Color3)
	Kit.Ball(f, 6, V(x, 3, z), Kit.Vivid(color), { Solid = true })
	Kit.CylFlat(f, 1.4, 6.15, V(x, 3, z), "X", band)
	Kit.AddCircle(x, z, 3.5)
end

type BallSpot = { P: Vector3, Col: Color3, Band: Color3 }

local function decor(f: Instance)
	local rng = Kit.Rng
	-- benches between the string-light poles
	local benches = 0
	for _, z in { 1017, 1042, 1067, 1092, 1117 } do
		for _, s in { -1, 1 } do
			if benches < 7 and Kit.IsFree(s * 16.5, z, 3.5) then
				benches += 1
				bench(f, s * 16.5, z, -s, 0)
			end
		end
	end
	-- wooden fencing
	fence(f, V(68, 0, 1164), V(92, 0, 1164))
	fence(f, V(-124, 0, 1150), V(-78, 0, 1150))
	fence(f, V(128, 0, 1030), V(128, 0, 1078))
	-- lanterns flanking the boss ring (one flickers)
	Props.Lantern(f, V(-26, 0, 1142), C(200, 150, 255), true, true)
	Props.Lantern(f, V(26, 0, 1142), C(255, 220, 140), true, false)
	Kit.AddCircle(-26, 1142, 1.5)
	Kit.AddCircle(26, 1142, 1.5)
	-- oversized decorations
	local lolly = { RED, BLUE, PURPLE, PINK }
	for i, p in { V(-60, 0, 936), V(40, 0, 938), V(-125, 0, 1020), V(122, 0, 1092) } do
		if Kit.IsFree(p.X, p.Z, 2) then
			lollipop(f, p.X, p.Z, lolly[i])
		end
	end
	local balls: { BallSpot } = {
		{ P = V(34, 0, 1036), Col = RED, Band = CREAM },
		{ P = V(-30, 0, 1035), Col = BLUE, Band = Kit.Vivid(YELLOW) },
		{ P = V(112, 0, 1100), Col = PURPLE, Band = CREAM },
	}
	for _, b in balls do
		if Kit.IsFree(b.P.X, b.P.Z, 3.5) then
			circusBall(f, b.P.X, b.P.Z, b.Col, b.Band)
		end
	end
	-- floating balloons (single parts, client-animated)
	local fl = { RED, YELLOW, BLUE, PURPLE, PINK }
	for i, p in { V(36, 19, 1078), V(24, 22, 1090), V(-36, 18, 1040), V(60, 24, 940), V(-40, 22, 1150) } do
		local b = Kit.Ball(f, 3, p, Kit.Vivid(fl[i]), { Name = "FloatingBalloon" })
		Kit.Float(b, 1.2)
	end
	-- candy trees near the walls
	local trees = 0
	for _ = 1, 120 do
		if trees >= 6 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(100, 131)
		local z = rng:NextNumber(905, 1150)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(12, 17), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	-- wooden crates and pumpkins scattered around the grounds
	local crates, pumpkins = 0, 0
	for _ = 1, 300 do
		if crates >= 7 and pumpkins >= 6 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(908, 1212)
		if Kit.IsFree(x, z, 3) then
			if crates < 7 then
				crates += 1
				local s = rng:NextNumber(2.6, 3.8)
				local cf = CFrame.new(x, s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
				Kit.Part(f, V(s, s, s), cf, Kit.Pick({ WOODC, C(170, 115, 75), C(205, 160, 110) }), { Mat = WOOD, Solid = true })
			else
				pumpkins += 1
				Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 3.4), -x, 0)
			end
			Kit.AddCircle(x, z, 3)
		end
	end
end

function Carnival.Build(map: Instance)
	local f = Kit.Folder(map, "Carnival")
	ground(f)
	sideWalls(f)
	outside(f)
	entranceArch(f)
	ticketBooth(f, -46, 930)
	ticketBooth(f, 46, 930)
	ferrisWheel(f)
	carousel(f)
	bigTop(f)
	prizeBooth(f)
	-- striped tents (door toward the midway)
	tent(f, -112, 936, 16, Kit.Vivid(RED), CREAM)
	tent(f, -80, 950, 13, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 118, 952, 16, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 115, 1005, 14, Kit.Vivid(RED), CREAM)
	tent(f, -122, 1110, 14, Kit.Vivid(RED), CREAM)
	tent(f, 40, 1180, 12, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, -45, 1185, 12, Kit.Vivid(RED), CREAM)
	-- game stalls
	stall(f, 52, 948, BLUE, "RING TOSS")
	stall(f, 52, 977, PURPLE, "DUCK POND")
	stall(f, 52, 1006, RED, "BOO BALLOONS")
	stall(f, -48, 1062, YELLOW, "WHACK-A-GHOST")
	popcorn(f, -40, 958)
	balloonCart(f, 30, 1085)
	highStriker(f, -28, 1078)
	Props.Wisp(f, V(58, 0, 1158), ECTO, 10, true)
	Kit.AddCircle(58, 1158, 5)
	stringLights(f)
	decor(f)
end

return Carnival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Castle</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 7: Cursed Castle (Z 1920..2280).
--   Z 1926..1936  cosmetic moat (water over a solid floor at Y -0.5: a half-stud wade, no pit)
--                 crossed by a stone bridge on the path (X -12..12).
--   Z 1936..1962  outer bailey: Royal crate station (-28, 1952) and Fast Travel pad (26, 1952).
--   Z 1962..1975  gatehouse (archway X -16..16, clear to Y ~30, 26+ wide at Y 30) flanked by a
--                 crenellated curtain wall out to the side walls.
--   Z 1975..2186  open courtyard (no roofs): every non-boss ghost area, knight statues, a
--                 spectral fountain, braziers, sword in the stone, lawns.
--   Z 2186..2256  open-topped throne room (X -45..45) around the boss area (0, 2220); giant doors
--                 swung outward; the throne sits on a balcony over a 26-wide arch in the back
--                 wall that leads on to the Spirit Realm gate.
--   Library corner X 74..140, Z 2146..2254 (open front/top). Eight round towers with stepped cone
--   roofs (keep towers flank the throne room, tips ~117), cliffs beyond the side walls.
--   Glow: rune ring, cracks, tower windows (half the towers), torches, braziers, candles, the
--   fountain orb and the throne gem. Everything else is stone, wood, metal and fabric.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Castle = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SLATE = Enum.Material.Slate
local COBBLE = Enum.Material.Cobblestone
local WOOD = Enum.Material.Wood
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1920, 2280

local STONE = C(150, 150, 166)
local STONE_D = C(112, 114, 132)
local STONE_L = C(188, 188, 200)
local FLOOR = C(132, 130, 148)
local PATH = C(176, 170, 186)
local BLUE = C(55, 78, 150)
local ROOF = C(60, 75, 145)
local ROOF_P = C(100, 60, 150)
local ROYAL_RED = C(175, 40, 70)
local PURPLE = C(125, 65, 175)
local GOLD = C(255, 200, 70)
local SPECTRAL = C(120, 255, 170)
local GHOST_PURPLE = C(190, 120, 255)
local WARM = C(255, 185, 95)
local WOOD_C = C(112, 76, 52)
local IRON = C(60, 62, 78)
local SILVER = C(196, 200, 214)
local ROCKC = C(102, 106, 124)

local SOLID_SLATE: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }

--==================================================================
-- HELPERS
--==================================================================
-- Stepped cone roof (stacked cylinders) from y up to y + h, with a gold finial.
local function cone(parent: Instance, x: number, z: number, y: number, d: number, h: number, color: Color3)
	local tiers = 5
	local th = h / tiers
	for i = 0, tiers - 1 do
		local di = d * (1 - i / tiers)
		local col = if i % 2 == 0 then color else color:Lerp(Color3.new(1, 1, 1), 0.12)
		Kit.Cyl(parent, th, di, CFrame.new(x, y + th * (i + 0.5), z), col, { Mat = SLATE, Shadow = true })
	end
	Kit.Ball(parent, math.max(1.2, d * 0.12), V(x, y + h + 0.4, z), Kit.Vivid(GOLD), { Mat = METAL })
end

-- Round tower with crenellated top, cone roof, flag and two windows facing the path.
local function tower(parent: Instance, x: number, z: number, d: number, h: number, roof: Color3, glow: Color3?)
	local m = Kit.Model(parent, "Tower")
	Kit.Cyl(m, 3, d + 3, CFrame.new(x, 1.5, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, h, d, CFrame.new(x, h / 2, z), STONE, SOLID_SLATE)
	Kit.Cyl(m, 1.2, d + 0.6, CFrame.new(x, h * 0.62, z), Kit.Vivid(BLUE), { Mat = SLATE })
	Kit.Cyl(m, 4, d + 3, CFrame.new(x, h + 2, z), STONE_L, { Mat = SLATE, Shadow = true })
	local r = (d + 3) / 2 - 1.3
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * r, z + math.sin(a) * r
		Kit.Box(m, V(px - 1.4, h + 4, pz - 1.4), V(px + 1.4, h + 7, pz + 1.4), STONE_L, { Mat = SLATE })
	end
	local coneH = (d - 1) * 1.75
	cone(m, x, z, h + 4, d - 1, coneH, roof)
	local tip = h + 4 + coneH
	Kit.Cyl(m, 6, 0.3, CFrame.new(x, tip + 3, z), IRON, { Mat = METAL })
	Kit.Part(m, V(0.3, 2.6, 4.5), CFrame.new(x, tip + 4.6, z - 2.4), Kit.Vivid(if roof == ROOF then ROYAL_RED else PURPLE), { Mat = FABRIC })
	local dir = if x > 0 then -1 else 1
	local winOpts: Kit.Opts = if glow then { Mat = NEON, Transp = 0.1 } else {}
	for _, wy in { h * 0.42, h * 0.8 } do
		Kit.Part(m, V(2.2, 5, 1), CFrame.new(x + dir * (d / 2 - 0.2), wy, z) * CFrame.Angles(0, Kit.FaceYaw(dir, 0), 0), glow or C(40, 50, 85), winOpts)
	end
	Kit.AddCircle(x, z, d / 2 + 2.5)
end

-- Hanging banner facing (fx, fz); pos = centre of the cloth.
local function banner(parent: Instance, pos: Vector3, w: number, h: number, fx: number, fz: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(parent, V(w, h, 0.3), cf, color, { Mat = FABRIC })
	local e = w * 0.42
	Kit.Part(parent, V(e, e, 0.2), cf * CFrame.new(0, h * 0.12, -0.22) * CFrame.Angles(0, 0, math.pi / 4), gold, { Mat = METAL })
	Kit.Part(parent, V(w + 1.2, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.2, 0), gold, { Mat = METAL })
	Kit.Part(parent, V(w, 0.6, 0.36), cf * CFrame.new(0, -h / 2 + 0.3, 0), gold, { Mat = FABRIC })
end

local function knightStatue(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "KnightStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = C(178, 178, 190)
	local so: Kit.Opts = { Mat = Enum.Material.Concrete, Shadow = true }
	Kit.Part(m, V(6, 3, 6), base * CFrame.new(0, 1.5, 0), STONE_D, SOLID_SLATE)
	Kit.Part(m, V(3, 4, 1.8), base * CFrame.new(0, 5, 0), stone, so)
	Kit.Part(m, V(4.2, 4.6, 2.4), base * CFrame.new(0, 9.3, 0), stone, so)
	Kit.Ball(m, 2.8, (base * CFrame.new(0, 12.9, 0)).Position, stone, so)
	Kit.Wedge(m, V(0.6, 1.8, 2.6), base * CFrame.new(0, 14.6, 0.4), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Part(m, V(3.2, 4.2, 0.5), base * CFrame.new(-2.7, 8.6, -0.9), Kit.Vivid(ROYAL_RED), { Mat = METAL })
	Kit.Part(m, V(1.4, 1.4, 0.2), base * CFrame.new(-2.7, 8.8, -1.2) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.5, 9, 0.3), base * CFrame.new(2.6, 9.5, -1.3), SILVER, { Mat = METAL })
	Kit.Part(m, V(2.4, 0.45, 0.45), base * CFrame.new(2.6, 7.2, -1.3), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.AddCircle(x, z, 4.5)
end

local function armor(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "SuitOfArmor")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.15 }
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(0, 0.3, 0), WOOD_C, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(1.9, 3.6, 1.2), base * CFrame.new(0, 2.4, 0), SILVER, mo)
	Kit.Part(m, V(2.8, 2.8, 1.6), base * CFrame.new(0, 5.6, 0), SILVER, mo)
	Kit.Part(m, V(3.4, 0.9, 1.8), base * CFrame.new(0, 6.9, 0), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(1.6, 1.9, 1.6), base * CFrame.new(0, 8.3, 0), SILVER, mo)
	Kit.Part(m, V(1.2, 0.25, 0.12), base * CFrame.new(0, 8.4, -0.82), C(25, 25, 35))
	Kit.Wedge(m, V(0.4, 1.2, 1.6), base * CFrame.new(0, 9.8, 0.2), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Part(m, V(0.3, 10, 0.3), base * CFrame.new(1.9, 5, -0.5), WOOD_C, { Mat = WOOD })
	Kit.Part(m, V(0.2, 1.8, 1.4), base * CFrame.new(1.9, 9.6, -0.9), SILVER, mo)
	Kit.AddCircle(x, z, 2.5)
end

local function candelabra(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "Candelabra")
	local gold = Kit.Vivid(GOLD)
	Kit.Disc(m, x, z, 0.5, 2.4, 0.5, gold, { Mat = METAL })
	Kit.Cyl(m, 6, 0.6, CFrame.new(x, 3.5, z), gold, { Mat = METAL })
	Kit.CylFlat(m, 4.2, 0.4, V(x, 6.5, z), "X", gold, { Mat = METAL })
	for i = -1, 1 do
		Kit.Cyl(m, 1.4, 0.55, CFrame.new(x + i * 1.9, 7.4, z), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x + i * 1.9, 8.4, z), WARM, { Mat = NEON })
		if light and i == 0 then
			Kit.Light(flame, WARM, 20, 1.3, true)
		end
	end
	Kit.AddCircle(x, z, 2.5)
end

local function brazier(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "Brazier")
	Kit.Cyl(m, 4, 2.4, CFrame.new(x, 2, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, 1.6, 4.4, CFrame.new(x, 4.8, z), IRON, { Mat = METAL })
	local flame = Kit.Ball(m, 2.6, V(x, 5.9, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(flame, SPECTRAL, 26, 1.6)
	Kit.AddCircle(x, z, 3)
end

local function crack(parent: Instance, p: Vector3, segs: number)
	local rng = Kit.Rng
	local a = rng:NextNumber(0, math.pi * 2)
	for _ = 1, segs do
		a += rng:NextNumber(-0.9, 0.9)
		local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(4, 7)
		Props.Beam(parent, p, q, 0.45, 0.06, if rng:NextNumber() < 0.5 then SPECTRAL else GHOST_PURPLE, { Mat = NEON })
		p = q
	end
end

--==================================================================
-- GROUND, MOAT, BRIDGE, PATH, WALLS, CLIFFS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, 1926), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	Kit.Box(f, V(-190, -4, 1926), V(190, -0.5, 1936), C(60, 72, 95), { Mat = SLATE, Solid = true, Name = "MoatFloor" })
	Kit.Box(f, V(-146, -0.5, 1926), V(146, -0.12, 1936), C(45, 85, 150), { Transp = 0.2, Refl = 0.25, Name = "MoatWater" })
	Kit.Box(f, V(-190, -4, 1936), V(190, 0, Z1), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	-- low stone curbs along the moat banks (steppable)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 13.6, -0.5, 1925.2), V(s * 140, 0.3, 1926), STONE_D, { Mat = SLATE, Solid = true })
		Kit.Box(f, V(s * 13.6, -0.5, 1936), V(s * 140, 0.3, 1936.8), STONE_D, { Mat = SLATE, Solid = true })
	end
	-- stone bridge over the moat
	Kit.Box(f, V(-12, -0.5, 1923.5), V(12, 0.06, 1938.5), PATH, { Mat = COBBLE, Solid = true, Name = "Bridge" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12, 0, 1924.5), V(s * 13.6, 3.2, 1937.5), STONE, SOLID_SLATE)
		for _, z in { 1924.5, 1937.5 } do
			Kit.Box(f, V(s * 11.8, 0, z - 1.1), V(s * 14, 4.6, z + 1.1), STONE_L, SOLID_SLATE)
			Kit.Ball(f, 1.8, V(s * 12.9, 5.4, z), Kit.Vivid(GOLD), { Mat = METAL })
		end
	end
	-- main path with blue slate edging
	Kit.Box(f, V(-9, 0, 1938.5), V(9, 0.05, Z1), PATH, { Mat = COBBLE, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, 1938.5), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(BLUE), { Mat = SLATE })
	end
	-- flat lawns in the courtyard
	for _, l in { { 40, 1978, 136, 2062 }, { -136, 1978, -40, 2012 }, { -136, 2070, -92, 2130 }, { 28, 2130, 70, 2186 }, { -46, 2192, -136, 2250 } } do
		Kit.Box(f, V(l[1], 0, l[2]), V(l[3], 0.04, l[4]), C(100, 165, 105), { Mat = Enum.Material.Grass })
	end
end

local function sideWalls(f: Instance)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, Z0 + 3), V(s * 146, 30, Z1 - 3), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 139.6, 30, Z0 + 3), V(s * 146.4, 31.2, Z1 - 3), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 139.7, 24, Z0 + 3), V(s * 140, 25.2, Z1 - 3), Kit.Vivid(BLUE), { Mat = SLATE })
		for z = Z0 + 12, Z1 - 12, 16 do
			Kit.Box(f, V(s * 140, 31.2, z - 3), V(s * 146, 35, z + 3), STONE, { Mat = SLATE })
		end
		for _, z in { 2012, 2056, 2146, 2190 } do
			Kit.Box(f, V(s * 137.5, 0, z - 2.5), V(s * 140, 26, z + 2.5), STONE_D, SOLID_SLATE)
		end
		-- spectral crack climbing the wall
		local x = s * 139.75
		local z0 = if s < 0 then 2120 else 2040
		Props.Beam(f, V(x, 2, z0), V(x, 9, z0 + 5), 0.4, 0.4, SPECTRAL, { Mat = NEON })
		Props.Beam(f, V(x, 9, z0 + 5), V(x, 15, z0 + 1), 0.4, 0.4, SPECTRAL, { Mat = NEON })
	end
	-- royal banners on the inner wall faces
	for i, z in { 2034, 2078, 2130 } do
		for _, s in { -1, 1 } do
			banner(f, V(s * 139.5, 15, z), 7, 14, -s, 0, if (i + (if s > 0 then 1 else 0)) % 2 == 0 then ROYAL_RED else PURPLE)
		end
	end
end

local function cliffs(f: Instance)
	local rng = Kit.Rng
	local cols = { ROCKC, C(88, 92, 112), C(115, 118, 138) }
	for _, s in { -1, 1 } do
		for i = 0, 7 do
			local z = 1934 + i * 46
			local w = rng:NextNumber(26, 44)
			local h = rng:NextNumber(42, 66)
			local cf = CFrame.new(s * (149 + w / 2), h / 2 - 3, z) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), s * rng:NextNumber(0.02, 0.08))
			Kit.Part(f, V(w, h, rng:NextNumber(38, 52)), cf, Kit.Pick(cols), { Mat = ROCK })
			Kit.Ball(f, rng:NextNumber(40, 60), V(s * rng:NextNumber(185, 205), rng:NextNumber(4, 18), z + 20), Kit.Pick(cols), { Mat = ROCK })
		end
	end
end

--==================================================================
-- GATEHOUSE + CURTAIN WALL
--==================================================================
local function gatehouse(f: Instance)
	local m = Kit.Model(f, "Gatehouse")
	local zA, zB = 1962, 1975
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16, 0, zA), V(s * 34, 46, zB), STONE, SOLID_SLATE)
		Kit.Box(m, V(s * 15.6, 0, zA - 0.4), V(s * 34.4, 3, zB + 0.4), STONE_D, SOLID_SLATE)
		for _, mx in { 18.5, 31.5 } do
			for _, mz in { zA + 1.5, zB - 1.5 } do
				Kit.Box(m, V(s * (mx - 1.5), 46, mz - 1.5), V(s * (mx + 1.5), 50, mz + 1.5), STONE_L, { Mat = SLATE })
			end
		end
		-- little turret with a cone roof
		Kit.Cyl(m, 10, 7, CFrame.new(s * 25, 51, (zA + zB) / 2), STONE_L, { Mat = SLATE, Shadow = true })
		cone(m, s * 25, (zA + zB) / 2, 56, 8.5, 13, ROOF_P)
		-- banner and torch on the approach face
		banner(m, V(s * 25, 24, zA - 0.35), 8, 18, 0, -1, if s < 0 then ROYAL_RED else PURPLE)
		local tx = s * 18.2
		Kit.Box(m, V(tx - 0.4, 16.5, zA - 0.8), V(tx + 0.4, 19.5, zA), IRON, { Mat = METAL })
		local flame = Kit.Ball(m, 1.7, V(tx, 20.3, zA - 0.6), WARM, { Mat = NEON })
		Kit.Light(flame, WARM, 26, 1.6)
	end
	-- lintel over the archway (opening X -16..16, Y 0..32) + rounded arch corners
	Kit.Box(m, V(-16, 32, zA + 1), V(16, 46, zB - 1), STONE, SOLID_SLATE)
	Kit.Box(m, V(-16, 32, zA + 0.7), V(16, 33, zB - 0.7), Kit.Vivid(GOLD), { Mat = METAL })
	local mid = (zA + zB) / 2
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(-13.5, 29.5, mid), V(0, 0, -1), V(0, -1, 0)), STONE, { Mat = SLATE })
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(13.5, 29.5, mid), V(0, 0, 1), V(0, -1, 0)), STONE, { Mat = SLATE })
	-- raised portcullis teeth
	Kit.Box(m, V(-15, 31, mid - 0.4), V(15, 31.6, mid + 0.4), IRON, { Mat = METAL })
	for x = -12, 12, 4 do
		Kit.Box(m, V(x - 0.35, 30.4, mid - 0.3), V(x + 0.35, 32, mid + 0.3), IRON, { Mat = METAL })
	end
	Props.SignBoard(m, V(0, 39.5, zA + 0.6), 26, 5, 0, -1, "CURSED CASTLE", C(45, 35, 80), Kit.Vivid(GOLD), GOLD)

	-- curtain wall from the gatehouse to the side walls
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 34, 0, 1964), V(s * 140, 24, 1972), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 34, 24, 1963.6), V(s * 140, 25, 1972.4), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 34, 18, 1963.7), V(s * 122, 19, 1964), Kit.Vivid(BLUE), { Mat = SLATE })
		for x = 40, 116, 9.5 do
			Kit.Box(f, V(s * (x - 2), 25, 1963.6), V(s * (x + 2), 28.5, 1966.6), STONE, { Mat = SLATE })
		end
		for i, x in { 58, 96 } do
			banner(f, V(s * x, 12, 1963.4), 7, 14, 0, -1, if i == 1 then ROYAL_RED else PURPLE)
		end
	end
	Kit.AddRect(-140, 1961, -15, 1976)
	Kit.AddRect(15, 1961, 140, 1976)
end

--==================================================================
-- THRONE ROOM
--==================================================================
local function throneRoom(f: Instance)
	local m = Kit.Model(f, "ThroneRoom")
	local wall = C(138, 134, 160)
	local gold = Kit.Vivid(GOLD)
	local H = 28
	-- walls (open top)
	Kit.Box(m, V(-45, 0, 2186), V(-15, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(15, 0, 2186), V(45, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2186), V(-42, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(42, 0, 2186), V(45, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2248), V(-13, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(13, 0, 2248), V(45, H, 2256), wall, SOLID_SLATE)
	-- balcony over the back arch (opening X -13..13, Y 0..20) carries the throne
	Kit.Box(m, V(-13, 20, 2248), V(13, 24, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-13, 20, 2247.7), V(13, 21, 2248), gold, { Mat = METAL })
	-- gold trim and merlons
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 22, 2185.7), V(s * 45, 23, 2186), gold, { Mat = METAL })
		for _, x in { 22, 32, 42 } do
			Kit.Box(m, V(s * (x - 2), H, 2186), V(s * (x + 2), H + 3.5, 2189), wall, { Mat = SLATE })
		end
		for _, z in { 2200, 2218, 2236 } do
			Kit.Box(m, V(s * 42, H, z - 2), V(s * 45, H + 3.5, z + 2), wall, { Mat = SLATE })
		end
	end
	-- lintel + name over the doorway (doorway X -15..15, Y 0..28)
	Kit.Box(m, V(-17, H, 2185.5), V(17, H + 6, 2190.5), STONE_L, SOLID_SLATE)
	Props.SignBoard(m, V(0, H + 3, 2185.1), 24, 4.5, 0, -1, "THRONE ROOM", C(80, 25, 50), gold, GOLD)
	Props.SignBoard(m, V(-24, 9, 2185.4), 9, 3, 0, -1, "BEWARE OF\nTHE KING", C(240, 232, 215), Kit.Vivid(ROYAL_RED))
	-- giant doors, swung outward
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 0, 2171), V(s * 16.6, H, 2186), C(105, 68, 45), { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		for _, y in { 5, 14, 23 } do
			Kit.Box(m, V(s * 14.8, y, 2171), V(s * 16.8, y + 1, 2186), IRON, { Mat = METAL })
		end
		Kit.CylFlat(m, 0.4, 2.2, V(s * 14.7, 12, 2174), "X", gold, { Mat = METAL })
		Kit.AddRect(s * 14, 2170, s * 17.5, 2186)
	end
	-- royal carpet (flat) from the doors to the throne
	Kit.Box(m, V(-5, 0, 2166), V(5, 0.08, 2248), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5 - 0.4, 0, 2166), V(s * 5 + 0.4, 0.1, 2248), gold, { Mat = FABRIC })
	end
	-- columns
	for _, s in { -1, 1 } do
		for _, z in { 2200, 2222, 2244 } do
			Kit.Cyl(m, 24, 3.2, CFrame.new(s * 36, 12, z), STONE_L, SOLID_SLATE)
			Kit.Box(m, V(s * 36 - 2.2, 24, z - 2.2), V(s * 36 + 2.2, 25.2, z + 2.2), gold, { Mat = METAL })
		end
		banner(m, V(s * 41.8, 15, 2211), 6, 14, -s, 0, ROYAL_RED)
		banner(m, V(s * 41.8, 15, 2233), 6, 14, -s, 0, PURPLE)
	end
	candelabra(m, -30, 2195, true)
	candelabra(m, 30, 2195, false)

	-- the throne on the balcony
	Kit.Box(m, V(-8, 24, 2247.5), V(8, 25.2, 2256), gold, { Mat = METAL })
	Kit.Box(m, V(-5.5, 25.2, 2248), V(5.5, 28.6, 2254), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(-6.5, 25.2, 2253), V(6.5, 46, 2256), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Box(m, V(-7.6, 25.2, 2253.6), V(7.6, 47.6, 2256.3), gold, { Mat = METAL })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5.5, 25.2, 2248), V(s * 7.6, 30.6, 2254), gold, { Mat = METAL })
		Kit.Cyl(m, 3.4, 1.2, CFrame.new(s * 5, 49.3, 2255), gold, { Mat = METAL })
		Kit.Ball(m, 1.6, V(s * 5, 51.4, 2255), Kit.Vivid(ROYAL_RED), { Refl = 0.2 })
	end
	Kit.Cyl(m, 4.4, 1.4, CFrame.new(0, 49.8, 2255), gold, { Mat = METAL })
	local gem = Kit.Ball(m, 2.2, V(0, 52.6, 2255), GHOST_PURPLE, { Mat = NEON })
	Kit.Light(gem, GHOST_PURPLE, 40, 1.8)
	Props.Beam(m, V(-3, 28, 2252.9), V(1, 36, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	Props.Beam(m, V(1, 36, 2252.9), V(-1, 42, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	local mist = Kit.Part(m, V(14, 0.2, 6), CFrame.new(0, 26, 2251), GHOST_PURPLE, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(mist, GHOST_PURPLE, 1.5, 6, 0.4)
	local crown = Kit.Cyl(m, 1.8, 3.4, CFrame.new(0, 58, 2252), gold, { Mat = METAL, Name = "FloatingCrown" })
	Kit.Float(crown, 1.2)

	-- boss area paint: royal disc, gold ring, spectral rune ring (flat)
	Kit.Disc(m, 0, 2220, 0.09, 52, 0.09, gold, { Mat = METAL })
	Kit.Disc(m, 0, 2220, 0.11, 48, 0.11, C(70, 40, 95), { Mat = SLATE })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.1
		local a2 = a1 + math.pi / 4 - 0.2
		Props.Beam(m, V(math.cos(a1) * 20, 0.15, 2220 + math.sin(a1) * 20), V(math.cos(a2) * 20, 0.15, 2220 + math.sin(a2) * 20), 0.5, 0.06, GHOST_PURPLE, { Mat = NEON })
	end
	Kit.AddRect(-46, 2185, 46, 2257)
end

--==================================================================
-- LIBRARY CORNER (+X back)
--==================================================================
local function library(f: Instance)
	local m = Kit.Model(f, "Library")
	local rng = Kit.Rng
	local shelfC = C(92, 60, 42)
	Kit.Box(m, V(74, 0, 2249), V(140, 22, 2253), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2205), V(76, 16, 2230), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2230), V(76, 11, 2249), STONE, SOLID_SLATE)
	Kit.Box(m, V(80, 0, 2160), V(134, 0.06, 2244), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(84, 0, 2164), V(130, 0.08, 2240), C(95, 50, 135), { Mat = FABRIC })
	-- shelves along the back wall (facing -Z), two colours per row
	for _, x in { 84, 100, 116 } do
		Kit.Box(m, V(x - 7, 0, 2245), V(x + 7, 18, 2249), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			local split = rng:NextNumber(-2, 2)
			Kit.Box(m, V(x - 6.3, y, 2244.6), V(x + split, y + 3.6, 2245.1), Kit.Pick(Props.Colors.Book))
			Kit.Box(m, V(x + split, y, 2244.6), V(x + 6.3, y + 3.4, 2245.1), Kit.Pick(Props.Colors.Book))
		end
	end
	-- shelves along the side wall (facing -X)
	for _, z in { 2166, 2184, 2202, 2220 } do
		Kit.Box(m, V(135, 0, z - 7), V(139.5, 18, z + 7), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			Kit.Box(m, V(134.6, y, z - 6.3), V(135.1, y + 3.6, z + 6.3), Kit.Pick(Props.Colors.Book))
		end
	end
	-- ladder
	Props.Beam(m, V(91, 0, 2243.4), V(91.6, 17.5, 2244.6), 0.3, 0.3, shelfC)
	Props.Beam(m, V(93.4, 0, 2243.4), V(94, 17.5, 2244.6), 0.3, 0.3, shelfC)
	-- reading table with candles and a book pile
	Kit.Box(m, V(88, 3, 2190), V(100, 3.8, 2198), shelfC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(89, 0, 2191), V(90, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(98, 0, 2191), V(99, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(90.5, 3.8, 2192), V(93.5, 4.6, 2196), Kit.Vivid(ROYAL_RED))
	Kit.Box(m, V(90.8, 4.6, 2192.4), V(93.2, 5.3, 2195.6), Kit.Vivid(BLUE))
	for i, x in { 96, 98 } do
		Kit.Cyl(m, 1.6, 0.6, CFrame.new(x, 4.6, 2194), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x, 5.7, 2194), WARM, { Mat = NEON })
		if i == 1 then
			Kit.Light(flame, WARM, 24, 1.3, true)
		end
	end
	-- lectern with a giant open spell book
	Kit.Box(m, V(104, 0, 2214), V(107, 4.2, 2217), shelfC, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(6, 0.5, 4.2), CFrame.new(105.5, 4.8, 2215.5) * CFrame.Angles(-0.35, 0, 0), C(250, 245, 230))
	Kit.Part(m, V(2.8, 0.1, 0.25), CFrame.new(105.5, 5.1, 2215.2) * CFrame.Angles(-0.35, 0, 0), SPECTRAL, { Mat = NEON })
	-- floating books and a candle
	Props.FloatingBook(m, V(96, 10, 2214))
	Props.FloatingBook(m, V(112, 12, 2228))
	Props.FloatingBook(m, V(120, 9, 2204))
	Props.FloatingCandle(m, V(106, 10, 2196))
	Props.SignBoard(m, V(100, 20.2, 2248.6), 26, 3.4, 0, -1, "ROYAL LIBRARY - SHHH!", C(50, 35, 80), Kit.Vivid(GOLD), GOLD)
	Kit.AddRect(72, 2146, 140, 2254)
end

--==================================================================
-- COURTYARD FEATURES
--==================================================================
local function fountain(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SpectralFountain")
	Kit.Disc(m, x, z, 2, 14, 2, STONE_L, SOLID_SLATE)
	Kit.Disc(m, x, z, 2.1, 12, 0.2, C(80, 200, 190), { Transp = 0.25, Refl = 0.2 })
	Kit.Cyl(m, 5, 2, CFrame.new(x, 4.5, z), STONE, { Mat = SLATE })
	Kit.Cyl(m, 1, 6, CFrame.new(x, 7.2, z), STONE_L, { Mat = SLATE })
	local orb = Kit.Ball(m, 2.4, V(x, 8.6, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(orb, SPECTRAL, 24, 1.4)
	Kit.Emitter(orb, SPECTRAL, 2, 5, 0.8)
	Kit.AddCircle(x, z, 8)
end

local function swordInStone(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SwordInStone")
	Kit.Ball(m, 8, V(x, -1, z), ROCKC, { Mat = ROCK, Solid = true })
	Kit.Part(m, V(0.8, 9, 0.3), CFrame.new(x, 6.5, z) * CFrame.Angles(0, 0.4, 0.06), SILVER, { Mat = METAL, Refl = 0.2 })
	Kit.Part(m, V(3.2, 0.6, 0.6), CFrame.new(x + 0.6, 10.6, z) * CFrame.Angles(0, 0.4, 0.06), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.6, 2.2, 0.6), CFrame.new(x + 0.66, 12, z) * CFrame.Angles(0, 0.4, 0.06), C(90, 50, 40), { Mat = FABRIC })
	Kit.Ball(m, 0.9, V(x + 0.72, 13.3, z), Kit.Vivid(GOLD), { Mat = METAL })
	Props.SignBoard(m, V(x - 4.5, 2.4, z - 3), 5, 2, -1, -1, "TUG ME?", C(240, 232, 215), Kit.Vivid(PURPLE))
	Kit.AddCircle(x, z, 6)
end

local function scatter(f: Instance)
	local rng = Kit.Rng
	local rubble, barrels, broken = 0, 0, 0
	for _ = 1, 400 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1942, 2272)
		if rubble < 10 and Kit.IsFree(x, z, 3) then
			rubble += 1
			Kit.Ball(f, rng:NextNumber(2.5, 4.5), V(x, -0.4, z), Kit.Pick({ ROCKC, STONE_D, STONE }), { Mat = ROCK, Solid = true })
			Kit.Ball(f, rng:NextNumber(1.4, 2.2), V(x + 2, -0.2, z + 1), STONE_D, { Mat = ROCK })
			Kit.AddCircle(x, z, 3)
		elseif barrels < 7 and Kit.IsFree(x, z, 2.5) then
			barrels += 1
			Kit.Cyl(f, 4, 2.8, CFrame.new(x, 2, z), C(140, 95, 60), { Mat = WOOD, Solid = true })
			Kit.Cyl(f, 0.4, 2.95, CFrame.new(x, 2.8, z), IRON, { Mat = METAL })
			Kit.AddCircle(x, z, 2.5)
		elseif broken < 5 and Kit.IsFree(x, z, 5) then
			broken += 1
			local h = rng:NextNumber(5, 11)
			Kit.Box(f, V(x - 2, 0, z - 2), V(x + 2, 1, z + 2), STONE_D, SOLID_SLATE)
			Kit.Cyl(f, h, 3, CFrame.new(x, 1 + h / 2, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.05, 0.05)), STONE_L, SOLID_SLATE)
			Kit.CylFlat(f, 7, 3, V(x + 1, 1.5, z + 3.5), "X", STONE_L, { Mat = SLATE })
			Kit.AddCircle(x, z, 5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Castle.Build(map: Instance)
	local f = Kit.Folder(map, "Castle")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	cliffs(f)
	gatehouse(f)

	-- ghost-area paint (flat rune circles; the boss circle is painted by the throne room)
	local areas = { { 0, 2005, 30 }, { -82, 2040, 24 }, { 75, 2100, 26 }, { -62, 2160, 24 } }
	for i, a in areas do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, Kit.Vivid(if i % 2 == 0 then PURPLE else BLUE), { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, STONE_L, { Mat = SLATE })
		crack(f, V(a[1] + rng:NextNumber(-8, 8), 0.13, a[2] + rng:NextNumber(-8, 8)), 2)
	end

	-- towers: front corners, side middles, back corners and the two keep towers by the throne
	tower(f, -131, 1968, 18, 56, ROOF)
	tower(f, 131, 1968, 18, 56, ROOF)
	tower(f, -128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, 128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, -128, 2262, 18, 60, ROOF)
	tower(f, 128, 2262, 18, 60, ROOF)
	tower(f, -60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)
	tower(f, 60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)

	throneRoom(f)
	library(f)

	-- courtyard
	for _, p in { { -22, 2062 }, { 22, 2062 }, { -22, 2122 }, { 22, 2122 } } do
		if Kit.IsFree(p[1], p[2], 4) then
			knightStatue(f, p[1], p[2], if p[1] < 0 then 1 else -1, 0)
		end
	end
	if Kit.IsFree(-31, 2092, 8) then
		fountain(f, -31, 2092)
	end
	if Kit.IsFree(32, 2090, 6) then
		swordInStone(f, 32, 2090)
	end
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 16, 2150, 2.5, true) then
			brazier(f, s * 16, 2150)
		end
	end
	for _, p in { { -30, 2181, 0, -1 }, { 30, 2181, 0, -1 }, { -50, 1980, 1, 0 }, { 50, 1980, -1, 0 }, { 68, 2150, -1, 0 }, { -70, 2206, 1, 0 } } do
		if Kit.IsFree(p[1], p[2], 2.5) then
			armor(f, p[1], p[2], p[3], p[4])
		end
	end
	scatter(f)
	for _ = 1, 4 do
		crack(f, V(rng:NextNumber(-120, 120), 0.13, rng:NextNumber(1980, 2180)), 1)
	end
end

return Castle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Cemetery</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 2: Cemetery (Z 260..540). Cobblestone path along X = 0 from gate to gate, a giant
-- mausoleum in the north-west corner (tall dome + glowing spire orb, visible from spawn),
-- small crypts, rows of oversized slate gravestones, twisted trees, lanterns, neon cracks,
-- candy mushrooms, iron fences and slow purple fog. Palette: dark green, stone gray, muted
-- purple, warm lantern orange, ectoplasm green. Glow is kept to the lanterns, candles, crypt
-- doorways, the spire orb and the small ectoplasm cracks.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Cemetery = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local STONES = { C(158, 156, 170), C(140, 146, 150), C(175, 170, 182), C(150, 145, 168), C(128, 136, 138) }
local EPITAPHS = { "RIP", "BRB", "BOO", "LOL", "GG", "AFK", "R.I.P.\nIN PEACE", "BE BACK\nSOON", "NOT\nHERE" }

-- Gable roof with the ridge along local X (slopes toward local ±Z), bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, { Solid = true, Shadow = true })
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, { Solid = true, Shadow = true })
end

local function mausoleum(f: Instance)
	local m = Kit.Model(f, "Mausoleum")
	local stone, light, roof = C(178, 174, 190), C(214, 210, 220), C(92, 74, 128)
	local glow = C(120, 255, 170)
	local mint = Kit.Vivid(glow) -- solid trims in the glow colour
	-- stepped platform
	Kit.Box(m, V(-122, 0, 477), V(-78, 1.2, 513), C(150, 140, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(-120, 1.2, 479), V(-82, 2.4, 511), C(170, 160, 200), { Mat = Enum.Material.Slate, Solid = true })
	-- body (front faces +X toward the path)
	Kit.Box(m, V(-118, 2.4, 482), V(-90, 26, 508), stone, { Mat = Enum.Material.Slate, Solid = true, Name = "Body" })
	-- portico columns
	for i = 0, 4 do
		local z = 483.5 + i * 5.75
		Kit.Cyl(m, 22, 2.6, CFrame.new(-85.5, 13.4, z), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
		Kit.Box(m, V(-87, 2.4, z - 1.6), V(-84, 3.2, z + 1.6), light)
	end
	-- entablature + cornice
	Kit.Box(m, V(-119, 24.4, 480), V(-83, 27, 510), light, { Mat = Enum.Material.Marble, Solid = true })
	Kit.Box(m, V(-83.3, 25, 483), V(-82.9, 26.4, 507), mint)
	-- pediment roof (triangle face toward +X)
	gable(m, CFrame.new(-101, 27, 495), 37, 31, 9, roof)
	-- ectoplasm-filled doorway (solid mint, lit by its own green light)
	Kit.Box(m, V(-90.3, 2.4, 487.5), V(-89.9, 17.5, 502.5), light)
	local door = Kit.Box(m, V(-90.1, 2.4, 489), V(-89.6, 16, 501), mint, { Refl = 0.1 })
	Kit.Light(door, glow, 30, 2)
	-- name plate on the entablature, facing +X
	local plateCF = CFrame.new(-82.7, 25.7, 495) * CFrame.Angles(0, Kit.FaceYaw(1, 0), 0)
	local plate = Kit.Part(m, V(18, 2.4, 0.4), plateCF, C(60, 40, 100))
	Kit.Sign(plate, Enum.NormalId.Front, "REST IN PURPLE", C(150, 255, 170))
	-- drum + dome + spire (tall: visible from spawn)
	Kit.Cyl(m, 12, 15, CFrame.new(-104, 36, 495), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
	Kit.Cyl(m, 1, 16.5, CFrame.new(-104, 42.2, 495), mint)
	Kit.Ball(m, 15, V(-104, 42.5, 495), C(112, 92, 150), { Mat = Enum.Material.Slate, Shadow = true })
	Kit.Cyl(m, 14, 1.4, CFrame.new(-104, 56, 495), C(240, 220, 120))
	local orb = Kit.Ball(m, 4.5, V(-104, 64, 495), glow, { Mat = NEON })
	Kit.Light(orb, glow, 40, 1.5)
	Kit.Emitter(orb, glow, 2, 4, 0.8)
	-- corner obelisks
	for _, x in { -121, -79 } do
		for _, z in { 476, 514 } do
			Kit.Box(m, V(x - 1.2, 0, z - 1.2), V(x + 1.2, 12, z + 1.2), light, { Mat = Enum.Material.Slate, Solid = true })
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z - 0.6), light)
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z + 0.6) * CFrame.Angles(0, math.pi, 0), light)
			Kit.Ball(m, 1.6, V(x, 14.6, z), mint)
		end
	end
	-- floating candles by the door
	for i = 0, 3 do
		Props.FloatingCandle(m, V(-80, 8 + (i % 2) * 2.5, 486 + i * 6))
	end
	Kit.AddRect(-124, 474, -76, 516)
end

local function crypt(f: Instance, cx: number, cz: number, fx: number, fz: number, flicker: boolean)
	local m = Kit.Model(f, "Crypt")
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = Kit.Pick(STONES)
	Kit.Part(m, V(15, 1, 13), base * CFrame.new(0, 0.5, 0), C(120, 122, 130), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(12, 10, 10), base * CFrame.new(0, 6, 0), stone, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- roof ridge runs front-to-back (local Z) so the triangle faces the front
	gable(m, base * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.pi / 2, 0), 12, 14, 5, C(96, 78, 132))
	local glow = Kit.Pick({ C(120, 255, 170), C(200, 130, 255) })
	local door = Kit.Part(m, V(4.4, 7, 0.4), base * CFrame.new(0, 4.5, -5.1), glow, { Mat = NEON, Transp = 0.15 })
	local trim: Kit.Opts = { Mat = Enum.Material.Marble }
	Kit.Part(m, V(5.6, 8.2, 0.3), base * CFrame.new(0, 4.6, -5.05), C(214, 210, 220), trim)
	Kit.Part(m, V(1, 3.6, 0.6), base * CFrame.new(0, 13.5, -6.3), C(214, 210, 220), trim)
	Kit.Part(m, V(2.6, 1, 0.6), base * CFrame.new(0, 14.2, -6.3), C(214, 210, 220), trim)
	if flicker then
		Kit.Light(door, glow, 16, 1.4, true)
	end
	Props.FloatingCandle(m, (base * CFrame.new(-4, 7.5, -7.5)).Position)
	Kit.AddCircle(cx, cz, 10)
end

local function gravestone(f: Instance, x: number, z: number)
	local rng = Kit.Rng
	local w = rng:NextNumber(3.6, 5.2)
	local h = rng:NextNumber(3.5, 6)
	local yaw = rng:NextNumber(-0.25, 0.25)
	local tilt = rng:NextNumber(-0.08, 0.08)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt, 0, tilt * 0.5)
	local col = Kit.Pick(STONES)
	local kind = rng:NextInteger(1, 6)
	if kind == 6 then
		-- cross
		Kit.Part(f, V(1.4, h + 2, 1), base * CFrame.new(0, (h + 2) / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Part(f, V(w * 0.8, 1.2, 1), base * CFrame.new(0, h * 0.75 + 0.6, 0), col, { Mat = Enum.Material.Slate })
	else
		local slab = Kit.Part(f, V(w, h, 1.2), base * CFrame.new(0, h / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
		Kit.Part(f, V(1.2, w, w), base * CFrame.new(0, h, 0) * CFrame.Angles(0, math.pi / 2, 0), col, { Mat = Enum.Material.Slate, Shape = Enum.PartType.Cylinder })
		if kind <= 2 then
			Kit.Sign(slab, Enum.NormalId.Front, Kit.Pick(EPITAPHS), C(90, 60, 130), { Stroke = C(235, 235, 240), Font = Enum.Font.GothamBlack })
		elseif kind == 3 then
			Kit.Part(f, V(w * 0.5, 0.3, 0.2), base * CFrame.new(0, h * 0.55, -0.65), Kit.Vivid(C(120, 255, 170)))
		end
	end
	-- little dirt mound in front
	Kit.Part(f, V(w + 0.6, 0.4, 3.4), base * CFrame.new(0, 0.1, -2.4), C(92, 78, 70), { Mat = Enum.Material.Ground })
	Kit.AddCircle(x, z, 2.5)
end

function Cemetery.Build(map: Instance)
	local f = Kit.Folder(map, "Cemetery")
	local rng = Kit.Rng

	-- main path + branch to the mausoleum
	Kit.Box(f, V(-8, -0.4, 260), V(8, 0.1, 540), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "Path" })
	Kit.Box(f, V(-80, -0.4, 490), V(-8, 0.08, 500), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true })
	local edging = Kit.Vivid(C(120, 255, 170))
	for z = 270, 530, 20 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 8, 0.1, z), V(s * 8.6, 0.25, z + 10), edging)
		end
	end
	Kit.AddRect(-9, 260, 9, 540, true)
	Kit.AddRect(-80, 489, -8, 501, true)

	mausoleum(f)
	crypt(f, 112, 300, -1, 0, true)
	crypt(f, -110, 345, 1, 0, true)
	crypt(f, 116, 500, -1, 0, false)
	crypt(f, -116, 392, 1, 0, false)

	-- lanterns along the path
	local lit = 0
	for z = 280, 530, 30 do
		for _, s in { -1, 1 } do
			local x = s * 10.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				-- warm orange lanterns on the left, ectoplasm green on the right
				Props.Lantern(f, V(x, 0, z), if s < 0 then C(255, 170, 80) else C(140, 255, 170), lit % 3 == 1 and lit <= 10)
				Kit.AddCircle(x, z, 1.5)
			end
		end
	end

	-- twisted trees (tall ones near the back so they show over the wall from spawn)
	local treeSpots = {
		{ -125, 280, 26 }, { 126, 285, 24 }, { -100, 300, 30 }, { 45, 292, 22 }, { -30, 380, 26 }, { 110, 410, 30 },
		{ 128, 430, 34 }, { -128, 455, 36 }, { 30, 470, 28 }, { 100, 470, 34 }, { -60, 522, 38 }, { 60, 525, 40 },
		{ -128, 525, 34 }, { 128, 525, 36 },
	}
	for _, t in treeSpots do
		if Kit.IsFree(t[1], t[2], 4) then
			Props.TwistedTree(f, V(t[1], 0, t[2]), t[3])
		end
	end

	-- gravestone field on a jittered grid
	for gx = -128, 128, 11 do
		for gz = 272, 532, 12 do
			local x = gx + rng:NextNumber(-2, 2)
			local z = gz + rng:NextNumber(-2, 2)
			if rng:NextNumber() < 0.45 and Kit.IsFree(x, z, 4.2) then -- the dirt mound reaches ~4 studs
				gravestone(f, x, z)
			end
		end
	end

	-- iron fences around the mausoleum yard and a few decorative runs
	Props.Fence(f, V(-126, 0, 472), V(-84, 0, 472), "iron")
	Props.Fence(f, V(-126, 0, 518), V(-84, 0, 518), "iron")
	Props.Fence(f, V(-133, 0, 300), V(-133, 0, 330), "iron")
	Props.Fence(f, V(133, 0, 330), V(133, 0, 360), "iron")

	-- neon ectoplasm cracks in the ground (flat, fine inside ghost areas)
	for _ = 1, 16 do
		local p = V(rng:NextNumber(-120, 120), 0.1, rng:NextNumber(275, 530))
		local a = rng:NextNumber(0, math.pi * 2)
		for _ = 1, 3 do
			a += rng:NextNumber(-1, 1)
			local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(3, 6)
			Props.Beam(f, p, q, 0.5, 0.12, C(120, 255, 170), { Mat = NEON })
			p = q
		end
	end

	-- glowing mushrooms
	local shrooms = 0
	for _ = 1, 200 do
		if shrooms >= 14 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(270, 530)
		if Kit.IsFree(x, z, 2.5) then
			shrooms += 1
			Props.Mushrooms(f, V(x, 0, z))
			Kit.AddCircle(x, z, 2.5)
		end
	end

	-- slow purple fog
	for _, p in { V(-40, 0, 300), V(40, 0, 395), V(-95, 0, 470), V(95, 0, 330), V(30, 0, 520) } do
		Props.Wisp(f, p, C(170, 110, 255), 14, true)
	end
	for _, p in { V(-60, 0, 360), V(80, 0, 500), V(-20, 0, 460) } do
		Props.Wisp(f, p, C(120, 255, 170), 10, false)
	end
end

return Cemetery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Clockwork</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 14: Clockwork Tower (Z 4480..4840). A steampunk town square in brass, copper and wood.
--   Ground: cobblestone slab + brick lane along X = 0 with brass edging.
--   Ghost areas get flat gear-shaped plazas ((0,4565) r30, (-82,4600) r24, (75,4660) r26,
--   (-62,4720) r24); the boss area (0,4785) r26 is a giant clock face painted on the square.
--   Cogwheel bridges over the lane at Z 4625 and Z 4745 (deck bottom Y 30).
--   Landmark seen from the Sunken City: the clock tower at (64, 4808), spire tip ~Y 150.
--   Shops along the sides, brass lamp posts, a gear monument, a grandfather clock, giant
--   gears and steam pipes on the side walls (brick, X +-140..146), a chimney skyline and an
--   airship outside.
-- Glow: lamp globes, a couple of shop windows, the tower clock and the monument gem.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Clockwork = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local BRICK = Enum.Material.Brick
local COBBLE = Enum.Material.Cobblestone
local WOOD = Enum.Material.WoodPlanks

local Z0, Z1 = 4480, 4840

local BRASS = C(215, 170, 85)
local BRASS_D = C(170, 130, 70)
local COPPER = C(190, 110, 70)
local VERDI = C(90, 175, 160) -- teal verdigris accents
local BROWN = C(120, 80, 55)
local BRICKC = C(160, 95, 70)
local CREAM = C(240, 225, 190)
local COBBLEC = C(150, 132, 118)
local DARK = C(55, 40, 35)
local WARM = C(255, 210, 130)
local IRON = C(70, 62, 60)

local SOLID_BRICK: Kit.Opts = { Mat = BRICK, Solid = true, Shadow = true }
local BRASS_M: Kit.Opts = { Mat = METAL }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
-- Gear standing upright: axis "X" (faces +-X) or "Z" (faces +-Z). pos = centre.
local function gear(parent: Instance, pos: Vector3, d: number, axis: string, color: Color3, teeth: number, thick: number?)
	local t = thick or 1.2
	local R = d / 2
	local tooth = math.max(1, d * 0.12)
	Kit.CylFlat(parent, t, d, pos, axis, color, BRASS_M)
	Kit.CylFlat(parent, t + 0.3, d * 0.62, pos, axis, color:Lerp(Color3.new(0, 0, 0), 0.18), BRASS_M)
	Kit.CylFlat(parent, t + 0.8, d * 0.22, pos, axis, Kit.Vivid(COPPER), BRASS_M)
	for i = 0, teeth - 1 do
		local a = i * math.pi * 2 / teeth
		if axis == "X" then
			Kit.Part(parent, V(t, tooth, tooth * 1.1), CFrame.new(pos + V(0, math.sin(a), math.cos(a)) * (R + tooth * 0.35)) * CFrame.Angles(math.pi / 2 - a, 0, 0), color, BRASS_M)
		else
			Kit.Part(parent, V(tooth * 1.1, tooth, t), CFrame.new(pos + V(math.cos(a), math.sin(a), 0) * (R + tooth * 0.35)) * CFrame.Angles(0, 0, a - math.pi / 2), color, BRASS_M)
		end
	end
end

-- Clock face facing (nx, nz); pos = centre of the face.
local function clockFace(parent: Instance, pos: Vector3, d: number, nx: number, nz: number, glow: boolean)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(nx, nz), 0)
	local axisZ = CFrame.Angles(0, math.pi / 2, 0)
	Kit.Part(parent, V(1, d + 2, d + 2), cf * axisZ, Kit.Vivid(BRASS), { Mat = METAL, Shape = Enum.PartType.Cylinder })
	local faceOpts: Kit.Opts = if glow then { Mat = NEON, Shape = Enum.PartType.Cylinder } else { Shape = Enum.PartType.Cylinder }
	local face = Kit.Part(parent, V(0.4, d, d), cf * CFrame.new(0, 0, -0.6) * axisZ, if glow then C(255, 240, 200) else CREAM, faceOpts)
	if d >= 8 then
		local panel = Kit.Part(parent, V(d * 0.9, d * 0.9, 0.05), cf * CFrame.new(0, 0, -0.85), CREAM, { Transp = 1, Name = "ClockNumerals" })
		local gui = Kit.Gui(panel, Enum.NormalId.Front, 20)
		local ink = C(70, 45, 30)
		local st = CREAM
		Kit.Label(gui, "XII", ink, { Pos = UDim2.fromScale(0.38, 0.02), Size = UDim2.fromScale(0.24, 0.15), Stroke = st })
		Kit.Label(gui, "III", ink, { Pos = UDim2.fromScale(0.8, 0.43), Size = UDim2.fromScale(0.18, 0.14), Stroke = st })
		Kit.Label(gui, "VI", ink, { Pos = UDim2.fromScale(0.4, 0.84), Size = UDim2.fromScale(0.2, 0.14), Stroke = st })
		Kit.Label(gui, "IX", ink, { Pos = UDim2.fromScale(0.02, 0.43), Size = UDim2.fromScale(0.18, 0.14), Stroke = st })
	end
	Kit.Part(parent, V(d * 0.05, d * 0.4, 0.15), cf * CFrame.new(0, d * 0.18, -1), DARK)
	Kit.Part(parent, V(d * 0.07, d * 0.28, 0.15), cf * CFrame.new(0, 0, -1.1) * CFrame.Angles(0, 0, 1.0) * CFrame.new(0, d * 0.12, 0), DARK)
	Kit.Ball(parent, d * 0.09, (cf * CFrame.new(0, 0, -1.1)).Position, Kit.Vivid(BRASS), BRASS_M)
	return face
end

local function lamp(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "BrassLamp")
	Kit.Disc(m, x, z, 1, 2.6, 1, BRASS_D, BRASS_M)
	Kit.Cyl(m, 12, 0.7, CFrame.new(x, 7, z), IRON, BRASS_M)
	Kit.Cyl(m, 0.6, 2.8, CFrame.new(x, 13.2, z), Kit.Vivid(BRASS), BRASS_M)
	local globe = Kit.Ball(m, 2.4, V(x, 14.6, z), WARM, { Mat = NEON })
	Kit.Cyl(m, 0.8, 3, CFrame.new(x, 16.1, z), Kit.Vivid(COPPER), BRASS_M)
	Kit.Ball(m, 0.8, V(x, 16.9, z), Kit.Vivid(BRASS), BRASS_M)
	if light then
		Kit.Light(globe, WARM, 24, 1.5)
	end
	Kit.AddCircle(x, z, 2)
end

local function shop(f: Instance, x: number, z: number, w: number, d: number, h: number, wall: Color3, roof: Color3, name: string, glow: boolean)
	local m = Kit.Model(f, "Shop")
	local fx = if x > 0 then -1 else 1
	local front = x + fx * w / 2
	Kit.Box(m, V(x - w / 2, 0, z - d / 2), V(x + w / 2, h, z + d / 2), wall, SOLID_BRICK)
	Kit.Box(m, V(x - w / 2 - 0.4, 0, z - d / 2 - 0.4), V(x + w / 2 + 0.4, 1.6, z + d / 2 + 0.4), DARK, { Mat = Enum.Material.Slate })
	Kit.Box(m, V(x - w / 2 - 1, h, z - d / 2 - 1), V(x + w / 2 + 1, h + 1.2, z + d / 2 + 1), CREAM, { Mat = WOOD })
	-- gable roof (ridge along Z)
	local rh = w * 0.35
	for _, s in { -1, 1 } do
		local cf = CFrame.new(x + s * (w / 2 + 1) / 2, h + 1.2 + rh / 2, z) * CFrame.Angles(0, Kit.FaceYaw(s, 0), 0)
		Kit.Wedge(m, V(d + 2, rh, w / 2 + 1), cf, roof, { Mat = METAL, Shadow = true })
	end
	-- front: door, round window, two square windows, sign, gear
	local fcf = CFrame.new(front, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	Kit.Part(m, V(5, 8, 0.4), fcf * CFrame.new(0, 4, -0.2), BROWN, { Mat = WOOD })
	Kit.Part(m, V(6, 0.8, 0.6), fcf * CFrame.new(0, 8.4, -0.3), Kit.Vivid(BRASS), BRASS_M)
	local winOpts: Kit.Opts = if glow then { Mat = NEON } else { Refl = 0.2 }
	local winC = if glow then WARM else C(150, 205, 200)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(4.6, 5.6, 0.5), fcf * CFrame.new(s * d / 4, h * 0.42, -0.1), Kit.Vivid(BRASS), BRASS_M)
		Kit.Part(m, V(3.8, 4.8, 0.3), fcf * CFrame.new(s * d / 4, h * 0.42, -0.3), winC, winOpts)
	end
	Kit.Part(m, V(0.5, 6.6, 6.6), fcf * CFrame.new(0, h * 0.75, -0.1) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(BRASS), { Mat = METAL, Shape = Enum.PartType.Cylinder })
	Kit.Part(m, V(0.5, 5.4, 5.4), fcf * CFrame.new(0, h * 0.75, -0.3) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(VERDI), { Refl = 0.2, Shape = Enum.PartType.Cylinder })
	Props.SignBoard(m, (fcf * CFrame.new(0, 10.4, -0.5)).Position, math.min(d - 4, 16), 2.4, fx, 0, name, DARK, Kit.Vivid(BRASS))
	gear(m, V(front + fx * 0.4, h - 3.5, z - d / 2 + 4), 5, "X", Kit.Vivid(COPPER), 8, 0.6)
	-- chimney
	local cx, cz = x - fx * w / 4, z + d / 4
	Kit.Cyl(m, 12, 2.8, CFrame.new(cx, h + rh * 0.5 + 6, cz), BRICKC, { Mat = BRICK })
	local cap = Kit.Cyl(m, 1, 3.6, CFrame.new(cx, h + rh * 0.5 + 12.5, cz), Kit.Vivid(COPPER), BRASS_M)
	Kit.AddRect(x - w / 2 - 1, z - d / 2 - 1, x + w / 2 + 1, z + d / 2 + 1)
	return cap
end

--==================================================================
-- GROUND, PLAZAS, WALLS, OUTSIDE
--==================================================================
local function gearPlaza(f: Instance, x: number, z: number, r: number, rim: Color3)
	local n = math.floor(r * 0.5)
	for i = 0, n - 1 do
		local a = i * math.pi * 2 / n
		Kit.Part(f, V(5, 0.06, 6), CFrame.new(x + math.cos(a) * (r + 3.5), 0.03, z + math.sin(a) * (r + 3.5)) * CFrame.Angles(0, -a, 0), rim, BRASS_M)
	end
	Kit.Disc(f, x, z, 0.07, r * 2 + 4, 0.07, rim, BRASS_M)
	Kit.Disc(f, x, z, 0.1, r * 2 - 4, 0.1, CREAM, { Mat = COBBLE })
	Kit.Disc(f, x, z, 0.13, 14, 0.13, Kit.Vivid(COPPER), BRASS_M)
	Kit.Disc(f, x, z, 0.16, 6, 0.16, Kit.Vivid(VERDI), BRASS_M)
	for i = 0, 3 do
		local a = i * math.pi / 2 + 0.4
		Props.Beam(f, V(x + math.cos(a) * 7, 0.12, z + math.sin(a) * 7), V(x + math.cos(a) * (r - 2.5), 0.12, z + math.sin(a) * (r - 2.5)), 1.6, 0.04, rim, BRASS_M)
	end
end

local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), COBBLEC, { Mat = COBBLE, Solid = true, Name = "Ground_Clockwork" })
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), C(176, 110, 82), { Mat = BRICK, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, Z0), V(s * 10, 0.08, Z1), Kit.Vivid(BRASS), BRASS_M)
	end
	for i, a in AREAS do
		gearPlaza(f, a[1], a[2], a[3], Kit.Vivid(if i % 2 == 0 then COPPER else BRASS))
	end
	-- boss: a giant clock face painted on the square
	local gold = Kit.Vivid(BRASS)
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, gold, BRASS_M)
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, CREAM, { Mat = Enum.Material.Marble })
	for i = 0, 11 do
		local a = i * math.pi / 6
		local big = i % 3 == 0
		Kit.Part(f, V(if big then 2 else 1.2, 0.04, if big then 5 else 3), CFrame.new(math.cos(a) * 23, 0.12, BOSS_Z + math.sin(a) * 23) * CFrame.Angles(0, -a + math.pi / 2, 0), DARK)
	end
	Props.Beam(f, V(0, 0.14, BOSS_Z), V(0, 0.14, BOSS_Z - 20), 1.6, 0.04, DARK)
	Props.Beam(f, V(0, 0.15, BOSS_Z), V(-11, 0.15, BOSS_Z - 6), 2.2, 0.04, DARK)
	Kit.Disc(f, 0, BOSS_Z, 0.18, 5, 0.06, gold, BRASS_M)
end

local function sideWalls(f: Instance)
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 30, z1), BRICKC, SOLID_BRICK)
		Kit.Box(f, V(s * 139.5, 30, z0), V(s * 146.5, 31.4, z1), Kit.Vivid(COPPER), BRASS_M)
		Kit.Box(f, V(s * 139.6, 0, z0), V(s * 140, 2.4, z1), DARK, { Mat = Enum.Material.Slate })
		for z = Z0 + 40, Z1 - 20, 40 do
			Kit.Box(f, V(s * 137.6, 0, z - 2), V(s * 140, 32, z + 2), CREAM, { Mat = Enum.Material.Concrete, Solid = true })
		end
		-- steam pipe along the wall with flanges and a valve
		Kit.CylFlat(f, z1 - z0, 2.4, V(s * 138.4, 5, (z0 + z1) / 2), "Z", Kit.Vivid(COPPER), BRASS_M)
		for z = Z0 + 20, Z1 - 20, 40 do
			Kit.CylFlat(f, 0.8, 3.2, V(s * 138.4, 5, z), "Z", Kit.Vivid(BRASS), BRASS_M)
		end
		-- giant gears on the inner face
		for i, g in { { Z0 + 100, 26, 21 }, { Z0 + 220, 30, 19 }, { Z0 + 320, 24, 22 } } do
			gear(f, V(s * 139.2, g[3], g[1]), g[2], "X", Kit.Vivid(if (i + (if s > 0 then 1 else 0)) % 2 == 0 then COPPER else BRASS), 9)
		end
	end
	-- steam vent stack on the west wall
	Kit.Cyl(f, 26, 1.8, CFrame.new(-137.8, 18, Z0 + 170), Kit.Vivid(COPPER), BRASS_M)
	Kit.CylFlat(f, 0.5, 3.4, V(-136.6, 7, Z0 + 170), "X", Kit.Vivid(VERDI), BRASS_M)
	local vent = Kit.Cyl(f, 1, 2.6, CFrame.new(-137.8, 31.5, Z0 + 170), Kit.Vivid(BRASS), BRASS_M)
	local e = Kit.Emitter(vent, C(240, 240, 245), 4, 5, 2.5)
	if e then
		e.Acceleration = V(0, 2, 0)
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local walls = { C(150, 95, 70), C(130, 100, 80), C(170, 120, 85), C(120, 85, 70) }
	for i = 0, 4 do
		local z = Z0 + 30 + i * 75
		for _, s in { -1, 1 } do
			local w, h = rng:NextNumber(18, 26), rng:NextNumber(28, 48)
			local x = s * (150 + w / 2 + rng:NextNumber(0, 10))
			local col = Kit.Pick(walls)
			Kit.Box(f, V(x - w / 2, 0, z - 12), V(x + w / 2, h, z + 12), col, { Mat = BRICK })
			Kit.Wedge(f, V(w, 8, 12), CFrame.new(x, h + 4, z - 6), Kit.Vivid(if i % 2 == 0 then COPPER else VERDI), BRASS_M)
			Kit.Wedge(f, V(w, 8, 12), CFrame.new(x, h + 4, z + 6) * CFrame.Angles(0, math.pi, 0), Kit.Vivid(if i % 2 == 0 then COPPER else VERDI), BRASS_M)
			local ch = rng:NextNumber(14, 24)
			Kit.Cyl(f, ch, 3, CFrame.new(x + s * 4, h + ch / 2, z + 6), BRICKC, { Mat = BRICK })
		end
	end
	-- airship drifting over the east rooftops
	local a = V(196, 82, Z0 + 170)
	Kit.CylFlat(f, 44, 18, a, "Z", C(205, 90, 75), { Mat = Enum.Material.Fabric })
	Kit.Ball(f, 18, a + V(0, 0, -22), C(205, 90, 75), { Mat = Enum.Material.Fabric })
	Kit.Ball(f, 18, a + V(0, 0, 22), C(205, 90, 75), { Mat = Enum.Material.Fabric })
	for _, dz in { -12, 0, 12 } do
		Kit.CylFlat(f, 18.6, 1, a + V(0, 0, dz), "X", Kit.Vivid(BRASS), BRASS_M)
	end
	Kit.Box(f, a + V(-4, -15, -9), a + V(4, -10, 9), BROWN, { Mat = WOOD })
	Kit.Wedge(f, V(0.6, 10, 8), CFrame.new(a + V(0, 4, 30)), Kit.Vivid(VERDI))
	gear(f, a + V(0, -12.5, 10.5), 6, "Z", Kit.Vivid(BRASS), 8, 0.6)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function clockTower(f: Instance)
	local m = Kit.Model(f, "ClockTower")
	local x, z = 64, Z0 + 328
	local gold = Kit.Vivid(BRASS)
	Kit.Box(m, V(x - 13, 0, z - 13), V(x + 13, 10, z + 13), C(130, 110, 100), { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 11, 10, z - 11), V(x + 11, 80, z + 11), BRICKC, SOLID_BRICK)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Box(m, V(x + sx * 11 - 1.6, 10, z + sz * 11 - 1.6), V(x + sx * 11 + 1.6, 80, z + sz * 11 + 1.6), CREAM, { Mat = Enum.Material.Concrete })
		end
	end
	for _, y in { 40, 79 } do
		Kit.Box(m, V(x - 12, y, z - 12), V(x + 12, y + 1.6, z + 12), Kit.Vivid(COPPER), BRASS_M)
	end
	-- clock stage with four faces
	Kit.Box(m, V(x - 13, 80.6, z - 13), V(x + 13, 102, z + 13), CREAM, { Mat = Enum.Material.Concrete, Shadow = true })
	local front = clockFace(m, V(x, 91, z - 13.6), 18, 0, -1, true)
	Kit.Light(front, WARM, 40, 1.5)
	clockFace(m, V(x - 13.6, 91, z), 18, -1, 0, false)
	clockFace(m, V(x + 13.6, 91, z), 18, 1, 0, false)
	clockFace(m, V(x, 91, z + 13.6), 18, 0, 1, false)
	-- belfry with a big brass bell
	Kit.Box(m, V(x - 13, 102, z - 13), V(x + 13, 103, z + 13), Kit.Vivid(COPPER), BRASS_M)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Box(m, V(x + sx * 11.5 - 1.5, 103, z + sz * 11.5 - 1.5), V(x + sx * 11.5 + 1.5, 115, z + sz * 11.5 + 1.5), CREAM, { Mat = Enum.Material.Concrete })
		end
	end
	Kit.Ball(m, 9, V(x, 108, z), gold, BRASS_M)
	Kit.Cyl(m, 1.2, 10, CFrame.new(x, 104.4, z), gold, BRASS_M)
	-- stepped copper roof, spire and a gear weathervane
	local sizes = { 28, 22, 16, 10, 5 }
	for i, s in sizes do
		local y = 115 + (i - 1) * 4
		Kit.Box(m, V(x - s / 2, y, z - s / 2), V(x + s / 2, y + 4, z + s / 2), Kit.Vivid(if i % 2 == 1 then VERDI else COPPER), { Mat = METAL, Shadow = true })
	end
	Kit.Cyl(m, 12, 1, CFrame.new(x, 141, z), gold, BRASS_M)
	gear(m, V(x, 149, z), 6, "Z", gold, 8, 0.6)
	-- big gear on the front of the shaft, door and sign toward the lane
	gear(m, V(x, 58, z - 11.8), 16, "Z", Kit.Vivid(BRASS), 12)
	Kit.Box(m, V(x - 13.4, 0, z - 5), V(x - 13, 9, z + 5), BROWN, { Mat = WOOD })
	Kit.Box(m, V(x - 13.6, 9, z - 6), V(x - 13, 10, z + 6), gold, BRASS_M)
	Props.SignBoard(m, V(x - 13.7, 13, z), 18, 3, -1, 0, "TICK-TOCK TOWER", DARK, gold)
	Kit.AddRect(x - 14, z - 14, x + 14, z + 14)
end

local function cogBridge(f: Instance, z: number, title: string)
	local m = Kit.Model(f, "CogBridge")
	local gold = Kit.Vivid(BRASS)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16, 0, z - 4.5), V(s * 26, 34, z + 4.5), BRICKC, SOLID_BRICK)
		Kit.Box(m, V(s * 15.6, 0, z - 4.9), V(s * 26.4, 3, z + 4.9), DARK, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(m, V(s * 15.6, 34, z - 4.9), V(s * 26.4, 35.4, z + 4.9), Kit.Vivid(COPPER), BRASS_M)
		gear(m, V(s * 21, 18, z - 4.9), 8, "Z", gold, 8, 0.6)
		Kit.AddRect(s * 15.5, z - 5, s * 26.5, z + 5)
	end
	-- deck (bottom Y 30) with brass railings and a big cog standing on it
	Kit.Box(m, V(-16, 30, z - 3), V(16, 32.4, z + 3), BROWN, { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Box(m, V(-16, 29.6, z - 3.3), V(16, 30.2, z + 3.3), gold, BRASS_M)
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(-16, 34.6, z + sz * 2.8 - 0.25), V(16, 35.1, z + sz * 2.8 + 0.25), gold, BRASS_M)
		for x = -14, 14, 7 do
			Kit.Box(m, V(x - 0.2, 32.4, z + sz * 2.8 - 0.2), V(x + 0.2, 34.6, z + sz * 2.8 + 0.2), gold, BRASS_M)
		end
	end
	gear(m, V(0, 39, z), 12, "Z", Kit.Vivid(COPPER), 10, 1)
	Props.SignBoard(m, V(0, 31.2, z - 3.4), 18, 2.2, 0, -1, title, DARK, gold)
end

local function gearMonument(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GearMonument")
	Kit.Box(m, V(x - 7, 0, z - 3.5), V(x + 7, 3, z + 3.5), C(130, 110, 100), { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1, 3, z - 1), V(x + 1, 11, z + 1), IRON, BRASS_M)
	gear(m, V(x - 1.5, 13, z), 16, "Z", Kit.Vivid(BRASS), 12)
	gear(m, V(x + 9.2, 6.8, z + 0.4), 8, "Z", Kit.Vivid(COPPER), 8)
	local gem = Kit.Ball(m, 2.2, V(x - 1.5, 13, z - 1.2), Kit.Vivid(VERDI), { Mat = NEON })
	Kit.Light(gem, C(150, 255, 230), 24, 1.2)
	Props.SignBoard(m, V(x, 1.6, z - 3.7), 9, 1.8, 0, -1, "THE GREAT COG", DARK, Kit.Vivid(BRASS))
	Kit.AddCircle(x, z, 10)
end

local function grandfatherClock(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GrandfatherClock")
	Kit.Box(m, V(x - 3.4, 0, z - 2.4), V(x + 3.4, 2, z + 2.4), BROWN, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(x - 2.6, 2, z - 1.8), V(x + 2.6, 17, z + 1.8), C(140, 90, 60), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1.6, 4, z - 1.95), V(x + 1.6, 14, z - 1.8), C(150, 205, 200), { Transp = 0.4, Refl = 0.2 })
	Kit.Box(m, V(x - 0.15, 8, z - 1.4), V(x + 0.15, 14, z - 1.2), Kit.Vivid(BRASS), BRASS_M)
	Kit.CylFlat(m, 0.3, 2.4, V(x, 7.6, z - 1.3), "Z", Kit.Vivid(BRASS), BRASS_M)
	Kit.Box(m, V(x - 3.4, 17, z - 2.4), V(x + 3.4, 24, z + 2.4), C(140, 90, 60), { Mat = WOOD, Shadow = true })
	clockFace(m, V(x, 20.5, z - 2.9), 5, 0, -1, false)
	Kit.Wedge(m, V(7.4, 2.6, 2.6), CFrame.new(x, 25.3, z - 1.3), BROWN, { Mat = WOOD })
	Kit.Wedge(m, V(7.4, 2.6, 2.6), CFrame.new(x, 25.3, z + 1.3) * CFrame.Angles(0, math.pi, 0), BROWN, { Mat = WOOD })
	Kit.Ball(m, 1.4, V(x, 27, z), Kit.Vivid(BRASS), BRASS_M)
	Kit.AddCircle(x, z, 4.5)
end

local function floaters(f: Instance)
	for _, p in { V(40, 22, Z0 + 120), V(-40, 26, Z0 + 200), V(110, 24, Z0 + 120), V(-112, 28, Z0 + 280), V(-22, 20, Z0 + 340), V(96, 30, Z0 + 296) } do
		local g = Kit.CylFlat(f, 0.6, 3.4, p, "Z", Kit.Vivid(Kit.Pick({ BRASS, COPPER, VERDI })), { Mat = METAL, Name = "FloatingCog" })
		Kit.Float(g, 1.4)
	end
end

local function decor(f: Instance)
	local rng = Kit.Rng
	local wallCols = { C(160, 95, 70), C(190, 150, 110), C(140, 110, 90), C(175, 120, 85) }
	local roofs = { Kit.Vivid(VERDI), Kit.Vivid(COPPER), C(110, 70, 60) }
	type ShopDef = { X: number, Z: number, W: number, D: number, H: number, Name: string, Glow: boolean }
	local shops: { ShopDef } = {
		{ X = 92, Z = Z0 + 60, W = 34, D = 28, H = 18, Name = "GEARS & CO.", Glow = false },
		{ X = -100, Z = Z0 + 55, W = 32, D = 26, H = 16, Name = "TEA & TICKS", Glow = true },
		{ X = 112, Z = Z0 + 250, W = 28, D = 32, H = 20, Name = "CHRONO CURIOS", Glow = false },
		{ X = -110, Z = Z0 + 180, W = 26, D = 30, H = 17, Name = "BOLT BAKERY", Glow = false },
		{ X = -104, Z = Z0 + 318, W = 32, D = 28, H = 19, Name = "STEAM WORKS", Glow = false },
	}
	local smokeCap: Part? = nil
	for i, s in shops do
		if Kit.IsFree(s.X, s.Z, math.max(s.W, s.D) / 2 + 1) then
			local cap = shop(f, s.X, s.Z, s.W, s.D, s.H, wallCols[(i - 1) % #wallCols + 1], roofs[(i - 1) % #roofs + 1], s.Name, s.Glow)
			if i == 5 then
				smokeCap = cap
			end
			if s.Glow then
				-- the glowing tea shop gets a cosy flickering light just inside its front
				local fx = if s.X > 0 then -1 else 1
				local win = Kit.Part(f, V(1, 1, 1), CFrame.new(s.X + fx * (s.W / 2 - 1), 7, s.Z), WARM, { Transp = 1, Name = "ShopGlow" })
				Kit.Light(win, WARM, 22, 1.3, true)
			end
		end
	end
	if smokeCap then
		local e = Kit.Emitter(smokeCap, C(230, 225, 220), 3, 5, 2)
		if e then
			e.Acceleration = V(0, 1.5, 0)
		end
	end
	-- lamp posts along the lane
	local lit = 0
	for _, z in { Z0 + 40, Z0 + 125, Z0 + 175, Z0 + 225 } do
		for _, sx in { -1, 1 } do
			local x = sx * 13.5
			if Kit.IsFree(x, z, 2.5) then
				local light = lit < 3 and ((z == Z0 + 40 and sx > 0) or (z == Z0 + 175 and sx < 0) or (z == Z0 + 225 and sx > 0))
				if light then
					lit += 1
				end
				lamp(f, x, z, light)
			end
		end
	end
	if Kit.IsFree(-30, Z0 + 180, 10) then
		gearMonument(f, -30, Z0 + 180)
	end
	if Kit.IsFree(32, Z0 + 225, 5) then
		grandfatherClock(f, 32, Z0 + 225)
	end
	-- crates, barrels and loose cogs
	local crates, barrels = 0, 0
	for _ = 1, 300 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 10)
		if crates < 8 and Kit.IsFree(x, z, 3) then
			crates += 1
			local s = rng:NextNumber(3, 4.5)
			Kit.Part(f, V(s, s, s), CFrame.new(x, s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), C(170, 125, 80), { Mat = WOOD, Solid = true })
			Kit.Part(f, V(s + 0.1, 0.4, s + 0.1), CFrame.new(x, s * 0.75, z), IRON, BRASS_M)
			Kit.AddCircle(x, z, 3)
		elseif barrels < 6 and Kit.IsFree(x, z, 2.5) then
			barrels += 1
			Kit.Cyl(f, 4, 3, CFrame.new(x, 2, z), Kit.Vivid(COPPER), { Mat = METAL, Solid = true })
			Kit.Cyl(f, 0.4, 3.15, CFrame.new(x, 2.8, z), Kit.Vivid(BRASS), BRASS_M)
			Kit.AddCircle(x, z, 2.5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Clockwork.Build(map: Instance)
	local f = Kit.Folder(map, "Clockwork")
	ground(f)
	sideWalls(f)
	outside(f)
	clockTower(f)
	cogBridge(f, Z0 + 145, "TICK TOCK LANE")
	cogBridge(f, Z0 + 265, "COGWHEEL CROSSING")
	floaters(f)
	decor(f)
end

return Clockwork
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Frost</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 10: Frostbite Peaks (Z 3040..3400). A bright snowy valley under an aurora.
--   Ground: snow slab (top Y = 0). Main path along X = 0: pale ice-blue paving (X -8..8,
--   top 0.05, normal friction, NOT the slippery Ice material) with lilac edges.
--   Ghost areas hold flat paint only: a frozen pond with cracks on the path (0, 3125), snow
--   drift circles, a second frozen pond (75, 3220) and the Blizzard Queen's ice rink with a big
--   snowflake (0, 3345). Frozen surfaces are smooth plastic with reflectance (walkable, not slippery).
--   Landmark: the frozen castle with a ~98-stud ice spire at (95, 3330) in front of a snowy
--   mountain range (outside the +X wall, peaks up to ~150), visible from the Swamp.
--   Also: a ski lodge and a cabin (east), igloos, snowmen, a ski rack and sled, snowy pines,
--   ice crystal clusters, a skating pond (-35, 3210). Side walls: snowbank walls with ice blocks.
--   Sky: aurora curtains (big translucent coloured planes, not neon) high above the walls,
--   gentle snowfall (one emitter).
-- Glow: a few ice-crystal tips, the spire crystal and window, lodge/igloo windows, lanterns and
-- small glints on the boss rink.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Frost = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SNOW = Enum.Material.Snow
local ICE = Enum.Material.Ice
local GLACIER = Enum.Material.Glacier
local WOOD = Enum.Material.Wood
local ROCK = Enum.Material.Rock
local FABRIC = Enum.Material.Fabric
local SLATE = Enum.Material.Slate

local Z0, Z1 = 3040, 3400

local WHITE = C(244, 248, 255)
local SNOWC = C(236, 243, 252)
local SNOW_SHADE = C(214, 226, 246)
local ICEC = C(170, 215, 245)
local LILAC = C(196, 170, 245)
local AURORA = C(120, 255, 190)
local PATH = C(196, 220, 244)
local PINE = { C(46, 112, 92), C(56, 126, 98), C(40, 100, 90) }
local BARK = C(110, 78, 58)
local LOG = C(156, 100, 64)
local WARM = C(255, 210, 130)
local MTN = C(150, 152, 190)
local MTN_DARK = C(124, 128, 170)

local function rz(n: number): number
	return Z0 + n
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material, solid: boolean)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = solid, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Flat frozen pond (non-solid sheet on the solid ground) with a snow rim.
local function frozenPond(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.04, d + 5, 0.03, WHITE, { Mat = SNOW })
	Kit.Disc(parent, x, z, 0.08, d, 0.04, ICEC, { Refl = 0.3, Name = "FrozenPond" })
end

--==================================================================
-- PROPS
--==================================================================
local function pine(parent: Instance, pos: Vector3, h: number)
	local col = Kit.Pick(PINE)
	Kit.Cyl(parent, h * 0.3, 1.8, CFrame.new(pos + V(0, h * 0.15, 0)), BARK, { Mat = WOOD, Solid = true, Shadow = true })
	for k = 0, 2 do
		local d = h * 0.62 * (1 - k * 0.27)
		local th = h * 0.2
		local y = h * 0.22 + k * h * 0.22
		Kit.Cyl(parent, th, d, CFrame.new(pos + V(0, y + th / 2, 0)), col, { Mat = Enum.Material.Grass, Shadow = true })
		Kit.Cyl(parent, 0.7, d * 0.82, CFrame.new(pos + V(0, y + th + 0.35, 0)), WHITE, { Mat = SNOW })
	end
	Kit.Ball(parent, h * 0.12, pos + V(0, h * 0.88 + 0.4, 0), WHITE, { Mat = SNOW })
	Kit.AddCircle(pos.X, pos.Z, h * 0.31)
end

local function snowman(parent: Instance, x: number, z: number, fx: number, fz: number, scarf: Color3)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local snow: Kit.Opts = { Mat = SNOW, Solid = true }
	Kit.Ball(parent, 5, (base * CFrame.new(0, 2.2, 0)).Position, WHITE, snow)
	Kit.Ball(parent, 3.7, (base * CFrame.new(0, 5.4, 0)).Position, WHITE, { Mat = SNOW })
	Kit.Ball(parent, 2.7, (base * CFrame.new(0, 8, 0)).Position, WHITE, { Mat = SNOW })
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.42, (base * CFrame.new(s * 0.5, 8.35, -1.15)).Position, C(30, 30, 40))
		Props.Beam(parent, (base * CFrame.new(s * 1.6, 5.8, 0)).Position, (base * CFrame.new(s * 3.6, 7.4, -0.3)).Position, 0.3, 0.3, BARK, { Mat = WOOD })
	end
	Kit.Part(parent, V(0.35, 0.35, 1.3), base * CFrame.new(0, 7.9, -1.65), Kit.Vivid(C(255, 140, 40)))
	Kit.Cyl(parent, 0.6, 3.1, base * CFrame.new(0, 6.95, 0), Kit.Vivid(scarf), { Mat = FABRIC })
	Kit.Cyl(parent, 0.25, 2.9, base * CFrame.new(0, 9.2, 0), C(40, 40, 55))
	Kit.Cyl(parent, 1.6, 1.9, base * CFrame.new(0, 10.1, 0), C(40, 40, 55))
	Kit.AddCircle(x, z, 4)
end

local function iceCluster(parent: Instance, x: number, z: number, glow: boolean)
	local rng = Kit.Rng
	local cols = { ICEC, C(200, 190, 255), C(160, 235, 240) }
	for k = 0, 2 do
		local h = if k == 0 then rng:NextNumber(6, 9) else rng:NextNumber(3, 5)
		local w = if k == 0 then 2.2 else 1.5
		local a = k * 2.2
		local p = V(x + math.cos(a) * (if k == 0 then 0 else 1.8), 0, z + math.sin(a) * (if k == 0 then 0 else 1.8))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 3), rng:NextNumber(-0.25, 0.25))
		Kit.Part(parent, V(w, h, w), cf * CFrame.new(0, h / 2 - 0.5, 0), Kit.Pick(cols), { Mat = ICE, Transp = 0.15, Refl = 0.2 })
		if k == 0 then
			Kit.Part(parent, V(w * 0.7, w * 0.7, w * 0.7), cf * CFrame.new(0, h - 0.5, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), if glow then AURORA else C(225, 245, 255), if glow then { Mat = NEON } else { Mat = ICE, Transp = 0.1 })
		end
	end
	Kit.AddCircle(x, z, 3)
end

local function igloo(parent: Instance, x: number, z: number, fx: number, fz: number, lit: boolean)
	local m = Kit.Model(parent, "Igloo")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(m, 16, V(x, 0, z), WHITE, { Mat = SNOW, Solid = true, Shadow = true })
	Kit.Cyl(m, 0.35, 15.4, CFrame.new(x, 2.6, z), SNOW_SHADE, { Mat = SNOW })
	Kit.Cyl(m, 0.35, 12.6, CFrame.new(x, 5, z), SNOW_SHADE, { Mat = SNOW })
	-- entrance tunnel (cylinder axis turned to point out of the dome) and the doorway
	local tunnel = base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi / 2, 0)
	Kit.Part(m, V(6, 6.4, 6.4), tunnel, WHITE, { Mat = SNOW, Shape = Enum.PartType.Cylinder, Solid = true })
	local door = Kit.Part(m, V(0.4, 4.2, 4.2), tunnel * CFrame.new(3.05, 0, 0), if lit then WARM else C(50, 60, 90), { Shape = Enum.PartType.Cylinder, Mat = if lit then NEON else Enum.Material.SmoothPlastic })
	if lit then
		Kit.Light(door, WARM, 18, 1.2)
	end
	Kit.AddCircle(x, z, 10)
end

-- Log cabin facing (fx, 0). length along the facade, depth into the cabin.
local function cabin(parent: Instance, x: number, z: number, fx: number, length: number, depth: number, wall: Color3, roof: Color3, sign: string?, lit: boolean, flicker: boolean)
	local m = Kit.Model(parent, "Cabin")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local h = 11
	Kit.Part(m, V(length + 1, 1.2, depth + 1), base * CFrame.new(0, 0.6, 0), C(150, 150, 175), { Mat = SLATE, Solid = true })
	Kit.Part(m, V(length, h, depth), base * CFrame.new(0, 1.2 + h / 2, 0), wall, { Mat = WOOD, Solid = true, Shadow = true })
	-- log seams on the front
	for k = 1, 3 do
		Kit.Part(m, V(length + 0.2, 0.35, 0.3), base * CFrame.new(0, 1.2 + k * h / 4, -depth / 2 - 0.1), wall:Lerp(Color3.new(0, 0, 0), 0.25), { Mat = WOOD })
	end
	gable(m, base * CFrame.new(0, 1.2 + h, 0), length + 2, depth + 3, 7, roof, SLATE, true)
	gable(m, base * CFrame.new(0, 1.2 + h + 0.7, 0), length + 2.4, depth + 3.4, 7, WHITE, SNOW, false)
	-- chimney
	Kit.Part(m, V(3, 9, 3), base * CFrame.new(length / 2 - 3, 1.2 + h + 5, depth * 0.2), C(150, 140, 160), { Mat = Enum.Material.Cobblestone })
	Kit.Part(m, V(3.4, 0.8, 3.4), base * CFrame.new(length / 2 - 3, 1.2 + h + 9.8, depth * 0.2), WHITE, { Mat = SNOW })
	-- door and windows on the front (local -Z)
	Kit.Part(m, V(3.4, 6.5, 0.3), base * CFrame.new(0, 4.45, -depth / 2 - 0.2), C(110, 60, 50), { Mat = WOOD })
	local first: Part? = nil
	for _, s in { -1, 1 } do
		local win = Kit.Part(m, V(3.4, 3, 0.3), base * CFrame.new(s * length * 0.3, 6.5, -depth / 2 - 0.2), WARM, if lit then { Mat = NEON } else {})
		Kit.Part(m, V(4.2, 3.8, 0.2), base * CFrame.new(s * length * 0.3, 6.5, -depth / 2 - 0.08), Kit.Vivid(C(200, 70, 80)), { Mat = WOOD })
		first = first or win
	end
	if lit and first then
		Kit.Light(first, WARM, 22, 1.4, flicker)
	end
	if sign then
		Props.SignBoard(m, (base * CFrame.new(0, 1.2 + h + 2.2, -depth / 2 - 1.2)).Position, length * 0.55, 3.2, fx, 0, sign, C(70, 45, 40), C(255, 235, 190), C(200, 70, 80))
	end
	local r = math.max(length, depth) / 2 + 3
	Kit.AddCircle(x, z, r)
end

local function skiRack(parent: Instance, x: number, z: number)
	local wood: Kit.Opts = { Mat = WOOD }
	for _, s in { -1, 1 } do
		Kit.Box(parent, V(x + s * 3 - 0.3, 0, z - 0.3), V(x + s * 3 + 0.3, 4, z + 0.3), LOG, wood)
	end
	Kit.Box(parent, V(x - 3.5, 3.6, z - 0.4), V(x + 3.5, 4.2, z + 0.4), LOG, wood)
	local skis = { C(255, 90, 120), C(90, 180, 255), C(255, 210, 70), C(150, 110, 240) }
	for i, col in skis do
		local sx = x - 2.6 + (i - 1) * 1.7
		Kit.Part(parent, V(0.6, 6.5, 0.2), CFrame.new(sx, 3.2, z - 0.6) * CFrame.Angles(-0.12, 0, 0), Kit.Vivid(col))
	end
	-- sled
	local sz = z - 5
	for _, s in { -1, 1 } do
		Kit.Box(parent, V(x + s * 1.4 - 0.2, 0, sz - 2.5), V(x + s * 1.4 + 0.2, 0.4, sz + 2.5), C(70, 70, 90), { Mat = Enum.Material.Metal })
	end
	Kit.Box(parent, V(x - 1.8, 0.4, sz - 2), V(x + 1.8, 0.9, sz + 2.2), Kit.Vivid(C(220, 60, 70)), wood)
	Kit.AddCircle(x, z - 2, 6)
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SNOWC, { Mat = SNOW, Solid = true, Name = "Ground_Frost" })
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PATH, { Solid = true, Refl = 0.08, Name = "IcePath" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.5, 0.05, Z0), V(s * 8 + 0.5, 0.1, Z1), Kit.Vivid(LILAC))
	end
	for z = Z0 + 16, Z1 - 10, 30 do
		Kit.Part(f, V(1.6, 0.04, 1.6), CFrame.new(0, 0.07, z) * CFrame.Angles(0, math.pi / 4, 0), WHITE)
	end
	-- soft snow drifts (flat shading patches)
	local rng = Kit.Rng
	for _ = 1, 8 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(16, 28), 0.03, rng:NextNumber(12, 22)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), SNOW_SHADE, { Mat = SNOW })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 10, zB), WHITE, { Mat = SNOW, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 10, zA), V(s * 146.4, 11, zB), ICEC, { Mat = GLACIER })
		Kit.Box(f, V(s * 139.85, 2.4, zA), V(s * 139.65, 3, zB), Kit.Vivid(LILAC))
		for z = zA + 14, zB - 6, 32 do
			Kit.Part(f, V(6, 6, 6), CFrame.new(s * 143, 13, z) * CFrame.Angles(0, 0.4, 0), if (z // 32) % 2 == 0 then ICEC else C(200, 190, 255), { Mat = ICE, Transp = 0.15, Solid = true })
			Kit.Ball(f, 7, V(s * 141, 10.5, z + 9), WHITE, { Mat = SNOW })
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- frost spirits: frozen pond across the path with a few cracks
	local cz = rz(85)
	frozenPond(f, 0, cz, 60)
	local crack = C(110, 160, 215)
	for i = 0, 4 do
		local a = i * 1.3 + 0.4
		local p = V(math.cos(a) * 8, 0.1, cz + math.sin(a) * 8)
		Props.Beam(f, p, p + V(math.cos(a + 0.3) * 14, 0, math.sin(a + 0.3) * 14), 0.35, 0.04, crack)
	end
	-- snow drift circles with lilac rings
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 3, 0.03, Kit.Vivid(LILAC))
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, SNOW_SHADE, { Mat = SNOW })
		frozenPond(f, a[1] + 5, a[2] + 3, 12)
	end
	-- yeti phantoms: second frozen pond
	frozenPond(f, 75, rz(180), 46)
	Props.Beam(f, V(62, 0.1, rz(172)), V(84, 0.1, rz(188)), 0.35, 0.04, crack)
	-- boss: the Blizzard Queen's ice rink with a big snowflake
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(LILAC))
	Kit.Disc(f, 0, bz, 0.08, 54, 0.04, ICEC, { Refl = 0.3, Name = "IceRink" })
	for i = 0, 5 do
		local a = i * math.pi / 3
		local tip = V(math.cos(a) * 22, 0.12, bz + math.sin(a) * 22)
		Props.Beam(f, V(0, 0.12, bz), tip, 1.4, 0.04, WHITE)
		local mid = V(math.cos(a) * 13, 0.12, bz + math.sin(a) * 13)
		for _, d in { -0.7, 0.7 } do
			Props.Beam(f, mid, mid + V(math.cos(a + d) * 5, 0, math.sin(a + d) * 5), 0.8, 0.04, WHITE)
		end
		Kit.Part(f, V(1.6, 0.05, 1.6), CFrame.new(tip.X, 0.13, tip.Z) * CFrame.Angles(0, math.pi / 4, 0), AURORA, { Mat = NEON })
	end
	Kit.Disc(f, 0, bz, 0.14, 5, 0.04, Kit.Vivid(C(120, 200, 255)))
end

--==================================================================
-- LANDMARK: frozen castle + mountains
--==================================================================
local function castle(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "FrozenCastle")
	local ice: Kit.Opts = { Mat = GLACIER, Solid = true, Shadow = true }
	local iceCol = C(186, 222, 248)
	local roof = Kit.Vivid(LILAC)
	Kit.Disc(m, x, z, 1.2, 46, 1.2, C(170, 175, 205), { Mat = ROCK, Solid = true })
	Kit.Disc(m, x, z, 1.3, 42, 0.1, WHITE, { Mat = SNOW })
	-- curtain walls (front faces -X with a gate)
	local hw, wh, t = 14, 16, 3
	Kit.Box(m, V(x + hw - t, 1.2, z - hw), V(x + hw, wh, z + hw), iceCol, ice)
	Kit.Box(m, V(x - hw, 1.2, z - hw), V(x + hw, wh, z - hw + t), iceCol, ice)
	Kit.Box(m, V(x - hw, 1.2, z + hw - t), V(x + hw, wh, z + hw), iceCol, ice)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x - hw, 1.2, z + s * 4.5), V(x - hw + t, wh, z + s * hw), iceCol, ice)
	end
	Kit.Box(m, V(x - hw, 11, z - 4.5), V(x - hw + t, wh, z + 4.5), iceCol, ice)
	Kit.Box(m, V(x - hw + 0.4, 1.2, z - 4.5), V(x - hw + 0.8, 11, z + 4.5), C(80, 90, 150))
	-- crenellations on the front wall
	for k = -2, 2 do
		Kit.Box(m, V(x - hw - 0.2, wh, z + k * 5.5 - 1.5), V(x - hw + t + 0.2, wh + 2, z + k * 5.5 + 1.5), iceCol, { Mat = GLACIER })
	end
	-- corner towers with lilac cone roofs
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local tx, tz = x + sx * hw, z + sz * hw
			Kit.Cyl(m, 28, 8, CFrame.new(tx, 15.2, tz), C(200, 230, 252), ice)
			for k = 0, 2 do
				Kit.Cyl(m, 3, 9.5 - k * 3, CFrame.new(tx, 30.7 + k * 3, tz), roof)
			end
			Kit.Ball(m, 1.6, V(tx, 37.6, tz), Kit.Vivid(AURORA))
		end
	end
	-- central ice spire
	Kit.Cyl(m, 64, 14, CFrame.new(x, 33.2, z), C(160, 210, 245), { Mat = ICE, Transp = 0.08, Solid = true, Shadow = true })
	Kit.Cyl(m, 2, 16, CFrame.new(x, 42, z), roof)
	Kit.Cyl(m, 2, 15.4, CFrame.new(x, 24, z), roof)
	local stack = { { 12, 6 }, { 8.5, 6 }, { 5, 7 } }
	local y = 65.2
	for _, s in stack do
		Kit.Cyl(m, s[2], s[1], CFrame.new(x, y + s[2] / 2, z), if s[1] > 10 then C(200, 230, 252) else roof, { Mat = GLACIER })
		y += s[2]
	end
	local tip = Kit.Part(m, V(3.6, 3.6, 3.6), CFrame.new(x, y + 2, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), AURORA, { Mat = NEON })
	Kit.Part(m, V(1.4, 10, 1.4), CFrame.new(x, y + 8.5, z), C(220, 245, 255), { Mat = ICE, Transp = 0.1 })
	Kit.Light(tip, AURORA, 40, 1.6)
	-- spire windows facing the valley (-X); the top one glows
	for k, wy in { 34, 50 } do
		Kit.Box(m, V(x - 7.2, wy, z - 1.4), V(x - 6.6, wy + 4, z + 1.4), if k == 2 then C(200, 240, 255) else C(70, 90, 160), if k == 2 then { Mat = NEON } else { Refl = 0.2 })
	end
	-- banners on the front towers
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(x - hw - 4.3, 14, z + sz * hw - 1.6), V(x - hw - 4, 24, z + sz * hw + 1.6), Kit.Vivid(C(150, 110, 230)), { Mat = FABRIC })
	end
	-- ice shards around the base
	local rng = Kit.Rng
	for i = 0, 5 do
		local a = i * math.pi / 3 + 0.5
		local p = V(x + math.cos(a) * 20, 0, z + math.sin(a) * 20)
		local h = rng:NextNumber(6, 10)
		local cf = CFrame.new(p) * CFrame.Angles(math.sin(a) * 0.3, rng:NextNumber(0, 3), -math.cos(a) * 0.3)
		Kit.Part(m, V(2.4, h, 2.4), cf * CFrame.new(0, h / 2 - 0.5, 0), if i % 2 == 0 then ICEC else C(205, 195, 255), { Mat = ICE, Transp = 0.15 })
	end
	-- icy mist rolling off the castle
	local fog = Kit.Part(m, V(40, 0.2, 40), CFrame.new(x, 1.5, z), C(225, 240, 255), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(225, 240, 255), 1.4, 9, 0.3)
	Kit.AddCircle(x, z, 24)
end

-- A mountain peak: a diamond-turned block half buried, plus a snow cap. Runs along Z.
local function peak(parent: Instance, x: number, z: number, size: number, depth: number, col: Color3)
	local cf = CFrame.new(x, -size * 0.12, z) * CFrame.Angles(0, 0, math.pi / 4)
	Kit.Part(parent, V(size, size, depth), cf, col, { Mat = ROCK })
	local capS = size * 0.36
	local topY = -size * 0.12 + size * 0.7071
	Kit.Part(parent, V(capS, capS, depth * 0.9), CFrame.new(x, topY - capS * 0.7071 + 0.6, z) * CFrame.Angles(0, 0, math.pi / 4), WHITE, { Mat = SNOW })
end

--==================================================================
-- OUTSIDE: mountains, snowfield, pines, aurora
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Peaks")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), SNOWC, { Mat = SNOW })
		-- pines on the outer snow
		for i = 0, 7 do
			local x = s * rng:NextNumber(152, 200)
			local z = Z0 + 20 + i * 44 + rng:NextNumber(-8, 8)
			local h = rng:NextNumber(22, 34)
			local col = Kit.Pick(PINE)
			Kit.Cyl(o, h * 0.3, 2, CFrame.new(x, h * 0.15, z), BARK, { Mat = WOOD })
			Kit.Cyl(o, h * 0.35, h * 0.55, CFrame.new(x, h * 0.42, z), col, { Mat = Enum.Material.Grass })
			Kit.Cyl(o, h * 0.3, h * 0.34, CFrame.new(x, h * 0.74, z), col, { Mat = Enum.Material.Grass })
			Kit.Cyl(o, 0.8, h * 0.3, CFrame.new(x, h * 0.9 + 0.4, z), WHITE, { Mat = SNOW })
		end
	end
	-- mountain ranges both sides, tallest behind the castle (+X, back)
	local ranges = {
		{ -260, rz(40), 150, 120 }, { -300, rz(160), 200, 130 }, { -250, rz(270), 160, 110 }, { -320, rz(340), 190, 120 },
		{ 270, rz(30), 140, 110 }, { 310, rz(140), 180, 130 }, { 250, rz(230), 150, 100 }, { 260, rz(320), 210, 120 },
	}
	for i, r in ranges do
		peak(o, r[1], r[2], r[3], r[4], if i % 2 == 0 then MTN else MTN_DARK)
	end
	-- aurora curtains: big translucent planes high above the side walls
	type Curtain = { s: number, z: number, col: Color3, t: number }
	local aur: { Curtain } = {
		{ s = -1, z = rz(110), col = AURORA, t = 0.62 },
		{ s = -1, z = rz(260), col = C(190, 150, 255), t = 0.66 },
		{ s = 1, z = rz(70), col = C(110, 220, 255), t = 0.66 },
		{ s = 1, z = rz(220), col = AURORA, t = 0.62 },
		{ s = 1, z = rz(330), col = C(190, 150, 255), t = 0.66 },
	}
	for i, a in aur do
		local s = a.s
		local cf = CFrame.new(s * (175 + (i % 2) * 20), 130 + (i % 3) * 12, a.z) * CFrame.Angles(0, (i % 2) * 0.15 - 0.07, s * 0.25)
		Kit.Part(o, V(1, 46, 190), cf, a.col, { Transp = a.t, Name = "Aurora" })
		Kit.Part(o, V(1, 14, 170), cf * CFrame.new(0, -26, 6), a.col, { Transp = 0.8, Name = "Aurora" })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Frost.Build(map: Instance)
	local f = Kit.Folder(map, "Frost")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	castle(f, 95, rz(290))
	cabin(f, 98, rz(62), -1, 30, 18, LOG, C(170, 60, 70), "⛷ SKI LODGE ⛷", true, true)
	cabin(f, 112, rz(118), -1, 18, 14, C(140, 92, 62), C(70, 90, 150), nil, true, false)
	skiRack(f, 72, rz(80))
	igloo(f, 56, rz(122), -1, 0, true)
	igloo(f, -100, rz(46), 1, 0, false)
	igloo(f, -118, rz(196), 1, 0, false)
	igloo(f, 30, rz(214), -1, -1, false)
	frozenPond(f, -35, rz(170), 28)
	Kit.AddCircle(-35, rz(170), 17)
	snowman(f, 15, rz(52), 0, -1, C(230, 60, 80))

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Kit.Cyl(f, 13, 1.4, CFrame.new(x + s * 10, 6.5, z), LOG, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "❄ FROSTBITE PEAKS ❄", C(70, 90, 150), WHITE, LILAC)
		Kit.Box(f, V(x - 11, 12.8, z - 0.6), V(x + 11, 13.6, z + 0.6), WHITE, { Mat = SNOW })
		Kit.AddCircle(x, z, 12)
	end

	-- lanterns along the path (one lit)
	local lit = 0
	for z = Z0 + 46, Z1 - 30, 46 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 23 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.Lantern(f, V(x, 0, zz), C(190, 235, 255), lit == 2, false)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- pines
	local trees = 0
	for _ = 1, 400 do
		if trees >= 18 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 30)
		if Kit.IsFree(x, z, h * 0.31 + 1) then
			trees += 1
			pine(f, V(x, 0, z), h)
		end
	end

	-- ice crystals and snowmen
	local scarves = { C(230, 60, 80), C(90, 170, 255), C(150, 110, 240), C(80, 200, 140) }
	local crystals, men = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if crystals < 9 and Kit.IsFree(x, z, 3.5) then
			crystals += 1
			iceCluster(f, x, z, crystals <= 3)
		elseif men < 4 and Kit.IsFree(x, z, 4.5) then
			men += 1
			snowman(f, x, z, -x, -10, scarves[men])
		end
	end

	-- floating snowflake crystals near the castle and the lodge
	for _, p in { V(70, 9, rz(262)), V(118, 12, rz(250)), V(64, 7, rz(318)), V(78, 10, rz(140)), V(120, 8, rz(320)) } do
		local c = Kit.Part(f, V(1.6, 1.6, 1.6), CFrame.new(p) * CFrame.Angles(math.pi / 4, 0.3, math.pi / 4), C(220, 245, 255), { Mat = ICE, Transp = 0.1, Name = "FloatingCrystal" })
		Kit.Float(c, rng:NextNumber(0.6, 1.2))
	end

	-- gentle snowfall over the valley
	local sky = Kit.Part(f, V(260, 1, 340), CFrame.new(0, 48, rz(180)), WHITE, { Transp = 1, Name = "SnowSource" })
	local e = Kit.Emitter(sky, WHITE, 18, 0.5, 1)
	if e then
		e.LightEmission = 0.2
		e.Acceleration = V(0, -3, 0)
		e.Lifetime = NumberRange.new(7, 10)
		e.Size = NumberSequence.new(0.45)
		e.Transparency = NumberSequence.new(0.15)
		e.EmissionDirection = Enum.NormalId.Bottom
	end

	outside(f)
end

return Frost
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Gates</string>
            <string name="Source"><![CDATA[--!strict
-- Zone gates: workspace.Map.Gates.Gate_<ZoneId> with Barrier, Arch, PromptAnchor and Sign
-- (TextLabel "CostLabel" on the sign's Front face, which faces the approaching player at -Z).
-- The Barrier is a ForceField-material wall (shimmering, no neon blow-out); the client
-- (Ambience) toggles its collision, tweens its Color/Size/CFrame/Transparency on unlock.
-- Trims are painted (solid); only the hanging lanterns, pillar jack-o'-lanterns and the
-- skull's eyes glow.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Format = require(game:GetService("ReplicatedStorage").GH.Logic.Format)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Gates = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

type Theme = { Stone: Color3, Trim: Color3, Barrier: Color3, Lamp: Color3 }

local THEMES: { [string]: Theme } = {
	Cemetery = { Stone = C(150, 125, 200), Trim = C(140, 255, 120), Barrier = C(180, 110, 255), Lamp = C(140, 255, 160) },
	School = { Stone = C(225, 120, 100), Trim = C(210, 120, 255), Barrier = C(100, 255, 190), Lamp = C(220, 150, 255) },
	Carnival = { Stone = C(235, 75, 85), Trim = C(255, 210, 70), Barrier = C(255, 120, 200), Lamp = C(255, 220, 120) },
	Hospital = { Stone = C(220, 228, 238), Trim = C(100, 180, 255), Barrier = C(120, 255, 200), Lamp = C(170, 230, 255) },
	Harbor = { Stone = C(125, 90, 60), Trim = C(70, 200, 200), Barrier = C(90, 255, 210), Lamp = C(255, 200, 110) },
	Castle = { Stone = C(150, 150, 165), Trim = C(255, 200, 70), Barrier = C(190, 110, 255), Lamp = C(255, 190, 100) },
	SpiritRealm = { Stone = C(70, 60, 110), Trim = C(110, 230, 255), Barrier = C(110, 240, 255), Lamp = C(150, 255, 230) },
	Swamp = { Stone = C(100, 120, 75), Trim = C(170, 255, 120), Barrier = C(150, 255, 120), Lamp = C(200, 255, 140) },
	Frost = { Stone = C(205, 225, 245), Trim = C(110, 190, 255), Barrier = C(170, 240, 255), Lamp = C(200, 245, 255) },
	Tomb = { Stone = C(225, 190, 125), Trim = C(70, 200, 220), Barrier = C(255, 210, 90), Lamp = C(255, 220, 140) },
	ToyFactory = { Stone = C(255, 150, 190), Trim = C(255, 225, 90), Barrier = C(255, 140, 220), Lamp = C(255, 230, 150) },
	Sunken = { Stone = C(90, 150, 170), Trim = C(255, 220, 120), Barrier = C(90, 255, 230), Lamp = C(150, 255, 240) },
	Clockwork = { Stone = C(160, 120, 80), Trim = C(230, 200, 120), Barrier = C(255, 190, 90), Lamp = C(255, 210, 130) },
	Inferno = { Stone = C(90, 55, 55), Trim = C(255, 150, 60), Barrier = C(255, 120, 60), Lamp = C(255, 170, 90) },
	Throne = { Stone = C(240, 235, 255), Trim = C(255, 215, 90), Barrier = C(255, 230, 140), Lamp = C(255, 240, 180) },
}

local function buildGate(folder: Instance, id: string, z: number, width: number)
	local zone = Config.ZoneById[id]
	local theme = THEMES[id] or THEMES.Cemetery
	local half = width / 2
	local m = Kit.Model(folder, "Gate_" .. id)
	local trim = Kit.Vivid(theme.Trim)

	-- Barrier: fills the opening. Other code toggles collision locally and tweens it.
	local barrier = Kit.Part(m, V(width, 30, 2), CFrame.new(0, 15, z), theme.Barrier, {
		Name = "Barrier",
		Mat = Enum.Material.ForceField,
		Transp = 0.4,
		Solid = true,
		Shadow = false,
	})
	barrier.CanQuery = false
	barrier.CanTouch = true

	-- Arch around the opening (never inside it).
	local arch = Kit.Model(m, "Arch")
	local pw = 8 -- pillar width
	for _, s in { -1, 1 } do
		local x1, x2 = s * half, s * (half + pw)
		Kit.Box(arch, V(x1, 0, z - 5), V(x2, 32, z + 5), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(arch, V(s * (half + 0.01), 0, z - 6), V(s * (half + pw + 1), 3, z + 6), theme.Stone:Lerp(Color3.new(0, 0, 0), 0.2), { Mat = Enum.Material.Slate, Solid = true })
		-- painted trims on the pillar fronts (both sides)
		for _, fz in { -1, 1 } do
			for _, ex in { 0.6, pw - 0.6 } do
				local x = s * (half + ex)
				Kit.Box(arch, V(x - 0.3, 3, z + fz * 5), V(x + 0.3, 30, z + fz * 5.3), trim)
			end
		end
		-- glowing jack-o'-lantern on top of each pillar
		Props.Pumpkin(arch, V(s * (half + pw / 2), 36, z), 6.5, 0, -1, true)
		-- hanging lantern on the approach side
		local lx = s * (half + pw / 2)
		Kit.Box(arch, V(lx - 0.3, 24, z - 5.8), V(lx + 0.3, 26, z - 5), C(50, 40, 70))
		local lamp = Kit.Box(arch, V(lx - 1.1, 21, z - 6.8), V(lx + 1.1, 24, z - 4.6), theme.Lamp, { Mat = NEON })
		Kit.Light(lamp, theme.Lamp, 22, 1.6)
	end
	-- top beam (Y 30..36) spanning the opening above the barrier
	Kit.Box(arch, V(-(half + pw + 1), 30, z - 4), V(half + pw + 1, 36, z + 4), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
	for _, fz in { -1, 1 } do
		Kit.Box(arch, V(-(half + pw + 1), 30, z + fz * 4), V(half + pw + 1, 30.6, z + fz * 4.3), trim)
	end
	-- crenellations
	for i = -2, 2 do
		local x = i * 9
		Kit.Box(arch, V(x - 2, 36, z - 3), V(x + 2, 38, z + 3), theme.Stone, { Mat = Enum.Material.Slate })
	end
	-- skull centrepiece on the approach face
	Props.Skull(arch, V(0, 33, z - 5), 4.5, 0, -1)
	-- low wisps either side of the opening
	Props.Wisp(arch, V(-(half + 5), 0, z - 9), theme.Barrier, 10, false)
	Props.Wisp(arch, V(half + 5, 0, z - 9), theme.Barrier, 10, false)

	-- Sign above the arch, Front face (-Z) toward players coming from the previous zone.
	local sign = Kit.Part(m, V(40, 10, 1), CFrame.new(0, 43, z - 3), C(45, 25, 80), { Name = "Sign" })
	Kit.Part(arch, V(42, 12, 0.6), CFrame.new(0, 43, z - 2.3), trim) -- frame
	local gui = Kit.Gui(sign, Enum.NormalId.Front, 30)
	Kit.Label(gui, zone.Name, zone.Accent, {
		Name = "ZoneLabel",
		Pos = UDim2.fromScale(0.03, 0.04),
		Size = UDim2.fromScale(0.94, 0.5),
	})
	Kit.Label(gui, "🔒 " .. Format.Short(zone.Cost) .. " ECTOPLASM", C(150, 255, 140), {
		Name = "CostLabel",
		Pos = UDim2.fromScale(0.08, 0.56),
		Size = UDim2.fromScale(0.84, 0.38),
	})

	-- Prompt anchor on the near side.
	Kit.Part(m, V(1, 1, 1), CFrame.new(0, 4, z - 6), C(255, 255, 255), { Name = "PromptAnchor", Transp = 1 })

	m.PrimaryPart = barrier
end

function Gates.Build(map: Instance)
	local folder = Kit.Folder(map, "Gates")
	for id, g in Kit.Gates(Config.Layout) do
		buildGate(folder, id, g.Z, g.Width)
	end
end

return Gates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Harbor</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 6: Ghost Ship Harbor (Z 1560..1920).
--   Cobblestone quay at Y = 0 with a WoodPlanks boardwalk along X = 0 (gate to gate) and
--   plank deck pads painted under every ghost area (flat, <= 0.17 tall).
--   -X side: muted-red brick harbour wall, three open-front warehouses (X -138..-112) and a row
--   of town houses behind the wall.
--   +X side: low quay curb + rope railing; the ocean (Y -1.5) beyond X = 146; a shallow
--   wading inlet (floor Y -0.5, no pit) at X 104..146, Z 1600..1650 with a pier and fishing hut.
--   Landmarks: the haunted ship "The Salty Specter" moored along +X (hull X 130..174,
--   Z 1672..1810, masts to Y ~102) and a red/white striped lighthouse at (116, 1866), ~94 tall.
--   Glow is limited to portholes, stern windows, a few rune lines, the figurehead heart, the
--   lighthouse lamp, lamp globes, a few ghostly windows and floating spectral lanterns.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Harbor = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local COBBLE = Enum.Material.Cobblestone
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1560, 1920

local SEA = C(28, 72, 128)
local SEA_TEAL = C(45, 135, 150)
local QUAY = C(118, 132, 150)
local PLANK = C(170, 125, 82)
local PLANK_DARK = C(112, 78, 55)
local HULL = C(92, 62, 48)
local MAST = C(110, 80, 58)
local RED = C(175, 72, 66)
local TEAL = C(60, 185, 185)
local SPECTRAL = C(120, 255, 170)
local PURPLE = C(160, 110, 230)
local SAIL = C(238, 232, 212)
local SAIL_TEAL = C(170, 222, 215)
local IRON = C(58, 60, 74)
local GOLD = C(255, 200, 60)
local ROPE = C(205, 178, 130)
local WARM = C(255, 205, 120)
local CRATES = { C(185, 135, 85), C(160, 110, 70), C(200, 150, 95), C(140, 100, 70) }

local SOLID_PLANKS: Kit.Opts = { Mat = PLANKS, Solid = true, Shadow = true }

-- Gable roof, ridge along local X, slopes toward local ±Z, bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = true, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Plan-view triangle (Y y0..y1): right angle at (xEdge, zBase), point at (xEdge, zTip) with
-- zTip > zBase, widest at (xOuter, zBase). Two mirrored halves make the ship's bow.
local function bowHalf(parent: Instance, xEdge: number, xOuter: number, zBase: number, zTip: number, y0: number, y1: number, color: Color3, opts: Kit.Opts)
	local s = if xOuter > xEdge then 1 else -1
	local center = V((xEdge + xOuter) / 2, (y0 + y1) / 2, (zBase + zTip) / 2)
	local cf = CFrame.fromMatrix(center, V(0, s, 0), V(s, 0, 0))
	Kit.Wedge(parent, V(y1 - y0, math.abs(xOuter - xEdge), zTip - zBase), cf, color, opts)
end

local function crate(parent: Instance, pos: Vector3, s: number, yaw: number)
	local cf = CFrame.new(pos + V(0, s / 2, 0)) * CFrame.Angles(0, yaw, 0)
	Kit.Part(parent, V(s, s, s), cf, Kit.Pick(CRATES), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(parent, V(s + 0.12, s * 0.18, s + 0.12), cf, PLANK_DARK, { Mat = WOOD })
end

local function barrel(parent: Instance, pos: Vector3, h: number)
	Kit.Cyl(parent, h, 2.8, CFrame.new(pos + V(0, h / 2, 0)), C(150, 100, 62), { Mat = WOOD, Solid = true })
	for _, t in { 0.22, 0.78 } do
		Kit.Cyl(parent, 0.35, 2.95, CFrame.new(pos + V(0, h * t, 0)), IRON, { Mat = METAL })
	end
end

--==================================================================
-- GROUND, WATER, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	local quay: Kit.Opts = { Mat = COBBLE, Solid = true }
	Kit.Box(f, V(-190, -4, Z0), V(104, 0, Z1), QUAY, { Mat = COBBLE, Solid = true, Name = "Ground_Harbor" })
	Kit.Box(f, V(104, -4, Z0), V(146, 0, 1600), QUAY, quay)
	Kit.Box(f, V(104, -4, 1650), V(146, 0, Z1), QUAY, quay)
	-- shallow wading inlet: solid floor at Y -0.5 (half-stud step, no pit) under clear water
	Kit.Box(f, V(104, -4, 1600), V(146, -0.5, 1650), C(80, 120, 125), { Mat = Enum.Material.Sand, Solid = true, Name = "InletFloor" })
	Kit.Box(f, V(104, -0.5, 1600), V(146, -0.15, 1650), SEA_TEAL, { Transp = 0.45, Refl = 0.2, Name = "InletWater" })
	-- timber edging around the inlet and a sea-gate beam hiding the step down to the ocean
	Kit.Box(f, V(102.8, -0.5, 1600), V(104, 0.3, 1650), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1598.8), V(140, 0.3, 1600), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1650), V(140, 0.3, 1651.2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(144, -2, 1598.8), V(146, 0.4, 1651.2), PLANK_DARK, { Mat = WOOD })
	Kit.AddRect(102, 1598, 140, 1652)

	-- the ocean (outside the play area), moonlit streaks and a few rocks
	Kit.Box(f, V(146, -3, Z0), V(190, -1.5, Z1), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(190, -3, 1520), V(560, -1.5, 1960), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(170, -1.5, 1700), V(540, -1.44, 1712), C(170, 225, 235), { Transp = 0.45 })
	Kit.Box(f, V(200, -1.5, 1726), V(540, -1.44, 1732), C(170, 225, 235), { Transp = 0.55 })
	Kit.Disc(f, 420, 1716, -1.42, 46, 0.06, C(250, 245, 215), { Transp = 0.35, Name = "MoonGlow" })
	for _, r in { { 232, 1612, 18 }, { 262, 1846, 24 }, { 205, 1900, 14 }, { 300, 1760, 12 } } do
		Kit.Ball(f, r[3], V(r[1], -4, r[2]), C(85, 95, 115), { Mat = ROCK })
	end

	-- boardwalk path along X = 0 with painted teal edges
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), PLANK, { Mat = PLANKS, Solid = true, Name = "Boardwalk" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, Z0), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(TEAL))
	end
	-- plank dock patches on the quay (flat)
	for _, d in { { 30, 1598, 102, 1660 }, { -110, 1576, -40, 1610 }, { 30, 1790, 100, 1840 }, { -108, 1830, -30, 1890 } } do
		Kit.Box(f, V(d[1], 0, d[2]), V(d[3], 0.04, d[4]), PLANK, { Mat = PLANKS })
	end
end

local function sideWalls(f: Instance)
	-- -X: brick harbour wall with slate cap and wooden posts topped with buoys
	local brick = C(160, 86, 74)
	Kit.Box(f, V(-146, 0, Z0 + 3), V(-140, 14, Z1 - 3), brick, { Mat = Enum.Material.Brick, Solid = true })
	Kit.Box(f, V(-146.6, 14, Z0 + 3), V(-139.4, 15.2, Z1 - 3), C(70, 110, 150), { Mat = Enum.Material.Slate })
	Kit.Box(f, V(-139.95, 3, Z0 + 3), V(-139.7, 3.8, Z1 - 3), Kit.Vivid(TEAL))
	local n = 0
	for z = Z0 + 20, Z1 - 15, 30 do
		n += 1
		Kit.Box(f, V(-147, 0, z - 2), V(-139, 17, z + 2), PLANK_DARK, { Mat = WOOD, Solid = true })
		Kit.Ball(f, 3, V(-143, 18.2, z), Kit.Vivid(if n % 2 == 0 then RED else TEAL))
	end
	-- life rings on the wall facing the docks
	for _, z in { 1650, 1770, 1890 } do
		Kit.CylFlat(f, 0.5, 3.4, V(-139.5, 8, z), "X", Kit.Vivid(RED))
		Kit.CylFlat(f, 0.6, 1.6, V(-139.45, 8, z), "X", C(240, 240, 235))
	end
	-- town houses behind the wall (backdrop)
	local houses = { C(120, 80, 110), C(70, 110, 140), C(150, 90, 75), C(80, 125, 120), C(120, 95, 70), C(95, 85, 140) }
	for i, z in { 1584, 1640, 1700, 1760, 1820, 1882 } do
		local h = 22 + (i % 3) * 6
		Kit.Box(f, V(-186, 0, z - 13), V(-152, h, z + 13), houses[i], { Mat = if i % 2 == 0 then PLANKS else Enum.Material.Brick })
		gable(f, CFrame.new(-169, h, z) * CFrame.Angles(0, math.pi / 2, 0), 28, 38, 10, C(55, 70, 105), Enum.Material.Slate)
		local ghostly = i % 2 == 1
		Kit.Box(f, V(-152.3, h - 9, z - 3), V(-151.9, h - 4, z + 3), if ghostly then SPECTRAL else WARM, { Mat = if ghostly then NEON else Enum.Material.SmoothPlastic })
	end

	-- +X: low quay curb, rope railing on posts (gaps at the inlet and where the ship's hull is)
	local curb = C(100, 112, 130)
	Kit.Box(f, V(140, 0, Z0 + 3), V(146, 1, 1600), curb, { Mat = COBBLE, Solid = true })
	Kit.Box(f, V(140, 0, 1650), V(146, 1, Z1 - 3), curb, { Mat = COBBLE, Solid = true })
	for _, seg in { { 1566, 1598 }, { 1652, 1664 }, { 1818, 1914 } } do
		local a, b = seg[1], seg[2]
		local z = a
		while z <= b do
			Kit.Cyl(f, 5, 1.2, CFrame.new(143, 3, z), PLANK_DARK, { Mat = WOOD })
			z += 16
		end
		Kit.CylFlat(f, b - a, 0.4, V(143, 4, (a + b) / 2), "Z", ROPE, { Mat = FABRIC })
	end
	-- decorative pier out into the ocean (beyond the wall)
	Kit.Box(f, V(146, -0.8, 1578), V(190, -0.2, 1590), PLANK, { Mat = PLANKS })
	for x = 152, 186, 11 do
		for _, z in { 1577.5, 1590.5 } do
			Kit.Cyl(f, 5, 1.3, CFrame.new(x, -1.5, z), PLANK_DARK, { Mat = WOOD })
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ship(f: Instance)
	local m = Kit.Model(f, "GhostShip")
	local cx = 152
	local x0, x1 = 130, 174
	local zs, ze, zt = 1672, 1778, 1810 -- stern, start of bow, bow tip
	local deckOpts: Kit.Opts = { Mat = PLANKS }

	-- hull + bow + deck
	Kit.Box(m, V(x0, -6, zs), V(x1, 17, ze), HULL, SOLID_PLANKS)
	bowHalf(m, cx, x0, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	bowHalf(m, cx, x1, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 17, zs), V(x1 - 1, 18, ze), PLANK, deckOpts)
	bowHalf(m, cx, x0 + 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	bowHalf(m, cx, x1 - 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	-- bulwarks
	Kit.Box(m, V(x0, 17, zs), V(x0 + 1.2, 21, ze), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1.2, 17, zs), V(x1, 21, ze), HULL, deckOpts)
	Props.Beam(m, V(x0 + 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	Props.Beam(m, V(x1 - 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	-- muted red wale, teal waterline and gold rail on the side players see (-X), plus the bow
	Kit.Box(m, V(x0 - 0.3, 9, zs), V(x0 + 0.2, 11.5, ze), Kit.Vivid(RED), { Mat = WOOD })
	Props.Beam(m, V(x0 - 0.2, 10.25, ze), V(cx, 10.25, zt + 0.3), 0.6, 2.5, Kit.Vivid(RED), { Mat = WOOD })
	Kit.Box(m, V(x0 - 0.25, -1.5, zs), V(x0 + 0.2, 0.3, ze), Kit.Vivid(TEAL))
	Kit.Box(m, V(x0 - 0.35, 20.6, zs), V(x0 + 1.3, 21.3, ze), Kit.Vivid(GOLD), { Mat = METAL })

	-- stern castle (faces players arriving from the gate)
	Kit.Box(m, V(x0, 17, zs), V(x1, 30, 1700), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 30, zs), V(x1 - 1, 31, 1700), PLANK, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x0 + 1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1, 30, zs), V(x1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x1, 33.5, zs + 1), HULL, deckOpts)
	Kit.Box(m, V(x0 - 0.3, 29, zs - 0.3), V(x1 + 0.3, 30, 1700), Kit.Vivid(RED), { Mat = WOOD })
	for i = -1, 1 do
		local x = cx + i * 12
		local win = Kit.Box(m, V(x - 2.6, 20, zs - 0.35), V(x + 2.6, 26.5, zs + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
		Kit.Box(m, V(x - 3.2, 19.4, zs - 0.2), V(x + 3.2, 27.1, zs + 0.1), Kit.Vivid(GOLD), { Mat = METAL })
		if i == 0 then
			Kit.Light(win, SPECTRAL, 30, 1.4)
		end
		Kit.Box(m, V(x - 2.4, 6, zs - 0.25), V(x + 2.4, 10.5, zs + 0.1), C(40, 60, 85))
	end
	-- forecastle
	Kit.Box(m, V(x0, 17, 1758), V(x1, 23, ze), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 23, 1758), V(x1 - 1, 23.6, ze), PLANK, deckOpts)

	-- masts, yards, tattered sails, crow's nest, ropes
	local masts = { { 1712, 80 }, { 1738, 102 }, { 1764, 88 } }
	local tops: { Vector3 } = {}
	for i, mst in masts do
		local z, top = mst[1], mst[2]
		Kit.Cyl(m, top - 17, 3, CFrame.new(cx, (17 + top) / 2, z), MAST, { Mat = WOOD, Shadow = true })
		local span = top - 17
		local yA = 17 + span * 0.55
		local yB = 17 + span * 0.88
		local lowW = 34 + i * 2
		Kit.CylFlat(m, lowW + 4, 1.2, V(cx, yA, z), "X", MAST, { Mat = WOOD })
		Kit.CylFlat(m, lowW - 4, 1.1, V(cx, yB, z), "X", MAST, { Mat = WOOD })
		local col = if i == 2 then SAIL_TEAL else SAIL
		local sailOpts: Kit.Opts = { Mat = FABRIC, Transp = 0.06 }
		-- lower sail torn into two ragged halves plus a dangling strip
		local h1 = (yA - 22) * 0.95
		local h2 = (yA - 22) * 0.7
		Kit.Part(m, V(lowW / 2 - 1, h1, 0.5), CFrame.new(cx - lowW / 4, yA - h1 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0), col, sailOpts)
		Kit.Part(m, V(lowW / 2 - 1, h2, 0.5), CFrame.new(cx + lowW / 4, yA - h2 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0.04), col, sailOpts)
		Kit.Part(m, V(3, h1 - h2 + 2, 0.4), CFrame.new(cx + lowW / 4 + 3, yA - h2 - (h1 - h2) / 2, z + 1.1) * CFrame.Angles(0, 0, 0.18), col, sailOpts)
		local hU = (yB - yA) - 3
		Kit.Part(m, V(lowW - 8, hU, 0.5), CFrame.new(cx, yB - hU / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.06, 0, 0), if i == 2 then SAIL else SAIL_TEAL, sailOpts)
		table.insert(tops, V(cx, top - 3, z))
		-- shrouds: two to the -X bulwark (visible side), one to +X
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z - 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z + 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x1 - 0.6, 21, z), 0.35, 0.35, ROPE)
	end
	Props.Beam(m, tops[1], tops[2], 0.35, 0.35, ROPE)
	Props.Beam(m, tops[2], tops[3], 0.35, 0.35, ROPE)
	Kit.Cyl(m, 3, 8, CFrame.new(cx, 86.5, 1738), PLANK_DARK, { Mat = WOOD })
	-- ghostly flag on the main mast
	local flag = Kit.Part(m, V(0.4, 7, 11), CFrame.new(cx, 97, 1738 - 6.5), C(40, 34, 55), { Mat = FABRIC })
	Kit.Sign(flag, Enum.NormalId.Left, "👻", C(240, 240, 240))
	-- bowsprit + forestay
	local sprTip = V(cx, 31, zt + 22)
	Props.Beam(m, V(cx, 20, zt - 6), sprTip, 1.6, 1.6, MAST, { Mat = WOOD })
	Props.Beam(m, tops[3], sprTip, 0.35, 0.35, ROPE)

	-- spectral figurehead
	Props.Beam(m, V(cx, 7, zt - 1), V(cx, 13.5, zt + 1.6), 3, 2.4, C(200, 240, 235), { Transp = 0.15 })
	Kit.Ball(m, 3.6, V(cx, 15.4, zt + 2), C(210, 245, 240), { Transp = 0.15 })
	Kit.Wedge(m, V(3.4, 4, 2), CFrame.new(cx, 14.5, zt + 0.6), C(150, 225, 220), { Transp = 0.15 })
	local heart = Kit.Ball(m, 1.6, V(cx, 11.6, zt + 2.2), SPECTRAL, { Mat = NEON })
	Kit.Light(heart, SPECTRAL, 28, 1.8)

	-- cannons and gun ports on the -X side
	for i = 0, 5 do
		local z = 1708 + i * 12
		Kit.Box(m, V(x0 - 0.25, 12.3, z - 1.6), V(x0 + 0.1, 15.3, z + 1.6), C(30, 25, 32))
		Kit.CylFlat(m, 6, 1.8, V(x0 - 2.6, 13.8, z), "X", IRON, { Mat = METAL })
	end
	-- glowing portholes with brass rims
	for i = 0, 7 do
		local z = 1680 + i * 12
		Kit.CylFlat(m, 0.3, 3.2, V(x0 - 0.15, 4.5, z), "X", Kit.Vivid(GOLD), { Mat = METAL })
		Kit.CylFlat(m, 0.2, 2.3, V(x0 - 0.38, 4.5, z), "X", SPECTRAL, { Mat = NEON })
	end
	-- spectral rune zigzag on the hull
	local runes = { V(x0 - 0.3, 0.8, 1690), V(x0 - 0.3, 7.6, 1700), V(x0 - 0.3, 1.2, 1712), V(x0 - 0.3, 7.2, 1724) }
	for i = 1, #runes - 1 do
		Props.Beam(m, runes[i], runes[i + 1], 0.35, 0.35, PURPLE, { Mat = NEON })
	end
	-- name board
	Props.SignBoard(m, V(x0 - 0.5, 13.8, 1690), 16, 3.2, -1, 0, "THE SALTY SPECTER", C(40, 30, 45), Kit.Vivid(GOLD), GOLD)

	-- green deck fog
	local fog = Kit.Part(m, V(30, 0.2, 70), CFrame.new(cx, 19, 1735), SPECTRAL, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, SPECTRAL, 2, 10, 0.3)

	-- mooring bollards with ropes up to the hull
	for _, z in { 1690, 1770 } do
		Kit.Cyl(m, 2.4, 2, CFrame.new(121, 1.2, z), IRON, { Mat = METAL, Solid = true })
		Kit.Cyl(m, 0.6, 2.8, CFrame.new(121, 2.5, z), IRON, { Mat = METAL })
		Props.Beam(m, V(121, 2.2, z), V(x0 - 0.2, 16, z + 4), 0.4, 0.4, ROPE)
		Kit.AddCircle(121, z, 2)
	end
	Kit.AddRect(124, zs - 6, 140, zt + 4)
end

local function lighthouse(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Lighthouse")
	local white, red = C(248, 245, 238), Kit.Vivid(C(205, 60, 60))
	local rock = C(105, 112, 125)
	Kit.Disc(m, x, z, 1.5, 24, 2, rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 9, V(x + 9, 0, z - 7), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 7, V(x - 7, 0, z + 9), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 6, V(x + 6, 0, z + 9), C(90, 100, 115), { Mat = ROCK })
	local seg = 12
	for i = 0, 5 do
		local d = 16 - i * 0.8
		Kit.Cyl(m, seg, d, CFrame.new(x, 1.5 + seg * i + seg / 2, z), if i % 2 == 0 then red else white, { Mat = Enum.Material.Plastic, Solid = true, Shadow = true })
	end
	-- door and windows on the side facing the boardwalk (-X)
	Kit.Box(m, V(x - 8.1, 1.5, z - 2.4), V(x - 7.4, 9, z + 2.4), PLANK_DARK, { Mat = WOOD })
	Kit.Box(m, V(x - 8.25, 8.6, z - 2.9), V(x - 7.4, 9.4, z + 2.9), Kit.Vivid(TEAL))
	for _, w in { { 1, 26 }, { 3, 50 } } do
		local r = (16 - w[1] * 0.8) / 2
		Kit.Box(m, V(x - r - 0.2, w[2] - 2, z - 1.2), V(x - r + 0.6, w[2] + 2, z + 1.2), C(55, 85, 120))
	end
	-- gallery + railing
	Kit.Disc(m, x, z, 75.5, 19, 1.5, IRON, { Mat = METAL })
	local posts: { Vector3 } = {}
	for i = 0, 5 do
		local a = i * math.pi / 3
		local p = V(x + math.cos(a) * 9, 75.5, z + math.sin(a) * 9)
		Kit.Box(m, p + V(-0.2, 0, -0.2), p + V(0.2, 3, 0.2), IRON, { Mat = METAL })
		table.insert(posts, p + V(0, 3, 0))
	end
	for i = 1, 6 do
		Props.Beam(m, posts[i], posts[(i % 6) + 1], 0.3, 0.3, red, { Mat = METAL })
	end
	-- lamp room: glass drum, warm lamp, frame
	Kit.Cyl(m, 8, 10, CFrame.new(x, 79.5, z), C(175, 230, 235), { Mat = Enum.Material.Glass, Transp = 0.5, Refl = 0.2 })
	local lamp = Kit.Ball(m, 4.5, V(x, 79.5, z), C(255, 225, 140), { Mat = NEON })
	Kit.Light(lamp, C(255, 215, 140), 60, 2.4)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * 5, z + math.sin(a) * 5
		Kit.Box(m, V(px - 0.25, 75.5, pz - 0.25), V(px + 0.25, 83.6, pz + 0.25), IRON, { Mat = METAL })
	end
	-- roof
	Kit.Disc(m, x, z, 84.5, 12.5, 1, red)
	Kit.Cyl(m, 2, 9, CFrame.new(x, 85.5, z), red)
	Kit.Cyl(m, 2, 6, CFrame.new(x, 87.5, z), red)
	Kit.Cyl(m, 2, 3, CFrame.new(x, 89.5, z), red)
	Kit.Ball(m, 1.8, V(x, 91.2, z), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Cyl(m, 3, 0.3, CFrame.new(x, 93.5, z), IRON, { Mat = METAL })
	Kit.AddCircle(x, z, 14)
end

local function warehouse(f: Instance, z1: number, z2: number, wall: Color3, roof: Color3, text: string, flicker: boolean)
	local m = Kit.Model(f, "Warehouse")
	local xb, xf = -138, -112
	local h = 18
	local sol: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }
	Kit.Box(m, V(xb, 0, z1), V(xb + 2, h, z2), wall, sol)
	Kit.Box(m, V(xb, 0, z1), V(xf, h, z1 + 2), wall, sol)
	Kit.Box(m, V(xb, 0, z2 - 2), V(xf, h, z2), wall, sol)
	for _, zz in { z1, z2 - 2 } do
		Kit.Box(m, V(xf - 0.6, 0, zz - 0.3), V(xf + 0.8, h + 0.4, zz + 2.3), PLANK_DARK, { Mat = WOOD, Solid = true })
	end
	local fascia = Kit.Box(m, V(xf - 1, h - 4, z1), V(xf + 0.6, h, z2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Sign(fascia, Enum.NormalId.Right, text, Kit.Vivid(C(255, 225, 120)), { Stroke = C(30, 40, 60) })
	gable(m, CFrame.new((xb + xf) / 2, h, (z1 + z2) / 2) * CFrame.Angles(0, math.pi / 2, 0), z2 - z1 + 2, xf - xb + 4, 9, roof, Enum.Material.Slate)
	Kit.Box(m, V(xb + 2, 0, z1 + 2), V(xf, 0.06, z2 - 2), PLANK, { Mat = PLANKS })
	-- one ghostly window on the side wall that faces the gate
	Kit.Box(m, V(-130, 8, z1 - 0.25), V(-122, 12.5, z1 + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	-- stacked cargo inside
	local rng = Kit.Rng
	for zz = z1 + 6, z2 - 6, 7 do
		crate(m, V(-133.5, 0, zz), 5, rng:NextNumber(-0.1, 0.1))
		if rng:NextNumber() < 0.6 then
			crate(m, V(-133.5, 5, zz), 4.2, rng:NextNumber(-0.25, 0.25))
		end
	end
	barrel(m, V(-124, 0, z1 + 6), 4)
	barrel(m, V(-121, 0, z1 + 8.5), 4)
	-- hanging lantern at the front
	local lx, lz = xf + 1.6, (z1 + z2) / 2
	Kit.Box(m, V(lx - 0.15, h - 6, lz - 0.15), V(lx + 0.15, h - 4, lz + 0.15), IRON)
	local lamp = Kit.Box(m, V(lx - 0.8, h - 8, lz - 0.8), V(lx + 0.8, h - 6, lz + 0.8), WARM, if flicker then { Mat = NEON } else {})
	if flicker then
		Kit.Light(lamp, WARM, 22, 1.4, true)
	end
	Kit.AddRect(xb - 2, z1 - 1, xf + 3, z2 + 1)
end

local function hut(f: Instance, x: number, z: number, fx: number, col: Color3)
	local m = Kit.Model(f, "FishingHut")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	Kit.Part(m, V(10, 9, 9), base * CFrame.new(0, 4.5, 0), col, { Mat = PLANKS, Solid = true, Shadow = true })
	Kit.Wedge(m, V(12, 3, 11), base * CFrame.new(0, 10.5, 0), C(60, 80, 115), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(3, 6, 0.3), base * CFrame.new(-2, 3, -4.6), PLANK_DARK, { Mat = WOOD })
	Kit.Part(m, V(2.6, 2.2, 0.3), base * CFrame.new(2.4, 5.2, -4.6), C(255, 215, 120))
	Kit.Part(m, V(0.2, 5, 6), base * CFrame.new(5.1, 4.8, 0), C(200, 190, 160), { Mat = FABRIC, Transp = 0.45 })
	Kit.CylFlat(m, 0.5, 2.6, (base * CFrame.new(2.4, 2.4, -4.8)).Position, "X", Kit.Vivid(RED))
	Props.Beam(m, (base * CFrame.new(-4.5, 1, -4.8)).Position, (base * CFrame.new(-6, 9, -9)).Position, 0.25, 0.25, PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function treasure(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TreasurePile")
	local gold = Kit.Vivid(GOLD)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.2 }
	Kit.Ball(m, 9, V(x, -2.2, z), gold, mo)
	Kit.Ball(m, 6, V(x + 4, -1.6, z - 3.5), gold, mo)
	-- chest
	local wood = C(135, 82, 48)
	Kit.Box(m, V(x - 3, 0, z + 2), V(x + 2.4, 3.2, z + 5.6), wood, { Mat = WOOD, Solid = true })
	Kit.CylFlat(m, 5.4, 3.6, V(x - 0.3, 3.2, z + 3.8), "X", wood, { Mat = WOOD })
	for _, bx in { -2.2, 1.6 } do
		Kit.Box(m, V(x + bx - 0.3, 0, z + 1.9), V(x + bx + 0.3, 5.1, z + 5.7), gold, { Mat = METAL })
	end
	Kit.Box(m, V(x - 0.8, 2.2, z + 1.8), V(x + 0.2, 3.4, z + 2), gold, { Mat = METAL })
	-- spilled coins, gems, a crown
	for i = 0, 3 do
		local a = i * 1.7
		Kit.Disc(m, x + math.cos(a) * 6, z + math.sin(a) * 6, 0.25, 1.8, 0.2, gold, mo)
	end
	for i, g in { C(230, 60, 90), C(60, 200, 210), C(170, 90, 240) } do
		Kit.Ball(m, 1.3, V(x - 2 + i * 1.4, 2.3 - i * 0.3, z - 1 + i * 0.6), Kit.Vivid(g), { Refl = 0.3 })
	end
	Kit.Cyl(m, 1.2, 2.6, CFrame.new(x + 0.4, 2.6, z - 0.4) * CFrame.Angles(0.2, 0, 0.15), gold, mo)
	Props.SignBoard(m, V(x - 6.5, 3, z - 4), 6, 2.4, -1, 0, "DO NOT TOUCH\n(CURSED)", C(245, 238, 220), Kit.Vivid(RED))
	Kit.Box(m, V(x - 6.65, 0, z - 4.2), V(x - 6.35, 1.8, z - 3.8), PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function anchor(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Anchor")
	local col = C(70, 95, 110)
	Kit.Disc(m, x, z, 0.6, 9, 0.6, C(90, 100, 115), { Mat = COBBLE, Solid = true })
	Kit.Box(m, V(x - 1, 0, z - 1), V(x + 1, 15, z + 1), col, { Mat = METAL, Solid = true })
	Kit.Box(m, V(x - 5, 12, z - 0.8), V(x + 5, 13.6, z + 0.8), col, { Mat = METAL })
	Kit.Ball(m, 2.6, V(x, 16.4, z), Kit.Vivid(TEAL), { Mat = METAL })
	for _, s in { -1, 1 } do
		Props.Beam(m, V(x, 1.2, z), V(x + s * 6, 5.5, z), 1.6, 1.6, col, { Mat = METAL })
		Kit.Ball(m, 2.8, V(x + s * 6.2, 5.8, z), col, { Mat = METAL })
	end
	Kit.AddCircle(x, z, 7)
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function deckPads(f: Instance)
	local pads = { { 0, 1645, 30 }, { -82, 1680, 24 }, { 75, 1740, 26 }, { -62, 1800, 24 }, { 0, 1860, 24 } }
	for i, p in pads do
		local ring = if i % 2 == 0 then Kit.Vivid(TEAL) else Kit.Vivid(C(110, 90, 170))
		Kit.Disc(f, p[1], p[2], 0.07, p[3] * 2 + 4, 0.07, ring)
		Kit.Disc(f, p[1], p[2], 0.1, p[3] * 2, 0.1, if i % 2 == 0 then PLANK else C(150, 108, 72), { Mat = PLANKS })
	end
	-- boss: compass rose + spectral rune ring
	local bx, bz = 0, 1860
	local gold = Kit.Vivid(GOLD)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Props.Beam(f, V(bx, 0.13, bz), V(bx + math.cos(a) * 18, 0.13, bz + math.sin(a) * 18), 2.6, 0.06, gold)
		local b = a + math.pi / 4
		Props.Beam(f, V(bx, 0.12, bz), V(bx + math.cos(b) * 11, 0.12, bz + math.sin(b) * 11), 1.8, 0.05, Kit.Vivid(TEAL))
	end
	Kit.Disc(f, bx, bz, 0.17, 5, 0.1, gold, { Mat = METAL })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.12
		local a2 = a1 + math.pi / 4 - 0.24
		Props.Beam(f, V(bx + math.cos(a1) * 21, 0.14, bz + math.sin(a1) * 21), V(bx + math.cos(a2) * 21, 0.14, bz + math.sin(a2) * 21), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Harbor.Build(map: Instance)
	local f = Kit.Folder(map, "Harbor")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	deckPads(f)
	ship(f)
	lighthouse(f, 116, 1866)
	warehouse(f, 1596, 1636, C(160, 82, 70), C(55, 95, 130), "FISH & SHIPS", false)
	warehouse(f, 1716, 1764, C(90, 110, 140), C(140, 60, 60), "CARGO", true)
	warehouse(f, 1836, 1880, C(130, 95, 75), C(60, 110, 120), "DOCK 13", false)

	-- pier across the inlet with a fishing hut at its end
	Kit.Box(f, V(104, -0.5, 1617), V(140, 0.06, 1631), PLANK, { Mat = PLANKS, Solid = true, Name = "Pier" })
	for _, x in { 107, 117, 127 } do
		for _, z in { 1616.6, 1631.4 } do
			Kit.Cyl(f, 3.5, 1.2, CFrame.new(x, 1.25, z), PLANK_DARK, { Mat = WOOD })
		end
	end
	hut(f, 133, 1624, -1, C(110, 140, 160))
	if Kit.IsFree(122, 1578, 7) then
		hut(f, 122, 1578, -1, C(170, 110, 90))
	end
	if Kit.IsFree(-64, 1600, 7) then
		hut(f, -64, 1600, 1, C(120, 150, 125))
	end
	if Kit.IsFree(70, 1830, 7) then
		hut(f, 70, 1830, -1, C(150, 120, 170))
	end

	-- floating spectral lanterns over the inlet and drifting bottles by the treasure
	for _, p in { V(110, 3.6, 1606), V(122, 4.2, 1644), V(136, 3.8, 1608), V(112, 4.4, 1641) } do
		local l = Kit.Part(f, V(1.2, 1.7, 1.2), CFrame.new(p), C(170, 255, 200), { Mat = NEON, Name = "FloatingLantern" })
		Kit.Float(l, rng:NextNumber(0.5, 1))
	end
	for _, p in { V(108, 3.5, 1712), V(124, 3.2, 1736) } do
		local b = Kit.Cyl(f, 1.8, 0.9, CFrame.new(p) * CFrame.Angles(0.5, 0, 0.3), C(120, 200, 170), { Mat = Enum.Material.Glass, Transp = 0.3, Name = "FloatingBottle" })
		Kit.Float(b, rng:NextNumber(0.5, 0.9))
	end
	-- pale fog rolling off the inlet
	local fog = Kit.Part(f, V(30, 0.2, 40), CFrame.new(122, 0.6, 1625), C(200, 235, 240), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(200, 235, 240), 1.5, 9, 0.3)

	treasure(f, 114, 1722)
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 40, 1872, 6) then
			anchor(f, s * 40, 1872)
		end
	end

	-- signs
	do
		local x, z = -60, 1578
		for _, s in { -1, 1 } do
			Kit.Cyl(f, 15, 1.4, CFrame.new(x + s * 11, 7.5, z), PLANK_DARK, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 12, z), 22, 6, 0, -1, "⚓ HARBOR ⚓", C(40, 70, 110), C(255, 235, 170), TEAL)
		Kit.AddCircle(x, z, 13)
	end
	if Kit.IsFree(18, 1698, 4) then
		Kit.Box(f, V(17.6, 0, 1698.2), V(18.4, 5, 1698.8), PLANK_DARK, { Mat = WOOD })
		Props.SignBoard(f, V(18, 6.5, 1698), 12, 5, 0, -1, "NO GHOSTS ALLOWED\n...OOPS", C(245, 240, 225), Kit.Vivid(RED), RED)
		Kit.AddCircle(18, 1698, 6)
	end

	-- harbour lamps along the boardwalk
	local lit = 0
	for z = 1590, 1900, 34 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 17 else 0)
			local x = s * 12.5
			if Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0, zz), WARM, lit == 1 or lit == 4 or lit == 7)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- cargo: crate stacks, barrel groups, rope coils, scattered on free quay
	local stacks, barrels, coils = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1572, 1908)
		if stacks < 16 and Kit.IsFree(x + 2.3, z, 5.5) then
			stacks += 1
			local yaw = rng:NextNumber(-0.3, 0.3)
			crate(f, V(x, 0, z), 4.5, yaw)
			crate(f, V(x + 4.6, 0, z + rng:NextNumber(-0.5, 0.5)), 4.5, yaw)
			if rng:NextNumber() < 0.6 then
				crate(f, V(x + 2.3, 4.5, z), 4, yaw + 0.2)
			end
			Kit.AddCircle(x + 2.3, z, 5.5)
		elseif barrels < 12 and Kit.IsFree(x + 1.4, z, 4) then
			barrels += 1
			barrel(f, V(x, 0, z), 4.2)
			barrel(f, V(x + 2.9, 0, z + 1), 4.2)
			if rng:NextNumber() < 0.5 then
				Kit.CylFlat(f, 4.2, 2.8, V(x + 1.4, 1.4, z - 2.6), "X", C(150, 100, 62), { Mat = WOOD })
			end
			Kit.AddCircle(x + 1.4, z, 4)
		elseif coils < 6 and Kit.IsFree(x, z, 2) then
			coils += 1
			Kit.Disc(f, x, z, 0.6, 3.6, 0.6, ROPE, { Mat = FABRIC })
			Kit.Disc(f, x, z, 0.65, 1.4, 0.1, PLANK_DARK)
			Kit.AddCircle(x, z, 2)
		end
	end

	-- a few spectral cracks in the quay
	for _ = 1, 4 do
		local p = V(rng:NextNumber(-120, 95), 0.13, rng:NextNumber(1600, 1890))
		local a = rng:NextNumber(0, math.pi * 2)
		Props.Beam(f, p, p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(5, 9), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

return Harbor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Hospital</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 5: Haunted Hospital (Z 1220..1560). Playful, pastel and a little supernatural (no gore).
--   Courtyard Z 1220..1268: path, Medical crate station (built by Stations), ambulance, sign,
--   planters, entrance canopy with the HOSPITAL facade and a red cross on a blue/white emblem.
--   Building X -113..113, Z 1269..1535, two-tone walls 16 tall, NO roof (parapet only) so the
--   camera and ghost taps work from above. Rooms (ghost areas in brackets):
--     Lobby / waiting room  X -51..49,  Z 1271..1351  [ (0,1305) r30 ]   reception desk, chairs
--     Ward B                X -111..-53, Z 1271..1397  [ (-82,1340) r24 ] beds in the corners
--     Patient rooms         X 51..111,   Z 1271..1351                    beds, curtains, monitors
--     X-Ray                 X 41..111,   Z 1353..1443  [ (75,1395) r26 ]  machine, lightbox
--     Atrium (hallway)      X -51..39,   Z 1353..1443                    elevators, carts
--     Paranormal lab        X -111..-33, Z 1399..1533  [ (-62,1455) r24 ] ecto tanks, spirit coil
--     Director's office     X -31..31,   Z 1445..1533  [ (0,1505) r22 boss ]
--     Pharmacy              X 33..111,   Z 1445..1533                    counter, shelves
--   Main path: front door (X -14..14) -> lobby -> atrium -> director's office -> back door
--   (X -14..14) -> back yard -> Harbor gate. Every doorway is a full-height opening >= 16 wide.
--   Landmark: the west wing tower (X -111..-85, Z 1507..1533, roof Y 72, antenna to ~Y 83).
-- Glow is kept to a few ghostly windows, ecto tanks, puddles, sconces and small lamps.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Hospital = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal
local CONCRETE = Enum.Material.Concrete
local WOOD = Enum.Material.WoodPlanks

local MIN_Z, MAX_Z = 1220, 1560
local H = 16
local FLOOR_Y = 0.13 -- top of the room floor paint
local WHITE = C(242, 244, 248)
local LBLUE = C(150, 205, 240)
local MGREEN = C(150, 200, 170)
local PURPLE = C(170, 120, 230)
local SPECT = C(130, 255, 190)
local DARK = C(45, 55, 85)
local REDX = C(235, 70, 80)
local GREY = C(190, 195, 210)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

--==================================================================
-- WALL HELPERS (two-tone: mint wainscot below, off-white above)
--==================================================================
type Opening = { c: number, w: number }

local LOWER = C(170, 215, 195)
local UPPER = C(236, 240, 244)

local function seg(parent: Instance, lo: Vector3, hi: Vector3)
	Kit.Box(parent, V(lo.X, 0, lo.Z), V(hi.X, 4.5, hi.Z), LOWER, SOLID)
	Kit.Box(parent, V(lo.X, 4.5, lo.Z), V(hi.X, H, hi.Z), UPPER, SOLID)
end

local function byCentre(a: Opening, b: Opening): boolean
	return a.c < b.c
end

-- Wall along X at fixed z (thickness 2) with full-height openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = x1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(cur, 0, z - 1), V(a, 0, z + 1))
		end
		cur = o.c + o.w / 2
	end
	if x2 > cur then
		seg(parent, V(cur, 0, z - 1), V(x2, 0, z + 1))
	end
end

-- Wall along Z at fixed x (thickness 2) with full-height openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = z1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(x - 1, 0, cur), V(x + 1, 0, a))
		end
		cur = o.c + o.w / 2
	end
	if z2 > cur then
		seg(parent, V(x - 1, 0, cur), V(x + 1, 0, z2))
	end
end

-- Wall lamp; fx = direction the lamp faces (wall face is behind it).
local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), DARK)
	Kit.Light(lamp, color, 24, 1.5, true)
end

local function puddle(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.22, d, 0.08, SPECT, { Mat = NEON, Transp = 0.25 })
end

--==================================================================
-- FURNITURE
--==================================================================
-- Hospital bed; (hx, hz) points toward the head end.
local function bed(f: Instance, x: number, z: number, hx: number, hz: number)
	local m = Kit.Model(f, "Bed")
	local base = faced(V(x, FLOOR_Y, z), hx, hz)
	Kit.Part(m, V(5, 2.2, 9), base * CFrame.new(0, 1.1, 0), WHITE, { Solid = true })
	Kit.Part(m, V(4.6, 1, 8.6), base * CFrame.new(0, 2.7, 0), Kit.Vivid(LBLUE), { Mat = FABRIC })
	Kit.Part(m, V(3.6, 0.8, 1.8), base * CFrame.new(0, 3.5, -3.2), WHITE, { Mat = FABRIC })
	Kit.Part(m, V(5.4, 5, 0.6), base * CFrame.new(0, 2.5, -4.7), Kit.Vivid(MGREEN))
	Kit.Part(m, V(4.8, 0.4, 4.6), base * CFrame.new(0, 3.3, 1.9), PURPLE:Lerp(WHITE, 0.35), { Mat = FABRIC })
	Kit.AddCircle(x, z, 5)
end

local function ivStand(f: Instance, x: number, z: number)
	Kit.Cyl(f, 7, 0.3, CFrame.new(x, FLOOR_Y + 3.5, z), GREY, { Mat = METAL })
	Kit.Box(f, V(x - 0.4, 5.6, z - 0.2), V(x + 0.4, 7, z + 0.2), Kit.Vivid(MGREEN), { Transp = 0.3 })
end

local function wheelchair(f: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(f, "Wheelchair")
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	local frame = Kit.Vivid(PURPLE)
	Kit.Part(m, V(2.6, 0.5, 2.4), base * CFrame.new(0, 2.2, 0), Kit.Vivid(LBLUE))
	Kit.Part(m, V(2.6, 3, 0.4), base * CFrame.new(0, 3.6, 1.2), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.3, 3.4, 3.4), base * CFrame.new(sx * 1.55, 1.7, 0.3), frame, { Shape = Enum.PartType.Cylinder })
	end
	Kit.Part(m, V(2.2, 0.3, 1), base * CFrame.new(0, 0.8, -1.8), frame)
	Kit.AddCircle(x, z, 2.5)
end

local function medCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "MedCart")
	Kit.Box(m, V(x - 2, 3.2, z - 1.3), V(x + 2, 3.6, z + 1.3), WHITE)
	Kit.Box(m, V(x - 2, 1, z - 1.3), V(x + 2, 1.3, z + 1.3), WHITE)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 1.85, FLOOR_Y, z - 1.3), V(x + s * 2.05, 3.2, z + 1.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x - 1.4, 3.6, z - 0.6), V(x - 0.2, 4.4, z + 0.6), Kit.Vivid(C(255, 150, 190)))
	Kit.Cyl(m, 1.2, 0.7, CFrame.new(x + 1, 4.2, z), Kit.Vivid(MGREEN))
	Kit.AddCircle(x, z, 3)
end

-- Bedside monitor with a SurfaceGui screen facing fx (-1 = -X, 1 = +X).
local function monitor(f: Instance, x: number, z: number, fx: number)
	Kit.Box(f, V(x - 0.25, FLOOR_Y, z - 0.25), V(x + 0.25, 5, z + 0.25), GREY, { Mat = METAL })
	local scr = Kit.Part(f, V(0.4, 2.2, 3), CFrame.new(x, 6, z), DARK)
	Kit.Sign(scr, if fx < 0 then Enum.NormalId.Left else Enum.NormalId.Right, "♥ BOO ♥", SPECT)
end

-- Row of joined waiting-room chairs along Z (facing +X when fx = 1).
local function chairRow(f: Instance, x: number, z1: number, z2: number, fx: number, color: Color3)
	Kit.Box(f, V(x - 1.5, 1.8, z1), V(x + 1.5, 2.4, z2), color, { Solid = true })
	Kit.Box(f, V(x - fx * 1.5, 2.4, z1), V(x - fx * 1, 5, z2), color)
	for _, z in { z1 + 0.8, z2 - 0.8 } do
		Kit.Box(f, V(x - 1.2, FLOOR_Y, z - 0.35), V(x + 1.2, 1.8, z + 0.35), GREY, { Mat = METAL })
	end
	Kit.AddRect(x - 2, z1, x + 2, z2)
end

local function chair(f: Instance, x: number, z: number, fx: number, fz: number, color: Color3)
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	Kit.Part(f, V(2.4, 2, 2.4), base * CFrame.new(0, 1, 0), color, { Solid = true })
	Kit.Part(f, V(2.4, 2.6, 0.5), base * CFrame.new(0, 3.3, 0.95), color)
end

local function plant(f: Instance, x: number, z: number)
	Kit.Cyl(f, 2.4, 2.4, CFrame.new(x, FLOOR_Y + 1.2, z), WHITE)
	Kit.Ball(f, 3.6, V(x, 4, z), C(110, 180, 120), { Mat = Enum.Material.Grass })
	Kit.AddCircle(x, z, 2)
end

local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), C(190, 140, 100), { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), C(190, 140, 100), { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(LBLUE))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function floater(f: Instance, size: Vector3, pos: Vector3, color: Color3, name: string, shape: Enum.PartType?)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local p = Kit.Part(f, size, cf, color, { Name = name, Shape = shape })
	Kit.Float(p, rng:NextNumber(0.6, 1.1))
end

--==================================================================
-- GROUND, SIDE WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(125, 190, 135), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Hospital" })
	-- paved path to the front door and from the back door to the Harbor gate (flat)
	local pave = C(210, 215, 225)
	Kit.Box(f, V(-10, 0, MIN_Z), V(10, 0.05, 1269), pave, { Mat = CONCRETE, Name = "Path" })
	Kit.Box(f, V(-10, 0, 1535), V(10, 0.05, MAX_Z), pave, { Mat = CONCRETE, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, MIN_Z), V(s * 10.8, 0.06, 1269), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 10, 0, 1535), V(s * 10.8, 0.06, MAX_Z), Kit.Vivid(LBLUE))
	end
end

local function sideWalls(f: Instance)
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, z0), V(s * 146, 12, z1), WHITE, { Mat = CONCRETE, Solid = true })
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13.2, z1), Kit.Vivid(LBLUE), { Mat = Enum.Material.Slate })
		Kit.Box(f, V(s * 139.8, 3, z0), V(s * 140, 4.2, z1), Kit.Vivid(MGREEN))
		for i = 1, 7 do
			local z = z0 + i * (z1 - z0) / 8
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), C(215, 225, 235), SOLID)
			Kit.Ball(f, 3.4, V(s * 143, 16.6, z), Kit.Vivid(C(140, 220, 180)))
		end
	end
end

local function outside(f: Instance)
	local hill = { C(110, 160, 140), C(140, 120, 200), C(120, 175, 150) }
	for i, z in { 1265, 1400, 1525 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 190, -14, z - s * 15), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- annex blocks beyond the walls
	for _, a in { V(-1, 0, 1330), V(1, 0, 1440) } do
		local s, z = a.X, a.Z
		Kit.Box(f, V(s * 156, 0, z - 22), V(s * 186, 30, z + 22), C(232, 236, 240), { Mat = CONCRETE })
		Kit.Box(f, V(s * 155.7, 18, z - 20), V(s * 155.9, 23, z + 20), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 155.5, 30, z - 22.5), V(s * 186.5, 31.5, z + 22.5), Kit.Vivid(MGREEN))
	end
	for _, z in { 1240, 1545 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 20 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

--==================================================================
-- COURTYARD
--==================================================================
local function ambulance(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Ambulance")
	local base = faced(V(x, 0, z), -1, 0) -- front toward the path (-X)
	local cargo = Kit.Part(m, V(8, 7.5, 11), base * CFrame.new(0, 5.25, 2.5), WHITE, SOLID)
	cargo.Name = "Cargo"
	Kit.Part(m, V(7.6, 5.5, 5), base * CFrame.new(0, 4.25, -5.5), WHITE, SOLID)
	local glass = Kit.Vivid(C(170, 225, 255))
	Kit.Part(m, V(6.6, 2.4, 0.3), base * CFrame.new(0, 5.6, -8.05), glass, { Refl = 0.2 })
	Kit.Part(m, V(7.7, 2.2, 3), base * CFrame.new(0, 5.6, -5.4), glass, { Refl = 0.2 })
	Kit.Part(m, V(8.1, 1.2, 11.1), base * CFrame.new(0, 4.5, 2.5), REDX)
	Kit.Part(m, V(7.7, 0.8, 5.1), base * CFrame.new(0, 3.2, -5.5), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.2, 3, 1), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		Kit.Part(m, V(0.2, 1, 3), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		for _, sz in { -5, 5.5 } do
			Kit.Part(m, V(1.2, 3.4, 3.4), base * CFrame.new(sx * 3.8, 1.7, sz), DARK, { Shape = Enum.PartType.Cylinder })
		end
		Kit.Part(m, V(0.9, 0.8, 0.2), base * CFrame.new(sx * 2.7, 3, -8.05), C(255, 240, 170))
		Kit.Part(m, V(2.2, 0.9, 1.2), base * CFrame.new(sx * 1.2, 9.45, -1.5), if sx < 0 then REDX else C(90, 160, 255), { Mat = NEON })
	end
	Kit.Part(m, V(7.8, 0.8, 0.6), base * CFrame.new(0, 1.8, -8.3), GREY)
	local tag = Kit.Part(m, V(6, 1, 0.2), base * CFrame.new(0, 7.6, -8.1), WHITE)
	Kit.Sign(tag, Enum.NormalId.Front, "AMBULANCE 👻", REDX, { Stroke = WHITE })
	Kit.AddCircle(x, z, 11)
end

local function courtyard(f: Instance)
	ambulance(f, 72, 1250)
	for _, z in { 1242, 1258 } do
		Kit.Box(f, V(60, 0, z - 0.3), V(86, 0.05, z + 0.3), WHITE)
	end
	-- welcome sign
	Kit.Box(f, V(-74, 0, 1256.5), V(-50, 3, 1259.5), WHITE, { Mat = CONCRETE, Solid = true })
	Props.SignBoard(f, V(-62, 6.4, 1258), 22, 6, 0, -1, "HAUNTED HOSPITAL\nvisiting hours: forever", C(60, 110, 170), WHITE, MGREEN)
	Kit.AddRect(-75, 1255, -49, 1261)
	-- planters
	for _, x in { -96, -44, 44, 96 } do
		if Kit.IsFree(x, 1263, 3) then
			Kit.Box(f, V(x - 2.5, 0, 1260.5), V(x + 2.5, 2, 1265.5), WHITE, { Mat = CONCRETE, Solid = true })
			Kit.Ball(f, 5, V(x, 3, 1263), C(110, 180, 120), { Mat = Enum.Material.Grass })
			Kit.AddCircle(x, 1263, 3)
		end
	end
	Props.StreetLamp(f, V(-104, 0, 1245), C(190, 235, 255), true)
	Props.StreetLamp(f, V(108, 0, 1240), C(190, 235, 255), false)
	Kit.AddCircle(-104, 1245, 1.5)
	Kit.AddCircle(108, 1240, 1.5)
	bench(f, -88, 1232, 0, 1)
	bench(f, 100, 1228, 0, 1)
end

local function entrance(f: Instance)
	-- canopy over the front door
	Kit.Box(f, V(-16.5, 12, 1254), V(16.5, 13.2, 1268.9), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-16.7, 12.2, 1253.8), V(16.7, 13, 1254.1), WHITE)
	for _, s in { -1, 1 } do
		Kit.Cyl(f, 12, 1.4, CFrame.new(s * 14.5, 6, 1258), WHITE, SOLID)
	end
	local lamp = Kit.Box(f, V(-3, 11.6, 1258), V(3, 12, 1262), C(225, 255, 240), { Mat = NEON })
	Kit.Light(lamp, C(210, 255, 235), 24, 1.3)
	Kit.AddRect(-17, 1253, 17, 1269)
	-- facade block over the door (bottom Y 16) with the big sign and the cross emblem
	Kit.Box(f, V(-20, 16, 1266.5), V(20, 30, 1271.5), WHITE, SOLID)
	Kit.Box(f, V(-20.3, 16, 1266.2), V(20.3, 17, 1266.5), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-20.5, 29.5, 1266), V(20.5, 31, 1272), Kit.Vivid(LBLUE))
	local sign = Kit.Part(f, V(30, 6.5, 0.4), CFrame.new(0, 23.4, 1266.2), C(60, 110, 170))
	Kit.Sign(sign, Enum.NormalId.Front, "HOSPITAL", WHITE, { Stroke = C(20, 40, 90) })
	Kit.CylFlat(f, 1, 13, V(0, 37.5, 1269.4), "Z", Kit.Vivid(LBLUE))
	Kit.CylFlat(f, 1, 11.4, V(0, 37.5, 1268.8), "Z", WHITE)
	Kit.Box(f, V(-1.3, 33.5, 1268), V(1.3, 41.5, 1268.4), REDX)
	Kit.Box(f, V(-4, 36.2, 1268), V(4, 38.8, 1268.4), REDX)
end

--==================================================================
-- BUILDING SHELL
--==================================================================
local function shell(f: Instance)
	Kit.Box(f, V(-113, -0.5, 1269), V(113, 0.1, 1535), C(215, 222, 230), { Solid = true, Name = "HospitalFloor" })
	-- room floors (flat paint, top Y 0.13)
	local function floor(x1: number, z1: number, x2: number, z2: number, color: Color3, mat: Enum.Material?)
		Kit.Box(f, V(x1, 0.1, z1), V(x2, FLOOR_Y, z2), color, { Mat = mat })
	end
	local tiles = { C(236, 241, 246), C(190, 222, 238) }
	for i = 0, 3 do
		for j = 0, 2 do
			local x0, z0 = -51 + i * 25, 1271 + j * (80 / 3)
			floor(x0, z0, x0 + 25, z0 + 80 / 3, tiles[((i + j) % 2) + 1])
		end
	end
	floor(-111, 1271, -53, 1397, C(205, 232, 214))
	floor(51, 1271, 111, 1351, C(228, 218, 242))
	floor(41, 1353, 111, 1443, C(205, 220, 242))
	floor(-51, 1353, 39, 1397, C(230, 236, 242))
	floor(-31, 1397, 39, 1443, C(230, 236, 242))
	floor(-111, 1399, -33, 1533, C(212, 236, 226))
	floor(-31, 1445, 31, 1533, C(185, 160, 215), FABRIC)
	floor(33, 1445, 111, 1533, C(242, 232, 214))
	-- light-blue runner along the main path + "follow the line" guides (flat)
	Kit.Box(f, V(-9, FLOOR_Y, 1271), V(9, 0.16, 1533), C(200, 228, 245), { Name = "Runner" })
	Kit.Box(f, V(-4.4, 0.16, 1271), V(-3.6, 0.19, 1533), Kit.Vivid(MGREEN))
	Kit.Box(f, V(3.6, 0.16, 1271), V(4.4, 0.19, 1533), Kit.Vivid(LBLUE))

	-- exterior walls (doors: front + back on the path, one side door each way)
	wallX(f, 1270, -113, 113, { { c = 0, w = 28 } })
	wallX(f, 1534, -113, 113, { { c = 0, w = 28 } })
	wallZ(f, -112, 1271, 1533, { { c = 1470, w = 16 } })
	wallZ(f, 112, 1271, 1533, { { c = 1460, w = 16 } })
	-- interior walls (all outside the ghost circles)
	wallZ(f, -52, 1271, 1398, { { c = 1310, w = 20 } }) -- lobby | ward
	wallZ(f, 50, 1271, 1351, { { c = 1315, w = 20 } }) -- lobby | patient rooms
	wallX(f, 1352, 39, 111, { { c = 80, w = 18 } }) -- patient rooms | x-ray
	wallX(f, 1352, -51, 39, { { c = -6, w = 60 } }) -- lobby | atrium (stubs)
	wallX(f, 1398, -111, -31, { { c = -80, w = 20 } }) -- ward | lab
	wallZ(f, 40, 1353, 1443, { { c = 1398, w = 24 } }) -- atrium | x-ray
	wallX(f, 1444, 31, 111, { { c = 75, w = 20 } }) -- x-ray | pharmacy
	wallZ(f, -32, 1399, 1533, { { c = 1422, w = 18 }, { c = 1505, w = 18 } }) -- lab | atrium, office
	wallZ(f, 32, 1445, 1533, { { c = 1490, w = 20 } }) -- office | pharmacy
	wallX(f, 1444, -31, 31, { { c = 0, w = 40 } }) -- atrium | office (stubs)

	-- parapet on the exterior walls (no roof over the rooms)
	local rim = Kit.Vivid(LBLUE)
	Kit.Box(f, V(-114, H, 1268), V(114, H + 1.6, 1272), rim, SOLID)
	Kit.Box(f, V(-114, H, 1532), V(114, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(-114, H, 1268), V(-110, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(110, H, 1268), V(114, H + 1.6, 1536), rim, SOLID)
	-- corner columns
	for _, x in { -113, 113 } do
		for _, z in { 1270, 1534 } do
			Kit.Cyl(f, 20, 6, CFrame.new(x, 10, z), WHITE, SOLID)
			Kit.Cyl(f, 1.4, 7, CFrame.new(x, 20.7, z), Kit.Vivid(MGREEN))
		end
	end

	-- windows: light-blue glass, a few ghostly ones glow
	local function window(lo: Vector3, hi: Vector3, glow: boolean)
		Kit.Box(f, lo, hi, if glow then SPECT else Kit.Vivid(C(175, 220, 245)), if glow then { Mat = NEON, Transp = 0.1 } else { Refl = 0.15 })
	end
	for _, x in { -100, -80, -55, -32, 32, 55, 80, 100 } do
		Kit.Box(f, V(x - 3.5, 5.5, 1268.7), V(x + 3.5, 12.5, 1268.95), WHITE)
		window(V(x - 2.8, 6, 1268.55), V(x + 2.8, 12, 1268.8), x == -55 or x == 80)
	end
	for _, s in { -1, 1 } do
		for _, z in { 1300, 1340, 1380, 1420, 1495 } do
			if not (s < 0 and z == 1495) then
				Kit.Box(f, V(s * 113, 5.5, z - 3.5), V(s * 113.25, 12.5, z + 3.5), WHITE)
				window(V(s * 113.15, 6, z - 2.8), V(s * 113.4, 12, z + 2.8), (s < 0 and z == 1340) or (s > 0 and z == 1420))
			end
		end
	end
	Kit.Box(f, V(-113.2, 14, 1268.7), V(113.2, 14.6, 1268.9), Kit.Vivid(MGREEN))
	Kit.AddRect(-116, 1266, 116, 1538)
end

--==================================================================
-- TOWER (landmark, back-west corner of the lab)
--==================================================================
local function tower(f: Instance)
	local m = Kit.Model(f, "HospitalTower")
	local x1, x2, z1, z2 = -111, -85, 1507, 1533
	Kit.Box(m, V(x1, 0, z1), V(x2, 64, z2), WHITE, { Solid = true, Shadow = true, Name = "Tower" })
	for _, y in { 16, 32, 48 } do
		Kit.Box(m, V(x1 - 0.3, y, z1 - 0.3), V(x2 + 0.3, y + 1, z2 + 0.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x1 - 0.5, 63.5, z1 - 0.5), V(x2 + 0.5, 65, z2 + 0.5), Kit.Vivid(PURPLE))
	Kit.Box(m, V(x1 + 3, 65, z1 + 3), V(x2 - 3, 72, z2 - 3), C(228, 236, 245), SOLID)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	Kit.Disc(m, cx, cz, 72.4, 16, 0.4, Kit.Vivid(MGREEN))
	local pad = Kit.Box(m, V(cx - 4, 72.4, cz - 4), V(cx + 4, 72.5, cz + 4), WHITE, { Transp = 1 })
	Kit.Sign(pad, Enum.NormalId.Top, "H", WHITE, { Stroke = C(60, 110, 170) })
	Kit.Cyl(m, 10, 0.6, CFrame.new(x2 - 5, 77, z2 - 5), GREY, { Mat = METAL })
	local beacon = Kit.Ball(m, 1.8, V(x2 - 5, 82.5, z2 - 5), C(255, 100, 120), { Mat = NEON })
	Kit.Light(beacon, C(255, 130, 140), 30, 1.2)
	-- windows on the -Z face (toward the Carnival) and the +X face (toward the lab)
	local glass = Kit.Vivid(C(175, 220, 245))
	for row = 0, 1 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local x = x1 + 5 + col * 8
			local glow = (row + col) % 3 == 1
			Kit.Box(m, V(x - 2.5, y - 3, z1 - 0.3), V(x + 2.5, y + 3, z1), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	for row = 0, 2 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local z = z1 + 5 + col * 8
			local glow = (row + col) % 4 == 2
			Kit.Box(m, V(x2, y - 3, z - 2.5), V(x2 + 0.3, y + 3, z + 2.5), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	-- red cross emblem near the top of the front face
	Kit.Box(m, V(-104, 51.5, z1 - 0.5), V(-92, 62.5, z1 - 0.1), Kit.Vivid(LBLUE))
	Kit.Box(m, V(-99.3, 53, z1 - 0.8), V(-96.7, 61, z1 - 0.4), REDX)
	Kit.Box(m, V(-102, 55.7, z1 - 0.8), V(-94, 58.3, z1 - 0.4), REDX)
	Kit.AddRect(x1 - 1, z1 - 1, x2 + 1, z2 + 1)
end

--==================================================================
-- ROOMS
--==================================================================
local function lobby(f: Instance)
	-- reception desk (east front corner, outside the ghost circle)
	Kit.Box(f, V(36, FLOOR_Y, 1276), V(39, 4, 1298), WHITE, { Solid = true })
	Kit.Box(f, V(35.8, 1.5, 1276), V(36, 2.5, 1298), Kit.Vivid(LBLUE))
	Kit.Box(f, V(35.5, 4, 1275.5), V(39.5, 4.5, 1298.5), Kit.Vivid(MGREEN))
	local mon = Kit.Box(f, V(37.2, 4.5, 1285), V(37.6, 7, 1289), DARK)
	Kit.Sign(mon, Enum.NormalId.Left, "👻 ON CALL", SPECT)
	Kit.Light(mon, C(190, 255, 220), 18, 1)
	Kit.Ball(f, 0.9, V(36.2, 4.9, 1293), Kit.Vivid(C(255, 210, 80)), { Refl = 0.3 })
	chair(f, 43, 1287, -1, 0, Kit.Vivid(PURPLE))
	Props.SignBoard(f, V(48.6, 11, 1287), 14, 3, -1, 0, "RECEPTION", C(60, 110, 170), WHITE)
	Kit.AddRect(35, 1275, 46, 1299)
	-- waiting chairs (west corners)
	chairRow(f, -46, 1275, 1296, 1, Kit.Vivid(LBLUE))
	chairRow(f, -39, 1275, 1296, 1, Kit.Vivid(MGREEN))
	chairRow(f, -46, 1326, 1348, 1, Kit.Vivid(MGREEN))
	chairRow(f, -39, 1328, 1348, 1, Kit.Vivid(LBLUE))
	Props.SignBoard(f, V(-42, 11, 1271.6), 18, 3, 0, 1, "WAITING ROOM", C(60, 110, 170), WHITE)
	-- vending machine against the east wall
	Kit.Box(f, V(45, FLOOR_Y, 1336), V(48.8, 9, 1342), Kit.Vivid(PURPLE), { Solid = true })
	local front = Kit.Box(f, V(44.8, 2, 1336.6), V(45, 8.4, 1341.4), C(215, 240, 255))
	Kit.Sign(front, Enum.NormalId.Left, "BOO-\nSNACKS", Kit.Vivid(PURPLE), { Stroke = WHITE })
	Kit.AddRect(44, 1335, 49, 1343)
	plant(f, 45, 1276)
	plant(f, -30, 1349)
	-- big painted cross on the floor under the ghosts (flat) + a puddle
	Kit.Box(f, V(-5, 0.16, 1285), V(5, 0.19, 1325), C(255, 205, 210))
	Kit.Box(f, V(-20, 0.16, 1300), V(20, 0.19, 1310), C(255, 205, 210))
	puddle(f, 12, 1318, 6)
	floater(f, V(1.6, 2.2, 0.2), V(-44, 9, 1311), C(205, 170, 120), "FloatingClipboard")
	floater(f, V(1.6, 2.2, 0.2), V(42, 9, 1316), C(205, 170, 120), "FloatingClipboard")
end

local function ward(f: Instance)
	bed(f, -106, 1280, -1, 0)
	bed(f, -106, 1296, -1, 0)
	bed(f, -106, 1382, -1, 0)
	bed(f, -106, 1392, -1, 0)
	bed(f, -80, 1276.5, 0, -1)
	bed(f, -66, 1276.5, 0, -1)
	ivStand(f, -99.5, 1292)
	ivStand(f, -99.5, 1378)
	local curtain = C(200, 232, 214)
	Kit.Box(f, V(-111, FLOOR_Y, 1287.8), V(-102, 8, 1288.2), curtain, { Mat = FABRIC })
	Kit.Box(f, V(-111, FLOOR_Y, 1386.8), V(-102, 8, 1387.2), curtain, { Mat = FABRIC })
	Props.SignBoard(f, V(-53.4, 12, 1365), 14, 3, -1, 0, "WARD B", C(60, 110, 170), WHITE)
	sconce(f, V(-110.4, 12, 1340), 1, C(200, 255, 225))
	puddle(f, -88, 1348, 5)
	wheelchair(f, -60, 1388, 1, 0)
end

local function patientRooms(f: Instance)
	for _, z in { 1283, 1311, 1340 } do
		bed(f, 106, z, 1, 0)
		monitor(f, 108.5, z - 5.2, -1)
		chair(f, 96, z - 4, -1, 0, Kit.Vivid(PURPLE))
	end
	local curtain = C(225, 212, 242)
	for _, z in { 1297, 1326 } do
		Kit.Box(f, V(86, FLOOR_Y, z - 0.2), V(111, 8, z + 0.2), curtain, { Mat = FABRIC })
		Kit.AddRect(86, z - 1, 111, z + 1)
	end
	Props.SignBoard(f, V(51.4, 11, 1290), 14, 3, 1, 0, "PATIENT ROOMS", C(60, 110, 170), WHITE)
	Props.SignBoard(f, V(65, 11, 1350.6), 18, 3, 0, -1, "VISITING HOURS:\nMIDNIGHT ONLY", C(120, 80, 190), WHITE)
	medCart(f, 70, 1276)
end

local function xray(f: Instance)
	-- x-ray machine in the north-east corner
	Kit.Box(f, V(100, FLOOR_Y, 1355), V(110, 1.5, 1365), GREY, { Solid = true })
	Kit.Box(f, V(99.5, 1.5, 1356), V(105.5, 3.4, 1364), WHITE, { Solid = true })
	Kit.Box(f, V(108, 1.5, 1358), V(110, 13, 1362), WHITE, { Solid = true })
	Kit.Box(f, V(100, 10, 1359), V(108, 11.5, 1361), WHITE)
	Kit.Box(f, V(98, 7.6, 1357.5), V(102, 10, 1362.5), Kit.Vivid(LBLUE))
	Kit.AddRect(98, 1354, 111, 1366)
	-- lightbox on the north wall
	local panel = Kit.Part(f, V(16, 8, 0.4), faced(V(96, 9, 1442.6), 0, -1), C(225, 245, 255))
	Kit.Sign(panel, Enum.NormalId.Front, "X-RAY RESULTS:\n100% GHOST 👻", C(40, 80, 140), { Stroke = WHITE })
	Kit.Light(panel, C(200, 240, 255), 20, 1)
	Props.SignBoard(f, V(39.4, 11, 1418), 10, 3, -1, 0, "X-RAY", C(60, 110, 170), WHITE)
	puddle(f, 68, 1402, 6)
	floater(f, V(1.6, 2.2, 0.2), V(60, 9, 1362), C(205, 170, 120), "FloatingClipboard")
end

local function elevator(f: Instance, z: number)
	Kit.Box(f, V(-51, FLOOR_Y, z - 5), V(-50.2, 12, z + 5), C(180, 190, 205), { Mat = METAL, Solid = true })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(-50.2, FLOOR_Y, z + s * 0.1), V(-49.9, 10, z + s * 4), C(220, 225, 235), { Mat = METAL })
	end
	local disp = Kit.Box(f, V(-50.2, 10.4, z - 2), V(-49.9, 11.6, z + 2), DARK)
	Kit.Sign(disp, Enum.NormalId.Right, "▲ 13 ▼", C(255, 200, 90))
	Kit.AddRect(-52, z - 5, -48, z + 5)
end

local function atrium(f: Instance)
	elevator(f, 1362)
	elevator(f, 1386)
	Props.SignBoard(f, V(-50.4, 14, 1374), 18, 2.4, 1, 0, "ELEVATORS (GHOSTS ONLY)", C(60, 110, 170), WHITE)
	medCart(f, -20, 1380)
	medCart(f, 28, 1432)
	wheelchair(f, 20, 1368, -1, 0)
	wheelchair(f, -22, 1432, 0, 1)
	bench(f, 35, 1366, -1, 0)
	plant(f, 35, 1356)
	plant(f, -27, 1440)
	Props.SignBoard(f, V(39.4, 11, 1434), 14, 3.2, -1, 0, "QUIET PLEASE...\nBOO!", C(120, 80, 190), WHITE)
	sconce(f, V(38.4, 12, 1374), -1, C(255, 230, 170))
	-- overhead sign at the director's wing (Y 11..16, over the path, before the boss room)
	Kit.Box(f, V(-20, 14, 1443.5), V(20, 16, 1444.5), WHITE)
	local s = Kit.Part(f, V(24, 2.8, 0.4), CFrame.new(0, 12.4, 1443.3), C(60, 110, 170))
	Kit.Sign(s, Enum.NormalId.Front, "⬆ DIRECTOR'S OFFICE ⬆", WHITE)
	Props.Wisp(f, V(-10, 0, 1414), SPECT, 9, true)
	floater(f, V(1.6, 0.8, 0.8), V(4, 10, 1400), Kit.Vivid(C(255, 150, 200)), "FloatingPill", Enum.PartType.Cylinder)
end

local function lab(f: Instance)
	-- ecto tanks along the west wall
	for i, z in { 1415, 1455, 1492 } do
		Kit.Cyl(f, 1.5, 6, CFrame.new(-105, FLOOR_Y + 0.75, z), GREY, { Mat = METAL, Solid = true })
		Kit.Cyl(f, 8, 5, CFrame.new(-105, 5.9, z), C(200, 245, 225), { Transp = 0.55, Refl = 0.1 })
		local liquid = Kit.Cyl(f, 6, 4, CFrame.new(-105, 5, z), SPECT, { Mat = NEON, Transp = 0.3 })
		Kit.Cyl(f, 1, 5.6, CFrame.new(-105, 10.4, z), GREY, { Mat = METAL })
		if i == 2 then
			Kit.Light(liquid, SPECT, 24, 1.2)
			Kit.Emitter(liquid, SPECT, 2, 2, 0.6)
		end
		Kit.AddCircle(-105, z, 4)
	end
	-- lab bench with bubbling beakers
	Kit.Box(f, V(-66, 3.4, 1400), V(-40, 4, 1405.5), WHITE)
	Kit.Box(f, V(-65, FLOOR_Y, 1400.5), V(-41, 3.4, 1405), Kit.Vivid(MGREEN), { Solid = true })
	for i, col in { C(255, 150, 200), C(200, 140, 255), C(140, 230, 255) } do
		Kit.Cyl(f, 1.6, 1, CFrame.new(-60 + i * 5, 4.8, 1402.5), Kit.Vivid(col), { Transp = 0.2 })
	end
	Kit.AddRect(-67, 1399, -39, 1407)
	-- spirit coil "ghost-o-meter"
	local x, z = -60, 1515
	Kit.Cyl(f, 1, 6, CFrame.new(x, FLOOR_Y + 0.5, z), GREY, { Mat = METAL, Solid = true })
	Kit.Cyl(f, 10, 1.6, CFrame.new(x, 6, z), GREY, { Mat = METAL, Solid = true })
	for i, d in { 5, 4, 3 } do
		Kit.Cyl(f, 0.5, d, CFrame.new(x, 3 + i * 2.5, z), Kit.Vivid(PURPLE))
	end
	Kit.Ball(f, 2.2, V(x, 12, z), C(200, 150, 255), { Mat = NEON })
	Props.SignBoard(f, V(x, 3, z - 4), 7, 1.6, 0, -1, "GHOST-O-METER", DARK, SPECT)
	Kit.AddCircle(x, z, 5)
	Props.SignBoard(f, V(-100, 11, 1399.4), 14, 3, 0, 1, "PARANORMAL LAB", C(120, 80, 190), WHITE)
	puddle(f, -70, 1462, 6)
	floater(f, V(1, 1.8, 1), V(-45, 9, 1420), Kit.Vivid(C(200, 140, 255)), "FloatingBeaker", Enum.PartType.Cylinder)
end

local function office(f: Instance)
	-- director's desk (front-east corner, outside the boss circle)
	Kit.Box(f, V(16.5, FLOOR_Y, 1454.5), V(27.5, 3.6, 1461.5), C(140, 95, 65), { Mat = WOOD, Solid = true })
	Kit.Box(f, V(16, 3.6, 1454), V(28, 4.2, 1462), C(165, 115, 80), { Mat = WOOD })
	local plate = Kit.Part(f, V(4.5, 1, 0.4), faced(V(22, 4.7, 1454.5), 0, -1), DARK)
	Kit.Sign(plate, Enum.NormalId.Front, "DIRECTOR 👻", C(255, 215, 120))
	chair(f, 22, 1465, 0, -1, Kit.Vivid(PURPLE))
	Kit.AddRect(15, 1453, 29, 1467)
	-- boss ring painted on the carpet (flat)
	Kit.Disc(f, 0, 1505, 0.18, 46, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 0, 1505, 0.2, 42, 0.04, C(215, 195, 235))
	puddle(f, -6, 1500, 6)
	Props.SignBoard(f, V(-22, 10, 1532.6), 11, 6, 0, -1, "EMPLOYEE\nOF THE\nCENTURY 👻", C(120, 80, 190), C(255, 225, 130), C(255, 200, 80))
	plant(f, -27, 1449)
	plant(f, 27, 1530)
end

local function pharmacy(f: Instance)
	Kit.Box(f, V(50, FLOOR_Y, 1468), V(82, 4, 1471), WHITE, { Solid = true })
	Kit.Box(f, V(49.5, 4, 1467.5), V(82.5, 4.5, 1471.5), Kit.Vivid(MGREEN))
	Kit.AddRect(49, 1467, 83, 1472)
	local rows = { C(255, 150, 190), C(140, 220, 255), C(255, 210, 110) }
	for _, x in { 50, 70, 90 } do
		Kit.Box(f, V(x - 6, FLOOR_Y, 1529), V(x + 6, 10, 1533), WHITE, { Solid = true })
		for i, col in rows do
			local y = 1.2 + (i - 1) * 2.9
			Kit.Box(f, V(x - 5.6, y, 1528.7), V(x + 5.6, y + 1.8, 1529), Kit.Vivid(col))
		end
		Kit.AddRect(x - 7, 1527, x + 7, 1533)
	end
	Props.SignBoard(f, V(70, 13, 1532.6), 20, 3, 0, -1, "PHARMACY", C(60, 110, 170), WHITE)
	-- get-well balloons by the counter
	local top = V(80, 4.5, 1469.5)
	for i, col in { C(255, 140, 190), C(150, 205, 240), C(170, 120, 230) } do
		local p = top + V((i - 2) * 1.6, 7 + (i % 2) * 1.2, 0)
		Props.Beam(f, top, p - V(0, 1.3, 0), 0.1, 0.1, WHITE)
		Kit.Ball(f, 2.6, p, Kit.Vivid(col))
	end
	wheelchair(f, 100, 1480, -1, 0)
	Props.SignBoard(f, V(60, 11, 1445.4), 14, 3, 0, 1, "GET WELL BOO-N!", C(255, 140, 190), WHITE)
end

local function grounds(f: Instance)
	-- back yard
	bench(f, -42, 1546, 0, -1)
	bench(f, 42, 1546, 0, -1)
	-- trees in the garden strips and corners
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 10 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(60, 131)
		local z = rng:NextNumber(1226, 1555)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

function Hospital.Build(map: Instance)
	local f = Kit.Folder(map, "Hospital")
	ground(f)
	sideWalls(f)
	outside(f)
	courtyard(f)
	entrance(f)
	shell(f)
	tower(f)
	lobby(f)
	ward(f)
	patientRooms(f)
	xray(f)
	atrium(f)
	lab(f)
	office(f)
	pharmacy(f)
	grounds(f)
end

return Hospital
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Inferno</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 15: Inferno Caverns (Z 4840..5200). A cosy-hot volcanic cavern: dark basalt, warm glow.
--   Ground: basalt slab + slate lane along X = 0 with ember-orange edging.
--   Ghost areas get flat scorched rings ((0,4925) r30, (-82,4960) r24, (75,5020) r26,
--   (-62,5080) r24); the boss area (0,5145) r26 is an obsidian disc with ember runes.
--   Lava (flat neon, a few big pieces, all outside the lane and the ghost areas): a river at
--   Z 4988..4998 from the west wall to a pool at (36, 4993), crossed by a solid glass bridge on
--   the lane; pools in the front corners; cracks in the west back corner.
--   Rock arches over the lane at Z 4970 and Z 5100 (span bottom Y 32).
--   Landmark seen from the Clockwork Tower: the volcano at (98, 5152), crater ~Y 108.
--   Crystal clusters, obsidian spikes, cute fire-salamander statues, braziers, cliffs outside.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Inferno = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local BASALT = Enum.Material.Basalt
local SLATE = Enum.Material.Slate
local METAL = Enum.Material.Metal
local ROCK = Enum.Material.Rock

local Z0, Z1 = 4840, 5200
local RIVER_Z1, RIVER_Z2 = Z0 + 148, Z0 + 158

local GROUND = C(58, 48, 52)
local ROCKC = C(78, 60, 58)
local ROCK_D = C(48, 40, 44)
local ROCK_R = C(105, 55, 45)
local LAVA = C(255, 120, 35)
local LAVA_Y = C(255, 175, 60)
local EMBER = C(255, 150, 60)
local GOLD = C(255, 200, 80)
local DEEP_RED = C(150, 45, 40)
local OBSIDIAN = C(35, 28, 45)
local SAL = C(255, 110, 60)
local SAL_SPOT = C(255, 215, 80)

local SOLID_ROCK: Kit.Opts = { Mat = BASALT, Solid = true, Shadow = true }
local LAVA_O: Kit.Opts = { Mat = NEON }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
local function crack(parent: Instance, p: Vector3, segs: number, w: number)
	local rng = Kit.Rng
	local a = rng:NextNumber(0, math.pi * 2)
	for _ = 1, segs do
		a += rng:NextNumber(-0.8, 0.8)
		local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(4, 7)
		Props.Beam(parent, p, q, w, 0.06, LAVA, LAVA_O)
		p = q
	end
end

-- Flat lava pool: dark rim discs under glowing discs (tops below Y 0.1).
local function pool(parent: Instance, pieces: { { number } }, light: boolean)
	for i, d in pieces do
		Kit.Disc(parent, d[1], d[2], 0.04, d[3] + 5, 0.04, ROCK_D, { Mat = SLATE })
		local p = Kit.Disc(parent, d[1], d[2], 0.06 + i * 0.005, d[3], 0.05, if i == 1 then LAVA else LAVA_Y, LAVA_O)
		if light and i == 1 then
			Kit.Light(p, EMBER, 40, 1.8)
		end
	end
end

local function crystals(parent: Instance, x: number, z: number, color: Color3, glow: boolean, light: boolean)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "Crystals")
	for i = 1, 4 do
		local h = rng:NextNumber(4, 9) * (if i == 1 then 1.3 else 1)
		local w = rng:NextNumber(1.4, 2.4)
		local p = V(x + rng:NextNumber(-2, 2), h / 2 - 0.5, z + rng:NextNumber(-2, 2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 1.5), rng:NextNumber(-0.35, 0.35)) * CFrame.Angles(0, math.pi / 4, 0)
		local opts: Kit.Opts = if glow and i == 1 then { Mat = NEON } else { Refl = 0.25, Transp = 0.1 }
		local c = Kit.Part(m, V(w, h, w), cf, if i % 2 == 0 then Kit.Vivid(color) else color:Lerp(Color3.new(1, 1, 1), 0.2), opts)
		if light and i == 1 then
			Kit.Light(c, color, 26, 1.4)
		end
	end
	Kit.Ball(m, 4, V(x, -0.8, z), ROCK_D, { Mat = BASALT })
	Kit.AddCircle(x, z, 4)
end

local function spikes(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "ObsidianSpikes")
	for i = 1, 3 do
		local h = rng:NextNumber(8, 18) * (if i == 1 then 1.2 else 0.8)
		local w = rng:NextNumber(2.4, 3.6)
		local p = V(x + rng:NextNumber(-2.5, 2.5), h / 2 - 1, z + rng:NextNumber(-2.5, 2.5))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 1.5), rng:NextNumber(-0.25, 0.25))
		Kit.Part(m, V(w, h, w * 0.7), cf, OBSIDIAN, { Refl = 0.3, Solid = i == 1, Shadow = true })
		Kit.Wedge(m, V(w, w * 1.2, w * 0.7), cf * CFrame.new(0, h / 2 + w * 0.6, 0) * CFrame.Angles(0, math.pi / 2, 0), OBSIDIAN, { Refl = 0.3 })
	end
	Kit.AddCircle(x, z, 4.5)
end

-- Cute fire salamander statue facing (fx, fz); s = scale.
local function salamander(parent: Instance, x: number, z: number, s: number, fx: number, fz: number)
	local m = Kit.Model(parent, "SalamanderStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local ph = 2.5 * math.min(s, 1.6)
	local body = Kit.Vivid(SAL)
	Kit.Part(m, V(6 * s, ph, 9 * s), base * CFrame.new(0, ph / 2, 0.8 * s), ROCK_R, { Mat = SLATE, Solid = true, Shadow = true })
	Kit.Part(m, V(6.4 * s, 0.5, 9.4 * s), base * CFrame.new(0, ph, 0.8 * s), Kit.Vivid(GOLD), { Mat = METAL })
	local y = ph + 0.25
	Kit.Ball(m, 3.6 * s, (base * CFrame.new(0, y + 1.6 * s, 0.4 * s)).Position, body, { Shadow = true })
	Kit.Ball(m, 3.2 * s, (base * CFrame.new(0, y + 1.5 * s, 2.6 * s)).Position, body)
	Kit.Ball(m, 3.8 * s, (base * CFrame.new(0, y + 2.8 * s, -2 * s)).Position, body, { Shadow = true })
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 1.4 * s, (base * CFrame.new(sx * 0.85 * s, y + 3.7 * s, -3.4 * s)).Position, C(255, 255, 250))
		Kit.Ball(m, 0.75 * s, (base * CFrame.new(sx * 0.85 * s, y + 3.75 * s, -3.95 * s)).Position, C(30, 20, 30))
		Kit.Ball(m, 0.8 * s, (base * CFrame.new(sx * 1.4 * s, y + 2.6 * s, -3.4 * s)).Position, C(255, 150, 170))
		for _, lz in { -0.6, 2.8 } do
			Kit.Part(m, V(1 * s, 1.4 * s, 1 * s), base * CFrame.new(sx * 1.5 * s, y + 0.7 * s, lz * s), body)
		end
	end
	-- curly tail with an ember tip
	local t0 = (base * CFrame.new(0, y + 1.3 * s, 4 * s)).Position
	local t1 = (base * CFrame.new(1.6 * s, y + 0.8 * s, 6.4 * s)).Position
	Props.Beam(m, t0, t1, 1.3 * s, 1.3 * s, body)
	Kit.Ball(m, 1.6 * s, t1 + V(0, 0.5 * s, 0), LAVA_Y, if s > 1.5 then LAVA_O else nil)
	for i = 0, 2 do
		Kit.Ball(m, 0.9 * s, (base * CFrame.new((i - 1) * 0.7 * s, y + 3.3 * s, (0.2 + i * 1.1) * s)).Position, Kit.Vivid(SAL_SPOT))
	end
	Kit.AddCircle(x, z, 5.5 * s)
end

local function brazier(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "Brazier")
	Kit.Cyl(m, 4, 2.4, CFrame.new(x, 2, z), ROCKC, SOLID_ROCK)
	Kit.Cyl(m, 1.6, 4.4, CFrame.new(x, 4.8, z), C(60, 50, 55), { Mat = METAL })
	Kit.Cyl(m, 0.4, 4.6, CFrame.new(x, 5.4, z), Kit.Vivid(GOLD), { Mat = METAL })
	local flame = Kit.Ball(m, 2.6, V(x, 6, z), EMBER, { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(flame, EMBER, 26, 1.6, true)
	end
	Kit.AddCircle(x, z, 3)
end

--==================================================================
-- GROUND, LAVA, WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), GROUND, { Mat = BASALT, Solid = true, Name = "Ground_Inferno" })
	-- slate lane with ember edging, interrupted by the glass bridge over the lava river
	local edge = Kit.Vivid(C(220, 120, 60))
	for _, seg in { { Z0, RIVER_Z1 - 2 }, { RIVER_Z2 + 2, Z1 } } do
		Kit.Box(f, V(-9, 0, seg[1]), V(9, 0.05, seg[2]), C(105, 80, 72), { Mat = SLATE, Solid = true, Name = "Path" })
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 9, 0, seg[1]), V(s * 10, 0.08, seg[2]), edge, { Mat = SLATE })
		end
	end
	-- scorched rings on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, if i % 2 == 0 then DEEP_RED else ROCK_R, { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, C(82, 66, 66), { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.13, 8, 0.13, Kit.Vivid(GOLD), { Mat = METAL })
		crack(f, V(a[1] + 9, 0.15, a[2] - 6), 1, 0.5)
	end
	-- boss: obsidian disc, gold ring, ember runes
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, OBSIDIAN, { Mat = SLATE, Refl = 0.15 })
	for i = 0, 3 do
		local a1 = i * math.pi / 2 + 0.2
		local a2 = a1 + math.pi / 2 - 0.4
		Props.Beam(f, V(math.cos(a1) * 20, 0.14, BOSS_Z + math.sin(a1) * 20), V(math.cos(a2) * 20, 0.14, BOSS_Z + math.sin(a2) * 20), 0.7, 0.05, LAVA, LAVA_O)
	end
	Kit.Disc(f, 0, BOSS_Z, 0.17, 6, 0.06, EMBER, LAVA_O)
end

local function lava(f: Instance)
	local m = Kit.Model(f, "Lava")
	-- river from the west wall to a pool east of the lane
	local river = Kit.Box(m, V(-136, 0, RIVER_Z1), V(30, 0.06, RIVER_Z2), LAVA, { Mat = NEON, Name = "LavaRiver" })
	Kit.Light(river, EMBER, 30, 1.2) -- centre of the river (by the glass bridge)
	for _, zz in { RIVER_Z1 - 1.2, RIVER_Z2 } do
		Kit.Box(m, V(-136, 0, zz), V(-12.5, 0.12, zz + 1.2), ROCK_D, { Mat = BASALT })
		Kit.Box(m, V(12.5, 0, zz), V(30, 0.12, zz + 1.2), ROCK_D, { Mat = BASALT })
	end
	pool(m, { { 36, (RIVER_Z1 + RIVER_Z2) / 2, 18 } }, false)
	-- glass bridge on the lane (solid, top Y 0.25)
	Kit.Box(m, V(-12, 0, RIVER_Z1 - 2), V(12, 0.25, RIVER_Z2 + 2), C(255, 200, 160), { Mat = Enum.Material.Glass, Transp = 0.45, Refl = 0.1, Solid = true, Name = "GlassBridge" })
	local gold = Kit.Vivid(GOLD)
	for _, s in { -1, 1 } do
		for _, zz in { RIVER_Z1 - 2, RIVER_Z2 + 2 } do
			Kit.Box(m, V(s * 12.6 - 0.4, 0, zz - 0.4), V(s * 12.6 + 0.4, 2.6, zz + 0.4), gold, { Mat = METAL })
			Kit.Ball(m, 1.2, V(s * 12.6, 3, zz), gold, { Mat = METAL })
		end
		Kit.Box(m, V(s * 12.6 - 0.2, 2, RIVER_Z1 - 2), V(s * 12.6 + 0.2, 2.4, RIVER_Z2 + 2), gold, { Mat = METAL })
	end
	-- corner pools
	pool(m, { { -102, Z0 + 52, 34 }, { -122, Z0 + 70, 20 }, { -80, Z0 + 44, 14 } }, true)
	local embers = Kit.Part(m, V(24, 0.4, 24), CFrame.new(-104, 1, Z0 + 56), EMBER, { Transp = 1, Name = "EmberSource" })
	local e = Kit.Emitter(embers, C(255, 170, 70), 3, 0.8, 2)
	if e then
		e.LightEmission = 1
		e.Acceleration = V(0, 3, 0)
	end
	pool(m, { { 112, Z0 + 58, 30 }, { 126, Z0 + 84, 16 } }, true)
	-- cracks in the west back corner
	crack(m, V(-112, 0.1, Z0 + 330), 3, 2.2)
	Props.SignBoard(m, V(-70, 4, Z0 + 76), 10, 3, 1, -1, "HOT! DO NOT LICK", C(60, 30, 30), Kit.Vivid(LAVA_Y), GOLD)
	Kit.Box(m, V(-70.4, 0, Z0 + 76.4), V(-69.6, 2.5, Z0 + 77.2), ROCKC, { Mat = BASALT })
	Kit.AddCircle(-70, Z0 + 76, 6)
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 34, z1), ROCKC, SOLID_ROCK)
		Kit.Box(f, V(s * 139.7, 0, z0), V(s * 140, 3, z1), ROCK_R, { Mat = SLATE })
		for z = z0 + 10, z1 - 10, 32 do
			local w = rng:NextNumber(8, 14)
			local cf = CFrame.new(s * 143, 34 + rng:NextNumber(1, 4), z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 1), rng:NextNumber(-0.3, 0.3))
			Kit.Part(f, V(w, rng:NextNumber(6, 12), w), cf, Kit.Pick({ ROCKC, ROCK_D, ROCK_R }), { Mat = BASALT })
		end
		-- glowing magma veins on the inner face
		local x = s * 139.75
		local zv = if s < 0 then Z0 + 210 else Z0 + 120
		Props.Beam(f, V(x, 1, zv), V(x, 12, zv + 6), 0.6, 0.6, LAVA, LAVA_O)
		Props.Beam(f, V(x, 12, zv + 6), V(x, 22, zv + 1), 0.5, 0.5, LAVA, LAVA_O)
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local cols = { ROCKC, ROCK_D, C(70, 50, 50) }
	for _, s in { -1, 1 } do
		for i = 0, 7 do
			local z = Z0 + 14 + i * 46
			local w = rng:NextNumber(26, 44)
			local h = rng:NextNumber(46, 74)
			local cf = CFrame.new(s * (149 + w / 2), h / 2 - 3, z) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), s * rng:NextNumber(0.02, 0.1))
			Kit.Part(f, V(w, h, rng:NextNumber(38, 52)), cf, Kit.Pick(cols), { Mat = ROCK })
			if i % 2 == 0 then
				Kit.Ball(f, rng:NextNumber(40, 60), V(s * rng:NextNumber(185, 205), rng:NextNumber(4, 18), z + 20), Kit.Pick(cols), { Mat = BASALT })
			end
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function rockArch(f: Instance, z: number, title: string?)
	local m = Kit.Model(f, "RockArch")
	local rng = Kit.Rng
	for _, s in { -1, 1 } do
		local y = 0
		for i = 1, 3 do
			local h = if i == 3 then 36 - y else rng:NextNumber(10, 14)
			local w = 10 - i * 0.8
			local cf = CFrame.new(s * 23, y + h / 2, z) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0)
			Kit.Part(m, V(w, h, 8 - i * 0.6), cf, if i % 2 == 0 then ROCK_D else ROCKC, SOLID_ROCK)
			y += h
		end
		local c = Kit.Part(m, V(1.6, 4, 1.6), CFrame.new(s * 18.6, 14, z - 3) * CFrame.Angles(0.3, 0.6, s * 0.4), Kit.Vivid(C(255, 120, 200)), if s < 0 then LAVA_O else { Refl = 0.25 })
		c.Name = "ArchCrystal"
		Kit.AddRect(s * 17, z - 5, s * 29, z + 5)
	end
	-- span (bottom Y 32) and rough top boulders
	Kit.Box(m, V(-28, 32, z - 4), V(28, 40, z + 4), ROCKC, SOLID_ROCK)
	Kit.Part(m, V(20, 8, 9), CFrame.new(-10, 42, z) * CFrame.Angles(0, 0.1, 0.12), ROCK_D, { Mat = BASALT })
	Kit.Part(m, V(18, 7, 8), CFrame.new(12, 42, z) * CFrame.Angles(0, -0.12, -0.1), ROCK_R, { Mat = BASALT })
	if title then
		Props.SignBoard(m, V(0, 35.8, z - 4.4), 30, 4, 0, -1, title, C(50, 25, 25), Kit.Vivid(LAVA_Y), GOLD)
	end
end

local function volcano(f: Instance)
	local m = Kit.Model(f, "Volcano")
	local x, z = 98, Z0 + 312
	local ds = { 76, 64, 52, 42, 32, 24 }
	local H = 18
	for i, d in ds do
		local t = (i - 1) / (#ds - 1)
		Kit.Cyl(m, H, d, CFrame.new(x, H * (i - 0.5), z), ROCK_D:Lerp(ROCK_R, t * 0.8), { Mat = BASALT, Solid = i <= 2, Shadow = true })
	end
	local top = H * #ds
	local crater = Kit.Disc(m, x, z, top + 0.15, 16, 0.3, LAVA, LAVA_O)
	Kit.Light(crater, EMBER, 60, 2)
	for i = 0, 2 do
		local a = i * 2.1 + 0.4
		Kit.Part(m, V(7, 5, 6), CFrame.new(x + math.cos(a) * 10, top + 1.5, z + math.sin(a) * 10) * CFrame.Angles(0.2, a, -0.15), ROCK_D, { Mat = BASALT })
	end
	-- two lava streams down the tiers (toward the lane and toward the approach)
	for _, ang in { math.pi, -math.pi / 2 - 0.35 } do
		local dir = V(math.cos(ang), 0, math.sin(ang))
		local function pt(r: number, y: number): Vector3
			return V(x, y, z) + dir * r
		end
		local pts = { pt(12.6, top), pt(21.6, H * 4), pt(32.6, H * 2), pt(38.6, H), pt(39.6, 0.2) }
		for i = 1, #pts - 1 do
			Props.Beam(m, pts[i], pts[i + 1], 3, 1, if i % 2 == 0 then LAVA_Y else LAVA, LAVA_O)
		end
	end
	local smoke = Kit.Part(m, V(12, 1, 12), CFrame.new(x, top + 3, z), C(90, 80, 80), { Transp = 1, Name = "SmokeSource" })
	local e = Kit.Emitter(smoke, C(110, 95, 95), 2, 14, 4)
	if e then
		e.Acceleration = V(0, 3, 0)
	end
	Kit.AddCircle(x, z, 40)
end

local function floaters(f: Instance)
	for _, p in { V(-36, 24, Z0 + 150), V(40, 28, Z0 + 110), V(-112, 26, Z0 + 180), V(118, 30, Z0 + 230), V(-30, 22, Z0 + 340) } do
		local r = Kit.Ball(f, Kit.Rng:NextNumber(2.4, 3.6), p, Kit.Vivid(C(200, 90, 50)), { Mat = BASALT, Name = "FloatingEmberRock" })
		Kit.Float(r, 1.6)
	end
end

local function decor(f: Instance)
	local rng = Kit.Rng
	-- salamander statues welcoming hunters and one big one in the back corner
	for _, p in { { -18, Z0 + 52 }, { 18, Z0 + 52 }, { 20, Z0 + 205 }, { -20, Z0 + 200 }, { -40, Z0 + 330 } } do
		if Kit.IsFree(p[1], p[2], 5.5) then
			salamander(f, p[1], p[2], 1, if p[1] < 0 then 1 else -1, 0)
		end
	end
	if Kit.IsFree(-100, Z0 + 322, 12) then
		salamander(f, -100, Z0 + 322, 2.2, 1, -1)
	end
	for i, p in { { -14, Z0 + 232 }, { 14, Z0 + 232 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			brazier(f, p[1], p[2], i == 1)
		end
	end
	-- basalt column clusters (hexagonal causeway look) and rock buttresses on the walls
	for _, p in { { -118, Z0 + 120 }, { 120, Z0 + 140 }, { -40, Z0 + 290 }, { 124, Z0 + 250 }, { -126, Z0 + 230 } } do
		if Kit.IsFree(p[1], p[2], 7) then
			for i = 0, 5 do
				local a = i * math.pi / 3
				local r = if i == 0 then 0 else 3.6
				local h = rng:NextNumber(3, 12) + (if i == 0 then 6 else 0)
				local cx, cz = p[1] + math.cos(a) * r, p[2] + math.sin(a) * r
				Kit.Cyl(f, h, 3.8, CFrame.new(cx, h / 2, cz), Kit.Pick({ ROCKC, ROCK_D, C(68, 56, 60) }), { Mat = BASALT, Solid = i == 0, Shadow = true })
			end
			Kit.AddCircle(p[1], p[2], 7)
		end
	end
	for _, s in { -1, 1 } do
		for z = Z0 + 30, Z1 - 30, 50 do
			if Kit.IsFree(s * 134, z, 2) then
				local w = rng:NextNumber(5, 8)
				Kit.Part(f, V(w, rng:NextNumber(30, 40), w * 1.4), CFrame.new(s * (140 - w / 2 + 1), 15, z) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), s * 0.06), Kit.Pick({ ROCKC, ROCK_D }), SOLID_ROCK)
			end
		end
	end
	-- stalagmites
	local nst = 0
	for _ = 1, 300 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 10)
		if nst < 12 and Kit.IsFree(x, z, 3.5) then
			nst += 1
			local h = rng:NextNumber(6, 14)
			local col = Kit.Pick({ ROCKC, ROCK_R, C(92, 70, 64) })
			Kit.Cyl(f, h * 0.45, 4.4, CFrame.new(x, h * 0.225, z), col, { Mat = BASALT, Solid = true, Shadow = true })
			Kit.Cyl(f, h * 0.35, 3, CFrame.new(x, h * 0.45 + h * 0.175, z), col, { Mat = BASALT })
			Kit.Cyl(f, h * 0.25, 1.6, CFrame.new(x, h * 0.8 + h * 0.125, z), col:Lerp(Color3.new(1, 0.6, 0.3), 0.15), { Mat = BASALT })
			if nst % 3 == 0 then
				local x2, z2 = x + 3, z + 2
				Kit.Cyl(f, h * 0.5, 2.4, CFrame.new(x2, h * 0.25, z2), col, { Mat = BASALT })
			end
			Kit.AddCircle(x, z, 3.5)
		end
	end
	-- crystals and obsidian spikes
	local cols = { C(255, 90, 170), C(255, 170, 60), C(255, 220, 100), C(200, 100, 255) }
	local nc, ns, nb = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 10)
		if nc < 10 and Kit.IsFree(x, z, 4) then
			nc += 1
			crystals(f, x, z, cols[(nc - 1) % #cols + 1], nc <= 3, nc == 1)
		elseif ns < 11 and Kit.IsFree(x, z, 4.5) then
			ns += 1
			spikes(f, x, z)
		elseif nb < 10 and Kit.IsFree(x, z, 3.5) then
			nb += 1
			Kit.Ball(f, rng:NextNumber(4, 7), V(x, -0.6, z), Kit.Pick({ ROCKC, ROCK_D, ROCK_R }), { Mat = BASALT, Solid = true })
			Kit.AddCircle(x, z, 3.5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Inferno.Build(map: Instance)
	local f = Kit.Folder(map, "Inferno")
	ground(f)
	lava(f)
	sideWalls(f)
	outside(f)
	rockArch(f, Z0 + 130, "INFERNO CAVERNS")
	rockArch(f, Z0 + 260, nil)
	volcano(f)
	floaters(f)
	decor(f)
end

return Inferno
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Part helpers for the procedural map. Every builder goes through these so that parts
-- get the same performance defaults (anchored, non-colliding, no touch/query, no shadow)
-- unless `Solid = true` is passed for floors, walls and buildings.
-- Also holds the seeded RNG, budgets (lights, emitters, tagged props) and a keep-out
-- registry so scattered props never land inside ghost areas, roads or stations.
--
-- Neon is an accent, not a surface: keep it for small things whose glow means something
-- (windows, lamp globes, lanterns, jack-o'-lantern faces at landmarks, eyes, small ectoplasm
-- cracks/puddles). Trims, bands, rings, frames and pads use a solid material with a
-- Kit.Vivid colour instead. Kit.Stats.Neon counts the Neon parts so the build log shows it.

local CollectionService = game:GetService("CollectionService")

local Kit = {}

export type Opts = {
	Name: string?,
	Mat: Enum.Material?,
	Transp: number?,
	Solid: boolean?, -- CanCollide + CanQuery (+ shadow)
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Refl: number?,
}

Kit.Rng = Random.new(42)

Kit.Stats = { Parts = 0, Neon = 0, Lights = 0, Emitters = 0, Floating = 0, Flicker = 0 }
-- Budgets for the whole 16-zone map (per zone ~9 lights, 2-3 emitters, 6-8 floating, 2 flicker).
local MAX_LIGHTS = 170
local MAX_EMITTERS = 54
local MAX_FLOATING = 140
local MAX_FLICKER = 34

local NO_OPTS: Opts = {}

local function apply(p: BasePart, size: Vector3, cf: CFrame, color: Color3, opts: Opts?)
	local o: Opts = opts or NO_OPTS
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.Mat or Enum.Material.SmoothPlastic
	p.Transparency = o.Transp or 0
	p.Reflectance = o.Refl or 0
	local solid = o.Solid == true
	p.CanCollide = solid
	p.CanQuery = solid
	p.CanTouch = false
	if o.Shadow ~= nil then
		p.CastShadow = o.Shadow
	else
		p.CastShadow = solid
	end
	if o.Name then
		p.Name = o.Name
	end
	Kit.Stats.Parts += 1
	if p.Material == Enum.Material.Neon then
		Kit.Stats.Neon += 1
	end
end

-- A slightly more saturated, brighter version of a colour. Solid materials are lit by the
-- scene instead of glowing, so former neon trims get this to stay candy-bright.
-- Near-greys/whites keep their saturation (no accidental tint).
function Kit.Vivid(c: Color3): Color3
	local h, s, v = c:ToHSV()
	local s2 = if s < 0.1 then s else math.min(1, s * 1.15 + 0.05)
	return Color3.fromHSV(h, s2, math.min(1, v * 1.06 + 0.03))
end

-- Block (or Ball/Cylinder via opts.Shape) at an arbitrary CFrame.
function Kit.Part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	apply(p, size, cf, color, opts)
	p.Parent = parent
	return p
end

-- Axis-aligned block from two corners.
function Kit.Box(parent: Instance, a: Vector3, b: Vector3, color: Color3, opts: Opts?): Part
	local lo = a:Min(b)
	local hi = a:Max(b)
	return Kit.Part(parent, hi - lo, CFrame.new((lo + hi) / 2), color, opts)
end

-- WedgePart: the slope faces local -Z (low edge at -Z, tall face at +Z).
function Kit.Wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): WedgePart
	local w: WedgePart = Instance.new("WedgePart")
	apply(w, size, cf, color, opts)
	w.Parent = parent
	return w
end

function Kit.Ball(parent: Instance, d: number, pos: Vector3, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	apply(p, Vector3.new(d, d, d), CFrame.new(pos), color, opts)
	p.Parent = parent
	return p
end

-- Vertical cylinder centred at cf.
function Kit.Cyl(parent: Instance, height: number, d: number, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	apply(p, Vector3.new(height, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, opts)
	p.Parent = parent
	return p
end

-- Flat vertical cylinder whose TOP surface is at topY.
function Kit.Disc(parent: Instance, x: number, z: number, topY: number, d: number, thick: number, color: Color3, opts: Opts?): Part
	return Kit.Cyl(parent, thick, d, CFrame.new(x, topY - thick / 2, z), color, opts)
end

-- Cylinder lying along the world axis given by `along` ("X" or "Z").
function Kit.CylFlat(parent: Instance, length: number, d: number, pos: Vector3, along: string, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	local cf = CFrame.new(pos)
	if along == "Z" then
		cf *= CFrame.Angles(0, math.pi / 2, 0)
	end
	apply(p, Vector3.new(length, d, d), cf, color, opts)
	p.Parent = parent
	return p
end

function Kit.Folder(parent: Instance, name: string): Folder
	local f: Folder = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.Model(parent: Instance, name: string): Model
	local m: Model = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Yaw (radians) that turns a part's local -Z (its Front face) toward world (dx, dz).
function Kit.FaceYaw(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

function Kit.Comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	while true do
		local replaced, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if k == 0 then
			break
		end
	end
	return out
end

--==================================================================
-- GUI
--==================================================================
function Kit.Gui(part: BasePart, face: Enum.NormalId, pps: number?): SurfaceGui
	local g: SurfaceGui = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	-- 30 px per stud: sharp up close, and far less shimmer when a sign is seen from a distance
	-- or while the camera moves (a 40 px texture squeezed into a few screen pixels sparkles,
	-- most on phones). Brightness just above 1 keeps the colours bright without the text
	-- glowing into the bloom.
	g.PixelsPerStud = pps or 30
	g.LightInfluence = 0
	g.Brightness = 1.1
	g.ZOffset = 1
	g.ResetOnSpawn = false
	g.Parent = part
	return g
end

export type LabelOpts = {
	Name: string?,
	Pos: UDim2?,
	Size: UDim2?,
	Font: Enum.Font?,
	Stroke: Color3?,
	Rotation: number?,
}

local NO_LABEL: LabelOpts = {}

function Kit.Label(gui: GuiBase2d, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local o: LabelOpts = opts or NO_LABEL
	local t: TextLabel = Instance.new("TextLabel")
	t.Name = o.Name or "Label"
	t.BackgroundTransparency = 1
	t.Position = o.Pos or UDim2.fromScale(0, 0)
	t.Size = o.Size or UDim2.fromScale(1, 1)
	t.Font = o.Font or Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Rotation = o.Rotation or 0
	local stroke: UIStroke = Instance.new("UIStroke")
	stroke.Color = o.Stroke or Color3.fromRGB(40, 20, 70)
	stroke.Thickness = 3
	stroke.Parent = t
	t.Parent = gui
	return t
end

-- Whole-face sign on a part.
function Kit.Sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local g = Kit.Gui(part, face)
	return Kit.Label(g, text, color, opts)
end

--==================================================================
-- EFFECTS (budgeted)
--==================================================================
function Kit.Light(part: BasePart, color: Color3, range: number, brightness: number, flicker: boolean?): PointLight?
	if Kit.Stats.Lights >= MAX_LIGHTS then
		return nil
	end
	Kit.Stats.Lights += 1
	local l: PointLight = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
	if flicker and Kit.Stats.Flicker < MAX_FLICKER then
		Kit.Stats.Flicker += 1
		CollectionService:AddTag(part, "FlickerLight")
	end
	return l
end

function Kit.Emitter(part: BasePart, color: Color3, rate: number, size: number?, speed: number?): ParticleEmitter?
	if Kit.Stats.Emitters >= MAX_EMITTERS then
		return nil
	end
	Kit.Stats.Emitters += 1
	local e: ParticleEmitter = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(4, 7)
	e.Speed = NumberRange.new(speed or 0.6, (speed or 0.6) * 2)
	e.SpreadAngle = Vector2.new(180, 15)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-15, 15)
	local s = size or 6
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s * 0.5),
		NumberSequenceKeypoint.new(0.5, s),
		NumberSequenceKeypoint.new(1, s * 1.2),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.75),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Acceleration = Vector3.new(0, 0.15, 0)
	e.Parent = part
	return e
end

-- Tag a single anchored part as a client-animated floating prop.
function Kit.Float(part: BasePart, bob: number): boolean
	if Kit.Stats.Floating >= MAX_FLOATING then
		return false
	end
	Kit.Stats.Floating += 1
	part:SetAttribute("BobHeight", bob)
	CollectionService:AddTag(part, "FloatingProp")
	return true
end

--==================================================================
-- KEEP-OUT REGISTRY (2D, X/Z)
--==================================================================
type Circle = { X: number, Z: number, R: number }
type Rect = { X1: number, Z1: number, X2: number, Z2: number, Road: boolean }

local circles: { Circle } = {}
local rects: { Rect } = {}

function Kit.ResetKeepOut()
	table.clear(circles)
	table.clear(rects)
end

-- Fresh RNG, budgets and keep-out map (so rebuilding gives the identical map).
function Kit.Reset()
	Kit.Rng = Random.new(42)
	Kit.Stats.Parts = 0
	Kit.Stats.Neon = 0
	Kit.Stats.Lights = 0
	Kit.Stats.Emitters = 0
	Kit.Stats.Floating = 0
	Kit.Stats.Flicker = 0
	Kit.ResetKeepOut()
end

function Kit.AddCircle(x: number, z: number, r: number)
	table.insert(circles, { X = x, Z = z, R = r })
end

function Kit.AddRect(x1: number, z1: number, x2: number, z2: number, road: boolean?)
	table.insert(rects, {
		X1 = math.min(x1, x2),
		Z1 = math.min(z1, z2),
		X2 = math.max(x1, x2),
		Z2 = math.max(z1, z2),
		Road = road == true,
	})
end

-- True when a circle of radius r at (x, z) touches no keep-out and stays inside the play area.
function Kit.IsFree(x: number, z: number, r: number, ignoreRoads: boolean?): boolean
	if math.abs(x) + r > 136 then
		return false
	end
	for _, c in circles do
		local dx, dz = x - c.X, z - c.Z
		if dx * dx + dz * dz < (c.R + r) * (c.R + r) then
			return false
		end
	end
	for _, q in rects do
		if not (ignoreRoads and q.Road) then
			if x + r > q.X1 and x - r < q.X2 and z + r > q.Z1 and z - r < q.Z2 then
				return false
			end
		end
	end
	return true
end

export type GateLayout = { Z: number, Width: number }

-- Typed views of Config.Layout tables (iterating a table literal yields unknown in strict mode).
function Kit.Gates(layout: any): { [string]: GateLayout }
	return layout.Gates
end

function Kit.CrateStations(layout: any): { [string]: Vector3 }
	return layout.CrateStations
end

function Kit.ZoneSpawns(layout: any): { [string]: Vector3 }
	return layout.ZoneSpawns
end

function Kit.Pick<T>(list: { T }): T
	return list[Kit.Rng:NextInteger(1, #list)]
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- TOP GHOST HUNTERS board beside the spawn plaza (Config.Layout.Leaderboard). The board is a
-- SurfaceGui with a title and Config.Leaderboard.Rows rows ("Row1".."RowN", each with Rank / Name
-- / Value labels); LeaderboardService fills them in.
local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)

local Leaderboard = {}

local C = Color3.fromRGB
local V = Vector3.new

function Leaderboard.Build(map: Instance)
	local L = Config.Layout.Leaderboard
	local m = Kit.Model(Kit.Folder(map, "Leaderboard"), "TopHunters")
	local base = CFrame.new(L.Position) * CFrame.Angles(0, L.Yaw, 0)
	local W, H, BOTTOM = 18, 20, 3
	local wood = C(120, 80, 55)
	-- posts + feet
	for _, s in { -1, 1 } do
		Kit.Part(m, V(1.4, BOTTOM + H + 1, 1.4), base * CFrame.new(s * (W / 2 + 0.7), (BOTTOM + H + 1) / 2, 0.4), wood, { Mat = Enum.Material.Wood, Solid = true })
		Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(s * (W / 2 + 0.7), 0.3, 0.4), C(90, 70, 110), { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(m, 2, (base * CFrame.new(s * (W / 2 + 0.7), BOTTOM + H + 2, 0.4)).Position, Kit.Vivid(C(255, 200, 60)))
	end
	-- frame + board face (front = local -Z)
	Kit.Part(m, V(W + 1.2, H + 1.2, 0.8), base * CFrame.new(0, BOTTOM + H / 2, 0.6), Kit.Vivid(C(150, 90, 230)), { Solid = true })
	local board = Kit.Part(m, V(W, H, 0.6), base * CFrame.new(0, BOTTOM + H / 2, 0.2), C(35, 22, 60), { Solid = true, Name = "Board" })
	-- topper: crown shape
	Kit.Part(m, V(8, 2.4, 0.8), base * CFrame.new(0, BOTTOM + H + 1.6, 0.6), Kit.Vivid(C(255, 200, 60)), { Mat = Enum.Material.Metal })
	for i = -1, 1 do
		Kit.Wedge(m, V(0.8, 2, 2), base * CFrame.new(i * 3, BOTTOM + H + 3.8, 0.6) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(C(255, 200, 60)), { Mat = Enum.Material.Metal })
	end

	local gui = Kit.Gui(board, Enum.NormalId.Front, 30)
	gui.Name = "BoardGui"
	local rows = Config.Leaderboard.Rows
	local titleH = 0.15
	Kit.Label(gui, "🏆 TOP GHOST HUNTERS", C(255, 215, 80), { Name = "Title", Pos = UDim2.fromScale(0.04, 0.015), Size = UDim2.fromScale(0.92, titleH - 0.03) })
	Kit.Label(gui, "ALL-TIME ECTOPLASM", C(150, 255, 170), { Name = "Sub", Pos = UDim2.fromScale(0.2, titleH - 0.02), Size = UDim2.fromScale(0.6, 0.05) })
	local rowH = (1 - titleH - 0.06) / rows
	for i = 1, rows do
		local y = titleH + 0.045 + (i - 1) * rowH
		local row: Frame = Instance.new("Frame")
		row.Name = "Row" .. i
		row.BackgroundColor3 = if i % 2 == 0 then C(55, 38, 90) else C(45, 30, 75)
		row.BorderSizePixel = 0
		row.Position = UDim2.fromScale(0.03, y)
		row.Size = UDim2.fromScale(0.94, rowH * 0.92)
		row.Parent = gui
		local rankColor = if i == 1 then C(255, 215, 80) elseif i == 2 then C(220, 225, 240) elseif i == 3 then C(240, 160, 90) else C(200, 190, 230)
		Kit.Label(row, "#" .. i, rankColor, { Name = "Rank", Pos = UDim2.fromScale(0.01, 0.1), Size = UDim2.fromScale(0.12, 0.8) })
		Kit.Label(row, "...", C(255, 255, 255), { Name = "PlayerName", Pos = UDim2.fromScale(0.15, 0.1), Size = UDim2.fromScale(0.52, 0.8) })
		Kit.Label(row, "", C(150, 255, 170), { Name = "Value", Pos = UDim2.fromScale(0.69, 0.1), Size = UDim2.fromScale(0.3, 0.8) })
	end
	local p = L.Position
	Kit.AddRect(p.X - 12, p.Z - 12, p.X + 12, p.Z + 12)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
-- Night-but-bright lighting: purple haze, big moon, punchy colours. Bloom is soft and only
-- catches the brightest pixels, so the few neon accents (windows, lamps, jack-o'-lantern
-- faces) glow without blowing out; the solid candy colours carry the scene.

local LightingService = game:GetService("Lighting")

local LightingSetup = {}

local function clear(name: string)
	local old = LightingService:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

function LightingSetup.Apply()
	local L = LightingService
	L.ClockTime = 0.5
	L.GeographicLatitude = 20
	L.Brightness = 2.2
	L.Ambient = Color3.fromRGB(150, 120, 200)
	L.OutdoorAmbient = Color3.fromRGB(160, 140, 210)
	L.ColorShift_Top = Color3.fromRGB(170, 140, 255)
	L.ColorShift_Bottom = Color3.fromRGB(60, 30, 90)
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.4
	L.GlobalShadows = true
	L.ShadowSoftness = 0.4
	L.ExposureCompensation = 0.12 -- slightly toned down (v1.4.1): same look, easier on the eyes
	L.FogEnd = 100000

	for _, child in L:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "GHSky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 24
	sky.SunAngularSize = 10
	sky.Parent = L

	local atmo = Instance.new("Atmosphere")
	atmo.Name = "GHAtmosphere"
	atmo.Density = 0.26 -- the map is ~2.7k studs long now: keep the next zone's landmarks visible
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(190, 150, 255)
	atmo.Decay = Color3.fromRGB(110, 70, 180)
	atmo.Glare = 0.25
	atmo.Haze = 1.0
	atmo.Parent = L

	clear("GHBloom")
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GHBloom"
	bloom.Intensity = 0.2
	bloom.Size = 16
	bloom.Threshold = 2.3
	bloom.Parent = L

	clear("GHColor")
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GHColor"
	cc.Saturation = 0.24
	cc.Contrast = 0.12
	cc.Brightness = 0
	cc.TintColor = Color3.fromRGB(255, 245, 255)
	cc.Parent = L

	clear("GHSunRays")
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "GHSunRays"
	rays.Intensity = 0.04
	rays.Spread = 0.7
	rays.Parent = L
end

return LightingSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Neighborhood</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 1: Haunted Neighborhood (Z -60..260). Spawn plaza + Ghost Hunter HQ at the south end,
-- a main road along X = 0 to the Cemetery gate, a cross street at Z 110..124 leading east to
-- the event arena, and candy-coloured houses placed on a grid wherever the keep-out map allows.
-- Palette: bright grass, warm houses, orange accents, purple paranormal touches, ectoplasm
-- green. Glow is reserved for the front windows, street lamps, car headlights and the HQ
-- antenna; side windows, plaza rings, chevrons, bands, doors and tanks are solid colours.
-- Materials: Asphalt roads, Concrete sidewalks, Slate roof shingles, Brick chimneys, Wood posts.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Neighborhood = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local WALLS = {
	C(255, 175, 190), C(255, 214, 168), C(255, 225, 140), C(250, 236, 200), C(215, 180, 255),
	C(255, 190, 140), C(240, 200, 150), C(255, 155, 135),
}
local ROOFS = { C(120, 60, 170), C(60, 120, 190), C(200, 70, 110), C(70, 150, 110), C(230, 110, 50), C(90, 70, 160) }
local WINDOWS = { C(255, 235, 120), C(150, 255, 140), C(205, 140, 255), C(255, 200, 90) }
local DOORS = { C(140, 70, 200), C(255, 110, 70), C(60, 170, 150), C(230, 70, 120) }
local TRIM = C(255, 250, 245)

--==================================================================
-- HOUSE
--==================================================================
-- Front windows glow; side windows (lit = false) are warm painted glass.
local function window(m: Instance, cf: CFrame, glow: Color3, lit: boolean?)
	Kit.Part(m, V(4, 4, 0.3), cf, TRIM, { Mat = Enum.Material.Wood })
	local glass: Kit.Opts = if lit == false then { Refl = 0.2 } else { Mat = NEON }
	Kit.Part(m, V(3.2, 3.2, 0.3), cf * CFrame.new(0, 0, -0.12), if lit == false then Kit.Vivid(glow) else glow, glass)
end

local function house(parent: Instance, cx: number, cz: number, fx: number, fz: number)
	local rng = Kit.Rng
	local W = rng:NextInteger(18, 23) -- along local X
	local D = rng:NextInteger(15, 19) -- along local Z (front = -Z)
	local twoStory = rng:NextNumber() < 0.35
	local H = if twoStory then 20 else 13
	local RH = math.floor(W * 0.38)
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local m = Kit.Model(parent, "House")
	local wall = Kit.Pick(WALLS)
	local roof = Kit.Pick(ROOFS)
	local glow = Kit.Pick(WINDOWS)

	Kit.Part(m, V(W + 0.8, 1.2, D + 0.8), base * CFrame.new(0, 0.6, 0), C(150, 130, 170), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(W, H, D), base * CFrame.new(0, H / 2, 0), wall, { Solid = true, Shadow = true, Name = "Body" })
	-- corner trims (front)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.9, H, 0.9), base * CFrame.new(sx * W / 2, H / 2, -D / 2), TRIM)
	end
	-- gable roof: two wedges meeting at the ridge (ridge along local X)
	local half = D / 2 + 1.5
	Kit.Part(m, V(W + 2.4, 0.6, D + 3.4), base * CFrame.new(0, H + 0.3, 0), TRIM)
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, -half / 2), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, half / 2) * CFrame.Angles(0, math.pi, 0), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- chimney poking through the back slope
	local chX = (if rng:NextNumber() < 0.5 then -1 else 1) * W * 0.28
	Kit.Part(m, V(2.4, RH + 2.5, 2.4), base * CFrame.new(chX, H + (RH + 2.5) / 2 + 0.6, D * 0.22), C(190, 110, 100), { Mat = Enum.Material.Brick, Shadow = true })
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(chX, H + RH + 3.4, D * 0.22), C(90, 70, 110))
	if rng:NextNumber() < 0.25 then
		-- a puff of ectoplasm smoke
		Kit.Ball(m, 2.2, (base * CFrame.new(chX, H + RH + 5, D * 0.22)).Position, Kit.Vivid(C(150, 255, 160)), { Transp = 0.4 })
	end
	-- front windows
	local rows: { number } = if twoStory then { H * 0.3, H * 0.72 } else { H * 0.5 }
	for _, wy in rows do
		for _, sx in { -1, 1 } do
			window(m, base * CFrame.new(sx * W * 0.28, wy, -D / 2 - 0.15), glow)
		end
	end
	if twoStory then
		window(m, base * CFrame.new(0, H * 0.72, -D / 2 - 0.15), Kit.Pick(WINDOWS))
	end
	-- side windows
	for _, sx in { -1, 1 } do
		window(m, base * CFrame.new(sx * (W / 2 + 0.15), H * 0.5, 0) * CFrame.Angles(0, -sx * math.pi / 2, 0), glow, false)
	end
	-- door
	Kit.Part(m, V(5, 8, 0.3), base * CFrame.new(0, 4.6, -D / 2 - 0.1), TRIM)
	Kit.Part(m, V(4, 7, 0.4), base * CFrame.new(0, 4.4, -D / 2 - 0.2), Kit.Pick(DOORS))
	Kit.Ball(m, 0.6, (base * CFrame.new(1.3, 4.2, -D / 2 - 0.5)).Position, C(255, 215, 80), { Refl = 0.3 }) -- brass knob
	-- porch with a little roof
	local pw = W * 0.6
	Kit.Part(m, V(pw, 0.8, 5), base * CFrame.new(0, 0.4, -D / 2 - 2.5), C(170, 120, 85), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local porchTop = if twoStory then 9.5 else 9.2
	Kit.Part(m, V(pw + 0.6, 0.5, 5.6), base * CFrame.new(0, porchTop + 0.25, -D / 2 - 2.8), roof)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, porchTop - 0.8, 0.6), base * CFrame.new(sx * (pw / 2 - 0.4), 0.8 + (porchTop - 0.8) / 2, -D / 2 - 5), TRIM, { Mat = Enum.Material.Wood })
	end
	if rng:NextNumber() < 0.55 then
		local p = base * CFrame.new(pw * 0.32, 0.8, -D / 2 - 3.2)
		local front = base.LookVector
		Props.Pumpkin(m, p.Position, 2.4, front.X, front.Z)
	end

	-- yard extras (only where the keep-out map allows)
	local function free(lx: number, lz: number, r: number): boolean
		local p = (base * CFrame.new(lx, 0, lz)).Position
		return Kit.IsFree(p.X, p.Z, r)
	end
	local yard = -D / 2 - 9
	if rng:NextNumber() < 0.45 and free(-W / 2 - 1, yard, 1) and free(W / 2 + 1, yard, 1) then
		local a1 = (base * CFrame.new(-W / 2 - 1, 0, yard)).Position
		local a2 = (base * CFrame.new(-2.5, 0, yard)).Position
		local b1 = (base * CFrame.new(2.5, 0, yard)).Position
		local b2 = (base * CFrame.new(W / 2 + 1, 0, yard)).Position
		Props.Fence(m, a1, a2, "picket")
		Props.Fence(m, b1, b2, "picket")
	elseif free(-W / 2 + 1, yard + 1, 1.5) then
		-- mailbox
		local mp = base * CFrame.new(-W / 2 + 1, 0, yard + 1)
		Kit.Part(m, V(0.5, 3.4, 0.5), mp * CFrame.new(0, 1.7, 0), C(110, 80, 60), { Mat = Enum.Material.Wood })
		Kit.Part(m, V(1.4, 1.3, 2.2), mp * CFrame.new(0, 3.9, 0), Kit.Pick(DOORS))
		Kit.Part(m, V(0.15, 1.2, 0.4), mp * CFrame.new(0.8, 4.4, 0.6), C(255, 70, 90))
	end
	if rng:NextNumber() < 0.3 then
		Props.FloatingPumpkin(m, (base * CFrame.new(-pw * 0.3, 11 + rng:NextNumber(0, 3), -D / 2 - 6)).Position)
	end
	Kit.AddCircle(cx, cz, math.max(W, D) / 2 + 4)
end

--==================================================================
-- SPAWN PLAZA + HQ
--==================================================================
local function chevron(parent: Instance, tip: Vector3, dir: Vector3, color: Color3)
	local perp = V(-dir.Z, 0, dir.X)
	local paint = Kit.Vivid(color)
	for _, s in { -1, 1 } do
		local arm = (-dir + perp * s).Unit
		local center = tip + arm * 2
		Kit.Part(parent, V(1, 0.15, 4.6), CFrame.lookAt(center, center + arm), paint)
	end
end

local function plaza(f: Instance)
	local spawnPos = Config.Layout.Spawn
	local sx, sz = spawnPos.X, spawnPos.Z
	Kit.Disc(f, sx, sz, 0.25, 52, 0.6, C(175, 150, 220), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.Disc(f, sx, sz, 0.35, 44, 0.2, Kit.Vivid(C(150, 255, 140)))
	Kit.Disc(f, sx, sz, 0.42, 42, 0.3, C(120, 95, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Disc(f, sx, sz, 0.5, 20, 0.2, Kit.Vivid(C(210, 120, 255)))

	local spawn: SpawnLocation = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(14, 1, 14)
	-- top surface at Y = 1.1; face +Z (forward)
	spawn.CFrame = CFrame.new(sx, 0.6, sz) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = C(130, 70, 220)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.CanCollide = true
	spawn.CanQuery = true
	spawn.CanTouch = true
	spawn.CastShadow = false
	spawn.Parent = f
	Kit.Stats.Parts += 1
	local g = Kit.Gui(spawn, Enum.NormalId.Top, 20)
	Kit.Label(g, "👻", C(255, 255, 255), { Pos = UDim2.fromScale(0.15, 0.15), Size = UDim2.fromScale(0.7, 0.7) })
	local border = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(sx - 7.4, 0.4, sz + s * 7) - V(0, 0, 0.4), V(sx + 7.4, 1.3, sz + s * 7) + V(0, 0, 0.4), border)
		Kit.Box(f, V(sx + s * 7, 0.4, sz - 7) - V(0.4, 0, 0), V(sx + s * 7, 1.3, sz + 7) + V(0.4, 0, 0), border)
	end

	-- plaza lamps on the rim
	for i, a in { 45, 135, 225, 315 } do
		local r = math.rad(a)
		Props.StreetLamp(f, V(sx + math.cos(r) * 23, 0.25, sz + math.sin(r) * 23), C(200, 140, 255), i <= 2)
	end

	-- guide chevrons to the Beginner crate and the upgrade booth
	local beg = Config.Layout.CrateStations.Beginner
	local up = Config.Layout.UpgradeStation
	for _, target in { beg, up } do
		local dir = (V(target.X, 0, target.Z) - V(sx, 0, sz)).Unit
		for i = 1, 3 do
			chevron(f, V(sx, 0.55, sz) + dir * (8 + i * 4.5), dir, if target == beg then C(255, 180, 60) else C(90, 210, 255))
		end
	end
	-- signpost straight ahead of spawn
	local post = V(sx, 0, sz + 19)
	Kit.Box(f, post - V(0.4, 0, 0.4), post + V(0.4, 11, 0.4), C(110, 80, 60), { Mat = Enum.Material.Wood })
	local boards = {
		{ Y = 10, Off = 0, Text = "👻 GHOSTS AHEAD", Col = C(150, 255, 140) },
		-- the player faces +Z, so -X is on their right
		{ Y = 7.6, Off = -3, Text = "CRATES ▶", Col = C(255, 190, 70) },
		{ Y = 5.2, Off = 3, Text = "◀ UPGRADES", Col = C(110, 220, 255) },
	}
	for _, b in boards do
		Props.SignBoard(f, post + V(b.Off, b.Y, -0.6), 8, 2, 0, -1, b.Text, C(50, 30, 85), b.Col)
	end
end

local function hq(f: Instance)
	local purple, dark = C(120, 75, 210), C(60, 40, 110)
	Kit.Box(f, V(-24, 0, -58), V(24, 16, -40), purple, { Mat = Enum.Material.Concrete, Solid = true, Name = "HQ" })
	Kit.Box(f, V(-26, 16, -60), V(26, 17.5, -38), dark, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Ball(f, 18, V(0, 17.5, -50), C(190, 160, 255), { Shadow = true })
	Kit.Box(f, V(-24.3, 5.6, -39.9), V(24.3, 6.4, -39.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Box(f, V(-24.3, 15, -39.9), V(24.3, 15.6, -39.6), Kit.Vivid(C(255, 150, 60)))
	-- big mint door
	Kit.Box(f, V(-7, 0, -39.85), V(7, 12, -39.6), TRIM)
	Kit.Box(f, V(-6, 0, -39.7), V(6, 11, -39.35), Kit.Vivid(C(150, 255, 160)), { Refl = 0.1 })
	-- windows
	for _, x in { -17, -11, 11, 17 } do
		Kit.Box(f, V(x - 2, 8, -39.8), V(x + 2, 12.5, -39.4), C(255, 235, 120), { Mat = NEON })
	end
	-- sign facing +Z (toward spawn)
	local signCF = CFrame.new(0, 21.5, -39) * CFrame.Angles(0, Kit.FaceYaw(0, 1), 0)
	local sign = Kit.Part(f, V(32, 6, 1), signCF, C(45, 25, 80))
	Kit.Part(f, V(33.5, 7.5, 0.5), signCF * CFrame.new(0, 0, 0.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sign, Enum.NormalId.Front, "GHOST HUNTER HQ", C(255, 230, 90))
	-- antenna + dish
	Kit.Cyl(f, 18, 0.8, CFrame.new(16, 26.5, -50), C(200, 200, 220), { Mat = Enum.Material.Metal })
	local orb = Kit.Ball(f, 2.6, V(16, 36, -50), C(255, 90, 160), { Mat = NEON })
	Kit.Light(orb, C(255, 120, 190), 30, 1.2)
	Kit.Cyl(f, 0.8, 9, CFrame.new(-16, 21, -50) * CFrame.Angles(math.rad(35), 0, 0), C(230, 230, 245))
	Kit.Cyl(f, 3, 1, CFrame.new(-16, 19, -50), C(150, 150, 170))
	-- containment tanks with captured ghosts
	for _, s in { -1, 1 } do
		local x = s * 30
		Kit.Cyl(f, 1, 9, CFrame.new(x, 0.5, -46), dark, { Mat = Enum.Material.Metal, Solid = true })
		local tank = Kit.Cyl(f, 12, 8, CFrame.new(x, 7, -46), Kit.Vivid(C(130, 255, 170)), { Transp = 0.55, Refl = 0.2 })
		Kit.Cyl(f, 1, 9, CFrame.new(x, 13.5, -46), dark, { Mat = Enum.Material.Metal })
		Kit.Ball(f, 3.6, V(x, 7.5, -46), C(240, 245, 255))
		Kit.Emitter(tank, C(150, 255, 180), 2, 2, 0.5)
	end
	Kit.AddRect(-36, -60, 36, -36)
end

--==================================================================
-- ROADS
--==================================================================
local function roads(f: Instance)
	local asphalt = C(72, 64, 92)
	local walk = C(200, 185, 230)
	-- main road X -10..10 from HQ to the gate
	local pave: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true }
	Kit.Box(f, V(-10, -0.4, -36), V(10, 0.1, 260), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "MainRoad" })
	for z = 34, 250, 12 do
		Kit.Box(f, V(-0.4, 0.1, z), V(0.4, 0.14, z + 6), C(255, 210, 80))
	end
	-- cross street toward the arena
	Kit.Box(f, V(-136, -0.4, 110), V(63, 0.06, 124), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "CrossStreet" })
	for x = -130, 55, 12 do
		if x < -16 or x > 14 then
			Kit.Box(f, V(x, 0.06, 116.6), V(x + 6, 0.1, 117.4), C(255, 210, 80))
		end
	end
	-- sidewalks
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, -0.4, 26), V(s * 14, 0.22, 106), walk, pave)
		Kit.Box(f, V(s * 10, -0.4, 128), V(s * 14, 0.22, 257), walk, pave)
		Kit.Box(f, V(-136, -0.4, if s < 0 then 106 else 124), V(-14, 0.22, if s < 0 then 110 else 128), walk, pave)
		Kit.Box(f, V(14, -0.4, if s < 0 then 106 else 124), V(61, 0.22, if s < 0 then 110 else 128), walk, pave)
	end
	Kit.AddRect(-14, -36, 14, 260, true)
	Kit.AddRect(-136, 106, 63, 128, true)
end

--==================================================================
-- BUILD
--==================================================================
function Neighborhood.Build(map: Instance)
	local f = Kit.Folder(map, "Neighborhood")
	local rng = Kit.Rng

	plaza(f)
	hq(f)
	roads(f)

	-- Houses on a grid; each faces the main road.
	local houses = Kit.Folder(f, "Houses")
	for _, x in { -118, -88, -58, -28, 28, 58, 88, 118 } do
		for z = -40, 230, 30 do
			if Kit.IsFree(x, z, 15) then
				house(houses, x, z, if x < 0 then 1 else -1, 0)
			end
		end
	end

	-- Street lamps along the main road (skipped inside ghost areas)
	local lit = 0
	for z = 34, 250, 24 do
		for _, s in { -1, 1 } do
			local x = s * 12.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0.22, z), Kit.Pick({ C(255, 230, 120), C(170, 255, 150), C(210, 150, 255) }), lit % 2 == 1 and lit <= 9)
			end
		end
	end
	for x = -125, 50, 35 do
		if Kit.IsFree(x, 108, 1, true) then
			Props.StreetLamp(f, V(x, 0.22, 108), C(255, 200, 120), false)
		end
	end

	-- Parked cars (curbside)
	local cars = {
		{ -6, 150, 0, 1 }, { 6, 186, 0, -1 }, { -105, 113.5, 1, 0 }, { -42, 113.5, 1, 0 }, { 40, 120.5, -1, 0 },
		{ 70, -30, 0, 1 }, { -70, 20, 0, -1 },
	}
	for _, c in cars do
		if Kit.IsFree(c[1], c[2], 7.5, true) then
			Props.Car(f, V(c[1], 0.1, c[2]), c[3], c[4], Kit.Pick(Props.Colors.Car))
		end
	end

	-- Trees and pumpkins scattered on free grass
	local trees = 0
	for _ = 1, 260 do
		if trees >= 30 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(-54, 250)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(10, 17))
		end
	end
	local pumpkins = 0
	for _ = 1, 300 do
		if pumpkins >= 26 then
			break
		end
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(-54, 254)
		if Kit.IsFree(x, z, 2.5) then
			pumpkins += 1
			Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 4.6), -x, -z + 100)
			Kit.AddCircle(x, z, 2.5)
		end
	end
	local floats = 0
	for _ = 1, 200 do
		if floats >= 3 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(-40, 240)
		if Kit.IsFree(x, z, 3) then
			floats += 1
			Props.FloatingPumpkin(f, V(x, rng:NextNumber(8, 13), z))
		end
	end

	-- Spectral fog accents
	Props.Wisp(f, V(-40, 0, 40), C(170, 110, 255), 14, true)
	Props.Wisp(f, V(55, 0, 135), C(120, 255, 170), 12, true)
	Props.Wisp(f, V(-110, 0, 215), C(200, 120, 255), 16, true)
	Props.Wisp(f, V(30, 0, 240), C(120, 255, 170), 10, false)
	Props.Wisp(f, V(-60, 0, -20), C(170, 110, 255), 12, false)
	Props.Wisp(f, V(110, 0, 20), C(255, 140, 220), 12, false)
end

return Neighborhood
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable chunky props shared by every zone (pumpkins, trees, lamps, fences, cars...).
-- Positions are ground points (Y = 0 is the walkable surface) unless stated otherwise.

local Kit = require(script.Parent.Kit)

local Props = {}

local NEON = Enum.Material.Neon
local C = Color3.fromRGB

Props.Colors = {
	PumpkinBody = { C(255, 140, 30), C(255, 120, 40), C(255, 165, 50) },
	Canopy = { C(170, 90, 230), C(255, 140, 50), C(200, 110, 255), C(255, 110, 90), C(140, 220, 90) },
	Glow = { C(255, 230, 110), C(140, 255, 120), C(200, 130, 255), C(255, 170, 70) },
	Car = { C(255, 90, 140), C(80, 200, 255), C(255, 200, 60), C(140, 255, 140), C(190, 120, 255), C(255, 120, 60) },
	Book = { C(255, 90, 90), C(90, 170, 255), C(255, 210, 70), C(140, 230, 120), C(200, 120, 255), C(255, 140, 200) },
}

-- Segment between two points (square cross-section). Used for twisted trunks, branches, cracks.
function Props.Beam(parent: Instance, a: Vector3, b: Vector3, w: number, h: number, color: Color3, opts: Kit.Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local cf: CFrame
	if math.abs(d.Unit.Y) > 0.98 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return Kit.Part(parent, Vector3.new(w, h, len), cf, color, opts)
end

-- Pumpkin / jack-o-lantern with a carved face toward (fx, fz). `pos` is the bottom of the pumpkin.
-- glow = true gives a Neon jack-o'-lantern face: use it only at landmarks (gate pillars, crate
-- stations, the arena rim, the school path). Every other pumpkin gets a warm solid-yellow
-- face, so the ~100 pumpkins on the map don't turn into glowing confetti.
local FACE_GLOW = C(255, 235, 90)
local FACE_SOLID = C(255, 205, 55)

function Props.Pumpkin(parent: Instance, pos: Vector3, d: number, fx: number, fz: number, glow: boolean?): Part
	local center = pos + Vector3.new(0, d * 0.45, 0)
	local body = Kit.Ball(parent, d, center, Kit.Pick(Props.Colors.PumpkinBody), { Shadow = false })
	local base = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Part(parent, Vector3.new(d * 0.12, d * 0.3, d * 0.12), base * CFrame.new(0, d * 0.55, 0) * CFrame.Angles(0, 0, 0.25), C(90, 160, 60))
	local face = if glow then FACE_GLOW else FACE_SOLID
	local faceOpts: Kit.Opts = if glow then { Mat = NEON } else {}
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(-d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.42, d * 0.1, d * 0.1), base * CFrame.new(0, -d * 0.12, -d * 0.45), face, faceOpts)
	return body
end

-- Lollipop tree: trunk + three canopy balls.
function Props.Tree(parent: Instance, pos: Vector3, height: number, canopy: Color3?)
	local col = canopy or Kit.Pick(Props.Colors.Canopy)
	local rng = Kit.Rng
	Kit.Cyl(parent, height, 1.8, CFrame.new(pos + Vector3.new(0, height / 2, 0)), C(120, 75, 50), { Mat = Enum.Material.Wood, Solid = true, Shadow = true })
	local top = pos + Vector3.new(0, height, 0)
	local s = height * 0.55
	Kit.Ball(parent, s, top, col, { Shadow = true })
	Kit.Ball(parent, s * 0.75, top + Vector3.new(rng:NextNumber(-2, 2), s * 0.35, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(1, 1, 1), 0.15))
	Kit.Ball(parent, s * 0.6, top + Vector3.new(rng:NextNumber(-3, 3), -s * 0.2, rng:NextNumber(-3, 3)), col:Lerp(Color3.new(0, 0, 0), 0.12))
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Twisted spooky tree made of crooked segments, bare branches and a few candy-coloured leaf puffs.
function Props.TwistedTree(parent: Instance, pos: Vector3, height: number)
	local rng = Kit.Rng
	local trunk = C(95, 70, 110)
	local pts = { pos }
	local seg = height / 3
	for i = 1, 3 do
		local prev = pts[i]
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1.2, 2.8)
		table.insert(pts, prev + Vector3.new(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 3 do
		local w = 3.2 - i * 0.7
		Props.Beam(parent, pts[i], pts[i + 1], w, w, trunk, { Mat = Enum.Material.Wood, Solid = i == 1, Shadow = true })
	end
	local leaf = { C(170, 90, 255), C(110, 255, 160), C(255, 120, 200) }
	for b = 1, 3 do
		local from = pts[2 + (b % 2)]
		local ang = b * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.22, 0.32)
		local tip = from + Vector3.new(math.cos(ang) * len, len * 0.6, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 0.9, 0.9, trunk, { Mat = Enum.Material.Wood })
		Kit.Ball(parent, rng:NextNumber(3.5, 5.5), tip, Kit.Vivid(Kit.Pick(leaf)), { Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Street lamp: pole, arm and a glowing globe.
function Props.StreetLamp(parent: Instance, pos: Vector3, color: Color3, withLight: boolean)
	local pole = C(60, 45, 90)
	local metal: Kit.Opts = { Mat = Enum.Material.Metal }
	Kit.Cyl(parent, 13, 0.8, CFrame.new(pos + Vector3.new(0, 6.5, 0)), pole, metal)
	Kit.Cyl(parent, 0.8, 1.8, CFrame.new(pos + Vector3.new(0, 0.4, 0)), pole, metal)
	Kit.Box(parent, pos + Vector3.new(-0.3, 12.6, -0.3), pos + Vector3.new(0.3, 13.2, 0.3), pole, metal)
	local globe = Kit.Ball(parent, 2.4, pos + Vector3.new(0, 14, 0), color, { Mat = NEON })
	Kit.Cyl(parent, 0.5, 2.8, CFrame.new(pos + Vector3.new(0, 15.3, 0)), pole, metal)
	if withLight then
		Kit.Light(globe, color, 22, 1.6)
	end
end

-- Little post lantern (cemetery paths).
function Props.Lantern(parent: Instance, pos: Vector3, color: Color3, withLight: boolean, flicker: boolean?)
	local iron = C(50, 40, 70)
	Kit.Box(parent, pos + Vector3.new(-0.3, 0, -0.3), pos + Vector3.new(0.3, 7, 0.3), iron, { Mat = Enum.Material.Metal })
	local glow = Kit.Box(parent, pos + Vector3.new(-0.8, 7, -0.8), pos + Vector3.new(0.8, 9, 0.8), color, { Mat = NEON })
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, -0.55)), iron)
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, 0.55)) * CFrame.Angles(0, math.pi, 0), iron)
	if withLight then
		Kit.Light(glow, color, 18, 1.4, flicker)
	end
end

-- Mushroom cluster with bright candy caps.
function Props.Mushrooms(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local caps = { C(120, 255, 200), C(200, 120, 255), C(255, 150, 220), C(120, 220, 255) }
	for _ = 1, rng:NextInteger(2, 3) do
		local p = pos + Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.8, 2)
		Kit.Cyl(parent, h, 0.5, CFrame.new(p + Vector3.new(0, h / 2, 0)), C(245, 240, 225))
		Kit.Ball(parent, rng:NextNumber(1.3, 2), p + Vector3.new(0, h, 0), Kit.Vivid(Kit.Pick(caps)))
	end
end

-- Fence run from a to b (ground points). style: "picket" (crooked white wood) or "iron" (dark
-- metal with mint tips).
function Props.Fence(parent: Instance, a: Vector3, b: Vector3, style: string)
	local rng = Kit.Rng
	local d = b - a
	local len = d.Magnitude
	if len < 1 then
		return
	end
	local dir = d.Unit
	local yaw = math.atan2(-dir.X, -dir.Z) -- local -Z along the run
	local iron = style == "iron"
	local col = if iron then C(55, 45, 80) else C(250, 240, 255)
	local h = if iron then 6 else 3.6
	local mat: Kit.Opts = { Mat = if iron then Enum.Material.Metal else Enum.Material.Wood }
	local step = if iron then 2 else 1.6
	local rails = { h * 0.3, h * 0.75 }
	for _, ry in rails do
		local mid = a + d / 2 + Vector3.new(0, ry, 0)
		Kit.Part(parent, Vector3.new(0.3, 0.3, len), CFrame.new(mid) * CFrame.Angles(0, yaw, 0), col, mat)
	end
	local n = math.floor(len / step)
	for i = 0, n do
		local p = a + dir * (i * step) + Vector3.new(0, h / 2, 0)
		local tilt = if iron then 0 else rng:NextNumber(-0.14, 0.14)
		local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt * 0.3, 0, tilt)
		Kit.Part(parent, Vector3.new(if iron then 0.35 else 0.25, h, if iron then 0.35 else 0.9), cf, col, mat)
		if iron and i % 3 == 0 then
			Kit.Ball(parent, 0.7, p + Vector3.new(0, h / 2 + 0.3, 0), Kit.Vivid(C(120, 255, 170)))
		end
	end
end

-- Low translucent spectral puddle on the ground (solid colour, the fog particles do the
-- glowing); optional slow particle fog.
function Props.Wisp(parent: Instance, pos: Vector3, color: Color3, d: number, emit: boolean)
	local p = Kit.Disc(parent, pos.X, pos.Z, 0.3, d, 0.12, Kit.Vivid(color), { Transp = 0.6 })
	if emit then
		local src = Kit.Part(parent, Vector3.new(d * 0.6, 0.2, d * 0.6), CFrame.new(pos + Vector3.new(0, 1, 0)), color, { Transp = 1, Name = "FogSource" })
		Kit.Emitter(src, color, 1.5, 7, 0.4)
	end
	return p
end

-- Chunky cartoon car. `along` = direction the car faces (unit X/Z vector).
function Props.Car(parent: Instance, pos: Vector3, fx: number, fz: number, color: Color3)
	local m = Kit.Model(parent, "Car")
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	-- body (length along local Z)
	Kit.Part(m, Vector3.new(7.5, 3, 14), base * CFrame.new(0, 2.6, 0), color, { Solid = true, Shadow = true })
	Kit.Part(m, Vector3.new(6.6, 2.8, 7), base * CFrame.new(0, 5.4, 0.8), color:Lerp(Color3.new(1, 1, 1), 0.25), { Solid = true })
	local glass = Kit.Vivid(C(170, 230, 255))
	Kit.Part(m, Vector3.new(5.8, 2, 0.3), base * CFrame.new(0, 5.5, -2.75), glass, { Transp = 0.2, Refl = 0.25 })
	Kit.Part(m, Vector3.new(6.7, 1.8, 5.4), base * CFrame.new(0, 5.5, 0.8), glass, { Transp = 0.3, Refl = 0.25 })
	local axle = if math.abs(fx) > math.abs(fz) then "Z" else "X"
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 1.2, 3.4, (base * CFrame.new(sx * 3.5, 1.7, sz * 4.4)).Position, axle, C(40, 35, 55), { Mat = Enum.Material.Rubber })
		end
		Kit.Part(m, Vector3.new(1.4, 1, 0.3), base * CFrame.new(sx * 2.6, 3, -7.05), C(255, 250, 200), { Mat = NEON })
		-- tail lights: glossy painted red (headlights are the only glow on a car)
		Kit.Part(m, Vector3.new(1.2, 0.8, 0.3), base * CFrame.new(sx * 2.7, 3, 7.05), Kit.Vivid(C(230, 40, 70)), { Refl = 0.3 })
	end
	Kit.AddCircle(pos.X, pos.Z, 8)
end

-- Cute skull (big white ball with black eyes) facing (fx, fz). pos = centre.
function Props.Skull(parent: Instance, pos: Vector3, d: number, fx: number, fz: number)
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(parent, d, pos, C(250, 245, 235))
	Kit.Part(parent, Vector3.new(d * 0.55, d * 0.35, d * 0.5), base * CFrame.new(0, -d * 0.4, -d * 0.1), C(250, 245, 235))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, d * 0.28, (base * CFrame.new(sx * d * 0.18, d * 0.05, -d * 0.38)).Position, C(120, 255, 170), { Mat = NEON })
	end
end

-- Single-part floating book (tagged). pos = centre in the air.
function Props.FloatingBook(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local b = Kit.Part(parent, Vector3.new(1.8, 0.5, 2.4), cf, Kit.Pick(Props.Colors.Book), { Name = "FloatingBook" })
	Kit.Float(b, rng:NextNumber(0.6, 1.2))
end

-- Single-part floating candle (tagged).
function Props.FloatingCandle(parent: Instance, pos: Vector3)
	local c = Kit.Cyl(parent, 1.6, 0.6, CFrame.new(pos), C(255, 230, 160), { Mat = NEON, Name = "FloatingCandle" })
	Kit.Float(c, Kit.Rng:NextNumber(0.5, 1))
end

-- Single-part floating pumpkin (tagged).
function Props.FloatingPumpkin(parent: Instance, pos: Vector3)
	local p = Kit.Ball(parent, 2.4, pos, C(255, 150, 40), { Name = "FloatingPumpkin" })
	Kit.Float(p, Kit.Rng:NextNumber(0.6, 1.1))
end

-- A sign board facing (fx, fz) with text on its Front face.
function Props.SignBoard(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, bg: Color3, fg: Color3, frame: Color3?): Part
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local board = Kit.Part(parent, Vector3.new(w, h, 0.6), cf, bg, { Name = "SignBoard" })
	if frame then
		Kit.Part(parent, Vector3.new(w + 1, h + 1, 0.4), cf * CFrame.new(0, 0, 0.35), Kit.Vivid(frame))
	end
	Kit.Sign(board, Enum.NormalId.Front, text, fg)
	return board
end

-- Graffiti: an invisible thin panel with neon text, flat against a wall, facing (fx, fz).
function Props.Graffiti(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, color: Color3, rot: number?)
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local panel = Kit.Part(parent, Vector3.new(w, h, 0.1), cf, color, { Transp = 1, Name = "Graffiti" })
	Kit.Sign(panel, Enum.NormalId.Front, text, color, { Font = Enum.Font.FredokaOne, Stroke = C(30, 10, 50), Rotation = rot })
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">School</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 3: Haunted School (Z 540..880).
--   Courtyard Z 540..600: path, Elite crate station (built by Stations), ghost bus, flagpole.
--   Building X -100..100, Z 600..860, walls 16 tall, NO roof over the interior (only rim
--   ledges and a few thin beams) so the camera and ghost taps work from above.
--     Front wall Z=600 with a 20-wide entrance under the clock tower (top ~Y 104).
--     Central hallway X -16..16, Z 601..761 (ghost areas at Z 640 and 700).
--     Library   X -99..-18, Z 601..648   | Cafeteria X 18..99, Z 601..648
--     Class 1-A X -99..-18, Z 650..761   | Class 1-B X 18..99, Z 650..761 (ghost areas at X ±62, Z 690)
--     Gym       X -99..99,  Z 763..859 (Headmaster area at Z 805), bleachers along the back wall
--               in two halves either side of the back exit.
--   Doorways: hallway→library/cafeteria 14 wide, hallway→classes 20 wide, library/cafeteria→class
--   14 wide, classes→gym 16 wide, hallway→gym 32 wide, gym→back exit 28 wide (X -14..14, Z 860,
--   12 tall under an "EXIT → CARNIVAL" sign), then a flat path to Gate_Carnival at Z 880.
--   The strips X 105..136 beside the building stay walkable from the courtyard to the back.
--   Palette: warm brick exterior, cream inner walls and trims, school-blue roofs/ledges, purple
--   spectral accents, green ectoplasm. Glow is kept to the front windows, sconces, desk lamps,
--   the bell, slime puddles, bus headlights and the jack-o'-lanterns along the path; bands,
--   rings, lines, frames, trims and side windows are painted.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local School = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local H = 16
local EXT = C(190, 98, 76) -- warm brick
local CREAM = C(245, 232, 205)
local BLUE = C(70, 112, 190) -- school blue
local TRIMC = C(70, 105, 185)
local WHITE = C(255, 250, 245)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }
local BRICK: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }

type Opening = { c: number, w: number, h: number? }

local function sortOpenings(list: { Opening })
	table.sort(list, function(a: Opening, b: Opening)
		return a.c < b.c
	end)
end

-- Wall along X at fixed z (thickness 2), from x1 to x2, with doorway openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = x1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(cur, 0, z - 1), V(a, H, z + 1), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(a, oh, z - 1), V(b, H, z + 1), color, wo)
		end
		cur = b
	end
	if x2 > cur then
		Kit.Box(parent, V(cur, 0, z - 1), V(x2, H, z + 1), color, wo)
	end
end

-- Wall along Z at fixed x (thickness 2), from z1 to z2, with doorway openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = z1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, a), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(x - 1, oh, a), V(x + 1, H, b), color, wo)
		end
		cur = b
	end
	if z2 > cur then
		Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, z2), color, wo)
	end
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, SOLID)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, SOLID)
end

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	-- wall lamp on a wall whose inner face is at pos.X - fx * 0.5
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), C(60, 40, 90))
	Kit.Light(lamp, color, 24, 1.6, true)
end

--==================================================================
-- SHELL
--==================================================================
local function shell(f: Instance)
	-- floors (top Y 0.15)
	Kit.Box(f, V(-101, -0.5, 599), V(101, 0.1, 861), C(110, 90, 150), { Solid = true, Name = "SchoolFloor" })
	local tiles = { C(240, 230, 210), C(95, 135, 205) }
	for i = 0, 3 do
		for j = 0, 19 do
			local x0, z0 = -16 + i * 8, 601 + j * 8
			Kit.Box(f, V(x0, 0.05, z0), V(x0 + 8, 0.15, z0 + 8), tiles[((i + j) % 2) + 1], { Solid = true })
		end
	end
	Kit.Box(f, V(-99, 0.05, 601), V(-18, 0.15, 648), C(190, 130, 90), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 601), V(99, 0.15, 648), C(255, 225, 175), { Solid = true })
	Kit.Box(f, V(-99, 0.05, 650), V(-18, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 650), V(99, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(-99, 0.05, 763), V(99, 0.15, 859), C(235, 160, 90), { Mat = Enum.Material.WoodPlanks, Solid = true, Name = "GymFloor" })

	-- exterior walls
	wallX(f, 600, -101, 101, EXT, { { c = 0, w = 20 } }, BRICK)
	-- back exit out of the gym toward Gate_Carnival (X -14..14, 12 tall)
	wallX(f, 860, -101, 101, EXT, { { c = 0, w = 28, h = 12 } }, BRICK)
	wallZ(f, -100, 601, 859, EXT, {}, BRICK)
	wallZ(f, 100, 601, 859, EXT, {}, BRICK)
	-- hallway walls
	local hall = CREAM
	wallZ(f, -17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	wallZ(f, 17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	-- front rooms / classrooms divider and the gym wall
	local inner = C(120, 160, 215)
	wallX(f, 649, -99, -18, inner, { { c = -60, w = 14, h = 12 } })
	wallX(f, 649, 18, 99, inner, { { c = 60, w = 14, h = 12 } })
	wallX(f, 762, -99, 99, C(235, 215, 180), { { c = 0, w = 32 }, { c = -60, w = 16, h = 13 }, { c = 60, w = 16, h = 13 } })

	-- parapet on the exterior walls + partial roof ledges (no roof over the interior)
	local rim: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true, Shadow = true }
	Kit.Box(f, V(-102, H, 598), V(102, H + 2, 602), CREAM, rim)
	Kit.Box(f, V(-102, H, 858), V(102, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(-102, H, 598), V(-98, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(98, H, 598), V(102, H + 2, 862), CREAM, rim)
	local ledge = BLUE
	Kit.Box(f, V(-98, H + 0.5, 602), V(98, H + 1.5, 607), ledge)
	Kit.Box(f, V(-98, H + 0.5, 853), V(98, H + 1.5, 858), ledge)
	Kit.Box(f, V(-98, H + 0.5, 602), V(-93, H + 1.5, 858), ledge)
	Kit.Box(f, V(93, H + 0.5, 602), V(98, H + 1.5, 858), ledge)
	-- sloped eaves on the outside
	local eave = C(55, 85, 150)
	local eaveOpts: Kit.Opts = { Mat = Enum.Material.Slate, Shadow = true }
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 596), 0, -1), eave, eaveOpts)
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 864), 0, 1), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(-104, H + 0.5, 730), -1, 0), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(104, H + 0.5, 730), 1, 0), eave, eaveOpts)
	-- painted band along the front
	Kit.Box(f, V(-101.2, 14, 598.7), V(101.2, 14.6, 598.9), Kit.Vivid(C(150, 255, 140)))

	-- corner turrets
	local turretRing, turretTop = Kit.Vivid(C(200, 130, 255)), Kit.Vivid(C(150, 255, 140))
	for _, x in { -100, 100 } do
		for _, z in { 600, 860 } do
			Kit.Cyl(f, 24, 10, CFrame.new(x, 12, z), EXT:Lerp(C(255, 255, 255), 0.08), BRICK)
			Kit.Cyl(f, 1, 10.6, CFrame.new(x, 14.3, z), turretRing)
			Kit.Cyl(f, 2, 11.5, CFrame.new(x, 25, z), CREAM, { Mat = Enum.Material.Concrete })
			Kit.Cyl(f, 3, 8, CFrame.new(x, 27.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Cyl(f, 3, 4.5, CFrame.new(x, 30.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Ball(f, 2.6, V(x, 33, z), turretTop)
		end
	end

	-- facade windows glow (ghostly); side windows are warm painted glass
	for _, x in { -88, -70, -50, -30, 30, 50, 70, 88 } do
		Kit.Box(f, V(x - 3, 4.5, 598.75), V(x + 3, 12.5, 599), WHITE)
		Kit.Box(f, V(x - 2.4, 5, 598.6), V(x + 2.4, 12, 598.85), Kit.Pick({ C(255, 230, 120), C(150, 255, 140), C(210, 150, 255) }), { Mat = NEON })
	end
	for _, s in { -1, 1 } do
		for _, z in { 625, 690, 735, 790, 830 } do
			Kit.Box(f, V(s * 101, 4.5, z - 3), V(s * 101.25, 12.5, z + 3), WHITE)
			Kit.Box(f, V(s * 101.15, 5, z - 2.4), V(s * 101.4, 12, z + 2.4), Kit.Vivid(Kit.Pick({ C(255, 225, 130), C(160, 235, 150), C(200, 160, 245) })), { Refl = 0.2 })
		end
	end
	-- entrance steps
	Kit.Box(f, V(-12, 0, 592), V(12, 0.5, 599), C(200, 190, 220), { Mat = Enum.Material.Slate, Solid = true })
end

--==================================================================
-- CLOCK TOWER (over the entrance)
--==================================================================
local function clockTower(f: Instance)
	local body = EXT:Lerp(C(0, 0, 0), 0.05)
	local mint, orange = Kit.Vivid(C(150, 255, 140)), Kit.Vivid(C(255, 160, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, 594), V(s * 14, 22, 606), body, BRICK)
		Kit.Box(f, V(s * 9.8, 0, 593.8), V(s * 10.3, 22, 594.3), mint)
	end
	Kit.Box(f, V(-14, 22, 594), V(14, 62, 606), body, { Mat = Enum.Material.Brick, Solid = true, Shadow = true, Name = "ClockTower" })
	Kit.Box(f, V(-14.3, 22, 593.7), V(14.3, 23, 606.3), mint)
	Kit.Box(f, V(-14.3, 61, 593.7), V(14.3, 62, 606.3), orange)
	-- SPOOKY HIGH sign
	local sign = Kit.Part(f, V(26, 6, 0.6), CFrame.new(0, 26.5, 593.6), C(45, 25, 80))
	Kit.Part(f, V(27.5, 7.5, 0.3), CFrame.new(0, 26.5, 593.85), orange)
	Kit.Sign(sign, Enum.NormalId.Front, "SPOOKY HIGH", C(255, 200, 80))
	-- clock (11:55, almost midnight)
	Kit.CylFlat(f, 0.5, 17.5, V(0, 44, 593.75), "Z", Kit.Vivid(C(200, 120, 255)))
	Kit.CylFlat(f, 0.6, 16, V(0, 44, 593.4), "Z", C(255, 245, 225))
	local function hand(len: number, w: number, angle: number, z: number, color: Color3)
		Kit.Part(f, V(w, len, 0.25), CFrame.new(0, 44, z) * CFrame.Angles(0, 0, angle) * CFrame.new(0, len / 2, 0), color)
	end
	hand(5, 1, -0.05, 593.0, C(60, 30, 90))
	hand(7, 0.7, -0.52, 592.9, C(130, 60, 200))
	Kit.Ball(f, 1.2, V(0, 44, 592.9), orange)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Part(f, V(0.8, 1.6, 0.3), CFrame.new(math.sin(a) * 6.5, 44 + math.cos(a) * 6.5, 593.0) * CFrame.Angles(0, 0, -a), C(130, 60, 200))
	end
	-- bell loft
	for _, x in { -12.5, 12.5 } do
		for _, z in { 595.5, 604.5 } do
			Kit.Box(f, V(x - 1.5, 62, z - 1.5), V(x + 1.5, 74, z + 1.5), CREAM, { Mat = Enum.Material.Concrete, Solid = true, Shadow = true })
		end
	end
	local bell = Kit.Ball(f, 7, V(0, 68, 600), C(255, 200, 70))
	Kit.Ball(f, 3, V(0, 64.8, 600), C(150, 255, 140), { Mat = NEON })
	Kit.Light(bell, C(170, 255, 160), 30, 1.4)
	Kit.Box(f, V(-15.5, 74, 592.5), V(15.5, 76, 607.5), TRIMC, SOLID)
	gable(f, CFrame.new(0, 76, 600), 31, 15, 14, C(55, 85, 150))
	Kit.Cyl(f, 12, 1.2, CFrame.new(0, 96, 600), C(240, 220, 120))
	Kit.Ball(f, 3.2, V(0, 103, 600), Kit.Vivid(C(200, 120, 255)))
end

--==================================================================
-- HALLWAY
--==================================================================
local function hallway(f: Instance)
	local lockerCols = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	local runs = { { 606, 616 }, { 632, 679 }, { 701, 760 } }
	local slimed = Kit.Vivid(C(140, 255, 150))
	local n = 0
	for _, s in { -1, 1 } do
		for _, r in runs do
			local z0 = r[1]
			while z0 + 3 <= r[2] do
				n += 1
				Kit.Box(f, V(s * 16, 0.15, z0), V(s * 14.5, 8.5, z0 + 3), lockerCols[(n % #lockerCols) + 1], { Mat = Enum.Material.Metal, Solid = true })
				if n % 7 == 0 then
					Kit.Box(f, V(s * 14.5, 1, z0 + 0.4), V(s * 14.35, 8, z0 + 2.6), slimed) -- slimed locker door
				end
				z0 += 3.2
			end
			Kit.Box(f, V(s * 16, 8.5, r[1]), V(s * 14.3, 9, r[2]), C(120, 70, 190))
		end
	end
	-- painted guide lines on the floor (flat)
	local guide = Kit.Vivid(C(200, 130, 255))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 7 - 0.25, 0.15, 603), V(s * 7 + 0.25, 0.2, 760), guide)
	end
	-- thin beams overhead (Y 16..17.5), clear of the ghost areas' height
	for _, z in { 615, 670, 732, 758 } do
		Kit.Box(f, V(-18, H, z - 0.75), V(18, H + 1.5, z + 0.75), C(120, 80, 60), { Mat = Enum.Material.WoodPlanks })
	end
	local gymSign = Kit.Part(f, V(14, 3, 0.4), CFrame.new(0, 13.6, 758), C(45, 25, 80))
	Kit.Sign(gymSign, Enum.NormalId.Front, "🏀 GYM 🏀", C(255, 190, 80))
	for _, x in { -5, 5 } do
		Kit.Box(f, V(x - 0.1, 15.1, 757.9), V(x + 0.1, H, 758.1), C(60, 50, 70))
	end
	-- flickering sconces
	for _, z in { 612, 668, 722 } do
		sconce(f, V(-15.6, 12.4, z), 1, C(255, 230, 140))
	end
	for _, z in { 640, 712, 750 } do
		sconce(f, V(15.6, 12.4, z), -1, C(200, 150, 255))
	end
	-- door signs
	Props.SignBoard(f, V(-15.6, 14, 624), 12, 2.8, 1, 0, "📚 LIBRARY", C(45, 25, 80), C(255, 220, 120))
	Props.SignBoard(f, V(15.6, 14, 624), 12, 2.8, -1, 0, "🍕 CAFETERIA", C(45, 25, 80), C(150, 255, 140))
	Props.SignBoard(f, V(-15.6, 14.5, 690), 14, 2.6, 1, 0, "CLASS 1-A", C(45, 25, 80), C(255, 170, 220))
	Props.SignBoard(f, V(15.6, 14.5, 690), 14, 2.6, -1, 0, "CLASS 1-B", C(45, 25, 80), C(120, 220, 255))
	-- ghostly graffiti
	Props.Graffiti(f, V(-15.9, 12.3, 650), 10, 5, 1, 0, "BOO!", C(150, 255, 140), -6)
	Props.Graffiti(f, V(15.9, 12.3, 655), 14, 5, -1, 0, "NO RUNNING\n(FLOATING OK)", C(255, 150, 220), 4)
	Props.Graffiti(f, V(-15.9, 12.3, 740), 14, 5, 1, 0, "GHOSTS RULE", C(200, 140, 255), -3)
	Props.Graffiti(f, V(15.9, 12.3, 728), 12, 5, -1, 0, "HALL PASS?\nNAH.", C(120, 230, 255), 5)
	-- slime puddles (flat)
	local slime = Kit.Disc(f, -4, 662, 0.22, 6, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
	Kit.Emitter(slime, C(150, 255, 160), 1.5, 3, 0.4)
	Kit.Disc(f, 6, 721, 0.22, 4, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- LIBRARY + CAFETERIA
--==================================================================
local function shelf(f: Instance, a: Vector3, b: Vector3, faceAxis: string, faceSign: number)
	Kit.Box(f, a, b, C(120, 75, 55), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	for i = 0, 2 do
		local y = 1.4 + i * 3.1
		local col = Kit.Pick(Props.Colors.Book)
		if faceAxis == "X" then
			local x = if faceSign > 0 then hi.X else lo.X
			Kit.Box(f, V(x, y, lo.Z + 0.4), V(x + faceSign * 0.3, y + 2.3, hi.Z - 0.4), col)
		else
			local z = if faceSign > 0 then hi.Z else lo.Z
			Kit.Box(f, V(lo.X + 0.4, y, z), V(hi.X - 0.4, y + 2.3, z + faceSign * 0.3), col)
		end
	end
end

local function library(f: Instance)
	for z = 607, 638, 8.5 do
		shelf(f, V(-99, 0.15, z), V(-96, 11, z + 8), "X", 1)
	end
	for x = -93, -30, 9 do
		shelf(f, V(x, 0.15, 601), V(x + 8, 11, 604), "Z", 1)
	end
	for _, x in { -70, -45 } do
		Kit.Box(f, V(x - 6, 3, 621), V(x + 6, 3.6, 631), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
		Kit.Box(f, V(x - 1, 0.15, 624), V(x + 1, 3, 628), C(110, 70, 50))
		Kit.Cyl(f, 1.6, 0.3, CFrame.new(x + 3, 4.4, 626), C(70, 60, 80))
		Kit.Ball(f, 1.3, V(x + 3, 5.4, 626), C(150, 255, 140), { Mat = NEON })
	end
	local rng = Kit.Rng
	for _ = 1, 7 do
		Props.FloatingBook(f, V(rng:NextNumber(-90, -26), rng:NextNumber(6, 11), rng:NextNumber(608, 644)))
	end
	Props.Graffiti(f, V(-82, 11, 647.9), 16, 5, 0, -1, "SHHH!\nGHOSTS READING", C(150, 255, 140), -3)
end

local function cafeteria(f: Instance)
	-- counter + sneeze guard + menu
	Kit.Box(f, V(90, 0.15, 607), V(96, 4, 643), C(205, 205, 225), { Solid = true })
	local pans = { C(130, 255, 140), C(255, 160, 60), C(200, 120, 255), C(255, 110, 140) }
	for i = 0, 3 do
		Kit.Box(f, V(91, 4, 609 + i * 8.5), V(95, 4.5, 615 + i * 8.5), Kit.Vivid(pans[i + 1]))
	end
	Kit.Box(f, V(89.8, 4, 607), V(90.2, 7, 643), C(200, 240, 255), { Transp = 0.6 })
	local menuCF = faced(V(98.7, 11, 625), -1, 0)
	local menu = Kit.Part(f, V(26, 6, 0.4), menuCF, C(40, 30, 60))
	Kit.Part(f, V(27, 7, 0.2), menuCF * CFrame.new(0, 0, 0.3), Kit.Vivid(C(255, 160, 60)))
	Kit.Sign(menu, Enum.NormalId.Front, "TODAY: ECTO-LOAF\n& SCREAM PIE", C(150, 255, 140))
	-- long tables with benches and trays
	local trays = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	for _, x in { 35, 55, 75 } do
		Kit.Box(f, V(x - 2.5, 3, 610), V(x + 2.5, 3.6, 640), C(240, 240, 250), { Solid = true })
		Kit.Box(f, V(x - 0.5, 0.15, 612), V(x + 0.5, 3, 638), C(130, 130, 160))
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 3.6, 0.15, 611), V(x + s * 5, 2, 639), C(170, 110, 230), { Solid = true })
		end
		for i = 0, 3 do
			local s = if i % 2 == 0 then -1 else 1
			local tz = 614 + i * 7
			Kit.Box(f, V(x + s * 0.3, 3.6, tz - 0.8), V(x + s * 2.2, 3.85, tz + 0.8), trays[i + 1])
			Kit.Ball(f, 0.9, V(x + s * 1.25, 4.2, tz), Kit.Vivid(Kit.Pick(pans)))
		end
	end
	Props.Graffiti(f, V(35, 11, 647.9), 16, 5, 0, -1, "FOOD FIGHT\nAT MIDNIGHT", C(255, 170, 220), 4)
	Props.FloatingPumpkin(f, V(45, 10, 628))
end

--==================================================================
-- CLASSROOMS
--==================================================================
local function classroom(f: Instance, side: number, title: string, graffiti: string)
	-- side = -1 (west, Class 1-A) or +1 (east, Class 1-B); board on the outer wall
	local gx, gz, gr = side * 62, 690, 20
	local boardCF = faced(V(side * 98.7, 8.5, 705), -side, 0)
	local board = Kit.Part(f, V(30, 8, 0.4), boardCF, C(40, 95, 75))
	Kit.Part(f, V(31.6, 9.6, 0.3), boardCF * CFrame.new(0, 0, 0.3), C(150, 100, 60), { Mat = Enum.Material.WoodPlanks })
	Kit.Sign(board, Enum.NormalId.Front, title, C(235, 255, 235), { Stroke = C(30, 70, 55), Font = Enum.Font.FredokaOne })
	-- teacher's desk + apple
	local tx = side * 90.5
	Kit.Box(f, V(tx - 2.5, 0.15, 698), V(tx + 2.5, 3.6, 710), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Ball(f, 1.2, V(tx, 4.2, 702), C(255, 70, 80))
	-- student desks (facing the board), kept out of the ghost circle and doorways
	local desk, chair = C(255, 210, 120), C(130, 90, 220)
	for ax = 91, 31, -12 do
		local x = side * ax
		for z = 656, 752, 12 do
			local dx, dz = x - gx, z - gz
			local inCircle = dx * dx + dz * dz < (gr + 4) * (gr + 4)
			local teacher = ax >= 85 and z >= 690 and z <= 716
			local gymDoor = z >= 736 and math.abs(ax - 60) < 9
			local divDoor = z <= 660 and math.abs(ax - 60) < 9
			local hallDoor = ax <= 31 and z >= 672 and z <= 708
			if not (inCircle or teacher or gymDoor or divDoor or hallDoor) then
				local back = side -- chairs sit on the side away from the board
				Kit.Box(f, V(x - 1.5, 3, z - 1.4), V(x + 1.5, 3.4, z + 1.4), desk, { Solid = true })
				Kit.Box(f, V(x + side * 1.5, 0.15, z - 1.2), V(x + side * 1.1, 3, z + 1.2), desk:Lerp(C(0, 0, 0), 0.2))
				Kit.Box(f, V(x - back * 2, 1.8, z - 1.1), V(x - back * 4.2, 2.1, z + 1.1), chair)
				Kit.Box(f, V(x - back * 4, 0.15, z - 1.1), V(x - back * 4.3, 4.4, z + 1.1), chair)
			end
		end
	end
	-- floating books near the back of the room
	local rng = Kit.Rng
	for i = 0, 3 do
		Props.FloatingBook(f, V(side * (36 + i * 14), rng:NextNumber(9, 12), 745 + rng:NextNumber(-4, 6)))
	end
	sconce(f, V(side * 98.4, 12.4, 740), -side, C(150, 255, 160))
	Props.Graffiti(f, V(side * 85, 11, 760.9), 18, 5, 0, -1, graffiti, C(200, 140, 255), side * 4)
	Kit.Disc(f, side * 40, 735, 0.22, 5, 0.08, C(200, 130, 255), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- GYM
--==================================================================
local function gym(f: Instance)
	-- court lines (white paint) and the purple centre circle
	local line = C(255, 250, 240)
	Kit.Box(f, V(-0.3, 0.15, 765), V(0.3, 0.2, 857), line)
	for _, x in { -92, 92 } do
		Kit.Box(f, V(x - 0.3, 0.15, 768), V(x + 0.3, 0.2, 840), line)
	end
	for _, z in { 768, 840 } do
		Kit.Box(f, V(-92, 0.15, z - 0.3), V(92, 0.2, z + 0.3), line)
	end
	local circle = Kit.Vivid(C(200, 130, 255))
	for i = 0, 15 do
		local a = (i + 0.5) / 16 * math.pi * 2
		local p = V(math.cos(a) * 10, 0.17, 805 + math.sin(a) * 10)
		Kit.Part(f, V(0.6, 0.06, 4.4), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), circle)
	end
	-- hoops on the side walls
	local hoop = Kit.Vivid(C(255, 120, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 97.4, 9.5, 800.5), V(s * 97.9, 14.5, 809.5), WHITE)
		Kit.Box(f, V(s * 97.3, 10.6, 803.5), V(s * 97.4, 13, 806.5), hoop)
		Kit.Box(f, V(s * 97.9, 11.4, 804.6), V(s * 99, 12.2, 805.4), C(80, 80, 100))
		Kit.Disc(f, s * 95.4, 805, 10.3, 3.6, 0.3, hoop)
		Kit.Cyl(f, 2, 3.2, CFrame.new(s * 95.4, 9.1, 805), WHITE, { Transp = 0.5 })
	end
	-- bleachers along the back wall, split either side of the back exit (X -15..15 open)
	local cols = { C(95, 135, 205), C(235, 150, 70), C(240, 225, 195), C(150, 100, 220) }
	for i = 0, 3 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 15, 0.15, 842 + i * 4), V(s * 60, 1.6 * (i + 1) + 0.15, 859), cols[i + 1], { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		end
	end
	for k, px in { -50, -36, -22, 22, 36, 50 } do
		local i = (k - 1) % 4
		Props.Pumpkin(f, V(px, 1.6 * (i + 1) + 0.15, 844 + i * 4), 2.6, 0, -1)
	end
	-- back exit: cream door frame, EXIT sign on the lintel, path to Gate_Carnival
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 14 - 0.6, 0, 858.6), V(s * 14 + 0.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	end
	Kit.Box(f, V(-14.6, 12, 858.6), V(14.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	local exitSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 858.7), C(30, 60, 45))
	Kit.Part(f, V(25, 3.6, 0.2), CFrame.new(0, 14.2, 858.95), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(exitSign, Enum.NormalId.Front, "EXIT → CARNIVAL 🎡", C(170, 255, 160), { Stroke = C(20, 50, 30) })
	local backSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 861.3) * CFrame.Angles(0, math.pi, 0), C(30, 60, 45))
	Kit.Sign(backSign, Enum.NormalId.Front, "SPOOKY HIGH 🏫", C(255, 220, 120), { Stroke = C(20, 50, 30) })
	Kit.Box(f, V(-12, 0, 861), V(12, 0.05, 877), C(175, 165, 190), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "ExitPath" })
	local guide = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12 - 0.3, 0.05, 862), V(s * 12 + 0.3, 0.1, 876), guide)
	end
	Props.Pumpkin(f, V(-15.5, 0, 865), 2.6, 1, 0)
	Props.Pumpkin(f, V(15.5, 0, 865), 2.6, -1, 0)
	-- scoreboard (on the back wall over the west bleachers)
	local sbCF = CFrame.new(-40, 12.5, 858.5)
	local sb = Kit.Part(f, V(26, 6, 0.6), sbCF, C(30, 20, 50))
	Kit.Part(f, V(27.4, 7.4, 0.3), sbCF * CFrame.new(0, 0, 0.35), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sb, Enum.NormalId.Front, "HOME 0  •  GHOSTS 999", C(255, 210, 80), { Font = Enum.Font.GothamBlack })
	-- banners
	Props.SignBoard(f, V(-98.6, 10, 780), 14, 5, 1, 0, "GO GHOULS!", C(130, 70, 220), C(255, 220, 90))
	Props.SignBoard(f, V(-98.6, 10, 830), 14, 5, 1, 0, "TEAM SPIRIT\n(LITERALLY)", C(255, 120, 60), WHITE)
	Props.SignBoard(f, V(98.6, 10, 780), 14, 5, -1, 0, "SPIRIT WEEK", C(60, 170, 150), WHITE)
	Props.SignBoard(f, V(98.6, 10, 830), 14, 5, -1, 0, "BOO CREW", C(220, 70, 140), C(255, 230, 120))
	Props.Graffiti(f, V(-80, 11, 763.1), 18, 5, 0, 1, "DETENTION\nFOREVER", C(150, 255, 140), -4)
	sconce(f, V(-98.4, 13.5, 792), 1, C(255, 200, 120))
	sconce(f, V(98.4, 13.5, 818), -1, C(255, 200, 120))
	Props.FloatingPumpkin(f, V(-30, 13, 850))
	Props.FloatingPumpkin(f, V(30, 13, 850))
end

--==================================================================
-- COURTYARD
--==================================================================
local function courtyard(f: Instance)
	Kit.Box(f, V(-10, -0.4, 540), V(10, 0.1, 592), C(190, 175, 215), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.AddRect(-12, 540, 12, 600, true)
	Kit.AddRect(-104, 592, 104, 864)
	Kit.AddRect(-18, 860, 18, 880, true) -- back exit path to Gate_Carnival
	-- ghost bus
	local yellow = C(255, 205, 50)
	Kit.Box(f, V(55, 1.5, 566), V(85, 10.5, 578), yellow, SOLID)
	Kit.Box(f, V(55.5, 10.5, 566.5), V(84.5, 11.3, 577.5), C(255, 225, 120))
	Kit.Box(f, V(54.9, 5.5, 565.9), V(85.1, 6.1, 578.1), C(40, 30, 50))
	-- windows: warm pale yellow sides, glassy windshield (solid; too long to glow nicely)
	for _, z in { 565.8, 578.0 } do
		Kit.Box(f, V(58, 6.8, z), V(82, 9.6, z + 0.2), C(255, 240, 160), { Refl = 0.15 })
	end
	Kit.Box(f, V(54.8, 6.5, 567), V(55, 9.8, 577), Kit.Vivid(C(170, 230, 255)), { Transp = 0.2, Refl = 0.25 })
	for _, x in { 60, 80 } do
		for _, z in { 565.6, 578.4 } do
			Kit.CylFlat(f, 1.4, 4, V(x, 2, z), "Z", C(40, 35, 55))
		end
	end
	for _, z in { 568, 576 } do
		Kit.Box(f, V(54.7, 3, z - 0.8), V(54.9, 4.2, z + 0.8), C(255, 250, 200), { Mat = NEON })
	end
	local busSign = Kit.Box(f, V(62, 2.2, 565.6), V(78, 5.2, 565.9), yellow)
	Kit.Sign(busSign, Enum.NormalId.Front, "SPOOKY HIGH 👻", C(60, 30, 90), { Stroke = C(255, 255, 255) })
	Kit.AddCircle(70, 572, 17)
	-- flagpole
	Kit.Cyl(f, 26, 0.6, CFrame.new(28, 13, 590), C(220, 220, 235))
	Kit.Ball(f, 1.2, V(28, 26.4, 590), C(255, 210, 80), { Refl = 0.3 })
	local flag = Kit.Box(f, V(28.3, 20, 589.9), V(37, 25, 590.1), C(150, 80, 230))
	Kit.Sign(flag, Enum.NormalId.Front, "👻", WHITE)
	Kit.AddCircle(28, 590, 2)
	-- jack-o'-lanterns lining the path
	for z = 548, 590, 14 do
		for _, s in { -1, 1 } do
			Props.Pumpkin(f, V(s * 12.5, 0, z), 2.8, -s, 0, true)
		end
	end
	-- trees (courtyard and the strips around the building)
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(546, 874)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	local lampGlobe = C(210, 150, 255)
	Props.StreetLamp(f, V(-15, 0, 594), lampGlobe, true)
	Props.StreetLamp(f, V(15, 0, 594), lampGlobe, false)
end

function School.Build(map: Instance)
	local f = Kit.Folder(map, "School")
	courtyard(f)
	shell(f)
	clockTower(f)
	hallway(f)
	library(f)
	cafeteria(f)
	classroom(f, -1, "GHOST 101\nBOO = HELLO 👋", "NO HOMEWORK\nONLY HAUNTWORK")
	classroom(f, 1, "BOO-OLOGY\nCHAPTER 13 🕸️", "A+ IN\nSCARING")
	gym(f)
end

return School
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">SpiritRealm</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 8: Spirit Realm (Z 2280..2680), the endgame: "you have entered another dimension".
--   Play area (|X| <= 140): a dark translucent "void glass" floor (top Y = 0, no holes) with
--   flat-topped floating islands of dark slate (tops Y 0.04..0.06) sunk into it; their glowing
--   lips and rocky undersides show through the glass, with stars and nebula far below.
--   Rune path along X = 0 (flat, top 0.08) from the gate to the portal platform at the back.
--   Ghost areas (0,2365) r30, (-82,2400) r24, (75,2470) r26, (-62,2530) r24 and the boss
--   SPIRIT OVERLORD at (0,2605) r28 hold only flat paint; nothing stands in or hangs above them.
--   Side walls: crystal-capped rock ridges at X +-140..146 (Z 2283..2677).
--   Back (Z 2645..2677): a huge portal arch the path walks through; it frames the Swamp gate.
--   Outside the walls: open void with floating islands, spirit trees, crystals, waterfalls
--   pouring into nothing, broken bridges, distant islands, cloud banks and a ringed planet.
--   Glow: island lips, path edge runes, wall crystal tips, a few crystals, tree spirit-orbs,
--   portal runes and stars. Rock, ruins, trunks and most crystals are solid/glass.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local SpiritRealm = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local ROCK = Enum.Material.Rock
local SLATE = Enum.Material.Slate
local GLASS = Enum.Material.Glass
local WOOD = Enum.Material.Wood

local Z0, Z1 = 2280, 2680
local W = 146 -- outer face of the side walls

local ROCKS = { C(44, 38, 70), C(36, 34, 60), C(52, 44, 82), C(32, 36, 58) }
local LIPS = { C(150, 100, 255), C(80, 210, 255), C(110, 240, 190), C(120, 140, 255) }
local CRYSTAL = { C(160, 110, 255), C(90, 200, 255), C(120, 235, 200), C(195, 140, 255) }
local LEAVES = { C(80, 210, 255), C(160, 105, 255), C(110, 240, 200), C(130, 150, 255) }
local RUIN = C(82, 76, 112)
local RUIN_DARK = C(56, 50, 84)
local BARK = C(34, 28, 46)
local BLACK = C(0, 0, 0)

local function clearOfGhosts(x: number, z: number, r: number): boolean
	for _, a in Config.Layout.GhostAreas do
		local dx, dz = x - a.Center.X, z - a.Center.Z
		local rr = a.Radius + r
		if dx * dx + dz * dz < rr * rr then
			return false
		end
	end
	return true
end

--==================================================================
-- PIECES
--==================================================================

-- Floating island: flat slate top at topY, a glowing lip just under the top edge and a
-- rocky underside tapering into the void.
local function island(f: Instance, x: number, z: number, topY: number, d: number, solid: boolean, lip: boolean): Part
	local rock = Kit.Pick(ROCKS)
	local top = Kit.Disc(f, x, z, topY, d, 3, rock, { Mat = SLATE, Solid = solid, Shadow = true })
	if lip then
		Kit.Disc(f, x, z, topY - 0.5, d + 1.6, 0.8, Kit.Pick(LIPS), { Mat = NEON })
	end
	local under = rock:Lerp(BLACK, 0.2)
	Kit.Disc(f, x, z, topY - 3, d * 0.84, 5, under, { Mat = ROCK })
	Kit.Disc(f, x + d * 0.04, z, topY - 8, d * 0.58, 7, under:Lerp(BLACK, 0.2), { Mat = ROCK })
	Kit.Disc(f, x - d * 0.03, z + d * 0.03, topY - 15, d * 0.3, 9, under:Lerp(BLACK, 0.35), { Mat = ROCK })
	Kit.Ball(f, d * 0.17, V(x, topY - 23, z), under:Lerp(BLACK, 0.45), { Mat = ROCK })
	return top
end

-- Crystal prism with a diamond tip, leaning by (tiltX, tiltZ). Neon only when asked;
-- otherwise translucent glass in a vivid colour.
local function shard(parent: Instance, base: Vector3, h: number, w: number, tiltX: number, tiltZ: number, color: Color3, neon: boolean): Part
	local cf = CFrame.new(base) * CFrame.Angles(tiltX, 0, tiltZ) * CFrame.Angles(0, Kit.Rng:NextNumber(0, math.pi), 0)
	local opts: Kit.Opts = if neon then { Mat = NEON } else { Mat = GLASS, Transp = 0.2, Refl = 0.2 }
	local col = if neon then color else Kit.Vivid(color)
	local body = Kit.Part(parent, V(w, h, w), cf * CFrame.new(0, h / 2, 0), col, opts)
	Kit.Part(parent, V(w * 0.72, w * 0.72, w * 0.72), cf * CFrame.new(0, h, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), col, opts)
	return body
end

-- Cluster of crystals on a dark rock base; returns the big central crystal.
local function crystalCluster(parent: Instance, pos: Vector3, scale: number, neonMain: boolean): Part
	local rng = Kit.Rng
	local col = Kit.Pick(CRYSTAL)
	Kit.Part(parent, V(5, 2.2, 4.4) * scale, CFrame.new(pos + V(0, 0.5 * scale, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0.12), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
	local main = shard(parent, pos, 12 * scale, 2.6 * scale, rng:NextNumber(-0.1, 0.1), rng:NextNumber(-0.1, 0.1), col, neonMain)
	for k = 1, 3 do
		local a = k * 2.1 + rng:NextNumber(-0.3, 0.3)
		local t = rng:NextNumber(0.25, 0.45)
		local p = pos + V(math.cos(a), 0, math.sin(a)) * (1.7 * scale)
		shard(parent, p, rng:NextNumber(4.5, 8) * scale, rng:NextNumber(1.2, 1.8) * scale, math.sin(a) * t, -math.cos(a) * t, Kit.Pick(CRYSTAL), false)
	end
	return main
end

-- Enormous spirit tree: twisted dark trunk, roots, four branches with glowing leaf clusters
-- (solid translucent colour) and one small Neon spirit-orb. Returns the orb.
local function spiritTree(parent: Instance, pos: Vector3, height: number): Part
	local rng = Kit.Rng
	local pts = { pos }
	local seg = height / 4
	for i = 1, 4 do
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1, 2.5)
		table.insert(pts, pts[i] + V(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 4 do
		local w = 4.6 - i * 0.85
		Props.Beam(parent, pts[i], pts[i + 1], w, w, BARK, { Mat = WOOD, Solid = i == 1, Shadow = true })
	end
	for r = 0, 2 do
		local a = r * 2.1 + rng:NextNumber(-0.3, 0.3)
		Props.Beam(parent, pos + V(0, 2.6, 0), pos + V(math.cos(a) * 5.5, -0.3, math.sin(a) * 5.5), 1.4, 1.4, BARK, { Mat = WOOD })
	end
	local s = height / 40
	local top = pts[5]
	local crown = Kit.Pick(LEAVES)
	Kit.Ball(parent, 12 * s, top + V(0, 1.5, 0), Kit.Vivid(crown), { Transp = 0.12, Shadow = true })
	for b = 1, 4 do
		local from = pts[3 + (b % 2)]
		local ang = b * 1.57 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.2, 0.28)
		local tip = from + V(math.cos(ang) * len, len * 0.5, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 1.2, 1.2, BARK, { Mat = WOOD })
		Kit.Ball(parent, rng:NextNumber(7, 9.5) * s, tip, Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.15 })
	end
	local orb = Kit.Ball(parent, 3.2 * s, top + V(0, -4.5 * s, 0), crown:Lerp(C(255, 255, 255), 0.3), { Mat = NEON })
	return orb
end

-- Falling water pouring off an edge into the void: a translucent sheet facing X plus a paler
-- core streak and a misty lip.
local function waterfall(parent: Instance, top: Vector3, width: number, len: number, mist: boolean)
	local cf = CFrame.new(top - V(0, len / 2, 0))
	Kit.Part(parent, V(1.2, len, width), cf, C(110, 180, 255), { Mat = GLASS, Transp = 0.45, Refl = 0.1, Name = "Waterfall" })
	Kit.Part(parent, V(1.6, len, width * 0.4), cf, C(205, 235, 255), { Transp = 0.6 })
	local lip = Kit.Part(parent, V(3, 0.8, width + 1), CFrame.new(top + V(0, 0.2, 0)), C(170, 220, 255), { Transp = 0.35 })
	if mist then
		Kit.Emitter(lip, C(190, 225, 255), 4, 7, 1.2)
	end
end

local function brokenColumn(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	Kit.Box(parent, V(x - 2.2, 0, z - 2.2), V(x + 2.2, 1.2, z + 2.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	local h = rng:NextNumber(4, 17)
	Kit.Cyl(parent, h, 3, CFrame.new(x, 1.2 + h / 2, z), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
	if h > 13 then
		Kit.Box(parent, V(x - 2.2, 1.2 + h, z - 2.2), V(x + 2.2, 2.6 + h, z + 2.2), RUIN_DARK, { Mat = SLATE })
	else
		Kit.Part(parent, V(2.4, 1.4, 2.4), CFrame.new(x, 1.6 + h, z) * CFrame.Angles(0.35, rng:NextNumber(0, 3), 0.25), RUIN, { Mat = SLATE })
		if rng:NextNumber() < 0.5 then
			Kit.CylFlat(parent, 4, 3, V(x + 2.2, 1.5, z + 2.4), "X", RUIN, { Mat = SLATE, Solid = true })
		end
	end
end

local function brokenArch(parent: Instance, x: number, z: number, yaw: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0)
	local o: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }
	Kit.Part(parent, V(3, 18, 3), base * CFrame.new(-7, 9, 0), RUIN, o)
	Kit.Part(parent, V(3, 11, 3), base * CFrame.new(7, 5.5, 0), RUIN, o)
	Kit.Part(parent, V(3, 2, 3), base * CFrame.new(7, 11.6, 0) * CFrame.Angles(0, 0, 0.4), RUIN_DARK, { Mat = SLATE })
	Kit.Part(parent, V(10, 3, 3.2), base * CFrame.new(-3.2, 19.3, 0) * CFrame.Angles(0, 0, -0.08), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Part(parent, V(6, 3, 3), base * CFrame.new(9.5, 1.3, 5) * CFrame.Angles(0.25, 0.6, 0.1), RUIN_DARK, o)
	-- faint rune carved on the standing pillar
	Kit.Part(parent, V(1.2, 1.2, 0.2), base * CFrame.new(-7, 12, -1.55) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(C(120, 220, 255)))
	Kit.AddCircle(x, z, 10)
end

local function temple(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "AncientTemple")
	Kit.Box(m, V(x - 13, 0, z - 11), V(x + 13, 0.9, z + 11), RUIN_DARK, { Mat = SLATE, Solid = true })
	Kit.Box(m, V(x - 10, 0.9, z - 8), V(x + 10, 1.8, z + 8), RUIN, { Mat = SLATE, Solid = true })
	local rng = Kit.Rng
	for _, cx in { -8, 8 } do
		for _, cz in { -6, 0, 6 } do
			local intact = cz >= 0
			local h = if intact then 14 else rng:NextNumber(4, 9)
			Kit.Cyl(m, h, 2.6, CFrame.new(x + cx, 1.8 + h / 2, z + cz), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
		end
	end
	Kit.Box(m, V(x - 9.6, 15.8, z - 1.6), V(x + 9.6, 17.4, z + 7.6), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Wedge(m, V(19.2, 4, 4.6), CFrame.new(x, 19.4, z + 5.3) * CFrame.Angles(0, math.pi, 0), RUIN_DARK, { Mat = SLATE })
	Kit.Part(m, V(9, 1.6, 4), CFrame.new(x + 3, 2.4, z - 9) * CFrame.Angles(0.15, 0.4, -0.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	-- altar with a spirit flame
	Kit.Box(m, V(x - 1.6, 1.8, z - 4.6), V(x + 1.6, 4.4, z - 1.4), C(70, 62, 102), { Mat = SLATE, Solid = true })
	local flame = Kit.Ball(m, 1.8, V(x, 5.3, z - 3), C(140, 255, 210), { Mat = NEON })
	Kit.Light(flame, C(140, 255, 210), 26, 1.6, true)
	Kit.AddCircle(x, z, 15)
end

local function monolithRing(parent: Instance, mx: number, mz: number)
	local rng = Kit.Rng
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local p = V(mx + math.cos(a) * 9, 0, mz + math.sin(a) * 9)
		local h = rng:NextNumber(7, 12)
		local cf = CFrame.new(p) * CFrame.Angles(0, Kit.FaceYaw(mx - p.X, mz - p.Z), 0) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
		Kit.Part(parent, V(2.8, h, 1.8), cf * CFrame.new(0, h / 2 - 0.3, 0), RUIN_DARK, { Mat = SLATE, Solid = true, Shadow = true })
	end
	Kit.Disc(parent, mx, mz, 0.1, 9, 0.06, Kit.Vivid(C(150, 100, 255)))
	Kit.Disc(parent, mx, mz, 0.13, 3.2, 0.06, C(150, 240, 255), { Mat = NEON })
	Kit.AddCircle(mx, mz, 12)
end

-- Flat ring of paint segments.
local function paintRing(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.3
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.03, cz + math.sin(a) * r)
		Kit.Part(parent, V(w, 0.06, segLen), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), color)
	end
end

--==================================================================
-- SECTIONS
--==================================================================
local function ground(f: Instance)
	-- void glass: walkable everywhere in the play area, dark and see-through
	Kit.Box(f, V(-W, -1, Z0), V(W, 0, Z1), C(16, 12, 34), { Solid = true, Transp = 0.3, Refl = 0.15, Name = "VoidGlass" })
	-- islands sunk into the glass (tops alternate 0.04 / 0.06 so overlaps never flicker)
	local islands = {
		{ 0, 2320, 92, 0.04 }, { 6, 2382, 70, 0.06 }, { -82, 2400, 66, 0.06 }, { 92, 2352, 46, 0.04 },
		{ 75, 2470, 70, 0.04 }, { -20, 2462, 40, 0.06 }, { -62, 2530, 66, 0.04 }, { 60, 2562, 42, 0.04 },
		{ 0, 2605, 90, 0.06 }, { -106, 2612, 36, 0.04 }, { 102, 2640, 34, 0.04 }, { -108, 2322, 40, 0.06 },
		{ 0, 2658, 60, 0.04 },
	}
	for _, i in islands do
		island(f, i[1], i[2], i[4], i[3], true, true)
	end
	-- starfield and nebula far below the glass
	local rng = Kit.Rng
	for _ = 1, 12 do
		Kit.Ball(f, rng:NextNumber(0.6, 1.4), V(rng:NextNumber(-135, 135), rng:NextNumber(-110, -35), rng:NextNumber(Z0 + 10, Z1 - 10)), Kit.Pick({ C(220, 230, 255), C(180, 150, 255), C(150, 240, 255) }), { Mat = NEON })
	end
	local nebula = { V(-180, -200, 2400), V(200, -230, 2560), V(0, -260, 2480) }
	local nebulaCol = { C(90, 50, 160), C(40, 80, 160), C(40, 120, 130) }
	for k, n in nebula do
		Kit.Disc(f, n.X, n.Z, n.Y, 520, 2, nebulaCol[k], { Transp = 0.55 })
	end
end

local function runePath(f: Instance)
	local z2 = 2648
	Kit.Box(f, V(-5, 0.02, Z0 + 3), V(5, 0.08, z2), C(40, 36, 68), { Mat = SLATE, Solid = true, Name = "RunePath" })
	local edge = C(120, 210, 255)
	for z = Z0 + 10, z2 - 14, 28 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 5, 0.02, z), V(s * 5.6, 0.1, z + 14), edge, { Mat = NEON })
		end
	end
	local glyph = C(190, 140, 255)
	for z = Z0 + 30, z2 - 10, 48 do
		Kit.Part(f, V(1.8, 0.04, 1.8), CFrame.new(0, 0.1, z) * CFrame.Angles(0, math.pi / 4, 0), glyph, { Mat = NEON })
	end
	-- painted (solid) dashes between the glyphs
	local dash = Kit.Vivid(C(130, 110, 220))
	for z = Z0 + 54, z2 - 10, 48 do
		Kit.Box(f, V(-0.3, 0.08, z - 4), V(0.3, 0.1, z + 4), dash)
	end
end

local function bossRing(f: Instance)
	local cx, cz = 0, 2605
	paintRing(f, cx, cz, 31, 28, 1.2, Kit.Vivid(C(150, 100, 255)), 0.12)
	paintRing(f, cx, cz, 20, 20, 0.8, Kit.Vivid(C(90, 200, 255)), 0.12)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Kit.Disc(f, cx + math.cos(a) * 33, cz + math.sin(a) * 33, 0.14, 2.4, 0.06, C(170, 240, 255), { Mat = NEON })
	end
end

local function portal(f: Instance)
	-- A horseshoe arch the main path walks through: it frames the Swamp gate (Z 2680) and the
	-- swamp beyond, so the "glimpse of the next destination" is the real next zone.
	local m = Kit.Model(f, "SpiritPortal")
	local cy, pz, R = 30, 2666, 32
	Kit.Box(m, V(-40, 0, 2648), V(40, 0.8, 2677), C(48, 42, 78), { Mat = SLATE, Solid = true })
	Kit.Box(m, V(-36, 0.8, 2654), V(36, 1.4, 2676), C(60, 52, 92), { Mat = SLATE, Solid = true })
	-- stone ring (upper part only) + a shimmering inner band
	local n = 28
	local segLen = 2 * math.pi * R / n + 0.6
	local inner = R - 4.5
	local innerLen = 2 * math.pi * inner / n + 0.4
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		if math.sin(a) > -0.45 then
			local pos = V(math.cos(a) * R, cy + math.sin(a) * R, pz)
			Kit.Part(m, V(segLen, 4.5, 4), CFrame.new(pos) * CFrame.Angles(0, 0, a + math.pi / 2), if i % 2 == 0 then C(52, 44, 84) else C(40, 36, 66), { Mat = SLATE, Shadow = true })
			if i % 4 == 1 then
				Kit.Part(m, V(1.4, 1.4, 0.3), CFrame.new(pos.X, pos.Y, pz - 2.1) * CFrame.Angles(0, 0, math.pi / 4), C(150, 240, 255), { Mat = NEON })
			end
			local ip = V(math.cos(a) * inner, cy + math.sin(a) * inner, pz)
			Kit.Part(m, V(innerLen, 1.6, 1), CFrame.new(ip) * CFrame.Angles(0, 0, a + math.pi / 2), if i % 2 == 0 then C(160, 90, 255) else C(80, 220, 255), { Mat = Enum.Material.ForceField, Transp = 0.2 })
		end
	end
	-- legs carrying the arch down to the platform (outside the gate opening)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 25.5, 1.4, pz - 2.5), V(s * 31.5, 18, pz + 2.5), C(44, 38, 70), { Mat = ROCK, Solid = true, Shadow = true })
		Kit.Box(m, V(s * 25, 1.4, pz - 3), V(s * 32, 4, pz + 3), RUIN_DARK, { Mat = SLATE, Solid = true })
	end
	-- glowing keystone with the portal light and sparkles drifting down through the arch
	local key = Kit.Part(m, V(5, 5, 5), CFrame.new(0, cy + R - 6, pz - 1) * CFrame.Angles(0, 0, math.pi / 4), C(225, 210, 255), { Transp = 0.2 })
	Kit.Light(key, C(190, 150, 255), 60, 2)
	Kit.Emitter(key, C(200, 160, 255), 5, 5, 2.5)
	-- flanking obelisks with crystal tips
	for _, s in { -1, 1 } do
		local x = s * 43
		Kit.Box(m, V(x - 2.5, 0, 2657.5), V(x + 2.5, 2, 2662.5), RUIN_DARK, { Mat = SLATE, Solid = true })
		Kit.Box(m, V(x - 1.8, 2, 2658.2), V(x + 1.8, 28, 2661.8), C(48, 42, 78), { Mat = SLATE, Solid = true, Shadow = true })
		shard(m, V(x, 28, 2660), 6, 2.2, 0, 0, if s < 0 then C(170, 110, 255) else C(90, 220, 255), true)
	end
	-- two rocks drifting around the portal
	for _, s in { -1, 1 } do
		local rock = Kit.Part(m, V(6, 4.5, 5), CFrame.new(s * 52, 30 + s * 6, 2655) * CFrame.Angles(0.4, s * 0.7, 0.3), Kit.Pick(ROCKS), { Mat = ROCK, Name = "FloatingRock" })
		Kit.Float(rock, 1.6)
	end
	Kit.AddRect(-47, 2645, 47, 2678)
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local zA, zB = Z0 + 3, Z1 - 3
	local n = 10
	local len = (zB - zA) / n
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local z = zA + i * len
			local h = rng:NextNumber(8, 13)
			Kit.Box(f, V(s * 140, -26, z), V(s * W, h, z + len), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
			for k = 1, 2 do
				local cz = z + len * (k / 3) + rng:NextNumber(-3, 3)
				local lean = rng:NextNumber(0.1, 0.35)
				shard(f, V(s * 143, h - 0.5, cz), rng:NextNumber(5, 10), rng:NextNumber(1.6, 2.4), rng:NextNumber(-0.2, 0.2), -s * lean, Kit.Pick(CRYSTAL), k == 1 and i % 4 == 1)
			end
		end
	end
end

local function insideScenery(f: Instance)
	local rng = Kit.Rng
	temple(f, 105, 2545)
	if Kit.IsFree(-104, 2345, 12) then
		monolithRing(f, -104, 2345)
	end
	-- broken arches beside the path
	local arches = { { -45, 2330, 0.3 }, { 48, 2412, -0.4 }, { -28, 2495, 0.2 }, { 40, 2525, -0.2 }, { -100, 2478, 1.2 } }
	local placed = 0
	for _, a in arches do
		if placed < 3 and Kit.IsFree(a[1], a[2], 10) then
			placed += 1
			brokenArch(f, a[1], a[2], a[3])
		end
	end
	-- entry pylons flanking the path just past the gate
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 13, 2318, 3, true) then
			local c = crystalCluster(f, V(s * 13, 0, 2318), 0.9, s > 0)
			if s > 0 then
				Kit.Light(c, C(120, 230, 255), 30, 1.5)
			else
				Kit.Emitter(c, C(170, 140, 255), 2, 2.5, 0.8)
			end
			Kit.AddCircle(s * 13, 2318, 4)
		end
	end
	-- enormous spirit trees along the edges (crowns kept clear of the ghost areas)
	local trees = { { -120, 2296, 42 }, { 120, 2298, 38 }, { -122, 2445, 44 }, { 124, 2395, 40 }, { 122, 2600, 42 }, { -124, 2566, 38 }, { 118, 2510, 34 } }
	local lit = 0
	for _, t in trees do
		if Kit.IsFree(t[1], t[2], 5) and clearOfGhosts(t[1], t[2], 19) then
			local orb = spiritTree(f, V(t[1], 0, t[2]), t[3])
			lit += 1
			if lit <= 2 then
				Kit.Light(orb, orb.Color, 28, 1.3)
			end
			Kit.AddCircle(t[1], t[2], 6)
		end
	end
	-- giant spectral crystal clusters
	local clusters, lights = 0, 0
	for _ = 1, 300 do
		if clusters >= 9 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 45)
		if math.abs(x) > 14 and Kit.IsFree(x, z, 6) then
			clusters += 1
			local neon = clusters % 2 == 1
			local main = crystalCluster(f, V(x, 0, z), rng:NextNumber(0.9, 1.4), neon)
			if neon and lights < 3 then
				lights += 1
				Kit.Light(main, main.Color, 26, 1.4)
			end
			Kit.AddCircle(x, z, 6)
		end
	end
	-- broken colonnade lining the path
	for z = Z0 + 46, 2640, 30 do
		for _, s in { -1, 1 } do
			local x = s * rng:NextNumber(17, 24)
			if Kit.IsFree(x, z, 5) then
				brokenColumn(f, x, z)
				Kit.AddCircle(x, z, 4)
			end
		end
	end
	-- loose boulders
	local boulders = 0
	for _ = 1, 200 do
		if boulders >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 40)
		if Kit.IsFree(x, z, 3) then
			boulders += 1
			local sz = V(rng:NextNumber(2, 4.5), rng:NextNumber(1.5, 3), rng:NextNumber(2, 4.5))
			Kit.Part(f, sz, CFrame.new(x, sz.Y * 0.35, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
			Kit.AddCircle(x, z, 3)
		end
	end
	-- floating ruin pieces and crystals (never over a ghost area)
	local floats = 0
	for _ = 1, 300 do
		if floats >= 8 then
			break
		end
		local x, z = rng:NextNumber(-125, 125), rng:NextNumber(Z0 + 40, Z1 - 50)
		if math.abs(x) > 12 and Kit.IsFree(x, z, 6) then
			floats += 1
			local y = rng:NextNumber(9, 18)
			local cf = CFrame.new(x, y, z) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5))
			local p: Part
			if floats <= 2 then
				p = Kit.Part(f, V(1.8, 6, 1.8), cf, Kit.Vivid(Kit.Pick(CRYSTAL)), { Mat = GLASS, Transp = 0.15, Refl = 0.2, Name = "FloatingCrystal" })
			elseif floats % 2 == 0 then
				p = Kit.Part(f, V(3, 5, 3), cf, RUIN, { Mat = SLATE, Shape = Enum.PartType.Cylinder, Name = "FloatingColumn" })
			else
				p = Kit.Part(f, V(4, 2.4, 3), cf, RUIN_DARK, { Mat = SLATE, Name = "FloatingBlock" })
			end
			Kit.Float(p, rng:NextNumber(0.8, 1.6))
		end
	end
end

local function outsideScenery(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Void")
	-- floating islands just beyond the walls: { x, z, topY, d, content, waterfall? }
	type Outer = { x: number, z: number, y: number, d: number, kind: string, falls: boolean }
	local outer: { Outer } = {
		{ x = -186, z = 2322, y = 6, d = 44, kind = "tree", falls = true },
		{ x = -206, z = 2420, y = -2, d = 52, kind = "crystal", falls = false },
		{ x = -182, z = 2522, y = 10, d = 36, kind = "ruin", falls = true },
		{ x = -214, z = 2622, y = 2, d = 50, kind = "tree", falls = false },
		{ x = 190, z = 2342, y = 2, d = 50, kind = "crystal", falls = true },
		{ x = 182, z = 2450, y = 12, d = 34, kind = "tree", falls = false },
		{ x = 210, z = 2552, y = -4, d = 56, kind = "ruin", falls = true },
		{ x = 188, z = 2652, y = 8, d = 40, kind = "crystal", falls = false },
	}
	local mist = false
	local litOuter = false
	for _, i in outer do
		island(o, i.x, i.z, i.y, i.d, false, true)
		local top = V(i.x, i.y, i.z)
		if i.kind == "tree" then
			spiritTree(o, top, rng:NextNumber(30, 40))
		elseif i.kind == "crystal" then
			local c = crystalCluster(o, top, 1.8, not litOuter)
			if not litOuter then
				litOuter = true
				Kit.Light(c, c.Color, 40, 1.6)
			end
			crystalCluster(o, top + V(i.d * 0.25, 0, i.d * 0.2), 0.9, false)
		else
			for k = 0, 2 do
				local h = 8 + k * 4
				Kit.Cyl(o, h, 3.2, CFrame.new(i.x - 8 + k * 8, i.y + h / 2, i.z - 6 + k * 3), RUIN, { Mat = SLATE })
			end
			Kit.Part(o, V(14, 2.4, 3.4), CFrame.new(i.x, i.y + 17, i.z) * CFrame.Angles(0, 0.3, 0.2), RUIN_DARK, { Mat = SLATE })
		end
		if i.falls then
			local s = if i.x < 0 then -1 else 1
			-- pours off the island edge that faces the play area
			-- (offset in Z so it never lands on a bridge)
			waterfall(o, V(i.x - s * (i.d / 2 - 2), i.y, i.z + i.d * 0.22), rng:NextNumber(7, 10), 170, not mist)
			mist = true
		end
	end
	-- broken bridges from the walls to two islands
	local bridges = { { -1, 2322, 6, 186 - 22 }, { 1, 2450, 12, 182 - 17 } }
	for _, b in bridges do
		local s, z, y, reach = b[1], b[2], b[3], b[4]
		local slabs = math.floor((reach - W) / 4.5)
		for k = 0, slabs - 1 do
			if k ~= 2 then
				local x = s * (W + 2.25 + k * 4.5)
				local cf = CFrame.new(x, y - 0.6, z)
				if k == slabs - 1 then
					cf = CFrame.new(x, y - 4, z + 1) * CFrame.Angles(0.3, 0, s * 0.5)
				end
				Kit.Part(o, V(4.2, 1.2, 7), cf, RUIN, { Mat = SLATE })
				if k % 2 == 0 then
					Kit.Box(o, V(x - 0.4, y, z + 3), V(x + 0.4, y + 3.5, z + 3.8), RUIN_DARK, { Mat = SLATE })
				end
			end
		end
	end
	-- loose rocks hanging in the void
	for _ = 1, 12 do
		local s = if rng:NextNumber() < 0.5 then -1 else 1
		local sz = V(rng:NextNumber(4, 12), rng:NextNumber(3, 8), rng:NextNumber(4, 12))
		Kit.Part(o, sz, CFrame.new(s * rng:NextNumber(160, 290), rng:NextNumber(-30, 45), rng:NextNumber(Z0, Z1 + 40)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)), Kit.Pick(ROCKS), { Mat = ROCK })
	end
	-- distant islands (low detail silhouettes)
	local far = { { -340, 2330, 30, 120 }, { -410, 2520, 55, 150 }, { -330, 2690, 20, 100 }, { 350, 2300, 45, 130 }, { 420, 2480, 25, 150 }, { 340, 2660, 60, 110 } }
	for _, d in far do
		local x, z, y, dia = d[1], d[2], d[3], d[4]
		Kit.Disc(o, x, z, y, dia, 6, C(40, 34, 66), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 6, dia * 0.7, 12, C(30, 26, 50), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 18, dia * 0.36, 18, C(22, 20, 40), { Mat = ROCK })
		Props.Beam(o, V(x, y, z), V(x + 4, y + 30, z), 4, 4, BARK, { Mat = WOOD })
		Kit.Ball(o, 22, V(x + 4, y + 34, z), Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.25 })
	end
	-- cloud banks and a ringed planet in a strange sky
	local clouds = {
		{ -260, 2300, 90, 160 }, { -420, 2460, 130, 220 }, { -300, 2640, 110, 180 }, { 280, 2340, 120, 200 },
		{ 440, 2560, 95, 230 }, { 260, 2700, 140, 170 }, { 0, 2820, 120, 260 }, { -150, 2800, 80, 150 },
		{ 160, 2790, 70, 150 }, { 0, 2250, 170, 200 },
	}
	for i, c in clouds do
		local col = if i % 2 == 0 then C(120, 90, 200) else C(80, 120, 210)
		Kit.Cyl(o, rng:NextNumber(6, 12), c[4], CFrame.new(c[1], c[3], c[2]) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)), col, { Transp = 0.75 })
	end
	local planet = V(-520, 230, 2760)
	Kit.Ball(o, 220, planet, C(110, 80, 180), { Transp = 0.15 })
	Kit.Cyl(o, 1, 400, CFrame.new(planet) * CFrame.Angles(0.35, 0, 0.25), C(170, 150, 230), { Transp = 0.65 })
	Kit.Ball(o, 60, V(480, 190, 2480), C(150, 220, 235), { Transp = 0.1 })
end

function SpiritRealm.Build(map: Instance)
	local f = Kit.Folder(map, "SpiritRealm")
	ground(f)
	runePath(f)
	bossRing(f)
	portal(f)
	sideWalls(f)
	insideScenery(f)
	outsideScenery(f)
end

return SpiritRealm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[--!strict
-- Crate stations (workspace.Map.Stations.CrateStation_<id>) and the upgrade booth
-- (workspace.Map.Stations.UpgradeStation). Stations sit beside the main path (X = 0);
-- their PromptAnchor and the OddsBoard's Front face point toward the path.
-- Pads, frames and trims are solid candy colours; the glow is kept to the arch lamps, the
-- corner jack-o'-lanterns and a couple of gadget lights.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Stations = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WHITE = C(255, 255, 255)

local function anchors(m: Model, x: number, z: number, dir: number)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x, 4, z), WHITE, { Name = "DisplaySlot", Transp = 1 })
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })
end

local function pad(m: Model, x: number, z: number, color: Color3, trim: Color3): Part
	local ring = Kit.Vivid(trim)
	Kit.Disc(m, x, z, 0.6, 16.5, 0.6, ring)
	local p = Kit.Disc(m, x, z, 1, 14, 1, color, { Name = "Pad", Solid = true })
	Kit.Disc(m, x, z, 1.12, 9, 0.2, ring)
	Kit.Disc(m, x, z, 1.18, 6, 0.2, color:Lerp(WHITE, 0.3))
	return p
end

local function crateStation(folder: Instance, crate: Config.CrateDef, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1 -- toward the path
	local m = Kit.Model(folder, "CrateStation_" .. crate.Id)
	local padPart = pad(m, x, z, crate.Color, crate.Trim)
	anchors(m, x, z, dir)
	local trim = Kit.Vivid(crate.Trim)

	-- Odds board behind the pad, Front face toward the path.
	local yaw = Kit.FaceYaw(dir, 0)
	local boardCF = CFrame.new(x - dir * 9.5, 7, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(m, V(12, 9, 0.6), boardCF, C(35, 22, 60), { Name = "OddsBoard", Solid = true })
	Kit.Part(m, V(13.4, 10.4, 0.5), boardCF * CFrame.new(0, 0, 0.45), trim)
	Kit.Part(m, V(14.2, 1.8, 1.2), boardCF * CFrame.new(0, 5.6, 0.3), crate.Color)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 2.6, 1), boardCF * CFrame.new(sx * 5, -5.8, 0.4), crate.Color:Lerp(C(0, 0, 0), 0.3), { Solid = true })
		Kit.Ball(m, 1.6, (boardCF * CFrame.new(sx * 7.1, 5.6, 0.3)).Position, trim)
	end

	-- Arch over the back half of the pad with the crate's name facing the path; the two
	-- orbs on top are its lamps (the beam carries the light).
	local ax = x - dir * 3
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(ax - 1.3, 0, z + sz * 9.5 - 1.3), V(ax + 1.3, 15, z + sz * 9.5 + 1.3), crate.Color, { Solid = true })
		Kit.Box(m, V(ax - 1.6, 0, z + sz * 9.5 - 1.6), V(ax + 1.6, 1.4, z + sz * 9.5 + 1.6), trim)
		Kit.Ball(m, 3, V(ax, 18.4, z + sz * 10.5), crate.Trim, { Mat = NEON })
	end
	local beam = Kit.Box(m, V(ax - 1.5, 15, z - 11.5), V(ax + 1.5, 17, z + 11.5), crate.Color:Lerp(WHITE, 0.15))
	Kit.Light(beam, crate.Trim, 18, 1.8)
	local signCF = CFrame.new(ax, 19, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(20, 4, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(21, 5, 0.4), signCF * CFrame.new(0, 0, 0.4), trim)
	Kit.Sign(sign, Enum.NormalId.Front, crate.Name, crate.Trim)

	-- glowing corner jack-o'-lanterns
	Props.Pumpkin(m, V(x + dir * 6, 0, z + 9), 2.8, dir, 0, true)
	Props.Pumpkin(m, V(x + dir * 6, 0, z - 9), 2.8, dir, 0, true)

	Kit.AddCircle(ax, z, 13)
	m.PrimaryPart = padPart
	return m
end

local function beginnerExtras(m: Model, x: number, z: number, crate: Config.CrateDef)
	-- Tall shimmering beacon so the first crate is obvious from spawn (ForceField: reads as a
	-- light pillar without a 70-stud neon tube blooming over everything).
	local beacon = Kit.Cyl(m, 70, 5, CFrame.new(x, 57, z), Kit.Vivid(crate.Trim), { Mat = Enum.Material.ForceField, Transp = 0.5, Name = "Beacon" })
	Kit.Emitter(beacon, crate.Trim, 3, 3, 2)
	Kit.Ball(m, 6, V(x, 22.5, z), Kit.Vivid(crate.Color), { Refl = 0.15 })
	-- World-space label with ONE fixed text size. (It used to be sized in studs with TextScaled,
	-- which re-sized the text on every camera move: constant text re-drawing that made letters
	-- glitch on phones.) MaxDistance hides it when far away.
	local bb: BillboardGui = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 40)
	bb.StudsOffsetWorldSpace = V(0, -24, 0)
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Parent = beacon
	local label = Kit.Label(bb, "🎁 OPEN CRATES! 🎁", C(255, 230, 90), { Stroke = C(120, 50, 10) })
	label.TextScaled = false
	label.TextSize = 24
	local st = label:FindFirstChildOfClass("UIStroke")
	if st then
		st.Thickness = 2
	end
end

local function upgradeStation(folder: Instance, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1
	local m = Kit.Model(folder, "UpgradeStation")
	local color, trim = C(80, 200, 255), C(255, 220, 80)
	local padPart = pad(m, x, z, color, trim)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })

	local bx = x - dir * 9.5 -- workbench centre line
	local back = bx - dir * 3 -- back panel
	local yaw = Kit.FaceYaw(dir, 0)
	-- workbench
	Kit.Box(m, V(bx - 2, 0, z - 8), V(bx + 2, 3.6, z + 8), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(m, V(bx - 2.4, 3.6, z - 8.4), V(bx + 2.4, 4.2, z + 8.4), C(90, 230, 255), { Solid = true })
	-- back panel + big sign
	Kit.Box(m, V(back - 0.6, 0, z - 10.5), V(back + 0.6, 17, z + 10.5), C(110, 70, 200), { Solid = true })
	local signCF = CFrame.new(back + dir * 0.9, 13.2, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(19, 5, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(20, 6, 0.3), signCF * CFrame.new(0, 0, 0.4), Kit.Vivid(trim))
	Kit.Sign(sign, Enum.NormalId.Front, "⚡ UPGRADES ⚡", trim)
	-- upgrade icons
	for i, upId in Config.UpgradeOrder do
		local up = Config.Upgrades[upId]
		local icf = CFrame.new(back + dir * 0.8, 7.8, z + (i - 2) * 6) * CFrame.Angles(0, yaw, 0)
		local icon = Kit.Part(m, V(4.4, 4.4, 0.4), icf, C(60, 40, 110))
		Kit.Part(m, V(5, 5, 0.3), icf * CFrame.new(0, 0, 0.3), Kit.Vivid(color))
		Kit.Sign(icon, Enum.NormalId.Front, up.Icon, WHITE)
	end
	-- gadgets on the bench (potion vials are solid candy colours; the orange status light glows)
	Kit.CylFlat(m, 4.5, 1.6, V(bx, 5, z - 4.5), "Z", C(255, 120, 200))
	Kit.CylFlat(m, 1.5, 0.8, V(bx, 5, z - 7.4), "Z", Kit.Vivid(C(140, 255, 160)))
	for i = 0, 1 do
		Kit.Cyl(m, 3.2, 1.6, CFrame.new(bx, 5.8, z + 1 + i * 2.2), Kit.Vivid(C(120, 255, 170)), { Transp = 0.15, Refl = 0.15 })
		Kit.Cyl(m, 0.5, 1.8, CFrame.new(bx, 7.6, z + 1 + i * 2.2), C(70, 70, 90))
	end
	Kit.CylFlat(m, 0.6, 3.2, V(bx, 5.9, z + 6), "X", C(255, 210, 70))
	Kit.Ball(m, 1.2, V(bx, 5.9, z + 6), C(255, 120, 60), { Mat = NEON })
	-- striped awning on posts
	local tilt = -dir * 0.22
	local stripes = { C(255, 140, 50), C(160, 90, 255) }
	for i = 0, 3 do
		local sz = z - 8.25 + i * 5.5
		Kit.Part(m, V(9, 0.5, 5.5), CFrame.new(bx - dir * 0.5, 17.2, sz) * CFrame.Angles(0, 0, tilt), stripes[(i % 2) + 1], { Shadow = true })
	end
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(bx + dir * 3.7 - 0.4, 0, z + sz * 10.5 - 0.4), V(bx + dir * 3.7 + 0.4, 16.3, z + sz * 10.5 + 0.4), C(70, 50, 110))
	end
	local bulb = Kit.Ball(m, 1.4, V(bx + dir * 2, 15, z), C(255, 240, 160), { Mat = NEON })
	Kit.Light(bulb, C(255, 220, 150), 18, 1.5)

	Kit.AddCircle(x - dir * 4, z, 14)
	m.PrimaryPart = padPart
end

function Stations.Build(map: Instance)
	local folder = Kit.Folder(map, "Stations")
	for id, pos in Kit.CrateStations(Config.Layout) do
		local crate = Config.Crates[id]
		if crate then
			local m = crateStation(folder, crate, pos)
			if id == "Beginner" then
				beginnerExtras(m, pos.X, pos.Z, crate)
			end
		end
	end
	upgradeStation(folder, Config.Layout.UpgradeStation)
end

return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Sunken</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 13: Sunken City (Z 4120..4480). Atlantis ruins on a sandy sea floor you can walk on.
--   Ground: sand slab + pale marble-tile avenue along X = 0 (flat, teal edging).
--   Ghost areas get flat mosaic discs ((0,4205) r30, (-82,4240) r24, (75,4300) r26,
--   (-62,4360) r24, boss (0,4425) r26 with a gold trident star).
--   Atlantis gate arch over the avenue at Z 4168 (beam bottom Y 30).
--   Landmark seen from the Toy Factory: domed temple (-100, 4432), trident tip ~Y 102.
--   Sunken ship bow (east back corner), giant clams, coral reefs, kelp, broken columns,
--   treasure chests and flat starfish. A translucent water surface floats at Y 120
--   (no collision) with a few soft light shafts.
--   Side walls: teal reef rock (X +-140..146) topped with coral; outside: reef hills, coral
--   spires and kelp forests.
-- Glow: temple pearl, clam pearl, arch crystal, sea lanterns, the ship lantern, the boss
-- mosaic heart and a few anemone patches. Everything else is sand, marble, rock and plastic.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Sunken = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SAND = Enum.Material.Sand
local MARBLE = Enum.Material.Marble
local ROCK = Enum.Material.Rock
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.WoodPlanks
local FABRIC = Enum.Material.Fabric
local PEBBLE = Enum.Material.Pebble

local Z0, Z1 = 4120, 4480

local SANDC = C(226, 206, 160)
local SAND_D = C(205, 182, 135)
local TEAL = C(60, 175, 175)
local SEA = C(55, 125, 200)
local DEEP = C(40, 80, 130)
local CORAL = C(255, 120, 150)
local CORAL_O = C(255, 150, 80)
local CORAL_P = C(190, 110, 230)
local GOLD = C(255, 205, 80)
local MARBLE_C = C(232, 238, 236)
local MARBLE_T = C(190, 225, 220)
local REEF = C(75, 130, 145)
local KELP = { C(70, 160, 90), C(95, 185, 85), C(60, 140, 100) }
local AQUA = C(130, 255, 235)
local PEARL = C(250, 245, 255)
local WOODC = C(110, 80, 60)

local SOLID_MARBLE: Kit.Opts = { Mat = MARBLE, Solid = true, Shadow = true }
local GOLD_M: Kit.Opts = { Mat = METAL }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- SMALL PROPS
--==================================================================
local function coral(parent: Instance, x: number, z: number, s: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "Coral")
	local cols = { CORAL, CORAL_O, CORAL_P, C(255, 190, 90) }
	-- brain coral
	Kit.Ball(m, 4.5 * s, V(x, 0.8 * s, z), Kit.Vivid(Kit.Pick(cols)), { Mat = PEBBLE })
	-- branching coral
	local bc = Kit.Vivid(Kit.Pick(cols))
	local base = V(x + 2.6 * s, 0, z + rng:NextNumber(-1.5, 1.5))
	for i = 1, 3 do
		local a = i * 2.1 + rng:NextNumber(-0.4, 0.4)
		local tip = base + V(math.cos(a) * 1.6 * s, rng:NextNumber(4, 6.5) * s, math.sin(a) * 1.6 * s)
		Props.Beam(m, base, tip, 0.8 * s, 0.8 * s, bc)
		Kit.Ball(m, 1.3 * s, tip, bc)
	end
	-- tube coral
	local tc = Kit.Vivid(Kit.Pick(cols))
	for i = 0, 1 do
		local h = rng:NextNumber(2.5, 4.5) * s
		local p = V(x - 2.4 * s + i * 1.4 * s, 0, z + 1.6 * s - i * 1.2 * s)
		Kit.Cyl(m, h, 1.3 * s, CFrame.new(p + V(0, h / 2, 0)), tc)
		Kit.Disc(m, p.X, p.Z, h + 0.2, 1.6 * s, 0.4, tc:Lerp(Color3.new(1, 1, 1), 0.35))
	end
	-- fan coral
	Kit.Part(m, V(0.3, 4 * s, 4.5 * s), CFrame.new(x - 0.5 * s, 2 * s, z - 2.4 * s) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Kit.Vivid(Kit.Pick(cols)))
	Kit.AddCircle(x, z, 4.5 * s)
end

local function kelp(parent: Instance, x: number, z: number, h: number)
	local rng = Kit.Rng
	for i = 1, 3 do
		local hh = h * rng:NextNumber(0.6, 1)
		local p = V(x + rng:NextNumber(-2, 2), hh / 2, z + rng:NextNumber(-2, 2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, math.pi), rng:NextNumber(-0.08, 0.08))
		Kit.Part(parent, V(0.7, hh, 2.4), cf, Kit.Pick(KELP), { Mat = Enum.Material.Grass })
		if i == 1 then
			Kit.Ball(parent, 1.4, p + V(0, hh * 0.3, 0), C(170, 200, 70))
		end
	end
	Kit.AddCircle(x, z, 3)
end

local function starfish(parent: Instance, x: number, z: number)
	local col = Kit.Vivid(Kit.Pick({ CORAL_O, CORAL, C(255, 215, 90) }))
	local yaw = Kit.Rng:NextNumber(0, math.pi * 2)
	for i = 0, 4 do
		local a = yaw + i * math.pi * 2 / 5
		Kit.Part(parent, V(0.9, 0.12, 2.6), CFrame.new(x + math.cos(a) * 1.2, 0.08, z + math.sin(a) * 1.2) * CFrame.Angles(0, -a + math.pi / 2, 0), col)
	end
end

local function brokenColumn(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	local m = Kit.Model(parent, "BrokenColumn")
	local h = rng:NextNumber(6, 18)
	Kit.Box(m, V(x - 2.6, 0, z - 2.6), V(x + 2.6, 1.2, z + 2.6), MARBLE_T, SOLID_MARBLE)
	Kit.Cyl(m, h, 3.6, CFrame.new(x, 1.2 + h / 2, z), MARBLE_C, SOLID_MARBLE)
	if h > 12 then
		Kit.Box(m, V(x - 2.4, 1.2 + h, z - 2.4), V(x + 2.4, 2.4 + h, z + 2.4), Kit.Vivid(GOLD), GOLD_M)
	else
		Kit.CylFlat(m, 6, 3.6, V(x + (if x > 0 then 3.2 else -3.2), 1.8, z + 3.5), "Z", MARBLE_C, { Mat = MARBLE })
		Kit.Ball(m, 2.2, V(x, 1.2 + h + 0.4, z), Kit.Vivid(CORAL), { Mat = PEBBLE })
	end
	Kit.AddCircle(x, z, 4)
end

local function chest(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "TreasureChest")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(m, V(6, 3.4, 4), base * CFrame.new(0, 1.7, 0), WOODC, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(6.3, 0.6, 4.3), base * CFrame.new(0, 3.1, 0), gold, GOLD_M)
	Kit.Part(m, V(6, 0.6, 4), base * CFrame.new(0, 4.6, 2.6) * CFrame.Angles(-1.1, 0, 0), WOODC, { Mat = WOOD })
	Kit.Part(m, V(0.8, 1.2, 0.3), base * CFrame.new(0, 2.6, -2.1), gold, GOLD_M)
	-- coin pile spilling out the front + a couple of gems
	for i = 0, 3 do
		Kit.Ball(m, 2.4 - i * 0.3, (base * CFrame.new(-1.5 + i, 3.4 - i * 0.6, -0.6 - i * 0.9)).Position, gold, GOLD_M)
	end
	Kit.Ball(m, 1.1, (base * CFrame.new(1.6, 3.8, 0)).Position, Kit.Vivid(C(230, 60, 110)), { Refl = 0.3 })
	Kit.Ball(m, 1, (base * CFrame.new(-1.8, 3.7, 0.6)).Position, Kit.Vivid(C(70, 200, 255)), { Refl = 0.3 })
	Kit.AddCircle(x, z, 5)
end

local function clam(parent: Instance, x: number, z: number, d: number, glow: boolean): Part
	local m = Kit.Model(parent, "GiantClam")
	local R = d / 2
	local shell = C(230, 170, 215)
	local rib = C(250, 215, 240)
	Kit.Disc(m, x, z, 1.6, d, 1.6, shell, { Solid = true, Shadow = true })
	Kit.Disc(m, x, z, 1.8, d - 2, 0.3, C(255, 205, 220))
	-- upper shell hinged at the back (+Z), opening toward -Z
	local hinge = CFrame.new(x, 1.8, z + R) * CFrame.Angles(0.65, 0, 0)
	Kit.Cyl(m, 1.4, d, hinge * CFrame.new(0, 0.7, -R), shell, { Shadow = true })
	for i = -2, 2 do
		local a = i * 0.32
		Kit.Part(m, V(0.6, 0.4, R * 1.7), hinge * CFrame.new(0, 1.5, -R) * CFrame.Angles(0, a, 0), rib)
	end
	local pearlOpts: Kit.Opts = if glow then { Mat = NEON } else { Refl = 0.35 }
	local pearl = Kit.Ball(m, d * 0.28, V(x, 1.8 + d * 0.14, z - R * 0.15), PEARL, pearlOpts)
	if glow then
		Kit.Light(pearl, C(220, 240, 255), 28, 1.4)
	end
	Kit.AddCircle(x, z, R + 2)
	return pearl
end

local function seaLantern(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "SeaLantern")
	Kit.Disc(m, x, z, 0.8, 3, 0.8, MARBLE_T, { Mat = MARBLE })
	Kit.Cyl(m, 9, 0.7, CFrame.new(x, 5.2, z), Kit.Vivid(GOLD), GOLD_M)
	-- shell cup holding a glowing sea-glass orb
	Kit.Cyl(m, 0.8, 3.4, CFrame.new(x, 10, z), Kit.Vivid(CORAL))
	local orb = Kit.Ball(m, 2.4, V(x, 11.4, z), AQUA, { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(orb, AQUA, 24, 1.4)
	end
	Kit.AddCircle(x, z, 2.5)
end

--==================================================================
-- GROUND, WALLS, OUTSIDE, WATER
--==================================================================
local function ground(f: Instance)
	local rng = Kit.Rng
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SANDC, { Mat = SAND, Solid = true, Name = "Ground_Sunken" })
	-- marble-tile avenue with teal edging and gold mosaic bands
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), MARBLE_C, { Mat = MARBLE, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, Z0), V(s * 10, 0.08, Z1), Kit.Vivid(TEAL))
	end
	for z = Z0 + 40, Z1 - 20, 40 do
		Kit.Box(f, V(-9, 0.05, z - 0.8), V(9, 0.08, z + 0.8), Kit.Vivid(GOLD), GOLD_M)
	end
	-- darker sand ripples (flat)
	for _ = 1, 8 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 20)
		if math.abs(x) > 26 then
			Kit.Part(f, V(rng:NextNumber(18, 30), 0.04, 3), CFrame.new(x, 0.02, z) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), SAND_D, { Mat = SAND })
		end
	end
	-- mosaic discs on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, Kit.Vivid(if i % 2 == 0 then SEA else TEAL), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, MARBLE_T, { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.13, 10, 0.13, Kit.Vivid(GOLD), GOLD_M)
	end
	-- boss: deep-blue mosaic with a gold trident star and a glowing heart
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, Kit.Vivid(GOLD), GOLD_M)
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, DEEP, { Mat = MARBLE })
	for i = 0, 5 do
		local a = i * math.pi / 3
		Props.Beam(f, V(math.cos(a) * 4, 0.14, BOSS_Z + math.sin(a) * 4), V(math.cos(a) * 22, 0.14, BOSS_Z + math.sin(a) * 22), 1.2, 0.06, Kit.Vivid(GOLD), GOLD_M)
	end
	Kit.Disc(f, 0, BOSS_Z, 0.18, 7, 0.06, AQUA, { Mat = NEON, Transp = 0.15 })
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 26, z1), REEF, { Mat = ROCK, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 26, z0), V(s * 146.4, 27.2, z1), SAND_D, { Mat = Enum.Material.Sandstone })
		Kit.Box(f, V(s * 139.7, 18, z0), V(s * 140, 19.2, z1), Kit.Vivid(TEAL))
		-- coral growing over the wall top
		for z = z0 + 14, z1 - 10, 30 do
			local c = Kit.Vivid(Kit.Pick({ CORAL, CORAL_O, CORAL_P }))
			Kit.Ball(f, rng:NextNumber(6, 9), V(s * 143, 28, z), c, { Mat = PEBBLE })
			Kit.Ball(f, rng:NextNumber(3.5, 5), V(s * 142, 30.5, z + 4), c:Lerp(Color3.new(1, 1, 1), 0.2), { Mat = PEBBLE })
		end
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local hills = { REEF, C(90, 110, 160), C(110, 150, 140) }
	for i = 0, 4 do
		local z = Z0 + 30 + i * 75
		for _, s in { -1, 1 } do
			Kit.Ball(f, rng:NextNumber(60, 80), V(s * rng:NextNumber(185, 200), -16, z + s * 15), Kit.Pick(hills), { Mat = ROCK })
			-- coral spire
			local x = s * rng:NextNumber(158, 168)
			local h = rng:NextNumber(30, 48)
			local c = Kit.Vivid(Kit.Pick({ CORAL, CORAL_O, CORAL_P }))
			Kit.Cyl(f, h, 5, CFrame.new(x, h / 2, z + 30), c)
			Kit.Ball(f, 8, V(x, h, z + 30), c:Lerp(Color3.new(1, 1, 1), 0.2), { Mat = PEBBLE })
			Kit.Ball(f, 5, V(x + s * 3, h * 0.6, z + 32), c, { Mat = PEBBLE })
			-- tall kelp forest
			for k = 0, 2 do
				local hh = rng:NextNumber(36, 60)
				local cf = CFrame.new(s * (151 + k * 5), hh / 2, z + 6 + k * 7) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.08, 0.08))
				Kit.Part(f, V(1.2, hh, 3.6), cf, Kit.Pick(KELP), { Mat = Enum.Material.Grass })
			end
		end
	end
end

local function water(f: Instance)
	Kit.Box(f, V(-190, 120, Z0), V(190, 121, Z1), C(70, 180, 215), { Transp = 0.85, Name = "WaterSurface", Shadow = false })
	-- soft light shafts (kept outside the ghost areas)
	for _, p in { { -118, Z0 + 52 }, { 116, Z0 + 120 }, { -24, Z0 + 205 }, { 48, Z0 + 262 } } do
		Kit.Part(f, V(6, 110, 14), CFrame.new(p[1], 64, p[2]) * CFrame.Angles(0, 0.4, 0.12), C(200, 245, 255), { Transp = 0.9, Name = "LightShaft", Shadow = false })
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function gateArch(f: Instance)
	local m = Kit.Model(f, "AtlantisArch")
	local z = Z0 + 48
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 13.5, 0, z - 4), V(s * 20.5, 2.5, z + 4), MARBLE_T, SOLID_MARBLE)
		Kit.Cyl(m, 27.5, 5.5, CFrame.new(s * 17, 2.5 + 13.75, z), MARBLE_C, SOLID_MARBLE)
		for _, y in { 8, 18 } do
			Kit.Cyl(m, 0.8, 6, CFrame.new(s * 17, y, z), Kit.Vivid(TEAL))
		end
		Kit.Ball(m, 5, V(s * 19, 4.5, z - 3), Kit.Vivid(CORAL), { Mat = PEBBLE })
		Kit.AddRect(s * 12.5, z - 4.5, s * 21.5, z + 4.5)
	end
	Kit.Box(m, V(-22, 30, z - 3.5), V(22, 34, z + 3.5), MARBLE_C, SOLID_MARBLE)
	Kit.Box(m, V(-22.4, 30, z - 3.7), V(22.4, 30.8, z + 3.7), Kit.Vivid(GOLD), GOLD_M)
	-- pediment (two wedges meeting in the middle)
	Kit.Wedge(m, V(7, 7, 22), CFrame.new(-11, 37.5, z) * CFrame.Angles(0, -math.pi / 2, 0), MARBLE_C, { Mat = MARBLE })
	Kit.Wedge(m, V(7, 7, 22), CFrame.new(11, 37.5, z) * CFrame.Angles(0, math.pi / 2, 0), MARBLE_C, { Mat = MARBLE })
	local crystal = Kit.Part(m, V(3, 3, 3), CFrame.new(0, 43.5, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), AQUA, { Mat = NEON })
	Kit.Light(crystal, AQUA, 30, 1.4)
	Props.SignBoard(m, V(0, 32, z - 3.9), 30, 3.4, 0, -1, "~ SUNKEN CITY ~", DEEP, Kit.Vivid(GOLD))
end

local function temple(f: Instance)
	local m = Kit.Model(f, "DomedTemple")
	local x, z = -100, Z0 + 312
	local gold = Kit.Vivid(GOLD)
	Kit.Disc(m, x, z, 2, 48, 2, MARBLE_T, SOLID_MARBLE)
	Kit.Disc(m, x, z, 4, 44, 2, MARBLE_C, SOLID_MARBLE)
	Kit.Disc(m, x, z, 6, 40, 2, MARBLE_T, SOLID_MARBLE)
	-- ring of columns
	for i = 0, 9 do
		local a = i * math.pi / 5
		local cx, cz = x + math.cos(a) * 17, z + math.sin(a) * 17
		Kit.Cyl(m, 30, 3.4, CFrame.new(cx, 21, cz), MARBLE_C, SOLID_MARBLE)
		Kit.Box(m, V(cx - 2.2, 35, cz - 2.2), V(cx + 2.2, 36.4, cz + 2.2), gold, GOLD_M)
	end
	-- inner cella with a door toward the avenue
	Kit.Cyl(m, 28, 22, CFrame.new(x, 20, z), C(150, 205, 200), SOLID_MARBLE)
	Kit.Box(m, V(x + 10.5, 6, z - 3.5), V(x + 11.2, 18, z + 3.5), C(30, 60, 90))
	Kit.Box(m, V(x + 10.6, 18, z - 4.3), V(x + 11.3, 19, z + 4.3), gold, GOLD_M)
	-- entablature, drum, dome
	Kit.Cyl(m, 4, 40, CFrame.new(x, 38, z), MARBLE_C, { Mat = MARBLE, Shadow = true })
	Kit.Cyl(m, 0.8, 40.6, CFrame.new(x, 36.6, z), gold, GOLD_M)
	Kit.Cyl(m, 6, 32, CFrame.new(x, 43, z), MARBLE_T, { Mat = MARBLE, Shadow = true })
	Kit.Ball(m, 32, V(x, 46, z), C(80, 190, 175), { Shadow = true, Refl = 0.1 })
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Props.Beam(m, V(x + math.cos(a) * 15.6, 47, z + math.sin(a) * 15.6), V(x + math.cos(a) * 3, 61.6, z + math.sin(a) * 3), 0.9, 0.9, gold, GOLD_M)
	end
	-- lantern with the glowing pearl
	Kit.Cyl(m, 1, 9, CFrame.new(x, 62.5, z), gold, GOLD_M)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Cyl(m, 6, 0.8, CFrame.new(x + math.cos(a) * 3.4, 66, z + math.sin(a) * 3.4), gold, GOLD_M)
	end
	local pearl = Kit.Ball(m, 4.2, V(x, 66, z), PEARL, { Mat = NEON })
	Kit.Light(pearl, C(200, 240, 255), 40, 1.6)
	Kit.Cyl(m, 1.2, 9, CFrame.new(x, 69.6, z), gold, GOLD_M)
	-- giant trident on top
	Kit.Cyl(m, 22, 1.2, CFrame.new(x, 81, z), gold, GOLD_M)
	Kit.Box(m, V(x - 5, 91.4, z - 0.6), V(x + 5, 92.6, z + 0.6), gold, GOLD_M)
	for _, dx in { -4.4, 0, 4.4 } do
		local top = if dx == 0 then 101 else 98
		Kit.Box(m, V(x + dx - 0.6, 92.6, z - 0.6), V(x + dx + 0.6, top, z + 0.6), gold, GOLD_M)
		Kit.Wedge(m, V(1.2, 2, 1.2), CFrame.new(x + dx, top + 1, z), gold, GOLD_M)
	end
	-- bubbles rising from the dome
	local src = Kit.Part(m, V(10, 0.4, 10), CFrame.new(x, 63, z), AQUA, { Transp = 1, Name = "BubbleSource" })
	local e = Kit.Emitter(src, C(210, 250, 255), 3, 2, 3)
	if e then
		e.Acceleration = V(0, 2, 0)
	end
	Props.SignBoard(m, V(x + 11.6, 22.5, z), 11, 2.6, 1, 0, "TEMPLE OF TIDES", DEEP, Kit.Vivid(GOLD))
	Kit.AddCircle(x, z, 25)
end

local function ship(f: Instance)
	local m = Kit.Model(f, "SunkenShip")
	local hull = C(120, 85, 65)
	local plank = C(150, 110, 80)
	local base = CFrame.new(104, 3, Z0 + 296) * CFrame.Angles(0, -0.35, 0) * CFrame.Angles(0.28, 0, 0.12)
	local so: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	Kit.Part(m, V(16, 14, 40), base, hull, so)
	Kit.Part(m, V(11.3, 14, 11.3), base * CFrame.new(0, 0, -20) * CFrame.Angles(0, math.pi / 4, 0), hull, so)
	Kit.Part(m, V(15.4, 0.6, 40), base * CFrame.new(0, 7.2, 0), plank, { Mat = WOOD })
	Kit.Part(m, V(16.4, 1.2, 40.4), base * CFrame.new(0, 2, 0), Kit.Vivid(C(220, 70, 70)), { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, 2, 38), base * CFrame.new(sx * 7.8, 8.5, 1), plank, { Mat = WOOD })
		for i = 0, 2 do
			Kit.Part(m, V(0.4, 2.6, 2.6), base * CFrame.new(sx * 8.1, 4.5, -10 + i * 9), Kit.Vivid(GOLD), { Mat = METAL, Shape = Enum.PartType.Cylinder })
			Kit.Part(m, V(0.5, 1.8, 1.8), base * CFrame.new(sx * 8.15, 4.5, -10 + i * 9), C(40, 70, 100), { Shape = Enum.PartType.Cylinder })
		end
	end
	-- bowsprit, broken mast and a tattered sail
	Kit.Part(m, V(1.2, 1.2, 14), base * CFrame.new(0, 7, -30) * CFrame.Angles(0.25, 0, 0), plank, { Mat = WOOD })
	local mast = base * CFrame.new(0, 7, -6) * CFrame.Angles(0, 0, 0.35)
	Kit.Part(m, V(1.8, 26, 1.8), mast * CFrame.new(0, 13, 0), WOODC, { Mat = WOOD })
	Kit.Part(m, V(0.2, 12, 14), mast * CFrame.new(0.4, 16, 0), C(240, 230, 205), { Mat = FABRIC, Transp = 0.1 })
	Kit.Part(m, V(1, 1, 16), mast * CFrame.new(0, 22, 0), WOODC, { Mat = WOOD })
	-- lantern hanging from the bowsprit
	local lantern = Kit.Part(m, V(1.6, 2.2, 1.6), base * CFrame.new(0, 5.5, -33), C(255, 210, 120), { Mat = NEON })
	Kit.Light(lantern, C(255, 200, 120), 26, 1.3, true)
	-- name board on the stern deck
	local sign = Kit.Part(m, V(9, 2.6, 0.4), base * CFrame.new(0, 10.3, 19.5) * CFrame.Angles(0, math.pi, 0), DEEP)
	Kit.Sign(sign, Enum.NormalId.Front, "S.S. BOO-NANZA", Kit.Vivid(GOLD))
	Kit.AddRect(80, Z0 + 262, 128, Z0 + 340)
end

local function seaLife(f: Instance)
	-- floating jellyfish and fish (single tagged parts, outside the ghost areas)
	for _, p in { V(-30, 26, Z0 + 150), V(40, 32, Z0 + 230), V(-116, 30, Z0 + 190), V(112, 28, Z0 + 92) } do
		local j = Kit.Ball(f, 4, p, Kit.Vivid(Kit.Pick({ CORAL, CORAL_P, C(255, 170, 220) })), { Transp = 0.35, Name = "Jellyfish" })
		Kit.Float(j, 2)
	end
	for _, p in { V(26, 18, Z0 + 140), V(-30, 22, Z0 + 290), V(120, 16, Z0 + 230) } do
		local fish = Kit.Part(f, V(1.4, 2.2, 4), CFrame.new(p) * CFrame.Angles(0, Kit.Rng:NextNumber(0, 6), 0), Kit.Vivid(Kit.Pick({ CORAL_O, C(255, 215, 80), SEA })), { Name = "Fish" })
		Kit.Float(fish, 1.5)
	end
end

local function scatter(f: Instance)
	local rng = Kit.Rng
	-- broken columns lining the avenue
	for z = Z0 + 128, Z1 - 70, 26 do
		for _, s in { -1, 1 } do
			local x = s * 16
			if Kit.IsFree(x, z, 3.5) then
				brokenColumn(f, x, z)
			end
		end
	end
	-- giant clams
	if Kit.IsFree(-104, Z0 + 52, 9) then
		clam(f, -104, Z0 + 52, 14, true)
	end
	if Kit.IsFree(118, Z0 + 140, 8) then
		clam(f, 118, Z0 + 140, 12, false)
	end
	if Kit.IsFree(-34, Z0 + 320, 7) then
		local pearl = clam(f, -34, Z0 + 320, 10, false)
		local e = Kit.Emitter(pearl, C(210, 250, 255), 2, 1.6, 2.5)
		if e then
			e.Acceleration = V(0, 2.5, 0)
		end
	end
	-- treasure
	for _, p in { { 84, Z0 + 248, -1, -1 }, { -64, Z0 + 320, 1, 0 }, { 120, Z0 + 352, -1, 0 } } do
		if Kit.IsFree(p[1], p[2], 5) then
			chest(f, p[1], p[2], p[3], p[4])
		end
	end
	-- sea lanterns along the avenue
	for i, p in { { -14, Z0 + 118 }, { 14, Z0 + 118 }, { -14, Z0 + 265 }, { 14, Z0 + 265 } } do
		if Kit.IsFree(p[1], p[2], 2.5) then
			seaLantern(f, p[1], p[2], i == 1 or i == 4)
		end
	end
	-- coral reefs and kelp
	local corals, kelps, stars = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 30, Z1 - 10)
		if corals < 14 and Kit.IsFree(x, z, 6) then
			corals += 1
			coral(f, x, z, rng:NextNumber(0.9, 1.3))
		elseif kelps < 10 and Kit.IsFree(x, z, 3) then
			kelps += 1
			kelp(f, x, z, rng:NextNumber(14, 30))
		elseif stars < 8 and math.abs(x) > 12 then
			stars += 1
			starfish(f, x, z)
		end
	end
	-- glowing anemone patches (flat neon accents)
	for _, p in { V(-48, 0, Z0 + 60), V(46, 0, Z0 + 330), V(-122, 0, Z0 + 270) } do
		Kit.Disc(f, p.X, p.Z, 0.2, 3.5, 0.1, AQUA, { Mat = NEON, Transp = 0.2 })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Sunken.Build(map: Instance)
	local f = Kit.Folder(map, "Sunken")
	ground(f)
	sideWalls(f)
	outside(f)
	water(f)
	gateArch(f)
	temple(f)
	ship(f)
	seaLife(f)
	scatter(f)
end

return Sunken
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Swamp</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 9: Phantom Swamp (Z 2680..3040). A misty, moss-green bayou: cute-spooky, not dark.
--   Ground: grass slab (top Y = 0) with flat mud patches and shallow water: translucent teal
--   sheets lying on the solid ground (no pits anywhere).
--   Main path: a plank boardwalk along X = 0 (X -8..8, top 0.05) from gate to gate.
--   Ghost areas hold flat paint only: lily-pad ponds either side of the boardwalk, moss clearings,
--   a wide lily pond and the boss bog ring around (0, 2985) with lime ectoplasm runes.
--   Landmark: the SWAMP KING, a giant gnarled cypress wearing a golden crown at (100, 2970),
--   ~90 tall, seen through the Spirit Realm portal arch.
--   Also: an old stranded paddle boat "Swamp Queen" (100, 2775), three crooked stilt shacks
--   (two with raised side boardwalks), cypress trees with hanging moss, reeds, glowing
--   mushrooms, fireflies, frogs and lanterns. Side walls: mossy plank palisade at X +-140..146.
--   Outside: open bayou water with cypress silhouettes and low fog banks.
-- Glow is limited to fireflies, a few mushroom caps, shack windows, lanterns, the boss runes,
-- the paddle boat's bow lamp and the Swamp King's eyes.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Swamp = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local GRASS = Enum.Material.Grass
local MUD = Enum.Material.Mud
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal

local Z0, Z1 = 2680, 3040

local GROUND = C(88, 128, 66)
local MUDC = C(104, 84, 58)
local WATER = C(64, 140, 120)
local WATER_DEEP = C(48, 112, 104)
local BARK = C(92, 70, 52)
local BARK_DARK = C(70, 54, 42)
local PLANK = C(150, 112, 74)
local PLANK_DARK = C(104, 76, 52)
local MOSS = C(96, 150, 70)
local MOSS_LIGHT = C(140, 180, 96)
local HANGMOSS = C(160, 182, 132)
local LIME = C(170, 255, 110)
local WARM = C(255, 220, 130)
local LILY = C(90, 170, 80)
local GOLD = C(255, 200, 60)
local CANOPY = { C(70, 125, 62), C(86, 140, 70), C(62, 112, 70), C(98, 150, 78) }
local SHACKS = { C(110, 150, 140), C(150, 120, 160), C(160, 130, 90) }

local function rz(n: number): number
	return Z0 + n
end

-- Plan-view triangle (local Y y0..y1): right angle at (xEdge, zBase), point at (xEdge, zTip > zBase).
local function bowHalf(parent: Instance, base: CFrame, xEdge: number, xOuter: number, zBase: number, zTip: number, y0: number, y1: number, color: Color3, opts: Kit.Opts)
	local s = if xOuter > xEdge then 1 else -1
	local center = V((xEdge + xOuter) / 2, (y0 + y1) / 2, (zBase + zTip) / 2)
	local cf = base * CFrame.fromMatrix(center, V(0, s, 0), V(s, 0, 0))
	Kit.Wedge(parent, V(y1 - y0, math.abs(xOuter - xEdge), zTip - zBase), cf, color, opts)
end

-- Gable roof, ridge along local X, bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = true, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Shallow water sheet (non-solid) with a mud rim, lying on the solid ground; top at Y 0.1.
local function pond(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.04, d + 4, 0.03, MUDC, { Mat = MUD })
	Kit.Disc(parent, x, z, 0.1, d, 0.06, WATER, { Transp = 0.2, Refl = 0.15, Name = "Water" })
end

local function lilyPad(parent: Instance, x: number, z: number, d: number, flower: boolean)
	Kit.Disc(parent, x, z, 0.14, d, 0.03, Kit.Vivid(LILY))
	if flower then
		Kit.Disc(parent, x + d * 0.15, z, 0.2, d * 0.35, 0.06, Kit.Vivid(C(255, 150, 200)))
	end
end

--==================================================================
-- PROPS
--==================================================================
local function cypress(parent: Instance, pos: Vector3, h: number)
	local rng = Kit.Rng
	local wood: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	Kit.Cyl(parent, 3, 5.5, CFrame.new(pos + V(0, 1.5, 0)), BARK_DARK, wood)
	local trunkCf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
	Kit.Cyl(parent, h, 2.4, trunkCf * CFrame.new(0, h / 2, 0), BARK, wood)
	-- cypress knees poking out of the mud
	for k = 1, 2 do
		local a = rng:NextNumber(0, math.pi * 2)
		local kh = rng:NextNumber(1.2, 2.4)
		Kit.Cyl(parent, kh, 0.9, CFrame.new(pos + V(math.cos(a) * (3.5 + k), kh / 2, math.sin(a) * (3.5 + k))), BARK)
	end
	-- flat-topped canopy layers
	local top = (trunkCf * CFrame.new(0, h, 0)).Position
	local col = Kit.Pick(CANOPY)
	local d = h * 0.75
	Kit.Cyl(parent, 2.6, d, CFrame.new(top + V(0, -1, 0)), col, { Mat = GRASS, Shadow = true })
	Kit.Cyl(parent, 2.4, d * 0.65, CFrame.new(top + V(rng:NextNumber(-1.5, 1.5), 1.2, rng:NextNumber(-1.5, 1.5))), col:Lerp(Color3.new(1, 1, 1), 0.12), { Mat = GRASS })
	Kit.Ball(parent, d * 0.4, top + V(rng:NextNumber(-2, 2), -2.2, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(0, 0, 0), 0.1), { Mat = GRASS })
	-- hanging moss strands under the canopy edge
	for k = 0, 2 do
		local a = k * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = rng:NextNumber(4, 7)
		local p = top + V(math.cos(a) * d * 0.38, -2.3 - len / 2, math.sin(a) * d * 0.38)
		Kit.Part(parent, V(0.6, len, 1.6), CFrame.new(p) * CFrame.Angles(0, a, 0), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, d / 2)
end

local function reeds(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	for k = 0, 2 do
		local h = rng:NextNumber(4, 6.5)
		local p = V(x + rng:NextNumber(-1.2, 1.2), 0, z + rng:NextNumber(-1.2, 1.2))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15))
		Kit.Cyl(parent, h, 0.3, cf * CFrame.new(0, h / 2, 0), C(110, 160, 80))
		if k < 2 then
			Kit.Cyl(parent, 1.6, 0.75, cf * CFrame.new(0, h - 1.2, 0), C(120, 80, 50), { Mat = FABRIC })
		end
	end
	Kit.AddCircle(x, z, 2)
end

local function mushrooms(parent: Instance, x: number, z: number, glow: boolean)
	local rng = Kit.Rng
	local caps = { C(170, 255, 110), C(110, 240, 210), C(200, 150, 255) }
	for _ = 1, 3 do
		local p = V(x + rng:NextNumber(-1.8, 1.8), 0, z + rng:NextNumber(-1.8, 1.8))
		local h = rng:NextNumber(1, 2.6)
		Kit.Cyl(parent, h, 0.6, CFrame.new(p + V(0, h / 2, 0)), C(240, 236, 220))
		local cap = Kit.Pick(caps)
		Kit.Cyl(parent, 0.8, rng:NextNumber(1.8, 2.8), CFrame.new(p + V(0, h + 0.3, 0)), if glow then cap else Kit.Vivid(cap), if glow then { Mat = NEON } else {})
	end
	Kit.AddCircle(x, z, 2.5)
end

local function frog(parent: Instance, x: number, z: number, fx: number, fz: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Disc(parent, x, z, 0.14, 4.4, 0.03, Kit.Vivid(LILY))
	Kit.Part(parent, V(2.4, 1.4, 2.2), base * CFrame.new(0, 0.9, 0), Kit.Vivid(C(110, 200, 90)))
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.9, (base * CFrame.new(s * 0.65, 1.75, -0.5)).Position, C(250, 250, 240))
		Kit.Ball(parent, 0.45, (base * CFrame.new(s * 0.65, 1.8, -0.88)).Position, C(30, 30, 40))
	end
	Kit.Part(parent, V(1.4, 0.15, 0.2), base * CFrame.new(0, 0.85, -1.12), Kit.Vivid(C(255, 120, 150)))
	Kit.AddCircle(x, z, 3)
end

local function fallenLog(parent: Instance, x: number, z: number, yaw: number, len: number)
	local cf = CFrame.new(x, 1.1, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(parent, V(len, 2.2, 2.2), cf, BARK, { Mat = WOOD, Shape = Enum.PartType.Cylinder, Solid = true })
	Kit.Part(parent, V(len * 0.5, 0.4, 1.6), cf * CFrame.new(len * 0.1, 1.05, 0), MOSS, { Mat = GRASS })
	Kit.AddCircle(x, z, len / 2)
end

-- Crooked stilt shack whose front (door, ramp) faces (fx, 0); a little pond under it.
local function shack(parent: Instance, x: number, z: number, fx: number, col: Color3, lit: boolean, flicker: boolean)
	local m = Kit.Model(parent, "StiltShack")
	pond(m, x, z, 20)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local tilt = base * CFrame.Angles(0, 0, 0.04)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Cyl(m, 5.2, 1.1, base * CFrame.new(sx * 6, 2.6, sz * 5), BARK_DARK, { Mat = WOOD, Solid = true })
		end
	end
	Kit.Part(m, V(14, 1, 12), base * CFrame.new(0, 4.6, 0), PLANK, { Mat = PLANKS, Solid = true, Shadow = true })
	Kit.Part(m, V(10, 8, 8), tilt * CFrame.new(0, 9.1, 1), col, { Mat = PLANKS, Solid = true, Shadow = true })
	gable(m, tilt * CFrame.new(0, 13.1, 1), 12, 10.5, 4.5, C(150, 96, 70), Enum.Material.CorrodedMetal)
	-- door + window on the front (local -Z)
	Kit.Part(m, V(2.6, 5, 0.3), tilt * CFrame.new(-2, 7.6, -3.1), PLANK_DARK, { Mat = WOOD })
	local win = Kit.Part(m, V(2.6, 2.2, 0.3), tilt * CFrame.new(2.4, 9.4, -3.1), WARM, if lit then { Mat = NEON } else {})
	Kit.Part(m, V(3.2, 0.4, 0.4), tilt * CFrame.new(2.4, 8.2, -3.2), PLANK_DARK)
	if lit then
		Kit.Light(win, WARM, 20, 1.3, flicker)
	end
	-- crooked stovepipe, porch rail and a ramp down to the mud
	Kit.Cyl(m, 5, 1, tilt * CFrame.new(3.5, 15, 3) * CFrame.Angles(0, 0, 0.15), C(70, 70, 80), { Mat = METAL })
	Kit.Part(m, V(14, 0.3, 0.3), base * CFrame.new(0, 7, -5.8), PLANK_DARK, { Mat = WOOD })
	Kit.Wedge(m, V(3.4, 4.6, 7), base * CFrame.new(-2, 2.3, -9.5), PLANK, { Mat = PLANKS, Solid = true })
	Kit.AddCircle(x, z, 12)
end

-- Raised boardwalk (top 0.6, a walkable step) along X at z.
local function sideWalk(parent: Instance, x1: number, x2: number, z: number)
	local lo, hi = math.min(x1, x2), math.max(x1, x2)
	Kit.Box(parent, V(lo, 0, z - 2.2), V(hi, 0.6, z + 2.2), PLANK, { Mat = PLANKS, Solid = true, Name = "SideBoardwalk" })
	local x = lo + 4
	while x < hi - 2 do
		for _, s in { -1, 1 } do
			Kit.Cyl(parent, 2.4, 0.7, CFrame.new(x, 1.2, z + s * 2.3), PLANK_DARK, { Mat = WOOD })
		end
		x += 16
	end
	Kit.AddRect(lo, z - 3, hi, z + 3)
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), GROUND, { Mat = GRASS, Solid = true, Name = "Ground_Swamp" })
	-- boardwalk along X = 0 with dark edge boards and cross seams
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PLANK, { Mat = PLANKS, Solid = true, Name = "Boardwalk" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.5, 0.05, Z0), V(s * 8 + 0.5, 0.11, Z1), PLANK_DARK, { Mat = WOOD })
	end
	for z = Z0 + 10, Z1 - 10, 22 do
		Kit.Box(f, V(-7.5, 0.05, z), V(7.5, 0.08, z + 0.6), PLANK_DARK, { Mat = WOOD })
	end
	-- flat mud patches
	local rng = Kit.Rng
	for _ = 1, 9 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(14, 26), 0.03, rng:NextNumber(10, 22)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), MUDC, { Mat = MUD })
		end
	end
	-- winding water channels along both sides (flat sheets on solid ground)
	local channels = {
		{ V(-122, 0, rz(70)), V(-128, 0, rz(130)), V(-116, 0, rz(190)), V(-124, 0, rz(250)), V(-112, 0, rz(320)) },
		{ V(124, 0, rz(150)), V(116, 0, rz(210)), V(124, 0, rz(250)) },
	}
	for _, ch in channels do
		for i = 1, #ch - 1 do
			local a, b = ch[i], ch[i + 1]
			local d = b - a
			local mid = (a + b) / 2
			local rot = CFrame.Angles(0, math.atan2(-d.X, -d.Z), 0)
			Kit.Part(f, V(13, 0.03, d.Magnitude + 8), CFrame.new(mid.X, 0.025, mid.Z) * rot, MUDC, { Mat = MUD })
			Kit.Part(f, V(9, 0.06, d.Magnitude + 6), CFrame.new(mid.X, 0.07, mid.Z) * rot, WATER_DEEP, { Transp = 0.2, Refl = 0.15, Name = "Water" })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 11, zB), PLANK_DARK, { Mat = PLANKS, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 11, zA), V(s * 146.4, 12.2, zB), MOSS, { Mat = GRASS })
		Kit.Box(f, V(s * 139.85, 2.5, zA), V(s * 139.65, 3.1, zB), Kit.Vivid(C(150, 230, 90)))
		for z = zA + 12, zB - 6, 36 do
			Kit.Cyl(f, 15, 3.2, CFrame.new(s * 143, 7.5, z), BARK, { Mat = WOOD, Solid = true })
			Kit.Ball(f, 4, V(s * 143, 15.4, z), Kit.Pick(CANOPY), { Mat = GRASS })
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- bog wisps: lily ponds either side of the boardwalk on a moss clearing
	local cz = rz(85)
	Kit.Disc(f, 0, cz, 0.03, 64, 0.02, MOSS_LIGHT, { Mat = GRASS })
	for _, s in { -1, 1 } do
		pond(f, s * 19.5, cz, 18)
		pond(f, s * 21, cz - 18, 9)
		pond(f, s * 20, cz + 18, 10)
		lilyPad(f, s * 16, cz - 3, 4, s > 0)
		lilyPad(f, s * 23, cz + 4, 3.2, s < 0)
		lilyPad(f, s * 20, cz + 18, 3, false)
	end
	-- moss clearings with mud rims
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 4, 0.03, MUDC, { Mat = MUD })
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, MOSS_LIGHT, { Mat = GRASS })
		pond(f, a[1] + 6, a[2] - 4, 12)
		lilyPad(f, a[1] + 8, a[2] - 3, 3.4, true)
	end
	-- marsh phantoms: a wide lily pond
	pond(f, 75, rz(180), 44)
	for _, l in { { 66, rz(172), 4.5 }, { 84, rz(186), 3.6 }, { 72, rz(194), 3 }, { 88, rz(170), 4.2 } } do
		lilyPad(f, l[1], l[2], l[3], l[3] > 4)
	end
	-- boss bog: mud ring, two murky pools and lime ectoplasm runes
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, MUDC, { Mat = MUD })
	for _, s in { -1, 1 } do
		pond(f, s * 17, bz, 15)
		lilyPad(f, s * 16, bz + 3, 3.6, s > 0)
	end
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.14
		local a2 = a1 + math.pi / 4 - 0.28
		Props.Beam(f, V(math.cos(a1) * 25, 0.13, bz + math.sin(a1) * 25), V(math.cos(a2) * 25, 0.13, bz + math.sin(a2) * 25), 0.5, 0.06, LIME, { Mat = NEON })
	end
	local core = Kit.Disc(f, 0, bz, 0.12, 6, 0.05, Kit.Vivid(LIME), { Transp = 0.3 })
	Kit.Light(core, LIME, 30, 1.2)
	local fog = Kit.Part(f, V(40, 0.2, 40), CFrame.new(0, 1, bz), C(200, 240, 200), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(200, 240, 200), 1.6, 9, 0.3)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function swampKing(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SwampKing")
	local wood: Kit.Opts = { Mat = WOOD, Solid = true, Shadow = true }
	pond(m, x, z, 34)
	-- roots
	for i = 0, 5 do
		local a = i * math.pi / 3 + 0.3
		Props.Beam(m, V(x + math.cos(a) * 17, 0.3, z + math.sin(a) * 17), V(x + math.cos(a) * 6, 9, z + math.sin(a) * 6), 3.2, 3.2, BARK_DARK, { Mat = WOOD })
	end
	Kit.Cyl(m, 14, 18, CFrame.new(x, 7, z), BARK, wood)
	-- gnarled trunk
	local pts = { V(x, 12, z), V(x + 3, 26, z - 2), V(x - 2, 40, z + 2), V(x + 1, 54, z) }
	for i = 1, #pts - 1 do
		local w = 14 - i * 2.5
		Props.Beam(m, pts[i], pts[i + 1], w, w, if i % 2 == 0 then BARK_DARK else BARK, wood)
	end
	-- sleepy face on the side looking at the boardwalk (-X)
	Kit.Box(m, V(x - 9.4, 3.5, z - 3.5), V(x - 8.4, 6.5, z + 3.5), C(40, 30, 28))
	local eye: Part? = nil
	for _, s in { -1, 1 } do
		Kit.Ball(m, 4.2, V(x - 8.4, 10.5, z + s * 3.6), C(40, 30, 28))
		local e = Kit.Ball(m, 2.6, V(x - 9.6, 10.5, z + s * 3.6), LIME, { Mat = NEON })
		eye = eye or e
	end
	if eye then
		Kit.Light(eye, LIME, 26, 1.4)
	end
	-- branches
	for i = 0, 4 do
		local a = i * 1.26 + 0.5
		local from = pts[2 + (i % 3)]
		local tip = from + V(math.cos(a) * 18, 10 + i * 2, math.sin(a) * 18)
		Props.Beam(m, from, tip, 2.4, 2.4, BARK, { Mat = WOOD })
	end
	-- mossy crown
	local crown = { V(0, 62, 0), V(14, 58, 6), V(-12, 60, -8), V(6, 60, -14), V(-6, 58, 14), V(-2, 72, 2) }
	for i, c in crown do
		Kit.Ball(m, if i == 1 then 30 else 20, V(x, 0, z) + c, CANOPY[(i % #CANOPY) + 1], { Mat = GRASS, Shadow = true })
	end
	for i = 0, 5 do
		local a = i * 1.05
		local len = 10 + (i % 3) * 3
		Kit.Part(m, V(0.8, len, 2.4), CFrame.new(x + math.cos(a) * 16, 52 - len / 2, z + math.sin(a) * 16) * CFrame.Angles(0, a, 0), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
	end
	-- the golden crown
	local gold = Kit.Vivid(GOLD)
	Kit.Cyl(m, 5, 13, CFrame.new(x - 2, 85, z + 2), gold, { Mat = METAL, Refl = 0.2 })
	for i = 0, 4 do
		local a = i * math.pi * 2 / 5
		local p = V(x - 2 + math.cos(a) * 5.5, 88.5, z + 2 + math.sin(a) * 5.5)
		Kit.Part(m, V(2.4, 3.6, 2.4), CFrame.new(p) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, math.pi / 4), gold, { Mat = METAL })
		Kit.Ball(m, 1.3, p + V(0, 2.4, 0), Kit.Vivid(if i % 2 == 0 then C(230, 60, 90) else C(70, 200, 220)))
	end
	Kit.AddCircle(x, z, 22)
end

local function paddleBoat(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "PaddleBoat")
	pond(m, x, z, 56)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, 0, 0.05) -- listing a little in the mud
	local hull = C(222, 212, 182)
	local teal = Kit.Vivid(C(60, 160, 150))
	local red = Kit.Vivid(C(200, 80, 70))
	local sol: Kit.Opts = { Mat = PLANKS, Solid = true, Shadow = true }
	-- hull (along Z, stern at -Z), pointed bow
	Kit.Part(m, V(16, 6, 30), base * CFrame.new(0, 2, -4), hull, sol)
	bowHalf(m, base, 0, -8, 11, 21, -1, 5, hull, sol)
	bowHalf(m, base, 0, 8, 11, 21, -1, 5, hull, sol)
	Kit.Part(m, V(16.3, 0.8, 30.2), base * CFrame.new(0, 3.6, -4), teal, { Mat = WOOD })
	Kit.Part(m, V(15, 0.5, 29), base * CFrame.new(0, 5.25, -4), PLANK, { Mat = PLANKS })
	Kit.Part(m, V(16.4, 1.4, 8), base * CFrame.new(0, 0.4, 2), MOSS, { Mat = GRASS })
	-- cabins
	Kit.Part(m, V(11, 5.5, 20), base * CFrame.new(0, 8.25, -4), hull, sol)
	Kit.Part(m, V(11.3, 1.6, 20.3), base * CFrame.new(0, 9.4, -4), C(60, 90, 110))
	Kit.Part(m, V(14, 0.6, 24), base * CFrame.new(0, 11.3, -4), red, { Mat = WOOD })
	Kit.Part(m, V(7, 4, 7), base * CFrame.new(0, 13.6, 0), hull, { Mat = PLANKS })
	Kit.Part(m, V(7.3, 1.3, 7.3), base * CFrame.new(0, 14.2, 0), C(60, 90, 110))
	Kit.Part(m, V(8.5, 0.5, 8.5), base * CFrame.new(0, 15.85, 0), red, { Mat = WOOD })
	-- smokestacks with gold crowns
	for _, s in { -1, 1 } do
		Kit.Cyl(m, 13, 2, base * CFrame.new(s * 3.5, 17.5, 6.5), C(50, 48, 58), { Mat = METAL })
		Kit.Cyl(m, 0.8, 3, base * CFrame.new(s * 3.5, 24.2, 6.5), Kit.Vivid(GOLD), { Mat = METAL })
	end
	-- stern paddle wheel
	local hub = base * CFrame.new(0, 5, -24)
	Kit.CylFlat(m, 10, 13, hub.Position, "X", red, { Mat = WOOD })
	for i = 0, 3 do
		Kit.Part(m, V(10.6, 1, 14), hub * CFrame.Angles(i * math.pi / 4, 0, 0), PLANK_DARK, { Mat = WOOD })
	end
	Kit.CylFlat(m, 18, 1.4, hub.Position, "X", C(60, 60, 70), { Mat = METAL })
	-- name board and a bow lantern
	local board = Kit.Part(m, V(0.4, 1.8, 12), base * CFrame.new(-8.25, 2.2, -4), C(40, 60, 60))
	Kit.Sign(board, Enum.NormalId.Left, "SWAMP QUEEN", Kit.Vivid(C(255, 220, 120)), { Stroke = C(20, 40, 30) })
	Kit.Cyl(m, 4, 0.4, base * CFrame.new(0, 7.5, 16), C(50, 45, 60), { Mat = METAL })
	local lamp = Kit.Part(m, V(1.4, 1.8, 1.4), base * CFrame.new(0, 10, 16), LIME, { Mat = NEON })
	Kit.Light(lamp, LIME, 24, 1.2)
	-- mist over the stranded boat's pond
	local fog = Kit.Part(m, V(40, 0.2, 50), CFrame.new(x, 1, z), C(210, 240, 220), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(210, 240, 220), 1.5, 9, 0.3)
	Kit.AddRect(x - 14, z - 32, x + 14, z + 24)
end

--==================================================================
-- OUTSIDE THE WALLS
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Bayou")
	for _, s in { -1, 1 } do
		-- shallow bayou water over the outer ground, then open water beyond the slab
		Kit.Box(o, V(s * 146, 0, Z0), V(s * 190, 0.1, Z1), WATER, { Transp = 0.15, Refl = 0.15 })
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.4, Z1), WATER_DEEP, { Refl = 0.15 })
		-- cypress silhouettes standing in the water
		for i = 0, 7 do
			local x = s * rng:NextNumber(160, 330)
			local z = Z0 + 20 + i * 45 + rng:NextNumber(-10, 10)
			local h = rng:NextNumber(24, 40)
			local y0 = if math.abs(x) > 190 then -0.4 else 0
			Kit.Cyl(o, h, 2.6, CFrame.new(x, y0 + h / 2, z), BARK_DARK, { Mat = WOOD })
			local col = Kit.Pick(CANOPY)
			Kit.Cyl(o, 3, h * 0.8, CFrame.new(x, y0 + h, z), col, { Mat = GRASS })
			Kit.Ball(o, h * 0.4, V(x + 2, y0 + h + 1.5, z - 1), col:Lerp(Color3.new(1, 1, 1), 0.1), { Mat = GRASS })
			Kit.Part(o, V(0.8, 8, 2.4), CFrame.new(x + h * 0.25, y0 + h - 5, z), HANGMOSS, { Mat = FABRIC, Transp = 0.1 })
		end
		-- low fog banks
		for i = 0, 2 do
			Kit.Cyl(o, 5, rng:NextNumber(70, 110), CFrame.new(s * rng:NextNumber(225, 320), 3, Z0 + 60 + i * 120), C(215, 235, 225), { Transp = 0.7 })
		end
	end
	-- a broken jetty on the -X side
	for k = 0, 4 do
		if k ~= 2 then
			Kit.Box(o, V(-152 - k * 7, 0.2, rz(150)), V(-146 - k * 7, 0.7, rz(156)), PLANK, { Mat = PLANKS })
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Swamp.Build(map: Instance)
	local f = Kit.Folder(map, "Swamp")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	swampKing(f, 100, rz(290))
	paddleBoat(f, 100, rz(95))
	shack(f, 64, rz(34), -1, SHACKS[1], true, true)
	shack(f, -100, rz(50), 1, SHACKS[2], true, false)
	shack(f, -118, rz(192), 1, SHACKS[3], false, false)
	sideWalk(f, -88, -10, rz(50))
	sideWalk(f, -106, -10, rz(192))

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Props.Beam(f, V(x + s * 10, 0, z), V(x + s * 10.6, 13, z + 0.3), 1.4, 1.4, BARK, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "🐸 PHANTOM SWAMP 🐸", C(70, 95, 60), C(220, 255, 170), C(150, 110, 70))
		Kit.AddCircle(x, z, 12)
	end
	do
		local x, z = 22, rz(150)
		if Kit.IsFree(x, z, 4) then
			Kit.Box(f, V(x - 0.3, 0, z - 0.3), V(x + 0.3, 5.5, z + 0.3), BARK, { Mat = WOOD })
			Props.SignBoard(f, V(x, 6.5, z), 11, 4.4, 0, -1, "DON'T FEED\nTHE GATORS", C(240, 230, 200), Kit.Vivid(C(60, 130, 60)), C(120, 90, 60))
			Kit.AddCircle(x, z, 6)
		end
	end

	-- lanterns along the boardwalk (one lit)
	local lit = 0
	for z = Z0 + 46, Z1 - 30, 46 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 23 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.Lantern(f, V(x, 0, zz), C(220, 255, 150), lit == 3, false)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- cypress trees
	local trees = 0
	for _ = 1, 400 do
		if trees >= 17 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 28)
		if Kit.IsFree(x, z, h * 0.375 + 1) then
			trees += 1
			cypress(f, V(x, 0, z), h)
		end
	end

	-- logs, reeds, mushrooms, frogs
	local logs, clumps, shrooms, frogs = 0, 0, 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if logs < 5 and Kit.IsFree(x, z, 6) then
			logs += 1
			fallenLog(f, x, z, rng:NextNumber(0, math.pi), rng:NextNumber(8, 12))
		elseif clumps < 13 and Kit.IsFree(x, z, 2) then
			clumps += 1
			reeds(f, x, z)
		elseif shrooms < 6 and Kit.IsFree(x, z, 3) then
			shrooms += 1
			mushrooms(f, x, z, shrooms <= 2)
		elseif frogs < 3 and Kit.IsFree(x, z, 3) then
			frogs += 1
			frog(f, x, z, -x, 0)
		end
	end

	-- fireflies: small glowing dots, a few of them bobbing
	local flies = 0
	for _ = 1, 300 do
		if flies >= 10 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 12 and Kit.IsFree(x, z, 2, true) then
			flies += 1
			local p = Kit.Ball(f, 0.6, V(x, rng:NextNumber(2.5, 6), z), Kit.Pick({ LIME, C(255, 240, 140) }), { Mat = NEON, Name = "Firefly" })
			if flies <= 5 then
				Kit.Float(p, rng:NextNumber(0.8, 1.4))
			end
		end
	end

	outside(f)
end

return Swamp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Throne</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 16: The Ghost King's Throne (Z 5200..5560), the final area. A floating royal palace in
-- the clouds: white marble, gold, royal purple and soft lavender.
--   Ground: marble slab + royal purple carpet along X = 0 with gold borders.
--   Ghost areas get flat gold-and-lavender medallions ((0,5285) r30, (-82,5320) r24,
--   (75,5380) r26, (-62,5440) r24); the boss area (0,5505) r28 is the royal seal. Nothing
--   stands in or above the boss circle (the Ghost King is huge and hovers at Y ~14).
--   Grand colonnades at X +-22 (Z 5325..5465) with banners, golden ghost-king statues,
--   floating chandeliers over the carpet (Y ~55), golden urns, lavender planters.
--   Grand final backdrop BEHIND the end of the play area (Z >= 5557, past the boss circle and
--   clear of the route check): the gigantic throne (crown tip ~Y 142, seen from the Inferno),
--   twin grand staircases up to a palace terrace, the palace facade with corner towers and the
--   "THE END... FOR NOW" banner. Cloud banks outside the side walls and behind the palace.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Throne = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local MARBLE = Enum.Material.Marble
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric

local Z0, Z1 = 5200, 5560
local BACK = Z1 - 3 -- the backdrop starts here (route check ends at Z1 - 4)

local WHITE = C(245, 242, 250)
local MARBLE_L = C(225, 215, 245) -- soft lavender marble
local LAVENDER = C(190, 160, 240)
local PURPLE = C(120, 65, 185)
local PURPLE_D = C(80, 40, 130)
local GOLD = C(255, 210, 90)
local CLOUD = C(250, 250, 255)
local CLOUD_S = C(225, 225, 245)
local WARM = C(255, 225, 160)

local GOLD_M: Kit.Opts = { Mat = METAL, Refl = 0.15 }
local SOLID_MARBLE: Kit.Opts = { Mat = MARBLE, Solid = true, Shadow = true }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
local function banner(parent: Instance, pos: Vector3, w: number, h: number, fx: number, fz: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(parent, V(w, h, 0.3), cf, color, { Mat = FABRIC })
	-- little crown emblem
	Kit.Part(parent, V(w * 0.5, w * 0.18, 0.2), cf * CFrame.new(0, h * 0.12, -0.22), gold, { Mat = METAL })
	for i = -1, 1 do
		Kit.Part(parent, V(w * 0.1, w * 0.18, 0.2), cf * CFrame.new(i * w * 0.2, h * 0.12 + w * 0.17, -0.22), gold, { Mat = METAL })
	end
	Kit.Part(parent, V(w + 1, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.2, 0), gold, { Mat = METAL })
	Kit.Part(parent, V(w, 0.6, 0.36), cf * CFrame.new(0, -h / 2 + 0.3, 0), gold, { Mat = FABRIC })
end

local function cloud(parent: Instance, pos: Vector3, d: number)
	local rng = Kit.Rng
	Kit.Ball(parent, d, pos, CLOUD, { Mat = Enum.Material.SmoothPlastic })
	Kit.Ball(parent, d * 0.7, pos + V(d * 0.45, -d * 0.12, rng:NextNumber(-d, d) * 0.25), CLOUD_S)
	Kit.Ball(parent, d * 0.6, pos + V(-d * 0.42, -d * 0.15, rng:NextNumber(-d, d) * 0.25), CLOUD)
end

-- Golden ghost-king statue facing (fx, fz).
local function statue(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "GoldenStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(m, V(8, 4, 8), base * CFrame.new(0, 2, 0), WHITE, SOLID_MARBLE)
	Kit.Part(m, V(8.6, 0.8, 8.6), base * CFrame.new(0, 4.2, 0), gold, GOLD_M)
	Kit.Cyl(m, 7, 5.6, base * CFrame.new(0, 8, 0), gold, GOLD_M)
	Kit.Ball(m, 7, (base * CFrame.new(0, 12, 0)).Position, gold, GOLD_M)
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 2.2, (base * CFrame.new(sx * 3.4, 10, -0.6)).Position, gold, GOLD_M)
		Kit.Ball(m, 1.2, (base * CFrame.new(sx * 1.2, 12.6, -3.1)).Position, C(40, 30, 60))
	end
	Kit.Ball(m, 1, (base * CFrame.new(0, 11, -3.3)).Position, C(40, 30, 60))
	Kit.Cyl(m, 1.4, 5, base * CFrame.new(0, 15.6, 0), gold, GOLD_M)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(m, V(1, 2.2, 1), base * CFrame.new(math.cos(a) * 1.9, 17.2, math.sin(a) * 1.9), gold, GOLD_M)
	end
	Kit.Ball(m, 1.2, (base * CFrame.new(0, 16, -2.5)).Position, Kit.Vivid(PURPLE), { Refl = 0.3 })
	Kit.AddCircle(x, z, 5.5)
end

local function urn(parent: Instance, x: number, z: number, light: boolean, flicker: boolean)
	local m = Kit.Model(parent, "GoldenUrn")
	local gold = Kit.Vivid(GOLD)
	Kit.Box(m, V(x - 2, 0, z - 2), V(x + 2, 3.5, z + 2), WHITE, SOLID_MARBLE)
	Kit.Cyl(m, 1.4, 1.6, CFrame.new(x, 4.2, z), gold, GOLD_M)
	Kit.Ball(m, 4, V(x, 6.2, z), gold, GOLD_M)
	Kit.Cyl(m, 0.6, 4.4, CFrame.new(x, 7.8, z), gold, GOLD_M)
	local flame = Kit.Ball(m, 2.6, V(x, 8.8, z), C(255, 220, 150), { Mat = NEON, Transp = 0.1 })
	if light then
		Kit.Light(flame, WARM, 26, 1.5, flicker)
	end
	Kit.AddCircle(x, z, 3)
end

local function planter(parent: Instance, x: number, z: number)
	Kit.Box(parent, V(x - 2.4, 0, z - 2.4), V(x + 2.4, 2.4, z + 2.4), MARBLE_L, { Mat = MARBLE, Solid = true })
	Kit.Box(parent, V(x - 2.6, 2.4, z - 2.6), V(x + 2.6, 2.8, z + 2.6), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Ball(parent, 4.6, V(x, 4.6, z), C(150, 200, 140), { Mat = Enum.Material.Grass })
	Kit.Ball(parent, 2, V(x + 1, 6.4, z - 0.6), Kit.Vivid(LAVENDER))
	Kit.AddCircle(x, z, 3)
end

local function chandelier(parent: Instance, x: number, y: number, z: number)
	local m = Kit.Model(parent, "Chandelier")
	local gold = Kit.Vivid(GOLD)
	Kit.Cyl(m, 1.2, 16, CFrame.new(x, y, z), gold, GOLD_M)
	Kit.Cyl(m, 1, 9, CFrame.new(x, y + 4, z), gold, GOLD_M)
	Kit.Cyl(m, 6, 1, CFrame.new(x, y + 2, z), gold, GOLD_M)
	Kit.Ball(m, 2.4, V(x, y + 7.6, z), gold, GOLD_M)
	Kit.Ball(m, 3, V(x, y - 2, z), LAVENDER, { Transp = 0.2, Refl = 0.3 })
	for i = 0, 5 do
		local a = i * math.pi / 3
		local cx, cz = x + math.cos(a) * 7.2, z + math.sin(a) * 7.2
		Kit.Cyl(m, 1.8, 0.7, CFrame.new(cx, y + 1.5, cz), C(250, 245, 230))
		local flame = Kit.Ball(m, 0.8, V(cx, y + 2.8, cz), WARM, { Mat = NEON })
		if i == 0 then
			Kit.Light(flame, WARM, 40, 1.4)
		end
	end
end

--==================================================================
-- GROUND, WALLS, CLOUDS
--==================================================================
local function ground(f: Instance)
	local gold = Kit.Vivid(GOLD)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), WHITE, { Mat = MARBLE, Solid = true, Name = "Ground_Throne" })
	-- royal carpet (flat) with gold borders, ending in a gold seal before the backdrop
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), Kit.Vivid(PURPLE), { Mat = FABRIC, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8, 0, Z0), V(s * 9.5, 0.07, Z1), gold, { Mat = FABRIC })
	end
	-- lavender diamond inlays beside the carpet
	for z = Z0 + 40, Z1 - 20, 40 do
		for _, s in { -1, 1 } do
			Kit.Part(f, V(6, 0.04, 6), CFrame.new(s * 15, 0.02, z) * CFrame.Angles(0, math.pi / 4, 0), MARBLE_L, { Mat = MARBLE })
		end
	end
	-- medallions on the ghost areas
	for i, a in AREAS do
		Kit.Disc(f, a[1], a[2], 0.08, a[3] * 2 + 4, 0.08, gold, { Mat = METAL })
		Kit.Disc(f, a[1], a[2], 0.11, a[3] * 2, 0.11, if i % 2 == 0 then MARBLE_L else C(235, 228, 250), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.14, 12, 0.14, Kit.Vivid(LAVENDER), { Mat = MARBLE })
		Kit.Disc(f, a[1], a[2], 0.17, 5, 0.17, gold, { Mat = METAL })
	end
	-- boss: the royal seal (purple, gold rings, flat gold crown and glowing star points)
	Kit.Disc(f, 0, BOSS_Z, 0.08, 62, 0.08, gold, { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.11, 58, 0.11, PURPLE_D, { Mat = MARBLE })
	Kit.Disc(f, 0, BOSS_Z, 0.14, 42, 0.03, gold, { Mat = METAL })
	Kit.Disc(f, 0, BOSS_Z, 0.16, 40, 0.05, Kit.Vivid(PURPLE), { Mat = MARBLE })
	Kit.Box(f, V(-9, 0.16, BOSS_Z - 4), V(9, 0.2, BOSS_Z + 1), gold, { Mat = METAL })
	for i = -2, 2 do
		local h = if i == 0 then 9 else (if math.abs(i) == 1 then 6 else 7.5)
		Kit.Box(f, V(i * 4 - 1.1, 0.16, BOSS_Z + 1), V(i * 4 + 1.1, 0.2, BOSS_Z + 1 + h), gold, { Mat = METAL })
	end
	for i = 0, 7 do
		local a = i * math.pi / 4
		Kit.Part(f, V(1.6, 0.06, 1.6), CFrame.new(math.cos(a) * 25, 0.18, BOSS_Z + math.sin(a) * 25) * CFrame.Angles(0, math.pi / 4, 0), C(255, 235, 150), { Mat = NEON })
	end
end

local function sideWalls(f: Instance)
	local gold = Kit.Vivid(GOLD)
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 14, z1), WHITE, SOLID_MARBLE)
		Kit.Box(f, V(s * 139.5, 14, z0), V(s * 146.5, 15, z1), gold, GOLD_M)
		Kit.Box(f, V(s * 139.7, 9, z0), V(s * 140, 10.2, z1), Kit.Vivid(LAVENDER), { Mat = MARBLE })
		for z = z0 + 12, z1 - 6, 36 do
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 18, z + 2.5), MARBLE_L, SOLID_MARBLE)
			Kit.Ball(f, 3.4, V(s * 143, 19.6, z), gold, GOLD_M)
		end
	end
end

local function clouds(f: Instance)
	local rng = Kit.Rng
	for i = 0, 6 do
		local z = Z0 + 20 + i * 54
		for _, s in { -1, 1 } do
			cloud(f, V(s * rng:NextNumber(166, 186), rng:NextNumber(-8, 4), z + s * 10), rng:NextNumber(30, 44))
		end
	end
	-- high drifting cloud puffs outside the walls
	for _, p in { V(-200, 70, Z0 + 90), V(205, 85, Z0 + 200), V(-210, 95, Z0 + 330), V(200, 60, Z0 + 380) } do
		cloud(f, p, rng:NextNumber(24, 34))
	end
end

--==================================================================
-- COLONNADES AND HALL DECOR
--==================================================================
local function colonnade(f: Instance)
	local gold = Kit.Vivid(GOLD)
	local zs = { Z0 + 125, Z0 + 153, Z0 + 181, Z0 + 209, Z0 + 237, Z0 + 265 }
	for _, s in { -1, 1 } do
		local x = s * 22
		local built = 0
		for i, z in zs do
			if Kit.IsFree(x, z, 3.5) then
				built += 1
				Kit.Box(f, V(x - 2.8, 0, z - 2.8), V(x + 2.8, 2, z + 2.8), MARBLE_L, SOLID_MARBLE)
				Kit.Cyl(f, 28, 4, CFrame.new(x, 16, z), WHITE, SOLID_MARBLE)
				Kit.Box(f, V(x - 2.8, 30, z - 2.8), V(x + 2.8, 31.6, z + 2.8), gold, GOLD_M)
				if i % 2 == 1 then
					banner(f, V(x - s * 2.2, 18, z), 4, 12, -s, 0, if s < 0 then PURPLE else Kit.Vivid(LAVENDER))
				end
				Kit.AddCircle(x, z, 3.5)
			end
		end
		if built == #zs then
			Kit.Box(f, V(x - 2.6, 31.6, zs[1] - 2.8), V(x + 2.6, 34.4, zs[#zs] + 2.8), WHITE, { Mat = MARBLE, Shadow = true })
			Kit.Box(f, V(x - 2.8, 34.4, zs[1] - 3), V(x + 2.8, 35, zs[#zs] + 3), gold, GOLD_M)
		end
	end
end

local function decor(f: Instance)
	for _, p in { { -40, Z0 + 52 }, { 40, Z0 + 52 }, { -42, Z1 - 16 }, { 42, Z1 - 16 } } do
		if Kit.IsFree(p[1], p[2], 5.5) then
			statue(f, p[1], p[2], 0, -1)
		end
	end
	for i, p in { { -15, Z0 + 46 }, { 15, Z0 + 46 }, { -36, Z0 + 290 }, { 36, Z0 + 290 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			urn(f, p[1], p[2], i == 2 or i == 3, i == 3)
		end
	end
	for _, p in { { -36, Z0 + 140 }, { 36, Z0 + 140 }, { -36, Z0 + 196 }, { 36, Z0 + 250 }, { 110, Z0 + 60 }, { -110, Z0 + 60 }, { 120, Z0 + 280 }, { -120, Z0 + 180 } } do
		if Kit.IsFree(p[1], p[2], 3) then
			planter(f, p[1], p[2])
		end
	end
	chandelier(f, 0, 54, Z0 + 155)
	chandelier(f, 0, 54, Z0 + 225)
	-- floating golden orbs and crowns (single tagged parts, outside the ghost areas)
	local gold = Kit.Vivid(GOLD)
	for i, p in { V(-40, 26, Z0 + 150), V(44, 30, Z0 + 120), V(-112, 28, Z0 + 190), V(116, 24, Z0 + 270), V(42, 32, Z0 + 250) } do
		local part: Part
		if i % 2 == 0 then
			part = Kit.Cyl(f, 1.4, 3, CFrame.new(p), gold, { Mat = METAL, Name = "FloatingCrown" })
		else
			part = Kit.Ball(f, 2.6, p, Kit.Vivid(LAVENDER), { Refl = 0.3, Name = "FloatingOrb" })
		end
		Kit.Float(part, 1.5)
	end
	-- low cloud tufts along the inner wall foot
	for _, p in { V(-132, 0, Z0 + 60), V(132, 0, Z0 + 110), V(-132, 0, Z0 + 290), V(132, 0, Z0 + 330), V(-132, 0, Z0 + 200) } do
		if Kit.IsFree(p.X, p.Z, 5) then
			Kit.Ball(f, 10, p + V(0, 1, 0), CLOUD)
			Kit.Ball(f, 7, p + V(0, 2, 5), CLOUD_S)
			Kit.AddCircle(p.X, p.Z, 6)
		end
	end
end

--==================================================================
-- GRAND FINAL BACKDROP (behind the end of the play area)
--==================================================================
local function backdrop(f: Instance)
	local m = Kit.Model(f, "GrandBackdrop")
	local gold = Kit.Vivid(GOLD)
	local TOP = 33.6 -- terrace height
	-- marble base under everything past the end of the zone
	Kit.Box(m, V(-190, -4, Z1), V(190, 0, Z1 + 90), WHITE, { Mat = MARBLE, Solid = true })

	-- twin grand staircases rising away from the hall (X +-34..140)
	local steps = 14
	local run = 3.2
	local rise = TOP / steps
	for i = 0, steps - 1 do
		local z = BACK + i * run
		local col = if i % 2 == 0 then WHITE else MARBLE_L
		for _, s in { -1, 1 } do
			Kit.Box(m, V(s * 34, 0, z), V(s * 146, rise * (i + 1), BACK + steps * run + 4), col, { Mat = MARBLE, Solid = i < 2, Shadow = true })
		end
	end
	local stairEnd = BACK + steps * run
	for _, s in { -1, 1 } do
		Props.Beam(m, V(s * 34.5, 3, BACK + 0.5), V(s * 34.5, TOP + 3, stairEnd), 0.6, 0.6, gold, GOLD_M)
		for i = 0, 3 do
			local t = i / 3
			local p = V(s * 34.5, rise + (TOP - rise) * t, BACK + 0.5 + (stairEnd - BACK - 0.5) * t)
			Kit.Box(m, p + V(-0.5, 0, -0.5), p + V(0.5, 3.4, 0.5), gold, GOLD_M)
		end
	end
	-- terrace behind the throne and stairs
	Kit.Box(m, V(-146, 0, stairEnd), V(146, TOP, Z1 + 80), WHITE, { Mat = MARBLE })
	Kit.Box(m, V(-146, TOP - 1, stairEnd - 0.3), V(146, TOP, stairEnd), gold, GOLD_M)

	-- palace facade with arched windows
	local fz = stairEnd + 14
	Kit.Box(m, V(-122, TOP, fz), V(122, 98, fz + 8), WHITE, { Mat = MARBLE, Shadow = true })
	Kit.Box(m, V(-123, 96, fz - 0.6), V(123, 99, fz + 8.6), gold, GOLD_M)
	Kit.Box(m, V(-121, TOP, fz - 0.4), V(121, TOP + 2, fz), MARBLE_L, { Mat = MARBLE })
	for _, x in { -100, -70, 70, 100 } do
		Kit.Box(m, V(x - 6, 44, fz - 0.4), V(x + 6, 74, fz), gold, GOLD_M)
		Kit.Box(m, V(x - 5, 45, fz - 0.6), V(x + 5, 73, fz - 0.2), Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15, Refl = 0.2 })
		Kit.CylFlat(m, 0.6, 12, V(x, 74, fz - 0.4), "Z", gold, GOLD_M)
		Kit.CylFlat(m, 0.6, 10, V(x, 74, fz - 0.5), "Z", Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15 })
	end
	-- corner towers with gold domes and flags
	for _, s in { -1, 1 } do
		local tx, tz = s * 132, stairEnd + 10
		Kit.Cyl(m, 120, 22, CFrame.new(tx, 60, tz), WHITE, { Mat = MARBLE, Shadow = true })
		Kit.Cyl(m, 2, 24, CFrame.new(tx, 92, tz), gold, GOLD_M)
		Kit.Cyl(m, 3, 25, CFrame.new(tx, 121, tz), MARBLE_L, { Mat = MARBLE })
		Kit.Ball(m, 22, V(tx, 124, tz), gold, GOLD_M)
		Kit.Cyl(m, 18, 1, CFrame.new(tx, 142, tz), gold, GOLD_M)
		Kit.Part(m, V(0.3, 5, 9), CFrame.new(tx, 148, tz - 4.6), Kit.Vivid(PURPLE), { Mat = FABRIC })
		for _, y in { 50, 80 } do
			Kit.Box(m, V(tx - s * 11.2 - 1.6, y, tz - 3), V(tx - s * 11.2 + 1.6, y + 8, tz + 3), Kit.Vivid(PURPLE), { Mat = Enum.Material.Glass, Transp = 0.15 })
		end
	end
	-- the big farewell banners on the facade
	local endSign = Props.SignBoard(m, V(84, 84, fz - 0.8), 64, 9, 0, -1, "THE END... FOR NOW", PURPLE_D, gold, GOLD)
	Kit.Light(endSign, WARM, 50, 1.2)
	Props.SignBoard(m, V(-84, 84, fz - 0.8), 64, 9, 0, -1, "THANKS FOR HUNTING!", PURPLE_D, gold, GOLD)
	for _, x in { -84, 84 } do
		for _, dx in { -33, 33 } do
			Kit.Wedge(m, V(4, 8, 1), CFrame.new(x + dx, 78, fz - 0.9) * CFrame.Angles(math.pi / 2, 0, 0), Kit.Vivid(PURPLE), { Mat = FABRIC })
		end
	end

	-- THE THRONE (dais front at the end of the play area; seat faces the hall)
	local tz = BACK + 2 -- front of the dais
	for i = 0, 2 do
		local z = tz + i * 4
		Kit.Box(m, V(-32 + i * 2, i * 3, z), V(32 - i * 2, (i + 1) * 3, stairEnd), if i % 2 == 0 then WHITE else MARBLE_L, { Mat = MARBLE, Shadow = true })
		Kit.Box(m, V(-32 + i * 2, (i + 1) * 3 - 0.5, z - 0.2), V(32 - i * 2, (i + 1) * 3, z), gold, GOLD_M)
	end
	local seatZ = tz + 13
	Kit.Box(m, V(-20, 9, seatZ), V(20, 30, seatZ + 16), Kit.Vivid(PURPLE), { Mat = FABRIC, Shadow = true })
	Kit.Box(m, V(-20.4, 26, seatZ - 0.4), V(20.4, 27.2, seatZ + 16), gold, GOLD_M)
	Kit.Box(m, V(-18, 30, seatZ - 1), V(18, 34, seatZ + 14), Kit.Vivid(LAVENDER), { Mat = FABRIC })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 20, 9, seatZ - 4), V(s * 27, 42, seatZ + 20), gold, GOLD_M)
		Kit.Ball(m, 8, V(s * 23.5, 45, seatZ - 3), gold, GOLD_M)
		Kit.Ball(m, 3, V(s * 23.5, 50, seatZ - 3), Kit.Vivid(PURPLE), { Refl = 0.3 })
		Kit.Box(m, V(s * 22, 9, seatZ + 14), V(s * 27, 126, seatZ + 21), gold, GOLD_M)
	end
	Kit.Box(m, V(-22, 30, seatZ + 14), V(22, 120, seatZ + 20), Kit.Vivid(PURPLE), { Mat = FABRIC, Shadow = true })
	Kit.Box(m, V(-27, 120, seatZ + 13.5), V(27, 126, seatZ + 21), gold, GOLD_M)
	-- friendly ghost emblem on the backrest
	Kit.Ball(m, 20, V(0, 82, seatZ + 17), C(250, 248, 255))
	Kit.Box(m, V(-10, 62, seatZ + 13.4), V(10, 82, seatZ + 15), C(250, 248, 255))
	for _, sx in { -1, 1 } do
		Kit.Ball(m, 3.6, V(sx * 4, 85, seatZ + 7.6), C(45, 30, 70))
	end
	Kit.Ball(m, 3, V(0, 78, seatZ + 7.6), C(45, 30, 70))
	-- the crown on top
	local cz = seatZ + 17
	Kit.Cyl(m, 6, 28, CFrame.new(0, 129, cz), gold, GOLD_M)
	for i = -2, 2 do
		local h = if i == 0 then 14 else (if math.abs(i) == 1 then 10 else 8)
		Kit.Box(m, V(i * 6 - 2, 132, cz - 2), V(i * 6 + 2, 132 + h, cz + 2), gold, GOLD_M)
		Kit.Ball(m, 3.4, V(i * 6, 133 + h, cz), if i == 0 then C(255, 120, 160) else Kit.Vivid(LAVENDER), { Refl = 0.3 })
	end
	local gem = Kit.Ball(m, 6, V(0, 129, cz - 13.4), C(210, 150, 255), { Mat = NEON })
	Kit.Light(gem, C(210, 160, 255), 60, 2)
	local sparkle = Kit.Part(m, V(30, 4, 6), CFrame.new(0, 136, cz), gold, { Transp = 1, Name = "SparkleSource" })
	Kit.Emitter(sparkle, C(255, 230, 140), 4, 2, 1.5)
	Props.SignBoard(m, V(0, 1.5, tz - 0.4), 34, 2.6, 0, -1, "THE GHOST KING'S THRONE", PURPLE_D, gold)

	-- clouds hugging the back of the palace
	for i = -3, 3 do
		cloud(m, V(i * 50, Kit.Rng:NextNumber(20, 40), Z1 + 92), Kit.Rng:NextNumber(40, 56))
	end
	local mist = Kit.Part(m, V(260, 1, 20), CFrame.new(0, 34, Z1 + 70), CLOUD, { Transp = 1, Name = "CloudMist" })
	Kit.Emitter(mist, C(250, 250, 255), 3, 16, 0.5)
end

--==================================================================
-- BUILD
--==================================================================
function Throne.Build(map: Instance)
	local f = Kit.Folder(map, "Throne")
	ground(f)
	sideWalls(f)
	clouds(f)
	colonnade(f)
	decor(f)
	backdrop(f)
end

return Throne
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Tomb</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 11: Pharaoh's Tomb (Z 3400..3760). A sunny desert temple: sand, gold and turquoise.
--   Ground: sand slab (top Y = 0). Main path along X = 0: sandstone paving (X -8..8, top 0.05)
--   with turquoise edges and terracotta seams.
--   Ghost areas hold flat paint only: a sun mosaic on the path (0, 3485), tiled circles, the
--   OASIS (flat turquoise water on solid sand) at (75, 3580) and the Pharaoh's seal with a big
--   painted eye around the boss (0, 3705).
--   Landmark: a huge step pyramid outside the +X wall (centre X 226, Z 3650, ~105 tall) with
--   its entrance facing the valley, and a smaller one outside the -X wall; both read from the
--   Frost zone.
--   Also: a colonnade of painted sandstone columns with lintels over the path (Z 3530..3600),
--   two pairs of obelisks, a cute sphinx-cat statue (-100, 3700) facing the path, palm trees
--   around the oasis, golden treasure piles, urns, broken columns and torches.
--   Side walls: sandstone with a terracotta cap and a painted hieroglyph band.
--   Outside: dunes and palms on open sand.
-- Glow: torch flames, the eye above the pyramid entrance and a few turquoise glints in the seal.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Tomb = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SAND = Enum.Material.Sand
local SANDSTONE = Enum.Material.Sandstone
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local GRASS = Enum.Material.Grass

local Z0, Z1 = 3400, 3760

local SANDC = C(238, 208, 150)
local SAND_DARK = C(222, 188, 128)
local STONE = C(224, 190, 132)
local STONE_DARK = C(196, 160, 106)
local PAVE = C(214, 178, 122)
local GOLD = C(255, 200, 60)
local TURQ = C(60, 200, 210)
local TERRA = C(206, 104, 70)
local LAPIS = C(50, 90, 190)
local FLAME = C(255, 160, 60)
local WATER = C(70, 200, 205)
local PALM = { C(70, 160, 70), C(90, 180, 80), C(60, 145, 85) }
local TRUNK = C(150, 110, 70)

local function rz(n: number): number
	return Z0 + n
end

--==================================================================
-- PROPS
--==================================================================
local function palm(parent: Instance, pos: Vector3, h: number)
	local rng = Kit.Rng
	local lean = rng:NextNumber(-1, 1)
	local a = rng:NextNumber(0, math.pi * 2)
	local dir = V(math.cos(a), 0, math.sin(a))
	local pts = { pos, pos + V(0, h * 0.4, 0) + dir * lean * 0.6, pos + V(0, h * 0.75, 0) + dir * lean * 1.8, pos + V(0, h, 0) + dir * lean * 3.2 }
	for i = 1, 3 do
		Props.Beam(parent, pts[i], pts[i + 1], 1.9 - i * 0.2, 1.9 - i * 0.2, if i % 2 == 0 then TRUNK else TRUNK:Lerp(Color3.new(1, 1, 1), 0.12), { Mat = WOOD, Solid = i == 1, Shadow = true })
	end
	local top = pts[4]
	local col = Kit.Pick(PALM)
	for k = 0, 4 do
		local fa = k * math.pi * 2 / 5 + rng:NextNumber(-0.2, 0.2)
		local len = h * 0.42
		local tip = top + V(math.cos(fa) * len, -h * 0.14, math.sin(fa) * len)
		local mid = (top + tip) / 2 + V(0, 0.8, 0)
		Kit.Part(parent, V(2.6, 0.3, len + 1), CFrame.lookAt(mid, tip) * CFrame.Angles(0, 0, 0), col, { Mat = GRASS })
	end
	Kit.Ball(parent, 1.3, top + V(0.6, -0.9, 0.3), C(120, 80, 45))
	Kit.Ball(parent, 1.3, top + V(-0.5, -1, -0.4), C(120, 80, 45))
	Kit.AddCircle(pos.X, pos.Z, h * 0.42 + 3)
end

local function obelisk(parent: Instance, x: number, z: number, h: number)
	local m = Kit.Model(parent, "Obelisk")
	Kit.Box(m, V(x - 3.5, 0, z - 3.5), V(x + 3.5, 1.6, z + 3.5), STONE_DARK, { Mat = SANDSTONE, Solid = true })
	Kit.Box(m, V(x - 2.2, 1.6, z - 2.2), V(x + 2.2, h * 0.55, z + 2.2), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1.8, h * 0.55, z - 1.8), V(x + 1.8, h, z + 1.8), STONE, { Mat = SANDSTONE, Shadow = true })
	Kit.Part(m, V(2.6, 2.6, 2.6), CFrame.new(x, h + 0.3, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Kit.Vivid(GOLD), { Mat = METAL, Refl = 0.2 })
	-- painted hieroglyph band
	Kit.Box(m, V(x - 2.3, h * 0.3, z - 2.3), V(x + 2.3, h * 0.3 + 1, z + 2.3), Kit.Vivid(TURQ))
	local panel = Kit.Box(m, V(x - 1.6, h * 0.36, z - 2.35), V(x + 1.6, h * 0.5, z - 2.25), Kit.Vivid(TERRA))
	Kit.Sign(panel, Enum.NormalId.Front, "☥\n👁\n☀", C(255, 245, 210), { Stroke = C(90, 40, 20) })
	Kit.AddCircle(x, z, 4.5)
end

local function column(parent: Instance, x: number, z: number, h: number)
	Kit.Box(parent, V(x - 2.6, 0, z - 2.6), V(x + 2.6, 1.4, z + 2.6), STONE_DARK, { Mat = SANDSTONE, Solid = true })
	Kit.Cyl(parent, h - 3.4, 3.6, CFrame.new(x, 1.4 + (h - 3.4) / 2, z), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
	Kit.Cyl(parent, 1.2, 3.9, CFrame.new(x, h * 0.62, z), Kit.Vivid(TURQ))
	Kit.Cyl(parent, 0.6, 3.9, CFrame.new(x, h * 0.62 + 1.2, z), Kit.Vivid(TERRA))
	Kit.Box(parent, V(x - 2.8, h - 2, z - 2.8), V(x + 2.8, h, z + 2.8), STONE_DARK, { Mat = SANDSTONE })
end

local function torch(parent: Instance, x: number, z: number, lit: boolean, flicker: boolean)
	Kit.Box(parent, V(x - 0.5, 0, z - 0.5), V(x + 0.5, 6, z + 0.5), STONE_DARK, { Mat = SANDSTONE })
	Kit.Cyl(parent, 1.2, 2.4, CFrame.new(x, 6.6, z), Kit.Vivid(GOLD), { Mat = METAL })
	local flame = Kit.Part(parent, V(1.3, 1.3, 1.3), CFrame.new(x, 7.6, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), FLAME, { Mat = NEON })
	if lit then
		Kit.Light(flame, C(255, 180, 90), 22, 1.5, flicker)
	end
end

local function urn(parent: Instance, x: number, z: number, s: number)
	local col = if Kit.Rng:NextNumber() < 0.5 then TERRA else C(190, 120, 70)
	Kit.Ball(parent, 2.4 * s, V(x, 1.2 * s, z), col, { Solid = true })
	Kit.Cyl(parent, 1.1 * s, 1.1 * s, CFrame.new(x, 2.6 * s, z), col)
	Kit.Cyl(parent, 0.3 * s, 1.5 * s, CFrame.new(x, 3.2 * s, z), Kit.Vivid(TURQ))
end

local function treasure(parent: Instance, x: number, z: number, sparkle: boolean)
	local m = Kit.Model(parent, "Treasure")
	local gold = Kit.Vivid(GOLD)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.25 }
	Kit.Ball(m, 9, V(x, -2.2, z), gold, mo)
	Kit.Ball(m, 6, V(x + 4, -1.6, z - 3.5), gold, mo)
	Kit.Ball(m, 5, V(x - 4, -1.4, z + 3), gold, mo)
	-- chest
	local wood = C(150, 90, 50)
	Kit.Box(m, V(x - 2.7, 0, z + 2), V(x + 2.7, 3, z + 5.4), wood, { Mat = WOOD, Solid = true })
	Kit.CylFlat(m, 5.4, 3.4, V(x, 3, z + 3.7), "X", wood, { Mat = WOOD })
	Kit.Box(m, V(x - 2.9, 1.4, z + 1.9), V(x + 2.9, 2, z + 5.5), gold, { Mat = METAL })
	-- gems, a golden mask and coins
	for i, g in { C(230, 60, 90), TURQ, C(170, 90, 240) } do
		Kit.Part(m, V(1.2, 1.2, 1.2), CFrame.new(x - 2.5 + i * 1.3, 2.3 - i * 0.3, z - 1 + i * 0.5) * CFrame.Angles(0.6, 0.4, 0.6), Kit.Vivid(g), { Refl = 0.3 })
	end
	Kit.Part(m, V(2.6, 3.2, 0.8), CFrame.new(x + 1.5, 3, z - 1.2) * CFrame.Angles(-0.4, 0.3, 0), gold, mo)
	for i = 0, 2 do
		local a = i * 2.1
		Kit.Disc(m, x + math.cos(a) * 6, z + math.sin(a) * 6, 0.2, 1.8, 0.2, gold, mo)
	end
	if sparkle then
		local src = Kit.Part(m, V(8, 1, 8), CFrame.new(x, 3, z), gold, { Transp = 1, Name = "SparkleSource" })
		local e = Kit.Emitter(src, C(255, 230, 120), 3, 0.6, 1.2)
		if e then
			e.Size = NumberSequence.new(0.5)
			e.Lifetime = NumberRange.new(1.5, 3)
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		end
		Kit.Light(src, C(255, 210, 120), 18, 1)
	end
	Kit.AddCircle(x, z, 7.5)
end

-- Cute sphinx-cat lying on a plinth, facing (fx, 0).
local function sphinxCat(parent: Instance, x: number, z: number, fx: number)
	local m = Kit.Model(parent, "SphinxCat")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local stone: Kit.Opts = { Mat = SANDSTONE, Solid = true, Shadow = true }
	local fur = C(232, 198, 140)
	Kit.Part(m, V(18, 4, 36), base * CFrame.new(0, 2, 0), STONE_DARK, stone)
	Kit.Part(m, V(18.4, 1, 36.4), base * CFrame.new(0, 3.2, 0), Kit.Vivid(TURQ), { Mat = SANDSTONE })
	-- body, haunch, paws
	Kit.Part(m, V(12, 9, 22), base * CFrame.new(0, 8.5, 3), fur, stone)
	Kit.Ball(m, 12, (base * CFrame.new(0, 9, 12)).Position, fur, stone)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(3.6, 3, 11), base * CFrame.new(s * 3.6, 5.5, -11), fur, stone)
		Kit.Ball(m, 3.8, (base * CFrame.new(s * 3.6, 5.6, -16.4)).Position, fur, { Mat = SANDSTONE })
	end
	-- head with nemes headdress
	local head = base * CFrame.new(0, 17, -8)
	Kit.Part(m, V(10, 9, 9), head, fur, stone)
	for _, s in { -1, 1 } do
		Kit.Wedge(m, V(1.6, 4, 3.4), head * CFrame.new(s * 3.2, 6.4, 0.5) * CFrame.Angles(0, math.pi, 0), fur, { Mat = SANDSTONE })
		-- striped headdress flaps
		Kit.Part(m, V(1.6, 10, 5), head * CFrame.new(s * 5.6, -1.5, 1.5), Kit.Vivid(LAPIS), { Mat = SANDSTONE })
		Kit.Part(m, V(1.8, 1.4, 5.2), head * CFrame.new(s * 5.6, 0.5, 1.5), Kit.Vivid(GOLD), { Mat = METAL })
		Kit.Part(m, V(1.8, 1.4, 5.2), head * CFrame.new(s * 5.6, -3.5, 1.5), Kit.Vivid(GOLD), { Mat = METAL })
		-- big friendly eyes
		Kit.Part(m, V(2.2, 2.6, 0.4), head * CFrame.new(s * 2.4, 1, -4.6), Kit.Vivid(TURQ))
		Kit.Part(m, V(0.9, 1.6, 0.3), head * CFrame.new(s * 2.4, 1, -4.85), C(30, 30, 45))
	end
	Kit.Part(m, V(10.4, 1.4, 9.4), head * CFrame.new(0, 3.6, 0), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(1.4, 0.9, 0.4), head * CFrame.new(0, -1.2, -4.6), Kit.Vivid(C(255, 140, 170)))
	-- gold collar and a curled tail
	Kit.Part(m, V(12.4, 1.6, 2), base * CFrame.new(0, 12.5, -6.4), Kit.Vivid(GOLD), { Mat = METAL })
	Props.Beam(m, (base * CFrame.new(5, 4.5, 16)).Position, (base * CFrame.new(8, 4.5, 6)).Position, 1.6, 1.6, fur, { Mat = SANDSTONE })
	Props.Beam(m, (base * CFrame.new(8, 4.5, 6)).Position, (base * CFrame.new(7.5, 6.5, 1)).Position, 1.6, 1.6, fur, { Mat = SANDSTONE })
	Kit.AddCircle(x, z, 20)
end

-- Step pyramid centred at (x, z); entrance on the face toward (ex, 0).
local function pyramid(parent: Instance, x: number, z: number, base: number, tiers: number, tierH: number, ex: number, entrance: boolean)
	local m = Kit.Model(parent, "Pyramid")
	for i = 0, tiers - 1 do
		local s = base * (1 - i / tiers)
		Kit.Box(m, V(x - s / 2, i * tierH - (if i == 0 then 2 else 0), z - s / 2), V(x + s / 2, (i + 1) * tierH, z + s / 2), if i % 2 == 0 then STONE else SAND_DARK, { Mat = SANDSTONE, Shadow = true })
	end
	local topY = tiers * tierH
	local cap = base / tiers
	Kit.Part(m, V(cap * 0.9, cap * 0.9, cap * 0.9), CFrame.new(x, topY + cap * 0.1, z) * CFrame.Angles(0, math.pi / 4, 0) * CFrame.Angles(math.pi / 4, 0, 0), Kit.Vivid(GOLD), { Mat = METAL, Refl = 0.3 })
	-- a painted band around the second tier
	local s2 = base * (1 - 1 / tiers)
	Kit.Box(m, V(x - s2 / 2 - 0.2, tierH * 1.4, z - s2 / 2 - 0.2), V(x + s2 / 2 + 0.2, tierH * 1.4 + 1.5, z + s2 / 2 + 0.2), Kit.Vivid(TURQ))
	if entrance then
		-- pylon facade on the face toward the valley: posts, tall lintel with a painted band and
		-- a glowing eye, a dark doorway, torches either side
		local back = x + ex * base / 2 -- the pyramid face
		local front = back + ex * 3 -- the facade's outer face
		local function slab(x1: number, x2: number, y1: number, y2: number, z1: number, z2: number, col: Color3, opts: Kit.Opts?): Part
			return Kit.Box(m, V(x1, y1, z1), V(x2, y2, z2), col, opts)
		end
		local sand: Kit.Opts = { Mat = SANDSTONE }
		slab(front, back, 0, 30, z - 13, z - 9, STONE_DARK, sand)
		slab(front, back, 0, 30, z + 9, z + 13, STONE_DARK, sand)
		slab(front, back, 30, 42, z - 15, z + 15, Kit.Vivid(TERRA), sand)
		slab(back - ex * 0.2, back + ex * 0.3, 0, 30, z - 9, z + 9, C(45, 35, 40))
		local band = slab(front + ex * 0.1, front, 30.8, 34.4, z - 13, z + 13, Kit.Vivid(LAPIS))
		Kit.Sign(band, if ex < 0 then Enum.NormalId.Left else Enum.NormalId.Right, "☥ 👁 ☀ 🐍 ☥", C(255, 240, 200), { Stroke = C(30, 30, 60) })
		local eye = slab(front + ex * 0.3, front, 35.4, 40.4, z - 5, z + 5, Kit.Vivid(TURQ), { Mat = NEON })
		slab(front + ex * 0.4, front, 36.6, 39.2, z - 1.5, z + 1.5, C(30, 30, 50))
		Kit.Light(eye, TURQ, 45, 1.6)
		for _, sz in { -1, 1 } do
			Kit.Cyl(m, 14, 2.6, CFrame.new(front + ex * 1.6, 7, z + sz * 17), STONE, sand)
			Kit.Part(m, V(1.6, 1.6, 1.6), CFrame.new(front + ex * 1.6, 14.8, z + sz * 17) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), FLAME, { Mat = NEON })
		end
		local dust = Kit.Part(m, V(4, 20, 18), CFrame.new(front + ex * 2, 12, z), C(255, 220, 160), { Transp = 1, Name = "DustSource" })
		Kit.Emitter(dust, C(255, 225, 170), 1.2, 6, 0.4)
	end
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SANDC, { Mat = SAND, Solid = true, Name = "Ground_Tomb" })
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PAVE, { Mat = SANDSTONE, Solid = true, Name = "TempleRoad" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.6, 0.05, Z0), V(s * 8 + 0.6, 0.1, Z1), Kit.Vivid(TURQ))
	end
	for z = Z0 + 12, Z1 - 10, 16 do
		Kit.Box(f, V(-7.4, 0.05, z), V(7.4, 0.07, z + 0.5), Kit.Vivid(TERRA))
	end
	-- wind ripples in the sand (flat shading)
	local rng = Kit.Rng
	for _ = 1, 8 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(16, 28), 0.03, rng:NextNumber(8, 16)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), SAND_DARK, { Mat = SAND })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	local glyphs = { "☥  👁  ☀", "🐍  ☥  🐈", "☀  🪲  ☥", "👁  ☥  🐍", "🐈  ☀  ☥" }
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 12, zB), STONE, { Mat = SANDSTONE, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.5, 12, zA), V(s * 146.5, 13.2, zB), Kit.Vivid(TERRA), { Mat = SANDSTONE })
		Kit.Box(f, V(s * 139.9, 7.6, zA), V(s * 139.7, 9.6, zB), Kit.Vivid(TURQ))
		Kit.Box(f, V(s * 139.9, 9.6, zA), V(s * 139.7, 10.2, zB), Kit.Vivid(GOLD))
		for i, z in { rz(40), rz(110), rz(180), rz(250), rz(320) } do
			local p = Kit.Box(f, V(s * 139.95, 2.5, z - 9), V(s * 139.65, 7, z + 9), Kit.Vivid(if i % 2 == 0 then TERRA else LAPIS))
			Kit.Sign(p, if s < 0 then Enum.NormalId.Right else Enum.NormalId.Left, glyphs[i], C(255, 240, 200), { Stroke = C(70, 40, 20) })
		end
		for z = zA + 20, zB - 10, 48 do
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), STONE_DARK, { Mat = SANDSTONE, Solid = true })
			Kit.Ball(f, 3, V(s * 143, 16.4, z), Kit.Vivid(TURQ))
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- mummy spirits: sun mosaic across the road
	local cz = rz(85)
	Kit.Disc(f, 0, cz, 0.04, 64, 0.03, Kit.Vivid(TERRA), { Mat = SANDSTONE })
	Kit.Disc(f, 0, cz, 0.07, 60, 0.03, PAVE, { Mat = SANDSTONE })
	Kit.Disc(f, 0, cz, 0.1, 14, 0.03, Kit.Vivid(GOLD))
	for i = 0, 7 do
		local a = i * math.pi / 4
		Props.Beam(f, V(math.cos(a) * 7, 0.1, cz + math.sin(a) * 7), V(math.cos(a) * 17, 0.1, cz + math.sin(a) * 17), 2.2, 0.04, Kit.Vivid(GOLD))
		local b = a + math.pi / 8
		Kit.Part(f, V(2.4, 0.04, 2.4), CFrame.new(math.cos(b) * 23, 0.1, cz + math.sin(b) * 23) * CFrame.Angles(0, b + math.pi / 4, 0), Kit.Vivid(TURQ))
	end
	-- tiled circles
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 3, 0.03, Kit.Vivid(TURQ))
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, PAVE, { Mat = SANDSTONE })
		Kit.Disc(f, a[1], a[2], 0.1, 10, 0.03, Kit.Vivid(TERRA))
	end
	-- the oasis: turquoise water lying flat on the sand, grass rim
	local ox, oz = 75, rz(180)
	Kit.Disc(f, ox, oz, 0.04, 54, 0.03, C(120, 190, 90), { Mat = GRASS })
	Kit.Disc(f, ox, oz, 0.1, 42, 0.06, WATER, { Transp = 0.2, Refl = 0.2, Name = "Oasis" })
	for _, l in { { 68, rz(174), 4 }, { 84, rz(186), 3.4 }, { 78, rz(166), 3 } } do
		Kit.Disc(f, l[1], l[2], 0.14, l[3], 0.03, Kit.Vivid(C(90, 180, 80)))
	end
	-- boss: the Pharaoh's seal with a big painted eye
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(TERRA), { Mat = SANDSTONE })
	Kit.Disc(f, 0, bz, 0.06, 54, 0.03, Kit.Vivid(GOLD))
	Kit.Disc(f, 0, bz, 0.08, 50, 0.03, PAVE, { Mat = SANDSTONE })
	Kit.Part(f, V(26, 0.04, 12), CFrame.new(0, 0.1, bz), C(250, 245, 230))
	Kit.Disc(f, 0, bz, 0.13, 9, 0.04, Kit.Vivid(TURQ))
	Kit.Disc(f, 0, bz, 0.15, 4, 0.04, C(30, 30, 50))
	Props.Beam(f, V(-13, 0.13, bz - 8), V(13, 0.13, bz - 8), 1.6, 0.04, Kit.Vivid(LAPIS))
	Props.Beam(f, V(-2, 0.13, bz + 6), V(-5, 0.13, bz + 15), 1.4, 0.04, Kit.Vivid(LAPIS))
	Props.Beam(f, V(6, 0.13, bz + 6), V(12, 0.13, bz + 13), 1.4, 0.04, Kit.Vivid(LAPIS))
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(f, V(1.8, 0.05, 1.8), CFrame.new(math.cos(a) * 22, 0.12, bz + math.sin(a) * 22) * CFrame.Angles(0, math.pi / 4, 0), TURQ, { Mat = NEON })
	end
end

--==================================================================
-- OUTSIDE
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Desert")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), SANDC, { Mat = SAND })
		-- dunes
		for i = 0, 4 do
			local x = s * rng:NextNumber(165, 330)
			local z = Z0 + 30 + i * 75 + rng:NextNumber(-15, 15)
			local d = rng:NextNumber(50, 90)
			if not (s > 0 and z > rz(160) and z < rz(340) and math.abs(x) < 310) then
				Kit.Ball(o, d, V(x, -d * 0.36, z), if i % 2 == 0 then SANDC else SAND_DARK, { Mat = SAND })
			end
		end
		-- palms just beyond the wall
		for i = 0, 3 do
			local z = Z0 + 30 + i * 95 + rng:NextNumber(-10, 10)
			if not (s > 0 and z > rz(150) and z < rz(345)) then
				palm(o, V(s * rng:NextNumber(152, 175), 0, z), rng:NextNumber(18, 26))
			end
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Tomb.Build(map: Instance)
	local f = Kit.Folder(map, "Tomb")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	pyramid(f, 226, rz(250), 150, 9, 11.5, -1, true)
	pyramid(f, -222, rz(110), 110, 7, 10, 1, false)
	sphinxCat(f, -100, rz(300), 1)
	treasure(f, 118, rz(262), true)
	treasure(f, 112, rz(56), false)
	treasure(f, -120, rz(232), false)

	-- obelisks: entrance pair and boss pair
	for _, s in { -1, 1 } do
		obelisk(f, s * 16, rz(48), 38)
		obelisk(f, s * 36, rz(268), 44)
	end

	-- colonnade along the road with painted lintels
	local glyphs = { "☥ 👁 ☀ 🐍 ☥", "🐈 ☀ ☥ 👁 🐈", "☀ ☥ 🪲 ☥ ☀", "👁 🐍 ☥ 🐈 👁" }
	for i, z in { rz(130), rz(152), rz(174), rz(196) } do
		for _, s in { -1, 1 } do
			column(f, s * 16, z, 20)
			Kit.AddCircle(s * 16, z, 3.5)
		end
		local lintel = Kit.Box(f, V(-19, 20, z - 2.4), V(19, 23, z + 2.4), STONE, { Mat = SANDSTONE, Shadow = true })
		Kit.Box(f, V(-19.1, 20.6, z - 2.5), V(19.1, 22.4, z - 2.42), Kit.Vivid(LAPIS))
		Kit.Sign(lintel, Enum.NormalId.Front, glyphs[i], C(255, 230, 150), { Stroke = C(60, 30, 20) })
	end

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 10 - 0.8, 0, z - 0.8), V(x + s * 10 + 0.8, 13, z + 0.8), STONE_DARK, { Mat = SANDSTONE, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "☥ PHARAOH'S TOMB ☥", Kit.Vivid(LAPIS), C(255, 220, 110), GOLD)
		Kit.AddCircle(x, z, 12)
	end

	-- torches along the road (three lit, one flickers)
	local n = 0
	for z = Z0 + 40, Z1 - 30, 40 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 20 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				n += 1
				torch(f, x, zz, n == 2 or n == 6 or n == 9, n == 6)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- palms around the oasis, then elsewhere
	local palms = 0
	for k = 0, 11 do
		local a = k * math.pi / 6
		local x, z = 75 + math.cos(a) * 40, rz(180) + math.sin(a) * 40
		if palms < 6 and Kit.IsFree(x, z, 12) then
			palms += 1
			palm(f, V(x, 0, z), rng:NextNumber(18, 20))
		end
	end
	for _ = 1, 400 do
		if palms >= 13 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 26)
		if Kit.IsFree(x, z, h * 0.42 + 3.5) then
			palms += 1
			palm(f, V(x, 0, z), h)
		end
	end

	-- urns and broken columns
	local urns, stumps = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if urns < 9 and Kit.IsFree(x, z, 2.5) then
			urns += 1
			urn(f, x, z, rng:NextNumber(1, 1.5))
			if rng:NextNumber() < 0.5 then
				urn(f, x + 2.4, z + 1, 0.8)
			end
			Kit.AddCircle(x, z, 3)
		elseif stumps < 6 and Kit.IsFree(x, z, 4) then
			stumps += 1
			local h = rng:NextNumber(3, 8)
			Kit.Cyl(f, h, 3.6, CFrame.new(x, h / 2, z), STONE, { Mat = SANDSTONE, Solid = true })
			Kit.Part(f, V(7, 3.4, 3.4), CFrame.new(x + 3.5, 1.7, z + 1) * CFrame.Angles(0, 0.6, 0), STONE_DARK, { Mat = SANDSTONE, Shape = Enum.PartType.Cylinder })
			Kit.AddCircle(x, z, 5)
		end
	end

	-- floating gems near the treasure and the pyramid entrance
	for _, p in { V(108, 8, rz(250)), V(126, 10, rz(274)), V(124, 7, rz(46)), V(-128, 9, rz(222)), V(130, 12, rz(300)) } do
		local g = Kit.Part(f, V(1.4, 1.4, 1.4), CFrame.new(p) * CFrame.Angles(0.6, 0.3, 0.6), Kit.Vivid(Kit.Pick({ TURQ, C(230, 60, 90), C(170, 90, 240), GOLD })), { Refl = 0.3, Name = "FloatingGem" })
		Kit.Float(g, rng:NextNumber(0.6, 1.2))
	end

	outside(f)
end

return Tomb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">ToyFactory</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 12: Haunted Toy Factory (Z 3760..4120). A bright, open-topped factory hall.
--   Floor: pale lilac plastic (top Y = 0) inside the walls, grass outside. Main path along X = 0:
--   a sky-blue lane (X -8..8, top 0.05) with yellow edges and white dashes.
--   Walls: pink, 16 tall at X +-140..146 with a yellow rim ledge, purple skirting, sky-blue
--   windows, big gears and a candy-striped pipe on the inner faces. No roof anywhere.
--   Ghost areas hold flat paint only: a giant play mat (0, 3845), rugs, a pinwheel (75, 3940)
--   and the Puppet Master's striped stage floor (0, 4065).
--   Landmarks: a giant sitting TEDDY BEAR with a wind-up key (95, 4050, ~61 tall) and a huge
--   JACK-IN-THE-BOX (-100, 4060, ~62 tall), plus striped factory chimneys outside the walls.
--   Also: an entrance gantry sign, a toy train on an oval track, conveyor belts carrying toys,
--   giant lettered building blocks, a wind-up mouse, toy soldiers, gift boxes, lamp posts and
--   balloons.
-- Glow: lamp globes, the train headlamp, the jack's nose and four star glints on the stage.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local ToyFactory = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GRASS = Enum.Material.Grass
local FABRIC = Enum.Material.Fabric

local Z0, Z1 = 3760, 4120

local FLOOR = C(246, 238, 252)
local PINK = C(255, 150, 195)
local SKY = C(110, 190, 255)
local YELLOW = C(255, 215, 80)
local PURPLE = C(160, 110, 230)
local WHITE = C(255, 255, 255)
local RED = C(240, 80, 90)
local MINT = C(120, 225, 170)
local FUR = C(200, 140, 90)
local FUR_LIGHT = C(240, 205, 160)
local DARK = C(45, 35, 50)
local TOYS = { PINK, SKY, YELLOW, PURPLE, MINT, C(255, 150, 80) }

local function rz(n: number): number
	return Z0 + n
end

-- Cylinder whose axis runs along the local Z of `cf`.
local function cylZ(parent: Instance, cf: CFrame, len: number, d: number, color: Color3, opts: Kit.Opts?): Part
	local o: Kit.Opts = opts or {}
	local p = Kit.Part(parent, V(len, d, d), cf * CFrame.Angles(0, math.pi / 2, 0), color, o)
	p.Shape = Enum.PartType.Cylinder
	return p
end

--==================================================================
-- PROPS
--==================================================================
local function gift(parent: Instance, x: number, z: number, s: number, yaw: number, y: number?)
	local cf = CFrame.new(x, (y or 0) + s / 2, z) * CFrame.Angles(0, yaw, 0)
	local col = Kit.Pick(TOYS)
	local rib = if col == YELLOW then PINK else YELLOW
	Kit.Part(parent, V(s, s, s), cf, Kit.Vivid(col), { Solid = true })
	Kit.Part(parent, V(s + 0.1, s + 0.1, s * 0.18), cf, Kit.Vivid(rib))
	Kit.Part(parent, V(s * 0.18, s + 0.1, s + 0.1), cf, Kit.Vivid(rib))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, s * 0.3, (cf * CFrame.new(sx * s * 0.16, s * 0.6, 0)).Position, Kit.Vivid(rib))
	end
end

local function block(parent: Instance, cf: CFrame, s: number, col: Color3, letter: string)
	local b = Kit.Part(parent, V(s, s, s), cf, Kit.Vivid(col), { Solid = true, Shadow = true })
	Kit.Sign(b, Enum.NormalId.Front, letter, WHITE, { Stroke = DARK })
	Kit.Sign(b, Enum.NormalId.Right, letter, WHITE, { Stroke = DARK })
end

local function blockStack(parent: Instance, x: number, z: number, s: number, letters: string)
	local rng = Kit.Rng
	local n = #letters
	for i = 1, n do
		local cf = CFrame.new(x + rng:NextNumber(-0.6, 0.6), s * (i - 0.5), z + rng:NextNumber(-0.6, 0.6)) * CFrame.Angles(0, rng:NextNumber(-0.35, 0.35), 0)
		block(parent, cf, s, TOYS[(i % #TOYS) + 1], string.sub(letters, i, i))
	end
	Kit.AddCircle(x, z, s * 0.8 + 1)
end

local function soldier(parent: Instance, x: number, z: number, fx: number, fz: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local blue = Kit.Vivid(C(60, 90, 200))
	for _, s in { -1, 1 } do
		Kit.Part(parent, V(1.1, 3.4, 1.3), base * CFrame.new(s * 0.7, 1.7, 0), blue)
		Kit.Part(parent, V(0.9, 3.2, 0.9), base * CFrame.new(s * 2, 5.4, 0), Kit.Vivid(RED))
	end
	Kit.Part(parent, V(3.2, 3.6, 2), base * CFrame.new(0, 5.2, 0), Kit.Vivid(RED), { Solid = true })
	Kit.Part(parent, V(3.3, 0.6, 2.1), base * CFrame.new(0, 4, 0), WHITE)
	Kit.Ball(parent, 2.4, (base * CFrame.new(0, 8, 0)).Position, C(255, 220, 190))
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.4, (base * CFrame.new(s * 0.45, 8.2, -1.1)).Position, DARK)
	end
	Kit.Cyl(parent, 2.8, 2.2, base * CFrame.new(0, 10.3, 0), DARK)
	Kit.Ball(parent, 0.9, (base * CFrame.new(0, 11.9, 0)).Position, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 3)
end

local function conveyor(parent: Instance, x: number, z1: number, z2: number, col: Color3)
	local m = Kit.Model(parent, "Conveyor")
	Kit.Box(m, V(x - 3, 0, z1), V(x + 3, 3, z2), Kit.Vivid(col), { Solid = true, Shadow = true })
	Kit.Box(m, V(x - 2.6, 3, z1), V(x + 2.6, 3.3, z2), C(70, 70, 90), { Mat = Enum.Material.Rubber })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 3 - 0.05, 1.2, z1), V(x + s * 3 + 0.05, 1.8, z2), Kit.Vivid(YELLOW))
	end
	for _, z in { z1, z2 } do
		Kit.CylFlat(m, 6.4, 3.4, V(x, 1.7, z), "X", Kit.Vivid(YELLOW), { Mat = METAL })
	end
	local rng = Kit.Rng
	local n = math.floor((z2 - z1) / 14)
	for i = 1, n do
		local z = z1 + i * (z2 - z1) / (n + 1)
		if i % 2 == 0 then
			Kit.Ball(m, 2.6, V(x, 4.6, z), Kit.Vivid(Kit.Pick(TOYS)))
		else
			local s = rng:NextNumber(2, 2.8)
			Kit.Part(m, V(s, s, s), CFrame.new(x, 3.3 + s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), Kit.Vivid(Kit.Pick(TOYS)))
		end
	end
	Kit.AddRect(x - 4.5, z1 - 2, x + 4.5, z2 + 2)
end

local function windupMouse(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "WindupMouse")
	local grey = C(185, 185, 205)
	Kit.Part(m, V(5, 4, 8), CFrame.new(x, 2.2, z), grey, { Solid = true })
	Kit.Ball(m, 5, V(x, 2.6, z - 3.6), grey)
	Kit.Ball(m, 1, V(x, 2.6, z - 6.2), Kit.Vivid(PINK))
	for _, s in { -1, 1 } do
		cylZ(m, CFrame.new(x + s * 1.6, 5.2, z - 3), 0.4, 3, Kit.Vivid(PINK))
		Kit.Ball(m, 0.6, V(x + s * 1, 3.4, z - 5.6), DARK)
	end
	Props.Beam(m, V(x, 1, z + 4), V(x + 2, 2.6, z + 9), 0.4, 0.4, Kit.Vivid(PINK))
	-- wind-up key on its back
	Kit.Cyl(m, 2.4, 0.5, CFrame.new(x, 5.3, z + 1), Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		cylZ(m, CFrame.new(x + s * 1.3, 7, z + 1) * CFrame.Angles(0, math.pi / 2, 0), 0.5, 2.6, Kit.Vivid(YELLOW), { Mat = METAL })
	end
	Kit.AddCircle(x, z, 7)
end

local function gear(parent: Instance, x: number, y: number, z: number, d: number, col: Color3)
	-- a gear flat against a wall that faces X (x is the wall's inner face)
	local s = if x > 0 then -1 else 1 -- direction into the hall
	Kit.CylFlat(parent, 0.8, d, V(x + s * 0.4, y, z), "X", col, { Mat = METAL })
	for k = 0, 5 do
		local a = k * math.pi / 3
		Kit.Part(parent, V(0.8, d * 0.2, d * 0.2), CFrame.new(x + s * 0.4, y + math.cos(a) * d / 2, z + math.sin(a) * d / 2) * CFrame.Angles(a, 0, 0), col, { Mat = METAL })
	end
	Kit.CylFlat(parent, 1, d * 0.32, V(x + s * 0.6, y, z), "X", Kit.Vivid(YELLOW), { Mat = METAL })
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-140, -4, Z0), V(140, 0, Z1), FLOOR, { Solid = true, Name = "Ground_ToyFactory" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -4, Z0), V(s * 190, 0, Z1), C(120, 205, 110), { Mat = GRASS, Solid = true })
	end
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), SKY, { Solid = true, Name = "FactoryLane" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.6, 0.05, Z0), V(s * 8 + 0.6, 0.1, Z1), Kit.Vivid(YELLOW))
	end
	for z = Z0 + 10, Z1 - 10, 18 do
		Kit.Box(f, V(-0.4, 0.05, z), V(0.4, 0.08, z + 7), WHITE)
	end
	-- coloured work zones painted on the floor
	Kit.Box(f, V(58, 0, rz(12)), V(120, 0.02, rz(142)), C(255, 225, 238))
	Kit.Box(f, V(-136, 0, rz(8)), V(-48, 0.02, rz(90)), C(225, 240, 255))
	Kit.Box(f, V(20, 0, rz(120)), V(44, 0.02, rz(212)), C(255, 246, 210))
	Kit.Box(f, V(-44, 0, rz(124)), V(-20, 0.02, rz(206)), C(232, 250, 238))
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 16, zB), PINK, { Solid = true, Shadow = true })
		Kit.Box(f, V(s * 138.5, 16, zA), V(s * 146.5, 17.5, zB), Kit.Vivid(YELLOW))
		Kit.Box(f, V(s * 139.6, 0, zA), V(s * 140, 1.6, zB), Kit.Vivid(PURPLE))
		-- candy-striped pipe along the wall
		Kit.CylFlat(f, zB - zA - 10, 2.6, V(s * 137.5, 12.5, (zA + zB) / 2), "Z", WHITE, { Mat = METAL })
		for z = zA + 12, zB - 10, 24 do
			Kit.CylFlat(f, 3, 2.9, V(s * 137.5, 12.5, z), "Z", Kit.Vivid(RED), { Mat = METAL })
		end
		for _, z in { zA + 6, zB - 6 } do
			Kit.Cyl(f, 12.5, 2.6, CFrame.new(s * 137.5, 6.25, z), WHITE, { Mat = METAL })
			Kit.Cyl(f, 2, 2.9, CFrame.new(s * 137.5, 4, z), Kit.Vivid(RED), { Mat = METAL })
		end
		-- windows and gears on the inner face
		for i, z in { rz(40), rz(100), rz(160), rz(220), rz(280), rz(330) } do
			if i % 2 == 1 then
				Kit.Box(f, V(s * 139.9, 3.5, z - 8), V(s * 139.65, 10, z + 8), Kit.Vivid(SKY), { Refl = 0.2 })
				Kit.Box(f, V(s * 139.95, 6.6, z - 8), V(s * 139.6, 6.9, z + 8), WHITE)
			else
				gear(f, s * 140, 7, z, 9, if i % 4 == 0 then Kit.Vivid(PURPLE) else Kit.Vivid(MINT))
			end
		end
	end
end

local function gantry(f: Instance)
	local z = rz(44)
	for _, s in { -1, 1 } do
		Kit.Cyl(f, 26, 2.4, CFrame.new(s * 14, 13, z), Kit.Vivid(PINK), { Solid = true })
		for _, y in { 8, 18 } do
			Kit.Cyl(f, 1.6, 2.7, CFrame.new(s * 14, y, z), WHITE)
		end
		Kit.AddCircle(s * 14, z, 2)
	end
	local beam = Kit.Box(f, V(-17, 22, z - 1.6), V(17, 27, z + 1.6), Kit.Vivid(YELLOW), { Shadow = true })
	Kit.Sign(beam, Enum.NormalId.Front, "🧸 HAUNTED TOY FACTORY 🧸", Kit.Vivid(PURPLE), { Stroke = WHITE })
	for _, s in { -1, 1 } do
		Kit.CylFlat(f, 1, 6, V(s * 17.5, 24.5, z - 0.4), "Z", Kit.Vivid(SKY), { Mat = METAL })
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- toy soldiers: giant play mat
	local cz = rz(85)
	local sizes = { 64, 58, 44, 30, 12 }
	local cols = { PINK, YELLOW, SKY, WHITE, PINK }
	for i, d in sizes do
		Kit.Disc(f, 0, cz, 0.02 + i * 0.025, d, 0.02, Kit.Vivid(cols[i]))
	end
	-- rugs with polka dots
	for k, a in { { -82, rz(120) }, { -62, rz(240) } } do
		Kit.Disc(f, a[1], a[2], 0.04, 51, 0.03, Kit.Vivid(if k == 1 then SKY else PURPLE))
		Kit.Disc(f, a[1], a[2], 0.07, 44, 0.03, Kit.Vivid(if k == 1 then C(190, 225, 255) else C(215, 190, 250)))
		for i = 0, 3 do
			local ang = i * math.pi / 2 + 0.4
			Kit.Disc(f, a[1] + math.cos(ang) * 12, a[2] + math.sin(ang) * 12, 0.1, 6, 0.03, WHITE)
		end
	end
	-- jack-in-the-box phantoms: pinwheel
	local px, pz = 75, rz(180)
	Kit.Disc(f, px, pz, 0.04, 54, 0.03, Kit.Vivid(YELLOW))
	for i = 0, 5 do
		local a = i * math.pi / 3
		Props.Beam(f, V(px, 0.08, pz), V(px + math.cos(a) * 24, 0.08, pz + math.sin(a) * 24), 5, 0.04, Kit.Vivid(TOYS[i + 1]))
	end
	Kit.Disc(f, px, pz, 0.12, 6, 0.03, WHITE)
	-- boss: the Puppet Master's striped stage floor
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(PURPLE))
	Kit.Disc(f, 0, bz, 0.06, 52, 0.03, Kit.Vivid(YELLOW))
	Kit.Disc(f, 0, bz, 0.08, 48, 0.03, Kit.Vivid(C(240, 70, 100)))
	for i = 0, 7 do
		local a = i * math.pi / 4
		Props.Beam(f, V(0, 0.11, bz), V(math.cos(a) * 23, 0.11, bz + math.sin(a) * 23), 4, 0.04, WHITE)
	end
	Kit.Disc(f, 0, bz, 0.14, 8, 0.03, Kit.Vivid(YELLOW))
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		Kit.Part(f, V(1.8, 0.05, 1.8), CFrame.new(math.cos(a) * 25.5, 0.12, bz + math.sin(a) * 25.5) * CFrame.Angles(0, math.pi / 4, 0), YELLOW, { Mat = NEON })
	end
end

--==================================================================
-- TOY TRAIN
--==================================================================
local function track(f: Instance, cx: number, z1: number, z2: number, r: number)
	local bed = C(150, 110, 200)
	local rail = C(120, 125, 145)
	local function seg(a: Vector3, b: Vector3)
		Props.Beam(f, a + V(0, 0.05, 0), b + V(0, 0.05, 0), 5, 0.06, bed)
		local d = (b - a).Unit
		local side = V(-d.Z, 0, d.X) * 1.7
		for _, s in { -1, 1 } do
			Props.Beam(f, a + side * s + V(0, 0.15, 0), b + side * s + V(0, 0.15, 0), 0.5, 0.14, rail, { Mat = METAL })
		end
	end
	for _, s in { -1, 1 } do
		seg(V(cx + s * r, 0, z1), V(cx + s * r, 0, z2))
	end
	for k = 0, 3 do
		local a1, a2 = k * math.pi / 4, (k + 1) * math.pi / 4
		seg(V(cx + math.cos(a1) * r, 0, z2 + math.sin(a1) * r), V(cx + math.cos(a2) * r, 0, z2 + math.sin(a2) * r))
		seg(V(cx + math.cos(a1) * r, 0, z1 - math.sin(a1) * r), V(cx + math.cos(a2) * r, 0, z1 - math.sin(a2) * r))
	end
end

local function train(f: Instance, x: number, zc: number)
	local m = Kit.Model(f, "ToyTrain")
	local sol: Kit.Opts = { Solid = true, Shadow = true }
	-- engine (front at +Z)
	Kit.Box(m, V(x - 3, 1.6, zc - 7), V(x + 3, 3, zc + 7), Kit.Vivid(RED), sol)
	Kit.CylFlat(m, 9, 5, V(x, 5.5, zc + 2), "Z", Kit.Vivid(SKY))
	Kit.CylFlat(m, 0.6, 5.4, V(x, 5.5, zc + 6.8), "Z", Kit.Vivid(YELLOW))
	Kit.Box(m, V(x - 3, 3, zc - 7), V(x + 3, 10.5, zc - 2), Kit.Vivid(YELLOW), sol)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 3.05, 6.5, zc - 6), V(x + s * 3.1, 9, zc - 3), Kit.Vivid(SKY), { Refl = 0.2 })
	end
	Kit.Box(m, V(x - 3.6, 10.5, zc - 7.6), V(x + 3.6, 11.3, zc - 1.4), Kit.Vivid(PURPLE))
	Kit.Cyl(m, 4, 1.8, CFrame.new(x, 10, zc + 4.5), DARK)
	Kit.Cyl(m, 1, 2.8, CFrame.new(x, 12.4, zc + 4.5), Kit.Vivid(RED))
	Kit.Wedge(m, V(6, 2.2, 2.4), CFrame.new(x, 2.2, zc + 8.2) * CFrame.Angles(0, math.pi, 0), Kit.Vivid(YELLOW))
	for _, z in { zc - 4.5, zc + 0.5, zc + 5 } do
		Kit.CylFlat(m, 6.6, 3.2, V(x, 1.6, z), "X", Kit.Vivid(PINK))
	end
	-- wind-up key on the boiler
	Kit.Cyl(m, 2, 0.6, CFrame.new(x, 9, zc + 1), Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		Kit.CylFlat(m, 0.5, 2.4, V(x, 10.6, zc + 1 + s * 1.3), "X", Kit.Vivid(YELLOW), { Mat = METAL })
	end
	local lamp = Kit.Part(m, V(1.6, 1.6, 0.4), CFrame.new(x, 5.5, zc + 7.2), C(255, 245, 190), { Mat = NEON })
	Kit.Light(lamp, C(255, 240, 190), 20, 1.2)
	-- two wagons
	for i, cargo in { "blocks", "balls" } do
		local zw = zc - 7 - i * 12 + 4
		Kit.Box(m, V(x - 2.5, 1.6, zw - 5), V(x + 2.5, 5, zw + 5), Kit.Vivid(if i == 1 then MINT else PURPLE), sol)
		for _, z in { zw - 3, zw + 3 } do
			Kit.CylFlat(m, 5.6, 3, V(x, 1.5, z), "X", Kit.Vivid(YELLOW))
		end
		Kit.Box(m, V(x - 0.5, 2.2, zw + 5), V(x + 0.5, 2.8, zw + 7), DARK)
		if cargo == "blocks" then
			block(m, CFrame.new(x, 6.6, zw - 2) * CFrame.Angles(0, 0.3, 0), 3.2, YELLOW, "A")
			block(m, CFrame.new(x, 6.6, zw + 2) * CFrame.Angles(0, -0.2, 0), 3.2, SKY, "B")
		else
			Kit.Ball(m, 3.4, V(x, 6.6, zw - 2), Kit.Vivid(RED))
			Kit.Ball(m, 3.4, V(x, 6.6, zw + 2), Kit.Vivid(YELLOW))
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function teddy(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GiantTeddy")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local sol: Kit.Opts = { Mat = FABRIC, Solid = true, Shadow = true }
	local soft: Kit.Opts = { Mat = FABRIC, Shadow = true }
	local function at(lx: number, ly: number, lz: number): Vector3
		return (base * CFrame.new(lx, ly, lz)).Position
	end
	Kit.Ball(m, 34, at(0, 17, 2), FUR, sol)
	cylZ(m, base * CFrame.new(0, 15, -14.6), 0.6, 19, FUR_LIGHT, { Mat = FABRIC })
	-- legs and paw pads
	for _, s in { -1, 1 } do
		cylZ(m, base * CFrame.new(s * 8.5, 6, -10), 16, 12, FUR, sol)
		cylZ(m, base * CFrame.new(s * 8.5, 6, -18.1), 0.4, 9, Kit.Vivid(PINK), { Mat = FABRIC })
	end
	-- arms resting on the knees
	for _, s in { -1, 1 } do
		local a, b = at(s * 14, 26, -2), at(s * 15, 14, -13)
		local mid = (a + b) / 2
		local arm = Kit.Part(m, V((b - a).Magnitude, 9, 9), CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0), FUR, soft)
		arm.Shape = Enum.PartType.Cylinder
		Kit.Ball(m, 9.5, b, FUR, soft)
	end
	-- head
	Kit.Ball(m, 28, at(0, 44, 0), FUR, sol)
	Kit.Ball(m, 11, at(0, 40, -11.5), FUR_LIGHT, soft)
	Kit.Ball(m, 4, at(0, 42.5, -16.6), DARK)
	for _, s in { -1, 1 } do
		Kit.Ball(m, 3.6, at(s * 5.5, 47, -12.3), DARK)
		Kit.Ball(m, 1.2, at(s * 5.1, 47.8, -13.8), WHITE)
		Kit.Ball(m, 10, at(s * 11, 56, 0), FUR, soft)
		Kit.Ball(m, 6, at(s * 11, 56, -2.6), Kit.Vivid(PINK), { Mat = FABRIC })
		Kit.Part(m, V(5, 4, 1.4), base * CFrame.new(s * 3.4, 31.5, -14.2) * CFrame.Angles(0, 0, s * 0.35), Kit.Vivid(SKY), { Mat = FABRIC })
	end
	Kit.Ball(m, 2.8, at(0, 31.5, -14.6), Kit.Vivid(SKY), { Mat = FABRIC })
	-- wind-up key in the back
	cylZ(m, base * CFrame.new(0, 20, 21), 6, 1.4, Kit.Vivid(YELLOW), { Mat = METAL })
	for _, s in { -1, 1 } do
		local lobe = Kit.Part(m, V(0.8, 5.5, 5.5), base * CFrame.new(s * 2.6, 20, 24.2), Kit.Vivid(YELLOW), { Mat = METAL })
		lobe.Shape = Enum.PartType.Cylinder
	end
	Kit.AddCircle(x, z, 24)
end

local function jackInTheBox(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "JackInTheBox")
	local sol: Kit.Opts = { Solid = true, Shadow = true }
	-- the box (front faces +X toward the lane)
	Kit.Box(m, V(x - 11, 0, z - 11), V(x + 11, 22, z + 11), Kit.Vivid(PINK), sol)
	Kit.Box(m, V(x - 11.5, 21, z - 11.5), V(x + 11.5, 22.5, z + 11.5), Kit.Vivid(PURPLE))
	local front = Kit.Box(m, V(x + 11, 3, z - 8), V(x + 11.3, 19, z + 8), Kit.Vivid(YELLOW))
	Kit.Sign(front, Enum.NormalId.Right, "★", Kit.Vivid(RED), { Stroke = WHITE })
	local side = Kit.Box(m, V(x - 8, 3, z - 11.3), V(x + 8, 19, z - 11), Kit.Vivid(SKY))
	Kit.Sign(side, Enum.NormalId.Front, "JACK", WHITE, { Stroke = Kit.Vivid(PURPLE) })
	-- lid flipped open at the back
	Kit.Part(m, V(1, 22, 22), CFrame.new(x - 11, 22.5, z) * CFrame.Angles(0, 0, 0.3) * CFrame.new(-0.5, 11, 0), Kit.Vivid(PURPLE), { Shadow = true })
	-- crank handle on the +Z side
	Kit.CylFlat(m, 3, 1.2, V(x, 12, z + 12.5), "Z", Kit.Vivid(YELLOW), { Mat = METAL })
	Props.Beam(m, V(x, 12, z + 14), V(x + 4, 15, z + 14), 0.8, 0.8, Kit.Vivid(YELLOW), { Mat = METAL })
	Kit.Ball(m, 2, V(x + 4, 15, z + 14.8), Kit.Vivid(RED))
	-- spring
	for i = 0, 6 do
		Kit.Cyl(m, 2.2, 7, CFrame.new(x + (if i % 2 == 0 then 0.8 else -0.8), 23.6 + i * 2.6, z), C(200, 205, 220), { Mat = METAL })
	end
	-- ruff, head, face, jester hat
	Kit.Cyl(m, 2, 15, CFrame.new(x, 41.5, z), Kit.Vivid(YELLOW), { Mat = FABRIC })
	Kit.Ball(m, 14, V(x, 49, z), C(255, 236, 222))
	local nose = Kit.Ball(m, 2.6, V(x + 6.9, 49, z), RED, { Mat = NEON })
	Kit.Light(nose, C(255, 120, 130), 22, 1.2)
	for _, s in { -1, 1 } do
		Kit.Ball(m, 1.8, V(x + 6, 51.4, z + s * 2.6), DARK)
		Kit.Ball(m, 2.2, V(x + 5.6, 47.6, z + s * 4.3), Kit.Vivid(C(255, 170, 190)))
		Props.Beam(m, V(x, 55, z + s * 1.5), V(x - 1, 62, z + s * 8), 3.4, 3.4, Kit.Vivid(if s < 0 then PURPLE else SKY), { Mat = FABRIC })
		Kit.Ball(m, 2.6, V(x - 1, 62.8, z + s * 8.6), Kit.Vivid(YELLOW))
	end
	Kit.Part(m, V(0.5, 0.9, 5), CFrame.new(x + 6.7, 45.6, z), Kit.Vivid(RED))
	Kit.Cyl(m, 2.4, 12, CFrame.new(x, 55, z), Kit.Vivid(PURPLE), { Mat = FABRIC })
	-- confetti puffing out of the box
	local src = Kit.Part(m, V(10, 1, 10), CFrame.new(x, 24, z), WHITE, { Transp = 1, Name = "ConfettiSource" })
	local e = Kit.Emitter(src, PINK, 4, 0.6, 3)
	if e then
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, PINK),
			ColorSequenceKeypoint.new(0.33, SKY),
			ColorSequenceKeypoint.new(0.66, YELLOW),
			ColorSequenceKeypoint.new(1, PURPLE),
		})
		e.LightEmission = 0.2
		e.Size = NumberSequence.new(0.5)
		e.Transparency = NumberSequence.new(0)
		e.Lifetime = NumberRange.new(2, 3.5)
		e.Acceleration = V(0, -4, 0)
		e.EmissionDirection = Enum.NormalId.Top
	end
	Kit.AddCircle(x, z, 17)
end

--==================================================================
-- OUTSIDE
--==================================================================
local function outside(f: Instance)
	local o = Kit.Folder(f, "Outside")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), C(120, 205, 110), { Mat = GRASS })
		for i, h in { { 60, 92 }, { 250, 80 } } do
			local cx, cz, ht = s * (180 + i * 14), rz(h[1]), h[2]
			Kit.Cyl(o, ht, 11, CFrame.new(cx, ht / 2, cz), WHITE, { Shadow = true })
			for k = 1, 4 do
				Kit.Cyl(o, 5, 11.4, CFrame.new(cx, ht * k / 5, cz), Kit.Vivid(if (k + i) % 2 == 0 then PINK else SKY))
			end
			Kit.Cyl(o, 3, 13, CFrame.new(cx, ht + 1.5, cz), Kit.Vivid(PURPLE))
			Kit.Ball(o, 12, V(cx + 2, ht + 9, cz), WHITE, { Transp = 0.35 })
			Kit.Ball(o, 8, V(cx + 6, ht + 16, cz + 3), WHITE, { Transp = 0.5 })
			if s > 0 and i == 1 then
				local top = Kit.Part(o, V(8, 1, 8), CFrame.new(cx, ht + 4, cz), WHITE, { Transp = 1, Name = "SteamSource" })
				Kit.Emitter(top, C(250, 250, 255), 2, 8, 2)
			end
		end
		-- pastel hills and lollipop trees
		for i = 0, 2 do
			Kit.Ball(o, 90, V(s * (290 + i * 20), -30, Z0 + 60 + i * 120), Kit.Vivid(if i % 2 == 0 then C(170, 230, 150) else C(255, 200, 220)), { Mat = GRASS })
		end
		for i = 0, 3 do
			Props.Tree(o, V(s * (158 + (i % 2) * 14), 0, Z0 + 30 + i * 90 + 25), 18 + (i % 3) * 4)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function ToyFactory.Build(map: Instance)
	local f = Kit.Folder(map, "ToyFactory")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	gantry(f)
	teddy(f, 95, rz(290))
	jackInTheBox(f, -100, rz(300))

	-- toy train on an oval track in the east work zone
	track(f, 88, rz(42), rz(110), 22)
	train(f, 110, rz(88))
	Kit.AddRect(60, rz(14), 120, rz(138))
	gift(f, 84, rz(60), 4, 0.3)
	gift(f, 92, rz(72), 3, -0.4)
	blockStack(f, 86, rz(96), 5, "TOY")

	conveyor(f, 31, rz(124), rz(206), PURPLE)
	conveyor(f, -31, rz(128), rz(202), MINT)
	conveyor(f, -48, rz(276), rz(330), SKY)
	conveyor(f, 48, rz(226), rz(264), PINK)

	type Stack = { x: number, z: number, s: number, text: string }
	local stacks: { Stack } = {
		{ x = -72, z = rz(30), s = 6, text = "BOO" },
		{ x = -104, z = rz(64), s = 5, text = "ABC" },
		{ x = -124, z = rz(24), s = 6, text = "GH" },
	}
	for _, b in stacks do
		if Kit.IsFree(b.x, b.z, b.s + 1) then
			blockStack(f, b.x, b.z, b.s, b.text)
		end
	end
	windupMouse(f, -46, rz(166))

	-- lamp posts along the lane (three lit)
	local cols = { PINK, SKY, YELLOW }
	local n = 0
	for z = Z0 + 50, Z1 - 30, 44 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 22 else 0)
			local x = s * 13
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.4, true) then
				n += 1
				Props.StreetLamp(f, V(x, 0, zz), Kit.Vivid(cols[(n % 3) + 1]), n == 2 or n == 6)
				Kit.AddCircle(x, zz, 1.6)
			end
		end
	end

	-- toy soldiers and gift boxes
	local soldiers, gifts = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 30, Z1 - 28)
		if soldiers < 4 and math.abs(x) < 40 and Kit.IsFree(x, z, 3.5) then
			soldiers += 1
			soldier(f, x, z, -x, 0)
		elseif gifts < 12 and Kit.IsFree(x, z, 3.5) then
			gifts += 1
			local s = rng:NextNumber(3, 5.5)
			gift(f, x, z, s, rng:NextNumber(0, 1.5))
			if rng:NextNumber() < 0.4 then
				gift(f, x + rng:NextNumber(-0.4, 0.4), z, 2.4, rng:NextNumber(0, 1.5), s)
			end
			Kit.AddCircle(x, z, 3.5)
		end
	end
	-- balloons drifting over the hall
	for i, p in { V(118, 18, rz(240)), V(60, 16, rz(132)), V(-120, 14, rz(84)), V(-50, 18, rz(300)), V(122, 15, rz(166)) } do
		local b = Kit.Ball(f, 3.2, p, Kit.Vivid(TOYS[i]), { Name = "Balloon" })
		Kit.Float(b, rng:NextNumber(0.8, 1.4))
	end

	outside(f)
end

return ToyFactory
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="61">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="62">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="63">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="64">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">GHClient</string>
        </Properties>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- World liveliness + interactions:
--  * per-zone lighting blend (ambient + fog colour) as you walk between areas
--  * floating books/pumpkins (FloatingProp), flickering lights (FlickerLight), spinning
--    display crates (SpinProp) - one loop, only props near the camera are animated
--  * gates: open locally for zones you own, the NEW AREA UNLOCKED! sequence, sign text
--  * station prompts open the right panel
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local CratePanel = require(script.Parent.CratePanel)
local GatePanel = require(script.Parent.GatePanel)
local Reveal = require(script.Parent.Reveal)

local Ambience = {}

local player = Players.LocalPlayer
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end
local currentZone = 0
local unlocking: { [string]: boolean } = {}

type Prop = { Part: BasePart, Base: CFrame, Phase: number, Bob: number, Kind: string }
local props: { [BasePart]: Prop } = {}

local function addProp(inst: Instance, kind: string)
	if not inst:IsA("BasePart") or props[inst] then
		return
	end
	local bob = inst:GetAttribute("BobHeight")
	props[inst] = {
		Part = inst,
		Base = inst.CFrame,
		Phase = math.random() * 10,
		Bob = if type(bob) == "number" then bob else 0.6,
		Kind = kind,
	}
end

local flickers: { BasePart } = {}

local function blendZone(idx: number)
	local z = Config.Zones[idx]
	if not z then
		return
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { Ambient = z.Ambient, OutdoorAmbient = z.Ambient:Lerp(Color3.new(1, 1, 1), 0.15) }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, info, { Color = z.FogColor, Decay = z.FogColor:Lerp(Color3.new(0, 0, 0), 0.35) }):Play()
	end
end

local function gateParts(zoneId: string): (BasePart?, TextLabel?, ProximityPrompt?)
	local map = workspace:FindFirstChild("Map")
	local gates = map and map:FindFirstChild("Gates")
	local gate = gates and gates:FindFirstChild("Gate_" .. zoneId)
	if not gate then
		return nil, nil, nil
	end
	local barrier = gate:FindFirstChild("Barrier") :: BasePart?
	local sign = gate:FindFirstChild("Sign")
	local sg = sign and sign:FindFirstChildOfClass("SurfaceGui")
	local cost = sg and sg:FindFirstChild("CostLabel", true) :: TextLabel?
	local anchor = gate:FindFirstChild("PromptAnchor")
	local prompt = anchor and anchor:FindFirstChildOfClass("ProximityPrompt")
	return barrier, cost, prompt
end

local barrierOriginal: { [BasePart]: { Size: Vector3, CFrame: CFrame, Transparency: number } } = {}

local function applyGates()
	local d = State.Data
	if not d then
		return
	end
	for _, z in Config.Zones do
		if not Config.Layout.Gates[z.Id] or unlocking[z.Id] then
			continue
		end
		local barrier, cost, prompt = gateParts(z.Id)
		local owned = d.Zones[z.Id] == true
		if barrier then
			if not barrierOriginal[barrier] then
				barrierOriginal[barrier] = { Size = barrier.Size, CFrame = barrier.CFrame, Transparency = barrier.Transparency }
			end
			local o = barrierOriginal[barrier]
			barrier.CanCollide = not owned
			barrier.Transparency = if owned then 1 else o.Transparency
			if not owned then
				barrier.Size = o.Size
				barrier.CFrame = o.CFrame
			end
		end
		if cost then
			cost.Text = if owned then "✅ UNLOCKED" else "🔒 " .. Format.Short(z.Cost) .. " ECTOPLASM"
		end
		if prompt then
			prompt.Enabled = not owned
		end
	end
end

local function unlockSequence(zoneId: string)
	local zone = Config.ZoneById[zoneId]
	if not zone then
		return
	end
	unlocking[zoneId] = true
	local barrier, cost, prompt = gateParts(zoneId)
	Sound.Play("ZoneUnlock")
	Hud.Banner("NEW AREA UNLOCKED!", zone.Name .. "  ·  NEW GHOSTS  ·  NEW CRATE", zone.Accent)
	if prompt then
		prompt.Enabled = false
	end
	if cost then
		cost.Text = "✅ UNLOCKED"
	end
	-- camera emphasis: quick punch-in + shake
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = 58
		TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Back), { FieldOfView = 70 }):Play()
	end
	if barrier then
		barrier.CanCollide = false
		local cf = barrier.CFrame
		local size = barrier.Size
		barrier.Color = Color3.new(1, 1, 1)
		TweenService:Create(barrier, TweenInfo.new(0.25), { Color = zone.Accent }):Play()
		for i = -2, 2 do
			local p = cf.Position + cf.RightVector * (i * size.X / 5) + Vector3.new(0, -size.Y / 2 + 4, 0)
			Effects.Burst(p, { Color = zone.Accent, Color2 = Color3.new(1, 1, 1), Count = 30, Size = 1.4, Speed = 24, Life = 1 })
		end
		Effects.Ring(cf.Position - Vector3.new(0, size.Y / 2 - 0.3, 0), zone.Accent, 30, 0.9)
		task.wait(0.3)
		-- the force field drains into the ground
		TweenService:Create(barrier, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(size.X, 0.2, size.Z),
			CFrame = cf - Vector3.new(0, size.Y / 2, 0),
			Transparency = 1,
		}):Play()
		task.wait(1.2)
	end
	unlocking[zoneId] = nil
	applyGates()
end

local stepParts: { BasePart } = {}
local stepCfs: { CFrame } = {}

local function step()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	table.clear(stepParts)
	table.clear(stepCfs)
	local parts, cfs = stepParts, stepCfs
	for part, p in props do
		if (p.Base.Position - camPos).Magnitude > 160 then
			continue
		end
		local cf
		if p.Kind == "Spin" then
			cf = p.Base * CFrame.new(0, math.sin(t * 1.8 + p.Phase) * 0.4, 0) * CFrame.Angles(0, t * 0.9, 0)
		else
			cf = p.Base * CFrame.new(0, math.sin(t * 1.4 + p.Phase) * p.Bob, 0) * CFrame.Angles(math.sin(t * 0.9 + p.Phase) * 0.12, t * 0.35 + p.Phase, math.cos(t * 0.7 + p.Phase) * 0.1)
		end
		table.insert(parts, part)
		table.insert(cfs, cf)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ambience.Init() end

function Ambience.Start()
	for _, inst in CollectionService:GetTagged("FloatingProp") do
		addProp(inst, "Float")
	end
	CollectionService:GetInstanceAddedSignal("FloatingProp"):Connect(function(inst)
		addProp(inst, "Float")
	end)
	for _, inst in CollectionService:GetTagged("SpinProp") do
		addProp(inst, "Spin")
	end
	CollectionService:GetInstanceAddedSignal("SpinProp"):Connect(function(inst)
		addProp(inst, "Spin")
	end)
	for _, inst in CollectionService:GetTagged("FlickerLight") do
		if inst:IsA("BasePart") then
			table.insert(flickers, inst)
		end
	end
	-- flicker: every so often one light stutters
	task.spawn(function()
		while true do
			task.wait(0.15 + math.random() * 0.35)
			if #flickers > 0 then
				local part = flickers[math.random(1, #flickers)]
				local light = part:FindFirstChildWhichIsA("Light")
				if light then
					local base = part:GetAttribute("BaseTransparency")
					if type(base) ~= "number" then
						base = part.Transparency
						part:SetAttribute("BaseTransparency", base)
					end
					local n = math.random(1, 3)
					for _ = 1, n do
						light.Enabled = false
						part.Transparency = math.max(base :: number, 0.6)
						task.wait(0.04 + math.random() * 0.08)
						light.Enabled = true
						part.Transparency = base :: number
						task.wait(0.03 + math.random() * 0.06)
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)

	-- zone blend
	task.spawn(function()
		while true do
			task.wait(0.5)
			local cam = workspace.CurrentCamera
			if cam and not Reveal.IsPlaying() then
				local idx = Rules.ZoneIndexAt(cam.Focus.Position.Z, zoneRanges)
				if idx ~= currentZone then
					currentZone = idx
					blendZone(idx)
				end
			end
		end
	end)

	-- gates
	State.OnData(function()
		applyGates()
	end)
	State.OnFx("ZoneUnlocked", function(data: any)
		if type(data) == "table" and type(data.Zone) == "string" then
			unlockSequence(data.Zone)
		end
	end)

	-- prompts → panels
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player or Reveal.IsPlaying() then
			return
		end
		local crate = prompt:GetAttribute("Crate")
		local station = prompt:GetAttribute("Station")
		local zone = prompt:GetAttribute("Zone")
		if type(crate) == "string" then
			CratePanel.Open(crate)
		elseif station == "Upgrades" then
			Hud.Open("Upgrades")
		elseif type(zone) == "string" then
			GatePanel.Open(zone)
		end
	end)
	-- keep prompts out of the way while a menu is open
	Kit.PanelOpened:Connect(function(name)
		ProximityPromptService.Enabled = name == nil
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Boss</string>
              <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST event presentation: warning announcement + countdown, a beacon over the
-- arena, dramatic spawn (flash, rings, camera shake), a big boss Spirit bar with timer, and
-- defeat / escape banners. Rewards arrive as normal Ectoplasm drops (the shower).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Boss = {}

local player = Players.LocalPlayer
local frame: Frame
local fill: Frame
local spiritLabel: TextLabel
local timerLabel: TextLabel
local titleLabel: TextLabel
local goButton: TextButton
local beacon: Part? = nil
local state = "Idle"
local warnAt = 0
local endsAt = 0
local bossUid = 0
local arenaPos = Config.Layout.EventArena.Center
local dismissed = false -- the player closed the event bar for this event (a small pill reopens it)
local reopen: TextButton

local function setBeacon(on: boolean)
	if on and not beacon then
		local b = Instance.new("Part")
		b.Name = "BossBeacon"
		b.Shape = Enum.PartType.Cylinder
		b.Anchored = true
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CastShadow = false
		b.Material = Enum.Material.Neon
		b.Color = Color3.fromRGB(255, 120, 230)
		b.Transparency = 0.55
		b.Size = Vector3.new(220, 5, 5)
		b.CFrame = CFrame.new(arenaPos + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
		b.Parent = workspace
		beacon = b
		task.spawn(function()
			while beacon == b do
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.8 }):Play()
				task.wait(0.6)
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.45 }):Play()
				task.wait(0.6)
			end
		end)
	elseif not on and beacon then
		beacon:Destroy()
		beacon = nil
	end
end

local function show(on: boolean)
	reopen.Visible = on and dismissed
	if on and dismissed then
		on = false
	end
	if on == frame.Visible then
		return
	end
	frame.Visible = true
	local sc = frame:FindFirstChildOfClass("UIScale") :: UIScale
	if on then
		sc.Scale = 0.4
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		Kit.Tween(sc, 0.2, { Scale = 0.4 })
		task.delay(0.2, function()
			frame.Visible = false
		end)
	end
end

local function nearArena(): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - arenaPos).Magnitude < 150
end

local function onBoss(data: any)
	if data.Pos then
		arenaPos = data.Pos
	end
	if data.State == "Warning" then
		state = "Warning"
		dismissed = false -- every new event shows its bar again
		warnAt = data.At or 0
		Hud.Announce("⚠️ GIANT POLTERGEIST INCOMING!", Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 200, 60))
		Sound.Play("BossAppear")
		setBeacon(true)
		titleLabel.Text = "⚠️ GIANT POLTERGEIST"
		fill.Size = UDim2.fromScale(1, 1)
		spiritLabel.Text = "APPEARS SOON!"
		goButton.Visible = not nearArena()
		show(true)
	elseif data.State == "Active" then
		state = "Active"
		bossUid = data.Uid or 0
		endsAt = data.EndsAt or 0
		titleLabel.Text = "👑 GIANT POLTERGEIST"
		setBeacon(true)
		Sound.Boss(true)
		show(true)
		if nearArena() then
			Sound.Play("BossAppear")
			Effects.Flash(arenaPos + Vector3.new(0, 14, 0), Color3.fromRGB(255, 120, 230), 30, 0.7)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Color3.fromRGB(255, 230, 90), 40, 0.9)
			Effects.Burst(arenaPos + Vector3.new(0, 14, 0), { Color = Color3.fromRGB(255, 120, 230), Color2 = Color3.fromRGB(255, 230, 90), Count = 120, Size = 2.5, Speed = 40, Life = 1.2 })
			-- camera shake
			task.spawn(function()
				local cam = workspace.CurrentCamera
				local t0 = os.clock()
				while os.clock() - t0 < 0.6 and cam.CameraType ~= Enum.CameraType.Scriptable do
					local k = 0.6 * (1 - (os.clock() - t0) / 0.6)
					cam.CFrame *= CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
					RunService.RenderStepped:Wait()
				end
			end)
		end
	elseif data.State == "Defeated" then
		state = "Idle"
		dismissed = false
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("GIANT POLTERGEIST DEFEATED!", "Grab the Ectoplasm shower!", Theme.Gold)
		if data.Pos and nearArena() then
			Effects.Poof(data.Pos, Color3.fromRGB(255, 120, 230), 4, true)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Theme.Ecto, 45, 1)
		end
	elseif data.State == "Escaped" then
		state = "Idle"
		dismissed = false
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("IT ESCAPED...", "It'll be back. Bring more hunters!", Theme.Muted)
	end
end

function Boss.Init()
	local screen = Kit.Screen()
	frame = Kit.new("Frame", {
		Name = "BossBar",
		Size = UDim2.fromOffset(420, 62),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		LayoutOrder = 2,
		Parent = Hud.TopStack or screen,
	})
	Kit.Corner(frame, UDim.new(0, 14))
	Kit.Stroke(frame, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(frame, Color3.fromRGB(110, 40, 120), Color3.fromRGB(50, 20, 70), 90)
	Kit.new("UIScale", { Parent = frame })
	titleLabel = Kit.Label(frame, "👑 GIANT POLTERGEIST", { Size = UDim2.new(0.68, 0, 0, 22), Position = UDim2.fromOffset(10, 4), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, Style = "Heading", Fit = true, ZIndex = 31 })
	timerLabel = Kit.Label(frame, "", { Size = UDim2.new(0.3, 0, 0, 22), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Style = "Body", Fit = true, ZIndex = 31 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 31), BackgroundColor3 = Color3.fromRGB(30, 12, 45), ZIndex = 31, Parent = frame })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 32, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 220, 80), 0)
	spiritLabel = Kit.Label(bar, "", { Style = "Small", ZIndex = 33 })
	-- "take me there" helper: walks you nowhere, just points the way (see Tutorial arrow)
	goButton = Kit.Button(frame, {
		Text = "📍 SHOW ME",
		Color = "Pink",
		Size = UDim2.fromOffset(140, 40),
		TextStyle = "Small",
		Position = UDim2.new(0.5, 0, 1, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 31,
		OnClick = function()
			Boss.PointRequested:Fire()
		end,
	})
	goButton.Visible = false
	-- ✕ closes the event bar (the event keeps running; the boss's own label still shows)
	Kit.CloseButton(frame, function()
		dismissed = true
		show(false)
	end, 34)
	-- small pill to bring it back while the event is still on
	reopen = Kit.Button(Hud.TopStack or screen, {
		Text = "👑 EVENT",
		Color = "Pink",
		Size = UDim2.fromOffset(96, 30),
		TextStyle = "Small",
		ZIndex = 30,
		OnClick = function()
			dismissed = false
			show(true)
		end,
	})
	reopen.Visible = false
	reopen.LayoutOrder = 2
end

Boss.PointRequested = Signal.new()

function Boss.State(): (string, Vector3)
	return state, arenaPos
end

function Boss.Start()
	State.OnFx("Boss", onBoss)
	RunService.Heartbeat:Connect(function()
		if state == "Warning" then
			local left = math.max(0, warnAt - workspace:GetServerTimeNow())
			timerLabel.Text = Format.Time(left)
			goButton.Visible = not nearArena()
		elseif state == "Active" then
			local left = math.max(0, endsAt - workspace:GetServerTimeNow())
			timerLabel.Text = "⏱ " .. Format.Time(left)
			timerLabel.TextColor3 = if left < 20 then Theme.Bad else Theme.Text
			goButton.Visible = not nearArena()
			local e = Ghosts.Get(bossUid)
			if e then
				local frac = math.clamp(e.Spirit / math.max(e.Max, 1), 0, 1)
				fill.Size = UDim2.fromScale(math.max(frac, 0.01), 1)
				spiritLabel.Text = Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max) .. " SPIRIT"
			end
		end
	end)
end

return Boss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">CratePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Crate station panel: odds (with luck boost), possible hunters, price and the OPEN button.
-- Opened by the station's ProximityPrompt. The server rolls; we only play the reveal.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Reveal = require(script.Parent.Reveal)

local CratePanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local list: ScrollingFrame
local openButton: TextButton
local tripleButton: TextButton
local autoButton: TextButton
local luckyButton: TextButton
-- Auto Open results waiting to be shown (the server keeps opening while one plays)
local autoQueue: { any } = {}
local autoPlaying = false
local infoLabel: TextLabel
local luckLabel: TextLabel
local current: string? = nil
local crateIcon: ImageLabel
local busy = false
local openedSignal = Signal.new()
CratePanel.Opened = openedSignal -- (result) after a successful purchase

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function nearStation(crateId: string): boolean
	local pos = Config.Layout.CrateStations[crateId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return pos ~= nil and root ~= nil and (root.Position - pos).Magnitude < 28
end

local cardsKey = ""
local refreshCards: (string, any, { [string]: number }, number) -> ()
local refreshButton: (string, any, number) -> ()

local function refresh()
	local crateId = current
	local d = State.Data
	if not crateId or not d then
		return
	end
	local crate = Config.Crates[crateId]
	panel.Title.Text = crate.Name
	local img = Icons.Get(Icons.ForCrate[crateId])
	crateIcon.Image = img or ""
	crateIcon.Visible = img ~= nil
	-- the luck boost ends on the server clock even if no new snapshot arrives
	local luck = if (d.Boosts.Luck or 0) > State.Now() then Config.Boosts.Luck.Multiplier else 1
	if d.LuckyOpens and (d.LuckyOpens[crateId] or 0) > 0 then
		luck *= Config.LuckyOpens.Multiplier
	end
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, luck, Config.LuckAffectsFromOrder)
	-- cards only change with the crate, luck or discoveries; the button changes with Ectoplasm
	local key = crateId .. "|" .. luck
	for _, e in crate.Pool do
		key ..= if d.Discovered[e.Hunter] then "1" else "0"
	end
	if key ~= cardsKey then
		cardsKey = key
		refreshCards(crateId, d, odds, luck)
	end
	refreshButton(crateId, d, luck)
end

function refreshCards(crateId: string, d: any, odds: { [string]: number }, luck: number)
	local crate = Config.Crates[crateId]
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local found = d.Discovered[e.Hunter] == true
		local card: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = list,
		})
		Kit.Corner(card, UDim.new(0, 14))
		Kit.Stroke(card, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(card, rar.Color, rar.Color2, 90)
		local pic: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(88, 88),
			Position = UDim2.new(0.5, 0, 0, 8),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(30, 18, 55),
			BackgroundTransparency = 0.3,
			ZIndex = 63,
			Parent = card,
		})
		Kit.Corner(pic, UDim.new(1, 0))
		Portrait.Face(pic, e.Hunter, not found)
		Kit.Label(card, if found then string.upper(def.Name) else "???", { Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 100), ZIndex = 64, Style = "Body", Fit = true })
		Kit.Label(card, rar.Name, { Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 121), ZIndex = 64, Color = Color3.fromRGB(255, 255, 240), Style = "Small", Fit = true })
		Kit.Label(card, "⚡ " .. Format.Commas(def.Power), { Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.new(0, 8, 1, -28), ZIndex = 64, Color = Theme.Gold, Align = Enum.TextXAlignment.Left, Style = "Small", Fit = true })
		local pct = Kit.Label(card, Format.Percent(odds[e.Hunter]), { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(1, -8, 1, -29), AnchorPoint = Vector2.new(1, 0), ZIndex = 64, Align = Enum.TextXAlignment.Right, Style = "Heading", Fit = true })
		if luck > 1 and rar.Order >= Config.LuckAffectsFromOrder then
			pct.TextColor3 = Theme.Ecto
		end
	end
end

function refreshButton(crateId: string, d: any, luck: number)
	local crate = Config.Crates[crateId]
	local free = d.FreeCrates[crateId] or 0
	local price = crate.Price
	if free > 0 then
		Kit.SetButtonText(openButton, "OPEN FREE! (" .. free .. ")")
		openButton:SetAttribute("Color", "Orange")
	elseif d.Ecto >= price then
		Kit.SetButtonText(openButton, "OPEN  💚 " .. Format.Commas(price))
		openButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(openButton, "NEED 💚 " .. Format.Short(price - d.Ecto) .. " MORE")
		openButton:SetAttribute("Color", "Gray")
	end
	if not d.Zones[crate.Zone] then
		infoLabel.Text = "Unlock " .. (Config.ZoneById[crate.Zone] :: Config.ZoneDef).Name .. " to open this crate"
	else
		infoLabel.Text = "Better crates > stronger hunters!"
	end
	local left = if d.LuckyOpens then d.LuckyOpens[crateId] or 0 else 0
	local L = Config.LuckyOpens
	Kit.SetButtonText(luckyButton, string.format("🍀 x%d LUCKY  💚 %s", L.Opens, Format.Short(price * L.PriceMultiplier)))
	luckyButton:SetAttribute("Color", if d.Ecto >= price * L.PriceMultiplier then "Teal" else "Gray")
	luckLabel.Text = if left > 0
		then string.format("🍀 %d LUCKY OPEN%s LEFT: rare odds x%d!", left, if left == 1 then "" else "S", L.Multiplier)
		else "🍀 LUCK BOOST: rare odds boosted!"
	luckLabel.Visible = luck > 1
	local autoOwned = d.Passes and d.Passes[Config.AutoOpen.Pass] == true
	local autoOn = player:GetAttribute("AutoOpen") ~= nil
	Kit.SetButtonText(autoButton, if not autoOwned then "🔒 AUTO OPEN" elseif autoOn then "AUTO OPEN: ON" else "AUTO OPEN: OFF")
	autoButton:SetAttribute("Color", if not autoOwned then "Gray" elseif autoOn then "Green" else "Purple")
	local triple = d.Passes and d.Passes[Config.TripleOpen.Pass] == true
	tripleButton.Visible = triple == true
	openButton.Position = if triple then UDim2.new(0.5, -75, 1, -4) else UDim2.new(0.5, 0, 1, -4)
	if triple then
		Kit.SetButtonText(tripleButton, "OPEN x3  💚 " .. Format.Short(price * Config.TripleOpen.Count))
	end
end

-- Plays the best of several results (Triple Open) and lists the rest as toasts.
local function rarityOf(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 0
end

local function playResults(crateId: string, first: any, again: (() -> ())?)
	local all = { { Uid = first.Uid, Hunter = first.Hunter, IsNew = first.IsNew == true } }
	for _, m in (first.More or {}) :: { any } do
		table.insert(all, { Uid = m.Uid, Hunter = m.Hunter, IsNew = m.IsNew == true })
	end
	table.sort(all, function(a, b)
		return rarityOf(a.Hunter) > rarityOf(b.Hunter)
	end)
	for _, r in all do
		openedSignal:Fire({ Crate = crateId, Hunter = r.Hunter, Uid = r.Uid, IsNew = r.IsNew })
	end
	local best = all[1]
	Reveal.Play({ Crate = crateId, Hunter = best.Hunter, Uid = best.Uid, IsNew = best.IsNew }, again)
	for i = 2, #all do
		local h = Config.Hunters[all[i].Hunter]
		if h then
			Kit.Toast("Also got: " .. Config.Rarities[h.Rarity].Name .. " " .. h.Name .. (if all[i].IsNew then " (NEW!)" else ""), "Good")
		end
	end
end

local function buyTriple()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	if player:GetAttribute("AutoOpen") then
		Kit.Toast("Turn AUTO OPEN off first", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId, Config.TripleOpen.Count)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	playResults(crateId, res, nil)
end

local function buy()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	if player:GetAttribute("AutoOpen") then
		Kit.Toast("Turn AUTO OPEN off first", "Bad")
		return
	end
	local d = State.Data
	local crate = Config.Crates[crateId]
	if d and (d.FreeCrates[crateId] or 0) <= 0 and d.Ecto < crate.Price then
		Kit.Toast("Defeat ghosts to collect more Ectoplasm!", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	local result: Reveal.Result = { Crate = crateId, Hunter = res.Hunter, Uid = res.Uid, IsNew = res.IsNew == true }
	openedSignal:Fire(result)
	local function again()
		if busy then
			return
		end
		local dd = State.Data
		if dd and (dd.FreeCrates[crateId] or 0) <= 0 and dd.Ecto < crate.Price then
			Kit.Toast("Not enough Ectoplasm!", "Bad")
			return
		end
		busy = true
		local r2 = State.Request("OpenCrate", crateId)
		busy = false
		if r2.ok then
			local res2: Reveal.Result = { Crate = crateId, Hunter = r2.Hunter, Uid = r2.Uid, IsNew = r2.IsNew == true }
			openedSignal:Fire(res2)
			Reveal.Play(res2, again)
		else
			Kit.Toast(r2.err or "Couldn't open the crate", "Bad")
		end
	end
	Reveal.Play(result, again)
end

function CratePanel.Open(crateId: string)
	if not Config.Crates[crateId] or Reveal.IsPlaying() then
		return
	end
	current = crateId
	refresh()
	panel:Open()
end

function CratePanel.Init()
	panel = Kit.Panel("Crate", "HUNTER CRATE", Vector2.new(700, 380), "Orange")
	-- crate picture in the top-left corner (uploaded icon per crate, see Icons.ForCrate)
	crateIcon = Kit.new("ImageLabel", {
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(72, 72),
		Position = UDim2.fromOffset(-14, -34),
		ZIndex = 64,
		Visible = false,
		Parent = panel.Root,
	})
	infoLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -400, 0, 20), Position = UDim2.fromOffset(0, 12), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	luckLabel = Kit.Label(panel.Body, "🍀 LUCK BOOST: rare odds boosted!", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 32), Color = Theme.Ecto, Style = "Small", ZIndex = 62 })
	luckLabel.Visible = false
	-- cards wrap onto more rows (and scroll) when the panel is narrow (phones, portrait)
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -118),
		Position = UDim2.fromOffset(0, 54),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(148, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = list })
	openButton = Kit.Button(panel.Body, {
		Text = "OPEN",
		Color = "Green",
		Size = UDim2.fromOffset(280, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = buy,
	})
	openButton.Name = "OpenButton"
	panel.Primary = openButton
	tripleButton = Kit.Button(panel.Body, {
		Text = "OPEN x3",
		Color = "Purple",
		Size = UDim2.fromOffset(200, 50),
		Position = UDim2.new(0.5, 185, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = buyTriple,
	})
	tripleButton.Visible = false
	-- LUCKY OPENS (Ectoplasm): next few opens of this crate at higher luck
	luckyButton = Kit.Button(panel.Body, {
		Text = "🍀 LUCKY",
		Color = "Teal",
		Size = UDim2.fromOffset(200, 34),
		Position = UDim2.new(1, -180, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = function()
			local crateId = current
			if busy or not crateId then
				return
			end
			busy = true
			local res = State.Request("BuyLuckyOpens", crateId)
			busy = false
			if res.ok then
				Kit.Toast(string.format("🍀 %d lucky opens ready for this crate!", res.Left or Config.LuckyOpens.Opens), "Good")
				refresh()
			else
				Kit.Toast(res.err or "Couldn't buy luck", "Bad")
			end
		end,
	})
	-- AUTO OPEN (game pass; NOT Auto Attack, which is free): locked button prompts the pass
	autoButton = Kit.Button(panel.Body, {
		Text = "🔒 AUTO OPEN",
		Color = "Gray",
		Size = UDim2.fromOffset(170, 34),
		Position = UDim2.new(1, 0, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		TextStyle = "Small",
		ZIndex = 63,
		OnClick = function()
			local crateId = current
			local d = State.Data
			if busy or not crateId or not d then
				return
			end
			local owned = d.Passes and d.Passes[Config.AutoOpen.Pass] == true
			if not owned then
				local res = State.Request("Buy", Config.AutoOpen.Pass)
				if not res.ok then
					Kit.Toast(res.err or "Auto Open isn't available yet", "Bad")
				end
				return
			end
			if player:GetAttribute("AutoOpen") then
				State.Request("AutoOpen", nil)
				refresh()
				return
			end
			if not nearStation(crateId) then
				Kit.Toast("Walk to the crate first!", "Bad")
				return
			end
			busy = true
			local res = State.Request("AutoOpen", crateId)
			busy = false
			if res.ok then
				panel:Close()
				Kit.Toast("AUTO OPEN: ON - stand still at the crate", "Good")
			else
				Kit.Toast(if res.err == "NeedPass" then "Auto Open is a game pass" else (res.err or "Couldn't start"), "Bad")
			end
		end,
	})
end

function CratePanel.Start()
	-- Robux Exclusive Crate: the server grants the hunter and tells us to play the reveal
	-- AUTO OPEN results: play them one after another (never two reveals at once)
	local function playNextAuto()
		if autoPlaying then
			return
		end
		local nextRes = table.remove(autoQueue, 1)
		if not nextRes then
			return
		end
		autoPlaying = true
		openedSignal:Fire(nextRes)
		Reveal.Play(nextRes, nil, { Auto = true })
	end
	Reveal.Finished:Connect(function()
		if autoPlaying then
			autoPlaying = false
			task.defer(playNextAuto)
		end
	end)
	Reveal.AutoStopped:Connect(function()
		table.clear(autoQueue)
	end)
	State.OnFx("AutoOpened", function(data: any)
		if type(data) ~= "table" or type(data.Hunter) ~= "string" or not Config.Hunters[data.Hunter] then
			return
		end
		local res: Reveal.Result = { Crate = tostring(data.Crate), Hunter = data.Hunter, Uid = tostring(data.Uid), IsNew = data.IsNew == true }
		if #autoQueue >= 3 then
			-- reveals can't keep up: list the extra hunter instead of queueing forever
			local h = Config.Hunters[res.Hunter]
			Kit.Toast("Auto Open: " .. Config.Rarities[h.Rarity].Name .. " " .. h.Name, "Good")
			openedSignal:Fire(res)
			return
		end
		table.insert(autoQueue, res)
		if panel.IsOpen then
			panel:Close()
		end
		playNextAuto()
	end)
	State.OnFx("AutoOpenStopped", function(data: any)
		local reason = if type(data) == "table" and type(data.Reason) == "string" then data.Reason else "stopped"
		Kit.Toast("AUTO OPEN stopped: " .. reason, "Bad")
	end)

	State.OnFx("Exclusive", function(data: any)
		if type(data) == "table" and type(data.Hunter) == "string" and Config.Hunters[data.Hunter] then
			if panel.IsOpen then
				panel:Close()
			end
			local res: Reveal.Result = { Crate = "Exclusive", Hunter = data.Hunter, Uid = tostring(data.Uid), IsNew = data.IsNew == true }
			openedSignal:Fire(res)
			Reveal.Play(res, nil)
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh() -- keeps the odds honest when a luck boost runs out
			end
		end
	end)
end

function CratePanel.Button(): TextButton
	return openButton
end

function CratePanel.IsOpen(): boolean
	return panel.IsOpen
end

return CratePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Crew</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every player's equipped Ghost Hunters (client-side, never collide with anything).
-- Idle: follow in a formation behind their player. Assigned (player's "Target" attribute):
-- run to a ring around the ghost, aim and fire a wobbly energy beam, celebrate on the poof,
-- then come back. All crews update in ONE RenderStepped loop: BulkMoveTo for roots, Motor6D
-- transforms for poses, staggered ground raycasts, and far-away crews are hidden.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local HunterRig = require(GH.Rigs.HunterRig)
local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Ghosts = require(script.Parent.Ghosts)
local Targeting = require(script.Parent.Targeting)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Crew = {}

type Member = {
	Id: string,
	Rig: HunterRig.Rig,
	Pos: Vector3,
	Yaw: number,
	State: string,
	GroundY: number,
	NextRay: number,
	Beam: Beam,
	CelebrateUntil: number,
	Phase: number,
	Color: Color3,
}

type CrewData = {
	Player: Player,
	Members: { Member },
	Visible: boolean,
	LastTarget: number,
	NextSpark: number,
	NextSound: number,
	Conns: { RBXScriptConnection },
}

local player = Players.LocalPlayer
local crews: { [Player]: CrewData } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local nextFilter = 0

local VISIBLE_RANGE = 170
local HUNTER_SCALE = 0.88 -- rigs are ~4-4.6 studs; this puts them at a player's chest height
local RUN_SPEED = Config.Combat.HunterRunSpeed

local function refreshFilter()
	local list: { Instance } = { folder }
	for _, name in { "Ghosts", "GHEffects", "GHOrbs", "GHReveal" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function makeBeam(m: Member)
	local beam = Instance.new("Beam")
	beam.Name = "CaptureBeam"
	beam.Attachment0 = m.Rig.Tip
	beam.Color = ColorSequence.new(m.Color, Color3.new(1, 1, 1))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.8, 0.15), NumberSequenceKeypoint.new(1, 0.4) })
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Width0 = 0.35
	beam.Width1 = 0.9
	beam.Enabled = false
	beam.Parent = m.Rig.Model
	m.Beam = beam
end

-- One small line over each hunter: "★ Name" in its rarity colour. Short range (your own crew
-- reads it when the camera is close; it never stacks into clutter from afar).
local function addTag(m: Member, isLocal: boolean)
	local def = Config.Hunters[m.Id]
	local rar = Config.Rarities[def.Rarity]
	local gui = WorldLabel.New({
		Name = "Tag",
		Adornee = m.Rig.Root,
		Parent = m.Rig.Model,
		Size = Theme.World.CrewTag,
		Offset = Vector3.new(0, m.Rig.Height + 0.7, 0),
		MaxDistance = if isLocal then Theme.World.CrewMaxDistance else Theme.World.CrewMaxDistance * 0.6,
	})
	WorldLabel.Text(gui, string.rep("⭐", math.min(rar.Order, 5)) .. " " .. def.Name, { Style = "Tiny", Color = rar.Color })
	-- rare+ hunters stand on a soft rarity-coloured disc
	if rar.Order >= 3 then
		local disc = Instance.new("Part")
		disc.Name = "RarityDisc"
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.12, 3.4, 3.4)
		disc.Material = Enum.Material.SmoothPlastic
		disc.Color = rar.Color
		disc.Transparency = 0.45
		disc.CanCollide = false
		disc.CanQuery = false
		disc.CanTouch = false
		disc.CastShadow = false
		disc.Massless = true
		disc.CFrame = m.Rig.Root.CFrame * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = m.Rig.Root
		w.Part1 = disc
		w.Parent = disc
		disc.Parent = m.Rig.Model
	end
end

local function newMember(id: string, at: Vector3, isLocal: boolean): Member
	local rig = HunterRig.Build(id)
	rig.Model:ScaleTo(HUNTER_SCALE)
	rig.Height *= HUNTER_SCALE
	for _, p in rig.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	rig.Model:PivotTo(CFrame.new(at))
	rig.Model.Parent = folder
	local def = Config.Hunters[id]
	local m: Member = {
		Id = id,
		Rig = rig,
		Pos = at,
		Yaw = 0,
		State = "Idle",
		GroundY = at.Y,
		NextRay = 0,
		Beam = nil :: any,
		CelebrateUntil = 0,
		Phase = math.random() * 10,
		Color = def.Look.Beam,
	}
	makeBeam(m)
	addTag(m, isLocal)
	return m
end

local function rootOf(pl: Player): BasePart?
	local char = pl.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function rebuild(c: CrewData)
	local raw = c.Player:GetAttribute("Crew")
	local ids = {}
	if type(raw) == "string" and raw ~= "" then
		for id in raw:gmatch("[^,]+") do
			if Config.Hunters[id] and #ids < 12 then
				table.insert(ids, id)
			end
		end
	end
	local root = rootOf(c.Player)
	local at = if root then root.Position - Vector3.new(0, 3, 0) else Vector3.zero
	local isLocal = c.Player == player
	for i, id in ids do
		local m = c.Members[i]
		if not m or m.Id ~= id then
			if m then
				m.Rig.Model:Destroy()
			end
			local spawnAt = if m then m.Pos else at + Vector3.new((i - 2.5) * 2, 0, 3)
			c.Members[i] = newMember(id, spawnAt, isLocal)
			if isLocal and m == nil and os.clock() > 3 then
				Effects.Burst(spawnAt + Vector3.new(0, 2, 0), { Color = Config.Rarities[Config.Hunters[id].Rarity].Color, Count = 14, Size = 0.7, Speed = 10 })
			end
		end
	end
	for i = #c.Members, #ids + 1, -1 do
		c.Members[i].Rig.Model:Destroy()
		c.Members[i] = nil
	end
	if not c.Visible then
		for _, m in c.Members do
			m.Rig.Model.Parent = nil
		end
	end
end

local function addPlayer(pl: Player)
	if crews[pl] then
		return
	end
	local c: CrewData = {
		Player = pl,
		Members = {},
		Visible = true,
		LastTarget = 0,
		NextSpark = 0,
		NextSound = 0,
		Conns = {},
	}
	crews[pl] = c
	table.insert(c.Conns, pl:GetAttributeChangedSignal("Crew"):Connect(function()
		rebuild(c)
	end))
	rebuild(c)
end

local function removePlayer(pl: Player)
	local c = crews[pl]
	if not c then
		return
	end
	for _, conn in c.Conns do
		conn:Disconnect()
	end
	for _, m in c.Members do
		m.Rig.Model:Destroy()
	end
	crews[pl] = nil
end

local function setVisible(c: CrewData, on: boolean, root: BasePart?)
	if c.Visible == on then
		return
	end
	c.Visible = on
	for i, m in c.Members do
		m.Rig.Model.Parent = if on then folder else nil
		if on and root then
			-- snap back into formation instead of sprinting across the map
			m.Pos = root.Position + Vector3.new((i - 2.5) * 2.5, -3, 4)
			m.NextRay = 0
		end
	end
end

local function angleDiff(a: number, b: number): number
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

local function centerAttachment(e: Ghosts.Entry): Attachment
	local a = e.Core:FindFirstChild("Center")
	if a and a:IsA("Attachment") then
		return a
	end
	local made = Instance.new("Attachment")
	made.Name = "Center"
	made.Parent = e.Core
	return made
end

local roots: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	dt = math.min(dt, 0.1)
	local clock = os.clock()
	if clock > nextFilter then
		nextFilter = clock + 2
		refreshFilter()
	end
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(roots)
	table.clear(cframes)

	for pl, c in crews do
		local root = rootOf(pl)
		local isLocal = pl == player
		if not root or #c.Members == 0 then
			setVisible(c, false, nil)
			continue
		end
		local far = not isLocal and (root.Position - camPos).Magnitude > VISIBLE_RANGE
		setVisible(c, not far, root)
		if far then
			continue
		end
		local footY = root.Position.Y - 3
		-- your own crew reacts to your tap instantly; others follow the server's choice
		local uid = if isLocal then Targeting.LocalTarget() else ((pl:GetAttribute("Target") :: number?) or 0)
		local ghost = if uid ~= 0 then Ghosts.Get(uid) else nil
		if ghost and (ghost.Pos - root.Position).Magnitude > Config.Combat.MaxRange * 1.5 then
			ghost = nil
		end
		if ghost then
			c.LastTarget = uid
		end
		local n = #c.Members
		local anyAttacking = false
		local rootLook = root.CFrame.LookVector
		local rootYaw = math.atan2(-rootLook.X, -rootLook.Z)
		local flatRoot = CFrame.new(root.Position) * CFrame.Angles(0, rootYaw, 0)
		local speedNow = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude

		for i, m in c.Members do
			local goal: Vector3
			local faceTo: Vector3? = nil
			local attackMode = false
			if m.CelebrateUntil > clock then
				goal = m.Pos
			elseif ghost then
				attackMode = true
				local gp = ghost.Pos
				local away = Vector3.new(root.Position.X - gp.X, 0, root.Position.Z - gp.Z)
				local base = if away.Magnitude > 0.1 then math.atan2(away.X, away.Z) else 0
				local spread = math.rad(math.min(160, 42 * (n - 1)))
				local a = base + (if n > 1 then -spread / 2 + spread * (i - 1) / (n - 1) else 0)
				local r = 3.2 + ghost.Def.Scale * 2.2
				goal = Vector3.new(gp.X + math.sin(a) * r, m.Pos.Y, gp.Z + math.cos(a) * r)
				faceTo = gp
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local inRow = math.min(3, n - row * 3)
				local x = (col - (inRow - 1) / 2) * 3.2
				local z = 4.6 + row * 3.4
				goal = (flatRoot * CFrame.new(x, 0, z)).Position
			end
			-- move (XZ), teleport if hopelessly far
			local delta = Vector3.new(goal.X - m.Pos.X, 0, goal.Z - m.Pos.Z)
			local dist = delta.Magnitude
			if dist > 75 then
				m.Pos = Vector3.new(goal.X, footY, goal.Z)
				m.NextRay = 0
				dist = 0
			elseif dist > 0.05 then
				local speed = if attackMode then RUN_SPEED else math.max(14, speedNow * 1.15 + dist * 2)
				local stepLen = math.min(dist, speed * dt)
				m.Pos += delta.Unit * stepLen
			end
			-- ground snap (staggered raycasts)
			if clock >= m.NextRay then
				m.NextRay = clock + 0.18 + math.random() * 0.08
				local hit = workspace:Raycast(Vector3.new(m.Pos.X, root.Position.Y + 3, m.Pos.Z), Vector3.new(0, -20, 0), rayParams)
				m.GroundY = if hit then math.clamp(hit.Position.Y, footY - 10, footY + 4) else footY
			end
			local y = m.Pos.Y + (m.GroundY - m.Pos.Y) * math.min(1, dt * 14)
			m.Pos = Vector3.new(m.Pos.X, y, m.Pos.Z)

			-- facing
			local wantYaw = m.Yaw
			if faceTo and dist < 4 then
				local f = Vector3.new(faceTo.X - m.Pos.X, 0, faceTo.Z - m.Pos.Z)
				if f.Magnitude > 0.1 then
					wantYaw = math.atan2(-f.X, -f.Z)
				end
			elseif dist > 0.6 then
				wantYaw = math.atan2(-delta.X, -delta.Z)
			elseif not ghost then
				wantYaw = rootYaw
			end
			m.Yaw += angleDiff(m.Yaw, wantYaw) * math.min(1, dt * 12)

			-- state
			local state
			if m.CelebrateUntil > clock then
				state = "Celebrate"
			elseif attackMode and dist < 4 then
				state = "Attack"
			elseif dist > 0.6 then
				state = "Run"
			else
				state = "Idle"
			end
			m.State = state
			HunterRig.Pose(m.Rig, state, clock + m.Phase, 1)

			-- beam
			local beam = m.Beam
			if state == "Attack" and ghost then
				anyAttacking = true
				local att = centerAttachment(ghost)
				if beam.Attachment1 ~= att then
					beam.Attachment1 = att
				end
				beam.Enabled = true
				local w = math.sin(clock * 9 + m.Phase)
				beam.CurveSize0 = w * 1.6
				beam.CurveSize1 = -w * 1.1
				beam.Width0 = 0.3 + 0.12 * math.sin(clock * 22 + m.Phase)
				beam.Width1 = 0.7 + 0.25 * math.sin(clock * 17 + m.Phase)
				-- RAINBOW BEAMS pass (cosmetic): hue cycles along the beam
				if pl:GetAttribute("RainbowBeams") == true then
					local h = (clock * 0.35 + m.Phase * 0.1) % 1
					beam.Color = ColorSequence.new(Color3.fromHSV(h, 0.75, 1), Color3.fromHSV((h + 0.35) % 1, 0.75, 1))
				end
			elseif beam.Enabled then
				beam.Enabled = false
			end

			table.insert(roots, m.Rig.Root)
			table.insert(cframes, CFrame.new(m.Pos) * CFrame.Angles(0, m.Yaw, 0))
		end

		-- impact sparks + soft zaps for your own crew only (keeps busy servers cheap)
		if isLocal and anyAttacking and ghost then
			if clock >= c.NextSpark then
				c.NextSpark = clock + 0.3
				local m = c.Members[math.random(1, n)]
				local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * ghost.Def.Scale * 2
				Effects.Burst(ghost.Pos + off, { Color = m.Color, Count = 7, Size = 0.5, Speed = 9, Life = 0.4 })
			end
			if clock >= c.NextSound then
				c.NextSound = clock + 0.45
				Sound.Play("Attack", 0.15)
			end
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Crew.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHCrews"
	folder.Parent = workspace
end

function Crew.Start()
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(removePlayer)
	for _, pl in Players:GetPlayers() do
		addPlayer(pl)
	end
	-- victory pose when a ghost they were fighting poofs
	Ghosts.Died:Connect(function(uid: number)
		local until_ = os.clock() + 0.9
		for _, c in crews do
			if c.LastTarget == uid then
				for _, m in c.Members do
					if m.State == "Attack" then
						m.CelebrateUntil = until_
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

-- Local crew members (for the crate reveal / tutorial).
function Crew.LocalCount(): number
	local c = crews[player]
	return if c then #c.Members else 0
end

return Crew
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">DailyPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DAILY reward: Day 1-7 tiles, a big golden Day 7, CLAIM button or a countdown.
-- Timing is decided by the server's clock (the client only displays it).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local DailyPanel = {}

type Tile = { Frame: Frame, Check: TextLabel, Today: TextLabel, Reward: TextLabel, Scale: UIScale }

local panel: Kit.Panel
local tiles: { Tile } = {}
local claimButton: TextButton
local statusLabel: TextLabel
local busy = false

local function rewardLabel(i: number, mult: number): string
	local r = Config.Daily.Rewards[i]
	if r.Amount and mult > 1 then
		return (r.Label:gsub(Format.Commas(r.Amount), Format.Commas(r.Amount * mult)))
	end
	return r.Label
end

local function remaining(d: any): number
	local info = d.DailyInfo
	if not info then
		return 0
	end
	return math.max(0, info.Wait - (State.Now() - (d.ServerTime or State.Now())))
end

local function refresh()
	local d = State.Data
	if not d or not d.DailyInfo then
		return
	end
	local info = d.DailyInfo
	local left = remaining(d)
	local canClaim = info.CanClaim or left <= 0
	local day = info.Day
	local claimed = if canClaim then day - 1 elseif day == 1 then #Config.Daily.Rewards else day - 1
	local mult = d.ZoneMultiplier or 1
	for i, t in tiles do
		t.Reward.Text = rewardLabel(i, mult)
		t.Check.Visible = i <= claimed
		t.Today.Visible = canClaim and i == day
		t.Frame.BackgroundTransparency = if i <= claimed then 0.45 else 0
	end
	if canClaim then
		Kit.SetButtonText(claimButton, "CLAIM DAY " .. day .. "!")
		claimButton:SetAttribute("Color", "Green")
		statusLabel.Text = if info.StreakBroken then "Streak reset - start again from Day 1!" else "Come back every day for bigger rewards!"
	else
		Kit.SetButtonText(claimButton, "NEXT IN " .. Format.Time(left))
		claimButton:SetAttribute("Color", "Gray")
		statusLabel.Text = "Day " .. day .. " unlocks in " .. Format.Time(left) .. ". Don't miss a day or your streak resets!"
	end
end

local function claim()
	if busy then
		return
	end
	busy = true
	local res = State.Request("ClaimDaily")
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Not yet!", "Bad")
		return
	end
	Sound.Play("Daily")
	Hud.Banner("DAY " .. tostring(res.Day) .. " REWARD!", res.Label, Theme.Gold)
	local t = tiles[res.Day]
	if t then
		t.Scale.Scale = 1.25
		Kit.Tween(t.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Effects.Burst(root.Position + Vector3.new(0, 2, 0), { Color = Theme.Gold, Color2 = Theme.Ecto, Count = 50, Size = 1, Speed = 20 })
	end
end

function DailyPanel.Init()
	panel = Kit.Panel("Daily", "DAILY REWARDS", Vector2.new(700, 440), "Purple")
	-- tiles wrap to the panel width (4 per row on wide screens) and scroll if short
	local grid: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -96),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(148, 124), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6), Parent = grid })
	for i = 1, #Config.Daily.Rewards do
		local big = i == #Config.Daily.Rewards
		local f: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = grid,
		})
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		if big then
			Kit.Gradient(f, Theme.Gold, Color3.fromRGB(255, 120, 40), 90)
		else
			Kit.Gradient(f, Theme.Panel3, Theme.Panel2, 90)
		end
		local sc = Kit.new("UIScale", { Parent = f })
		Kit.Label(f, "DAY " .. i, { Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 4), Style = "Heading", ZIndex = 63 })
		local r = Config.Daily.Rewards[i]
		local icon = if r.Kind == "Day7" then "🎁" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "🍀" else "⚡") else "💚"
		local iconKey = if r.Kind == "Day7" then "menu_daily" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "boost_luck" else "boost_ecto2x") else "ecto_pile"
		Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 28), Style = "Icon", TextSize = 28, ZIndex = 63, Stroke = 0 })
		local reward = Kit.Label(f, r.Label, { Size = UDim2.new(1, -12, 0, 52), Position = UDim2.fromOffset(6, 66), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Style = "Small" })
		local check = Kit.Label(f, "✅", { Size = UDim2.fromScale(1, 1), Color = Theme.Good, ZIndex = 66, Style = "Banner", Stroke = 3 })
		check.Visible = false
		local today = Kit.Label(f, "TODAY!", { Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, 4, 0, -8), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 67, Stroke = 2 })
		today.Rotation = 8
		today.Visible = false
		table.insert(tiles, { Frame = f, Check = check, Today = today, Reward = reward, Scale = sc })
	end
	statusLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 1, -82), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 })
	claimButton = Kit.Button(panel.Body, {
		Text = "CLAIM",
		Color = "Green",
		Size = UDim2.fromOffset(280, 48),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = claim,
	})
	panel.Primary = claimButton
	Hud.RegisterPanel("Daily", function()
		panel:Toggle()
	end)
end

function DailyPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
	-- a returning player with a reward waiting gets the panel once, a few seconds after joining
	task.spawn(function()
		local d = State.WaitForData()
		task.wait(6)
		if d.DailyInfo and d.DailyInfo.CanClaim and (d.Tutorial or 1) > #Config.Tutorial.Steps and not Kit.CurrentPanel() then
			panel:Open()
		end
	end)
end

return DailyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DEV panel: owner-only test tools. The 🛠 button appears only when the server marked this
-- player as a developer (attribute "IsDev"); every action is checked again on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local DevPanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local inbox: Kit.Panel
local inboxList: ScrollingFrame
local devButton: TextButton

local function showInbox()
	local res = State.Request("FeedbackInbox")
	if not res.ok then
		Kit.Toast(res.err or "Couldn't load feedback", "Bad")
		return
	end
	for _, c in inboxList:GetChildren() do
		if c:IsA("Frame") or c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local entries = res.Entries or {}
	if #entries == 0 then
		Kit.Label(inboxList, "No feedback yet.", { Size = UDim2.new(1, 0, 0, 30), Style = "Body", ZIndex = 62 })
	end
	for i, e in entries do
		local f: Frame = Kit.new("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.3, LayoutOrder = i, ZIndex = 62, Parent = inboxList })
		Kit.Corner(f, UDim.new(0, 10))
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = f })
		Kit.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = f })
		local head = (if e.Kind == "Bug" then "🐞 BUG" else "💡 IDEA") .. "  ·  " .. tostring(e.Name) .. "  ·  " .. tostring(e.Zone) .. "  ·  " .. os.date("%Y-%m-%d %H:%M", e.T or 0) .. "  ·  v" .. tostring(e.Version)
		local h = Kit.Label(f, head, { Size = UDim2.new(1, 0, 0, 16), Align = Enum.TextXAlignment.Left, Color = if e.Kind == "Bug" then Theme.Bad else Theme.Ecto, Style = "Tiny", Fit = true, ZIndex = 63 })
		h.LayoutOrder = 1
		local t = Kit.Label(f, tostring(e.Text), { Size = UDim2.new(1, 0, 0, 0), Align = Enum.TextXAlignment.Left, AlignY = Enum.TextYAlignment.Top, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 63 })
		t.AutomaticSize = Enum.AutomaticSize.Y
		t.LayoutOrder = 2
	end
	panel:Close()
	inbox:Open()
end

type Action = { Text: string, Cmd: string, Arg: any?, Color: string, Confirm: boolean? }
local ACTIONS: { Action } = {
	{ Text = "+10K ECTO", Cmd = "Ecto", Arg = 10000, Color = "Green" },
	{ Text = "+1M ECTO", Cmd = "Ecto", Arg = 1000000, Color = "Green" },
	{ Text = "+1B ECTO", Cmd = "Ecto", Arg = 1000000000, Color = "Green" },
	{ Text = "+1T ECTO", Cmd = "Ecto", Arg = 1000000000000, Color = "Green" },
	{ Text = "UNLOCK ALL AREAS", Cmd = "Zones", Color = "Blue" },
	{ Text = "ALL 32 HUNTERS", Cmd = "Hunters", Color = "Orange" },
	{ Text = "MAX UPGRADES", Cmd = "MaxUpgrades", Color = "Teal" },
	{ Text = "START EVENT", Cmd = "Event", Color = "Pink" },
	{ Text = "2X ECTOPLASM: 2 DAYS", Cmd = "Ecto2x", Arg = 48, Color = "Green" },
	{ Text = "2X ECTOPLASM: ON", Cmd = "Ecto2x", Arg = true, Color = "Green" },
	{ Text = "2X ECTOPLASM: OFF", Cmd = "Ecto2x", Arg = false, Color = "Red" },
	{ Text = "RESET DAILY", Cmd = "ResetDaily", Color = "Purple" },
	{ Text = "AUTO ATTACK PASS", Cmd = "AutoAttack", Color = "Purple" },
	{ Text = "ALL GAME PASSES", Cmd = "AllPasses", Color = "Purple" },
	{ Text = "SERVER LUCK 15M", Cmd = "ServerLuck", Color = "Green" },
	{ Text = "EXCLUSIVE HUNTER", Cmd = "Exclusive", Color = "Teal" },
	{ Text = "REPLAY TUTORIAL", Cmd = "Tutorial", Color = "Gray" },
	{ Text = "💬 READ FEEDBACK", Cmd = "Inbox", Color = "Blue" },
	{ Text = "⚠️ RESET MY PROGRESS", Cmd = "ResetProgress", Color = "Red", Confirm = true },
}

local armed: { [string]: number } = {} -- dangerous actions need a second tap within 4 s

local function run(a: Action)
	if a.Cmd == "Inbox" then
		showInbox()
		return
	end
	if a.Confirm then
		local t = armed[a.Cmd]
		if not t or os.clock() - t > 4 then
			armed[a.Cmd] = os.clock()
			Kit.Toast("Tap " .. a.Text .. " again to confirm", "Bad")
			return
		end
		armed[a.Cmd] = nil
	end
	local res = State.Request("Dev", a.Cmd, a.Arg)
	if res.ok then
		Kit.Toast(if a.Cmd == "Ecto" then "+" .. Format.Short(a.Arg :: number) .. " Ectoplasm" else a.Text .. " ✅", "Good")
	else
		Kit.Toast(res.err or "Failed", "Bad")
	end
end

function DevPanel.Init()
	panel = Kit.Panel("Dev", "🛠 DEV TOOLS", Vector2.new(620, 360), "Gray")
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 46), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = list })
	for i, a in ACTIONS do
		local b = Kit.Button(list, { Text = a.Text, Color = a.Color, TextStyle = "Small", ZIndex = 62, OnClick = function()
			run(a)
		end })
		b.LayoutOrder = i
		if i == 1 then
			panel.Primary = b
		end
	end
	Kit.Label(panel.Body, "Only you can see this. In a live server these change your real save.", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), Color = Theme.Muted, Font = Theme.Body, Style = "Tiny", Stroke = 0, ZIndex = 62 })

	inbox = Kit.Panel("DevInbox", "💬 PLAYER FEEDBACK", Vector2.new(760, 460), "Blue")
	inboxList = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -8),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = inbox.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inboxList })

	-- lower-right row next to FEEDBACK / SETTINGS
	devButton = Kit.Button(Hud.LowerRow or Kit.Screen(), {
		Text = "🛠",
		Color = "Gray",
		Size = UDim2.fromOffset(44, 44),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	devButton.Visible = false
	devButton.LayoutOrder = 1
end

function DevPanel.Start()
	local function refresh()
		devButton.Visible = player:GetAttribute("IsDev") == true
	end
	player:GetAttributeChangedSignal("IsDev"):Connect(refresh)
	refresh()
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Short-lived VFX helpers (bursts, rings, sparkles). All local, all self-cleaning, and capped
-- so a busy moment never turns into a GPU benchmark.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

Effects.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local folder: Folder
local live = 0
local MAX_LIVE = 24

local function holder(pos: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = folder
	return p
end

export type BurstOpts = {
	Color: Color3,
	Color2: Color3?,
	Count: number?,
	Size: number?,
	Speed: number?,
	Life: number?,
	Texture: string?,
	Spread: number?,
	Gravity: number?,
	LightEmission: number?,
}

function Effects.Burst(pos: Vector3, o: BurstOpts)
	if live >= MAX_LIVE then
		return
	end
	live += 1
	local p = holder(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or Effects.Textures.Sparkle
	e.Color = ColorSequence.new(o.Color, o.Color2 or o.Color)
	local size = o.Size or 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.6, size * 0.8), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	local life = o.Life or 0.7
	e.Lifetime = NumberRange.new(life * 0.6, life)
	local speed = o.Speed or 18
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Acceleration = Vector3.new(0, -(o.Gravity or 0), 0)
	e.Drag = 3
	e.LightEmission = o.LightEmission or 1
	e.Rate = 0
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = p
	e:Emit(math.min(o.Count or 20, 160))
	task.delay(life + 0.2, function()
		live -= 1
		p:Destroy()
	end)
end

-- Expanding flat neon ring on the ground / around a point.
function Effects.Ring(pos: Vector3, color: Color3, radius: number, time: number?)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Size = Vector3.new(0.3, 1, 1)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = folder
	local t = time or 0.5
	TweenService:Create(r, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(r, t + 0.05)
end

-- Expanding glowing sphere (poofs, reveal flashes).
function Effects.Flash(pos: Vector3, color: Color3, radius: number, time: number?)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.Neon
	s.Color = color
	s.Transparency = 0.15
	s.Size = Vector3.new(1, 1, 1) * radius * 0.4
	s.CFrame = CFrame.new(pos)
	s.Parent = folder
	local t = time or 0.35
	TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(1, 1, 1) * radius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(s, t + 0.05)
end

-- The signature ghost POOF: flash + cloud + sparkles + ring.
function Effects.Poof(pos: Vector3, color: Color3, scale: number, big: boolean)
	Effects.Flash(pos, Color3.new(1, 1, 1), 3 * scale, 0.25)
	Effects.Flash(pos, color, 4.5 * scale, 0.45)
	Effects.Burst(pos, { Color = Color3.fromRGB(245, 240, 255), Color2 = color, Count = if big then 40 else 18, Size = 2.2 * scale, Speed = 10 * scale, Life = 0.8, Texture = Effects.Textures.Smoke, LightEmission = 0.3 })
	Effects.Burst(pos, { Color = color, Count = if big then 60 else 24, Size = 0.9 * math.sqrt(scale), Speed = 22 * math.sqrt(scale), Life = 0.7 })
	Effects.Ring(pos, color, 7 * scale, 0.5)
end

function Effects.Folder(): Folder
	return folder
end

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHEffects"
	folder.Parent = workspace
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">EventPopup</string>
              <string name="Source"><![CDATA[--!strict
-- 2X ECTOPLASM EVENT announcement. Shown when a developer turns the global event on, and once
-- after joining while it is already on. Closing it only hides the popup (the event keeps
-- running; the "2X ECTOPLASM EVENT" chip under the counters stays while it's active).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local EventPopup = {}

local panel: Kit.Panel
local shownThisSession = false
local _ = GH

local function show()
	if panel.IsOpen then
		return
	end
	shownThisSession = true
	Sound.Play("ZoneUnlock")
	panel:Open()
end

function EventPopup.Init()
	panel = Kit.Panel("Ecto2xEvent", "2X ECTOPLASM EVENT!", Vector2.new(460, 270), "Green")
	local body = panel.Body
	-- solid colour, no UIGradient: on phones the gradient-filled 56 px "2X" lost its "2" and
	-- flickered (seen in a player recording)
	Kit.Label(body, "2X", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 12), Color = Theme.Ecto, Style = "Banner", TextSize = 48, ZIndex = 62, Stroke = 3 })
	Kit.Label(body, "Earn DOUBLE Ectoplasm from ghosts while the event is active!", { Size = UDim2.new(1, -20, 0, 48), Position = UDim2.fromOffset(10, 80), Style = "Body", ZIndex = 62 })
	local ok = Kit.Button(body, {
		Text = "LET'S HUNT!",
		Color = "Green",
		Size = UDim2.fromOffset(220, 48),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			panel:Close()
		end,
	})
	panel.Primary = ok
end

function EventPopup.Start()
	State.OnFx("Ecto2xEvent", function(data: any)
		if type(data) == "table" and data.On == true then
			show()
		elseif panel.IsOpen then
			panel:Close()
		end
	end)
	-- joined while the event is already on: show it once, after loading settles
	task.spawn(function()
		State.WaitForData()
		task.wait(4)
		if workspace:GetAttribute("Ecto2x") == true and not shownThisSession and not Kit.CurrentPanel() then
			show()
		end
	end)
end

return EventPopup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">FeedbackPanel</string>
              <string name="Source"><![CDATA[--!strict
-- FEEDBACK: players send a bug report or an idea (Settings → SEND FEEDBACK). The server filters
-- and stores it; the owner reads them in the DEV panel (FeedbackInbox).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local FeedbackPanel = {}

local panel: Kit.Panel
local box: TextBox
local counter: TextLabel
local kindButtons: { [string]: TextButton } = {}
local kind = "Bug"
local busy = false

local function setKind(k: string)
	kind = k
	for id, b in kindButtons do
		b:SetAttribute("Color", if id == k then (if id == "Bug" then "Red" else "Blue") else "Gray")
	end
	box.PlaceholderText = if k == "Bug"
		then "What went wrong? Where were you and what did you do?"
		else "What would make the game more fun?"
end

local function send()
	if busy then
		return
	end
	local text = box.Text
	if #text < Config.Feedback.MinLength then
		Kit.Toast("Tell us a bit more!", "Bad")
		return
	end
	busy = true
	local res = State.Request("Feedback", kind, text)
	busy = false
	if res.ok then
		box.Text = ""
		panel:Close()
		Kit.Toast("Thanks! Your " .. (if kind == "Bug" then "bug report" else "idea") .. " was sent 💚", "Good")
	else
		Kit.Toast(res.err or "Couldn't send", "Bad")
	end
end

function FeedbackPanel.Init()
	panel = Kit.Panel("Feedback", "💬 FEEDBACK", Vector2.new(520, 360), "Blue")
	local body = panel.Body
	local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 10), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), Parent = row })
	for _, k in { "Bug", "Idea" } do
		kindButtons[k] = Kit.Button(row, {
			Text = if k == "Bug" then "🐞 BUG" else "💡 IDEA",
			Color = "Gray",
			Size = UDim2.fromOffset(150, 40),
			TextStyle = "Body",
			ZIndex = 62,
			OnClick = function()
				setKind(k)
			end,
		})
	end
	local frame: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 1, -128), Position = UDim2.fromOffset(0, 58), BackgroundColor3 = Theme.Bg, ZIndex = 61, Parent = body })
	Kit.Corner(frame, UDim.new(0, 12))
	Kit.Stroke(frame, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	box = Kit.new("TextBox", {
		Size = UDim2.new(1, -20, 1, -16),
		Position = UDim2.fromOffset(10, 8),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Body,
		TextSize = Theme.Type.Body,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		Text = "",
		ZIndex = 62,
		Parent = frame,
	})
	counter = Kit.Label(body, "0 / " .. Config.Feedback.MaxLength, { Size = UDim2.fromOffset(110, 18), Position = UDim2.new(1, 0, 1, -66), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = Theme.Muted, Style = "Tiny", Stroke = 0, ZIndex = 62 })
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.Feedback.MaxLength then
			box.Text = box.Text:sub(1, Config.Feedback.MaxLength)
		end
		counter.Text = #box.Text .. " / " .. Config.Feedback.MaxLength
	end)
	local sendButton = Kit.Button(body, {
		Text = "SEND",
		Color = "Green",
		Size = UDim2.fromOffset(220, 46),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = send,
	})
	panel.Primary = sendButton
	setKind("Bug")
	Hud.RegisterPanel("Feedback", function()
		panel:Toggle()
	end)
end

return FeedbackPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">GatePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Zone gate confirm: "UNLOCK CEMETERY?" with cost, progress and what you get. The gate's
-- ProximityPrompt opens it; the server checks cost, order and distance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)

local GatePanel = {}

local panel: Kit.Panel
local costLabel: TextLabel
local fill: Frame
local progressLabel: TextLabel
local unlockButton: TextButton
local current: string? = nil
local busy = false

local function refresh()
	local d = State.Data
	local zone = current and Config.ZoneById[current]
	if not d or not zone then
		return
	end
	panel.Title.Text = "UNLOCK " .. zone.Name .. "?"
	Kit.EctoText(costLabel, "💚 " .. Format.Short(zone.Cost) .. " ECTOPLASM")
	local frac = math.clamp(d.Ecto / math.max(zone.Cost, 1), 0, 1)
	Kit.Tween(fill, 0.25, { Size = UDim2.fromScale(math.max(frac, 0.03), 1) })
	progressLabel.Text = Format.Short(math.min(d.Ecto, zone.Cost)) .. " / " .. Format.Short(zone.Cost)
	if d.Zones[zone.Id] then
		Kit.SetButtonText(unlockButton, "UNLOCKED ✅")
		unlockButton:SetAttribute("Color", "Gray")
	elseif d.Ecto >= zone.Cost then
		Kit.SetButtonText(unlockButton, "UNLOCK!")
		unlockButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(unlockButton, "NEED " .. Format.Short(zone.Cost - d.Ecto) .. " MORE")
		unlockButton:SetAttribute("Color", "Gray")
	end
end

function GatePanel.Open(zoneId: string)
	if not Config.ZoneById[zoneId] then
		return
	end
	current = zoneId
	refresh()
	panel:Open()
end

function GatePanel.Init()
	panel = Kit.Panel("Gate", "UNLOCK?", Vector2.new(520, 330), "Green")
	local body = panel.Body
	costLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 14), Color = Theme.Ecto, Style = "Heading", ZIndex = 62 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(0.8, 0, 0, 24), Position = UDim2.new(0.1, 0, 0, 48), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(0.03, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Theme.Ecto, Theme.Ecto2, 0)
	progressLabel = Kit.Label(bar, "", { Style = "Small", ZIndex = 64 })
	local perks: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), Position = UDim2.fromOffset(0, 84), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 38), CellPadding = UDim2.fromOffset(10, 8), Parent = perks })
	for _, p in { "👻 NEW GHOSTS", "📦 NEW CRATE", "🔦 BETTER HUNTERS", "💚 HIGHER REWARDS" } do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Theme.Panel3, ZIndex = 62, Parent = perks })
		Kit.Corner(f, UDim.new(0, 10))
		local pl = Kit.Label(f, p, { Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0), Style = "Body", Fit = true, ZIndex = 63 })
		Kit.EctoText(pl, p)
	end
	unlockButton = Kit.Button(body, {
		Text = "UNLOCK!",
		Color = "Green",
		Size = UDim2.fromOffset(260, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			local zoneId = current
			local d = State.Data
			if busy or not zoneId or not d or d.Zones[zoneId] then
				return
			end
			if d.Ecto < (Config.ZoneById[zoneId] :: Config.ZoneDef).Cost then
				Kit.Toast("Defeat more ghosts to earn Ectoplasm!", "Bad")
				return
			end
			busy = true
			local res = State.Request("UnlockZone", zoneId)
			busy = false
			if res.ok then
				panel:Close()
			else
				Kit.Toast(res.err or "Couldn't unlock", "Bad")
			end
		end,
	})
	panel.Primary = unlockButton
end

function GatePanel.Start()
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return GatePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Ghosts</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side ghost presentation. The server sends each ghost as a single invisible hitbox
-- (`Core`, the tap target) plus attributes; this module builds the visual rig locally
-- (GhostRig), moves both along the server's wander segments, and handles bobbing, facing,
-- Spirit labels, the selected-ghost state (active label + ground ring), hit wobble, spawn-in
-- and the POOF. One RenderStepped loop for all ghosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Signal = require(GH.Signal)
local Format = require(GH.Logic.Format)
local GhostRig = require(GH.Rigs.GhostRig)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Ghosts = {}

export type Entry = {
	Uid: number,
	Model: Model, -- server model (hitbox)
	Core: BasePart, -- server hitbox (tap target, beam attachments)
	Vis: Model, -- local visual rig
	VisCore: BasePart,
	Def: Config.GhostDef,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	Phase: number,
	Max: number,
	Spirit: number,
	Gui: BillboardGui,
	NameLabel: TextLabel,
	Bar: Frame,
	Fill: Frame,
	SpiritText: TextLabel,
	HitT: number,
	Yaw: number,
	Dying: boolean,
	Pos: Vector3, -- visual centre this frame
	Base: Vector3, -- centre without bob (for the ground ring)
	Selected: boolean,
	Culled: boolean,
}

local entries: { [number]: Entry } = {}
local player = Players.LocalPlayer
local diedSignal = Signal.new()
Ghosts.Died = diedSignal -- (uid, pos)
local addedSignal = Signal.new()
Ghosts.Added = addedSignal -- (entry)
local selectedUid = 0
local ring: Part
local ringStroke: UIStroke

function Ghosts.Get(uid: number): Entry?
	return entries[uid]
end

function Ghosts.All(): { [number]: Entry }
	return entries
end

-- Finds the ghost entry owning an instance (for tap targeting).
function Ghosts.FromInstance(inst: Instance?): Entry?
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") then
			local uid = cur:GetAttribute("Uid")
			if type(uid) == "number" and entries[uid] then
				return entries[uid]
			end
		end
		cur = cur.Parent
	end
	return nil
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function labelSize(e: Entry): Vector2
	local boss = e.Def.Kind == "Boss" or e.Def.Kind == "Event"
	if e.Selected then
		return if boss then Theme.World.BossLabelSelected else Theme.World.GhostLabelSelected
	end
	return if boss then Theme.World.BossLabel else Theme.World.GhostLabel
end

local function maxDistance(e: Entry): number
	if e.Selected then
		return Theme.World.SelectedMaxDistance
	end
	return if e.Def.Kind == "Normal" then Theme.World.GhostMaxDistance else Theme.World.BossMaxDistance
end

-- Spirit value on the bar: "x / max" when selected (and on bosses), just "x" otherwise.
local function spiritText(e: Entry)
	e.SpiritText.Text = if e.Selected or e.Def.Kind ~= "Normal"
		then Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max)
		else Format.Short(e.Spirit)
end

-- Unselected: name + slim bar. Selected: bigger bar with numbers, brighter, visible further,
-- drawn on top so you never lose your target.
local function styleLabel(e: Entry)
	spiritText(e)
	WorldLabel.Resize(e.Gui, labelSize(e))
	e.Gui.MaxDistance = maxDistance(e)
	e.Gui.AlwaysOnTop = e.Selected
	WorldLabel.SetTextStyle(e.SpiritText, if e.Selected then "Small" else "Tiny")
	e.Bar.Size = UDim2.fromScale(0.9, if e.Selected then 0.5 else 0.42)
	local st = e.Bar:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = if e.Selected then Color3.new(1, 1, 1) else Theme.Outline
		st.Thickness = if e.Selected then 2 else 1.5
	end
	e.NameLabel.TextColor3 = if e.Selected then Theme.Gold elseif e.Def.Kind ~= "Normal" then Color3.fromRGB(255, 230, 150) else Theme.Text
end

local function buildLabel(e: Entry)
	local def = e.Def
	-- above the head: hitbox top + a little, scaled with the ghost
	local gui = WorldLabel.New({
		Name = "SpiritGui",
		Adornee = e.Core,
		Parent = e.Model,
		Size = labelSize(e),
		Offset = Vector3.new(0, 2.6 * def.Scale + 0.8, 0),
		MaxDistance = Theme.World.GhostMaxDistance,
	})
	local nameText = def.Name
	if def.Kind == "MiniBoss" then
		nameText = "⭐ " .. nameText
	elseif def.Kind == "Boss" or def.Kind == "Event" then
		nameText = "👑 " .. nameText
	end
	e.NameLabel = WorldLabel.Text(gui, nameText, { Size = UDim2.fromScale(1, 0.48), Style = if def.Kind == "Normal" or def.Kind == "MiniBoss" then "Small" else "Body" })
	local bar: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(0.9, 0.42),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 15, 50),
		Parent = gui,
	})
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 1.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local fill: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, def.Glow, Color3.fromRGB(180, 120, 255), 0)
	e.SpiritText = WorldLabel.Text(bar, "", { Style = "Tiny", ZIndex = 3 })
	e.Bar = bar
	e.Fill = fill
	e.Gui = gui
end

local function updateSpirit(e: Entry, spirit: number)
	local old = e.Spirit
	e.Spirit = spirit
	local frac = if e.Max > 0 then math.clamp(spirit / e.Max, 0, 1) else 0
	TweenService:Create(e.Fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(frac, 1) }):Play()
	spiritText(e)
	if spirit < old then
		e.HitT = os.clock()
	end
end

local function readSegment(e: Entry)
	local m = e.Model
	local from = m:GetAttribute("From")
	local to = m:GetAttribute("To")
	e.From = if typeof(from) == "Vector3" then from else e.Pos
	e.To = if typeof(to) == "Vector3" then to else e.From
	e.T0 = (m:GetAttribute("T0") :: number?) or 0
	e.Dur = (m:GetAttribute("Dur") :: number?) or 0
end

-- Selected ghost: active label + soft ground ring (set by Targeting).
function Ghosts.SetSelected(uid: number)
	if uid == selectedUid then
		return
	end
	local old = entries[selectedUid]
	if old then
		old.Selected = false
		styleLabel(old)
	end
	selectedUid = uid
	local e = entries[uid]
	if e then
		e.Selected = true
		styleLabel(e)
		local d = math.max(4, 2.8 * e.Def.Scale + 1.5)
		ring.Size = Vector3.new(d, 0.1, d)
		ringStroke.Color = e.Def.Glow
	else
		ring.CFrame = CFrame.new(0, -500, 0)
	end
end

local function add(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local uid = model:GetAttribute("Uid")
	local ghostId = model:GetAttribute("GhostId")
	if type(uid) ~= "number" or type(ghostId) ~= "string" or entries[uid] then
		return
	end
	local def = Config.Ghosts[ghostId]
	local core = model.PrimaryPart or model:WaitForChild("Core", 5)
	if not def or not core or not core:IsA("BasePart") or model:GetAttribute("Dead") then
		return
	end
	local vis = GhostRig.Build(ghostId)
	vis.Name = "Visual"
	local visCore = vis.PrimaryPart :: BasePart
	visCore.CanQuery = false -- the server hitbox is the tap target
	vis:PivotTo(core.CFrame)
	vis.Parent = model
	local e: Entry = {
		Uid = uid,
		Model = model,
		Core = core,
		Vis = vis,
		VisCore = visCore,
		Def = def,
		From = core.Position,
		To = core.Position,
		T0 = 0,
		Dur = 0,
		Phase = math.random() * math.pi * 2,
		Max = (model:GetAttribute("MaxSpirit") :: number?) or def.Spirit,
		Spirit = (model:GetAttribute("Spirit") :: number?) or def.Spirit,
		Gui = nil :: any,
		NameLabel = nil :: any,
		Bar = nil :: any,
		Fill = nil :: any,
		SpiritText = nil :: any,
		HitT = 0,
		Yaw = math.random() * math.pi * 2,
		Dying = false,
		Pos = core.Position,
		Base = core.Position,
		Selected = false,
		Culled = false,
	}
	readSegment(e)
	buildLabel(e)
	updateSpirit(e, e.Spirit)
	entries[uid] = e
	if uid == selectedUid then
		selectedUid = 0
		Ghosts.SetSelected(uid)
	end
	model:GetAttributeChangedSignal("T0"):Connect(function()
		-- From/To/T0/Dur are set together; read them once they have all arrived
		task.defer(readSegment, e)
	end)
	model:GetAttributeChangedSignal("Spirit"):Connect(function()
		updateSpirit(e, (model:GetAttribute("Spirit") :: number?) or 0)
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) and entries[uid] == e then
			entries[uid] = nil
		end
	end)
	-- spawn-in: grow from nothing (the event boss gets its own dramatic entrance)
	if def.Kind ~= "Event" then
		local s = Instance.new("NumberValue")
		s.Value = 0.2
		vis:ScaleTo(def.Scale * 0.2)
		local conn
		conn = s.Changed:Connect(function(v)
			-- (vis.Parent is nil while culled: keep growing so it isn't stuck small on return)
			if e.Dying or not model.Parent then
				conn:Disconnect()
				return
			end
			vis:ScaleTo(def.Scale * v)
		end)
		local tw = TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Value = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			conn:Disconnect()
			s:Destroy()
		end)
	end
	addedSignal:Fire(e)
end

local function poof(data: any)
	local e = entries[data.Uid]
	local pos: Vector3 = data.Pos
	local color: Color3 = data.Color
	local scale: number = data.Scale or 1
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = root == nil or (root.Position - pos).Magnitude < 160
	if e then
		e.Dying = true
		pos = e.Pos
		entries[data.Uid] = nil
		if selectedUid == data.Uid then
			selectedUid = 0
			ring.CFrame = CFrame.new(0, -500, 0)
		end
		diedSignal:Fire(data.Uid, pos)
		e.Gui.Enabled = false
		-- squash-and-stretch pop: inflate, then vanish
		local vis = e.Vis
		local v = Instance.new("NumberValue")
		v.Value = 1
		v.Changed:Connect(function(x)
			if vis.Parent then
				vis:ScaleTo(math.max(0.05, e.Def.Scale * x))
			end
		end)
		local up = TweenService:Create(v, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1.35 })
		up:Play()
		up.Completed:Connect(function()
			if near then
				Effects.Poof(pos, color, scale, data.Big == true)
			end
			for _, p in vis:GetDescendants() do
				if p:IsA("BasePart") then
					p.Transparency = 1
				elseif p:IsA("ParticleEmitter") then
					p.Enabled = false
				elseif p:IsA("Light") then
					p.Enabled = false
				end
			end
			v:Destroy()
		end)
	elseif near then
		Effects.Poof(pos, color, scale, data.Big == true)
	end
	if near then
		Sound.Play(if data.Big then "BigPoof" else "Poof", 0.08)
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}
-- Ghost visuals further than this from the camera are parked (unparented): with 8 zones most
-- ghosts are far away, and mobile shouldn't draw or animate them. Hysteresis avoids flicker.
local CULL_OUT = 330
local CULL_IN = 300

local function step()
	local t = workspace:GetServerTimeNow()
	local clock = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(parts)
	table.clear(cframes)
	for _, e in entries do
		if e.Dying then
			continue
		end
		local a = if e.Dur > 0 then math.clamp((t - e.T0) / e.Dur, 0, 1) else 1
		local base = e.From:Lerp(e.To, smooth(a))
		local camDist = (base - camPos).Magnitude
		if e.Culled then
			if camDist > CULL_IN and not e.Selected then
				-- keep the position fresh for readers (Targeting fallback, Crew, Boss)
				e.Pos = base
				e.Base = base
				continue
			end
			e.Culled = false
			e.Vis.Parent = e.Model
			e.Gui.Enabled = true
		elseif camDist > CULL_OUT and not e.Selected then
			e.Culled = true
			e.Vis.Parent = nil
			e.Gui.Enabled = false
			e.Pos = base
			e.Base = base
			continue
		end
		WorldLabel.SetDistance(e.Gui, camDist)
		local s = e.Def.Scale
		local bob = math.sin(clock * 2.2 + e.Phase) * 0.45 * math.sqrt(s)
		local pos = base + Vector3.new(0, bob, 0)
		-- hit shake
		local since = clock - e.HitT
		if since < 0.15 then
			local k = (0.15 - since) / 0.15
			pos += Vector3.new(math.sin(clock * 90) * 0.25 * k * s, 0, math.cos(clock * 80) * 0.2 * k * s)
		end
		-- face the camera horizontally (cute + readable), with a gentle sway
		local dx, dz = camPos.X - pos.X, camPos.Z - pos.Z
		if dx * dx + dz * dz > 1 then
			local target = math.atan2(-dx, -dz)
			local diff = (target - e.Yaw + math.pi) % (2 * math.pi) - math.pi
			e.Yaw += diff * 0.08
		end
		local sway = math.sin(clock * 1.7 + e.Phase) * 0.12
		local moving = a < 1 and (e.To - e.From).Magnitude > 0.5
		local lean = if moving then 0.12 else 0
		e.Pos = pos
		e.Base = base
		local cf = CFrame.new(pos) * CFrame.Angles(0, e.Yaw, 0) * CFrame.Angles(-lean, 0, sway)
		table.insert(parts, e.Core)
		table.insert(cframes, CFrame.new(pos))
		table.insert(parts, e.VisCore)
		table.insert(cframes, cf)
	end
	-- ground ring under the selected ghost
	local sel = entries[selectedUid]
	if sel and not sel.Dying then
		local groundY = sel.Base.Y - sel.Def.Hover + 0.15
		table.insert(parts, ring)
		table.insert(cframes, CFrame.new(sel.Base.X, groundY, sel.Base.Z) * CFrame.Angles(0, clock * 0.8, 0))
		ringStroke.Transparency = 0.25 + 0.2 * math.sin(clock * 4)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ghosts.Init()
	ring = Instance.new("Part")
	ring.Name = "TargetRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(6, 0.1, 6)
	ring.CFrame = CFrame.new(0, -500, 0)
	ring.Parent = workspace
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 24,
		LightInfluence = 0,
		Brightness = 1.5,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = sg })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 7, Color = Theme.Ecto, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
	-- dashed look: a second, inner faint circle
	local inner: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = circle })
	Kit.Corner(inner, UDim.new(1, 0))
	Kit.new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1), Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inner })
end

function Ghosts.Start()
	local folder = workspace:WaitForChild("Ghosts")
	folder.ChildAdded:Connect(function(m)
		task.defer(add, m)
	end)
	for _, m in folder:GetChildren() do
		task.spawn(add, m)
	end
	State.OnFx("Poof", poof)
	RunService.RenderStepped:Connect(step)
end

return Ghosts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD, kept compact so the screen stays free for seeing and tapping ghosts:
-- Ectoplasm counter, crew power, active boosts, menu buttons (one column on big screens,
-- a 2-column block in the top-left on phones, clear of the thumbstick), settings, the
-- AUTO ATTACK toggle (pass owners only), toasts, announcements and zone banners.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local Hud = {}

local player = Players.LocalPlayer
local openers: { [string]: () -> () } = {}
Hud.Buttons = {} :: { [string]: TextButton }

local ectoLabel: TextLabel
local ectoPill: Frame
local powerLabel: TextLabel
local powerPrefix = "⚡ "
local boostHolder: Frame
local dailyBadge: Frame
local autoButton: TextButton
local shownEcto = 0
local targetEcto = 0
local bannerLabel: TextLabel
local bannerSub: TextLabel
local announceFrame: Frame
local announceToken = 0

function Hud.RegisterPanel(name: string, open: () -> ())
	openers[name] = open
end

function Hud.Open(name: string)
	local fn = openers[name]
	if fn then
		fn()
	end
end

-- Pulsing ring on a menu button (tutorial).
local pulses: { [string]: Frame } = {}
function Hud.Pulse(name: string, on: boolean)
	local b = Hud.Buttons[name]
	if not b then
		return
	end
	if on and not pulses[name] then
		local ring: Frame = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = b,
		})
		Kit.Corner(ring, UDim.new(0, 14))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		pulses[name] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.fromScale(1.35, 1.35) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and pulses[name] then
		pulses[name]:Destroy()
		pulses[name] = nil
	end
end

local function floatText(text: string, color: Color3)
	local l = Kit.Label(Kit.Overlay(), text, {
		Size = UDim2.fromOffset(160, 24),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = color,
		Style = "Heading",
		ZIndex = 80,
	})
	Kit.Tween(l, 0.8, { Position = UDim2.new(0.5, 0, 0, 40), TextTransparency = 1 })
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		Kit.Tween(st, 0.8, { Transparency = 1 })
	end
	task.delay(0.85, function()
		l:Destroy()
	end)
end

local function buildTop(screen: ScreenGui)
	-- Ectoplasm + power: two same-size pills side by side, centred in the top bar row
	local top = Kit.TopBar()
	local row: Frame = Kit.new("Frame", {
		Name = "Counters",
		Size = UDim2.fromOffset(190 * 2 + 14, 40),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = top,
	})
	ectoPill = Kit.new("Frame", {
		Name = "Ecto",
		Size = UDim2.fromOffset(190, 40),
		Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	Kit.Corner(ectoPill, UDim.new(1, 0))
	Kit.Stroke(ectoPill, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ectoPill, Theme.Panel2, Theme.Bg, 90)
	Kit.new("UIScale", { Parent = ectoPill })
	local orb: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, -12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = ectoPill,
	})
	Kit.Corner(orb, UDim.new(1, 0))
	Kit.Stroke(orb, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(orb, Theme.Ecto, Theme.Ecto2, 135)
	local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.3, 0.24), Position = UDim2.fromScale(0.26, 0.2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3, ZIndex = 4, Parent = orb })
	Kit.Corner(shine, UDim.new(1, 0))
	if Icons.Get("ecto") then
		-- uploaded Ectoplasm icon replaces the drawn orb
		orb.BackgroundTransparency = 1
		shine.Visible = false
		local st = orb:FindFirstChildOfClass("UIStroke")
		if st then
			st.Enabled = false
		end
		local g = orb:FindFirstChildOfClass("UIGradient")
		if g then
			g.Enabled = false
		end
		Kit.Icon(orb, "ecto", "💚", { Size = UDim2.fromScale(1.15, 1.15), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 })
	end
	ectoLabel = Kit.Label(ectoPill, "0", { Size = UDim2.new(1, -46, 1, 0), Position = UDim2.fromOffset(40, 0), Color = Theme.Ecto, Style = "Currency", Fit = true })
	-- crew power
	local power: Frame = Kit.new("Frame", {
		Name = "Power",
		Size = UDim2.fromOffset(190, 40),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	Kit.Corner(power, UDim.new(1, 0))
	Kit.Stroke(power, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(power, Theme.Panel2, Theme.Bg, 90)
	Kit.Icon(power, "power", "⚡", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, -12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Style = "Icon", TextSize = 30, Stroke = 0, ZIndex = 4 })
	powerPrefix = ""
	powerLabel = Kit.Label(power, "0 POWER", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(42, 0), Color = Theme.Gold, Style = "Heading", Fit = true })
	-- boosts (only while active)
	-- directly under the counters: next-area progress bar (Tutorial), boss event bar (Boss) and
	-- active boosts, stacked so they never overlap and never sit in the middle of the play area
	local stack: Frame = Kit.new("Frame", {
		Name = "TopStack",
		Size = UDim2.fromOffset(440, 220),
		Position = UDim2.new(0.5, 0, 0, 52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = top,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 5), FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = stack })
	Hud.TopStack = stack
	local _ = screen
	boostHolder = Kit.new("Frame", {
		Size = UDim2.fromOffset(340, 22),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Visible = false,
		Parent = stack,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), Parent = boostHolder })
end

-- HUD layout
--   LEFT  (vertical): HUNTERS, WORLDS, INDEX
--   RIGHT (vertical, bottom-anchored stack): UPGRADES, SHOP, DAILY, then the free AUTO ATTACK
--   toggle, then the lower-right row: [DEV] FEEDBACK SETTINGS. On touch screens the stack sits
--   above the Roblox jump button; on desktop the left column starts under the chat window.
local MENU_LEFT = {
	{ Name = "Hunters", Icon = "🔦", Text = "HUNTERS", Color = "Orange" },
	{ Name = "Worlds", Icon = "🌍", Text = "WORLDS", Color = "Teal" },
	{ Name = "Index", Icon = "📖", Text = "INDEX", Color = "Blue" },
}
local MENU_RIGHT = {
	{ Name = "Upgrades", Icon = "🧲", Text = "UPGRADES", Color = "Green" },
	{ Name = "Shop", Icon = "🛒", Text = "SHOP", Color = "Pink" },
	{ Name = "Daily", Icon = "🎁", Text = "DAILY", Color = "Purple" },
}
local CELL_MAX = 84
local GAP = 6
local SMALL = 44 -- settings / feedback / dev buttons
local AUTO_W, AUTO_H = 132, 40

local menu: Frame -- left column
local menuScale: UIScale
Hud.TopStack = nil :: Frame?
local rightStack: Frame
local rightScale: UIScale
local lowerRow: Frame
Hud.LowerRow = nil :: Frame? -- other controllers (DEV button) add small buttons here
Hud.RightStack = nil :: Frame?
local chatBottomCache = 0

local function touchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Desktop only: bottom of the Roblox chat window (logical px below our inset), read once after
-- joining and on resizes, so the left column starts under it. Phones keep chat collapsed
-- behind its top-bar button (following it live made the menu jump around).
local function readChatBottom()
	chatBottomCache = 0
	if touchOnly() then
		return
	end
	pcall(function()
		local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if cfg and cfg.Enabled then
			local pos = (cfg :: any).AbsolutePosition :: Vector2
			local size = (cfg :: any).AbsoluteSize :: Vector2
			local inset = Kit.Screen().AbsolutePosition.Y
			chatBottomCache = math.max(0, (pos.Y + size.Y - inset) / Kit.UIScale())
		end
	end)
end

-- Room to keep free above the bottom edge on the right (the touch jump button), logical px.
local function bottomReserve(): number
	if not touchOnly() then
		return 10
	end
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local small = math.min(vp.X, vp.Y) < 500 -- Roblox uses the small jump button below 500 px
	local physical = if small then 100 else 225
	return physical / Kit.UIScale()
end

local function columnHeight(n: number): number
	return CELL_MAX * n + GAP * (n - 1)
end

local function layoutMenu()
	local logical = Kit.LogicalSize()
	-- right stack (anchored bottom-right, above the jump button on touch screens)
	local reserve = bottomReserve()
	local rightH = columnHeight(#MENU_RIGHT) + GAP * 2 + AUTO_H + GAP * 2 + SMALL
	local rightW = math.max(CELL_MAX, AUTO_W, SMALL * 3 + GAP * 2)
	local rfit = math.clamp((logical.Y - reserve - 8) / rightH, 0.5, 1)
	rightScale.Scale = rfit
	rightStack.Size = UDim2.fromOffset(rightW, rightH)
	rightStack.Position = UDim2.new(1, -8, 1, -reserve)
	rightStack.AnchorPoint = Vector2.new(1, 1)
	-- left column: same button size as the right, top lined up with the right column's top
	-- (desktop: never above the bottom of the chat window)
	local rightTop = logical.Y - reserve - rightH * rfit
	local top = math.max(4, rightTop, if chatBottomCache > 0 then chatBottomCache + 8 else 0)
	local full = columnHeight(#MENU_LEFT)
	menuScale.Scale = math.min(rfit, math.clamp((logical.Y - top - 10) / full, 0.5, 1))
	menu.Size = UDim2.fromOffset(CELL_MAX, full)
	menu.Position = UDim2.fromOffset(8, top)
	menu.AnchorPoint = Vector2.zero
end

local function menuButton(parent: Instance, i: number, m: any): TextButton
	local b = Kit.Button(parent, {
		Text = "",
		Color = m.Color,
		OnClick = function()
			Hud.Open(m.Name)
		end,
	})
	b.LayoutOrder = i
	b.Size = UDim2.fromOffset(CELL_MAX, CELL_MAX)
	Kit.Icon(b, "menu_" .. string.lower(m.Name), m.Icon, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 7), Style = "Icon", TextSize = 36, Stroke = 0, ZIndex = 3 })
	Kit.Label(b, m.Text, { Size = UDim2.new(1, -4, 0, 19), Position = UDim2.new(0, 2, 1, -25), Style = "Tiny", TextSize = 14, Fit = true, ZIndex = 3 })
	Hud.Buttons[m.Name] = b
	return b
end

local function buildMenu(screen: ScreenGui)
	-- LEFT column
	menu = Kit.new("Frame", { Name = "Menu", BackgroundTransparency = 1, Parent = screen })
	menuScale = Kit.new("UIScale", { Parent = menu })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	for i, m in MENU_LEFT do
		menuButton(menu, i, m)
	end
	-- RIGHT stack
	rightStack = Kit.new("Frame", { Name = "RightMenu", BackgroundTransparency = 1, Parent = screen })
	rightScale = Kit.new("UIScale", { Parent = rightStack })
	Kit.new("UIListLayout", {
		Padding = UDim.new(0, GAP * 2),
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = rightStack,
	})
	local col: Frame = Kit.new("Frame", { Name = "Column", BackgroundTransparency = 1, Size = UDim2.fromOffset(CELL_MAX, columnHeight(#MENU_RIGHT)), LayoutOrder = 1, Parent = rightStack })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
	for i, m in MENU_RIGHT do
		menuButton(col, i, m)
	end
	lowerRow = Kit.new("Frame", { Name = "LowerRow", BackgroundTransparency = 1, Size = UDim2.fromOffset(SMALL * 3 + GAP * 2, SMALL), LayoutOrder = 3, Parent = rightStack })
	Kit.new("UIListLayout", { Padding = UDim.new(0, GAP), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder, Parent = lowerRow })
	Hud.LowerRow = lowerRow
	Hud.RightStack = rightStack
	-- red "!" on DAILY when a reward is waiting
	dailyBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, 5, 0, -5),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Bad,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Daily,
	})
	Kit.Corner(dailyBadge, UDim.new(1, 0))
	Kit.Stroke(dailyBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(dailyBadge, "!", { Style = "Small", ZIndex = 11 })
	layoutMenu()
	-- desktop: start under the chat window (read after it has appeared; again on resizes)
	task.delay(3, function()
		readChatBottom()
		layoutMenu()
	end)
	Kit.ScaleChanged:Connect(function()
		readChatBottom()
		layoutMenu()
	end)
end

-- Settings panel (gear, top right)
local function buildSettings(screen: ScreenGui)
	local panel = Kit.Panel("Settings", "SETTINGS", Vector2.new(400, 350), "Gray")
	local list: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel.Body, ZIndex = 61 })
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = list })
	local toggles = {
		{ Key = "Music", Text = "MUSIC" },
		{ Key = "Sfx", Text = "SOUND EFFECTS" },
		{ Key = "FastReveal", Text = "FAST CRATE OPENING" },
	}
	local buttons: { [string]: TextButton } = {}
	for _, t in toggles do
		local b = Kit.Button(list, {
			Text = t.Text,
			Color = "Green",
			Size = UDim2.fromOffset(320, 44),
			ZIndex = 62,
			OnClick = function()
				local d = State.Data
				if not d then
					return
				end
				local res = State.Request("Setting", t.Key, not d.Settings[t.Key])
				if not res.ok then
					Kit.Toast(res.err or "Couldn't change that", "Bad")
				end
			end,
		})
		buttons[t.Key] = b
	end
	Kit.Button(list, {
		Text = "💬 SEND FEEDBACK / REPORT A BUG",
		Color = "Blue",
		Size = UDim2.fromOffset(320, 44),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			panel:Close()
			Hud.Open("Feedback")
		end,
	})
	State.OnData(function(d)
		for _, t in toggles do
			local on = d.Settings[t.Key] == true
			local b = buttons[t.Key]
			b:SetAttribute("Color", if on then "Green" else "Gray")
			Kit.SetButtonText(b, t.Text .. (if on then ": ON" else ": OFF"))
			if t.Key == "FastReveal" then
				-- fast crate opening is part of the Permanent Crate Skip pass
				b.Visible = d.Passes ~= nil and d.Passes[Config.CrateSkip.Pass] == true
			end
		end
	end)
	Hud.RegisterPanel("Settings", function()
		panel:Toggle()
	end)
	-- lower-right row: FEEDBACK then SETTINGS (the DEV button, for developers, goes first)
	local _ = screen
	local feedback = Kit.Button(lowerRow, {
		Text = "💬",
		Color = "Blue",
		Size = UDim2.fromOffset(SMALL, SMALL),
		TextStyle = "Heading",
		OnClick = function()
			Hud.Open("Feedback")
		end,
	})
	feedback.LayoutOrder = 2
	local gear = Kit.Button(lowerRow, {
		Text = "",
		Color = "Gray",
		Size = UDim2.fromOffset(SMALL, SMALL),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	gear.LayoutOrder = 3
	Kit.Icon(gear, "menu_settings", "⚙", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Heading", Stroke = 0, ZIndex = 3 })
end

-- AUTO ATTACK toggle: FREE for every player (no pass, no Robux).
local busyAuto = false
local function refreshAuto()
	autoButton.Visible = true -- Auto Attack is free for everyone
	local on = player:GetAttribute("AutoAttack") == true
	Kit.SetButtonText(autoButton, if on then "🤖 AUTO: ON" else "🤖 AUTO: OFF")
	autoButton:SetAttribute("Color", if on then "Green" else "Gray")
end

local function buildAuto(screen: ScreenGui)
	autoButton = Kit.Button(rightStack, {
		Text = "🤖 AUTO: OFF",
		Color = "Gray",
		Size = UDim2.fromOffset(AUTO_W, AUTO_H),
		TextStyle = "Small",
		OnClick = function()
			if busyAuto then
				return
			end
			busyAuto = true
			local on = player:GetAttribute("AutoAttack") == true
			local res = State.Request("AutoAttack", not on)
			busyAuto = false
			if not res.ok then
				Kit.Toast(res.err or "Couldn't switch Auto Attack", "Bad")
			else
				Kit.Toast(if res.On then "AUTO ATTACK ON: your crew picks nearby ghosts" else "AUTO ATTACK OFF: tap a ghost to attack", "Good")
			end
		end,
	})
	autoButton.Name = "AutoAttack"
	autoButton.LayoutOrder = 2
	autoButton.Visible = false
	player:GetAttributeChangedSignal("AutoAttack"):Connect(refreshAuto)
	State.OnData(function()
		refreshAuto()
	end)
end

local function buildBanners()
	local overlay = Kit.Overlay()
	bannerLabel = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(640, 48),
		Position = UDim2.fromScale(0.5, 0.27),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Ecto,
		Style = "Banner",
		Fit = true,
		ZIndex = 70,
	})
	bannerLabel.TextTransparency = 1
	bannerSub = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(560, 24),
		Position = UDim2.new(0.5, 0, 0.27, 30),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Theme.Text,
		Style = "Body",
		Fit = true,
		ZIndex = 70,
	})
	bannerSub.TextTransparency = 1
	announceFrame = Kit.new("Frame", {
		Size = UDim2.fromOffset(500, 36),
		Position = UDim2.new(0.5, 0, 0, -60),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		-- on the HUD screen, below panels (ZIndex 60): an announcement must never cover an open
		-- popup's title (it used to sit on the overlay, above every panel)
		ZIndex = 58,
		Parent = Kit.Screen(),
	})
	Kit.Corner(announceFrame, UDim.new(0, 12))
	Kit.Stroke(announceFrame, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(announceFrame, Theme.Gold, Color3.fromRGB(255, 120, 40), 0)
	local l = Kit.Label(announceFrame, "", { Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(10, 0), Style = "Body", Fit = true, ZIndex = 76 })
	l.Name = "Text"
	-- ✕ (or tapping the bar anywhere) dismisses the announcement right away
	local function dismiss()
		announceToken += 1
		local my = announceToken
		Kit.Tween(announceFrame, 0.2, { Position = UDim2.new(0.5, 0, 0, -60) })
		task.delay(0.2, function()
			if announceToken == my then
				announceFrame.Visible = false
			end
		end)
	end
	local tap: TextButton = Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 77, Parent = announceFrame })
	tap.Activated:Connect(dismiss)
	Kit.CloseButton(announceFrame, dismiss, 79)
end

local bannerToken = 0
-- Centre-screen title (zone names, NEW AREA UNLOCKED!). The one place for big text.
function Hud.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	bannerLabel.Text = title
	bannerLabel.TextColor3 = color or Theme.Ecto
	bannerSub.Text = sub or ""
	local s1 = bannerLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
	local s2 = bannerSub:FindFirstChildOfClass("UIStroke") :: UIStroke
	bannerLabel.TextTransparency = 1
	bannerSub.TextTransparency = 1
	s1.Transparency = 1
	s2.Transparency = 1
	local sc = bannerLabel:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = bannerLabel })
	sc.Scale = 0.6
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.Tween(bannerLabel, 0.3, { TextTransparency = 0 })
	Kit.Tween(s1, 0.3, { Transparency = 0 })
	Kit.Tween(bannerSub, 0.3, { TextTransparency = 0 })
	Kit.Tween(s2, 0.3, { Transparency = 0 })
	task.delay(2.4, function()
		if bannerToken ~= my then
			return
		end
		Kit.Tween(bannerLabel, 0.45, { TextTransparency = 1 })
		Kit.Tween(s1, 0.45, { Transparency = 1 })
		Kit.Tween(bannerSub, 0.45, { TextTransparency = 1 })
		Kit.Tween(s2, 0.45, { Transparency = 1 })
	end)
end

-- Sliding top announcement (legendary hatches, boss events).
function Hud.Announce(text: string, c1: Color3?, c2: Color3?)
	announceToken += 1
	local my = announceToken
	local l = announceFrame:FindFirstChild("Text") :: TextLabel
	l.Text = text
	local g = announceFrame:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(c1 or Theme.Gold, c2 or Color3.fromRGB(255, 120, 40))
	-- below the boss bar / goal chip so event warnings never stack on top of each other
	announceFrame.Visible = true
	Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, 100) }, Enum.EasingStyle.Back)
	task.delay(4, function()
		if announceToken == my then
			Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, -60) })
			task.wait(0.3)
			if announceToken == my then
				announceFrame.Visible = false -- parked off-screen must not peek under the top bar
			end
		end
	end)
end

local boostLabels: { [string]: TextLabel } = {}
local function refreshBoosts()
	local d = State.Data
	if not d then
		return
	end
	local now = State.Now()
	local chips: { [string]: any } = {}
	for id, def in Config.Boosts :: any do
		if type(def) == "table" then
			chips[id] = { Icon = def.Icon, Name = def.Name, Expiry = d.Boosts[id] }
		end
	end
	-- server-wide luck someone bought (Robux): everyone sees it
	chips.ServerLuck = { Icon = "🍀", Name = "SERVER LUCK", Expiry = d.ServerLuckUntil }
	-- global 2X Ectoplasm event (developer-controlled; a countdown when it was started for a set time)
	local ends = workspace:GetAttribute("Ecto2xEnds")
	local timed = type(ends) == "number" and ends > 0
	chips.Ecto2x = {
		Icon = "💚",
		Name = "2X ECTOPLASM",
		Expiry = if workspace:GetAttribute("Ecto2x") ~= true then 0 elseif timed then ends else now + 1e9,
		NoTimer = not timed,
	}
	for id, def in chips do
		local expiry = def.Expiry
		local left = if expiry then expiry - now else 0
		local l = boostLabels[id]
		if left > 0 then
			if not l then
				local f: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Theme.Panel2, BackgroundTransparency = 0.1, Parent = boostHolder })
				Kit.Corner(f, UDim.new(1, 0))
				l = Kit.Label(f, "", { Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0), Color = Theme.Ecto, Style = "Tiny", Fit = true })
				boostLabels[id] = l
			end
			Kit.EctoText(l :: TextLabel, def.Icon .. " " .. def.Name .. (if def.NoTimer then "" else " " .. Format.Time(left)))
		elseif l then
			(l.Parent :: Instance):Destroy()
			boostLabels[id] = nil
		end
	end
	boostHolder.Visible = next(boostLabels) ~= nil
	local info = d.DailyInfo
	if info then
		local canClaim = info.CanClaim or info.Wait - (now - (d.ServerTime or now)) <= 0
		dailyBadge.Visible = canClaim
	end
end

local seeded = false
local function onData(d: any)
	powerLabel.Text = powerPrefix .. Format.Short(d.CrewPower or 0) .. " POWER"
	targetEcto = d.Ecto
	if not seeded then
		-- first snapshot: show the balance as-is (no count-up from 0 on every join)
		seeded = true
		shownEcto = d.Ecto
		ectoLabel.Text = Format.Short(d.Ecto)
	end
	refreshBoosts()
end

local lastZone = 0
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

function Hud.Init()
	local screen = Kit.Screen()
	Kit.SetSound(function(name)
		Sound.Play(name)
	end)
	buildTop(screen)
	buildMenu(screen)
	buildSettings(screen)
	buildAuto(screen)
	buildBanners()
	-- TopStack lives in the top-bar ScreenGui (drawn above the HUD screen), so hide it while a
	-- panel is open (it would cover the panel's title) or the HUD is hidden (crate reveal)
	local stack = Hud.TopStack
	if stack then
		local function syncStack()
			stack.Visible = screen.Enabled and Kit.CurrentPanel() == nil
		end
		screen:GetPropertyChangedSignal("Enabled"):Connect(syncStack)
		Kit.PanelOpened:Connect(function()
			task.defer(syncStack)
		end)
	end
end

-- [VIP] chat tag for VIP pass owners (the server sets the player's "VIP" attribute)
local function hookVipChat()
	pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage)
			local props = Instance.new("TextChatMessageProperties")
			local src = message.TextSource
			local who = src and Players:GetPlayerByUserId(src.UserId)
			if who and who:GetAttribute("VIP") == true then
				props.PrefixText = '<font color="#FFD24A">[VIP]</font> ' .. message.PrefixText
			end
			return props
		end
	end)
end

function Hud.Start()
	hookVipChat()
	State.OnData(onData)
	State.EctoChanged:Connect(function(new: number, old: number)
		targetEcto = new
		if new > old then
			floatText("+" .. Format.Short(new - old), Theme.Ecto)
			local sc = ectoPill:FindFirstChildOfClass("UIScale") :: UIScale
			sc.Scale = 1.1
			Kit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
	-- smooth count-up
	RunService.RenderStepped:Connect(function(dt: number)
		if shownEcto ~= targetEcto then
			local diff = targetEcto - shownEcto
			local step = diff * math.min(1, dt * 10)
			if math.abs(diff) < 1 or math.abs(step) < 1 then
				shownEcto = targetEcto
			else
				shownEcto += step
			end
			ectoLabel.Text = Format.Short(math.floor(shownEcto + 0.5))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshBoosts()
			-- zone banner when walking into a different zone
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
				if idx ~= lastZone then
					if lastZone ~= 0 then
						local z = Config.Zones[idx]
						Hud.Banner(z.Name, nil, z.Accent)
					end
					lastZone = idx
				end
			end
		end
	end)
	State.OnFx("Toast", function(data: any)
		Kit.Toast(data.Text, data.Color)
	end)
	State.OnFx("Announce", function(data: any)
		local r = Config.Rarities[data.Color]
		Hud.Announce(data.Text, r and r.Color, r and r.Color2)
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">HuntersPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTERS inventory: grid of cards (portrait, name, rarity, Capture Power, equipped/locked
-- badges), an inspect pane with a 3D preview, EQUIP / UNEQUIP / EQUIP BEST / LOCK / RELEASE,
-- sort by power or rarity, and a release mode with "select weak" for clearing storage.
-- Cards are cached per hunter uid, so data updates only touch what changed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)

local HuntersPanel = {}

type Card = {
	Frame: TextButton,
	Equip: Frame,
	Lock: TextLabel,
	Select: Frame,
}

local panel: Kit.Panel
local grid: ScrollingFrame
local cards: { [string]: Card } = {}
local equippedLabel: TextLabel
local powerLabel: TextLabel
local storageLabel: TextLabel
local sortButton: TextButton
local releaseButton: TextButton
local equipBestButton: TextButton
local top: Frame
local actionsRow: Frame
local side: Frame
-- inspect pane
local inspect: ScrollingFrame
local viewHolder: Frame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local rarityRibbon: Frame
local statLabel: TextLabel
local blurbLabel: TextLabel
local equipButton: TextButton
local lockButton: TextButton
local relOneButton: TextButton
local emptyHint: TextLabel
-- release mode
local releaseBar: Frame
local releaseConfirm: TextButton
local releaseMode = false
local selected: { [string]: boolean } = {}
local inspectUid: string? = nil
local sortMode = "Power"
local spinModel: Model? = nil
local spinConn: RBXScriptConnection? = nil

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOf(id: string): Config.RarityDef
	return Config.Rarities[Config.Hunters[id].Rarity]
end

local function crateRefund(id: string): number
	local def = Config.Hunters[id]
	local zone = Config.ZoneById[def.Zone]
	local crate = zone and Config.Crates[zone.Crate]
	return if crate then math.floor(crate.Price * Config.Inventory.ReleaseRefund) else 0
end

local function sortedUids(d: any): { string }
	local uids = {}
	for uid in d.Hunters do
		table.insert(uids, uid)
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	table.sort(uids, function(a, b)
		if eq[a] ~= eq[b] then
			return eq[a] == true
		end
		local ha, hb = d.Hunters[a].Id, d.Hunters[b].Id
		local pa, pb = powerOf(ha), powerOf(hb)
		local ra, rb = rarityOf(ha).Order, rarityOf(hb).Order
		if sortMode == "Rarity" and ra ~= rb then
			return ra > rb
		end
		if pa ~= pb then
			return pa > pb
		end
		if ra ~= rb then
			return ra > rb
		end
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	return uids
end

local previewUid: string? = nil

local function clearPreview()
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in viewHolder:GetChildren() do
		if c:IsA("ViewportFrame") then
			c:Destroy()
		end
	end
	spinModel = nil
	previewUid = nil
end

local function setInspect(uid: string?)
	inspectUid = uid
	local d = State.Data
	local h = uid and d and d.Hunters[uid]
	inspect.Visible = h ~= nil and not releaseMode
	emptyHint.Visible = not inspect.Visible and not releaseMode
	if not h or not d or not uid then
		clearPreview()
		return
	end
	local def = Config.Hunters[h.Id]
	local rar = rarityOf(h.Id)
	-- the 3D preview is only rebuilt when you pick a different hunter (not on every update)
	if previewUid ~= uid then
		clearPreview()
		previewUid = uid
		local _, model = Portrait.Viewport(viewHolder, h.Id, false)
		spinModel = model
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				if spinModel then
					spinModel:PivotTo(CFrame.Angles(0, math.sin((os.clock() - t0) * 0.8) * 0.6, 0))
				end
			end)
		end
	end
	nameLabel.Text = string.upper(def.Name)
	rarityLabel.Text = rar.Name
	local g = rarityRibbon:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(rar.Color, rar.Color2)
	statLabel.Text = "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER"
	blurbLabel.Text = def.Blurb
	local isEq = table.find(d.Equipped, uid) ~= nil
	Kit.SetButtonText(equipButton, if isEq then "UNEQUIP" else "EQUIP")
	equipButton:SetAttribute("Color", if isEq then "Red" else "Green")
	Kit.SetButtonText(lockButton, if h.Locked then "🔓 UNLOCK" else "🔒 LOCK")
	relOneButton.Visible = not isEq and not h.Locked
	Kit.SetButtonText(relOneButton, "RELEASE +" .. Format.Short(crateRefund(h.Id)))
end

local function updateReleaseBar()
	local d = State.Data
	local n, refund = 0, 0
	if d then
		for uid in selected do
			local h = d.Hunters[uid]
			if h then
				n += 1
				refund += crateRefund(h.Id)
			else
				selected[uid] = nil
			end
		end
	end
	Kit.SetButtonText(releaseConfirm, "RELEASE " .. n .. "  (+💚" .. Format.Short(refund) .. ")")
	releaseConfirm:SetAttribute("Color", if n > 0 then "Red" else "Gray")
end

local function makeCard(uid: string, hunterId: string): Card
	local def = Config.Hunters[hunterId]
	local rar = rarityOf(hunterId)
	local f: TextButton = Kit.new("TextButton", {
		Name = uid,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 63,
		Parent = grid,
	})
	Kit.Corner(f, UDim.new(0, 16))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, rar.Color, rar.Color2, 90)
	if rar.Order >= 5 then
		-- legendary cards shimmer
		local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, ZIndex = 63, Parent = f })
		Kit.Corner(shine, UDim.new(0, 16))
		local sg = Kit.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 25,
			Parent = shine,
		})
		task.spawn(function()
			while shine.Parent do
				sg.Offset = Vector2.new(-1, 0)
				Kit.Tween(sg, 1.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear)
				task.wait(2.4)
			end
		end)
	end
	local pic: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 18, 55),
		BackgroundTransparency = 0.35,
		ZIndex = 64,
		Parent = f,
	})
	Kit.Corner(pic, UDim.new(1, 0))
	Portrait.Face(pic, hunterId, false)
	Kit.Label(f, string.upper(def.Name), { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
	Kit.Label(f, "⚡" .. Format.Short(def.Power), { Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 98), ZIndex = 66, Color = Theme.Gold, Style = "Body", Fit = true })
	local eqBadge: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.fromOffset(-5, -5),
		BackgroundColor3 = Theme.Good,
		Visible = false,
		ZIndex = 68,
		Parent = f,
	})
	Kit.Corner(eqBadge, UDim.new(1, 0))
	Kit.Stroke(eqBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(eqBadge, "✅", { Style = "Body", ZIndex = 69 })
	local lock = Kit.Label(f, "🔒", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, 2, 0, -3), AnchorPoint = Vector2.new(1, 0), ZIndex = 68, Stroke = 0, Style = "Small" })
	lock.Visible = false
	local sel: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bad, BackgroundTransparency = 0.45, Visible = false, ZIndex = 70, Parent = f })
	Kit.Corner(sel, UDim.new(0, 12))
	Kit.Label(sel, "X", { Style = "Title", ZIndex = 71 })
	f.Activated:Connect(function()
		Kit.Play("Click")
		if releaseMode then
			local d = State.Data
			local h = d and d.Hunters[uid]
			if not h or h.Locked or table.find(d.Equipped, uid) then
				Kit.Toast("Equipped or locked hunters can't be released", "Bad")
				return
			end
			if selected[uid] then
				selected[uid] = nil
			else
				selected[uid] = true
			end
			sel.Visible = selected[uid] == true
			updateReleaseBar()
		else
			setInspect(uid)
		end
	end)
	return { Frame = f, Equip = eqBadge, Lock = lock, Select = sel }
end

local BATCH = 24 -- new cards per frame: a 150-hunter inventory opens without a hitch
local rebuildQueued = false

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local created = 0
	-- remove cards for hunters that are gone
	for uid, c in cards do
		if not d.Hunters[uid] then
			c.Frame:Destroy()
			cards[uid] = nil
			selected[uid] = nil
		end
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	for i, uid in sortedUids(d) do
		local h = d.Hunters[uid]
		local c = cards[uid]
		if not c then
			if created >= BATCH then
				-- finish the rest next frame
				if not rebuildQueued then
					rebuildQueued = true
					task.spawn(function()
						task.wait() -- next frame
						rebuildQueued = false
						if panel.IsOpen then
							rebuild()
						end
					end)
				end
				continue
			end
			created += 1
			c = makeCard(uid, h.Id)
			cards[uid] = c
		end
		c.Frame.LayoutOrder = i
		c.Equip.Visible = eq[uid] == true
		c.Lock.Visible = h.Locked == true
		c.Select.Visible = releaseMode and selected[uid] == true
	end
	local count = State.CountOwned()
	local slots = d.Slots or Config.Inventory.BaseSlots
	equippedLabel.Text = "EQUIPPED " .. #d.Equipped .. "/" .. slots
	powerLabel.Text = "⚡ " .. Format.Short(d.CrewPower or 0)
	local maxHunters = (State.Data and State.Data.MaxHunters) or Config.Inventory.MaxHunters
	storageLabel.Text = "STORAGE " .. count .. "/" .. maxHunters
	storageLabel.TextColor3 = if count >= maxHunters - 5 then Theme.Bad else Theme.Muted
	if inspectUid and not d.Hunters[inspectUid] then
		inspectUid = nil
	end
	setInspect(inspectUid)
	if releaseMode then
		updateReleaseBar()
	end
end

local function setReleaseMode(on: boolean)
	releaseMode = on
	table.clear(selected)
	releaseBar.Visible = on
	Kit.SetButtonText(releaseButton, if on then "DONE" else "RELEASE")
	releaseButton:SetAttribute("Color", if on then "Gray" else "Red")
	rebuild()
end

local function act(action: string, ...: any)
	local res = State.Request(action, ...)
	if not res.ok then
		Kit.Toast(res.err or "Couldn't do that", "Bad")
	end
	return res
end

function HuntersPanel.Init()
	panel = Kit.Panel("Hunters", "GHOST HUNTERS", Vector2.new(860, 500), "Orange")
	local body = panel.Body
	-- top bar: counts on the left, actions on the right (actions drop to a 2nd row when narrow)
	top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 10), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	equippedLabel = Kit.Label(top, "EQUIPPED 0/4", { Size = UDim2.fromOffset(150, 22), Position = UDim2.fromOffset(0, 0), Align = Enum.TextXAlignment.Left, Style = "Heading", Fit = true, ZIndex = 62 })
	powerLabel = Kit.Label(top, "⚡ 0", { Size = UDim2.fromOffset(120, 22), Position = UDim2.fromOffset(152, 0), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, Style = "Heading", Fit = true, ZIndex = 62 })
	storageLabel = Kit.Label(top, "STORAGE 0/150", { Size = UDim2.fromOffset(200, 16), Position = UDim2.fromOffset(0, 25), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	actionsRow = Kit.new("Frame", { Size = UDim2.new(0, 400, 0, 40), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 61, Parent = top })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = actionsRow })
	local buttons = actionsRow
	sortButton = Kit.Button(buttons, {
		Text = "SORT: POWER",
		Color = "Blue",
		Size = UDim2.fromOffset(124, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			sortMode = if sortMode == "Power" then "Rarity" else "Power"
			Kit.SetButtonText(sortButton, "SORT: " .. string.upper(sortMode))
			rebuild()
		end,
	})
	releaseButton = Kit.Button(buttons, {
		Text = "RELEASE",
		Color = "Red",
		Size = UDim2.fromOffset(100, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			setReleaseMode(not releaseMode)
		end,
	})
	equipBestButton = Kit.Button(buttons, {
		Text = "EQUIP BEST",
		Color = "Green",
		Size = UDim2.fromOffset(140, 38),
		ZIndex = 62,
		OnClick = function()
			local res = act("EquipBest")
			if res.ok then
				Kit.Toast("Best crew equipped! ⚡ " .. Format.Commas(res.Power or 0), "Good")
			end
		end,
	})
	equipBestButton.Name = "EquipBest"
	panel.Primary = equipBestButton
	-- grid
	grid = Kit.new("ScrollingFrame", {
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.5,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.Corner(grid, UDim.new(0, 12))
	Kit.Padding(grid, 8)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(100, 122),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	-- inspect pane (scrolls, so it fits short phone screens)
	side = Kit.new("Frame", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	emptyHint = Kit.Label(side, "Tap a hunter to inspect it.\n\nEQUIP BEST picks your strongest crew!", { Size = UDim2.new(1, -24, 0.6, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	inspect = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		ZIndex = 63,
		Parent = side,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = inspect })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = inspect })
	viewHolder = Kit.new("Frame", { Size = UDim2.fromOffset(150, 132), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 63, Parent = inspect })
	nameLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 64 })
	nameLabel.LayoutOrder = 2
	rarityRibbon = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 3, ZIndex = 64, Parent = inspect })
	Kit.Corner(rarityRibbon, UDim.new(1, 0))
	Kit.Stroke(rarityRibbon, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(rarityRibbon, Theme.Panel2, Theme.Panel, 0)
	rarityLabel = Kit.Label(rarityRibbon, "", { Style = "Small", ZIndex = 65 })
	statLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 20), Color = Theme.Gold, Style = "Body", Fit = true, ZIndex = 64 })
	statLabel.LayoutOrder = 4
	blurbLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 0), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	blurbLabel.AutomaticSize = Enum.AutomaticSize.Y
	blurbLabel.LayoutOrder = 5
	local actions: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), BackgroundTransparency = 1, LayoutOrder = 6, ZIndex = 63, Parent = inspect })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = actions })
	equipButton = Kit.Button(actions, {
		Text = "EQUIP",
		Color = "Green",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			if not d or not uid then
				return
			end
			if table.find(d.Equipped, uid) then
				act("Unequip", uid)
			else
				act("Equip", uid)
			end
		end,
	})
	equipButton.LayoutOrder = 1
	lockButton = Kit.Button(actions, {
		Text = "🔒 LOCK",
		Color = "Blue",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			local h = uid and d and d.Hunters[uid]
			if h then
				act("Lock", uid, not h.Locked)
			end
		end,
	})
	lockButton.LayoutOrder = 2
	relOneButton = Kit.Button(actions, {
		Text = "RELEASE",
		Color = "Red",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local uid = inspectUid
			if uid then
				act("Release", { uid })
			end
		end,
	})
	relOneButton.LayoutOrder = 3
	-- release bar (replaces the inspect pane in release mode)
	releaseBar = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	Kit.Label(releaseBar, "Tap hunters to select them. Released hunters give back a little Ectoplasm.", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 8), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	Kit.Button(releaseBar, {
		Text = "SELECT WEAK",
		Color = "Orange",
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.fromOffset(10, 74),
		ZIndex = 64,
		OnClick = function()
			-- every unequipped, unlocked hunter weaker than your weakest equipped one
			local d = State.Data
			if not d then
				return
			end
			local weakest = math.huge
			for _, uid in d.Equipped do
				local h = d.Hunters[uid]
				if h then
					weakest = math.min(weakest, powerOf(h.Id))
				end
			end
			table.clear(selected)
			for uid, h in d.Hunters do
				if not h.Locked and not table.find(d.Equipped, uid) and powerOf(h.Id) < weakest then
					selected[uid] = true
				end
			end
			rebuild()
		end,
	})
	releaseConfirm = Kit.Button(releaseBar, {
		Text = "RELEASE 0",
		Color = "Gray",
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0, 10, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			local list = {}
			for uid in selected do
				table.insert(list, uid)
			end
			if #list == 0 then
				return
			end
			local res = act("Release", list)
			if res.ok then
				table.clear(selected)
				rebuild()
			end
		end,
	})
	Hud.RegisterPanel("Hunters", function()
		panel:Toggle()
	end)
end

-- Responsive layout from the panel's actual (logical) width: the inspect pane takes ~30%,
-- and the action buttons move under the counters when the panel is narrow.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local narrow = w < 700
	local topH = if narrow then 88 else 44
	top.Size = UDim2.new(1, 0, 0, topH)
	if narrow then
		actionsRow.AnchorPoint = Vector2.zero
		actionsRow.Position = UDim2.fromOffset(0, 46)
		actionsRow.Size = UDim2.new(1, 0, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Left
		end
	else
		actionsRow.AnchorPoint = Vector2.new(1, 0)
		actionsRow.Position = UDim2.fromScale(1, 0)
		actionsRow.Size = UDim2.new(0, 400, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Right
		end
	end
	local sideW = math.clamp(math.floor(w * 0.3), 200, 260)
	local y = topH + 16
	grid.Position = UDim2.fromOffset(0, y)
	grid.Size = UDim2.new(1, -(sideW + 8), 1, -y)
	side.Position = UDim2.new(1, 0, 0, y)
	side.Size = UDim2.new(0, sideW, 1, -y)
end

function HuntersPanel.Start()
	panel.OnOpen:Connect(function()
		layout()
		rebuild()
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if releaseMode then
			setReleaseMode(false)
		end
		clearPreview()
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
end

function HuntersPanel.EquipBestButton(): TextButton
	return equipBestButton
end

function HuntersPanel.IsOpen(): boolean
	return panel.IsOpen
end

return HuntersPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTER INDEX: discovery tracking per zone ("HAUNTED NEIGHBORHOOD 3/4 DISCOVERED"),
-- overall completion %, silhouettes for unknown hunters, a 3D preview for known ones and a
-- NEW! indicator (menu badge + card sticker) for discoveries you haven't looked at yet.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)
local CratePanel = require(script.Parent.CratePanel)

local IndexPanel = {}

local panel: Kit.Panel
local scroll: ScrollingFrame
local totalLabel: TextLabel
local totalFill: Frame
local bar: Frame
local side: Frame
local detail: ScrollingFrame
local detailView: Frame
local detailName: TextLabel
local detailInfo: TextLabel
local detailBlurb: TextLabel
local menuBadge: Frame
local newIds: { [string]: boolean } = {}
local spinConn: RBXScriptConnection? = nil
local lastKey = ""

local function hunterList(zoneId: string): { Config.HunterDef }
	local out = {}
	local crate = Config.Crates[(Config.ZoneById[zoneId] :: Config.ZoneDef).Crate]
	for _, e in crate.Pool do
		table.insert(out, Config.Hunters[e.Hunter])
	end
	return out
end

type Section = { Id: string, Name: string, Accent: Color3, List: { Config.HunterDef }, Unlocked: boolean }

-- One section per area, then the Robux-only EXCLUSIVE hunters.
local function sections(d: any): { Section }
	local out: { Section } = {}
	for _, z in Config.Zones do
		table.insert(out, { Id = z.Id, Name = z.Name, Accent = z.Accent, List = hunterList(z.Id), Unlocked = d.Zones[z.Id] == true })
	end
	local ex = {}
	for _, z in Config.Zones do
		local id = Config.Exclusives[z.Id]
		if id and Config.Hunters[id] then
			table.insert(ex, Config.Hunters[id])
		end
	end
	if #ex > 0 then
		table.insert(out, { Id = "Exclusive", Name = "💎 EXCLUSIVE (ROBUX CRATE)", Accent = Config.Rarities.Exclusive.Color, List = ex, Unlocked = true })
	end
	return out
end

local function oddsOf(h: Config.HunterDef): number
	local zone = Config.ZoneById[h.Zone]
	local crate = Config.Crates[zone.Crate]
	local odds = Rules.Odds(crate.Pool :: any, function(id)
		return Config.Rarities[Config.Hunters[id].Rarity].Order
	end, 1, Config.LuckAffectsFromOrder)
	return odds[h.Id] or 0
end

local function showDetail(h: Config.HunterDef, found: boolean)
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in detailView:GetChildren() do
		c:Destroy()
	end
	detail.Visible = true
	local rar = Config.Rarities[h.Rarity]
	local crate = if h.Rarity == "Exclusive" then Config.Crates.Exclusive else Config.Crates[(Config.ZoneById[h.Zone] :: Config.ZoneDef).Crate]
	if found then
		local _, model = Portrait.Viewport(detailView, h.Id, false)
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				model:PivotTo(CFrame.Angles(0, (os.clock() - t0) * 0.9, 0))
			end)
		end
		detailName.Text = string.upper(h.Name)
		detailBlurb.Text = h.Blurb
	else
		Portrait.Viewport(detailView, h.Id, true)
		detailName.Text = "???"
		detailBlurb.Text = "Not discovered yet. Keep opening crates!"
	end
	detailName.TextColor3 = rar.Color
	detailInfo.Text = rar.Name .. "  ·  ⚡ " .. (if found then Format.Commas(h.Power) else "?") .. "\n" .. (if h.Rarity == "Exclusive" then "EXCLUSIVE CRATE (ROBUX) · best unlocked area" else crate.Name .. "  ·  " .. Format.Percent(oddsOf(h)))
end

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local key = ""
	local secs = sections(d)
	for _, z in secs do
		key ..= if z.Unlocked then "u" else "l"
		for _, h in z.List do
			key ..= (if d.Discovered[h.Id] then "1" else "0") .. (if newIds[h.Id] then "n" else "")
		end
	end
	if key == lastKey then
		return
	end
	lastKey = key
	for _, c in scroll:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local total, found = 0, 0
	for zi, z in secs do
		local list = z.List
		local zf = 0
		for _, h in list do
			if d.Discovered[h.Id] then
				zf += 1
			end
		end
		if z.Id ~= "Exclusive" then -- paid hunters don't count toward completion
			total += #list
			found += zf
		end
		local section: Frame = Kit.new("Frame", {
			Size = UDim2.new(1, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.45,
			LayoutOrder = zi,
			ZIndex = 62,
			Parent = scroll,
		})
		Kit.Corner(section, UDim.new(0, 12))
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = section })
		Kit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = section })
		local unlocked = z.Unlocked
		local complete = zf == #list
		local header: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 62, Parent = section })
		Kit.Label(header, (if unlocked then "" else "🔒 ") .. z.Name, { Size = UDim2.new(0.6, 0, 1, 0), Align = Enum.TextXAlignment.Left, Color = z.Accent, Style = "Heading", Fit = true, ZIndex = 63 })
		Kit.Label(header, (if complete then "⭐ " else "") .. zf .. "/" .. #list .. " DISCOVERED", { Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = if complete then Theme.Gold else Theme.Text, Style = "Small", Fit = true, ZIndex = 63 })
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 62, Parent = section })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 124), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		for _, h in list do
			local rar = Config.Rarities[h.Rarity]
			local known = d.Discovered[h.Id] == true
			local card: TextButton = Kit.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 63,
				Parent = row,
			})
			Kit.Corner(card, UDim.new(0, 12))
			Kit.Stroke(card, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
			if known then
				Kit.Gradient(card, rar.Color, rar.Color2, 90)
			else
				Kit.Gradient(card, Color3.fromRGB(70, 60, 100), Color3.fromRGB(40, 32, 66), 90)
			end
			local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = card })
			Kit.Corner(pic, UDim.new(1, 0))
			Portrait.Face(pic, h.Id, not known)
			Kit.Label(card, if known then string.upper(h.Name) else "???", { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
			Kit.Label(card, rar.Name, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 100), ZIndex = 66, Color = if known then Color3.new(1, 1, 1) else rar.Color, Style = "Tiny", Fit = true })
			if newIds[h.Id] then
				local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(46, 18), Position = UDim2.new(1, 6, 0, -6), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 70, Stroke = 2 })
				stamp.Rotation = 12
			end
			card.Activated:Connect(function()
				Kit.Play("Click")
				if newIds[h.Id] then
					newIds[h.Id] = nil
					menuBadge.Visible = next(newIds) ~= nil
				end
				showDetail(h, known)
			end)
		end
	end
	local pct = if total > 0 then found / total else 0
	totalLabel.Text = found .. " / " .. total .. " DISCOVERED  ·  " .. math.floor(pct * 100 + 0.5) .. "%"
	Kit.Tween(totalFill, 0.4, { Size = UDim2.fromScale(math.max(pct, 0.02), 1) })
end

function IndexPanel.Init()
	panel = Kit.Panel("Index", "HUNTER INDEX", Vector2.new(860, 500), "Blue")
	local body = panel.Body
	bar = Kit.new("Frame", { Size = UDim2.new(1, -270, 0, 28), Position = UDim2.fromOffset(0, 12), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	totalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(totalFill, UDim.new(1, 0))
	Kit.Gradient(totalFill, Theme.Ecto, Theme.Ecto2, 0)
	totalLabel = Kit.Label(bar, "COLLECTION", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Body", Fit = true, ZIndex = 64 })
	scroll = Kit.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 50),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	side = Kit.new("Frame", { Position = UDim2.new(1, 0, 0, 12), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	Kit.Label(side, "Tap a card to take a closer look!", { Size = UDim2.new(1, -24, 0, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	detail = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 64,
		Parent = side,
	})
	Kit.Corner(detail, UDim.new(0, 12))
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = detail })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = detail })
	detailView = Kit.new("Frame", { Size = UDim2.fromOffset(160, 160), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 65, Parent = detail })
	detailName = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 66 })
	detailName.LayoutOrder = 2
	detailInfo = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Text, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailInfo.AutomaticSize = Enum.AutomaticSize.Y
	detailInfo.LayoutOrder = 3
	detailBlurb = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailBlurb.AutomaticSize = Enum.AutomaticSize.Y
	detailBlurb.LayoutOrder = 4
	-- NEW badge on the INDEX menu button
	menuBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(36, 18),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Ecto,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Index,
	})
	Kit.Corner(menuBadge, UDim.new(1, 0))
	Kit.Stroke(menuBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(menuBadge, "NEW", { Style = "Tiny", ZIndex = 11 })
	Hud.RegisterPanel("Index", function()
		panel:Toggle()
	end)
end

-- Side pane takes ~30% of the panel's actual width; sections wrap their cards.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local sideW = math.clamp(math.floor(w * 0.3), 190, 250)
	bar.Size = UDim2.new(1, -(sideW + 10), 0, 28)
	scroll.Size = UDim2.new(1, -(sideW + 10), 1, -50)
	side.Size = UDim2.new(0, sideW, 1, -12)
end

function IndexPanel.Start()
	panel.OnOpen:Connect(function()
		layout()
		lastKey = ""
		detail.Visible = false
		rebuild()
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
		-- looked at the index: discoveries are no longer "new"
		table.clear(newIds)
		menuBadge.Visible = false
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
	CratePanel.Opened:Connect(function(res: any)
		if res.IsNew then
			newIds[res.Hunter] = true
			menuBadge.Visible = true
		end
	end)
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">LikeReminder</string>
              <string name="Source"><![CDATA[--!strict
-- A friendly reminder to like the game, shown once per session after a while of play.
-- No reward (Roblox doesn't allow rewards for likes) and nothing blocks the screen.
local Theme = require(script.Parent.Parent.UI.Theme)
local Hud = require(script.Parent.Hud)

local LikeReminder = {}

local FIRST_AFTER = 10 * 60 -- seconds of play before the reminder

function LikeReminder.Init() end

function LikeReminder.Start()
	task.delay(FIRST_AFTER, function()
		Hud.Banner("HAVING FUN? 👻", "Tap 👍 on the game page to help Ghost Hunters grow!", Theme.Ecto)
	end)
end

return LikeReminder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[--!strict
-- Ectoplasm orbs (visual only; the server owns values and decides pickups).
--   Drops   → orbs pop out of the poof on an arc, bounce twice, then hover and glow.
--   Pickup  → as soon as an orb is inside your pickup radius it starts accelerating toward you
--             (predicted locally so it feels instant); it is "eaten" when the server confirms
--             the pickup (Collect). Unconfirmed orbs wait at your side briefly, then go back.
-- One RenderStepped loop moves every orb with BulkMoveTo; parts are pooled.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Orbs = {}

type Orb = {
	Id: number,
	Part: BasePart,
	Value: number,
	Start: Vector3,
	Land: Vector3,
	T0: number,
	FlyDur: number,
	Phase: string, -- Fly | Rest | Magnet | Held | Fade
	Confirmed: boolean,
	MagnetT0: number,
	MagnetFrom: Vector3,
	HeldT0: number,
	NoPredictUntil: number,
	ExpireAt: number,
	Spin: number,
	Size: number,
	Pos: Vector3,
}

local player = Players.LocalPlayer
local orbs: { [number]: Orb } = {}
local pool: { BasePart } = {}
local folder: Folder
local hidden = CFrame.new(0, -500, 0)
local streak = 0
local lastPickup = 0
local ring: Part
local ringGui: SurfaceGui
local ringStroke: UIStroke
local ringAlpha = 0
local collectedSignal = Signal.new()
Orbs.Collected = collectedSignal -- (amount)

local GREEN = Theme.Ecto
local CYAN = Theme.Ecto2

local function getPart(): BasePart
	local p = table.remove(pool)
	if p then
		p.Transparency = 0.05
		return p
	end
	local b = Instance.new("Part")
	b.Name = "Ecto"
	b.Shape = Enum.PartType.Ball
	b.Material = Enum.Material.Neon
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.CastShadow = false
	b.Transparency = 0.05
	b.CFrame = hidden
	b.Parent = folder
	return b
end

local function release(o: Orb)
	orbs[o.Id] = nil
	o.Part.CFrame = hidden
	if #pool < 300 then
		table.insert(pool, o.Part)
	else
		o.Part:Destroy()
	end
end

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function radius(): number
	local d = State.Data
	return if d and d.PickupRadius then d.PickupRadius else Config.Upgrades.PickupRadius.Levels[1]
end

local function spawnDrops(origin: Vector3, list: { any }, removed: { number }?)
	local now = os.clock()
	-- the server retired these (too many uncollected orbs): fade them out like a timeout
	if type(removed) == "table" then
		for _, id in removed do
			local old = orbs[id]
			if old and old.Phase ~= "Magnet" and old.Phase ~= "Held" then
				old.Phase = "Fade"
				old.T0 = now
			end
		end
	end
	for i, item in list do
		local id, land, value = item[1], item[2], item[3]
		if type(id) ~= "number" or typeof(land) ~= "Vector3" or type(value) ~= "number" or orbs[id] then
			continue
		end
		-- size by value relative to your best area (ZoneMultiplier ~ typical income there), so
		-- boss and big drops stand out in every zone instead of all late orbs being max size
		local rel = value / math.max(1, (State.Data and State.Data.ZoneMultiplier) or 1)
		local size = math.clamp(0.9 + 0.35 * math.log10(math.max(1, rel)), 0.9, 1.9)
		local part = getPart()
		part.Size = Vector3.new(size, size, size)
		part.Color = GREEN:Lerp(CYAN, math.random() * 0.6)
		local o: Orb = {
			Id = id,
			Part = part,
			Value = value,
			Start = origin,
			Land = land,
			T0 = now + (i - 1) * 0.025, -- tiny stagger so a burst "sprays"
			FlyDur = 0.45 + math.random() * 0.25,
			Phase = "Fly",
			Confirmed = false,
			MagnetT0 = 0,
			MagnetFrom = origin,
			HeldT0 = 0,
			NoPredictUntil = 0,
			ExpireAt = now + Config.Drops.Lifetime,
			Spin = math.random() * 6.28,
			Size = size,
			Pos = origin,
		}
		orbs[id] = o
	end
	-- ectoplasm splash where the ghost popped
	Effects.Burst(origin, { Color = GREEN, Color2 = CYAN, Count = math.min(6 + #list * 2, 30), Size = 0.7, Speed = 14, Life = 0.5, Gravity = 25 })
	Sound.Play("Drop", 0.1)
end

local function startMagnet(o: Orb)
	if o.Phase == "Magnet" or o.Phase == "Held" or o.Phase == "Fade" then
		return
	end
	o.Phase = "Magnet"
	o.MagnetT0 = os.clock()
	o.MagnetFrom = o.Pos
end

local function eat(o: Orb, at: Vector3)
	local now = os.clock()
	if now - lastPickup < 0.6 then
		streak = math.min(streak + 1, 14)
	else
		streak = 0
	end
	lastPickup = now
	Effects.Burst(at, { Color = o.Part.Color, Count = 5, Size = 0.45, Speed = 6, Life = 0.35 })
	Sound.Play("Pickup", 0.02, 1 + streak * 0.045) -- rising pitch on a pickup streak
	release(o)
	collectedSignal:Fire(o.Value)
end

local function onCollect(ids: { number }, _total: number)
	for _, id in ids do
		local o = orbs[id]
		if o then
			o.Confirmed = true
			if o.Phase == "Held" then
				local r = rootPart()
				eat(o, if r then r.Position else o.Pos)
			else
				startMagnet(o)
			end
		end
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	local now = os.clock()
	local root = rootPart()
	local rpos = if root then root.Position else nil
	local rad = radius()
	local r2 = rad * rad
	local nearCount = 0
	table.clear(parts)
	table.clear(cframes)
	for _, o in orbs do
		local pos: Vector3
		if o.Phase == "Fly" then
			local a = math.clamp((now - o.T0) / o.FlyDur, 0, 1)
			local dist = (o.Land - o.Start).Magnitude
			local arc = (2.5 + dist * 0.35) * 4 * a * (1 - a)
			pos = o.Start:Lerp(o.Land, a) + Vector3.new(0, arc, 0)
			if a >= 1 then
				o.Phase = "Rest"
				o.T0 = now
			end
		elseif o.Phase == "Rest" then
			local b = now - o.T0
			local bounce = 0
			if b < 0.5 then
				local k = b / 0.5
				bounce = math.abs(math.sin(k * math.pi * 2)) * 1.3 * (1 - k)
			end
			pos = o.Land + Vector3.new(0, 0.35 + bounce + math.sin(now * 3 + o.Spin) * 0.22, 0)
			if now >= o.ExpireAt then
				o.Phase = "Fade"
				o.T0 = now
			elseif rpos and now >= o.NoPredictUntil then
				local dx, dz = pos.X - rpos.X, pos.Z - rpos.Z
				if dx * dx + dz * dz <= r2 and math.abs(pos.Y - rpos.Y) < 14 then
					startMagnet(o)
				end
			end
			if rpos and (pos - rpos).Magnitude < rad + 25 then
				nearCount += 1
			end
		elseif o.Phase == "Magnet" then
			local a = math.clamp((now - o.MagnetT0) / Config.Drops.FlyTime, 0, 1)
			local target = if rpos then rpos else o.MagnetFrom
			local e = a * a -- accelerate in
			pos = o.MagnetFrom:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 2, 0)
			if a >= 1 then
				if o.Confirmed then
					eat(o, target)
					continue
				end
				o.Phase = "Held"
				o.HeldT0 = now
			end
		elseif o.Phase == "Held" then
			pos = if rpos then rpos else o.Pos
			if now - o.HeldT0 > 1.2 then
				-- server didn't agree (moved away too fast?) - send it back to where it was
				o.Phase = "Rest"
				o.T0 = now - 1
				o.NoPredictUntil = now + 1.5
				pos = o.Land
			end
		else -- Fade
			local a = math.clamp((now - o.T0) / 0.4, 0, 1)
			local s = o.Size * (1 - a)
			o.Part.Size = Vector3.new(s, s, s) + Vector3.new(0.05, 0.05, 0.05)
			pos = o.Land + Vector3.new(0, 0.35, 0)
			if a >= 1 then
				release(o)
				continue
			end
		end
		o.Pos = pos
		table.insert(parts, o.Part)
		-- hidden while held at the player (waiting for the server)
		table.insert(cframes, if o.Phase == "Held" then hidden else CFrame.new(pos) * CFrame.Angles(0, now * 2 + o.Spin, 0))
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- pickup radius ring: fades in while orbs are lying around nearby
	local want = if nearCount > 0 and rpos then 1 else 0
	ringAlpha += (want - ringAlpha) * math.min(1, dt * 6)
	if rpos and ringAlpha > 0.02 then
		local d = rad * 2
		if math.abs(ring.Size.X - d) > 0.05 then
			ring.Size = Vector3.new(d, 0.1, d)
			local pps = math.clamp(math.floor(600 / d), 6, 30)
			ringGui.PixelsPerStud = pps
			ringStroke.Thickness = math.max(2, 0.4 * pps)
		end
		ring.CFrame = CFrame.new(rpos.X, rpos.Y - 2.85, rpos.Z)
		ringStroke.Transparency = 1 - 0.55 * ringAlpha
		ringGui.Enabled = true
	elseif ringGui.Enabled then
		ringGui.Enabled = false
		ring.CFrame = hidden
	end
end

function Orbs.Count(): number
	local n = 0
	for _, o in orbs do
		if o.Phase == "Rest" or o.Phase == "Fly" then
			n += 1
		end
	end
	return n
end

function Orbs.Nearest(pos: Vector3): Vector3?
	local best, bestD = nil, math.huge
	for _, o in orbs do
		if o.Phase == "Rest" then
			local d = (o.Pos - pos).Magnitude
			if d < bestD then
				best, bestD = o.Pos, d
			end
		end
	end
	return best
end

function Orbs.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHOrbs"
	folder.Parent = workspace
	ring = Instance.new("Part")
	ring.Name = "PickupRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(28, 0.1, 28)
	ring.CFrame = hidden
	ring.Parent = folder
	ringGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Brightness = 2,
		Enabled = false,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = ringGui })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 6, Color = GREEN, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
end

function Orbs.Start()
	Net.Event("Drops").OnClientEvent:Connect(spawnDrops)
	Net.Event("Collect").OnClientEvent:Connect(onCollect)
	RunService.RenderStepped:Connect(step)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Crate opening cinematic. Plays on a private stage far from the map with a scripted camera:
--   crate drops in → bounces → shakes (rare+: levitates while rarity energy converges) →
--   locks pop → lid flies open → light burst → the hunter leaps out and poses → result card.
-- Intensity comes from Config.Rarities (RevealPause, ShakeIntensity, Particles, Darken,
-- CameraPunch). Commons are quick; "Fast crate opening" in settings shortens everything; SKIP
-- jumps straight to the result. Every step is written as anim(duration, apply(alpha)) so a
-- skip simply applies each step's end state.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local HunterRig = require(GH.Rigs.HunterRig)
local CrateRig = require(GH.Rigs.CrateRig)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local Targeting = require(script.Parent.Targeting)

local Reveal = {}

export type Result = {
	Crate: string,
	Hunter: string,
	Uid: string,
	IsNew: boolean,
}

local player = Players.LocalPlayer
local STAGE = Vector3.new(0, 900, -2500)
local CAM_FOV = 50

local playing = false
local skipping = false
local stage: Folder? = nil
local gui: ScreenGui? = nil
local cc: ColorCorrectionEffect? = nil
local rays: Frame? = nil
local raySpeed = 20
local poseConn: RBXScriptConnection? = nil
local hunterRig: HunterRig.Rig? = nil
local hunterState = "Idle"
local againFn: (() -> ())? = nil
local liveTweens: { Tween } = {}
local shakeToken = 0
local cardShown = false
local okButton: TextButton? = nil

-- Tweens the reveal starts are tracked so closing it can stop them (no lingering darkening
-- or FOV changes after a quick SKIP + OK).
local function tween(obj: Instance, info: TweenInfo, props: { [string]: any }): Tween
	local tw = TweenService:Create(obj, info, props)
	table.insert(liveTweens, tw)
	tw:Play()
	return tw
end
local finishedSignal = Signal.new()
Reveal.Finished = finishedSignal -- (result)
local startedSignal = Signal.new()
Reveal.Started = startedSignal
local stopAutoSignal = Signal.new()
Reveal.AutoStopped = stopAutoSignal -- the player pressed STOP AUTO OPEN

function Reveal.IsPlaying(): boolean
	return playing
end

local function hasPermanentSkip(): boolean
	local d = State.Data
	return d ~= nil and d.Passes ~= nil and d.Passes[Config.CrateSkip.Pass] == true
end

-- "Fast crate opening" is part of Permanent Crate Skip (skipping is paid now).
local function fast(): boolean
	local d = State.Data
	return d ~= nil and d.Settings.FastReveal == true and hasPermanentSkip()
end

-- SKIP: Permanent Crate Skip owners skip free; others use a bought Single Crate Skip (10 R$).
-- The server checks and spends; the reveal is only a cinematic of a hunter that's already saved.
local skipBusy = false
local pendingSkip = false
local skipButton: TextButton? = nil
local autoMode = false

local function skipLabel(): string
	local d = State.Data
	if hasPermanentSkip() then
		return "SKIP ⏩"
	end
	local tokens = if d then d.SkipTokens or 0 else 0
	return if tokens > 0 then "SKIP ⏩ (" .. tokens .. ")" else "SKIP ⏩ R$10"
end

local function requestSkip()
	if skipping or cardShown or not playing or skipBusy then
		return
	end
	skipBusy = true
	local res = State.Request("UseSkip")
	skipBusy = false
	if res.ok then
		pendingSkip = false
		skipping = true
		return
	end
	if res.err == "NeedSkip" then
		local buy = State.Request("Buy", Config.CrateSkip.Product)
		if buy.ok then
			pendingSkip = true -- the purchase arrives as a SkipGranted message
		else
			Kit.Toast(buy.err or "Skip isn't available", "Bad")
		end
	else
		Kit.Toast(res.err or "Couldn't skip", "Bad")
	end
end

-- Runs fn(alpha) every frame for `t` seconds (alpha 0→1). On skip: fn(1) immediately.
local function anim(t: number, fn: (number) -> ())
	if skipping or t <= 0 then
		fn(1)
		return
	end
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / t, 0, 1)
		fn(a)
		if a >= 1 or skipping then
			if skipping then
				fn(1)
			end
			return
		end
		RunService.RenderStepped:Wait()
	end
end

local function easeOutBack(a: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end

local function easeOutBounce(a: number): number
	local n1, d1 = 7.5625, 2.75
	if a < 1 / d1 then
		return n1 * a * a
	elseif a < 2 / d1 then
		a -= 1.5 / d1
		return n1 * a * a + 0.75
	elseif a < 2.5 / d1 then
		a -= 2.25 / d1
		return n1 * a * a + 0.9375
	end
	a -= 2.625 / d1
	return n1 * a * a + 0.984375
end

local controls: any = nil
local function setControls(on: boolean)
	if not controls then
		local ok, mod = pcall(function()
			local ps = player:WaitForChild("PlayerScripts")
			return (require :: any)(ps:WaitForChild("PlayerModule"))
		end)
		if ok and mod then
			controls = mod:GetControls()
		end
	end
	if controls then
		pcall(function()
			if on then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = stage
	return p
end

local function buildStage(rarity: Config.RarityDef)
	local f = Instance.new("Folder")
	f.Name = "GHReveal"
	f.Parent = workspace
	stage = f
	-- floor disc with glowing trim
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 18, 18), Color = Color3.fromRGB(45, 28, 80), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 19, 19), Color = rarity.Color, Material = Enum.Material.Neon, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	-- backdrop with spinning rays (SurfaceGui, unaffected by lighting)
	local back = part({ Size = Vector3.new(70, 44, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 6, 14)) })
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 14,
		LightInfluence = 0,
		Brightness = 1,
		Parent = back,
	})
	local bg: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sg })
	Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 40)),
			ColorSequenceKeypoint.new(0.5, rarity.Color2:Lerp(Color3.fromRGB(40, 20, 70), 0.55)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 10, 40)),
		}),
		Rotation = 90,
		Parent = bg,
	})
	local holder: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(1400, 1400),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = bg,
	})
	-- six full-length bars through the centre = twelve rays (GUI rotation pivots on the centre)
	for i = 0, 5 do
		local ray: Frame = Kit.new("Frame", {
			Size = UDim2.new(0, 110, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Rotation = i * 30,
			Parent = holder,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.58, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
	end
	rays = holder
	-- lights
	local l1 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 7, -6)) })
	Kit.new("PointLight", { Range = 22, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 255), Parent = l1 })
	local l2 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 3, 3)) })
	Kit.new("PointLight", { Name = "RarityLight", Range = 16, Brightness = 0, Color = rarity.Color, Parent = l2 })
end

local function buildGui(): (ScreenGui, TextButton)
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = "GHRevealGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Kit.new("UIScale", { Scale = Kit.UIScale(), Parent = g })
	local skip = Kit.Button(g, {
		Text = skipLabel(),
		Color = if hasPermanentSkip() then "Gray" else "Orange",
		Size = UDim2.fromOffset(150, 40),
		Position = UDim2.new(1, -16, 1, -16),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 5,
		OnClick = function()
			task.spawn(requestSkip)
		end,
	})
	skipButton = skip
	if autoMode then
		Kit.Button(g, {
			Text = "STOP AUTO OPEN",
			Color = "Red",
			Size = UDim2.fromOffset(180, 40),
			Position = UDim2.new(0, 16, 1, -16),
			AnchorPoint = Vector2.new(0, 1),
			ZIndex = 5,
			OnClick = function()
				Reveal.StopAuto()
			end,
		})
	end
	gui = g
	return g, skip
end

local function flash(color: Color3, t: number)
	local g = gui
	if not g then
		return
	end
	local f: Frame = Kit.new("Frame", { Size = UDim2.fromScale(4, 4), Position = UDim2.fromScale(-1.5, -1.5), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 20, Parent = g })
	Kit.Tween(f, t, { BackgroundTransparency = 1 })
	task.delay(t, function()
		f:Destroy()
	end)
end

local function cameraShake(intensity: number, t: number)
	local cam = workspace.CurrentCamera
	if not cam or skipping then
		return
	end
	local my = shakeToken
	local base = cam.CFrame
	anim(t, function(a)
		if my ~= shakeToken or not playing then
			return
		end
		local k = intensity * (1 - a)
		cam.CFrame = base * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end)
	if my == shakeToken and playing then
		cam.CFrame = base
	end
end

local function resultCard(g: ScreenGui, res: Result, rarity: Config.RarityDef)
	local def = Config.Hunters[res.Hunter]
	local d = State.Data
	-- right side of the screen, so the hunter (shifted left by the camera) stays the focus
	local card: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 232),
		Position = UDim2.new(1, -20, 0.5, 10),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = g,
	})
	Kit.Corner(card, UDim.new(0, 18))
	Kit.Stroke(card, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, Theme.Panel2, Theme.Bg, 90)
	local sc = Kit.new("UIScale", { Scale = 0.3, Parent = card })
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- slide in from the right edge
	card.Position = UDim2.new(1, 380, 0.5, 10)
	Kit.Tween(card, 0.35, { Position = UDim2.new(1, -20, 0.5, 10) }, Enum.EasingStyle.Back)
	-- rarity ribbon
	local ribbon: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(200, 32),
		Position = UDim2.new(0.5, 0, 0, -16),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 12,
		Parent = card,
	})
	Kit.Corner(ribbon, UDim.new(0, 10))
	Kit.Stroke(ribbon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ribbon, rarity.Color, rarity.Color2, 0)
	Kit.Label(ribbon, rarity.Name, { Style = "Heading", ZIndex = 13 })
	Kit.Label(card, string.upper(def.Name), { Size = UDim2.new(1, -30, 0, 30), Position = UDim2.fromOffset(15, 22), Style = "Title", Fit = true, ZIndex = 11 })
	Kit.Label(card, "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER", { Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 54), Color = Theme.Gold, Style = "Body", ZIndex = 11 })
	Kit.Label(card, def.Blurb, { Size = UDim2.new(1, -30, 0, 52), Position = UDim2.fromOffset(15, 78), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 11, Stroke = 0 })
	if res.IsNew then
		local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(80, 30), Position = UDim2.new(1, 8, 0, 4), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Title", ZIndex = 14 })
		stamp.Rotation = 14
		local ssc = Kit.new("UIScale", { Scale = 3, Parent = stamp })
		Kit.Tween(ssc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	-- buttons
	local row: Frame = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0, 10, 1, -58),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = card,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = row })
	local equipped = d and table.find(d.Equipped, res.Uid) ~= nil
	local slots = if d then d.Slots or Config.Inventory.BaseSlots else Config.Inventory.BaseSlots
	if d and not equipped then
		local free = #d.Equipped < slots
		-- with full slots, offer EQUIP BEST only if this hunter beats the weakest equipped one
		local weakest = math.huge
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h then
				weakest = math.min(weakest, Config.Hunters[h.Id].Power)
			end
		end
		if free or def.Power > weakest then
			local b: TextButton
			b = Kit.Button(row, {
				Text = if free then "EQUIP" else "EQUIP BEST",
				Color = "Green",
				Size = UDim2.fromOffset(118, 44),
				ZIndex = 12,
				OnClick = function()
					local r = if free then State.Request("Equip", res.Uid) else State.Request("EquipBest")
					if r.ok then
						Kit.SetButtonText(b, "EQUIPPED ✅")
						b:SetAttribute("Color", "Gray")
						b.Active = false
					else
						Kit.Toast(r.err or "Couldn't equip", "Bad")
					end
				end,
			})
			b.Name = "EquipButton"
		end
	end
	if againFn then
		local crate = Config.Crates[res.Crate]
		local fnAgain = againFn
		Kit.Button(row, {
			Text = "AGAIN 💚" .. Format.Short(crate.Price),
			Color = "Purple",
			Size = UDim2.fromOffset(122, 44),
			ZIndex = 12,
			OnClick = function()
				fnAgain()
			end,
		})
	end
	okButton = Kit.Button(row, {
		Text = "OK",
		Color = "Blue",
		Size = UDim2.fromOffset(84, 44),
		ZIndex = 12,
		OnClick = function()
			Reveal.Close()
		end,
	})
end

local function teardownStage()
	shakeToken += 1
	for _, tw in liveTweens do
		tw:Cancel()
	end
	table.clear(liveTweens)
	cardShown = false
	okButton = nil
	if poseConn then
		poseConn:Disconnect()
		poseConn = nil
	end
	if stage then
		stage:Destroy()
		stage = nil
	end
	if gui then
		gui:Destroy()
		gui = nil
	end
	hunterRig = nil
	rays = nil
end

-- Ends the reveal and gives the camera back.
function Reveal.Close()
	if not playing then
		return
	end
	-- a skip bought for THIS reveal that arrives later is kept as a token, not spent on the next one
	pendingSkip = false
	teardownStage()
	if cc then
		cc.Brightness = 0
		cc.Saturation = 0
		cc.Contrast = 0
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
	Kit.Screen().Enabled = true
	setControls(true)
	Targeting.SetBlocked(false)
	ProximityPromptService.Enabled = Kit.CurrentPanel() == nil
	ContextActionService:UnbindAction("GHRevealB")
	if GuiService.SelectedObject and not GuiService.SelectedObject:IsDescendantOf(Kit.Screen()) then
		GuiService.SelectedObject = nil
	end
	playing = false
	finishedSignal:Fire()
end

export type PlayOpts = { Auto: boolean? }

-- Plays the opening for a server-confirmed result. `again` (optional) re-buys the same crate.
-- opts.Auto: Auto Open reveal (STOP button, the card closes by itself).
function Reveal.Play(res: Result, again: (() -> ())?, opts: PlayOpts?)
	autoMode = opts ~= nil and opts.Auto == true
	local def = Config.Hunters[res.Hunter]
	local crateDef = Config.Crates[res.Crate]
	if not def or not crateDef then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	againFn = again
	if playing then
		teardownStage() -- "AGAIN": keep the camera, rebuild the stage
	end
	playing = true
	skipping = autoMode and hasPermanentSkip() -- Auto Open + Permanent Skip: quick reveals
	startedSignal:Fire()
	Targeting.SetBlocked(true)
	setControls(false)
	Kit.Screen().Enabled = false
	ProximityPromptService.Enabled = false -- station prompts would float over the cinematic
	ContextActionService:BindActionAtPriority("GHRevealB", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			if cardShown then
				Reveal.Close()
			else
				task.spawn(requestSkip)
			end
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.ButtonB)
	buildStage(rarity)
	local g, skip = buildGui()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = CAM_FOV
	local camCF = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13), STAGE + Vector3.new(0, 2.6, 0))
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0)) -- lighting detail follows Focus
	flash(Color3.new(1, 1, 1), 0.35)

	local f = if fast() then 0.5 else 1
	local my = stage

	-- crate
	local crate = CrateRig.Build(res.Crate)
	crate.Model:ScaleTo(1.25)
	crate.Model.Parent = stage
	local base = CFrame.new(STAGE)
	local function placeCrate(cf: CFrame)
		crate.Model:PivotTo(cf)
	end
	placeCrate(base + Vector3.new(0, 9, 0))

	-- rays spin + hunter poses
	raySpeed = 20
	local hunterT0 = os.clock()
	poseConn = RunService.RenderStepped:Connect(function(dt: number)
		if rays then
			rays.Rotation = (rays.Rotation + dt * raySpeed) % 360
		end
		if hunterRig then
			HunterRig.Pose(hunterRig, hunterState, os.clock() - hunterT0, 1)
		end
	end)

	Sound.Play("CrateBuy")
	-- 1) drop in with a bounce
	anim(0.45 * f, function(a)
		placeCrate(base + Vector3.new(0, 9 * (1 - easeOutBounce(a)), 0))
	end)
	if stage ~= my then
		return
	end
	-- 2) shake (+ levitate, darken and converging energy for rarer pulls)
	local shakeT = (0.55 + rarity.RevealPause) * f
	local levitate = if rarity.Order >= 3 then 1.4 else 0
	local charge: ParticleEmitter? = nil
	if rarity.RevealPause > 0.3 and not skipping then
		local sphere = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 2.5, 0)) })
		local e = Instance.new("ParticleEmitter")
		e.Shape = Enum.ParticleEmitterShape.Sphere
		e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Texture = Effects.Textures.Sparkle
		e.Color = ColorSequence.new(rarity.Color, rarity.Color2)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) })
		e.Speed = NumberRange.new(9, 12)
		e.Lifetime = NumberRange.new(0.45, 0.6)
		e.Rate = 0
		e.Parent = sphere
		charge = e
	end
	if cc and rarity.Darken > 0 and not skipping then
		tween(cc, TweenInfo.new(shakeT * 0.6), { Brightness = -rarity.Darken * 0.35, Saturation = -rarity.Darken * 0.4 })
	end
	local rl = (if stage then stage:FindFirstChild("RarityLight", true) else nil) :: any
	if not skipping then
		Sound.Play("CrateShake")
	end
	local nextShakeSound = os.clock() + 0.45
	anim(shakeT, function(a)
		local k = rarity.ShakeIntensity * (0.4 + a)
		local tt = os.clock()
		local wob = CFrame.Angles(math.sin(tt * 38) * 0.06 * k, math.sin(tt * 29) * 0.1 * k, math.sin(tt * 47) * 0.09 * k)
		local lift = levitate * math.sin(math.min(a * 1.6, 1) * math.pi / 2)
		placeCrate(base * CFrame.new(math.sin(tt * 53) * 0.12 * k, lift, 0) * wob)
		raySpeed = 20 + 160 * a * rarity.Order / 5
		if charge then
			charge.Rate = 15 + 110 * a
		end
		if rl then
			rl.Brightness = 3 * a * math.min(1, rarity.Order / 3)
		end
		if tt >= nextShakeSound and a < 0.95 then
			nextShakeSound = tt + 0.45
			Sound.Play("CrateShake", 0.1)
		end
	end)
	if charge then
		charge.Rate = 0
	end
	if stage ~= my then
		return
	end
	placeCrate(base + Vector3.new(0, levitate, 0))
	-- 3) locks pop off
	if not skipping then
		Sound.Play("LockPop")
	end
	anim(0.22 * f, function(a)
		local e = easeOutBack(a)
		crate.Motors.LockL.Transform = CFrame.new(-1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, 2.5 * a)
		crate.Motors.LockR.Transform = CFrame.new(1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, -2.5 * a)
	end)
	-- drop the padlocks (and their welded shackles) out of sight
	crate.Motors.LockL.Transform = CFrame.new(0, -60, 0)
	crate.Motors.LockR.Transform = CFrame.new(0, -60, 0)
	-- 4) lid flies open + light burst
	local burstPos = crate.Burst.WorldPosition
	if not skipping then
		Sound.Play(rarity.Sound)
		flash(rarity.Color, 0.45)
		Effects.Flash(burstPos, rarity.Color, 5 + rarity.Order, 0.5)
		Effects.Burst(burstPos, { Color = rarity.Color, Color2 = Color3.new(1, 1, 1), Count = rarity.Particles, Size = 0.9, Speed = 26, Life = 1.1, Gravity = 18 })
		Effects.Ring(STAGE + Vector3.new(0, 0.2, 0), rarity.Color, 10, 0.6)
		if cc then
			tween(cc, TweenInfo.new(0.5), { Brightness = 0.12, Saturation = 0.15 })
			task.delay(0.5, function()
				if cc then
					tween(cc, TweenInfo.new(0.6), { Brightness = 0, Saturation = 0 })
				end
			end)
		end
		if rarity.CameraPunch then
			cam.FieldOfView = CAM_FOV - 10
			tween(cam, TweenInfo.new(0.45, Enum.EasingStyle.Back), { FieldOfView = CAM_FOV })
			task.spawn(cameraShake, 0.5 * rarity.ShakeIntensity, 0.35)
		end
	end
	crate.Glow.Color = rarity.Color
	anim(0.3 * f, function(a)
		crate.Motors.Lid.Transform = CFrame.Angles(math.rad(115) * easeOutBack(a), 0, 0)
		crate.Glow.Transparency = 1 - 0.85 * a
	end)
	if stage ~= my then
		return
	end
	-- 5) hunter leaps out
	local rig = HunterRig.Build(res.Hunter)
	rig.Model:ScaleTo(1.2)
	rig.Model.Parent = stage
	hunterRig = rig
	hunterState = "Celebrate"
	hunterT0 = os.clock()
	local from = STAGE + Vector3.new(0, levitate + 0.6, 0.2)
	local to = STAGE + Vector3.new(0, 0, -3.4)
	anim(0.55 * f, function(a)
		local p = from:Lerp(to, a) + Vector3.new(0, 5.5 * 4 * a * (1 - a), 0)
		local spin = (1 - a) * math.pi * 2
		rig.Model:PivotTo(CFrame.new(p) * CFrame.Angles(0, spin, 0))
	end)
	rig.Model:PivotTo(CFrame.new(to))
	-- the crate settles back down behind the hunter
	placeCrate(base)
	if not skipping then
		Effects.Ring(to + Vector3.new(0, 0.15, 0), Color3.new(1, 1, 1), 5, 0.4)
		Effects.Burst(to + Vector3.new(0, 3, 0), { Color = rarity.Color, Count = math.floor(rarity.Particles / 3), Size = 0.6, Speed = 14, Life = 0.7 })
	end
	if stage ~= my then
		return
	end
	-- 6) legendary title slam
	if rarity.Order >= 5 and not skipping then
		local title = Kit.Label(g, rarity.Name .. "!", { Size = UDim2.fromOffset(600, 70), Position = UDim2.fromScale(0.5, 0.2), AnchorPoint = Vector2.new(0.5, 0.5), Color = rarity.Color, Style = "Banner", TextSize = 54, ZIndex = 8, Stroke = 4 })
		-- solid colour (a UIGradient on big text dropped letters on phones)
		local tsc = Kit.new("UIScale", { Scale = 3, Parent = title })
		Kit.Tween(tsc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		task.spawn(cameraShake, 0.35, 0.3)
	end
	skip.Visible = false
	skipping = false
	raySpeed = 25
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0))
	-- slide the camera so the hunter sits left of centre, clear of the info card on the right
	local side = Vector3.new(-3.6, 0, 0)
	tween(cam, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { CFrame = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13) + side, STAGE + Vector3.new(0, 2.6, 0) + side) })
	resultCard(g, res, rarity)
	cardShown = true
	if autoMode then
		-- Auto Open: the card closes by itself so the next crate can play
		local myStage = stage
		task.delay(if hasPermanentSkip() then 0.6 else 1.4, function()
			if playing and stage == myStage then
				Reveal.Close()
			end
		end)
	end
	if okButton and UserInputService.GamepadEnabled and UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then
		GuiService.SelectedObject = okButton
	end
end

function Reveal.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "GHRevealCC"
	effect.Parent = Lighting
	cc = effect
end

function Reveal.StopAuto()
	autoMode = false
	task.spawn(function()
		State.Request("AutoOpen", nil)
	end)
	stopAutoSignal:Fire()
end

function Reveal.Start()
	-- a Single Crate Skip bought during a reveal is used right away
	State.OnFx("SkipGranted", function()
		if skipButton and skipButton.Parent then
			Kit.SetButtonText(skipButton, skipLabel())
		end
		if pendingSkip and playing and not cardShown then
			task.spawn(requestSkip)
		end
	end)
	-- respawning mid-reveal must not leave the camera stuck
	player.CharacterAdded:Connect(function()
		if playing then
			Reveal.Close()
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- SHOP: Robux products (Ectoplasm packs, boosts) and game passes. Items without an id in
-- Config show "SOON". Purchases are prompted and granted by the server only.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local ShopPanel = {}

local panel: Kit.Panel
local passButtons: { [string]: TextButton } = {}
local ectoLabels: { [string]: TextLabel } = {}

local function card(parent: Instance, order: number, iconKey: string?, icon: string, name: string, sub: string, price: string, available: boolean, color: string, onBuy: () -> ()): (TextButton, TextLabel)
	local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = parent })
	Kit.Corner(f, UDim.new(0, 14))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local c = Theme.Buttons[color] or Theme.Buttons.Purple
	Kit.Gradient(f, c[1], c[2], 90)
	Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), Style = "Icon", TextSize = 32, ZIndex = 63, Stroke = 0 })
	Kit.Label(f, name, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 48), Style = "Body", ZIndex = 63 })
	local subLabel = Kit.Label(f, sub, { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 84), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Font = Theme.Body, Style = "Tiny", Stroke = 1 })
	local b = Kit.Button(f, {
		Text = if available then price else "SOON",
		Color = if available then "Green" else "Gray",
		Size = UDim2.new(1, -16, 0, 38),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 64,
		OnClick = onBuy,
	})
	return b, subLabel
end

-- Live Robux prices: Roblox "managed pricing" can change them, so ask Roblox once per item
-- and show what it says (the Config PriceLabel is only the fallback).
local priceButtons: { [string]: TextButton } = {}
local function fetchPrices()
	local function fetch(key: string, id: number, kind: Enum.InfoType)
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, kind)
		end)
		local b = priceButtons[key]
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" and b then
			local d = State.Data
			if not (d and d.Passes and d.Passes[key]) then
				Kit.SetButtonText(b, "R$ " .. info.PriceInRobux)
			end
		end
	end
	for _, p in Config.Products do
		if p.ProductId then
			task.spawn(fetch, p.Key, p.ProductId, Enum.InfoType.Product)
		end
	end
	for _, pass in Config.GamePasses do
		if pass.PassId then
			task.spawn(fetch, pass.Key, pass.PassId, Enum.InfoType.GamePass)
		end
	end
end

local function buy(key: string)
	local res = State.Request("Buy", key)
	if not res.ok then
		Kit.Toast(res.err or "Can't buy that right now", "Bad")
	end
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local mult = d.ZoneMultiplier or 1
	for _, p in Config.Products do
		local l = ectoLabels[p.Key]
		if l and p.Amount then
			l.Text = "+" .. Format.Short(p.Amount * mult) .. " ECTOPLASM"
		end
	end
	for _, pass in Config.GamePasses do
		local b = passButtons[pass.Key]
		if b and d.Passes and d.Passes[pass.Key] then
			Kit.SetButtonText(b, "OWNED ✅")
			b:SetAttribute("Color", "Gray")
		end
	end
end

function ShopPanel.Init()
	panel = Kit.Panel("Shop", "SHOP", Vector2.new(780, 500), "Pink")
	local scroll: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 10),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	-- cards wrap to as many rows as the panel width needs
	local function section(order: number, title: string): Frame
		Kit.Label(scroll, title, { Size = UDim2.new(1, 0, 0, 24), Style = "Heading", ZIndex = 62 }).LayoutOrder = order
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, ZIndex = 61, Parent = scroll })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 168), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		return row
	end
	local prodRow = section(1, "BOOSTS & ECTOPLASM")
	for i, p in Config.Products do
		local sub = if p.Blurb then p.Blurb elseif p.Kind == "Ecto" then "+" .. Format.Short(p.Amount or 0) .. " ECTOPLASM" else Format.Time(p.Seconds or 0) .. " BOOST"
		local prodButton, subLabel = card(prodRow, i, Icons.ForProduct[p.Key], p.Icon, p.Name, sub, p.PriceLabel, p.ProductId ~= nil, if p.Kind == "Ecto" then "Green" else "Purple", function()
			buy(p.Key)
		end)
		if p.Kind == "Ecto" then
			ectoLabels[p.Key] = subLabel
		end
		priceButtons[p.Key] = prodButton
	end
	local passRow = section(3, "GAME PASSES (FOREVER)")
	for i, pass in Config.GamePasses do
		if pass.Hidden then
			continue -- no longer sold (e.g. the old Auto Attack pass: Auto Attack is free now)
		end
		local sub = if pass.Blurb then pass.Blurb elseif pass.Slots then "+" .. pass.Slots .. " EQUIPPED HUNTERS" else "x" .. tostring(pass.Multiplier or 2) .. " ALL ECTOPLASM"
		local b = card(passRow, i, Icons.ForProduct[pass.Key], pass.Icon, pass.Name, sub, pass.PriceLabel, pass.PassId ~= nil, "Orange", function()
			buy(pass.Key)
		end)
		passButtons[pass.Key] = b
		priceButtons[pass.Key] = b
	end
	Kit.Label(scroll, "Ectoplasm packs grow with the furthest area you've unlocked. Auto Attack only picks targets for you: same damage, same rewards.", { Size = UDim2.new(1, -10, 0, 36), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 }).LayoutOrder = 5
	Hud.RegisterPanel("Shop", function()
		panel:Toggle()
	end)
end

function ShopPanel.Start()
	panel.OnOpen:Connect(refresh)
	-- prices: once when the shop first opens, then every few minutes while it's opened again
	local lastFetch = -math.huge
	panel.OnOpen:Connect(function()
		if os.clock() - lastFetch > 300 then
			lastFetch = os.clock()
			fetchPrices()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds by key from GH.Sounds; respects the player's Music/SFX settings.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Sounds = require(GH.Sounds)
local State = require(script.Parent.Parent.State)

local Sound = {}

local pool: { [string]: { Sound } } = {}
local folder: Folder
local music: Sound? = nil
local bossMusic: Sound? = nil
local lastPlay: { [string]: number } = {}

local function sfxOn(): boolean
	local d = State.Data
	return not d or d.Settings.Sfx ~= false
end

local function make(key: string): Sound?
	local def = Sounds[key]
	if not def or not def.Id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch or 1
	s.Looped = def.Looped == true
	s.Parent = folder
	return s
end

-- pitchJitter adds small random variation; pitchMul shifts the pitch (pickup streaks).
function Sound.Play(key: string, pitchJitter: number?, pitchMul: number?)
	if not sfxOn() then
		return
	end
	local now = os.clock()
	if now - (lastPlay[key] or 0) < 0.035 then
		return -- de-dupe bursts (e.g. 20 orbs landing at once)
	end
	lastPlay[key] = now
	local list = pool[key]
	if not list then
		list = {}
		pool[key] = list
	end
	local s: Sound? = nil
	for _, c in list do
		if not c.IsPlaying then
			s = c
			break
		end
	end
	if not s and #list < 4 then
		s = make(key)
		if s then
			table.insert(list, s)
		end
	end
	if s then
		local def = Sounds[key]
		s.PlaybackSpeed = (def.Pitch or 1) * (pitchMul or 1) * (1 + (if pitchJitter then (math.random() * 2 - 1) * pitchJitter else 0))
		s.TimePosition = 0
		s:Play()
	end
end

local function refreshMusic()
	local d = State.Data
	local on = not d or d.Settings.Music ~= false
	for _, m in { music, bossMusic } do
		if m then
			m.Volume = if on then (Sounds[m.Name].Volume) else 0
		end
	end
end

function Sound.Boss(active: boolean)
	if bossMusic and music then
		if active then
			bossMusic:Play()
			music:Pause()
		else
			bossMusic:Stop()
			music:Resume()
		end
	end
end

function Sound.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHSounds"
	folder.Parent = SoundService
end

function Sound.Start()
	music = make("Music")
	bossMusic = make("BossMusic")
	if music then
		music:Play()
	end
	State.OnData(function()
		refreshMusic()
	end)
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Targeting</string>
              <string name="Source"><![CDATA[--!strict
-- Ghost selection. PC: click a ghost. Mobile: tap a ghost. Console: ButtonX (or F on a
-- keyboard) targets the ghost nearest the centre of the screen and cycles on repeat presses.
-- The selection is optimistic (instant highlight + sound) and then follows the server's
-- authoritative "Target" attribute.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Targeting = {}

local player = Players.LocalPlayer
local selectRemote: RemoteEvent
local selectHL: Highlight
local hoverHL: Highlight
local pending: number? = nil
local pendingAt = 0
local blocked = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local selectedSignal = Signal.new()
Targeting.Selected = selectedSignal -- (uid) fired on a local selection

function Targeting.SetBlocked(on: boolean)
	blocked = on
end

function Targeting.Current(): number
	return (player:GetAttribute("Target") :: number?) or 0
end

-- The target your crew should be heading for right now: your fresh tap (before the server
-- confirms it) or the server's choice. Lets your hunters react the instant you tap.
function Targeting.LocalTarget(): number
	return pending or Targeting.Current()
end

local function showHighlight(uid: number)
	local e = if uid ~= 0 then Ghosts.Get(uid) else nil
	if e then
		selectHL.Adornee = e.Model
		selectHL.OutlineColor = e.Def.Glow
		selectHL.FillColor = e.Def.Glow
		selectHL.Enabled = true
		Ghosts.SetSelected(uid)
	else
		selectHL.Adornee = nil
		selectHL.Enabled = false
		Ghosts.SetSelected(0)
	end
end

local function rootPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

function Targeting.Select(uid: number)
	if blocked then
		return
	end
	local e = Ghosts.Get(uid)
	if not e then
		return
	end
	local zone = Config.ZoneById[e.Def.Zone]
	local d = State.Data
	if d and zone and not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " first!", "Bad")
		return
	end
	local p = rootPos()
	if p and (e.Pos - p).Magnitude > Config.Combat.MaxRange + 10 then
		Kit.Toast("Get closer to that ghost!", "Bad")
		return
	end
	pending = uid
	pendingAt = os.clock()
	showHighlight(uid)
	Sound.Play("Select")
	Effects.Ring(e.Pos, e.Def.Glow, 4 * e.Def.Scale, 0.35)
	if Targeting.Current() ~= uid then
		selectRemote:FireServer(uid)
	end
	selectedSignal:Fire(uid)
end

-- `pos` is in GUI coordinates (InputObject.Position, TouchTap) unless `viewport` is true
-- (GetMouseLocation); the matching camera functions keep the top-bar inset consistent.
local function ghostAtScreen(pos: Vector2, viewport: boolean?): Ghosts.Entry?
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Ghosts")
	if not cam or not folder then
		return nil
	end
	rayParams.FilterDescendantsInstances = { folder }
	local ray = if viewport then cam:ViewportPointToRay(pos.X, pos.Y) else cam:ScreenPointToRay(pos.X, pos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams)
	-- (a culled ghost's hitbox isn't moved while parked, so a hit on it is a stale position)
	local hitEntry = if hit then Ghosts.FromInstance(hit.Instance) else nil
	if hitEntry and not hitEntry.Culled then
		return hitEntry
	end
	-- Forgiving fallback (no surgical taps needed): the ghost whose centre is nearest the tap,
	-- within ~8% of the screen. When ghosts overlap, the one nearer the camera wins ties.
	local vp = cam.ViewportSize
	local radius = math.clamp(math.min(vp.X, vp.Y) * 0.08, 40, 72)
	local camPos = cam.CFrame.Position
	local best, bestScore = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Dying or e.Culled then
			continue
		end
		local sp, onScreen
		if viewport then
			sp, onScreen = cam:WorldToViewportPoint(e.Pos)
		else
			sp, onScreen = cam:WorldToScreenPoint(e.Pos)
		end
		if onScreen then
			-- bigger ghosts are bigger targets on screen
			local reach = radius + 12 * e.Def.Scale
			local dist = (Vector2.new(sp.X, sp.Y) - pos).Magnitude
			if dist <= reach then
				local score = dist + 0.15 * (e.Pos - camPos).Magnitude
				if score < bestScore then
					best, bestScore = e, score
				end
			end
		end
	end
	return best
end

-- Console / keyboard: pick the ghost closest to screen centre (within range), cycling.
local function cycleTarget()
	local cam = workspace.CurrentCamera
	local p = rootPos()
	if not cam or not p then
		return
	end
	local list = {}
	local d = State.Data
	for uid, e in Ghosts.All() do
		if e.Dying or (d and not d.Zones[e.Def.Zone]) then
			continue
		end
		if (e.Pos - p).Magnitude <= Config.Combat.MaxRange then
			local sp, onScreen = cam:WorldToViewportPoint(e.Pos)
			if onScreen then
				local c = cam.ViewportSize / 2
				table.insert(list, { Uid = uid, Score = (Vector2.new(sp.X, sp.Y) - c).Magnitude })
			end
		end
	end
	if #list == 0 then
		Kit.Toast("No ghosts nearby!", "Bad")
		return
	end
	table.sort(list, function(a, b)
		return a.Score < b.Score
	end)
	local cur = pending or Targeting.Current()
	local idx = 1
	for i, item in list do
		if item.Uid == cur then
			idx = (i % #list) + 1
			break
		end
	end
	Targeting.Select(list[idx].Uid)
end

function Targeting.Init()
	selectHL = Instance.new("Highlight")
	selectHL.Name = "GHSelect"
	selectHL.FillTransparency = 0.75
	selectHL.OutlineTransparency = 0
	selectHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	selectHL.Enabled = false
	selectHL.Parent = workspace
	hoverHL = Instance.new("Highlight")
	hoverHL.Name = "GHHover"
	hoverHL.FillTransparency = 1
	hoverHL.OutlineColor = Color3.new(1, 1, 1)
	hoverHL.OutlineTransparency = 0.3
	hoverHL.DepthMode = Enum.HighlightDepthMode.Occluded
	hoverHL.Enabled = false
	hoverHL.Parent = workspace
end

function Targeting.Start()
	selectRemote = Net.Event("SelectTarget")

	-- Mouse click (PC). Taps use TouchTap so camera drags never select by accident.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or blocked then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local e = ghostAtScreen(Vector2.new(input.Position.X, input.Position.Y))
			if e then
				Targeting.Select(e.Uid)
			end
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or blocked or #positions == 0 then
			return
		end
		local e = ghostAtScreen(positions[1])
		if e then
			Targeting.Select(e.Uid)
		end
	end)
	ContextActionService:BindAction("GHTarget", function(_, state)
		if state == Enum.UserInputState.Begin and not blocked then
			cycleTarget()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonX, Enum.KeyCode.F)

	-- authoritative target from the server
	player:GetAttributeChangedSignal("Target"):Connect(function()
		local uid = Targeting.Current()
		pending = nil
		showHighlight(uid)
	end)
	Ghosts.Died:Connect(function(uid)
		if selectHL.Adornee and Targeting.Current() == uid then
			showHighlight(0)
		end
	end)

	-- hover outline (mouse only) + reconcile a rejected optimistic selection
	RunService.RenderStepped:Connect(function()
		if pending and os.clock() - pendingAt > 0.8 then
			pending = nil
			showHighlight(Targeting.Current())
		end
		if not UserInputService.MouseEnabled or blocked then
			hoverHL.Enabled = false
			return
		end
		local m = UserInputService:GetMouseLocation()
		local e = ghostAtScreen(m, true)
		if e and e.Model ~= selectHL.Adornee then
			hoverHL.Adornee = e.Model
			hoverHL.Enabled = true
		else
			hoverHL.Enabled = false
		end
	end)
end

return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time guidance without walls of text:
--   1 TAP A GHOST!  →  2 COLLECT ECTOPLASM!  →  3 OPEN A HUNTER CRATE!  →
--   4 EQUIP YOUR NEW HUNTER!  →  5 UNLOCK THE CEMETERY!  →  done
-- A glowing breadcrumb trail on the ground + a bouncing arrow over the target show where to
-- go; menu buttons pulse when they're the next step. After the tutorial a small NEXT GOAL
-- chip keeps the next zone in view. Progress is saved (server only accepts forward steps).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Orbs = require(script.Parent.Orbs)
local Reveal = require(script.Parent.Reveal)
local CratePanel = require(script.Parent.CratePanel)
local HuntersPanel = require(script.Parent.HuntersPanel)
local Boss = require(script.Parent.Boss)
local Sound = require(script.Parent.Sound)

local Tutorial = {}

local player = Players.LocalPlayer
local STEPS = #Config.Tutorial.Steps
local step = 0 -- 0 = not loaded yet
local promptFrame: Frame
local promptLabel: TextLabel
local promptSub: TextLabel
local goalChip: Frame
local goalLabel: TextLabel
local goalFill: Frame
local dots: { BasePart } = {}
local marker: BillboardGui
local markerPart: Part
local guideTarget: (() -> Vector3?)? = nil
local guideUntil = math.huge
local framed = false

local DOTS = 12
local SPACING = 3.6

--------------------------------------------------------------------------------
-- guide (breadcrumbs + marker)
--------------------------------------------------------------------------------
local function setGuide(fn: (() -> Vector3?)?, seconds: number?)
	guideTarget = fn
	guideUntil = if seconds then os.clock() + seconds else math.huge
end
Tutorial.SetGuide = setGuide

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local hidden = CFrame.new(0, -400, 0)
local dotsHidden = true
local parts: { BasePart } = {}
local cfs: { CFrame } = {}

local function hideDots()
	if dotsHidden then
		return -- nothing to do: no per-frame writes while the guide is off
	end
	dotsHidden = true
	for _, d in dots do
		d.CFrame = hidden
	end
end

local function updateGuide()
	local root = rootPart()
	local target = if guideTarget and os.clock() < guideUntil then guideTarget() else nil
	if not root or not target or Reveal.IsPlaying() then
		hideDots()
		if marker.Enabled then
			marker.Enabled = false
		end
		return
	end
	markerPart.CFrame = CFrame.new(target)
	marker.Enabled = true
	local from = root.Position - Vector3.new(0, 2.7, 0)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 6 then
		hideDots()
		return
	end
	dotsHidden = false
	local dir = flat.Unit
	local t = os.clock()
	local offset = (t * 6) % SPACING -- dots flow toward the target
	local groundEnd = math.min(target.Y, from.Y + 2)
	table.clear(parts)
	table.clear(cfs)
	for i, d in dots do
		local along = 2.5 + (i - 1) * SPACING + offset
		if along > dist - 2 then
			table.insert(parts, d)
			table.insert(cfs, hidden)
		else
			local k = along / dist
			local y = from.Y + (groundEnd - from.Y) * k + 0.35
			local pulse = 0.75 + 0.25 * math.sin(t * 6 - i * 0.6)
			d.Size = Vector3.new(pulse, pulse, pulse)
			table.insert(parts, d)
			table.insert(cfs, CFrame.new(from.X + dir.X * along, y, from.Z + dir.Z * along))
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

--------------------------------------------------------------------------------
-- prompts
--------------------------------------------------------------------------------
local shownText = ""
local function setPrompt(text: string?, sub: string?)
	if not text then
		if promptFrame.Visible then
			promptFrame.Visible = false
			shownText = ""
		end
		return
	end
	promptSub.Text = sub or ""
	promptSub.Visible = sub ~= nil
	if text ~= shownText then
		shownText = text
		promptLabel.Text = text
		promptFrame.Visible = true
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		sc.Scale = 0.5
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.Play("Select")
	end
end

local function tapWord(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Gamepad1 then
		return "PRESS (X) TO TARGET A GHOST!"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "TAP A GHOST!"
	end
	return "CLICK A GHOST!"
end

local function nearestGhost(): Vector3?
	local root = rootPart()
	if not root then
		return nil
	end
	local d = State.Data
	local best, bestD = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Def.Kind ~= "Event" and (not d or d.Zones[e.Def.Zone]) then
			local dist = (e.Pos - root.Position).Magnitude
			if dist < bestD then
				best, bestD = e, dist
			end
		end
	end
	return if best then best.Pos + Vector3.new(0, 2.5 * best.Def.Scale + 1, 0) else nil
end

local function cratePos(): Vector3?
	local p = Config.Layout.CrateStations.Beginner
	return p + Vector3.new(0, 8, 0)
end

local function gatePos(): Vector3?
	local g = Config.Layout.Gates.Cemetery
	return if g then Vector3.new(0, 10, g.Z - 4) else nil
end

local function advance(to: number)
	if to <= step then
		return
	end
	step = to
	task.spawn(State.Request, "Tutorial", to)
	if to > STEPS then
		setPrompt(nil)
		setGuide(nil)
		Hud.Pulse("Hunters", false)
		Hud.Banner("TUTORIAL COMPLETE!", "Keep hunting, collecting and unlocking!", Theme.Gold)
	end
end

-- Pulsing ring on a button inside a menu: while a menu is open the guidance lives on the
-- button itself (a prompt pill would sit under/over the menu).
local rings: { [GuiObject]: Frame } = {}
local function pulseRing(b: GuiObject, on: boolean)
	local existing = rings[b]
	if on and not existing then
		local ring: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 80, Parent = b })
		Kit.Corner(ring, UDim.new(0, 12))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		rings[b] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.new(1, 20, 1, 20) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and existing then
		existing:Destroy()
		rings[b] = nil
	end
end

local function setEquipRing(on: boolean)
	pulseRing(HuntersPanel.EquipBestButton(), on)
end

-- One-time camera framing of the nearest ghost for brand-new players.
local function frameGhost()
	if framed then
		return
	end
	framed = true
	local root = rootPart()
	local target = nearestGhost()
	local cam = workspace.CurrentCamera
	if not root or not target or not cam then
		return
	end
	local start = cam.CFrame
	local eye = root.Position + Vector3.new(0, 5, 0) - (target - root.Position).Unit * 10
	local look = CFrame.lookAt(eye, target)
	cam.CameraType = Enum.CameraType.Scriptable
	local tw = TweenService:Create(cam, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { CFrame = look })
	tw:Play()
	tw.Completed:Wait()
	task.wait(0.8)
	local back = TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { CFrame = start })
	back:Play()
	back.Completed:Wait()
	if not Reveal.IsPlaying() then
		cam.CameraType = Enum.CameraType.Custom
	end
end

local collectedOnce = false

local function tick()
	local d = State.Data
	if not d or step == 0 then
		return
	end
	local panel = Kit.CurrentPanel()
	if step > STEPS then
		-- NEXT GOAL chip
		local nextZone: Config.ZoneDef? = nil
		for _, z in Config.Zones do
			if not d.Zones[z.Id] then
				nextZone = z
				break
			end
		end
		local bossState = Boss.State()
		if nextZone and not panel and bossState == "Idle" and not Reveal.IsPlaying() then
			goalChip.Visible = true
			goalLabel.Text = "NEXT: UNLOCK " .. nextZone.Name .. "  " .. Format.Short(math.min(d.Ecto, nextZone.Cost)) .. " / " .. Format.Short(nextZone.Cost)
			goalFill.Size = UDim2.fromScale(math.clamp(d.Ecto / nextZone.Cost, 0.02, 1), 1)
		elseif not nextZone and not panel and bossState == "Idle" and not Reveal.IsPlaying() then
			-- every area open: the goal becomes the full Hunter Index
			local total, found = 0, 0
			for id, h in Config.Hunters do
				if h.Rarity == "Exclusive" then
					continue -- Robux-only hunters are never a required goal
				end
				total += 1
				if d.Discovered[id] then
					found += 1
				end
			end
			goalChip.Visible = found < total
			goalLabel.Text = "NEXT: DISCOVER EVERY HUNTER  " .. found .. " / " .. total
			goalFill.Size = UDim2.fromScale(math.clamp(found / math.max(total, 1), 0.02, 1), 1)
		else
			goalChip.Visible = false
		end
		return
	end
	goalChip.Visible = false
	if Reveal.IsPlaying() or (panel ~= nil and panel ~= "Crate" and panel ~= "Hunters") then
		setPrompt(nil)
		return
	end
	local target = (player:GetAttribute("Target") :: number?) or 0
	if step == 1 then
		setPrompt(tapWord())
		setGuide(nearestGhost)
		if target ~= 0 then
			advance(2)
		end
	elseif step == 2 then
		if Orbs.Count() > 0 then
			setPrompt("COLLECT ECTOPLASM!", "Walk close - it flies to you!")
			setGuide(function()
				local root = rootPart()
				return if root then Orbs.Nearest(root.Position) else nil
			end)
		elseif target ~= 0 then
			setPrompt("YOUR HUNTER IS ON IT!", "Ghosts POOF into Ectoplasm")
			setGuide(nil)
		else
			setPrompt(tapWord())
			setGuide(nearestGhost)
		end
		if collectedOnce then
			advance(3)
		end
	elseif step == 3 then
		local price = Config.Crates.Beginner.Price
		if (d.Stats.Crates or 0) >= 1 then
			pulseRing(CratePanel.Button(), false)
			advance(4)
		elseif d.Ecto >= price or (d.FreeCrates.Beginner or 0) > 0 then
			if CratePanel.IsOpen() then
				setPrompt(nil)
				pulseRing(CratePanel.Button(), true)
				setGuide(nil)
			else
				pulseRing(CratePanel.Button(), false)
				setPrompt("OPEN A HUNTER CRATE!", "Follow the trail to the crate")
				setGuide(cratePos)
			end
		else
			setPrompt("COLLECT " .. price .. " ECTOPLASM", Format.Commas(d.Ecto) .. " / " .. price .. "  -  tap more ghosts!")
			setGuide(if target == 0 then nearestGhost else nil)
		end
	elseif step == 4 then
		-- done once a second hunter is equipped (or all you own, if you released the new one)
		if #d.Equipped >= math.min(2, State.CountOwned()) then
			Hud.Pulse("Hunters", false)
			setEquipRing(false)
			advance(5)
		elseif panel == "Hunters" then
			setPrompt(nil)
			Hud.Pulse("Hunters", false)
			setEquipRing(true)
		else
			setPrompt("EQUIP YOUR NEW HUNTER!", "Open HUNTERS")
			Hud.Pulse("Hunters", true)
			setEquipRing(false)
		end
		setGuide(nil)
	elseif step == 5 then
		local zone = Config.ZoneById.Cemetery
		if d.Zones.Cemetery then
			advance(6)
		elseif panel then
			setPrompt(nil)
		elseif d.Ecto >= zone.Cost then
			setPrompt("UNLOCK THE CEMETERY!", "Follow the trail to the gate")
			setGuide(gatePos)
		else
			setPrompt("UNLOCK THE CEMETERY!", Format.Commas(d.Ecto) .. " / " .. Format.Commas(zone.Cost) .. " Ectoplasm  -  open crates, equip the best!")
			setGuide(nil)
		end
	end
end

function Tutorial.Init()
	local screen = Kit.Screen()
	-- compact pill low in the middle of the screen (between the thumbstick and jump button)
	promptFrame = Kit.new("Frame", {
		Name = "TutorialPrompt",
		Size = UDim2.fromOffset(400, 58),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = screen,
	})
	Kit.Corner(promptFrame, UDim.new(0, 14))
	Kit.new("UIScale", { Parent = promptFrame })
	promptLabel = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 28), Position = UDim2.fromOffset(12, 4), Color = Theme.Ecto, Style = "Heading", TextSize = 22, Fit = true, ZIndex = 41 })
	promptSub = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(12, 32), Color = Theme.Text, Style = "Small", Fit = true, ZIndex = 41 })
	Kit.Button(promptFrame, {
		Text = "SKIP",
		Color = "Gray",
		Size = UDim2.fromOffset(58, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Tiny",
		ZIndex = 42,
		OnClick = function()
			advance(STEPS + 1)
		end,
	})
	-- pulse the prompt gently
	task.spawn(function()
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		while true do
			if promptFrame.Visible then
				Kit.Tween(sc, 0.5, { Scale = 1.04 }, Enum.EasingStyle.Sine)
				task.wait(0.5)
				Kit.Tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Sine)
			end
			task.wait(0.5)
		end
	end)
	-- NEXT GOAL bar: directly under the Ectoplasm / Power counters (Hud.TopStack)
	goalChip = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 24),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 20,
		LayoutOrder = 1,
		Parent = Hud.TopStack or screen,
	})
	Kit.Corner(goalChip, UDim.new(1, 0))
	Kit.Stroke(goalChip, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	goalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Theme.Ecto, BackgroundTransparency = 0.55, ZIndex = 21, Parent = goalChip })
	Kit.Corner(goalFill, UDim.new(1, 0))
	goalLabel = Kit.Label(goalChip, "", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Small", Fit = true, ZIndex = 22 })

	-- breadcrumbs + marker
	local folder = Instance.new("Folder")
	folder.Name = "GHGuide"
	folder.Parent = workspace
	for _ = 1, DOTS do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.9, 0.9, 0.9)
		p.Material = Enum.Material.Neon
		p.Color = Theme.Ecto
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = hidden
		p.Parent = folder
		table.insert(dots, p)
	end
	markerPart = Instance.new("Part")
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(1, 1, 1)
	markerPart.CFrame = hidden
	markerPart.Parent = folder
	-- device-scaled bouncing arrow over the target (always readable, never huge)
	marker = WorldLabel.New({
		Name = "GuideArrow",
		Adornee = markerPart,
		Parent = folder,
		Size = Vector2.new(Theme.World.Marker, Theme.World.Marker),
		Offset = Vector3.new(0, 2.5, 0),
		MaxDistance = 600,
		AlwaysOnTop = true,
	})
	marker.Enabled = false
	local arrow = WorldLabel.Text(marker, "⬇", { Color = Theme.Ecto, Style = "Banner", Stroke = 3 })
	task.spawn(function()
		while true do
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0.2) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
		end
	end)
end

function Tutorial.Start()
	Orbs.Collected:Connect(function()
		collectedOnce = true
	end)
	RunService.RenderStepped:Connect(updateGuide)
	-- "SHOW ME" on the boss bar reuses the trail for a few seconds
	Boss.PointRequested:Connect(function()
		local _, pos = Boss.State()
		setGuide(function()
			return pos + Vector3.new(0, 16, 0)
		end, 10)
	end)
	task.spawn(function()
		local d = State.WaitForData()
		step = math.clamp(d.Tutorial or 1, 1, STEPS + 1)
		if step == 1 then
			-- let the world settle, then frame the first ghost
			task.wait(2)
			if (player:GetAttribute("Target") or 0) == 0 then
				frameGhost()
			end
		end
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[--!strict
-- UPGRADES: Pickup Radius, Ectoplasm Bonus, Movement Speed. Level pips, current → next value
-- and an escalating price; the server validates every purchase.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local UpgradesPanel = {}

type Row = { Pips: { Frame }, Value: TextLabel, Buy: TextButton }

local panel: Kit.Panel
local rows: { [string]: Row } = {}

local function fmt(up: Config.UpgradeDef, v: number): string
	if up.Format == "percent" then
		return "+" .. math.floor(v * 100 + 0.5) .. "%"
	elseif up.Format == "studs" then
		return v .. " studs"
	end
	return tostring(v)
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	for id, row in rows do
		local up = Config.Upgrades[id]
		local level = d.Upgrades[id] or 1
		for i, pip in row.Pips do
			pip.BackgroundColor3 = if i <= level then Theme.Ecto else Theme.Bg
		end
		local cur = Rules.UpgradeValue(up.Levels, level)
		local cost = Rules.UpgradeCost(up.Costs, level)
		if cost then
			row.Value.Text = fmt(up, cur) .. "  >  " .. fmt(up, Rules.UpgradeValue(up.Levels, level + 1))
			Kit.SetButtonText(row.Buy, "💚 " .. Format.Short(cost))
			row.Buy:SetAttribute("Color", if d.Ecto >= cost then "Green" else "Gray")
		else
			row.Value.Text = fmt(up, cur) .. "  (MAX)"
			Kit.SetButtonText(row.Buy, "MAXED ⭐")
			row.Buy:SetAttribute("Color", "Orange")
		end
	end
end

function UpgradesPanel.Init()
	panel = Kit.Panel("Upgrades", "UPGRADES", Vector2.new(640, 380), "Green")
	-- rows are full-width with the text area stretching (Scale) and the button pinned right,
	-- so they work from a phone to a wide monitor; the list scrolls if the panel is short
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -12),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	for i, id in Config.UpgradeOrder do
		local up = Config.Upgrades[id]
		local r: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 88), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.4, LayoutOrder = i, ZIndex = 62, Parent = list })
		Kit.Corner(r, UDim.new(0, 14))
		local icon: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = r })
		Kit.Corner(icon, UDim.new(0, 14))
		Kit.Stroke(icon, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(icon, Theme.Panel3, Theme.Panel, 90)
		Kit.Icon(icon, Icons.ForUpgrade[id], up.Icon, { Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Icon", TextSize = 30, ZIndex = 64, Stroke = 0 })
		-- text column: everything between the icon and the buy button
		local text: Frame = Kit.new("Frame", { Size = UDim2.new(1, -(84 + 160), 1, -12), Position = UDim2.fromOffset(84, 6), BackgroundTransparency = 1, ZIndex = 62, Parent = r })
		Kit.Label(text, up.Name, { Size = UDim2.new(1, 0, 0, 22), Align = Enum.TextXAlignment.Left, Style = "Heading", Fit = true, ZIndex = 63 })
		Kit.Label(text, up.Description, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 24), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Fit = true, ZIndex = 63, Stroke = 0 })
		local n = #up.Levels
		local pipW = if n > 5 then 10 else 15
		local pipRowW = n * pipW + (n - 1) * 3
		local value = Kit.Label(text, "", { Size = UDim2.new(1, -(pipRowW + 6), 0, 20), Position = UDim2.new(0, 0, 1, -20), Align = Enum.TextXAlignment.Left, Color = Theme.Ecto, Style = "Body", Fit = true, ZIndex = 63 })
		local pipRow: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(pipRowW, 12), Position = UDim2.new(1, 0, 1, -16), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 63, Parent = text })
		Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = pipRow })
		local pips = {}
		for _ = 1, n do
			local pip: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(pipW, 12), BackgroundColor3 = Theme.Bg, ZIndex = 64, Parent = pipRow })
			Kit.Corner(pip, UDim.new(0, 4))
			Kit.Stroke(pip, 1.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
			table.insert(pips, pip)
		end
		local buy = Kit.Button(r, {
			Text = "",
			Color = "Green",
			Size = UDim2.fromOffset(140, 48),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 64,
			OnClick = function()
				local res = State.Request("BuyUpgrade", id)
				if res.ok then
					Sound.Play("Upgrade")
					Kit.Toast(up.Name .. " upgraded to level " .. tostring(res.Level) .. "!", "Good")
					local char = game:GetService("Players").LocalPlayer.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						Effects.Burst(root.Position, { Color = Theme.Ecto, Count = 30, Size = 0.8, Speed = 16 })
						Effects.Ring(root.Position - Vector3.new(0, 2.8, 0), Theme.Ecto, 8, 0.5)
					end
				else
					Kit.Toast(res.err or "Can't buy that yet", "Bad")
				end
			end,
		})
		rows[id] = { Pips = pips, Value = value, Buy = buy }
		if i == 1 then
			panel.Primary = buy
		end
	end
	Hud.RegisterPanel("Upgrades", function()
		panel:Toggle()
	end)
end

function UpgradesPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

function UpgradesPanel.Open()
	if not panel.IsOpen then
		panel:Open()
	end
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">WorldsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- WORLDS (Fast Travel): a card per zone. Unlocked zones teleport you to their arrival pad
-- (the server checks ownership and places you); locked zones show a lock and their price.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)

local WorldsPanel = {}

type Card = { Frame: Frame, Status: TextLabel, Lock: GuiObject, Go: TextButton }

local player = Players.LocalPlayer
local panel: Kit.Panel
local cards: { [string]: Card } = {}
local busy = false

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function currentZone(): string?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local z = Config.Zones[Rules.ZoneIndexAt(root.Position.Z, zoneRanges)]
	return if z then z.Id else nil
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local here = currentZone()
	for _, z in Config.Zones do
		local c = cards[z.Id]
		local owned = d.Zones[z.Id] == true
		c.Lock.Visible = not owned
		c.Frame.BackgroundTransparency = if owned then 0 else 0.35
		if not owned then
			c.Status.Text = "🔒 " .. Format.Short(z.Cost)
			c.Status.TextColor3 = Theme.Muted
			Kit.SetButtonText(c.Go, "LOCKED")
			c.Go:SetAttribute("Color", "Gray")
		elseif z.Id == here then
			c.Status.Text = "YOU ARE HERE"
			c.Status.TextColor3 = Theme.Ecto
			Kit.SetButtonText(c.Go, "HERE")
			c.Go:SetAttribute("Color", "Gray")
		else
			c.Status.Text = "UNLOCKED"
			c.Status.TextColor3 = Theme.Ecto
			Kit.SetButtonText(c.Go, "GO!")
			c.Go:SetAttribute("Color", "Green")
		end
	end
end

local function travel(zone: Config.ZoneDef)
	local d = State.Data
	if busy or not d then
		return
	end
	if not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " at its gate first!", "Bad")
		return
	end
	if zone.Id == currentZone() then
		panel:Close()
		return
	end
	busy = true
	local res = State.Request("Travel", zone.Id)
	busy = false
	if res.ok then
		panel:Close()
		Sound.Play("ZoneUnlock")
		Hud.Banner(zone.Name, "Fast travel complete!", zone.Accent)
	else
		Kit.Toast(res.err or "Can't travel right now", "Bad")
	end
end

function WorldsPanel.Init()
	panel = Kit.Panel("Worlds", "WORLDS", Vector2.new(720, 420), "Blue")
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -8),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(160, 150),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 6), Parent = list })
	for _, z in Config.Zones do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = z.Order, ZIndex = 62, Parent = list })
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(f, z.Accent:Lerp(Theme.Panel3, 0.35), z.FogColor, 90)
		Kit.Label(f, tostring(z.Order), { Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(6, 6), Style = "Heading", ZIndex = 64 })
		-- optional uploaded zone badge (icon-prompts/) between the number and the lock
		local hasIcon = Icons.Get(Icons.ForZone(z.Id)) ~= nil
		if hasIcon then
			Kit.Icon(f, Icons.ForZone(z.Id), "", { Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 63 })
		end
		Kit.Label(f, z.Name, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, if hasIcon then 38 else 32), Style = "Body", ZIndex = 64 })
		local status = Kit.Label(f, "", { Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(6, 74), Style = "Small", Fit = true, ZIndex = 64 })
		local lock = Kit.Icon(f, "lock", "🔒", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -6, 0, 4), AnchorPoint = Vector2.new(1, 0), Style = "Icon", Stroke = 0, ZIndex = 65 })
		local go = Kit.Button(f, {
			Text = "GO!",
			Color = "Green",
			Size = UDim2.new(1, -20, 0, 40),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 64,
			OnClick = function()
				travel(z)
			end,
		})
		cards[z.Id] = { Frame = f, Status = status, Lock = lock, Go = go }
		if z.Order == 1 then
			panel.Primary = go
		end
	end
	Hud.RegisterPanel("Worlds", function()
		panel:Toggle()
	end)
end

function WorldsPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return WorldsPanel
]]></string>
            </Properties>
          </Item>
