        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number/time formatting shared by UI and signs (pure).
local Format = {}

-- 1250 -> "1,250"
function Format.Commas(n: number): string
	local neg = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if neg then "-" else "") .. out
end

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1250 -> "1,250", 125000 -> "125K", 1520000 -> "1.52M"
function Format.Short(n: number): string
	if math.abs(n) < 100000 then
		return Format.Commas(n)
	end
	local i = 1
	local v = math.abs(n)
	while v >= 1000 and i < #SUFFIX do
		v /= 1000
		i += 1
	end
	local digits = if v >= 100 then 0 elseif v >= 10 then 1 else 2
	local s = string.format("%." .. digits .. "f", math.floor(v * 10 ^ digits) / 10 ^ digits)
	if digits > 0 then
		-- trim trailing decimal zeros only ("1.50" -> "1.5", "2.00" -> "2"; "100" stays "100")
		s = s:gsub("0+$", "")
		s = s:gsub("%.$", "")
	end
	return (if n < 0 then "-" else "") .. s .. SUFFIX[i]
end

-- 3725 -> "1h 2m", 125 -> "2:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%dh %dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Format.Percent(x: number): string
	local p = x * 100
	if p >= 10 then
		return string.format("%d%%", math.floor(p + 0.5))
	elseif p >= 1 then
		return (string.format("%.1f", p):gsub("%.0$", "")) .. "%"
	end
	return (string.format("%.2f", p):gsub("0+$", ""):gsub("%.$", "")) .. "%"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure game rules (no Roblox types) so they can be unit tested with the Luau CLI.
-- Callers pass in the bits of Config they need.

local Rules = {}

export type PoolEntry = { Hunter: string, Weight: number }

-- Weight of an entry after the luck boost: rarities whose order >= luckFrom get luckMul.
local function weightOf(e: PoolEntry, rarityOrder: (string) -> number, luckMul: number, luckFrom: number): number
	if rarityOrder(e.Hunter) >= luckFrom then
		return e.Weight * luckMul
	end
	return e.Weight
end

-- Chance (0..1) of each hunter in a crate.
function Rules.Odds(pool: { PoolEntry }, rarityOrder: (string) -> number, luckMul: number, luckFrom: number): { [string]: number }
	local total = 0
	for _, e in pool do
		total += weightOf(e, rarityOrder, luckMul, luckFrom)
	end
	local out = {}
	for _, e in pool do
		out[e.Hunter] = if total > 0 then weightOf(e, rarityOrder, luckMul, luckFrom) / total else 0
	end
	return out
end

-- r in [0, 1). Returns the rolled hunter id.
function Rules.Roll(pool: { PoolEntry }, rarityOrder: (string) -> number, luckMul: number, luckFrom: number, r: number): string
	local total = 0
	for _, e in pool do
		total += weightOf(e, rarityOrder, luckMul, luckFrom)
	end
	local pick = r * total
	for _, e in pool do
		pick -= weightOf(e, rarityOrder, luckMul, luckFrom)
		if pick < 0 then
			return e.Hunter
		end
	end
	return pool[#pool].Hunter
end

export type OwnedHunter = { Id: string, Locked: boolean?, T: number? }

-- Sum of Capture Power of the equipped hunters (unknown / missing uids are ignored).
function Rules.CrewPower(equipped: { string }, owned: { [string]: OwnedHunter }, powerOf: (string) -> number): number
	local sum = 0
	for _, uid in equipped do
		local h = owned[uid]
		if h then
			sum += powerOf(h.Id)
		end
	end
	return sum
end

-- Sorts uids strongest first (ties: rarity order, then uid for stability).
function Rules.SortByPower(owned: { [string]: OwnedHunter }, powerOf: (string) -> number, rarityOrder: (string) -> number): { string }
	local uids = {}
	for uid in owned do
		table.insert(uids, uid)
	end
	table.sort(uids, function(a, b)
		local pa, pb = powerOf(owned[a].Id), powerOf(owned[b].Id)
		if pa ~= pb then
			return pa > pb
		end
		local ra, rb = rarityOrder(owned[a].Id), rarityOrder(owned[b].Id)
		if ra ~= rb then
			return ra > rb
		end
		local na, nb = tonumber(a), tonumber(b)
		if na and nb then
			return na < nb
		end
		return a < b
	end)
	return uids
end

function Rules.EquipBest(owned: { [string]: OwnedHunter }, powerOf: (string) -> number, rarityOrder: (string) -> number, slots: number): { string }
	local sorted = Rules.SortByPower(owned, powerOf, rarityOrder)
	local out = {}
	for i = 1, math.min(slots, #sorted) do
		out[i] = sorted[i]
	end
	return out
end

-- Upgrades: level is 1-based. Returns nil when maxed.
function Rules.UpgradeCost(costs: { number }, level: number): number?
	return costs[level]
end

function Rules.UpgradeValue(levels: { number }, level: number): number
	return levels[math.clamp(level, 1, #levels)]
end

export type DailyInfo = { CanClaim: boolean, Day: number, Wait: number, StreakBroken: boolean }

-- Which day (1..days) the next claim gives, and whether it is claimable now.
-- last = os.time of last claim (0 = never), streak = consecutive days already claimed.
function Rules.Daily(now: number, last: number, streak: number, cooldown: number, resetAfter: number, days: number): DailyInfo
	if last <= 0 then
		return { CanClaim = true, Day = 1, Wait = 0, StreakBroken = false }
	end
	local elapsed = now - last
	if elapsed < 0 then
		-- server clock went backwards; treat as "just claimed"
		return { CanClaim = false, Day = (streak % days) + 1, Wait = cooldown, StreakBroken = false }
	end
	if elapsed >= resetAfter then
		return { CanClaim = true, Day = 1, Wait = 0, StreakBroken = streak > 0 }
	end
	local day = (streak % days) + 1
	if elapsed >= cooldown then
		return { CanClaim = true, Day = day, Wait = 0, StreakBroken = false }
	end
	return { CanClaim = false, Day = day, Wait = cooldown - elapsed, StreakBroken = false }
end

-- Splits an integer total into n positive integer parts (n is reduced if total < n).
function Rules.Split(total: number, n: number): { number }
	total = math.max(0, math.floor(total))
	if total == 0 then
		return {}
	end
	n = math.clamp(math.floor(n), 1, total)
	local base = total // n
	local extra = total - base * n
	local out = table.create(n, base)
	for i = 1, extra do
		out[i] += 1
	end
	return out
end

-- Event reward multiplier for a participant: share of damage scaled by participant count.
function Rules.EventShare(damage: number, totalDamage: number, participants: number, minShare: number, maxShare: number): number
	if totalDamage <= 0 or participants <= 0 then
		return minShare
	end
	return math.clamp((damage / totalDamage) * participants, minShare, maxShare)
end

-- Ectoplasm multiplier from upgrades and boosts.
function Rules.EctoMultiplier(bonus: number, boostActive: boolean, boostMul: number, passMul: number): number
	return (1 + bonus) * (if boostActive then boostMul else 1) * passMul
end

-- Simple sliding-window rate limiter keyed by string.
export type Limiter = { hits: { [string]: { number } }, count: number, window: number }

function Rules.NewLimiter(count: number, window: number): Limiter
	return { hits = {}, count = count, window = window }
end

function Rules.Allow(l: Limiter, key: string, now: number): boolean
	local list = l.hits[key]
	if not list then
		list = {}
		l.hits[key] = list
	end
	local i = 1
	while i <= #list do
		if now - list[i] >= l.window then
			table.remove(list, i)
		else
			i += 1
		end
	end
	if #list >= l.count then
		return false
	end
	table.insert(list, now)
	return true
end

function Rules.Forget(l: Limiter, prefix: string)
	for key in l.hits do
		if string.sub(key, 1, #prefix) == prefix then
			l.hits[key] = nil
		end
	end
end

-- Zone index (1-based order) for a Z coordinate given ordered {MinZ, MaxZ} pairs.
function Rules.ZoneIndexAt(z: number, ranges: { { number } }): number
	for i, r in ranges do
		if z >= r[1] and z < r[2] then
			return i
		end
	end
	if #ranges > 0 and z >= ranges[#ranges][2] then
		return #ranges
	end
	return 1
end

return Rules
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote registry. The server creates every remote in Init(); clients wait for them.
-- Client → server: SelectTarget (RemoteEvent), Request (RemoteFunction, action dispatcher).
-- Server → client: Sync (profile snapshot), Ecto (currency only), Drops (orbs spawned),
-- Collect (orbs picked up), Fx (effects/announcements, see Fx kinds in docs/ARCHITECTURE.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = { "SelectTarget", "Sync", "Ecto", "Drops", "Collect", "Fx" }
local FUNCTIONS = { "Request" }
local FOLDER = "GHRemotes"

function Net.Init()
	assert(RunService:IsServer(), "Net.Init is server-only")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER) or Instance.new("Folder")
	folder.Name = FOLDER
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
end

local function folder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER)
end

function Net.Event(name: string): RemoteEvent
	return folder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return folder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Rigs</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">CrateRig</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter crates: chunky treasure chests built from plain Parts (no asset IDs).
--
--   CrateRig.Build(crateId) -> CrateRig
--
-- Size at scale 1: 5 wide (X), 3.6 tall (Y), 3.6 deep (Z); the front faces -Z.
-- `Base` (anchored, PrimaryPart) is the crate body; its PivotOffset puts the model pivot at the
-- bottom centre, so Model:PivotTo(CFrame.new(groundPoint)) sits the crate on the ground.
-- Animation hooks (all via Motor6D.Transform):
--   Motors.Lid   hinge on the back top edge; Transform = CFrame.Angles(a, 0, 0) with a > 0 opens it
--                (about math.rad(110) is fully open).
--   Motors.LockL / Motors.LockR  front padlocks; e.g. Transform = CFrame.new(0, 1.5, -1) * CFrame.Angles(...)
--                pops them off.
-- `Glow` is a neon slab inside the crate (Transparency 1 by default; fade it in on open).
-- `Burst` is an Attachment on Base at the interior top, for particle bursts.
-- Trim bands are solid (SmoothPlastic, vivid trim colour); the only visible Neon is the thin
-- lip under the lid, like magic light leaking from the seam.

local Config = require(script.Parent.Parent.Config)
local U = require(script.Parent.RigUtil)

local CrateRig = {}

export type CrateRig = {
	Model: Model,
	Base: BasePart,
	Motors: { Lid: Motor6D, LockL: Motor6D, LockR: Motor6D },
	Glow: BasePart,
	Burst: Attachment,
}

local W, D = 5, 3.6
local BODY_H = 2.3
local LID_H = 0.75
local LID_TOP_H = 0.55
local BAND_X = 1.75

local WHITE = Color3.fromRGB(240, 242, 255)
local EYE = Color3.fromRGB(25, 15, 40)
local LOCK = Color3.fromRGB(255, 205, 60)
local METAL = Color3.fromRGB(150, 155, 170)

local NEON = { Material = Enum.Material.Neon }

function CrateRig.Build(crateId: string): CrateRig
	local def = Config.Crates[crateId]
	assert(def, "CrateRig: unknown crate " .. tostring(crateId))
	local color = def.Color
	local trim = def.Trim
	local band = U.Vivid(trim) -- solid trim bands
	local bandOpts: U.Opts = { Shadow = false }

	local model = Instance.new("Model")
	model.Name = crateId

	------------------------------------------------------------------ body
	local baseCf = CFrame.new(0, BODY_H / 2, 0)
	local base = U.Block(Vector3.new(W, BODY_H, D), baseCf, color, model, { Name = "Base", Shadow = true })
	base.Anchored = true
	base.Massless = false
	base.PivotOffset = CFrame.new(0, -BODY_H / 2, 0)
	model.PrimaryPart = base

	local function onBase(p: BasePart): BasePart
		U.Weld(base, p)
		return p
	end

	onBase(U.Block(Vector3.new(W + 0.25, 0.35, D + 0.25), CFrame.new(0, 0.175, 0), U.Shade(color, 0.6), model)) -- plinth
	for _, s in { -1, 1 } do
		onBase(U.Block(Vector3.new(0.5, 2.0, D + 0.12), CFrame.new(BAND_X * s, 1.35, 0), band, model, bandOpts))
	end

	-- cute ghost emblem on the front
	local emblem = Vector3.new(0, 1.3, -D / 2)
	onBase(U.Ball(1.25, CFrame.new(emblem), WHITE, model))
	for _, s in { -1, 1 } do
		onBase(U.Ball(0.3, CFrame.new(emblem + Vector3.new(0.22 * s, 0.1, -0.52)), EYE, model))
	end
	onBase(U.Cyl(0.08, 0.22, CFrame.new(emblem + Vector3.new(0, -0.17, -0.62)) * U.AxisZ, EYE, model))

	-- interior glow (hidden until the reveal fades it in)
	local glow = onBase(U.Block(Vector3.new(W - 0.6, 0.3, D - 0.6), CFrame.new(0, BODY_H - 0.15, 0), trim, model, { Material = Enum.Material.Neon, Transparency = 1, Name = "Glow" }))

	local burst = U.AttachAt(base, "Burst", CFrame.new(0, BODY_H, 0))

	------------------------------------------------------------------ lid (hinged at the back top edge)
	local lidY = BODY_H + LID_H / 2
	local lid = U.Block(Vector3.new(W + 0.1, LID_H, D + 0.1), CFrame.new(0, lidY, 0), color, model, { Name = "Lid", Shadow = true })
	local hinge = Vector3.new(0, BODY_H, (D + 0.1) / 2)
	local lidMotor = U.Motor("Lid", base, lid, baseCf:ToObjectSpace(CFrame.new(hinge)), lid.CFrame:ToObjectSpace(CFrame.new(hinge)))

	local function onLid(p: BasePart): BasePart
		U.Weld(lid, p)
		return p
	end
	local topY = BODY_H + LID_H + LID_TOP_H / 2
	local topDepth = D - 1.2
	onLid(U.Block(Vector3.new(W + 0.1, LID_TOP_H, topDepth), CFrame.new(0, topY, 0), color, model))
	local bevel = Vector3.new(W + 0.1, LID_TOP_H, ((D + 0.1) - topDepth) / 2)
	onLid(U.Wedge(bevel, CFrame.new(0, topY, -(topDepth + bevel.Z) / 2), color, model)) -- front bevel
	onLid(U.Wedge(bevel, CFrame.new(0, topY, (topDepth + bevel.Z) / 2) * CFrame.Angles(0, math.pi, 0), color, model)) -- back bevel
	for _, s in { -1, 1 } do
		onLid(U.Block(Vector3.new(0.5, LID_H + 0.04, D + 0.16), CFrame.new(BAND_X * s, lidY, 0), band, model, bandOpts))
		onLid(U.Block(Vector3.new(0.5, LID_TOP_H + 0.04, topDepth + 0.04), CFrame.new(BAND_X * s, topY, 0), band, model, bandOpts))
	end
	onLid(U.Block(Vector3.new(W + 0.15, 0.18, 0.16), CFrame.new(0, BODY_H + 0.09, -(D + 0.1) / 2 - 0.04), trim, model, NEON)) -- front lip (glowing seam)

	------------------------------------------------------------------ padlocks
	local lockMotors: { [number]: Motor6D } = {}
	for _, s in { -1, 1 } do
		local pos = Vector3.new(BAND_X * s, BODY_H - 0.15, -D / 2 - 0.2)
		local body = U.Block(Vector3.new(0.7, 0.75, 0.35), CFrame.new(pos), LOCK, model, { Name = if s < 0 then "LockL" else "LockR", Material = Enum.Material.Metal })
		lockMotors[s] = U.Motor(if s < 0 then "LockL" else "LockR", base, body, baseCf:ToObjectSpace(CFrame.new(pos)), CFrame.identity)
		local shackle = U.Cyl(0.1, 0.55, CFrame.new(pos + Vector3.new(0, 0.4, 0.02)) * U.AxisZ, METAL, model, { Material = Enum.Material.Metal })
		U.Weld(body, shackle)
		local hole = U.Block(Vector3.new(0.12, 0.22, 0.06), CFrame.new(pos + Vector3.new(0, -0.08, -0.18)), EYE, model)
		U.Weld(body, hole)
	end

	------------------------------------------------------------------ style decorations
	-- Same chest for every crate; later styles add more hardware. Body pieces are welded to
	-- Base, lid pieces to Lid (so they swing open with it).
	local style = def.Style
	local lidTop = BODY_H + LID_H + LID_TOP_H
	local frontZ = -D / 2
	local lidFrontZ = -(D + 0.1) / 2
	local metal: U.Opts = { Material = Enum.Material.Metal }
	local function bBlock(size: Vector3, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onBase(U.Block(size, cf, c, model, opts))
	end
	local function bBall(d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onBase(U.Ball(d, cf, c, model, opts))
	end
	local function bCyl(len: number, d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onBase(U.Cyl(len, d, cf, c, model, opts))
	end
	local function lBlock(size: Vector3, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onLid(U.Block(size, cf, c, model, opts))
	end
	local function lBall(d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onLid(U.Ball(d, cf, c, model, opts))
	end
	local function lCyl(len: number, d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onLid(U.Cyl(len, d, cf, c, model, opts))
	end
	local function lWedge(size: Vector3, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return onLid(U.Wedge(size, cf, c, model, opts))
	end

	if style == "Haunted" then
		-- stitched trim bands
		for _, s in { -1, 1 } do
			for _, y in { 0.7, 1.15, 1.6 } do
				bBlock(Vector3.new(0.6, 0.08, 0.06), CFrame.new(BAND_X * s, y, frontZ - 0.1) * CFrame.Angles(0, 0, 0.5), EYE)
			end
		end
		-- two little ghost wisps sitting on the lid
		for _, s in { -1, 1 } do
			local p = Vector3.new(2.1 * s, lidTop + 0.38, 0.4)
			lBall(0.8, CFrame.new(p), WHITE, { Transparency = 0.15 })
			lBall(0.45, CFrame.new(p + Vector3.new(0.25 * s, -0.25, 0.4)), WHITE, { Transparency = 0.15 })
			for _, e in { -1, 1 } do
				lBall(0.14, CFrame.new(p + Vector3.new(0.13 * e, 0.06, -0.36)), EYE)
			end
		end
	elseif style == "Elite" then
		-- metal corner caps on body and lid, rivets on the bands and a front strap
		local capC = Color3.fromRGB(190, 195, 215)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				bBlock(Vector3.new(0.6, 0.6, 0.6), CFrame.new(sx * W / 2, 0.55, sz * D / 2), capC, metal)
				bBlock(Vector3.new(0.6, 0.6, 0.6), CFrame.new(sx * W / 2, BODY_H - 0.3, sz * D / 2), capC, metal)
				lBlock(Vector3.new(0.6, 0.6, 0.6), CFrame.new(sx * (W / 2 + 0.03), BODY_H + 0.38, sz * (D / 2 + 0.03)), capC, metal)
			end
		end
		for _, s in { -1, 1 } do
			for _, y in { 0.6, 1.0, 1.4 } do
				bBall(0.18, CFrame.new(BAND_X * s, y, frontZ - 0.08), capC, metal)
			end
			lBall(0.18, CFrame.new(BAND_X * s, BODY_H + 0.38, lidFrontZ - 0.06), capC, metal)
		end
		bBlock(Vector3.new(W - 1.0, 0.2, 0.1), CFrame.new(0, 0.5, frontZ - 0.03), capC, metal)
	elseif style == "Carnival" then
		-- cream circus stripes on body and lid
		local cream = Color3.fromRGB(255, 240, 215)
		for _, x in { -2.2, -0.75, 0.75, 2.2 } do
			bBlock(Vector3.new(0.5, BODY_H - 0.4, D + 0.04), CFrame.new(x, 0.35 + (BODY_H - 0.4) / 2, 0), cream)
			lBlock(Vector3.new(0.5, LID_H + 0.02, D + 0.14), CFrame.new(x, BODY_H + LID_H / 2, 0), cream)
		end
		for _, z in { -0.75, 0.75 } do
			bBlock(Vector3.new(W + 0.04, BODY_H - 0.4, 0.5), CFrame.new(0, 0.35 + (BODY_H - 0.4) / 2, z), cream)
		end
		-- gold star standing on the lid
		local sp = CFrame.new(0, lidTop + 0.5, -0.1)
		lBlock(Vector3.new(0.85, 0.85, 0.16), sp, LOCK, metal)
		lBlock(Vector3.new(0.85, 0.85, 0.16), sp * CFrame.Angles(0, 0, math.pi / 4), LOCK, metal)
		lBall(0.4, sp * CFrame.new(0, 0, -0.1), Color3.fromRGB(235, 55, 70))
		-- marquee bulbs along the lid front
		for i = -2, 2 do
			lBall(0.22, CFrame.new(i * 0.6, BODY_H + 0.42, lidFrontZ - 0.05), cream)
		end
	elseif style == "Medical" then
		local red = Color3.fromRGB(230, 50, 60)
		bBlock(Vector3.new(W + 0.04, 0.3, D + 0.04), CFrame.new(0, 0.7, 0), band, bandOpts) -- blue stripe
		for _, s in { -1, 1 } do
			-- red crosses on the sides
			bBlock(Vector3.new(0.06, 0.9, 0.3), CFrame.new(s * (W / 2 + 0.03), 1.45, 0), red)
			bBlock(Vector3.new(0.06, 0.3, 0.9), CFrame.new(s * (W / 2 + 0.03), 1.45, 0), red)
			-- front latches (lower half on the body, upper half on the lid)
			bBlock(Vector3.new(0.32, 0.42, 0.12), CFrame.new(0.85 * s, 2.0, frontZ - 0.06), METAL, metal)
			lBlock(Vector3.new(0.4, 0.16, 0.14), CFrame.new(0.85 * s, BODY_H + 0.26, lidFrontZ - 0.07), METAL, metal)
		end
		-- cross plaque standing on the lid
		local pp = CFrame.new(0, lidTop + 0.55, -0.1)
		lCyl(0.16, 1.25, pp * U.AxisZ, WHITE)
		lBlock(Vector3.new(0.75, 0.25, 0.08), pp * CFrame.new(0, 0, -0.1), red)
		lBlock(Vector3.new(0.25, 0.75, 0.08), pp * CFrame.new(0, 0, -0.1), red)
	elseif style == "Sailor" then
		-- rope trim round the top of the body
		local rope = Color3.fromRGB(225, 195, 140)
		local ropeOpts: U.Opts = { Material = Enum.Material.Fabric }
		for _, s in { -1, 1 } do
			bCyl(W + 0.1, 0.2, CFrame.new(0, BODY_H - 0.12, s * (D / 2 + 0.06)), rope, ropeOpts)
			bCyl(D + 0.1, 0.2, CFrame.new(s * (W / 2 + 0.06), BODY_H - 0.12, 0) * U.AxisZ, rope, ropeOpts)
		end
		-- plank seams
		local seam = U.Shade(color, 0.6)
		for _, y in { 0.9, 1.45 } do
			bBlock(Vector3.new(W + 0.02, 0.06, D + 0.02), CFrame.new(0, y, 0), seam)
		end
		lBlock(Vector3.new(W + 0.12, 0.05, D + 0.12), CFrame.new(0, BODY_H + 0.38, 0), seam)
		-- gold anchor standing on the lid
		local ac = CFrame.new(0, lidTop + 0.65, -0.1)
		lBlock(Vector3.new(0.16, 1.1, 0.14), ac, LOCK, metal)
		lCyl(0.12, 0.38, ac * CFrame.new(0, 0.66, 0) * U.AxisZ, LOCK, metal)
		lBlock(Vector3.new(0.7, 0.13, 0.13), ac * CFrame.new(0, 0.3, 0), LOCK, metal)
		lBlock(Vector3.new(0.95, 0.14, 0.14), ac * CFrame.new(0, -0.5, 0), LOCK, metal)
		for _, s in { -1, 1 } do
			lBlock(Vector3.new(0.14, 0.38, 0.14), ac * CFrame.new(0.48 * s, -0.38, 0) * CFrame.Angles(0, 0, -0.45 * s), LOCK, metal)
		end
	elseif style == "Royal" then
		-- gold crown on a velvet cushion on the lid
		local ccf = CFrame.new(0, lidTop + 0.25, -0.05)
		lCyl(0.5, 1.5, ccf * U.AxisY, LOCK, metal)
		lBall(1.25, ccf * CFrame.new(0, 0.2, 0), Color3.fromRGB(200, 40, 70))
		for i = 0, 4 do
			local a = CFrame.Angles(0, i * 2 * math.pi / 5, 0)
			lWedge(Vector3.new(0.34, 0.5, 0.28), ccf * a * CFrame.new(0, 0.48, -0.62), LOCK, metal)
			lBall(0.18, ccf * a * CFrame.new(0, 0.76, -0.5), WHITE)
		end
		-- jewel on the lid front
		local gp = CFrame.new(0, BODY_H + 0.42, lidFrontZ - 0.05)
		lCyl(0.12, 0.6, gp * U.AxisZ, LOCK, metal)
		lBlock(Vector3.new(0.36, 0.36, 0.12), gp * CFrame.new(0, 0, -0.06) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(255, 70, 140), NEON)
		-- gold trim over the plinth
		bBlock(Vector3.new(W + 0.3, 0.1, D + 0.3), CFrame.new(0, 0.38, 0), LOCK, metal)
	elseif style == "Spirit" then
		-- containment cage: metal corner posts and bars
		local frame = Color3.fromRGB(70, 75, 95)
		local hx, hz = W / 2 + 0.05, D / 2 + 0.05
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				bCyl(BODY_H + 0.1, 0.32, CFrame.new(sx * hx, BODY_H / 2 + 0.05, sz * hz) * U.AxisY, frame, metal)
				bCyl(0.12, 0.42, CFrame.new(sx * hx, 1.2, sz * hz) * U.AxisY, trim, NEON) -- rune ring
			end
		end
		for _, y in { 0.45, BODY_H - 0.15 } do
			for _, s in { -1, 1 } do
				bCyl(W + 0.1, 0.22, CFrame.new(0, y, s * hz), frame, metal)
				bCyl(D + 0.1, 0.22, CFrame.new(s * hx, y, 0) * U.AxisZ, frame, metal)
			end
		end
		-- glowing crystal spikes on the lid
		for i = -1, 1 do
			local h = if i == 0 then 0.8 else 0.55
			local cf = CFrame.new(i * 0.9, lidTop + h / 2 - 0.05, -0.1) * CFrame.Angles(0, 0, -0.3 * i)
			lBlock(Vector3.new(0.32, h, 0.32), cf * CFrame.Angles(0, math.pi / 4, 0), band, { Reflectance = 0.25 })
			lBlock(Vector3.new(0.32, 0.32, 0.32), cf * CFrame.new(0, h / 2, 0) * U.VertexUp, trim, NEON)
		end
	end

	return {
		Model = model,
		Base = base,
		Motors = { Lid = lidMotor, LockL = lockMotors[-1], LockR = lockMotors[1] },
		Glow = glow,
		Burst = burst,
	}
end

return CrateRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">GhostRig</string>
            <string name="Source"><![CDATA[--!strict
-- Floating cute-spooky ghosts built from plain Parts (no asset IDs).
--
--   GhostRig.Build(ghostId) -> Model
--
-- PrimaryPart = "Core": an invisible, anchored, queryable Ball covering the body (tap target).
-- Every other part is unanchored, massless, non-queryable and welded to Core, so moving the
-- ghost is just Model:PivotTo(cf). Pivot = Core centre = body centre. Core holds the
-- attachments "Center", "Top" (above the head/hat, for billboards) and "Bottom" (tail tip).
-- Built at scale 1 (body diameter 3.5) and then scaled with Model:ScaleTo(def.Scale).
-- The ghost faces -Z (its LookVector).
-- The spooky glow comes from the body colour, glowing eyes/flames
-- where a style has them and the "Aura" ParticleEmitter; horns, stripes, tassels and crown
-- spikes are solid (vivid glow colour) so big ghosts don't turn into neon blobs.
-- Neon accessories are limited to small meaningful bits: glowing eyes of the spooky styles,
-- flames, gems, crystal tips, runes and cracks. Bosses get a stronger Aura than normal ghosts.

local Config = require(script.Parent.Parent.Config)
local U = require(script.Parent.RigUtil)

local GhostRig = {}

local BODY_D = 3.5
local R = BODY_D / 2
local CORE_D = 4.6

local WHITE = Color3.fromRGB(255, 255, 255)
local EYE = Color3.fromRGB(25, 15, 40)
local MOUTH = Color3.fromRGB(70, 20, 50)
local BLUSH = Color3.fromRGB(255, 150, 190)
local GOLD = Color3.fromRGB(255, 205, 60)
local METAL = Color3.fromRGB(120, 125, 145)
local WOOD = Color3.fromRGB(150, 95, 55)
local RED = Color3.fromRGB(235, 55, 70)
local CREAM = Color3.fromRGB(255, 244, 220)
local DARK = Color3.fromRGB(38, 32, 55)
local NAVY = Color3.fromRGB(40, 55, 125)
local STONE = Color3.fromRGB(150, 150, 168)
local BEARD = Color3.fromRGB(242, 242, 236)

local NEON = { Material = Enum.Material.Neon }
local METAL_MAT = { Material = Enum.Material.Metal }

-- styles whose eyes glow (Neon in the glow colour) instead of the usual dark cartoon eyes
local GLOW_EYES = { Student = true, Ancient = true, Void = true, Overlord = true }
-- styles with the open "▽" grin instead of the round "O" mouth
local GRIN = {
	Mischief = true, Hallway = true, Headmaster = true, Carnival = true, Ringmaster = true,
	Pirate = true, Captain = true, King = true, Overlord = true,
}
-- spooky styles that don't blush
local NO_BLUSH = { Giant = true, Void = true, Overlord = true }

-- point on the body sphere in direction `dir`, pushed `out` studs off the surface
local function surf(dir: Vector3, out: number): Vector3
	return dir.Unit * (R + out)
end

function GhostRig.Build(ghostId: string): Model
	local def = Config.Ghosts[ghostId]
	assert(def, "GhostRig: unknown ghost " .. tostring(ghostId))
	local style = def.Style
	local color = def.Color
	local glow = def.Glow
	local accent = U.Vivid(glow) -- solid accessories in the glow colour

	local model = Instance.new("Model")
	model.Name = ghostId

	local core = U.Ball(CORE_D, CFrame.identity, glow, model, { Transparency = 1, Name = "Core", Shadow = false })
	core.Anchored = true
	core.CanQuery = true
	core.Massless = false
	model.PrimaryPart = core

	local function add(p: BasePart): BasePart
		U.Weld(core, p)
		return p
	end
	local function ball(d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return add(U.Ball(d, cf, c, model, opts))
	end
	local function block(size: Vector3, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return add(U.Block(size, cf, c, model, opts))
	end
	local function cyl(len: number, d: number, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return add(U.Cyl(len, d, cf, c, model, opts))
	end
	local function wedge(size: Vector3, cf: CFrame, c: Color3, opts: U.Opts?): BasePart
		return add(U.Wedge(size, cf, c, model, opts))
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x, y, z)
	end
	-- "▽" open grin (a WedgePart turned to face out of the body)
	local function grin(pos: Vector3, w: number, c: Color3, opts: U.Opts?)
		wedge(Vector3.new(0.2, w, w), U.Facing(pos, pos) * CFrame.Angles(0, 0, -math.pi / 4) * U.AxisZ, c, opts)
	end
	-- straight rod between two points
	local function rod(a: Vector3, b: Vector3, d: number, c: Color3, opts: U.Opts?): BasePart
		return cyl((b - a).Magnitude, d, U.Between(a, b), c, opts)
	end
	-- band hugging the body sphere at height y (tilt rolls it around Z)
	local function ring(y: number, thick: number, c: Color3, opts: U.Opts?, tilt: number?)
		local r = math.sqrt(math.max(R * R - y * y, 0.05))
		cyl(thick, r * 2 + 0.12, CFrame.Angles(0, 0, tilt or 0) * at(0, y, 0) * U.AxisY, c, opts)
	end
	-- ruffled collar: n balls round the body at height y, alternating two colours
	local function ruff(y: number, n: number, d: number, c1: Color3, c2: Color3)
		local r = math.sqrt(R * R - y * y) + 0.05
		for i = 0, n - 1 do
			local a = (i + 0.5) * 2 * math.pi / n
			ball(d, at(math.sin(a) * r, y, -math.cos(a) * r), if i % 2 == 0 then c1 else c2)
		end
	end
	-- stepped cone standing on `base` (along its +Y); returns the frame at the tip
	local function cone(base: CFrame, d: number, h: number, tiers: number, c1: Color3, c2: Color3?): CFrame
		local th = h / tiers
		for i = 0, tiers - 1 do
			local c = if c2 and i % 2 == 1 then c2 else c1
			cyl(th * 1.05, d * (tiers - i) / tiers, base * at(0, th * (i + 0.5), 0) * U.AxisY, c)
		end
		return base * at(0, h, 0)
	end
	-- crystal: diamond prism along the frame's Y with pointed tip (and optional pointed bottom)
	local function crystal(cf: CFrame, w: number, h: number, c: Color3, opts: U.Opts?, tipC: Color3, tipOpts: U.Opts?, both: boolean)
		block(Vector3.new(w, h, w), cf * CFrame.Angles(0, math.pi / 4, 0), c, opts)
		block(Vector3.new(w, w, w), cf * at(0, h / 2, 0) * U.VertexUp, tipC, tipOpts)
		if both then
			block(Vector3.new(w, w, w), cf * at(0, -h / 2, 0) * U.VertexUp, tipC, tipOpts)
		end
	end
	-- round "O" mouth
	local function oMouth(pos: Vector3, d: number)
		cyl(0.25, d, U.DiscFacing(pos, pos), MOUTH)
	end
	-- slanted eyebrow over an eye (s = -1 left, 1 right); angry = inner end down
	local function brow(s: number, y: number, angry: boolean, c: Color3, w: number)
		local pos = surf(Vector3.new(0.6 * s, y, -1.38), 0.08)
		local tilt = if angry then 0.35 * s else -0.25 * s
		block(Vector3.new(w, 0.18, 0.2), U.Facing(pos, pos) * CFrame.Angles(0, 0, tilt), c)
	end

	-- Opaque body: see-through layered parts (body over a glowing inner core, overlapping tail
	-- balls) flicker on moving models because the engine re-sorts transparent parts every frame.
	local bodyOpts = { Shadow = false }

	------------------------------------------------------------------ body + tail
	ball(BODY_D, CFrame.identity, color, { Shadow = true })
	ball(2.7, at(0, -0.95, 0.45), color, bodyOpts)
	ball(2.0, at(0.15, -1.75, 0.95), color, bodyOpts)
	ball(1.35, at(-0.05, -2.35, 1.45), color, bodyOpts)
	ball(0.8, at(0.2, -2.7, 1.9), color, bodyOpts)

	------------------------------------------------------------------ face
	local glowEyes = GLOW_EYES[style] == true
	local eyeColor = if glowEyes then glow else EYE
	local eyeOpts: U.Opts? = if glowEyes then NEON else nil
	if style == "Crypt" then
		-- one big eye peeking out between the bandages
		local p = Vector3.new(0, 0.38, -1.45)
		ball(1.15, CFrame.new(p), EYE)
		ball(0.4, CFrame.new(p + Vector3.new(0.2, 0.22, -0.4)), WHITE)
	else
		for _, s in { -1, 1 } do
			if style == "Pirate" and s < 0 then
				continue -- the eyepatch goes here
			end
			local p = Vector3.new(0.6 * s, 0.35, -1.38)
			ball(0.9, CFrame.new(p), eyeColor, eyeOpts)
			ball(0.32, CFrame.new(p + Vector3.new(0.16, 0.18, -0.3)), WHITE)
		end
	end
	local mouthPos = surf(Vector3.new(0, -0.45, -1.65), -0.02)
	if style == "Doctor" then
		-- the surgical mask covers the mouth
	elseif style == "Void" then
		grin(mouthPos, 0.55, glow, NEON)
	elseif style == "Clown" then
		grin(mouthPos, 0.75, MOUTH)
	elseif style == "Giant" then
		grin(mouthPos, 0.85, MOUTH)
	elseif GRIN[style] then
		grin(mouthPos, if def.Kind == "Boss" then 0.6 else 0.5, MOUTH)
	else
		oMouth(mouthPos, if style == "Poltergeist" then 0.75 else 0.6)
	end
	-- nub arms
	for _, s in { -1, 1 } do
		ball(0.95, at(1.7 * s, -0.35, -0.2), color, bodyOpts)
	end
	-- blush (the Giant and the void spirits are too spooky to blush)
	if not NO_BLUSH[style] then
		for _, s in { -1, 1 } do
			ball(0.4, at(1.0 * s, -0.12, -1.45), BLUSH)
		end
	end

	------------------------------------------------------------------ styles
	if style == "Mischief" then
		for _, s in { -1, 1 } do
			wedge(Vector3.new(0.3, 0.85, 0.5), at(0.8 * s, 1.6, -0.1) * CFrame.Angles(0, 0, -0.35 * s), accent) -- devil horns
			brow(s, 0.98, false, U.Shade(color, 0.45), 0.6)
		end
		local tongue = mouthPos + Vector3.new(0.12, -0.3, -0.05)
		ball(0.42, CFrame.new(tongue), Color3.fromRGB(255, 90, 130))
		wedge(Vector3.new(0.15, 0.5, 0.45), at(0.25, -2.95, 2.25) * CFrame.Angles(-0.6, 0, 0), accent) -- spade tail tip
	elseif style == "Poltergeist" then
		-- crown of green flames
		for i = 0, 3 do
			local a = math.pi / 4 + i * math.pi / 2
			wedge(Vector3.new(0.35, 1.0, 0.6), CFrame.Angles(0, a, 0) * at(0, 1.95, -0.7) * CFrame.Angles(-0.35, 0, 0), glow, { Material = Enum.Material.Neon })
		end
		-- floating household junk
		cyl(0.12, 1.1, CFrame.Angles(0, 0.6, 0) * at(0, 0.6, -2.7) * CFrame.Angles(0.5, 0, 0.3) * U.AxisY, WHITE) -- plate
		block(Vector3.new(0.9, 1.0, 0.15), CFrame.Angles(0, 2.6, 0) * at(0, -0.2, -2.8) * CFrame.Angles(0.3, 0, 0.4), WOOD) -- chair back
		block(Vector3.new(0.75, 0.25, 0.95), CFrame.Angles(0, 4.4, 0) * at(0, 0.9, -2.7) * CFrame.Angles(0.2, 0.5, -0.3), Color3.fromRGB(230, 80, 90)) -- book
	elseif style == "Grave" then
		local t = at(0.3, 1.62, 0.1) * CFrame.Angles(0, 0, -0.18)
		local stone = Color3.fromRGB(150, 150, 168)
		block(Vector3.new(1.0, 0.9, 0.32), t * at(0, 0.45, 0), stone)
		cyl(0.32, 1.0, t * at(0, 0.9, 0) * U.AxisZ, stone)
		local moss = Color3.fromRGB(90, 190, 90)
		ball(0.45, t * at(-0.38, 0.12, -0.1), moss)
		ball(0.7, at(-0.85, 1.35, 0.3), moss)
	elseif style == "Crypt" then
		local wrap = U.Shade(color, 0.85)
		local function band(tilt: number, offset: number, center: Vector3, radius: number)
			cyl(0.3, radius * 2 + 0.12, CFrame.new(center) * CFrame.Angles(0, 0, tilt) * at(0, offset, 0) * U.AxisY, wrap)
		end
		band(0.2, 1.15, Vector3.zero, math.sqrt(R * R - 1.15 * 1.15))
		band(-0.12, -1.05, Vector3.new(0, 0, 0.2), 1.55)
		band(0.15, 0, Vector3.new(-0.05, -2.35, 1.45), 0.68)
		ball(0.42, CFrame.new(surf(Vector3.new(0, -1.25, -1.2), 0.02)), glow, NEON) -- amber amulet
	elseif style == "Warden" then
		local hood = Color3.fromRGB(70, 50, 120)
		ball(3.1, at(0, 0.6, 0.45), hood)
		wedge(Vector3.new(0.6, 1.1, 1.0), at(0, 2.05, 0.95) * CFrame.Angles(-0.4, 0, 0), hood)
		-- lantern hanging from the right nub
		cyl(0.2, 0.7, at(1.95, -0.75, -0.45) * U.AxisY, METAL, { Material = Enum.Material.Metal })
		block(Vector3.new(0.65, 0.75, 0.65), at(1.95, -1.25, -0.45), Color3.fromRGB(210, 220, 230))
		ball(0.8, at(1.95, -1.25, -0.45), glow, NEON) -- flame (no PointLight: moving lights flicker)
		-- chain + weight from the left nub
		cyl(0.12, 0.45, at(-1.85, -0.78, -0.25), METAL, { Material = Enum.Material.Metal })
		cyl(0.12, 0.45, at(-1.88, -1.12, -0.25) * U.AxisZ, METAL, { Material = Enum.Material.Metal })
		cyl(0.12, 0.45, at(-1.91, -1.46, -0.25), METAL, { Material = Enum.Material.Metal })
		ball(0.65, at(-1.93, -1.9, -0.25), Color3.fromRGB(60, 60, 75), { Material = Enum.Material.Metal })
	elseif style == "Hallway" then
		local frame = Color3.fromRGB(230, 60, 70)
		for _, s in { -1, 1 } do
			local eye = Vector3.new(0.6 * s, 0.35, -1.38)
			cyl(0.08, 1.15, U.DiscFacing(surf(eye, 0.07), eye), frame)
		end
		block(Vector3.new(0.35, 0.09, 0.09), CFrame.new(0, 0.42, -1.78), frame)
		-- lanyard cord + hall pass
		local cordY = -0.85
		cyl(0.1, 2 * math.sqrt(R * R - cordY * cordY) + 0.08, at(0, cordY, 0) * U.AxisY, Color3.fromRGB(60, 120, 255))
		local passPos = surf(Vector3.new(0, -1.2, -1.3), 0.04)
		local f = U.Facing(passPos, passPos)
		block(Vector3.new(0.75, 0.95, 0.08), f, Color3.fromRGB(250, 250, 240))
		block(Vector3.new(0.75, 0.28, 0.1), f * at(0, 0.3, 0), accent)
	elseif style == "Student" then
		local capColor = Color3.fromRGB(60, 90, 200)
		ball(2.5, at(0, 1.15, 0.2), capColor)
		cyl(0.12, 1.7, at(0, 1.5, -1.35) * CFrame.Angles(-0.1, 0, 0) * U.AxisY, U.Shade(capColor, 0.8))
		local bag = Color3.fromRGB(230, 80, 80)
		block(Vector3.new(1.7, 1.8, 0.8), at(0, -0.1, 1.65), bag)
		block(Vector3.new(1.2, 0.7, 0.3), at(0, -0.5, 2.1), U.Shade(bag, 0.8))
		local bookCf = at(-1.95, -0.35, -0.5) * CFrame.Angles(0, 0.3, 0.15)
		block(Vector3.new(0.32, 1.1, 0.85), bookCf, Color3.fromRGB(90, 200, 120))
		block(Vector3.new(0.26, 1.0, 0.85), bookCf * at(0, 0, -0.04), WHITE)
	elseif style == "Headmaster" then
		local dark = Color3.fromRGB(35, 30, 50)
		cyl(0.5, 2.2, at(0, 1.65, 0.1) * U.AxisY, dark)
		block(Vector3.new(2.9, 0.15, 2.9), at(0, 1.95, 0.1) * CFrame.Angles(0, math.pi / 4, 0), dark)
		block(Vector3.new(0.12, 0.8, 0.12), at(1.98, 1.55, 0.1), accent) -- tassel
		-- monocle on the right eye + its chain
		local eye = Vector3.new(0.6, 0.35, -1.38)
		cyl(0.08, 1.2, U.DiscFacing(surf(eye, 0.08), eye), GOLD, { Material = Enum.Material.Metal })
		block(Vector3.new(0.06, 0.9, 0.06), CFrame.new(surf(Vector3.new(1.0, -0.2, -1.4), 0.06)) * CFrame.Angles(0, 0, 0.25), GOLD)
		-- handlebar mustache
		for _, s in { -1, 1 } do
			local pos = surf(Vector3.new(0.35 * s, -0.18, -1.65), 0.04)
			wedge(Vector3.new(0.18, 0.35, 0.7), U.Facing(pos, pos) * CFrame.Angles(0, 0, 0.15 * s) * CFrame.Angles(0, math.pi / 2 * s, 0), Color3.fromRGB(70, 55, 80))
		end
		-- pointer stick from the right nub
		local hand = Vector3.new(1.75, -0.35, -0.2)
		local dir = Vector3.new(0.35, 0.75, -0.55).Unit
		local mid = hand + dir * 1.3
		cyl(3.2, 0.14, CFrame.lookAt(mid, mid + dir) * U.AxisZ, WOOD)
		ball(0.3, CFrame.new(hand + dir * 2.95), glow, NEON)
	elseif style == "Giant" then
		-- crown
		cyl(0.6, 1.9, at(0, 1.75, 0.05) * U.AxisY, GOLD, { Material = Enum.Material.Metal })
		for i = 0, 2 do
			wedge(Vector3.new(0.3, 0.75, 0.45), CFrame.Angles(0, i * math.pi * 2 / 3, 0) * at(0, 2.4, -0.78), accent)
		end
		for _, s in { -1, 1 } do
			brow(s, 1.0, true, Color3.fromRGB(60, 20, 60), 0.85)
		end
		-- sharp teeth hanging from the top of the grin
		for _, s in { -1, 1 } do
			local pos = surf(Vector3.new(0.18 * s, -0.42, -1.7), 0.08)
			wedge(Vector3.new(0.08, 0.22, 0.22), U.Facing(pos, pos) * CFrame.Angles(0, 0, -math.pi / 4) * U.AxisZ, WHITE)
		end
		-- orbiting junk
		cyl(0.12, 1.2, CFrame.Angles(0, 0.4, 0) * at(0, 0.5, -3.0) * CFrame.Angles(0.6, 0, 0.2) * U.AxisY, WHITE)
		block(Vector3.new(0.9, 1.0, 0.15), CFrame.Angles(0, 2.0, 0) * at(0, -0.3, -3.0) * CFrame.Angles(0.3, 0, 0.5), WOOD)
		block(Vector3.new(0.75, 0.25, 0.95), CFrame.Angles(0, 3.4, 0) * at(0, 0.9, -3.0) * CFrame.Angles(0.2, 0.5, -0.3), Color3.fromRGB(90, 130, 255))
	elseif style == "Carnival" then
		-- striped party hat with a pompom
		local tip = cone(at(0.3, 1.4, 0.1) * CFrame.Angles(0, 0, -0.28), 1.35, 1.55, 4, accent, CREAM)
		ball(0.5, tip, Color3.fromRGB(255, 110, 190))
		-- balloon on a string from the left nub
		local hand = Vector3.new(-1.95, -0.35, -0.25)
		local knot = Vector3.new(-2.45, 1.45, 0.05)
		rod(hand, knot, 0.06, WHITE)
		ball(0.22, CFrame.new(knot), RED)
		local bc = knot + Vector3.new(-0.08, 0.68, 0)
		ball(1.2, CFrame.new(bc), RED)
		ball(0.28, CFrame.new(bc + Vector3.new(0.2, 0.25, -0.45)), WHITE) -- shine
	elseif style == "Clown" then
		ball(0.62, CFrame.new(surf(Vector3.new(0, -0.02, -1), 0.14)), RED, { Reflectance = 0.1 }) -- round nose
		local tuft = Color3.fromRGB(255, 140, 40)
		for _, s in { -1, 1 } do
			ball(0.95, at(1.35 * s, 0.95, 0.35), accent)
			ball(0.8, at(1.62 * s, 0.4, 0.5), tuft)
			ball(0.7, at(1.05 * s, 1.4, 0.6), tuft)
		end
		ruff(-1.05, 10, 0.6, accent, GOLD)
	elseif style == "Ringmaster" then
		-- tall top hat
		local hatC = Color3.fromRGB(40, 30, 55)
		local hcf = at(0, 1.5, 0.1) * CFrame.Angles(-0.08, 0, 0.08)
		cyl(0.16, 2.7, hcf * U.AxisY, hatC) -- brim
		cyl(1.5, 1.75, hcf * at(0, 0.8, 0) * U.AxisY, hatC)
		cyl(0.36, 1.8, hcf * at(0, 0.28, 0) * U.AxisY, GOLD, METAL_MAT) -- band
		ball(0.42, hcf * at(0, 0.3, -0.86), RED) -- rosette
		-- red tailcoat flaps behind
		local coat = Color3.fromRGB(140, 25, 45)
		for _, s in { -1, 1 } do
			block(Vector3.new(0.7, 1.7, 0.18), at(0.5 * s, -1.6, 2.02) * CFrame.Angles(-0.3, 0, 0.12 * s), coat)
		end
		ball(0.28, CFrame.new(surf(Vector3.new(0, -1.4, -1.05), 0.02)), GOLD, METAL_MAT) -- coat button
		-- bow tie
		local bp = surf(Vector3.new(0, -0.95, -1.45), 0.06)
		local bf = U.Facing(bp, bp)
		for _, s in { -1, 1 } do
			wedge(Vector3.new(0.12, 0.38, 0.32), bf * at(0.17 * s, 0, 0) * CFrame.Angles(0, math.pi / 2 * s, 0), DARK)
		end
		ball(0.2, bf, DARK)
		-- curly mustache + raised brows
		local stache = Color3.fromRGB(55, 30, 40)
		for _, s in { -1, 1 } do
			local pos = surf(Vector3.new(0.36 * s, -0.2, -1.65), 0.05)
			wedge(Vector3.new(0.18, 0.32, 0.65), U.Facing(pos, pos) * CFrame.Angles(0, 0, 0.15 * s) * CFrame.Angles(0, math.pi / 2 * s, 0), stache)
			ball(0.3, CFrame.new(surf(Vector3.new(0.75 * s, -0.05, -1.5), 0.08)), stache) -- curl
			brow(s, 0.98, false, stache, 0.6)
		end
		-- ringmaster's baton in the right nub
		local hand = Vector3.new(1.75, -0.35, -0.2)
		local dir = Vector3.new(0.35, 0.65, -0.65).Unit
		rod(hand - dir * 0.2, hand + dir * 2.0, 0.16, DARK)
		ball(0.3, CFrame.new(hand + dir * 2.05), GOLD, METAL_MAT)
		ball(0.26, CFrame.new(hand - dir * 0.25), GOLD, METAL_MAT)
	elseif style == "Patient" then
		-- bandage wrapped round the head, knotted at the side
		local wrap = Color3.fromRGB(250, 248, 240)
		ring(1.12, 0.4, wrap, nil, 0.15)
		ball(0.45, at(1.3, 1.32, 0.1), wrap)
		block(Vector3.new(0.2, 0.5, 0.08), at(1.55, 1.05, 0.05) * CFrame.Angles(0, 0, 0.5), wrap)
		block(Vector3.new(0.2, 0.45, 0.08), at(1.5, 1.02, 0.3) * CFrame.Angles(0, 0, 0.2), wrap)
		-- hospital wristband on the left nub
		cyl(0.22, 0.86, at(-1.98, -0.38, -0.2), WHITE)
		block(Vector3.new(0.24, 0.1, 0.3), at(-1.98, 0.06, -0.2), Color3.fromRGB(120, 200, 255))
		-- tiny teddy bear hugged in the right nub
		local bear = Color3.fromRGB(195, 135, 85)
		local tb = Vector3.new(2.0, -0.85, -0.7)
		ball(0.75, CFrame.new(tb), bear)
		ball(0.62, CFrame.new(tb + Vector3.new(0, 0.6, 0)), bear)
		for _, s in { -1, 1 } do
			ball(0.24, CFrame.new(tb + Vector3.new(0.24 * s, 0.88, 0.02)), bear)
			ball(0.1, CFrame.new(tb + Vector3.new(0.11 * s, 0.68, -0.28)), EYE)
		end
		ball(0.24, CFrame.new(tb + Vector3.new(0, 0.53, -0.28)), CREAM) -- snout
	elseif style == "Doctor" then
		-- head mirror on a band
		ring(1.05, 0.18, Color3.fromRGB(70, 75, 95))
		local md = Vector3.new(0.4, 1.05, -1.33)
		cyl(0.1, 0.95, U.DiscFacing(surf(md, 0.08), md), Color3.fromRGB(225, 230, 240), { Material = Enum.Material.Metal, Reflectance = 0.35 })
		cyl(0.14, 0.22, U.DiscFacing(surf(md, 0.1), md), DARK)
		-- surgical mask over the mouth
		local mp = surf(Vector3.new(0, -0.5, -1.62), -0.06)
		local mf = U.Facing(mp, mp)
		local maskC = Color3.fromRGB(150, 215, 235)
		block(Vector3.new(1.45, 0.8, 0.14), mf, maskC)
		for _, y in { 0.15, -0.12 } do
			block(Vector3.new(1.3, 0.05, 0.16), mf * at(0, y, 0), U.Shade(maskC, 0.85)) -- pleats
		end
		for _, s in { -1, 1 } do
			rod((mf * at(0.7 * s, 0.25, 0)).Position, surf(Vector3.new(1.0 * s, 0.15, -0.9), 0.03), 0.06, WHITE) -- ear loops
		end
		-- clipboard in the left nub
		local cb = at(-2.05, -0.6, -0.6) * CFrame.Angles(0.15, 0.55, 0.1)
		block(Vector3.new(0.95, 1.25, 0.1), cb, WOOD)
		block(Vector3.new(0.8, 0.95, 0.04), cb * at(0, -0.08, -0.06), WHITE)
		block(Vector3.new(0.42, 0.14, 0.1), cb * at(0, 0.58, -0.07), METAL, METAL_MAT)
		for i = 0, 1 do
			block(Vector3.new(0.55, 0.05, 0.03), cb * at(-0.05, 0.12 - i * 0.22, -0.09), accent)
		end
	elseif style == "Director" then
		-- glasses + stern brows
		local frameC = Color3.fromRGB(45, 40, 60)
		for _, s in { -1, 1 } do
			local eye = Vector3.new(0.6 * s, 0.35, -1.38)
			cyl(0.08, 1.15, U.DiscFacing(surf(eye, 0.07), eye), frameC)
			brow(s, 1.02, true, frameC, 0.55)
		end
		block(Vector3.new(0.35, 0.09, 0.09), CFrame.new(0, 0.42, -1.78), frameC)
		-- white coat: collar + lapels
		ring(-0.85, 0.26, WHITE)
		for _, s in { -1, 1 } do
			local lp = surf(Vector3.new(0.5 * s, -1.15, -1.25), 0.02)
			block(Vector3.new(0.55, 1.2, 0.12), U.Facing(lp, lp) * CFrame.Angles(0, 0, -0.4 * s), WHITE)
		end
		-- necktie
		local tieC = Color3.fromRGB(175, 35, 60)
		local tp = surf(Vector3.new(0, -0.95, -1.45), 0.06)
		block(Vector3.new(0.3, 0.26, 0.12), U.Facing(tp, tp), tieC)
		local tbp = surf(Vector3.new(0, -1.35, -1.12), 0.04)
		local tbf = U.Facing(tbp, tbp)
		block(Vector3.new(0.34, 0.7, 0.1), tbf, tieC)
		block(Vector3.new(0.25, 0.25, 0.1), tbf * at(0, -0.36, 0) * CFrame.Angles(0, 0, math.pi / 4), tieC)
		-- stethoscope round the neck
		local tube = Color3.fromRGB(60, 60, 75)
		local chest = surf(Vector3.new(0.75, -1.4, -0.85), 0.08)
		rod(surf(Vector3.new(-1.3, -0.6, -1.0), 0.04), surf(Vector3.new(-0.8, -1.35, -0.95), 0.06), 0.1, tube)
		rod(surf(Vector3.new(1.3, -0.6, -1.0), 0.04), chest, 0.1, tube)
		cyl(0.14, 0.42, U.DiscFacing(chest, chest), METAL, METAL_MAT)
		-- gold name badge
		local nb = surf(Vector3.new(-0.95, -0.85, -1.2), 0.02)
		block(Vector3.new(0.45, 0.22, 0.06), U.Facing(nb, nb), GOLD, METAL_MAT)
		-- big clipboard in the right nub
		local cb = at(2.15, -0.55, -0.6) * CFrame.Angles(0.12, -0.55, -0.1)
		block(Vector3.new(1.2, 1.6, 0.12), cb, WOOD)
		block(Vector3.new(1.02, 1.25, 0.04), cb * at(0, -0.1, -0.07), WHITE)
		block(Vector3.new(0.5, 0.16, 0.12), cb * at(0, 0.75, -0.08), GOLD, METAL_MAT)
		for i = 0, 2 do
			block(Vector3.new(0.7, 0.06, 0.03), cb * at(-0.05, 0.25 - i * 0.25, -0.1), accent)
		end
	elseif style == "Sailor" then
		-- white sailor cap with a navy stripe
		local hcf = at(0.2, 1.55, 0.1) * CFrame.Angles(0.1, 0, -0.18)
		cyl(0.6, 1.75, hcf * at(0, 0.3, 0) * U.AxisY, WHITE)
		cyl(0.28, 2.15, hcf * U.AxisY, WHITE) -- turned-up brim
		cyl(0.08, 2.19, hcf * at(0, 0.06, 0) * U.AxisY, NAVY)
		-- navy sailor collar behind, red neckerchief in front
		block(Vector3.new(1.9, 0.95, 0.12), at(0, -0.7, 1.86), NAVY)
		block(Vector3.new(1.9, 0.1, 0.14), at(0, -1.0, 1.86), WHITE)
		local np = surf(Vector3.new(0, -0.95, -1.45), 0.02)
		block(Vector3.new(0.55, 0.55, 0.08), U.Facing(np, np) * at(0, -0.22, 0) * CFrame.Angles(0, 0, math.pi / 4), RED)
		ball(0.36, CFrame.new(np + np.Unit * 0.08), RED)
		-- small anchor in the left nub
		local ac = at(-2.1, -0.85, -0.5) * CFrame.Angles(0, 0.4, 0.15)
		local anc = Color3.fromRGB(70, 85, 115)
		block(Vector3.new(0.16, 1.1, 0.14), ac, anc, METAL_MAT)
		cyl(0.12, 0.38, ac * at(0, 0.66, 0) * U.AxisZ, anc, METAL_MAT)
		block(Vector3.new(0.7, 0.13, 0.13), ac * at(0, 0.3, 0), anc, METAL_MAT)
		block(Vector3.new(0.9, 0.14, 0.14), ac * at(0, -0.5, 0), anc, METAL_MAT)
		for _, s in { -1, 1 } do
			block(Vector3.new(0.14, 0.36, 0.14), ac * at(0.45 * s, -0.38, 0) * CFrame.Angles(0, 0, -0.45 * s), anc, METAL_MAT)
		end
	elseif style == "Pirate" then
		-- polka-dot bandana knotted at the back
		local band = Color3.fromRGB(220, 50, 60)
		local bc = Vector3.new(0, 1.0, 0.2)
		ball(2.9, CFrame.new(bc), band)
		for _, d in { Vector3.new(-0.55, 0.55, -0.65), Vector3.new(0.5, 0.75, -0.45), Vector3.new(0.05, 0.95, 0.3), Vector3.new(-0.8, 0.6, 0.35) } do
			ball(0.3, CFrame.new(bc + d.Unit * 1.42), WHITE)
		end
		ball(0.5, at(0.3, 1.05, 1.6), band)
		block(Vector3.new(0.26, 0.7, 0.1), at(0.15, 0.6, 1.72) * CFrame.Angles(0.25, 0, 0.3), band)
		block(Vector3.new(0.26, 0.6, 0.1), at(0.5, 0.65, 1.68) * CFrame.Angles(0.25, 0, -0.35), band)
		-- eyepatch over the left eye (no eye is built there)
		local le = Vector3.new(-0.6, 0.35, -1.38)
		local pc = surf(le, 0.04)
		cyl(0.12, 0.85, U.DiscFacing(pc, le), DARK)
		rod(surf(Vector3.new(0.1, 1.0, -1.4), 0.03), pc, 0.07, DARK)
		rod(pc, surf(Vector3.new(-1.45, -0.1, -0.95), 0.03), 0.07, DARK)
		-- hook hand on the right nub
		local hook = Color3.fromRGB(190, 195, 210)
		cyl(0.3, 0.55, at(1.98, -0.38, -0.2), DARK) -- cuff
		local pts = {
			Vector3.new(2.1, -0.38, -0.2),
			Vector3.new(2.5, -0.38, -0.3),
			Vector3.new(2.72, -0.62, -0.35),
			Vector3.new(2.62, -0.9, -0.35),
			Vector3.new(2.38, -0.88, -0.33),
		}
		for i = 1, #pts - 1 do
			rod(pts[i], pts[i + 1], 0.12, hook, METAL_MAT)
		end
		-- gold earring
		local ep = surf(Vector3.new(1.0, -0.05, -0.2), 0.0)
		rod(ep, ep + Vector3.new(0.06, -0.2, 0), 0.06, GOLD, METAL_MAT)
		ball(0.3, CFrame.new(ep + Vector3.new(0.08, -0.32, 0)), GOLD, METAL_MAT)
	elseif style == "Captain" then
		-- big tricorn with a gold trim and a skull emblem
		local hatC = Color3.fromRGB(30, 35, 62)
		local hcf = at(0, 1.5, 0.1)
		cyl(0.9, 2.0, hcf * at(0, 0.4, 0) * U.AxisY, hatC)
		for i = 0, 2 do
			local side = hcf * CFrame.Angles(0, i * 2 * math.pi / 3, 0) * at(0, 0.3, -0.95) * CFrame.Angles(-0.45, 0, 0)
			block(Vector3.new(3.3, 0.75, 0.16), side, hatC)
			block(Vector3.new(3.3, 0.12, 0.22), side * at(0, 0.38, 0), GOLD, METAL_MAT)
		end
		local front = hcf * at(0, 0.3, -0.95) * CFrame.Angles(-0.45, 0, 0)
		ball(0.55, front * at(0, 0.02, -0.15), WHITE)
		for _, s in { -1, 1 } do
			ball(0.14, front * at(0.11 * s, 0.05, -0.4), EYE)
			block(Vector3.new(0.75, 0.1, 0.06), front * at(0, -0.02, -0.1) * CFrame.Angles(0, 0, 0.6 * s), WHITE) -- crossbones
			brow(s, 1.0, false, Color3.fromRGB(60, 55, 80), 0.55)
		end
		-- bushy beard
		ball(1.6, at(0, -1.25, -1.1), BEARD)
		for _, s in { -1, 1 } do
			ball(1.15, at(0.6 * s, -1.05, -1.15), BEARD)
		end
		-- captain's coat collar + gold epaulettes
		for _, s in { -1, 1 } do
			local cp = surf(Vector3.new(0.55 * s, -0.25, 0.85), 0.08)
			block(Vector3.new(1.1, 1.0, 0.14), U.Facing(cp, cp), hatC)
			cyl(0.2, 0.85, at(1.62 * s, 0.15, -0.2) * U.AxisY, GOLD, METAL_MAT)
		end
		-- ship's wheel on the back
		local wc = at(0, -0.15, 2.4)
		for i = 0, 7 do
			block(Vector3.new(0.2, 0.86, 0.2), wc * CFrame.Angles(0, 0, i * math.pi / 4) * at(1.05, 0, 0), WOOD)
		end
		for i = 0, 3 do
			block(Vector3.new(3.0, 0.14, 0.14), wc * CFrame.Angles(0, 0, i * math.pi / 4 + math.pi / 8), U.Shade(WOOD, 0.8))
		end
		cyl(0.32, 0.55, wc * U.AxisZ, GOLD, METAL_MAT)
	elseif style == "Knight" then
		-- steel helmet: dome, rim, crest, raised visor with its slit, plume
		local steel = Color3.fromRGB(195, 202, 220)
		local hc = Vector3.new(0, 1.0, 0.2)
		ball(3.3, CFrame.new(hc), steel, METAL_MAT)
		cyl(0.24, 3.4, at(0, 0.98, 0.2) * U.AxisY, U.Shade(steel, 0.8), METAL_MAT)
		cyl(0.2, 3.36, CFrame.new(hc), U.Shade(steel, 0.85), METAL_MAT) -- crest ridge front to back
		local vd = Vector3.new(0, 0.25, -1).Unit
		local vp = hc + vd * 1.68
		local vf = U.Facing(vp, vd)
		block(Vector3.new(1.7, 0.5, 0.16), vf, steel, METAL_MAT)
		block(Vector3.new(1.25, 0.09, 0.06), vf * at(0, -0.02, -0.09), DARK)
		local plume = Color3.fromRGB(235, 60, 80)
		ball(0.6, at(0, 2.7, 0.05), plume)
		wedge(Vector3.new(0.32, 1.0, 1.3), at(0, 2.9, 0.75) * CFrame.Angles(0.35, 0, 0), plume)
		-- small round shield on the left nub
		local sc = at(-2.1, -0.5, -0.5) * CFrame.Angles(0, 0.55, 0)
		cyl(0.12, 1.32, sc * U.AxisZ, GOLD, METAL_MAT)
		cyl(0.16, 1.15, sc * at(0, 0, -0.03) * U.AxisZ, accent)
		block(Vector3.new(0.16, 0.8, 0.05), sc * at(0, 0, -0.12), WHITE)
		block(Vector3.new(0.6, 0.16, 0.05), sc * at(0, 0.1, -0.12), WHITE)
	elseif style == "Royal" then
		-- small tilted crown with a gem
		local ccf = at(0.15, 1.62, 0.05) * CFrame.Angles(0, 0, -0.15)
		cyl(0.4, 1.3, ccf * U.AxisY, GOLD, METAL_MAT)
		for i = 0, 4 do
			wedge(Vector3.new(0.3, 0.42, 0.24), ccf * CFrame.Angles(0, i * 2 * math.pi / 5, 0) * at(0, 0.4, -0.52), GOLD, METAL_MAT)
		end
		ball(0.22, ccf * at(0, 0, -0.66), accent, NEON)
		ruff(-1.0, 8, 0.6, WHITE, CREAM)
		-- cape with a gold hem
		local capeCf = at(0, -1.0, 1.95) * CFrame.Angles(-0.2, 0, 0)
		block(Vector3.new(2.9, 2.6, 0.18), capeCf, Color3.fromRGB(120, 40, 170))
		block(Vector3.new(2.9, 0.16, 0.22), capeCf * at(0, -1.25, 0), GOLD, METAL_MAT)
	elseif style == "King" then
		-- big jewelled crown over a velvet cap
		local ccf = at(0, 1.3, 0.05)
		cyl(0.75, 2.45, ccf * U.AxisY, GOLD, METAL_MAT)
		ball(2.2, ccf * at(0, 0.32, 0), Color3.fromRGB(200, 35, 70))
		for i = 0, 5 do
			wedge(Vector3.new(0.42, 0.7, 0.36), ccf * CFrame.Angles(0, i * math.pi / 3, 0) * at(0, 0.7, -1.05), GOLD, METAL_MAT)
		end
		ball(0.42, ccf * at(0, 0, -1.25), glow, NEON) -- centre jewel
		for _, s in { -1, 1 } do
			local gemC = if s < 0 then Color3.fromRGB(220, 40, 70) else Color3.fromRGB(60, 120, 255)
			ball(0.3, ccf * CFrame.Angles(0, 0.75 * s, 0) * at(0, 0, -1.24), gemC, { Reflectance = 0.25 })
		end
		block(Vector3.new(0.14, 0.5, 0.14), ccf * at(0, 1.6, 0), GOLD, METAL_MAT)
		block(Vector3.new(0.4, 0.13, 0.13), ccf * at(0, 1.65, 0), GOLD, METAL_MAT)
		-- long white beard
		ball(1.6, at(0, -1.2, -1.1), BEARD)
		ball(1.2, at(0, -1.85, -1.0), BEARD)
		ball(0.8, at(0, -2.4, -0.82), BEARD)
		for _, s in { -1, 1 } do
			ball(1.0, at(0.6 * s, -1.0, -1.2), BEARD)
		end
		-- ermine collar (white puffs with black tips) and a red cape
		local cy = -0.95
		local cr = math.sqrt(R * R - cy * cy) + 0.05
		for i = 0, 7 do
			local a = (i + 0.5) * math.pi / 4
			local p = Vector3.new(math.sin(a) * cr, cy, -math.cos(a) * cr)
			ball(0.65, CFrame.new(p), WHITE)
			if i % 2 == 0 then
				local n = Vector3.new(p.X, 0, p.Z).Unit
				block(Vector3.new(0.09, 0.2, 0.06), U.Facing(p + n * 0.31, n), DARK)
			end
		end
		block(Vector3.new(3.3, 2.9, 0.2), at(0, -1.1, 2.0) * CFrame.Angles(-0.2, 0, 0), Color3.fromRGB(190, 30, 60))
		-- scepter with a glowing gem
		local hand = Vector3.new(1.75, -0.35, -0.2)
		local dir = Vector3.new(0.2, 1, -0.3).Unit
		rod(hand - dir * 0.5, hand + dir * 1.9, 0.16, GOLD, METAL_MAT)
		ball(0.34, CFrame.new(hand + dir * 1.95), GOLD, METAL_MAT)
		block(Vector3.new(0.5, 0.5, 0.5), CFrame.new(hand + dir * 2.35) * U.VertexUp, glow, NEON)
	elseif style == "Ancient" then
		-- carved stone circlet with a glowing rune stone on the forehead
		ring(1.12, 0.5, STONE)
		local fp = surf(Vector3.new(0, 1.12, -1.4), 0.08)
		local ff = U.Facing(fp, fp)
		block(Vector3.new(0.75, 0.75, 0.2), ff * CFrame.Angles(0, 0, math.pi / 4), U.Shade(STONE, 0.85))
		cyl(0.06, 0.3, ff * at(0, 0, -0.12) * U.AxisZ, glow, NEON)
		-- rune stripes round the body
		local runeC = U.Shade(accent, 0.75)
		ring(-0.75, 0.16, runeC)
		ring(-1.2, 0.16, runeC)
		for _, a in { -1.0, -0.35, 0.35, 1.0 } do
			local d = Vector3.new(math.sin(a), -0.7, -math.cos(a))
			local p = surf(d, 0)
			block(Vector3.new(0.1, 0.3, 0.06), U.Facing(p, d), glow, NEON)
		end
		-- floating stone tablet
		local tcf = at(-2.6, 0.55, 0) * CFrame.Angles(0.1, 0.55, 0.12)
		block(Vector3.new(1.1, 1.3, 0.24), tcf, STONE)
		cyl(0.24, 1.1, tcf * at(0, 0.65, 0) * U.AxisZ, STONE)
		for i = 0, 2 do
			block(Vector3.new(0.65 - i * 0.12, 0.08, 0.04), tcf * at(0, 0.45 - i * 0.32, -0.13), glow, NEON)
		end
	elseif style == "Void" then
		-- glowing cracks in the dark body
		local cracks = {
			{ d = Vector3.new(1.0, 0.55, -0.45), t = 0.4 },
			{ d = Vector3.new(-0.95, 0.75, -0.2), t = -0.5 },
			{ d = Vector3.new(0.85, -0.45, -0.75), t = 2.6 },
			{ d = Vector3.new(-0.7, -0.35, -0.9), t = 0.3 },
			{ d = Vector3.new(0.15, 0.95, 0.35), t = 1.2 },
		}
		for _, c in cracks do
			local p = surf(c.d, -0.02)
			local f = U.Facing(p, c.d) * CFrame.Angles(0, 0, c.t)
			block(Vector3.new(0.11, 0.75, 0.1), f, glow, NEON)
			block(Vector3.new(0.09, 0.42, 0.1), f * at(0.12, 0.42, 0) * CFrame.Angles(0, 0, -0.7), glow, NEON)
		end
		-- three orbiting shards
		for i = 0, 2 do
			local a = i * 2 * math.pi / 3 + 0.5
			local y = 0.3 + 0.45 * math.sin(i * 2.1)
			crystal(CFrame.Angles(0, a, 0) * at(0, y, -2.65) * CFrame.Angles(0.35, 0, 0.5), 0.34, 0.75, U.Shade(color, 0.7), nil, glow, NEON, true)
		end
	elseif style == "Overlord" then
		-- massive crystal crown: gold circlet, centre spike, horns and side spikes
		local gem = U.Vivid(glow)
		local glass = { Reflectance = 0.25 }
		cyl(0.42, 2.55, at(0, 1.25, 0.05) * U.AxisY, GOLD, METAL_MAT)
		crystal(at(0, 1.6, -0.3) * at(0, 0.8, 0), 0.52, 1.6, gem, glass, glow, NEON, false)
		for _, s in { -1, 1 } do
			crystal(at(0.8 * s, 1.5, 0.1) * CFrame.Angles(0, 0, -0.55 * s) * at(0, 0.7, 0), 0.45, 1.4, gem, glass, glow, NEON, false)
			crystal(at(0.45 * s, 1.45, -0.62) * CFrame.Angles(-0.25, 0, -0.3 * s) * at(0, 0.35, 0), 0.3, 0.7, gem, glass, glow, NEON, false)
			brow(s, 0.98, true, DARK, 0.7)
		end
		block(Vector3.new(0.4, 0.4, 0.4), at(0, 1.25, -1.33) * U.VertexUp, glow, NEON) -- circlet jewel
		-- ornate high collar
		ring(-0.75, 0.22, GOLD, METAL_MAT)
		for i = -2, 2 do
			block(Vector3.new(0.6, 1.3, 0.14), CFrame.Angles(0, i * 0.42, 0) * at(0, -0.15, 1.75) * CFrame.Angles(0.35, 0, 0), Color3.fromRGB(70, 50, 120))
		end
		-- five big crystals floating around
		for i = 0, 4 do
			local a = math.pi / 5 + i * 2 * math.pi / 5
			local y = if i % 2 == 0 then 0.7 else -0.5
			crystal(CFrame.Angles(0, a, 0) * at(0, y, -3.1) * CFrame.Angles(0.15, 0, 0.3), 0.45, 1.3, gem, glass, glow, NEON, true)
		end
	else -- Plain: a little wisp curl on top
		ball(0.6, at(0.1, 1.85, 0.1), color, bodyOpts)
		ball(0.35, at(0.35, 2.15, 0.22), color, bodyOpts)
	end

	------------------------------------------------------------------ attachments, glow, light
	local top, bottom = R, -R
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= core then
			top = math.max(top, U.TopY(d))
			bottom = math.min(bottom, U.BottomY(d))
		end
	end
	U.AttachAt(core, "Center", CFrame.identity)
	U.AttachAt(core, "Top", CFrame.new(0, top + 0.3, 0))
	U.AttachAt(core, "Bottom", CFrame.new(0, bottom, 0))

	-- aura: subtle on normal ghosts, stronger on mini-bosses, strongest on bosses/event ghosts
	local isBoss = def.Kind == "Boss" or def.Kind == "Event"
	local isMini = def.Kind == "MiniBoss"
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Aura"
	pe.Color = ColorSequence.new(glow)
	pe.LightEmission = 1
	pe.LightInfluence = 0
	pe.Rate = if isBoss then 8 elseif isMini then 4 else 2
	pe.Lifetime = NumberRange.new(1.5, 2.5)
	pe.Speed = NumberRange.new(0.3, if isBoss then 1.1 else 0.8)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Shape = Enum.ParticleEmitterShape.Sphere
	local peak = if isBoss then 1.6 elseif isMini then 1.2 else 0.8
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, peak / 3),
		NumberSequenceKeypoint.new(0.5, peak),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if isBoss then 0.45 elseif isMini then 0.6 else 0.7),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-30, 30)
	pe.Parent = core

	-- No PointLights on ghosts: lights on moving, bobbing (and spawn-scaling) models flicker as
	-- the engine re-sorts nearby lights every frame. The glow comes from the neon core, eyes and
	-- the Aura emitter (stronger on bosses).

	if def.Scale ~= 1 then
		model:ScaleTo(def.Scale)
	end
	return model
end

return GhostRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">HunterRig</string>
            <string name="Source"><![CDATA[--!strict
-- Chibi ghost-hunter rigs built from plain Parts (no asset IDs).
--
--   HunterRig.Build(hunterId) -> Rig        animated rig: anchored Root at the feet, Motor6D limbs
--   HunterRig.Pose(rig, state, t, blend?)   procedural pose ("Idle" | "Run" | "Attack" | "Celebrate")
--   HunterRig.BuildStatic(hunterId) -> Model fully anchored, posed copy for ViewportFrame portraits
--
-- Layout (studs, model space, facing -Z): feet at Y=0, hips at Y=0.92, torso 0.9..1.95,
-- head (1.9 ball) centred at Y=2.77. Total height ~3.8-4.4 depending on hair/hat.
-- Joints sit at the waist (Root->Torso), neck, shoulders and hips, so Motor6D.Transform
-- rotates each bone around its joint.
-- Neon is limited to the tool emitter (the part holding the Tip attachment) plus at most one
-- small light (helmet lamp, antenna bulb, a small halo, the Crystal circlet's gems or the
-- small Orbs back); visors, goggles, badges, tanks, wings, hats and screens are solid vivid colours.

local Config = require(script.Parent.Parent.Config)
local U = require(script.Parent.RigUtil)

local HunterRig = {}

export type Rig = {
	Model: Model,
	Root: BasePart,
	Motors: { [string]: Motor6D },
	Tip: Attachment,
	Height: number,
	HunterId: string,
}

type Deco = { Part: BasePart, Offset: CFrame }
type DecoMap = { [BasePart]: { Deco } }

-- body measurements
local HIP_Y = 0.92
local TORSO_SIZE = Vector3.new(1.3, 1.05, 0.85)
local TORSO_HALF_H = 0.5 -- waist joint sits this far below the torso centre
local NECK = Vector3.new(0, 0.525, 0) -- torso-local
local HEAD_UP = 0.82 -- head centre above the neck
local HEAD_D = 1.9
local SHOULDER = Vector3.new(0.86, 0.36, 0) -- torso-local (X mirrored)
local ARM_SIZE = Vector3.new(0.42, 0.78, 0.42)
local ARM_DROP = 0.3 -- arm centre below the shoulder
local HIP = Vector3.new(0.32, -0.5, 0) -- torso-local (X mirrored)
local LEG_SIZE = Vector3.new(0.5, 0.7, 0.55)
local LEG_DROP = 0.33
local GRIP = CFrame.new(0, -0.45, -0.05) * CFrame.Angles(-math.pi / 6, 0, 0) -- arm-local tool frame (-Z = muzzle)

local JOINT_ORDER = { "Torso", "Head", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }

local WHITE = Color3.fromRGB(255, 255, 255)
local EYE = Color3.fromRGB(25, 20, 35)
local MOUTH = Color3.fromRGB(110, 35, 50)
local METAL = Color3.fromRGB(90, 95, 115)
local GOLD = Color3.fromRGB(255, 205, 60)
local NAVY = Color3.fromRGB(35, 50, 120)
local RED = Color3.fromRGB(230, 50, 70)

local NEON = { Material = Enum.Material.Neon }
local METAL_MAT = { Material = Enum.Material.Metal }

local function buildInternal(hunterId: string): (Rig, DecoMap)
	local def = Config.Hunters[hunterId]
	assert(def, "HunterRig: unknown hunter " .. tostring(hunterId))
	local look = def.Look
	local rarity = Config.Rarities[def.Rarity]
	local rarityColor = if rarity then rarity.Color else look.Beam

	local model = Instance.new("Model")
	model.Name = hunterId

	local root = U.Block(Vector3.new(1, 1, 1), CFrame.identity, WHITE, model, { Transparency = 1, Name = "Root", Shadow = false })
	root.Anchored = true
	model.PrimaryPart = root

	local decos: DecoMap = {}
	local motors: { [string]: Motor6D } = {}

	local function bone(name: string, p: BasePart): BasePart
		p.Name = name
		decos[p] = {}
		return p
	end

	local function add(b: BasePart, p: BasePart): BasePart
		U.FixedWeld(b, p)
		table.insert(decos[b], { Part = p, Offset = b.CFrame:ToObjectSpace(p.CFrame) })
		return p
	end
	local function ball(b: BasePart, d: number, lcf: CFrame, color: Color3, opts: U.Opts?): BasePart
		return add(b, U.Ball(d, b.CFrame * lcf, color, model, opts))
	end
	local function block(b: BasePart, size: Vector3, lcf: CFrame, color: Color3, opts: U.Opts?): BasePart
		return add(b, U.Block(size, b.CFrame * lcf, color, model, opts))
	end
	local function cyl(b: BasePart, len: number, d: number, lcf: CFrame, color: Color3, opts: U.Opts?): BasePart
		return add(b, U.Cyl(len, d, b.CFrame * lcf, color, model, opts))
	end
	local function wedge(b: BasePart, size: Vector3, lcf: CFrame, color: Color3, opts: U.Opts?): BasePart
		return add(b, U.Wedge(size, b.CFrame * lcf, color, model, opts))
	end
	-- straight rod between two bone-local points
	local function rod(b: BasePart, p0: Vector3, p1: Vector3, d: number, color: Color3, opts: U.Opts?): BasePart
		return cyl(b, (p1 - p0).Magnitude, d, U.Between(p0, p1), color, opts)
	end
	-- stepped cone standing on bone-local `base` (along its +Y); returns the tip frame
	local function cone(b: BasePart, base: CFrame, d: number, h: number, tiers: number, c1: Color3, c2: Color3?): CFrame
		local th = h / tiers
		for i = 0, tiers - 1 do
			local c = if c2 and i % 2 == 1 then c2 else c1
			cyl(b, th * 1.05, d * (tiers - i) / tiers, base * CFrame.new(0, th * (i + 0.5), 0) * U.AxisY, c)
		end
		return base * CFrame.new(0, h, 0)
	end

	------------------------------------------------------------------ skeleton
	local torsoC0 = CFrame.new(0, HIP_Y, 0)
	local torsoC1 = CFrame.new(0, -TORSO_HALF_H, 0)
	local torso = bone("Torso", U.Block(TORSO_SIZE, torsoC0 * torsoC1:Inverse(), look.Shirt, model, { Shadow = true }))
	motors.Torso = U.Motor("Torso", root, torso, torsoC0, torsoC1)

	local headC0 = CFrame.new(NECK)
	local headC1 = CFrame.new(0, -HEAD_UP, 0)
	local head = bone("Head", U.Ball(HEAD_D, torso.CFrame * headC0 * headC1:Inverse(), look.Skin, model, { Shadow = true }))
	motors.Head = U.Motor("Head", torso, head, headC0, headC1)

	local arms: { [number]: BasePart } = {}
	local legs: { [number]: BasePart } = {}
	for _, s in { -1, 1 } do
		local side = if s < 0 then "Left" else "Right"
		local aC0 = CFrame.new(SHOULDER.X * s, SHOULDER.Y, SHOULDER.Z)
		local aC1 = CFrame.new(0, ARM_DROP, 0)
		local arm = bone(side .. "Arm", U.Block(ARM_SIZE, torso.CFrame * aC0 * aC1:Inverse(), look.Shirt, model))
		motors[side .. "Arm"] = U.Motor(side .. "Arm", torso, arm, aC0, aC1)
		ball(arm, 0.5, CFrame.new(0, -0.42, 0), look.Skin) -- hand
		arms[s] = arm

		local lC0 = CFrame.new(HIP.X * s, HIP.Y, HIP.Z)
		local lC1 = CFrame.new(0, LEG_DROP, 0)
		local leg = bone(side .. "Leg", U.Block(LEG_SIZE, torso.CFrame * lC0 * lC1:Inverse(), look.Pants, model))
		motors[side .. "Leg"] = U.Motor(side .. "Leg", torso, leg, lC0, lC1)
		-- shoe: bottom exactly at Y=0 (leg centre is at Y=0.59)
		block(leg, Vector3.new(0.6, 0.3, 0.78), CFrame.new(0, 0.15 - (HIP_Y - LEG_DROP), -0.08), look.Shoes)
		legs[s] = leg
	end
	local rArm = arms[1]

	------------------------------------------------------------------ face
	local hat = look.Hat
	local hatColor = look.HatColor or look.Shirt
	for _, s in { -1, 1 } do
		local eyePos = Vector3.new(0.34 * s, 0.0, -0.8)
		ball(head, 0.5, CFrame.new(eyePos), EYE, { Shadow = false })
		ball(head, 0.17, CFrame.new(eyePos + Vector3.new(0.07, 0.1, -0.19)), WHITE)
		if hat ~= "Goggles" then
			block(head, Vector3.new(0.34, 0.08, 0.14), CFrame.new(0.34 * s, 0.37, -0.86) * CFrame.Angles(0.35, 0, -0.14 * s), U.Shade(look.Hair, 0.8))
		end
	end
	-- little open smile: a WedgePart turned into a "▽"
	wedge(head, Vector3.new(0.1, 0.26, 0.26), CFrame.new(0, -0.34, -0.88) * CFrame.Angles(-0.35, 0, 0) * CFrame.Angles(0, 0, -math.pi / 4) * U.AxisZ, MOUTH)

	------------------------------------------------------------------ hair
	local covered = hat == "Hood"
		or hat == "Helmet"
		or hat == "Beanie"
		or hat == "KnightHelm"
		or hat == "Bandana"
		or hat == "Jester"
		or hat == "SailorCap"
	local style = look.HairStyle
	local hairTop = 1.25
	local hairColor = look.Hair
	local function cap()
		ball(head, 2.0, CFrame.new(0, 0.25, 0.2), hairColor)
	end
	if style == "None" then
		hairTop = HEAD_D / 2
	elseif style == "Puff" and not covered then
		ball(head, 2.3, CFrame.new(0, 0.5, 0.32), hairColor)
		hairTop = 1.65
	elseif style == "Spiky" and not covered then
		cap()
		wedge(head, Vector3.new(0.45, 1.0, 0.8), CFrame.new(-0.3, 1.05, 0.35) * CFrame.Angles(0.5, 0, 0.25), hairColor)
		wedge(head, Vector3.new(0.45, 1.0, 0.8), CFrame.new(0.3, 1.0, 0.45) * CFrame.Angles(0.55, 0, -0.25), hairColor)
		hairTop = 1.35
	elseif style == "Bob" then
		cap()
		ball(head, 2.06, CFrame.new(0, -0.12, 0.32), hairColor)
	elseif style == "Long" then
		cap()
		block(head, Vector3.new(1.75, 1.6, 0.55), CFrame.new(0, -0.5, 0.72), hairColor)
	else -- Short (and covered Puff/Spiky): a neat hair cap
		cap()
	end
	local lift = hairTop - 1.25

	------------------------------------------------------------------ hat
	if hat == "Cap" then
		ball(head, 2.0, CFrame.new(0, 0.45, 0.12), hatColor)
		cyl(head, 0.1, 1.3, CFrame.new(0, 0.55, -0.95) * CFrame.Angles(-0.12, 0, 0) * U.AxisY, U.Shade(hatColor, 0.85))
	elseif hat == "Beanie" then
		ball(head, 2.06, CFrame.new(0, 0.42, 0.12), hatColor)
		ball(head, 0.6, CFrame.new(0, 1.5, 0.2), U.Mix(hatColor, WHITE, 0.6))
	elseif hat == "Fedora" then
		cyl(head, 0.12, 2.8, CFrame.new(0, 0.78 + lift, 0.08) * CFrame.Angles(-0.06, 0, 0) * U.AxisY, hatColor)
		cyl(head, 0.85, 1.55, CFrame.new(0, 1.2 + lift, 0.08) * U.AxisY, hatColor)
		cyl(head, 0.22, 1.6, CFrame.new(0, 0.92 + lift, 0.08) * U.AxisY, U.Shade(hatColor, 0.45))
	elseif hat == "Hood" then
		ball(head, 2.25, CFrame.new(0, 0.22, 0.3), hatColor)
		wedge(head, Vector3.new(0.55, 0.9, 0.7), CFrame.new(0, 1.2, 0.75) * CFrame.Angles(-0.3, 0, 0), hatColor)
	elseif hat == "Helmet" then
		ball(head, 2.08, CFrame.new(0, 0.48, 0.12), hatColor)
		cyl(head, 0.1, 2.35, CFrame.new(0, 0.5, 0.12) * U.AxisY, U.Shade(hatColor, 0.8))
		local dir = Vector3.new(0, 0.5, -0.87).Unit
		local pos = Vector3.new(0, 0.48, 0.12) + dir * 1.06
		cyl(head, 0.25, 0.45, U.DiscFacing(pos, dir), look.Beam, NEON)
	elseif hat == "Mortarboard" then
		cyl(head, 0.45, 1.5, CFrame.new(0, hairTop - 0.1, 0.1) * U.AxisY, hatColor)
		block(head, Vector3.new(2.1, 0.12, 2.1), CFrame.new(0, hairTop + 0.17, 0.1) * CFrame.Angles(0, math.pi / 4, 0), hatColor)
		block(head, Vector3.new(0.12, 0.6, 0.12), CFrame.new(1.38, hairTop - 0.1, 0.1), Color3.fromRGB(255, 205, 60)) -- tassel
	elseif hat == "Visor" then
		cyl(head, 0.2, 2.02, CFrame.new(0, 0.5, 0.05) * U.AxisY, U.Shade(hatColor, 0.6))
		block(head, Vector3.new(1.5, 0.08, 0.75), CFrame.new(0, 0.6, -1.05) * CFrame.Angles(-0.2, 0, 0), U.Vivid(hatColor), { Transparency = 0.35, Reflectance = 0.2, Shadow = false })
	elseif hat == "Goggles" then
		cyl(head, 0.16, 2.06, CFrame.new(0, 0.52, 0.05) * U.AxisY, U.Shade(hatColor, 0.45))
		for _, s in { -1, 1 } do
			local pos = Vector3.new(0.366 * s, 0.554, -0.817)
			cyl(head, 0.22, 0.5, U.DiscFacing(pos, pos), U.Vivid(hatColor), { Transparency = 0.15, Reflectance = 0.25 }) -- glassy lenses
		end
	elseif hat == "Halo" then
		cyl(head, 0.1, 1.3, CFrame.new(0, hairTop + 0.4, 0.1) * CFrame.Angles(0.15, 0, 0) * U.AxisY, hatColor, { Material = Enum.Material.Neon, Transparency = 0.2 })
	elseif hat == "TopHat" then
		local bandC = if hatColor.R + hatColor.G + hatColor.B > 1.6 then U.Shade(hatColor, 0.35) else GOLD
		local hcf = CFrame.new(0, 0.82 + lift, 0.08) * CFrame.Angles(-0.05, 0, 0.06)
		cyl(head, 0.1, 2.2, hcf * U.AxisY, hatColor) -- brim
		cyl(head, 1.0, 1.4, hcf * CFrame.new(0, 0.52, 0) * U.AxisY, hatColor)
		cyl(head, 0.24, 1.44, hcf * CFrame.new(0, 0.2, 0) * U.AxisY, bandC)
	elseif hat == "Jester" then
		local alt = U.Vivid(GOLD)
		ball(head, 2.06, CFrame.new(0, 0.42, 0.12), hatColor)
		for _, s in { -1, 1 } do
			local base = CFrame.new(0.5 * s, 1.05, 0.15) * CFrame.Angles(0, 0, -0.95 * s)
			local tipCf = cone(head, base, 0.75, 1.0, 3, if s < 0 then hatColor else alt)
			ball(head, 0.3, tipCf, if s < 0 then alt else hatColor) -- bell
		end
	elseif hat == "NurseCap" then
		local ncf = CFrame.new(0, hairTop - 0.12, -0.15) * CFrame.Angles(-0.35, 0, 0)
		block(head, Vector3.new(1.25, 0.45, 0.55), ncf, hatColor)
		block(head, Vector3.new(1.3, 0.12, 0.6), ncf * CFrame.new(0, -0.2, 0), U.Shade(hatColor, 0.9)) -- folded band
		block(head, Vector3.new(0.34, 0.1, 0.04), ncf * CFrame.new(0, 0.02, -0.29), RED)
		block(head, Vector3.new(0.1, 0.34, 0.04), ncf * CFrame.new(0, 0.02, -0.29), RED)
	elseif hat == "HeadMirror" then
		cyl(head, 0.14, 2.08, CFrame.new(0, 0.62, 0.05) * U.AxisY, U.Shade(hatColor, 0.45)) -- head band
		local n = Vector3.new(0.3, 0.3, -1).Unit
		local pos = Vector3.new(0.36, 0.75, -0.98)
		cyl(head, 0.08, 0.75, U.DiscFacing(pos, n), hatColor, { Material = Enum.Material.Metal, Reflectance = 0.4 })
		cyl(head, 0.1, 0.16, U.DiscFacing(pos + n * 0.01, n), EYE)
	elseif hat == "SailorCap" then
		local scf = CFrame.new(0.05, 1.0 + lift, 0.12) * CFrame.Angles(0.1, 0, -0.12)
		cyl(head, 0.5, 1.7, scf * CFrame.new(0, 0.28, 0) * U.AxisY, hatColor)
		cyl(head, 0.24, 2.0, scf * U.AxisY, hatColor) -- turned-up brim
		cyl(head, 0.07, 2.03, scf * CFrame.new(0, 0.05, 0) * U.AxisY, NAVY)
	elseif hat == "Bandana" then
		local c = Vector3.new(0, 0.4, 0.14)
		ball(head, 2.08, CFrame.new(c), hatColor)
		for _, d in { Vector3.new(-0.45, 0.55, -0.7), Vector3.new(0.4, 0.75, -0.5), Vector3.new(0.05, 0.95, 0.3) } do
			ball(head, 0.2, CFrame.new(c + d.Unit * 1.02), WHITE) -- polka dots
		end
		local knotC = U.Shade(hatColor, 0.85)
		ball(head, 0.38, CFrame.new(0.1, 0.35, 1.12), knotC)
		block(head, Vector3.new(0.22, 0.6, 0.08), CFrame.new(-0.05, 0.0, 1.18) * CFrame.Angles(0.2, 0, 0.3), knotC)
		block(head, Vector3.new(0.22, 0.55, 0.08), CFrame.new(0.25, 0.02, 1.16) * CFrame.Angles(0.2, 0, -0.25), knotC)
	elseif hat == "Tricorn" then
		local tcf = CFrame.new(0, 0.95 + lift, 0.1)
		cyl(head, 0.6, 1.55, tcf * CFrame.new(0, 0.25, 0) * U.AxisY, hatColor)
		for i = 0, 2 do
			local side = tcf * CFrame.Angles(0, math.pi / 3 + i * 2 * math.pi / 3, 0) * CFrame.new(0, 0.15, -0.68) * CFrame.Angles(-0.4, 0, 0)
			block(head, Vector3.new(2.3, 0.5, 0.1), side, hatColor)
			block(head, Vector3.new(2.3, 0.08, 0.14), side * CFrame.new(0, 0.26, 0), GOLD, METAL_MAT) -- gold trim
		end
	elseif hat == "KnightHelm" then
		-- open-faced helm: covers the top, back and sides; the face shows through
		local steel = hatColor
		ball(head, 2.2, CFrame.new(0, 0.3, 0.32), steel, METAL_MAT)
		cyl(head, 0.16, 2.26, CFrame.new(0, 0.3, 0.32), U.Shade(steel, 0.8), METAL_MAT) -- crest ridge
		local n = Vector3.new(0, 0.45, -0.9).Unit
		local vcf = U.Facing(Vector3.new(0, 0.3, 0.32) + n * 1.12, n)
		block(head, Vector3.new(1.5, 0.42, 0.12), vcf, steel, METAL_MAT) -- raised visor
		block(head, Vector3.new(1.1, 0.08, 0.05), vcf * CFrame.new(0, 0, -0.07), EYE) -- visor slit
		for _, s in { -1, 1 } do
			block(head, Vector3.new(0.14, 0.75, 0.6), CFrame.new(0.9 * s, -0.2, -0.35), steel, METAL_MAT) -- cheek guard
		end
		local plume = U.Vivid(look.Shirt)
		ball(head, 0.42, CFrame.new(0, 1.48, 0.05), plume)
		wedge(head, Vector3.new(0.22, 0.75, 0.9), CFrame.new(0, 1.6, 0.55) * CFrame.Angles(0.3, 0, 0), plume)
	elseif hat == "Wizard" then
		local wcf = CFrame.new(0, 0.85 + lift, 0.12) * CFrame.Angles(-0.12, 0, 0.1)
		cyl(head, 0.1, 2.5, wcf * U.AxisY, hatColor) -- brim
		cyl(head, 0.2, 1.6, wcf * CFrame.new(0, 0.12, 0) * U.AxisY, GOLD) -- band
		local tipCf = cone(head, wcf * CFrame.new(0, 0.05, 0), 1.55, 1.45, 4, hatColor)
		ball(head, 0.24, tipCf, GOLD)
		local star = wcf * CFrame.new(0.1, 0.55, -0.62) * CFrame.Angles(-0.12, 0, 0)
		block(head, Vector3.new(0.24, 0.24, 0.05), star, GOLD)
		block(head, Vector3.new(0.24, 0.24, 0.05), star * CFrame.Angles(0, 0, math.pi / 4), GOLD)
	elseif hat == "Crown" then
		local ccf = CFrame.new(0, hairTop - 0.05, 0.1)
		cyl(head, 0.42, 1.35, ccf * U.AxisY, hatColor, METAL_MAT)
		for i = 0, 4 do
			wedge(head, Vector3.new(0.32, 0.42, 0.22), ccf * CFrame.Angles(0, i * 2 * math.pi / 5, 0) * CFrame.new(0, 0.4, -0.56), hatColor, METAL_MAT)
		end
		ball(head, 0.26, ccf * CFrame.new(0, 0, -0.68), RED, { Reflectance = 0.3 }) -- front gem
	elseif hat == "Crystal" then
		-- floating circlet of small glowing crystals; the centre one is a tall point
		local y = hairTop + 0.15
		local glowOpts = { Material = Enum.Material.Neon, Transparency = 0.1 }
		for i = -2, 2 do
			local p = CFrame.new(0, 0, 0.12) * CFrame.Angles(0, i * 0.55, 0) * CFrame.new(0, y - math.abs(i) * 0.12, -0.72)
			if i == 0 then
				block(head, Vector3.new(0.3, 0.5, 0.3), p * CFrame.Angles(0, math.pi / 4, 0), U.Vivid(hatColor), { Reflectance = 0.3 })
				block(head, Vector3.new(0.3, 0.3, 0.3), p * CFrame.new(0, 0.25, 0) * U.VertexUp, hatColor, glowOpts)
			else
				local sz = 0.28 - math.abs(i) * 0.03
				block(head, Vector3.new(sz, sz, sz), p * U.VertexUp, hatColor, glowOpts)
			end
		end
	end

	------------------------------------------------------------------ body accent / aura
	local badgeCf = CFrame.new(-0.3, 0.2, -0.44) * U.AxisZ
	if look.Aura then
		cyl(torso, 0.08, 0.42, badgeCf, U.Vivid(rarityColor), { Reflectance = 0.2 })
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Aura"
		pe.Color = ColorSequence.new(rarityColor)
		pe.LightEmission = 1
		pe.Rate = 6
		pe.Lifetime = NumberRange.new(0.9, 1.6)
		pe.Speed = NumberRange.new(0.4, 1.1)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.12),
			NumberSequenceKeypoint.new(0.4, 0.28),
			NumberSequenceKeypoint.new(1, 0),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		pe.Acceleration = Vector3.new(0, 1.2, 0)
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-90, 90)
		pe.Parent = torso
	else
		cyl(torso, 0.08, 0.42, badgeCf, look.Beam)
	end

	------------------------------------------------------------------ back
	local back = look.Back
	local backColor = look.BackColor or look.Shirt
	if back == "Backpack" then
		block(torso, Vector3.new(1.0, 1.0, 0.5), CFrame.new(0, 0, 0.65), backColor)
		block(torso, Vector3.new(0.7, 0.4, 0.18), CFrame.new(0, -0.2, 0.95), U.Shade(backColor, 0.75))
	elseif back == "Tank" then
		cyl(torso, 1.2, 0.78, CFrame.new(0, 0.1, 0.75) * U.AxisY, backColor, { Transparency = 0.45 })
		cyl(torso, 1.0, 0.5, CFrame.new(0, 0.1, 0.75) * U.AxisY, U.Vivid(backColor)) -- ectoplasm inside the tank
		cyl(torso, 0.18, 0.84, CFrame.new(0, 0.75, 0.75) * U.AxisY, METAL, { Material = Enum.Material.Metal })
	elseif back == "Cape" then
		block(torso, Vector3.new(1.35, 1.55, 0.12), CFrame.new(0, -0.3, 0.52) * CFrame.Angles(-0.15, 0, 0), backColor)
		block(torso, Vector3.new(1.45, 0.3, 0.6), CFrame.new(0, 0.5, 0.25), U.Shade(backColor, 0.75))
	elseif back == "Wings" then
		for _, s in { -1, 1 } do
			-- big wing: tall outer edge, tapering into the spine
			wedge(torso, Vector3.new(0.12, 1.4, 1.2), CFrame.new(0.8 * s, 0.35, 0.58) * CFrame.Angles(0, 0, 0.35 * s) * CFrame.Angles(0, math.pi / 2 * s, 0), backColor, { Transparency = 0.1 })
			-- brighter inner feather layer
			wedge(torso, Vector3.new(0.1, 1.0, 0.9), CFrame.new(0.7 * s, 0.0, 0.64) * CFrame.Angles(0, 0, 0.05 * s) * CFrame.Angles(0, math.pi / 2 * s, 0), U.Vivid(backColor), { Transparency = 0.3 })
		end
	elseif back == "Antenna" then
		block(torso, Vector3.new(0.7, 0.8, 0.4), CFrame.new(0, 0, 0.62), backColor)
		cyl(torso, 1.8, 0.1, CFrame.new(0.25, 1.1, 0.75) * U.AxisY, METAL, { Material = Enum.Material.Metal })
		ball(torso, 0.32, CFrame.new(0.25, 2.0, 0.75), look.Beam, NEON)
	elseif back == "Balloons" then
		local anchor = Vector3.new(0.3, 0.3, 0.7)
		local cols = { backColor, Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 215, 70) }
		local spots = { Vector3.new(-1.1, 2.2, 0.9), Vector3.new(0.2, 2.6, 1.2), Vector3.new(1.15, 2.05, 0.85) }
		for i, p in spots do
			rod(torso, anchor, p - Vector3.new(0, 0.4, 0), 0.05, WHITE)
			ball(torso, 0.85, CFrame.new(p), U.Vivid(cols[i]))
		end
	elseif back == "MedKit" then
		block(torso, Vector3.new(1.05, 0.85, 0.5), CFrame.new(0, 0.05, 0.66), backColor)
		block(torso, Vector3.new(0.5, 0.15, 0.06), CFrame.new(0, 0.05, 0.93), RED)
		block(torso, Vector3.new(0.15, 0.5, 0.06), CFrame.new(0, 0.05, 0.93), RED)
		cyl(torso, 0.5, 0.1, CFrame.new(0, 0.53, 0.66), METAL, METAL_MAT) -- handle
		for _, s in { -1, 1 } do
			block(torso, Vector3.new(0.18, 0.12, 0.9), CFrame.new(0.38 * s, 0.56, 0.05), U.Shade(backColor, 0.7)) -- shoulder strap
		end
	elseif back == "LifeRing" then
		local c = CFrame.new(0, 0.05, 0.7)
		for i = 0, 7 do
			block(torso, Vector3.new(0.24, 0.44, 0.24), c * CFrame.Angles(0, 0, i * math.pi / 4) * CFrame.new(0.5, 0, 0), if i % 2 == 0 then backColor else WHITE)
		end
	elseif back == "Shield" then
		local scf = CFrame.new(0, 0, 0.62) * CFrame.Angles(0, 0, 0.2)
		cyl(torso, 0.12, 1.45, scf * U.AxisZ, METAL, METAL_MAT) -- rim
		cyl(torso, 0.14, 1.3, scf * CFrame.new(0, 0, 0.03) * U.AxisZ, backColor)
		block(torso, Vector3.new(0.18, 1.05, 0.05), scf * CFrame.new(0, 0, 0.11), GOLD)
		block(torso, Vector3.new(1.05, 0.18, 0.05), scf * CFrame.new(0, 0.1, 0.11), GOLD)
		ball(torso, 0.3, scf * CFrame.new(0, 0, 0.1), GOLD, METAL_MAT) -- boss
	elseif back == "Orbs" then
		-- three small spirit orbs floating behind the shoulders
		for _, p in { Vector3.new(-1.1, 0.8, 0.5), Vector3.new(1.25, 1.25, 0.55), Vector3.new(-1.3, 1.95, 0.5) } do
			ball(torso, 0.55, CFrame.new(p), backColor, { Transparency = 0.65, Shadow = false })
			ball(torso, 0.3, CFrame.new(p), backColor, NEON)
		end
	end

	------------------------------------------------------------------ tool (right hand)
	local grip = rArm.CFrame * GRIP
	local tool = look.Tool
	local tc = look.ToolColor
	local beam = look.Beam
	local function tpart(p: BasePart): BasePart
		return add(rArm, p)
	end
	local function T(x: number, y: number, z: number): CFrame
		return grip * CFrame.new(x, y, z)
	end
	local muzzle: BasePart
	local tipWorld: CFrame
	if tool == "Vacuum" then
		local body = tpart(U.Block(Vector3.new(0.55, 0.6, 1.1), T(0, 0.1, -0.25), tc, model))
		tpart(U.Cyl(0.9, 0.42, T(0, 0.05, -1.2) * U.AxisZ, METAL, model, { Material = Enum.Material.Metal }))
		muzzle = tpart(U.Cyl(0.18, 0.64, T(0, 0.05, -1.7) * U.AxisZ, beam, model, NEON))
		tipWorld = T(0, 0.05, -1.82)
		-- hose: a Beam from the back of the vacuum to the hip (follows the animation for free)
		local a0 = U.AttachAt(body, "HoseA", T(0, 0.0, 0.3) * CFrame.Angles(0, 0, -math.pi / 2))
		local a1 = U.AttachAt(torso, "HoseB", torso.CFrame * CFrame.new(0.5, -0.35, if back then 0.6 else 0.3))
		local hose = Instance.new("Beam")
		hose.Name = "Hose"
		hose.Attachment0 = a0
		hose.Attachment1 = a1
		hose.Color = ColorSequence.new(U.Shade(tc, 0.55))
		hose.Width0 = 0.22
		hose.Width1 = 0.26
		hose.FaceCamera = true
		hose.Segments = 12
		hose.CurveSize0 = 0.9
		hose.CurveSize1 = 0
		hose.LightInfluence = 1
		hose.Transparency = NumberSequence.new(0)
		hose.Parent = body
	elseif tool == "Scanner" then
		tpart(U.Block(Vector3.new(0.8, 0.45, 1.2), T(0, 0.1, -0.35), U.Shade(tc, 0.45), model))
		tpart(U.Block(Vector3.new(0.6, 0.06, 0.7), T(0, 0.35, -0.35), U.Vivid(tc), model, { Reflectance = 0.2 })) -- screen
		muzzle = tpart(U.Ball(0.32, T(0, 0.15, -1.0), tc, model, NEON))
		tipWorld = T(0, 0.15, -1.05)
	elseif tool == "Blaster" then
		tpart(U.Block(Vector3.new(0.5, 0.62, 1.05), T(0, 0.12, -0.3), tc, model))
		tpart(U.Cyl(0.8, 0.36, T(0, 0.22, -1.1) * U.AxisZ, METAL, model, { Material = Enum.Material.Metal }))
		muzzle = tpart(U.Cyl(0.16, 0.5, T(0, 0.22, -1.5) * U.AxisZ, beam, model, NEON))
		tpart(U.Wedge(Vector3.new(0.12, 0.3, 0.5), T(0, 0.58, -0.2), U.Shade(tc, 0.7), model))
		tipWorld = T(0, 0.22, -1.6)
	elseif tool == "Cannon" then
		tpart(U.Cyl(2.2, 0.95, T(0.15, 0.45, -0.55) * U.AxisZ, tc, model))
		tpart(U.Ball(1.1, T(0.15, 0.45, 0.45), U.Shade(tc, 0.6), model))
		tpart(U.Cyl(0.18, 1.02, T(0.15, 0.45, -0.4) * U.AxisZ, U.Vivid(beam), model)) -- ring
		muzzle = tpart(U.Cyl(0.3, 1.18, T(0.15, 0.45, -1.65) * U.AxisZ, beam, model, NEON))
		tipWorld = T(0.15, 0.45, -1.85)
	elseif tool == "Lantern" then
		tpart(U.Cyl(0.18, 0.6, T(0, 0.05, -0.5) * U.AxisY, METAL, model, { Material = Enum.Material.Metal }))
		tpart(U.Block(Vector3.new(0.55, 0.65, 0.55), T(0, -0.3, -0.5), tc, model, { Transparency = 0.4 }))
		muzzle = tpart(U.Ball(0.38, T(0, -0.3, -0.5), beam, model, NEON))
		tipWorld = T(0, -0.3, -0.5)
		-- no PointLight: a light on every moving crew flickers (the neon flame is enough)
	elseif tool == "Staff" then
		local up = CFrame.Angles(-0.1, 0, 0) -- pole stands nearly upright in the Attack pose
		tpart(U.Cyl(3.0, 0.18, grip * up * CFrame.new(0, 0.55, 0) * U.AxisY, U.Shade(tc, 0.5), model))
		tpart(U.Cyl(0.16, 0.62, grip * up * CFrame.new(0, 2.0, 0) * U.AxisY, tc, model))
		muzzle = tpart(U.Ball(0.62, grip * up * CFrame.new(0, 2.3, 0), beam, model, NEON))
		tipWorld = grip * up * CFrame.new(0, 2.3, 0)
	elseif tool == "Projector" then
		tpart(U.Block(Vector3.new(0.75, 0.7, 1.0), T(0, 0.15, -0.35), tc, model))
		muzzle = tpart(U.Cyl(0.25, 0.55, T(0, 0.15, -0.95) * U.AxisZ, beam, model, NEON))
		tpart(U.Cyl(0.12, 0.65, T(0, 0.75, -0.1), U.Shade(tc, 0.45), model))
		tpart(U.Cyl(0.12, 0.65, T(0, 0.75, -0.65), U.Shade(tc, 0.45), model))
		tipWorld = T(0, 0.15, -1.1)
	elseif tool == "Megaphone" then
		tpart(U.Block(Vector3.new(0.2, 0.42, 0.26), T(0, -0.05, -0.15), U.Shade(tc, 0.5), model)) -- grip
		tpart(U.Cyl(0.55, 0.36, T(0, 0.22, -0.35) * U.AxisZ, tc, model))
		tpart(U.Cyl(0.35, 0.58, T(0, 0.22, -0.78) * U.AxisZ, WHITE, model))
		tpart(U.Cyl(0.3, 0.82, T(0, 0.22, -1.08) * U.AxisZ, tc, model)) -- bell
		muzzle = tpart(U.Cyl(0.06, 0.74, T(0, 0.22, -1.24) * U.AxisZ, beam, model, NEON))
		tipWorld = T(0, 0.22, -1.3)
	elseif tool == "Wand" then
		tpart(U.Cyl(1.15, 0.13, T(0, 0.05, -0.55) * U.AxisZ, tc, model))
		tpart(U.Cyl(0.22, 0.15, T(0, 0.05, -1.05) * U.AxisZ, WHITE, model)) -- tip cap
		muzzle = tpart(U.Block(Vector3.new(0.24, 0.24, 0.24), T(0, 0.05, -1.28) * U.VertexUp, beam, model, NEON)) -- sparkle
		tipWorld = T(0, 0.05, -1.32)
	elseif tool == "Orb" then
		tpart(U.Cyl(0.2, 0.55, T(0, 0.15, -0.45) * U.AxisY, tc, model, METAL_MAT)) -- stand
		tpart(U.Ball(0.82, T(0, 0.55, -0.45), U.Vivid(beam), model, { Transparency = 0.45, Reflectance = 0.2, Shadow = false })) -- glass
		muzzle = tpart(U.Ball(0.42, T(0, 0.55, -0.45), beam, model, NEON))
		tipWorld = T(0, 0.55, -0.86)
	elseif tool == "Spyglass" then
		tpart(U.Cyl(0.4, 0.24, T(0, 0.08, 0.05) * U.AxisZ, U.Shade(tc, 0.6), model, METAL_MAT)) -- eyepiece
		tpart(U.Cyl(0.5, 0.3, T(0, 0.08, -0.38) * U.AxisZ, tc, model, METAL_MAT))
		tpart(U.Cyl(0.7, 0.38, T(0, 0.08, -0.95) * U.AxisZ, Color3.fromRGB(95, 62, 40), model)) -- leather tube
		tpart(U.Cyl(0.1, 0.46, T(0, 0.08, -1.3) * U.AxisZ, tc, model, METAL_MAT)) -- rim
		muzzle = tpart(U.Cyl(0.04, 0.34, T(0, 0.08, -1.36) * U.AxisZ, beam, model, NEON)) -- lens
		tipWorld = T(0, 0.08, -1.4)
	elseif tool == "Sword" then
		local hilt = Color3.fromRGB(90, 60, 45)
		tpart(U.Cyl(0.45, 0.17, T(0, 0, 0.12) * U.AxisZ, hilt, model))
		tpart(U.Ball(0.24, T(0, 0, 0.38), GOLD, model, METAL_MAT)) -- pommel
		tpart(U.Block(Vector3.new(0.85, 0.14, 0.16), T(0, 0, -0.14), GOLD, model, METAL_MAT)) -- crossguard
		tpart(U.Block(Vector3.new(0.08, 0.3, 1.3), T(0, 0, -0.87), tc, model, METAL_MAT)) -- blade
		tpart(U.Wedge(Vector3.new(0.08, 0.15, 0.35), T(0, 0.075, -1.695), tc, model, METAL_MAT)) -- point (upper half)
		tpart(U.Wedge(Vector3.new(0.08, 0.15, 0.35), T(0, -0.075, -1.695) * CFrame.Angles(0, 0, math.pi), tc, model, METAL_MAT))
		muzzle = tpart(U.Block(Vector3.new(0.1, 0.07, 1.1), T(0, 0, -0.85), beam, model, NEON)) -- glowing fuller
		tipWorld = T(0, 0, -1.85)
	else -- Flashlight (default)
		tpart(U.Cyl(1.2, 0.36, T(0, 0, -0.3) * U.AxisZ, U.Shade(tc, 0.7), model))
		tpart(U.Cyl(0.38, 0.62, T(0, 0, -1.05) * U.AxisZ, tc, model))
		muzzle = tpart(U.Cyl(0.06, 0.5, T(0, 0, -1.25) * U.AxisZ, beam, model, NEON))
		tipWorld = T(0, 0, -1.3)
	end
	local tip = U.AttachAt(muzzle, "Tip", tipWorld)

	------------------------------------------------------------------ finish
	local top = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			top = math.max(top, U.TopY(d))
		end
	end

	local rig: Rig = {
		Model = model,
		Root = root,
		Motors = motors,
		Tip = tip,
		Height = top,
		HunterId = hunterId,
	}
	HunterRig.Pose(rig, "Idle", 0, 1)
	return rig, decos
end

function HunterRig.Build(hunterId: string): Rig
	local rig = buildInternal(hunterId)
	return rig
end

------------------------------------------------------------------ procedural poses
local sin, cos, abs, max = math.sin, math.cos, math.abs, math.max
local CFn, CFa = CFrame.new, CFrame.Angles
local AIM = math.pi / 6 -- arm pitch that levels the tool (the grip is tilted -30 degrees)

function HunterRig.Pose(rig: Rig, state: string, t: number, blend: number?)
	local b = if blend == nil then 1 else math.clamp(blend, 0, 1)
	local m = rig.Motors
	local torso, head, la, ra, ll, rl = m.Torso, m.Head, m.LeftArm, m.RightArm, m.LeftLeg, m.RightLeg

	if state == "Run" then
		local w = t * 13
		local s = sin(w)
		local lean = -0.22 * b
		local twist = 0.15 * s * b
		torso.Transform = CFn(0, abs(cos(w)) * 0.22 * b, 0) * CFa(lean, twist, 0)
		-- legs cancel the torso lean/twist so they swing from an upright hip
		local legBase = CFa(0, -twist, 0)
		ll.Transform = legBase * CFa(-lean + 0.95 * s * b, 0, 0)
		rl.Transform = legBase * CFa(-lean - 0.95 * s * b, 0, 0)
		la.Transform = CFa(-0.9 * s * b, 0, -0.12 * b)
		ra.Transform = CFa((0.4 + 0.3 * s) * b, 0, 0.1 * b)
		head.Transform = CFa(-lean * 0.6 + 0.05 * cos(2 * w) * b, -twist * 0.7, 0)
	elseif state == "Attack" then
		local ph = (t * 4) % 1
		local p = (1 - ph) * (1 - ph) * (1 - ph) -- recoil pulse, 4 Hz
		local jx = 0.015 * sin(t * 57) * b
		local jy = 0.015 * sin(t * 43) * b
		local lean = (-0.12 + 0.1 * p) * b
		torso.Transform = CFn(jx, jy, 0.06 * p * b) * CFa(lean, 0, 0)
		ll.Transform = CFa(-lean + 0.28 * b, 0, -0.12 * b)
		rl.Transform = CFa(-lean - 0.22 * b, 0, 0.12 * b)
		ra.Transform = CFa((AIM + 0.18 * p) * b - lean, 0, 0.04 * b)
		la.Transform = CFa((1.15 + 0.1 * p) * b - lean, 0, 0.45 * b)
		head.Transform = CFa(0.06 * b - lean * 0.5 + jy, 0, 0)
	elseif state == "Celebrate" then
		local w = t * 3.6
		local j = abs(sin(w))
		torso.Transform = CFn(0, 0.65 * j * b, 0) * CFa(-0.08 * b, 0.5 * sin(t * 2.4) * b, 0)
		ll.Transform = CFa(0.35 * j * b, 0, -0.15 * j * b)
		rl.Transform = CFa(-0.25 * j * b, 0, 0.15 * j * b)
		la.Transform = CFa(0, 0, (-2.5 - 0.25 * sin(t * 8)) * b)
		ra.Transform = CFa(0.2 * b, 0, (1.7 + 0.8 * max(0, sin(t * 7.2))) * b)
		head.Transform = CFa((-0.18 + 0.05 * sin(w * 2)) * b, 0, 0.12 * sin(w) * b)
	else -- Idle
		local br = sin(t * 2.2)
		torso.Transform = CFn(0, 0.03 * br * b, 0) * CFa(0.025 * br * b, 0, 0)
		head.Transform = CFa(0.04 * sin(t * 1.3) * b, 0.15 * sin(t * 0.6) * b, 0.05 * sin(t * 0.9) * b)
		la.Transform = CFa(0.06 * sin(t * 2.2 + 0.6) * b, 0, -(0.12 + 0.04 * br) * b)
		ra.Transform = CFa((0.22 + 0.05 * br) * b, 0, (0.1 + 0.03 * br) * b)
		ll.Transform = CFa(0, 0, -0.04 * b)
		rl.Transform = CFa(0, 0, 0.04 * b)
	end
end

------------------------------------------------------------------ portrait copy
-- Anchored, posed model for ViewportFrames (no physics runs there, so joints are solved here).
function HunterRig.BuildStatic(hunterId: string): Model
	local rig, decos = buildInternal(hunterId)
	HunterRig.Pose(rig, "Idle", 0.45, 1)
	for _, name in JOINT_ORDER do
		local mo = rig.Motors[name]
		local p0, p1 = mo.Part0, mo.Part1
		if p0 and p1 then
			p1.CFrame = p0.CFrame * mo.C0 * mo.Transform * mo.C1:Inverse()
		end
	end
	for b, list in decos do
		for _, d in list do
			d.Part.CFrame = b.CFrame * d.Offset
		end
	end
	for _, d in rig.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return rig.Model
end

return HunterRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">RigUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Small part factory shared by HunterRig, GhostRig and CrateRig.
-- Every part is created non-colliding, non-touching, non-querying, unanchored and massless;
-- callers flip what they need (Root/Core/Base are anchored, Core is queryable).

local RigUtil = {}

export type Opts = {
	Material: Enum.Material?,
	Transparency: number?,
	Name: string?,
	Reflectance: number?,
	Shadow: boolean?, -- force CastShadow (default: only parts larger than 1.5 studs cast)
}

local function setup(p: BasePart, size: Vector3, cf: CFrame, color: Color3, parent: Instance, opts: Opts?)
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local maxDim = math.max(size.X, size.Y, size.Z)
	p.CastShadow = maxDim >= 1.5
	if opts then
		if opts.Material then
			p.Material = opts.Material
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.Name then
			p.Name = opts.Name
		end
		if opts.Reflectance then
			p.Reflectance = opts.Reflectance
		end
		if opts.Shadow ~= nil then
			p.CastShadow = opts.Shadow
		end
	end
	if p.Material == Enum.Material.Neon then
		p.CastShadow = false
	end
	p.Parent = parent
end

function RigUtil.Ball(d: number, cf: CFrame, color: Color3, parent: Instance, opts: Opts?): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	setup(p, Vector3.new(d, d, d), cf, color, parent, opts)
	return p
end

function RigUtil.Block(size: Vector3, cf: CFrame, color: Color3, parent: Instance, opts: Opts?): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Block
	setup(p, size, cf, color, parent, opts)
	return p
end

-- Cylinder: `length` runs along the part's X axis, `d` is the diameter.
function RigUtil.Cyl(length: number, d: number, cf: CFrame, color: Color3, parent: Instance, opts: Opts?): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	setup(p, Vector3.new(length, d, d), cf, color, parent, opts)
	return p
end

-- WedgePart: full height on its back (+Z) face, sloping down to its front (-Z) bottom edge.
function RigUtil.Wedge(size: Vector3, cf: CFrame, color: Color3, parent: Instance, opts: Opts?): BasePart
	local p = Instance.new("WedgePart")
	setup(p, size, cf, color, parent, opts)
	return p
end

-- Rotations that turn a Cylinder's X axis to point along another axis.
RigUtil.AxisY = CFrame.Angles(0, 0, math.pi / 2) -- cylinder stands upright (disc lies flat)
RigUtil.AxisZ = CFrame.Angles(0, math.pi / 2, 0) -- cylinder points forward/back (disc faces -Z)

-- Rotation that stands a cube on one corner (a cheap faceted gem or crystal tip).
RigUtil.VertexUp = CFrame.Angles(0, 0, math.atan(math.sqrt(2))) * CFrame.Angles(0, math.pi / 4, 0)

-- Frame for a Cylinder running from `a` to `b` (give it length (b - a).Magnitude).
function RigUtil.Between(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) / 2, b) * RigUtil.AxisZ
end

-- A frame at `pos` whose front (-Z) looks along `normal` (used to stick things onto round surfaces).
function RigUtil.Facing(pos: Vector3, normal: Vector3): CFrame
	return CFrame.lookAt(pos, pos + normal.Unit)
end

-- A forward-facing disc (Cylinder axis along the frame's -Z) on a round surface.
function RigUtil.DiscFacing(pos: Vector3, normal: Vector3): CFrame
	return CFrame.lookAt(pos, pos + normal.Unit) * RigUtil.AxisZ
end

function RigUtil.Weld(a: BasePart, b: BasePart): WeldConstraint
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end

-- Classic Weld with the current offset baked in (deterministic even outside Workspace).
function RigUtil.FixedWeld(a: BasePart, b: BasePart): Weld
	local w = Instance.new("Weld")
	w.Part0 = a
	w.Part1 = b
	w.C0 = a.CFrame:ToObjectSpace(b.CFrame)
	w.C1 = CFrame.identity
	w.Parent = b
	return w
end

function RigUtil.Motor(name: string, p0: BasePart, p1: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1
	m.Parent = p0
	return m
end

function RigUtil.AttachAt(part: BasePart, name: string, worldCf: CFrame): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = part.CFrame:ToObjectSpace(worldCf)
	a.Parent = part
	return a
end

function RigUtil.Shade(c: Color3, f: number): Color3
	return Color3.new(math.clamp(c.R * f, 0, 1), math.clamp(c.G * f, 0, 1), math.clamp(c.B * f, 0, 1))
end

function RigUtil.Mix(a: Color3, b: Color3, t: number): Color3
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- Slightly more saturated, brighter colour for accents that are solid instead of Neon
-- (Neon is kept for tool emitters, eyes, flames and one small light per rig).
-- Near-greys/whites keep their saturation.
function RigUtil.Vivid(c: Color3): Color3
	local h, s, v = c:ToHSV()
	local s2 = if s < 0.1 then s else math.min(1, s * 1.15 + 0.05)
	return Color3.fromHSV(h, s2, math.min(1, v * 1.06 + 0.03))
end

-- Highest world Y reached by a part's box (exact for blocks, conservative for balls/cylinders).
function RigUtil.TopY(p: BasePart): number
	local _, y, _, _, _, _, r10, r11, r12 = p.CFrame:GetComponents()
	local s = p.Size
	return y + (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) / 2
end

function RigUtil.BottomY(p: BasePart): number
	local _, y, _, _, _, _, r10, r11, r12 = p.CFrame:GetComponents()
	local s = p.Size
	return y - (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) / 2
end

return RigUtil
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Minimal signal. Unlike a BindableEvent, arguments are passed by reference (BindableEvents
-- deep-copy tables and turn Instance keys into strings), and each handler runs in its own
-- thread so one failing handler can't break the others.
export type Connection = { Connected: boolean, Disconnect: (Connection) -> () }
export type Signal = {
	Connect: (Signal, (...any) -> ()) -> Connection,
	Fire: (Signal, ...any) -> (),
	Wait: (Signal) -> ...any,
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { [Connection]: (...any) -> () } = {}
	local waiting: { thread } = {}
	local self = {} :: Signal

	function self.Connect(_: Signal, fn: (...any) -> ()): Connection
		local conn = { Connected = true } :: Connection
		function conn.Disconnect(c: Connection)
			c.Connected = false
			handlers[c] = nil
		end
		handlers[conn] = fn
		return conn
	end

	function self.Fire(_: Signal, ...: any)
		for conn, fn in handlers do
			if conn.Connected then
				task.spawn(fn, ...)
			end
		end
		if #waiting > 0 then
			local list = waiting
			waiting = {}
			for _, th in list do
				task.spawn(th, ...)
			end
		end
	end

	function self.Wait(_: Signal): ...any
		table.insert(waiting, coroutine.running())
		return coroutine.yield()
	end

	return self
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
