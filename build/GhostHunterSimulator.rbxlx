	bed(f, -106, 1280, -1, 0)
	bed(f, -106, 1296, -1, 0)
	bed(f, -106, 1382, -1, 0)
	bed(f, -106, 1392, -1, 0)
	bed(f, -80, 1276.5, 0, -1)
	bed(f, -66, 1276.5, 0, -1)
	ivStand(f, -99.5, 1292)
	ivStand(f, -99.5, 1378)
