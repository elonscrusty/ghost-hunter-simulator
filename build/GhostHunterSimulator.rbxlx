		muzzle = tpart(U.Ball(0.14, cf * CFrame.new(0.15, 0.9, 0.05), beam, model, NEON))
		tipWorld = cf * CFrame.new(0.15, 0.95, 0.05)
	elseif tool == "Diploma" then
