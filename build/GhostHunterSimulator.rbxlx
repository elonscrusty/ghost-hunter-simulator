			local gc = gems[i % 4 + 1]
			crystal(CFrame.Angles(0, a, 0) * at(0, y, -3.4) * CFrame.Angles(0.15, 0, 0.3), 0.45, 1.2, gc, glass, gc, NEON, false)
		end
