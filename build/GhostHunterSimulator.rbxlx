			{ a = Vector3.new(0, 2.25, 0.45), b = Vector3.new(0, 2.95, 0.95), c = Vector3.new(0, 2.45, 1.6), col = capA },
			{ a = Vector3.new(0.75, 2.0, 0.2), b = Vector3.new(1.65, 2.6, 0.3), c = Vector3.new(2.05, 1.95, 0.35), col = capB },
		}
		for _, h in horns do
