  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">GHServer</string>
      </Properties>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR server entry. Builds the world, then initialises services in order.
-- Every step is protected: one failing system logs a warning instead of stopping the others.
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)

Net.Init()

-- Players pass through each other (busy crate stations); hunters are client-side and non-colliding.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

local okWorld, errWorld = pcall(function()
	require(script.Parent.World.Builder).Build()
end)
if not okWorld then
	warn("[Main] world build failed: " .. tostring(errWorld))
end

local Services = script.Parent.Services
local order = {
	"Fx",
	"Remotes",
	"DataService",
	"PlayerInfo",
	"HunterService",
	"DropService",
	"GhostService",
	"ProgressService",
	"EventService",
	"ShopService",
	"StationService",
	"DevService",
}
local loaded: { [string]: any } = {}
for _, name in order do
	local ok, mod = pcall(require, Services:FindFirstChild(name) :: ModuleScript)
	if not ok then
		warn("[Main] couldn't load " .. name .. ": " .. tostring(mod))
		continue
	end
	loaded[name] = mod
	if (mod :: any).Init then
		local okInit, err = pcall((mod :: any).Init)
		if not okInit then
			warn("[Main] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end
for _, name in order do
	local mod = loaded[name]
	if mod and mod.Start then
		local okStart, err = pcall(mod.Start)
		if not okStart then
			warn("[Main] " .. name .. ".Start failed: " .. tostring(err))
		end
	end
end

-- Developer tools (DEV button + chat commands) live in Services/DevService.
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load/save with retries, a per-session lock (prevents duplication when a
-- player hops or rejoins quickly), autosave, BindToClose and schema migration. Every other
-- service reads and writes data ONLY through DataService.Get(player) on the server.
--
-- Safety rules:
--  * a save only writes while OUR session holds the lock; otherwise it reports failure
--  * the save snapshot is a deep copy taken at save time (consistent even if the write retries)
--  * once a player is leaving, only the final releasing save runs
--  * a join waits for this server's in-flight leave-save of the same user
--  * the no-saving fallback exists only in Studio; live servers kick instead of using a blank profile
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)

local DataService = {}

export type HunterRecord = { Id: string, Locked: boolean?, T: number? }
export type Data = {
	Version: number,
	Ecto: number,
	TotalEcto: number,
	Hunters: { [string]: HunterRecord },
	NextUid: number,
	Equipped: { string },
	Discovered: { [string]: boolean },
	Zones: { [string]: boolean },
	Upgrades: { [string]: number },
	Daily: { Last: number, Streak: number },
	Boosts: { [string]: number }, -- boost id -> os.time expiry
	FreeCrates: { [string]: number },
	Settings: { Music: boolean, Sfx: boolean, FastReveal: boolean },
	Tutorial: number,
	Stats: { Ghosts: number, Crates: number, Events: number, Seconds: number },
	Purchases: { string }, -- recent receipt ids (ring buffer)
	Orphans: { [string]: any }, -- hunters whose id no longer exists in Config (kept, not used)
	Extra: { [string]: any }, -- unknown top-level keys from a newer/older version (kept as-is)
}

local IS_STUDIO = RunService:IsStudio()

local function defaults(): Data
	local d: Data = {
		Version = Config.DataSchemaVersion,
		Ecto = 0,
		TotalEcto = 0,
		Hunters = {},
		NextUid = 1,
		Equipped = {},
		Discovered = {},
		Zones = { [Config.Zones[1].Id] = true },
		Upgrades = {},
		Daily = { Last = 0, Streak = 0 },
		Boosts = {},
		FreeCrates = {},
		Settings = { Music = true, Sfx = true, FastReveal = false },
		Tutorial = 1,
		Stats = { Ghosts = 0, Crates = 0, Events = 0, Seconds = 0 },
		Purchases = {},
		Orphans = {},
		Extra = {},
	}
	for id in Config.Upgrades do
		d.Upgrades[id] = 1
	end
	return d
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

-- Fills missing fields (new features) and upgrades old schemas. Never deletes player data:
-- unknown keys go to Extra, hunters that no longer exist go to Orphans.
local function migrate(raw: any): Data
	local d = defaults()
	if type(raw) ~= "table" then
		return d
	end
	for k, v in raw do
		if k == "_lock" then
			continue
		end
		local cur = (d :: any)[k]
		if cur ~= nil then
			if type(v) == type(cur) and k ~= "Extra" then
				(d :: any)[k] = v
			end
		elseif type(k) == "string" then
			d.Extra[k] = v
		end
	end
	if type(raw.Extra) == "table" then
		for k, v in raw.Extra do
			if d.Extra[k] == nil and (d :: any)[k] == nil then
				d.Extra[k] = v
			end
		end
	end
	-- nested defaults
	local base = defaults()
	local settings = d.Settings :: any
	for k, v in base.Settings :: any do
		if type(settings[k]) ~= type(v) then
			settings[k] = v
		end
	end
	for k in settings do
		if (base.Settings :: any)[k] == nil then
			settings[k] = nil -- retired setting (e.g. the old free auto-target)
		end
	end
	for k, v in base.Stats do
		if type((d.Stats :: any)[k]) ~= "number" then
			(d.Stats :: any)[k] = v
		end
	end
	for k, v in base.Daily do
		if type((d.Daily :: any)[k]) ~= "number" then
			(d.Daily :: any)[k] = v
		end
	end
	for id in Config.Upgrades do
		local lv = d.Upgrades[id]
		d.Upgrades[id] = if type(lv) == "number" and lv == lv then math.clamp(math.floor(lv), 1, #Config.Upgrades[id].Levels) else 1
	end
	if type(d.Ecto) ~= "number" or d.Ecto ~= d.Ecto then
		d.Ecto = 0
	end
	d.Zones[Config.Zones[1].Id] = true
	-- hunters whose definition was removed are parked in Orphans (restored if the id returns)
	for uid, h in d.Orphans do
		if type(h) == "table" and Config.Hunters[h.Id] and d.Hunters[uid] == nil then
			d.Hunters[uid] = h
			d.Orphans[uid] = nil
		end
	end
	for uid, h in d.Hunters do
		if type(h) ~= "table" or not Config.Hunters[h.Id] then
			d.Orphans[uid] = h
			d.Hunters[uid] = nil
		end
	end
	local eq = {}
	local seen = {}
	for _, uid in d.Equipped do
		if d.Hunters[uid] and not seen[uid] then
			seen[uid] = true
			table.insert(eq, uid)
		end
	end
	d.Equipped = eq
	-- uids must never be reused: NextUid stays above every existing numeric uid
	local maxUid = 0
	for _, list in { d.Hunters :: any, d.Orphans } do
		for uid in list do
			local n = tonumber(uid)
			if n and n > maxUid then
				maxUid = n
			end
		end
	end
	d.NextUid = math.max(math.floor(tonumber(d.NextUid) or 1), maxUid + 1)
	-- (future) if d.Version < 2 then ... end
	d.Version = Config.DataSchemaVersion
	return d
end

type Profile = {
	Data: Data,
	Key: string,
	Session: string,
	Loaded: boolean,
	Leaving: boolean,
	Saving: boolean,
	SyncQueued: boolean,
	JoinedAt: number,
}

local profiles: { [Player]: Profile } = {}
local leavingSaves: { [number]: boolean } = {} -- userId -> final save in flight on this server
local inflight = 0
local store: DataStore? = nil
local storeOk = false
local loadedSignal = Signal.new()
DataService.Loaded = loadedSignal -- (player, data) by reference

local syncRemote: RemoteEvent
local ectoRemote: RemoteEvent
-- Extra values other services add to the client snapshot (crew power, slots, ...).
local decorators: { (Player, any) -> () } = {}

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local delayS = 1
	for attempt = 1, Config.Data.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[Data] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < Config.Data.Retries then
			task.wait(delayS)
			delayS = math.min(delayS * 2, 8)
		end
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

local function lockFresh(lock: any, session: string): boolean
	return type(lock) == "table" and lock.session ~= session and os.time() - (tonumber(lock.t) or 0) < Config.Data.SessionLockSeconds
end

-- Loads with a session lock. Returns data, or nil if the player should be kicked.
local function loadProfile(player: Player, p: Profile): Data?
	if not storeOk or not store then
		return if IS_STUDIO then migrate(nil) else nil
	end
	local ds = store :: DataStore
	local key = p.Key
	for attempt = 1, 6 do
		local locked = false
		local ok, result = retry("load " .. key, function()
			return ds:UpdateAsync(key, function(old: any)
				old = if type(old) == "table" then old else {}
				if lockFresh(old._lock, p.Session) then
					locked = true
					return nil -- don't write
				end
				old._lock = { job = jobId(), session = p.Session, t = os.time() }
				return old
			end)
		end)
		if not ok then
			return nil
		end
		if not locked then
			return migrate(result)
		end
		-- Another session still holds the lock (player just hopped). Wait for it to save.
		task.wait(math.min(2 + attempt * 2, 8))
		if not player.Parent then
			return nil
		end
	end
	warn("[Data] session lock never released for " .. key .. "; taking over")
	local ok, result = retry("steal " .. key, function()
		return ds:UpdateAsync(key, function(old: any)
			old = if type(old) == "table" then old else {}
			old._lock = { job = jobId(), session = p.Session, t = os.time() }
			return old
		end)
	end)
	return if ok then migrate(result) else nil
end

-- Writes the profile. Returns true only if the data really reached the DataStore.
local function saveProfile(player: Player, release: boolean): boolean
	local p = profiles[player]
	if not p or not p.Loaded then
		return false
	end
	if not storeOk or not store then
		return IS_STUDIO -- Studio without API access: nothing to save
	end
	if p.Leaving and not release then
		return false -- only the final, releasing save runs for a leaving player
	end
	if p.Saving then
		local t0 = os.clock()
		while p.Saving and os.clock() - t0 < 20 do
			task.wait(0.2)
		end
		if p.Saving then
			return false -- never run two writes for the same profile in parallel
		end
	end
	p.Saving = true
	inflight += 1
	local ds = store :: DataStore
	p.Data.Stats.Seconds += math.floor(os.clock() - p.JoinedAt)
	p.JoinedAt = os.clock()
	local snapshot = deepCopy(p.Data)
	local aborted = false
	local ok = retry("save " .. p.Key, function()
		aborted = false
		return ds:UpdateAsync(p.Key, function(old: any)
			if type(old) == "table" and lockFresh(old._lock, p.Session) then
				-- another session owns this profile now: never overwrite its newer data
				aborted = true
				return nil
			end
			snapshot._lock = if release then nil else { job = jobId(), session = p.Session, t = os.time() }
			return snapshot
		end)
	end)
	p.Saving = false
	inflight -= 1
	if ok and aborted then
		warn("[Data] save skipped for " .. p.Key .. ": another session owns the profile")
	end
	return ok and not aborted
end

function DataService.Get(player: Player): Data?
	local p = profiles[player]
	return if p and p.Loaded and not p.Leaving then p.Data else nil
end

-- Waits (up to timeout) for the player's data.
function DataService.WaitFor(player: Player, timeout: number?): Data?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < (timeout or 30) do
		local d = DataService.Get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return nil
end

function DataService.AddDecorator(fn: (Player, any) -> ())
	table.insert(decorators, fn)
end

local function snapshot(player: Player, d: Data): any
	local s = {
		Ecto = d.Ecto,
		Hunters = d.Hunters,
		Equipped = d.Equipped,
		Discovered = d.Discovered,
		Zones = d.Zones,
		Upgrades = d.Upgrades,
		Daily = d.Daily,
		Boosts = d.Boosts,
		FreeCrates = d.FreeCrates,
		Settings = d.Settings,
		Tutorial = d.Tutorial,
		Stats = d.Stats,
		ServerTime = os.time(),
	}
	for _, fn in decorators do
		local ok, err = pcall(function()
			fn(player, s)
		end)
		if not ok then
			warn("[Data] snapshot decorator failed: " .. tostring(err))
		end
	end
	return s
end

-- Sends the client a fresh snapshot (batched: many changes in one frame = one message).
function DataService.Changed(player: Player)
	local p = profiles[player]
	if not p or not p.Loaded or p.SyncQueued then
		return
	end
	p.SyncQueued = true
	task.defer(function()
		p.SyncQueued = false
		if player.Parent and profiles[player] == p and not p.Leaving then
			syncRemote:FireClient(player, snapshot(player, p.Data))
		end
	end)
end

-- Currency changes are frequent: send only the number.
function DataService.AddEcto(player: Player, amount: number)
	local p = profiles[player]
	if not p or not p.Loaded or p.Leaving or amount ~= amount or math.abs(amount) == math.huge then
		return
	end
	amount = math.floor(amount)
	p.Data.Ecto = math.max(0, p.Data.Ecto + amount)
	if amount > 0 then
		p.Data.TotalEcto += amount
	end
	ectoRemote:FireClient(player, p.Data.Ecto)
	player:SetAttribute("Ecto", p.Data.Ecto)
end

-- Spends Ectoplasm. Returns false if the player can't afford it.
function DataService.Spend(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or amount ~= amount or amount < 0 or d.Ecto < amount then
		return false
	end
	DataService.AddEcto(player, -amount)
	return true
end

-- Next unique hunter id (never reuses an id that is already owned).
function DataService.NewUid(d: Data): string
	local uid = tostring(d.NextUid)
	while d.Hunters[uid] ~= nil or d.Orphans[uid] ~= nil do
		d.NextUid += 1
		uid = tostring(d.NextUid)
	end
	d.NextUid += 1
	return uid
end

function DataService.Save(player: Player)
	task.spawn(saveProfile, player, false)
end

-- Saves now and waits; used by ProcessReceipt. True only if the write really happened.
function DataService.SaveNow(player: Player): boolean
	return saveProfile(player, false)
end

function DataService.Init()
	syncRemote = Net.Event("Sync")
	ectoRemote = Net.Event("Ecto")
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		store = result
		if IS_STUDIO then
			-- Studio without "Enable Studio Access to API Services" errors on any request
			storeOk = pcall(function()
				(result :: DataStore):GetAsync("__probe")
			end)
		else
			storeOk = true -- live: per-player loads retry and kick on failure
		end
	end
	if not storeOk then
		warn(if IS_STUDIO
			then "[Data] DataStores unavailable in Studio (turn on API access). Progress will NOT be saved this test."
			else "[Data] DataStore unavailable: players will be asked to rejoin.")
	end
end

local function onPlayerAdded(player: Player)
	local p: Profile = {
		Data = defaults(),
		Key = keyFor(player),
		Session = HttpService:GenerateGUID(false),
		Loaded = false,
		Leaving = false,
		Saving = false,
		SyncQueued = false,
		JoinedAt = os.clock(),
	}
	profiles[player] = p
	-- rejoined this same server while the previous session was still saving: wait for it
	local t0 = os.clock()
	while leavingSaves[player.UserId] and os.clock() - t0 < 30 do
		task.wait(0.2)
	end
	local data = loadProfile(player, p)
	if not player.Parent or profiles[player] ~= p then
		-- left while loading: release OUR lock (only if it is still ours) without writing data
		if data and storeOk and store then
			local ds = store :: DataStore
			pcall(function()
				ds:UpdateAsync(p.Key, function(old: any)
					if type(old) == "table" and type(old._lock) == "table" and old._lock.session == p.Session then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		if profiles[player] == p then
			profiles[player] = nil
		end
		return
	end
	if not data then
		profiles[player] = nil
		player:Kick("Couldn't load your Ghost Hunter data. Please rejoin in a moment - your progress is safe.")
		return
	end
	p.Data = data
	p.Loaded = true
	player:SetAttribute("Ecto", data.Ecto)
	loadedSignal:Fire(player, data)
	DataService.Changed(player)
end

local function onPlayerRemoving(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	p.Leaving = true
	if p.Loaded then
		leavingSaves[player.UserId] = true
		saveProfile(player, true)
		leavingSaves[player.UserId] = nil
	end
	if profiles[player] == p then
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, pl in Players:GetPlayers() do
		task.spawn(onPlayerAdded, pl)
	end
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveSeconds)
			for player, p in profiles do
				if p.Loaded and not p.Leaving then
					task.spawn(saveProfile, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		if not storeOk then
			return
		end
		for player, p in profiles do
			if p.Loaded and not p.Leaving then
				p.Leaving = true
				task.spawn(saveProfile, player, true)
			end
		end
		task.wait() -- let the saves start
		local t0 = os.clock()
		while inflight > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

-- Records a processed receipt id so a purchase is never granted twice.
function DataService.HasPurchase(d: Data, receipt: string): boolean
	return table.find(d.Purchases, receipt) ~= nil
end

function DataService.AddPurchase(d: Data, receipt: string)
	table.insert(d.Purchases, receipt)
	while #d.Purchases > 100 do
		table.remove(d.Purchases, 1)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!strict
-- Owner-only developer tools (DEV button + Studio chat commands). A player is a dev when the
-- game runs in Studio, when they created the game (or own the group that did), or when their
-- UserId is in Config.DevUserIds. Every command is re-checked here on the server, so the
-- button showing up on a client means nothing by itself.
-- NOTE: in a live server these change the dev's REAL saved profile.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local EventService = require(script.Parent.EventService)
local Remotes = require(script.Parent.Remotes)

local DevService = {}

local devs: { [Player]: boolean } = {}

local function checkDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.DevUserIds, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank == 255
end

function DevService.IsDev(player: Player): boolean
	return devs[player] == true
end

local MAX_ECTO_GRANT = 1e12

-- Runs one dev command; returns an error text or nil.
function DevService.Run(player: Player, cmd: string, arg: any): string?
	if not devs[player] then
		return "Not allowed"
	end
	local d = DataService.Get(player)
	if not d then
		return "Loading..."
	end
	if cmd == "Ecto" then
		local n = tonumber(arg)
		if not n or n ~= n or n <= 0 then
			return "Bad amount"
		end
		DataService.AddEcto(player, math.min(math.floor(n), MAX_ECTO_GRANT))
	elseif cmd == "Zones" then
		for _, z in Config.Zones do
			d.Zones[z.Id] = true
		end
		DataService.Changed(player)
	elseif cmd == "Hunters" then
		local count = 0
		for _ in d.Hunters do
			count += 1
		end
		for id in Config.Hunters do
			if count >= Config.Inventory.MaxHunters then
				break
			end
			HunterService.Add(player, id)
			count += 1
		end
		HunterService.Refresh(player)
	elseif cmd == "MaxUpgrades" then
		for id, up in Config.Upgrades do
			d.Upgrades[id] = #up.Levels
		end
		DataService.Changed(player)
	elseif cmd == "Event" then
		EventService.TriggerNow()
	elseif cmd == "ResetDaily" then
		d.Daily.Last = 0
		DataService.Changed(player)
	elseif cmd == "AutoAttack" then
		PlayerInfo.SetPass(player, "AutoAttack", true)
		HunterService.Refresh(player)
	elseif cmd == "Tutorial" then
		d.Tutorial = 1
		DataService.Changed(player)
	else
		return "Unknown command"
	end
	return nil
end

function DevService.Init()
	Remotes.Register("Dev", "Default", function(player, cmd, arg)
		if type(cmd) ~= "string" then
			return Remotes.Fail("Bad command")
		end
		local err = DevService.Run(player, cmd, arg)
		if err then
			return Remotes.Fail(err)
		end
		return { ok = true }
	end)
end

local CHAT: { [string]: string } = {
	["/event"] = "Event",
	["/reset-daily"] = "ResetDaily",
	["/autoattack"] = "AutoAttack",
	["/zones"] = "Zones",
	["/hunters"] = "Hunters",
	["/maxupgrades"] = "MaxUpgrades",
	["/tutorial"] = "Tutorial",
}

function DevService.Start()
	local function hook(player: Player)
		task.spawn(function()
			devs[player] = checkDev(player)
			-- the client shows the DEV button for this attribute; the server still checks every call
			player:SetAttribute("IsDev", devs[player])
		end)
		player.Chatted:Connect(function(msg)
			if not devs[player] then
				return
			end
			local n = msg:match("^/ecto%s+(%d+)")
			if n then
				DevService.Run(player, "Ecto", tonumber(n))
			elseif CHAT[msg] then
				DevService.Run(player, CHAT[msg], nil)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		devs[player] = nil
	end)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DropService</string>
            <string name="Source"><![CDATA[--!strict
-- Physical Ectoplasm orbs. The SERVER decides where each orb lands, what it is worth and
-- when it is picked up (player's root within their pickup radius). Clients only draw orbs
-- (bounce, glow, magnet flight). Orbs are per player, so nobody can steal another's loot.
-- One loop checks every player's orbs on a short interval; no per-orb connections.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)

local DropService = {}

type Drop = { Id: number, Pos: Vector3, Value: number, Expires: number }
type Bag = { List: { Drop }, NextId: number }

local bags: { [Player]: Bag } = {}
local dropsRemote: RemoteEvent
local collectRemote: RemoteEvent
local rng = Random.new()
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local collectedSignal = Signal.new()
DropService.Collected = collectedSignal -- (player, amount)

-- Ground raycasts ignore ghosts and characters (filter built once per Spawn call).
local function refreshFilter()
	local filter: { Instance } = {}
	local ghosts = workspace:FindFirstChild("Ghosts")
	if ghosts then
		table.insert(filter, ghosts)
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(filter, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
end

local function groundAt(x: number, y: number, z: number): number
	local hit = workspace:Raycast(Vector3.new(x, y + 4, z), Vector3.new(0, -80, 0), rayParams)
	return if hit then hit.Position.Y else 0
end

-- Spawns `total` Ectoplasm split into `count` orbs around `origin` for `player`.
-- scatter = {min, max} studs (defaults from Config.Drops).
function DropService.Spawn(player: Player, origin: Vector3, total: number, count: number, scatter: { number }?)
	local bag = bags[player]
	if not bag then
		return
	end
	local values = Rules.Split(total, math.max(1, count))
	local sMin = if scatter then scatter[1] else Config.Drops.ScatterMin
	local sMax = if scatter then scatter[2] else Config.Drops.ScatterMax
	local expires = os.clock() + Config.Drops.Lifetime
	local out: { { any } } = {}
	local removed: { number } = {}
	refreshFilter()
	for _, v in values do
		-- over the cap (nobody is collecting): the oldest orb fades away to make room,
		-- exactly as if it had timed out
		if #bag.List >= Config.Drops.MaxPerPlayer then
			local oldest = 1
			for i, d in bag.List do
				if d.Expires < bag.List[oldest].Expires then
					oldest = i
				end
			end
			table.insert(removed, bag.List[oldest].Id)
			bag.List[oldest] = bag.List[#bag.List]
			bag.List[#bag.List] = nil
		end
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber(sMin, sMax)
		local x = origin.X + math.cos(a) * r
		local z = origin.Z + math.sin(a) * r
		-- keep orbs inside the playable area
		x = math.clamp(x, -Config.Layout.HalfWidth + 4, Config.Layout.HalfWidth - 4)
		local y = groundAt(x, origin.Y, z) + 1.1
		local drop: Drop = { Id = bag.NextId, Pos = Vector3.new(x, y, z), Value = v, Expires = expires }
		bag.NextId += 1
		table.insert(bag.List, drop)
		table.insert(out, { drop.Id, drop.Pos, drop.Value } :: { any })
	end
	if #out > 0 then
		dropsRemote:FireClient(player, origin, out, removed)
	end
end

local function pickupTick()
	local t = os.clock()
	for player, bag in bags do
		if #bag.List == 0 then
			continue
		end
		local root = Remotes.Root(player)
		local radius = PlayerInfo.PickupRadius(player) + 1.5 -- latency slack
		local r2 = radius * radius
		local got = 0
		local ids = {}
		local i = 1
		while i <= #bag.List do
			local d = bag.List[i]
			local take = false
			if root then
				local dx = d.Pos.X - root.Position.X
				local dz = d.Pos.Z - root.Position.Z
				take = dx * dx + dz * dz <= r2 and math.abs(d.Pos.Y - root.Position.Y) < 14
			end
			if take then
				got += d.Value
				table.insert(ids, d.Id)
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			elseif t >= d.Expires then
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			else
				i += 1
			end
		end
		if got > 0 then
			DataService.AddEcto(player, got)
			collectRemote:FireClient(player, ids, got)
			collectedSignal:Fire(player, got)
		end
	end
end

function DropService.Init()
	dropsRemote = Net.Event("Drops")
	collectRemote = Net.Event("Collect")
end

function DropService.Start()
	local function add(player: Player)
		bags[player] = { List = {}, NextId = 1 }
	end
	Players.PlayerAdded:Connect(add)
	for _, pl in Players:GetPlayers() do
		add(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		bags[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Drops.PickupTick)
			local ok, err = pcall(function()
				pickupTick()
			end)
			if not ok then
				warn("[Drops] tick error: " .. tostring(err))
			end
		end
	end)
end

return DropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST: a periodic server-wide boss everyone can attack. Spirit scales with the
-- crews in the server; rewards scale with each participant's share of the damage.
-- Client messages (Fx "Boss"): { State = "Warning"|"Active"|"Defeated"|"Escaped", At = serverTime, Uid?, EndsAt? }
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local GhostService = require(script.Parent.GhostService)
local DropService = require(script.Parent.DropService)
local Fx = require(script.Parent.Fx)

local EventService = {}

local current: GhostService.Ghost? = nil
local state = "Idle"
local endsAt = 0
local rng = Random.new()

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function spiritFor(): number
	-- only crews near the arena count (late-game players elsewhere on the map must not make
	-- the boss unbeatable for the players who are actually there)
	local sum = 0
	local arena = Config.Layout.EventArena.Center
	for _, pl in Players:GetPlayers() do
		local char = pl.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - arena).Magnitude <= Config.Event.JoinRadius then
			sum += math.min(HunterService.CrewPower(pl), Config.Event.PowerCap)
		end
	end
	return Config.Event.SpiritBase + Config.Event.SpiritPerPower * sum
end

local function reward(g: GhostService.Ghost)
	local total = 0
	local participants = {}
	for player, dmg in g.Damage do
		-- counts if they dealt 1% of the boss, or ~MinSeconds of their own crew's damage (so a
		-- small crew fighting next to a huge one still participates)
		local ownShare = HunterService.CrewPower(player) * Config.Event.MinSeconds
		if player.Parent and dmg > 0 and (dmg >= g.Max * Config.Event.MinContribution or dmg >= ownShare) then
			table.insert(participants, player)
			total += dmg
		end
	end
	local arena = Config.Layout.EventArena
	for _, player in participants do
		local d = DataService.Get(player)
		if d then
			local share = Rules.EventShare(g.Damage[player], total, #participants, Config.Event.MinShare, Config.Event.MaxShare)
			local amount = Config.Event.RewardBase * PlayerInfo.ZoneMultiplier(player) * share * PlayerInfo.EctoMultiplier(player)
			amount = math.floor(amount + 0.5)
			-- Ectoplasm shower over the arena
			DropService.Spawn(player, arena.Center + Vector3.new(0, 12, 0), amount, Config.Event.RewardDrops, { 4, arena.Radius - 4 })
			d.Stats.Events += 1
			Fx.Toast(player, "GIANT POLTERGEIST DEFEATED! +" .. Format.Commas(amount) .. " Ectoplasm incoming!", "Good")
		end
	end
end

local function runEvent()
	if state ~= "Idle" then
		return
	end
	local arena = Config.Layout.EventArena
	state = "Warning"
	Fx.All("Boss", { State = "Warning", At = serverNow() + Config.Event.WarningSeconds, Pos = arena.Center })
	task.wait(Config.Event.WarningSeconds)
	if #Players:GetPlayers() == 0 then
		state = "Idle"
		return
	end
	local def = Config.Ghosts[Config.Event.Ghost]
	local g = GhostService.Spawn(def, arena.Center, arena.Radius * 0.35, { Spirit = spiritFor(), Event = true })
	current = g
	state = "Active"
	endsAt = serverNow() + Config.Event.Duration
	g.Model:SetAttribute("EndsAt", endsAt)
	Fx.All("Boss", { State = "Active", Uid = g.Uid, EndsAt = endsAt, Pos = arena.Center })
	while g.Alive and serverNow() < endsAt do
		task.wait(0.2)
	end
	-- `g` is our own reference, so this works no matter how the ghost was removed
	if g.Alive then
		GhostService.Remove(g, nil, false)
		Fx.All("Boss", { State = "Escaped" })
	else
		Fx.All("Boss", { State = "Defeated", Pos = GhostService.Position(g) })
		reward(g)
	end
	current = nil
	state = "Idle"
end

-- Runs one event safely: an error can never leave the event system stuck.
local function runSafely()
	local ok, err = pcall(function()
		runEvent()
	end)
	if not ok then
		warn("[Event] " .. tostring(err))
		if current and current.Alive then
			pcall(GhostService.Remove, current, nil, false)
		end
		Fx.All("Boss", { State = "Escaped" })
		state = "Idle"
		current = nil
	end
end

function EventService.Init()
	-- late joiners see the current boss
	DataService.Loaded:Connect(function(player)
		if state == "Active" and current then
			Fx.To(player, "Boss", { State = "Active", Uid = current.Uid, EndsAt = endsAt, Pos = Config.Layout.EventArena.Center })
		end
	end)
end

function EventService.Start()
	task.spawn(function()
		task.wait(Config.Event.FirstDelay)
		while true do
			runSafely()
			task.wait(Config.Event.Interval + rng:NextNumber(-30, 30))
		end
	end)
end

-- Studio/testing helper: start an event now (used by the admin command in Main).
function EventService.TriggerNow()
	task.spawn(runSafely)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Server → client effect/announcement messages over the "Fx" remote.
-- Kinds: Poof, Announce, ZoneUnlocked, Boss, Toast, Upgrade, Daily (see docs/ARCHITECTURE.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("GH").Net)

local Fx = {}
local remote: RemoteEvent

function Fx.Init()
	remote = Net.Event("Fx")
end

function Fx.All(kind: string, data: any?)
	remote:FireAllClients(kind, data)
end

-- Everyone except one player (e.g. the opener of a legendary crate, who sees the reveal).
function Fx.AllExcept(except: Player, kind: string, data: any?)
	for _, pl in game:GetService("Players"):GetPlayers() do
		if pl ~= except then
			remote:FireClient(pl, kind, data)
		end
	end
end

function Fx.To(player: Player, kind: string, data: any?)
	remote:FireClient(player, kind, data)
end

function Fx.Toast(player: Player, text: string, color: string?)
	remote:FireClient(player, "Toast", { Text = text, Color = color })
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">GhostService</string>
            <string name="Source"><![CDATA[--!strict
-- Ghost spawning, wandering, targeting and server-authoritative damage.
--
-- Movement is NOT simulated per frame on the server. Each ghost has a straight wander segment
-- (attributes From, To, T0, Dur in server time); the server evaluates the position only when it
-- needs it (range checks, drops) and every client animates the model locally along the same
-- segment. One loop handles all ghosts, so there is no per-ghost Heartbeat connection.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)
local Signal = require(GH.Signal)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local DropService = require(script.Parent.DropService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local GhostService = {}

export type Ghost = {
	Uid: number,
	Def: Config.GhostDef,
	Model: Model,
	Spirit: number,
	Max: number,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	NextMove: number,
	Center: Vector3,
	Radius: number,
	Alive: boolean,
	Event: boolean,
	Area: number?, -- index into Config.Layout.GhostAreas (nil for event ghosts)
	Damage: { [Player]: number },
	DirtySpirit: boolean,
}

local buildHitbox: (Config.GhostDef, Vector3) -> Model
local ghosts: { [number]: Ghost } = {}
local nextUid = 1
local folder: Folder
local rng = Random.new()

-- Ready = os.clock() when damage may start (hunters need time to run over).
-- Auto = picked by the Auto Attack pass (manual picks are never replaced automatically).
type Target = { Uid: number, Ready: number, Auto: boolean }
local targets: { [Player]: Target } = {}

-- Auto Attack toggle (session only, default OFF). Only honoured while the player owns the pass.
local autoOn: { [Player]: boolean } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local killedSignal = Signal.new()
GhostService.Killed = killedSignal -- (ghost: Ghost, killer: Player?) by reference

local function now(): number
	return workspace:GetServerTimeNow()
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function GhostService.Position(g: Ghost, t: number?): Vector3
	local a = if g.Dur > 0 then math.clamp(((t or now()) - g.T0) / g.Dur, 0, 1) else 1
	return g.From:Lerp(g.To, smooth(a))
end

function GhostService.Get(uid: number): Ghost?
	return ghosts[uid]
end

function GhostService.All(): { [number]: Ghost }
	return ghosts
end

local function randomPoint(center: Vector3, radius: number, hover: number): Vector3
	local a = rng:NextNumber() * math.pi * 2
	local r = math.sqrt(rng:NextNumber()) * radius
	return Vector3.new(center.X + math.cos(a) * r, center.Y + hover, center.Z + math.sin(a) * r)
end

-- A random point that keeps clear of the other live ghosts of the same spawn area (first try
-- that leaves `spacing` studs, else the roomiest of a few tries), so ghosts don't stack and
-- each one stays easy to tap.
local SPREAD_TRIES = 5
local function spacedPoint(center: Vector3, radius: number, hover: number, area: number?, self: Ghost?, spacing: number): Vector3
	local best, bestGap = randomPoint(center, radius, hover), -1
	if area == nil then
		return best
	end
	local want = spacing * spacing
	for i = 1, SPREAD_TRIES do
		local p = if i == 1 then best else randomPoint(center, radius, hover)
		local gap = math.huge
		for _, o in ghosts do
			if o ~= self and o.Alive and o.Area == area then
				local q = o.To
				local dx, dz = p.X - q.X, p.Z - q.Z
				gap = math.min(gap, dx * dx + dz * dz)
			end
		end
		if gap >= want then
			return p
		end
		if gap > bestGap then
			best, bestGap = p, gap
		end
	end
	return best
end

local function setSegment(g: Ghost, to: Vector3)
	local t = now()
	local from = GhostService.Position(g, t)
	g.From = from
	g.To = to
	g.T0 = t
	g.Dur = math.max(0.5, (to - from).Magnitude / math.max(g.Def.Speed, 0.1))
	g.NextMove = t + g.Dur + rng:NextNumber(0.4, g.Def.Wander)
	local m = g.Model
	m:SetAttribute("From", g.From)
	m:SetAttribute("To", g.To)
	m:SetAttribute("T0", g.T0)
	m:SetAttribute("Dur", g.Dur)
end

-- The server's ghost is only an invisible, generously sized tap target (Core) with the
-- attachments beams and labels use. Every client builds the visual rig (GhostRig) locally,
-- so a kill/respawn replicates one part instead of a whole model.
function buildHitbox(def: Config.GhostDef, pos: Vector3): Model
	local s = def.Scale
	local model = Instance.new("Model")
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(1, 1, 1) * (Config.Combat.HitboxDiameter * s)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = true
	core.CastShadow = false
	core.CFrame = CFrame.new(pos)
	core.Parent = model
	local attachments: { [string]: number } = { Center = 0, Top = 2.4 * s, Bottom = -2.1 * s }
	for name, y in attachments do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = Vector3.new(0, y, 0)
		a.Parent = core
	end
	model.PrimaryPart = core
	return model
end

-- Creates a ghost. `spirit` overrides the config value (event ghost scaling).
export type SpawnOpts = { Spirit: number?, Event: boolean?, Area: number? }

function GhostService.Spawn(def: Config.GhostDef, center: Vector3, radius: number, opts: SpawnOpts?): Ghost
	local o: SpawnOpts = opts or {}
	local uid = nextUid
	nextUid += 1
	local spirit = math.floor(o.Spirit or def.Spirit)
	local pos = spacedPoint(center, radius, def.Hover, o.Area, nil, Config.Combat.HitboxDiameter * def.Scale * 1.4)
	local model = buildHitbox(def, pos)
	model.Name = "Ghost_" .. uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("GhostId", def.Id)
	model:SetAttribute("Spirit", spirit)
	model:SetAttribute("MaxSpirit", spirit)
	model:SetAttribute("Zone", def.Zone)
	model:SetAttribute("Event", o.Event == true)
	local g: Ghost = {
		Uid = uid,
		Def = def,
		Model = model,
		Spirit = spirit,
		Max = spirit,
		From = pos,
		To = pos,
		T0 = now(),
		Dur = 0,
		NextMove = 0,
		Center = center,
		Radius = radius,
		Alive = true,
		Event = o.Event == true,
		Area = o.Area,
		Damage = {},
		DirtySpirit = false,
	}
	ghosts[uid] = g
	setSegment(g, pos)
	g.NextMove = now() + rng:NextNumber(0, def.Wander)
	model.Parent = folder
	return g
end

local function rootPos(player: Player): Vector3?
	local root = Remotes.Root(player)
	return if root then root.Position else nil
end

local function setTarget(player: Player, uid: number?, auto: boolean?)
	local g = uid and ghosts[uid]
	if uid and g then
		-- damage starts once the crew could plausibly have run to the ghost
		local p = rootPos(player)
		local run = if p then (GhostService.Position(g) - p).Magnitude / Config.Combat.HunterRunSpeed else 0
		targets[player] = { Uid = uid, Ready = os.clock() + Config.Combat.EngageDelay + math.min(run, 2), Auto = auto == true }
		player:SetAttribute("Target", uid)
	else
		targets[player] = nil
		player:SetAttribute("Target", 0)
	end
end

function GhostService.AutoActive(player: Player): boolean
	return autoOn[player] == true and PlayerInfo.HasPass(player, Config.AutoAttack.Pass)
end

-- Auto Attack pick: nearest living ghost the player may fight, in the zone the player is
-- standing in (so hunters never run through zone walls), within Config.AutoAttack.Range.
local function autoCandidate(player: Player): Ghost?
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not d or not p then
		return nil
	end
	local here = Rules.ZoneIndexAt(p.Z, zoneRanges)
	local best, bestDist = nil, Config.AutoAttack.Range
	local t = now()
	for _, g in ghosts do
		local zone = Config.ZoneById[g.Def.Zone]
		if g.Alive and zone and zone.Order == here and d.Zones[zone.Id] then
			local dist = (GhostService.Position(g, t) - p).Magnitude
			if dist < bestDist then
				best, bestDist = g, dist
			end
		end
	end
	return best
end

-- Removes a ghost. reward=false for escapes/cleanup.
function GhostService.Remove(g: Ghost, killer: Player?, reward: boolean)
	if not g.Alive then
		return
	end
	g.Alive = false
	ghosts[g.Uid] = nil
	local pos = GhostService.Position(g)
	g.Model:SetAttribute("Spirit", 0)
	g.Model:SetAttribute("Dead", true)
	Fx.All("Poof", {
		Uid = g.Uid,
		Pos = pos,
		Scale = g.Def.Scale,
		Color = g.Def.Glow,
		Big = g.Def.Kind ~= "Normal",
		Escaped = not reward,
	})
	task.delay(1.2, function()
		g.Model:Destroy()
	end)

	if reward and not g.Event then
		-- helpers get their own drops; the bar to count as a helper drops when many crews pile on
		local helpers = 0
		for player in g.Damage do
			if player.Parent then
				helpers += 1
			end
		end
		local minShare = g.Max * math.min(Config.Combat.ContributorShare, 0.5 / math.max(helpers, 1))
		for player, dmg in g.Damage do
			if player.Parent and (player == killer or dmg >= minShare) then
				local d = DataService.Get(player)
				if d then
					local base = rng:NextInteger(g.Def.Reward[1], g.Def.Reward[2])
					local total = math.max(1, math.floor(base * PlayerInfo.EctoMultiplier(player) + 0.5))
					DropService.Spawn(player, pos, total, g.Def.Drops, nil)
					d.Stats.Ghosts += 1
				end
			end
		end
	end
	if reward then
		killedSignal:Fire(g, killer)
	end

	-- Hunters on this ghost come home. Only Auto Attack owners with the toggle ON get a new
	-- ghost picked for them; everyone else chooses their next ghost by clicking/tapping it.
	for player, tg in targets do
		if tg.Uid == g.Uid then
			local nextG = if GhostService.AutoActive(player) then autoCandidate(player) else nil
			setTarget(player, if nextG then nextG.Uid else nil, true)
		end
	end

	if g.Area then
		local area = Config.Layout.GhostAreas[g.Area]
		task.delay(g.Def.Respawn, function()
			GhostService.Spawn(g.Def, area.Center, area.Radius, { Area = g.Area })
		end)
	end
end

local function onSelect(player: Player, uid: any)
	if not Remotes.Allow(player, "SelectTarget") then
		return
	end
	if uid == nil or uid == 0 then
		setTarget(player, nil)
		return
	end
	if type(uid) ~= "number" then
		return
	end
	local g = ghosts[uid]
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not g or not g.Alive or not d or not p then
		return
	end
	if not d.Zones[g.Def.Zone] then
		Fx.Toast(player, "Unlock " .. (Config.ZoneById[g.Def.Zone] :: Config.ZoneDef).Name .. " first!", "Bad")
		return
	end
	if (GhostService.Position(g) - p).Magnitude > Config.Combat.MaxRange + 15 then
		Fx.Toast(player, "Get closer to that ghost!", "Bad")
		return
	end
	local cur = targets[player]
	if cur and cur.Uid == uid then
		cur.Auto = false -- the player chose it: Auto Attack OFF won't drop it
		return
	end
	setTarget(player, uid, false)
end

-- Gives Auto Attack players a ghost whenever their crew is idle.
local function autoTick()
	for player, on in autoOn do
		if on and not targets[player] and player.Parent and GhostService.AutoActive(player) then
			local g = autoCandidate(player)
			if g then
				setTarget(player, g.Uid, true)
			end
		end
	end
end

local function damageTick(dt: number)
	local t = now()
	local clock = os.clock()
	for player, tg in targets do
		local g = ghosts[tg.Uid]
		if not g or not g.Alive or not player.Parent then
			targets[player] = nil
			if player.Parent then
				player:SetAttribute("Target", 0)
			end
			continue
		end
		local p = rootPos(player)
		if not p then
			continue
		end
		local dist = (GhostService.Position(g, t) - p).Magnitude
		if dist > Config.Combat.MaxRange * 1.4 then
			setTarget(player, nil) -- walked away: hunters come home
			continue
		end
		if dist > Config.Combat.MaxRange or clock < tg.Ready then
			continue
		end
		local power = HunterService.CrewPower(player)
		if power <= 0 then
			continue
		end
		local dmg = power * dt
		g.Spirit -= dmg
		g.Damage[player] = (g.Damage[player] or 0) + dmg
		g.DirtySpirit = true
		if g.Spirit <= 0 then
			GhostService.Remove(g, player, true)
		end
	end
	for _, g in ghosts do
		if g.DirtySpirit and g.Alive then
			g.DirtySpirit = false
			g.Model:SetAttribute("Spirit", math.max(0, math.ceil(g.Spirit)))
		end
	end
end

local function moveTick()
	local t = now()
	for _, g in ghosts do
		if g.Alive and t >= g.NextMove then
			setSegment(g, spacedPoint(g.Center, g.Radius, g.Def.Hover, g.Area, g, Config.Combat.HitboxDiameter * g.Def.Scale * 1.4))
		end
	end
end

function GhostService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Ghosts"
	folder.Parent = workspace
	Net.Event("SelectTarget").OnServerEvent:Connect(onSelect)

	-- AUTO ATTACK toggle. Ownership is checked on the server (game pass); the toggle only
	-- automates picking targets: damage, rewards and pickups are exactly the same.
	Remotes.Register("AutoAttack", "Default", function(player, on)
		if type(on) ~= "boolean" then
			return Remotes.Fail("Bad value")
		end
		if on and not PlayerInfo.HasPass(player, Config.AutoAttack.Pass) then
			return Remotes.Fail("Auto Attack is a game pass - see the SHOP!")
		end
		if on then
			autoOn[player] = true
		else
			autoOn[player] = nil
		end
		player:SetAttribute("AutoAttack", on)
		if not on then
			-- back to manual: a ghost Auto Attack picked is dropped, one you chose is kept
			local tg = targets[player]
			if tg and tg.Auto then
				setTarget(player, nil)
			end
		end
		return { ok = true, On = on }
	end)
end

function GhostService.Start()
	for i, area in Config.Layout.GhostAreas do
		local def = Config.Ghosts[area.Ghost]
		for _ = 1, area.Count do
			GhostService.Spawn(def, area.Center, area.Radius, { Area = i })
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		autoOn[player] = nil
		for _, g in ghosts do
			g.Damage[player] = nil
		end
	end)
	task.spawn(function()
		local tick = Config.Combat.TickSeconds
		local last = os.clock()
		local nextAuto = 0
		while true do
			task.wait(tick)
			local c = os.clock()
			-- cap dt so a server hitch can't produce a burst of damage
			local dt = math.min(c - last, tick * 2)
			last = c
			local ok, err = pcall(function()
				damageTick(dt)
				moveTick()
				if c >= nextAuto then
					nextAuto = c + Config.AutoAttack.ScanSeconds
					autoTick()
				end
			end)
			if not ok then
				warn("[Ghosts] tick error: " .. tostring(err))
			end
		end
	end)
end

return GhostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">HunterService</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter inventory, equipping and crate opening (server-authoritative rolls).
-- Replicates each player's crew to everyone through player attributes:
--   Crew = "HunterId,HunterId,..." (equipped order), CrewPower = number.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local HunterService = {}

local rng = Random.new()
local STATION_RANGE = 30

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	local r = h and Config.Rarities[h.Rarity]
	return if r then r.Order else 1
end
HunterService.PowerOf = powerOf
HunterService.RarityOrder = rarityOrder

local function countOwned(d: DataService.Data): number
	local n = 0
	for _ in d.Hunters do
		n += 1
	end
	return n
end

function HunterService.CrewPower(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	return Rules.CrewPower(d.Equipped, d.Hunters, powerOf)
end

-- Pushes the crew to attributes (for everyone's visuals) and re-syncs the owner.
function HunterService.Refresh(player: Player)
	local d = DataService.Get(player)
	if not d then
		return
	end
	local ids = {}
	for _, uid in d.Equipped do
		local h = d.Hunters[uid]
		if h then
			table.insert(ids, h.Id)
		end
	end
	player:SetAttribute("Crew", table.concat(ids, ","))
	player:SetAttribute("CrewPower", Rules.CrewPower(d.Equipped, d.Hunters, powerOf))
	DataService.Changed(player)
end

function HunterService.Add(player: Player, hunterId: string): (string?, boolean)
	local d = DataService.Get(player)
	if not d or not Config.Hunters[hunterId] then
		return nil, false
	end
	local uid = DataService.NewUid(d)
	d.Hunters[uid] = { Id = hunterId, Locked = false, T = os.time() }
	local isNew = not d.Discovered[hunterId]
	d.Discovered[hunterId] = true
	return uid, isNew
end

-- A profile with nothing equipped (new player) gets its best hunters equipped.
local function ensureEquipped(player: Player, d: DataService.Data)
	if #d.Equipped == 0 then
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
	end
end

local function crateRoll(player: Player, crate: Config.CrateDef): string
	return Rules.Roll(crate.Pool :: any, rarityOrder, PlayerInfo.LuckMultiplier(player), Config.LuckAffectsFromOrder, rng:NextNumber())
end

-- Opens one crate. `free` = paid by a free-crate token (daily day 7) instead of Ectoplasm.
local function openCrate(player: Player, crateId: any): any
	if type(crateId) ~= "string" then
		return Remotes.Fail("Bad crate")
	end
	local crate = Config.Crates[crateId]
	local d = DataService.Get(player)
	if not crate or not d then
		return Remotes.Fail("Bad crate")
	end
	if not d.Zones[crate.Zone] then
		return Remotes.Fail("Unlock this zone first!")
	end
	local station = Config.Layout.CrateStations[crateId]
	if not station or not Remotes.Near(player, station, STATION_RANGE) then
		return Remotes.Fail("Walk to the crate first!")
	end
	if countOwned(d) >= Config.Inventory.MaxHunters then
		return Remotes.Fail("Hunter storage full! Release some hunters.")
	end
	local usedFree = false
	if (d.FreeCrates[crateId] or 0) > 0 then
		d.FreeCrates[crateId] -= 1
		if d.FreeCrates[crateId] <= 0 then
			d.FreeCrates[crateId] = nil
		end
		usedFree = true
	elseif not DataService.Spend(player, crate.Price) then
		return Remotes.Fail("Not enough Ectoplasm!")
	end
	local hunterId = crateRoll(player, crate)
	local uid, isNew = HunterService.Add(player, hunterId)
	d.Stats.Crates += 1
	local def = Config.Hunters[hunterId]
	local rarity = Config.Rarities[def.Rarity]
	if rarity.Announce then
		Fx.AllExcept(player, "Announce", {
			Text = string.format("%s hatched a %s %s!", player.DisplayName, rarity.Name, string.upper(def.Name)),
			Color = def.Rarity,
		})
	end
	DataService.Changed(player)
	return { ok = true, Uid = uid, Hunter = hunterId, IsNew = isNew, Free = usedFree, Crate = crateId }
end

local function validUid(d: DataService.Data, uid: any): boolean
	return type(uid) == "string" and #uid < 20 and d.Hunters[uid] ~= nil
end

function HunterService.Init()
	DataService.AddDecorator(function(player, s)
		s.CrewPower = HunterService.CrewPower(player)
	end)

	Remotes.Register("OpenCrate", "OpenCrate", openCrate)

	Remotes.Register("Equip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		if table.find(d.Equipped, uid) then
			return { ok = true }
		end
		if #d.Equipped >= PlayerInfo.Slots(player) then
			return Remotes.Fail("All slots full! Unequip one first.")
		end
		table.insert(d.Equipped, uid)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("Unequip", "Inventory", function(player, uid)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		local i = table.find(d.Equipped, uid)
		if not i then
			return { ok = true }
		end
		if #d.Equipped <= 1 then
			return Remotes.Fail("Keep at least one hunter equipped!")
		end
		table.remove(d.Equipped, i)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("EquipBest", "Inventory", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
		HunterService.Refresh(player)
		return { ok = true, Power = HunterService.CrewPower(player) }
	end)

	Remotes.Register("Lock", "Inventory", function(player, uid, locked)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) or type(locked) ~= "boolean" then
			return Remotes.Fail("Unknown hunter")
		end
		d.Hunters[uid].Locked = locked
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Releases (deletes) unlocked, unequipped hunters for a small refund.
	Remotes.Register("Release", "Inventory", function(player, uids)
		local d = DataService.Get(player)
		if not d or type(uids) ~= "table" or #uids == 0 or #uids > Config.Inventory.MaxHunters then
			return Remotes.Fail("Nothing selected")
		end
		local refund = 0
		local released = 0
		local total = countOwned(d)
		for _, uid in uids do
			if total - released <= 1 then
				break
			end
			if validUid(d, uid) and not table.find(d.Equipped, uid) and not d.Hunters[uid].Locked then
				local def = Config.Hunters[d.Hunters[uid].Id]
				local crate = Config.Crates[(Config.ZoneById[def.Zone] :: Config.ZoneDef).Crate]
				refund += math.floor((if crate then crate.Price else 0) * Config.Inventory.ReleaseRefund)
				d.Hunters[uid] = nil
				released += 1
			end
		end
		if released == 0 then
			return Remotes.Fail("Can't release equipped or locked hunters")
		end
		if refund > 0 then
			DataService.AddEcto(player, refund)
		end
		DataService.Changed(player)
		Fx.Toast(player, string.format("Released %d hunter%s (+%s Ectoplasm)", released, if released == 1 then "" else "s", Format.Commas(refund)))
		return { ok = true, Released = released, Refund = refund }
	end)

	DataService.Loaded:Connect(function(player: Player)
		-- always work on the live profile (never a copy)
		local d = DataService.Get(player)
		if not d then
			return
		end
		if next(d.Hunters) == nil then
			HunterService.Add(player, Config.StarterHunter)
		end
		ensureEquipped(player, d)
		HunterService.Refresh(player)
	end)
end

function HunterService.Start()
	Players.PlayerRemoving:Connect(function(player)
		PlayerInfo.Forget(player)
	end)
end

return HunterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PlayerInfo</string>
            <string name="Source"><![CDATA[--!strict
-- Derived per-player numbers (slots, multipliers, radius) from data + game passes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)

local PlayerInfo = {}

-- Game passes owned this session (filled by ShopService).
local passes: { [Player]: { [string]: boolean } } = {}

function PlayerInfo.SetPass(player: Player, key: string, owned: boolean)
	passes[player] = passes[player] or {}
	passes[player][key] = owned
end

function PlayerInfo.HasPass(player: Player, key: string): boolean
	local p = passes[player]
	return p ~= nil and p[key] == true
end

function PlayerInfo.Forget(player: Player)
	passes[player] = nil
end

local function passDef(key: string): Config.PassDef?
	for _, p in Config.GamePasses do
		if p.Key == key then
			return p
		end
	end
	return nil
end

function PlayerInfo.Slots(player: Player): number
	local extra = 0
	local def = passDef("ExtraSlots")
	if def and PlayerInfo.HasPass(player, "ExtraSlots") then
		extra = def.Slots or 0
	end
	return Config.Inventory.BaseSlots + extra
end

function PlayerInfo.BoostActive(d: DataService.Data, boost: string): boolean
	local t = d.Boosts[boost]
	return t ~= nil and t > os.time()
end

function PlayerInfo.AddBoost(d: DataService.Data, boost: string, seconds: number)
	local now = os.time()
	local cur = math.max(d.Boosts[boost] or 0, now)
	d.Boosts[boost] = math.min(cur + seconds, now + Config.Boosts.MaxStackSeconds)
end

function PlayerInfo.EctoMultiplier(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 1
	end
	local up = Config.Upgrades.EctoBonus
	local bonus = Rules.UpgradeValue(up.Levels, d.Upgrades.EctoBonus or 1)
	local passMul = 1
	local def = passDef("DoubleEcto")
	if def and PlayerInfo.HasPass(player, "DoubleEcto") then
		passMul = def.Multiplier or 1
	end
	return Rules.EctoMultiplier(bonus, PlayerInfo.BoostActive(d, "Ecto"), Config.Boosts.Ecto.Multiplier, passMul)
end

function PlayerInfo.LuckMultiplier(player: Player): number
	local d = DataService.Get(player)
	if d and PlayerInfo.BoostActive(d, "Luck") then
		return Config.Boosts.Luck.Multiplier
	end
	return 1
end

function PlayerInfo.PickupRadius(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.PickupRadius or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.PickupRadius.Levels, lv)
end

function PlayerInfo.WalkSpeed(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.MoveSpeed or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.MoveSpeed.Levels, lv)
end

-- Index (1-based) of the furthest unlocked zone, used to scale flat rewards.
function PlayerInfo.BestZone(player: Player): number
	local d = DataService.Get(player)
	local best = 1
	if d then
		for i, z in Config.Zones do
			if d.Zones[z.Id] then
				best = math.max(best, i)
			end
		end
	end
	return best
end

function PlayerInfo.ZoneMultiplier(player: Player): number
	local m = Config.Daily.ZoneMultiplier
	return m[math.min(PlayerInfo.BestZone(player), #m)]
end

function PlayerInfo.Init()
	DataService.AddDecorator(function(player, s)
		s.Slots = PlayerInfo.Slots(player)
		s.EctoMultiplier = PlayerInfo.EctoMultiplier(player)
		s.LuckMultiplier = PlayerInfo.LuckMultiplier(player)
		s.PickupRadius = PlayerInfo.PickupRadius(player)
		s.ZoneMultiplier = PlayerInfo.ZoneMultiplier(player)
		local owned = {}
		for _, p in Config.GamePasses do
			owned[p.Key] = PlayerInfo.HasPass(player, p.Key)
		end
		s.Passes = owned
	end)
end

return PlayerInfo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
-- Zone unlocks (+ keeping players out of locked zones), upgrades, daily reward,
-- settings and tutorial progress.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ProgressService = {}

local GATE_RANGE = 40
local TRAVEL_COOLDOWN = 3 -- seconds between Fast Travel jumps
local lastTravel: { [Player]: number } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function applyWalkSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = PlayerInfo.WalkSpeed(player)
	end
end

-- Daily reward grant (also used by Day 7 crate token).
local function grantReward(player: Player, d: DataService.Data, reward: Config.RewardDef): string
	local mult = PlayerInfo.ZoneMultiplier(player)
	if reward.Amount and reward.Amount > 0 then
		DataService.AddEcto(player, reward.Amount * mult)
	end
	if reward.Boost and reward.Seconds then
		PlayerInfo.AddBoost(d, reward.Boost, reward.Seconds)
	end
	if reward.Crate then
		d.FreeCrates[reward.Crate] = (d.FreeCrates[reward.Crate] or 0) + 1
	end
	if reward.Amount and mult > 1 then
		return (reward.Label:gsub(Format.Commas(reward.Amount), Format.Commas(reward.Amount * mult)))
	end
	return reward.Label
end
ProgressService.GrantReward = grantReward

function ProgressService.Init()
	DataService.AddDecorator(function(_player, s)
		local d = s :: any
		local info = Rules.Daily(os.time(), d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		s.DailyInfo = info
	end)

	Remotes.Register("UnlockZone", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if d.Zones[zone.Id] then
			return { ok = true }
		end
		local prev = Config.Zones[zone.Order - 1]
		if prev and not d.Zones[prev.Id] then
			return Remotes.Fail("Unlock " .. prev.Name .. " first!")
		end
		local gate = Config.Layout.Gates[zone.Id]
		if gate and not Remotes.Near(player, Vector3.new(0, 3, gate.Z), GATE_RANGE) then
			return Remotes.Fail("Walk to the gate first!")
		end
		if not DataService.Spend(player, zone.Cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Zones[zone.Id] = true
		DataService.Changed(player)
		Fx.To(player, "ZoneUnlocked", { Zone = zone.Id })
		return { ok = true }
	end)

	-- Fast Travel (WORLDS menu): only to zones this profile owns, onto the zone's arrival pad.
	Remotes.Register("Travel", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if not d.Zones[zone.Id] then
			return Remotes.Fail("Unlock " .. zone.Name .. " first!")
		end
		local now = os.clock()
		if now - (lastTravel[player] or -math.huge) < TRAVEL_COOLDOWN then
			return Remotes.Fail("Wait a moment...")
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = Remotes.Root(player)
		if not char or not hum or hum.Health <= 0 or not root then
			return Remotes.Fail("Can't travel right now")
		end
		local spawnPos = (Config.Layout.ZoneSpawns :: any)[zone.Id] :: Vector3?
		if not spawnPos then
			return Remotes.Fail("Unknown area")
		end
		lastTravel[player] = now
		-- small random offset so a group travelling together doesn't stack
		local a = math.random() * math.pi * 2
		local r = math.random() * 3
		local pos = spawnPos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		root.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)))
		return { ok = true }
	end)

	Remotes.Register("BuyUpgrade", "Default", function(player, upgradeId)
		local d = DataService.Get(player)
		local up = type(upgradeId) == "string" and Config.Upgrades[upgradeId] or nil
		if not d or not up then
			return Remotes.Fail("Unknown upgrade")
		end
		local level = d.Upgrades[up.Id] or 1
		local cost = Rules.UpgradeCost(up.Costs, level)
		if not cost then
			return Remotes.Fail("Already maxed!")
		end
		if not DataService.Spend(player, cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Upgrades[up.Id] = level + 1
		if up.Id == "MoveSpeed" then
			applyWalkSpeed(player)
		end
		DataService.Changed(player)
		return { ok = true, Level = level + 1 }
	end)

	Remotes.Register("ClaimDaily", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		local now = os.time()
		local info = Rules.Daily(now, d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		if not info.CanClaim then
			return Remotes.Fail("Come back in " .. Format.Time(info.Wait))
		end
		local reward = Config.Daily.Rewards[info.Day]
		local streak = if info.Day == 1 then 1 else d.Daily.Streak + 1
		d.Daily.Last = now
		d.Daily.Streak = streak
		local label = grantReward(player, d, reward)
		DataService.Changed(player)
		DataService.Save(player)
		return { ok = true, Day = info.Day, Label = label }
	end)

	Remotes.Register("Setting", "Default", function(player, key, value)
		local d = DataService.Get(player)
		if not d or type(key) ~= "string" or type(value) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		if type((d.Settings :: any)[key]) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		(d.Settings :: any)[key] = value
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Tutorial progress is cosmetic (client-driven guidance); only allow moving forward.
	Remotes.Register("Tutorial", "Default", function(player, step)
		local d = DataService.Get(player)
		if not d or type(step) ~= "number" or step ~= step then
			return Remotes.Fail("Bad step")
		end
		step = math.clamp(math.floor(step), 1, #Config.Tutorial.Steps + 1)
		if step > d.Tutorial then
			d.Tutorial = step
			DataService.Changed(player)
		end
		return { ok = true }
	end)
end

-- Server-side guard: anyone standing in a zone they don't own is moved back to the gate.
local function zoneGuardTick()
	for _, player in Players:GetPlayers() do
		local d = DataService.Get(player)
		local root = Remotes.Root(player)
		if not d or not root then
			continue
		end
		local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
		local zone = Config.Zones[idx]
		if zone and not d.Zones[zone.Id] then
			-- find the furthest owned zone and drop them in front of its exit gate
			local safeZ = Config.Layout.Spawn.Z
			for i = idx - 1, 1, -1 do
				local z = Config.Zones[i]
				if d.Zones[z.Id] then
					local nextZone = Config.Zones[i + 1]
					local gate = nextZone and Config.Layout.Gates[nextZone.Id]
					safeZ = if gate then gate.Z - 12 else z.MinZ + 20
					break
				end
			end
			local char = player.Character
			if char then
				char:PivotTo(CFrame.new(math.clamp(root.Position.X, -10, 10), 4, safeZ))
			end
		end
	end
end

function ProgressService.Start()
	local function setup(player: Player, char: Model)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			applyWalkSpeed(player)
			-- players pass through each other: characters go in their own collision group
			for _, part in char:GetDescendants() do
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end
			char.DescendantAdded:Connect(function(part)
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end)
		end
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			setup(player, char)
		end)
		-- a character that spawned while the world was still building
		if player.Character then
			task.spawn(setup, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(player)
		lastTravel[player] = nil
	end)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	DataService.Loaded:Connect(function(player)
		applyWalkSpeed(player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				zoneGuardTick()
			end)
			if not ok then
				warn("[Zones] guard error: " .. tostring(err))
			end
		end
	end)
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Validated, rate-limited request dispatcher. Clients call
--   Request:InvokeServer(action, ...) -> { ok: boolean, err: string?, ... }
-- Handlers never trust arguments: they type-check everything they receive.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)

local Remotes = {}

type Handler = (Player, ...any) -> any
local handlers: { [string]: { fn: Handler, bucket: string } } = {}
local limiters: { [string]: Rules.Limiter } = {}

local function limiter(bucket: string): Rules.Limiter
	local l = limiters[bucket]
	if not l then
		local def = (Config.RateLimits :: any)[bucket] or Config.RateLimits.Default
		l = Rules.NewLimiter(def.Count, def.Window)
		limiters[bucket] = l
	end
	return l
end

function Remotes.Allow(player: Player, bucket: string): boolean
	return Rules.Allow(limiter(bucket), tostring(player.UserId), os.clock())
end

function Remotes.Register(action: string, bucket: string, fn: Handler)
	assert(not handlers[action], "duplicate action " .. action)
	handlers[action] = { fn = fn, bucket = bucket }
end

function Remotes.Init()
	local rf = Net.Function("Request")
	rf.OnServerInvoke = function(player: Player, action: any, ...: any): any
		if type(action) ~= "string" then
			return { ok = false, err = "Bad request" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, err = "Unknown action" }
		end
		if not Remotes.Allow(player, h.bucket) then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(h.fn, player, ...)
		if not ok then
			warn(string.format("[Remotes] %s from %s errored: %s", action, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		if type(result) ~= "table" then
			return { ok = result == true }
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		local key = tostring(player.UserId)
		for _, l in limiters do
			l.hits[key] = nil
		end
	end)
end

-- Helpers for handlers
function Remotes.Fail(err: string): any
	return { ok = false, err = err }
end

function Remotes.Root(player: Player): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Remotes.Near(player: Player, pos: Vector3, maxDist: number): boolean
	local root = Remotes.Root(player)
	return root ~= nil and (root.Position - pos).Magnitude <= maxDist
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux shop: developer products (Ectoplasm packs, boosts) and game passes.
-- ProcessReceipt is idempotent: receipts are recorded in the profile and saved before
-- returning PurchaseGranted, so a purchase is never lost or granted twice.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ShopService = {}

local function productById(id: number): Config.ProductDef?
	for _, p in Config.Products do
		if p.ProductId == id then
			return p
		end
	end
	return nil
end

local function grantProduct(player: Player, d: DataService.Data, p: Config.ProductDef)
	if p.Kind == "Ecto" and p.Amount then
		DataService.AddEcto(player, p.Amount * PlayerInfo.ZoneMultiplier(player))
	elseif p.Kind == "Boost" and p.Boost and p.Seconds then
		PlayerInfo.AddBoost(d, p.Boost, p.Seconds)
	end
	DataService.Changed(player)
	Fx.Toast(player, "Thanks! " .. p.Name .. " added!", "Good")
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = DataService.WaitFor(player, 20)
	if not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipt = tostring(info.PurchaseId)
	if DataService.HasPurchase(d, receipt) then
		-- already granted in this session; only confirm once it is really saved
		return if DataService.SaveNow(player)
			then Enum.ProductPurchaseDecision.PurchaseGranted
			else Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = productById(info.ProductId)
	if not p then
		warn("[Shop] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(player, d, p)
	DataService.AddPurchase(d, receipt)
	if not DataService.SaveNow(player) then
		-- Roblox will retry the receipt later; our record prevents a double grant in this session
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.PassId then
			local ok, owned = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.PassId :: number)
			end)
			if not player.Parent then
				return -- left while we were asking Roblox
			end
			PlayerInfo.SetPass(player, pass.Key, ok and owned == true)
		end
	end
	HunterService.Refresh(player)
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.PassId == passId then
				PlayerInfo.SetPass(player, pass.Key, true)
				HunterService.Refresh(player)
				Fx.Toast(player, "Thanks! " .. pass.Name .. " unlocked!", "Good")
			end
		end
	end)

	-- Client asks to buy: server validates the key and prompts (ids never come from the client).
	Remotes.Register("Buy", "Default", function(player, key)
		if type(key) ~= "string" then
			return Remotes.Fail("Bad item")
		end
		for _, p in Config.Products do
			if p.Key == key then
				if not p.ProductId then
					return Remotes.Fail("Coming soon!")
				end
				if p.Kind == "Boost" and p.Boost and p.Seconds then
					-- boosts stack up to a cap; don't sell time that would be thrown away
					local d = DataService.Get(player)
					local left = if d then (d.Boosts[p.Boost] or 0) - os.time() else 0
					if left + p.Seconds > Config.Boosts.MaxStackSeconds then
						return Remotes.Fail("That boost is already stacked to the max!")
					end
				end
				MarketplaceService:PromptProductPurchase(player, p.ProductId)
				return { ok = true }
			end
		end
		for _, pass in Config.GamePasses do
			if pass.Key == key then
				if not pass.PassId then
					return Remotes.Fail("Coming soon!")
				end
				if PlayerInfo.HasPass(player, pass.Key) then
					return Remotes.Fail("You already own this!")
				end
				MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
				return { ok = true }
			end
		end
		return Remotes.Fail("Bad item")
	end)

	DataService.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
end

function ShopService.Start() end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">StationService</string>
            <string name="Source"><![CDATA[--!strict
-- Dresses the stations the world builder made: crate display models, odds boards and
-- ProximityPrompts (crates, upgrades, gates). Prompts only open client UI; every purchase
-- goes through validated Requests.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local CrateRig = require(GH.Rigs.CrateRig)

local StationService = {}

local function find(path: { string }): Instance?
	local cur: Instance? = workspace
	for _, name in path do
		cur = cur and cur:FindFirstChild(name)
	end
	return cur
end

local function prompt(parent: Instance, action: string, object: string, attrs: { [string]: any }): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "GHPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonY
	p.Style = Enum.ProximityPromptStyle.Default
	for k, v in attrs do
		p:SetAttribute(k, v)
	end
	p.Parent = parent
	return p
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(25, 10, 45)
	stroke.Parent = t
	t.Parent = parent
	return t
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function buildOddsBoard(board: BasePart, crate: Config.CrateDef)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Odds"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(70, 40, 120), Color3.fromRGB(25, 15, 45))
	grad.Rotation = 90
	grad.Parent = bg
	label(bg, crate.Name, UDim2.fromScale(0.94, 0.13), UDim2.fromScale(0.03, 0.03), crate.Trim)
	label(bg, "💚 " .. Format.Commas(crate.Price) .. " ECTOPLASM", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.1, 0.17), Color3.fromRGB(150, 255, 150))
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, 1, Config.LuckAffectsFromOrder)
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local row = Instance.new("Frame")
		row.Size = UDim2.fromScale(0.92, 0.155)
		row.Position = UDim2.fromScale(0.04, 0.29 + (i - 1) * 0.175)
		row.BackgroundColor3 = rar.Color
		row.BackgroundTransparency = 0.15
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = row
		local g2 = Instance.new("UIGradient")
		g2.Color = ColorSequence.new(rar.Color, rar.Color2)
		g2.Parent = row
		row.Parent = bg
		label(row, string.upper(def.Name), UDim2.fromScale(0.55, 0.55), UDim2.fromScale(0.03, 0.05), Color3.new(1, 1, 1))
		label(row, rar.Name .. "  •  ⚡" .. Format.Commas(def.Power), UDim2.fromScale(0.55, 0.38), UDim2.fromScale(0.03, 0.58), Color3.fromRGB(255, 255, 230))
		label(row, Format.Percent(odds[e.Hunter]), UDim2.fromScale(0.35, 0.8), UDim2.fromScale(0.62, 0.1), Color3.new(1, 1, 1))
	end
	gui.Parent = board
end

function StationService.Init() end

function StationService.Start()
	for crateId, crate in Config.Crates do
		local station = find({ "Map", "Stations", "CrateStation_" .. crateId })
		if not station then
			warn("[Stations] missing CrateStation_" .. crateId)
			continue
		end
		local slot = station:FindFirstChild("DisplaySlot") :: BasePart?
		if slot then
			local rig = CrateRig.Build(crateId)
			rig.Model.Name = "DisplayCrate"
			rig.Model:ScaleTo(1.3)
			rig.Model:PivotTo(CFrame.new(slot.Position - Vector3.new(0, 1.6, 0)))
			rig.Model.Parent = station
			CollectionService:AddTag(rig.Base, "SpinProp")
		end
		local board = station:FindFirstChild("OddsBoard") :: BasePart?
		if board then
			buildOddsBoard(board, crate)
		end
		local anchor = station:FindFirstChild("PromptAnchor")
		if anchor then
			prompt(anchor, "Open Crate", crate.Name .. " • " .. Format.Commas(crate.Price), { Crate = crateId })
		end
	end
	local up = find({ "Map", "Stations", "UpgradeStation", "PromptAnchor" })
	if up then
		prompt(up, "Upgrades", "Upgrade Station", { Station = "Upgrades" })
	end
	for _, zone in Config.Zones do
		local anchor = find({ "Map", "Gates", "Gate_" .. zone.Id, "PromptAnchor" })
		if anchor then
			prompt(anchor, "Unlock", zone.Name .. " • " .. Format.Commas(zone.Cost), { Zone = zone.Id })
		end
	end
end

return StationService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!strict
-- Giant Ghost event arena (workspace.Map.EventArena): a flat rune circle that stays clear
-- (nothing above 0.3 studs inside the radius, nothing in the air up to Y=40), with pumpkin
-- spectators, bleachers on the north/south edges and an entrance sign over the cross street.
-- The rune circle is painted in solid candy colours; only the lamps, the small rim lights
-- and the rim jack-o'-lanterns glow.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Arena = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local function ring(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.4
	local paint = Kit.Vivid(color)
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.1, cz + math.sin(a) * r)
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Kit.Part(parent, V(w, 0.2, segLen), CFrame.lookAt(p, p + tangent), paint)
	end
end

local function bleachers(parent: Instance, cx: number, z0: number, outward: number)
	-- 3 steps rising away from the arena; outward = +1 (north) or -1 (south)
	local cols = { C(160, 90, 255), C(255, 150, 60), C(110, 230, 160) }
	for i = 0, 2 do
		local zA = z0 + outward * (i * 3.5)
		local zB = z0 + outward * 11
		Kit.Box(parent, V(cx - 14, 0, zA), V(cx + 14, 1.6 * (i + 1), zB), cols[i + 1], { Mat = Enum.Material.WoodPlanks, Solid = true })
	end
	-- pumpkin audience on the steps
	for i = 0, 2 do
		for k = -2, 2 do
			if (i + k) % 2 == 0 then
				local z = z0 + outward * (i * 3.5 + 1.75)
				Props.Pumpkin(parent, V(cx + k * 5, 1.6 * (i + 1), z), 2.6, 0, -outward)
			end
		end
	end
	Kit.AddRect(cx - 15, z0, cx + 15, z0 + outward * 12)
end

function Arena.Build(map: Instance)
	local ea = Config.Layout.EventArena
	local cx, cz, r = ea.Center.X, ea.Center.Z, ea.Radius
	local m = Kit.Model(map, "EventArena")

	-- Field (flat, top 0.12)
	local field = Kit.Disc(m, cx, cz, 0.12, r * 2 + 4, 0.4, C(90, 60, 140), { Mat = Enum.Material.Slate, Solid = true, Name = "Field" })
	Kit.Disc(m, cx, cz, 0.16, r * 2 - 6, 0.1, C(120, 80, 190), { Solid = true })
	ring(m, cx, cz, r, 36, 1.4, C(150, 255, 120), 0.32)
	ring(m, cx, cz, r * 0.62, 24, 0.9, C(255, 110, 220), 0.3)
	Kit.Disc(m, cx, cz, 0.3, 10, 0.12, Kit.Vivid(C(150, 255, 160)))
	-- rune spokes and a star
	local spoke, dot = Kit.Vivid(C(190, 120, 255)), Kit.Vivid(C(255, 230, 90))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local p1 = V(cx + math.cos(a) * r * 0.62, 0.25, cz + math.sin(a) * r * 0.62)
		local a2 = a + math.pi * 2 / 6 * 2
		local p2 = V(cx + math.cos(a2) * r * 0.62, 0.25, cz + math.sin(a2) * r * 0.62)
		Props.Beam(m, p1, p2, 0.6, 0.12, spoke)
		local outer = V(cx + math.cos(a) * (r - 3), 0.25, cz + math.sin(a) * (r - 3))
		Kit.Disc(m, outer.X, outer.Z, 0.3, 3, 0.12, dot)
	end

	-- Edge decorations (outside the radius)
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local px, pz = cx + math.cos(a) * (r + 3.5), cz + math.sin(a) * (r + 3.5)
		if math.abs(px) < 134 and not (px < cx and pz > cz - 10 and pz < cz + 26) then
			if i % 2 == 0 then
				Props.Pumpkin(m, V(px, 0, pz), 3.4, cx - px, cz - pz, true)
			else
				Kit.Box(m, V(px - 0.6, 0, pz - 0.6), V(px + 0.6, 4, pz + 0.6), C(60, 40, 90), { Mat = Enum.Material.Metal })
				Kit.Ball(m, 2, V(px, 5, pz), C(150, 255, 140), { Mat = NEON })
			end
		end
	end
	bleachers(m, cx, cz + r + 4, 1)
	bleachers(m, cx, cz - r - 4, -1)

	-- Entrance arch over the cross street on the west side, sign facing -X (toward the road)
	local ax = cx - r - 5
	for _, sz in { -1, 1 } do
		local pz = cz + 7 + sz * 13
		Kit.Box(m, V(ax - 1.2, 0, pz - 1.2), V(ax + 1.2, 22, pz + 1.2), C(110, 70, 200), { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(m, 3, V(ax, 23, pz), Kit.Vivid(C(255, 150, 60)))
	end
	local signCF = CFrame.new(ax, 19, cz + 7) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local sign = Kit.Part(m, V(24, 5, 0.8), signCF, C(45, 25, 80))
	Kit.Part(m, V(25, 6, 0.4), signCF * CFrame.new(0, 0, 0.5), Kit.Vivid(C(255, 110, 220)))
	Kit.Sign(sign, Enum.NormalId.Front, "👻 GIANT GHOST EVENT 👻", C(255, 230, 90))
	-- second sign facing into the arena from the east wall side
	local sign2CF = CFrame.new(cx + r + 4, 9, cz) * CFrame.Angles(0, Kit.FaceYaw(-1, 0), 0)
	local s2 = Kit.Part(m, V(16, 5, 0.6), sign2CF, C(45, 25, 80))
	Kit.Part(m, V(17, 6, 0.3), sign2CF * CFrame.new(0, 0, 0.4), Kit.Vivid(C(150, 255, 120)))
	Kit.Box(m, V(cx + r + 4.6, 0, cz - 0.5), V(cx + r + 5.6, 7, cz + 0.5), C(60, 40, 90))
	Kit.Sign(s2, Enum.NormalId.Front, "GIANT GHOST EVENT", C(150, 255, 140))

	-- lights on two tall poles at the edge
	for _, sz in { -1, 1 } do
		local p = V(cx + r * 0.75, 0, cz + sz * (r + 9))
		Kit.Cyl(m, 26, 1, CFrame.new(p + V(0, 13, 0)), C(60, 40, 90), { Mat = Enum.Material.Metal })
		local lamp = Kit.Ball(m, 3, p + V(0, 27, 0), C(255, 160, 230), { Mat = NEON })
		Kit.Light(lamp, C(255, 170, 230), 40, 1.4)
	end
	-- low, faint haze (a big bright cloud here washed out the rune circle)
	local haze = Kit.Emitter(field, C(200, 140, 255), 1.5, 6, 0.3)
	if haze then
		haze.LightEmission = 0.25
	end

	Kit.AddCircle(cx, cz, r + 6)
	m.PrimaryPart = field
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Boundary</string>
            <string name="Source"><![CDATA[--!strict
-- Ground slabs (top at Y=0), themed outer walls, the two zone-separation walls and the
-- invisible collision walls up to Y=80 that keep players inside and in front of locked gates.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Boundary = {}

local C = Color3.fromRGB
local V = Vector3.new
local INVIS_TOP = 80
local HW = Config.Layout.HalfWidth -- 140
local END = Config.Zones[#Config.Zones].MaxZ -- far end of the map

-- Zone-separation wall look per gate (wall / cap stone / cap ball / painted band).
type WallLook = { Wall: Color3, Cap: Color3, Ball: Color3, Band: Color3, Pumpkins: boolean }
local WALLS: { [string]: WallLook } = {
	Cemetery = { Wall = C(135, 115, 175), Cap = C(185, 170, 220), Ball = C(255, 160, 60), Band = C(150, 255, 120), Pumpkins = true },
	School = { Wall = C(215, 110, 95), Cap = C(250, 230, 210), Ball = C(200, 130, 255), Band = C(200, 120, 255), Pumpkins = true },
	Carnival = { Wall = C(230, 70, 80), Cap = C(255, 240, 215), Ball = C(255, 205, 60), Band = C(70, 140, 255), Pumpkins = false },
	Hospital = { Wall = C(225, 230, 238), Cap = C(150, 200, 235), Ball = C(140, 220, 180), Band = C(110, 190, 255), Pumpkins = false },
	Harbor = { Wall = C(120, 85, 55), Cap = C(70, 110, 150), Ball = C(220, 80, 70), Band = C(60, 200, 200), Pumpkins = false },
	Castle = { Wall = C(140, 140, 155), Cap = C(95, 95, 115), Ball = C(255, 200, 70), Band = C(150, 40, 70), Pumpkins = false },
	SpiritRealm = { Wall = C(60, 50, 95), Cap = C(90, 80, 140), Ball = C(110, 230, 255), Band = C(170, 100, 255), Pumpkins = false },
}

local invisible: (Instance, Vector3, Vector3) -> ()
function invisible(parent: Instance, a: Vector3, b: Vector3)
	-- Roblox caps a part at 2048 studs per axis: split long walls along Z into pieces
	local lo, hi = a:Min(b), a:Max(b)
	if hi.Z - lo.Z > 1000 then
		local n = math.ceil((hi.Z - lo.Z) / 1000)
		local step = (hi.Z - lo.Z) / n
		for i = 0, n - 1 do
			invisible(parent, Vector3.new(lo.X, lo.Y, lo.Z + i * step), Vector3.new(hi.X, hi.Y, lo.Z + (i + 1) * step))
		end
		return
	end
	local p = Kit.Box(parent, a, b, C(255, 255, 255), { Transp = 1, Solid = true, Name = "InvisibleWall", Shadow = false })
	p.CanQuery = false -- never block taps / ground raycasts
end

local function hedgeRun(f: Instance, a: Vector3, b: Vector3)
	-- a/b: opposite corners of the hedge box (Y 0..14)
	Kit.Box(f, a, b, C(70, 160, 85), { Mat = Enum.Material.Grass, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / 16)
	local greens = { C(80, 175, 90), C(95, 190, 100), C(70, 150, 95) }
	for i = 0, n do
		local t = (i + 0.5) / (n + 1)
		local pos = if alongX
			then V(lo.X + (hi.X - lo.X) * t, hi.Y, (lo.Z + hi.Z) / 2)
			else V((lo.X + hi.X) / 2, hi.Y, lo.Z + (hi.Z - lo.Z) * t)
		Kit.Ball(f, 7.5, pos, Kit.Pick(greens), { Mat = Enum.Material.Grass })
	end
end

local function stoneRun(f: Instance, a: Vector3, b: Vector3, wall: Color3, cap: Color3, topBall: Color3, spacing: number)
	Kit.Box(f, a, b, wall, { Mat = Enum.Material.Cobblestone, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	Kit.Box(f, V(lo.X - 0.5, hi.Y, lo.Z - 0.5), V(hi.X + 0.5, hi.Y + 1.2, hi.Z + 0.5), cap, { Mat = Enum.Material.Slate })
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / spacing)
	local ball = Kit.Vivid(topBall)
	for i = 0, n do
		local t = i / math.max(n, 1)
		local cx = if alongX then lo.X + (hi.X - lo.X) * t else (lo.X + hi.X) / 2
		local cz = if alongX then (lo.Z + hi.Z) / 2 else lo.Z + (hi.Z - lo.Z) * t
		local half = if alongX then V(2.5, 0, (hi.Z - lo.Z) / 2 + 1) else V((hi.X - lo.X) / 2 + 1, 0, 2.5)
		Kit.Box(f, V(cx, 0, cz) - half, V(cx, hi.Y + 3, cz) + half, cap, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(f, 2.6, V(cx, hi.Y + 4.3, cz), ball) -- candy-coloured cap ball (solid, not glowing)
	end
end

local function brickRun(f: Instance, a: Vector3, b: Vector3, spacing: number)
	stoneRun(f, a, b, C(215, 110, 95), C(250, 230, 210), C(200, 130, 255), spacing)
end

function Boundary.Build(map: Instance)
	local f = Kit.Folder(map, "Boundary")
	local W = HW + 6 -- outer face of the visible walls

	-- Ground (top surface Y = 0), wider than the play area so the walls sit on grass.
	Kit.Box(f, V(-190, -4, -100), V(190, 0, 260), C(105, 195, 100), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Neighborhood" })
	Kit.Box(f, V(-190, -4, 260), V(190, 0, 540), C(80, 160, 120), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Cemetery" })
	Kit.Box(f, V(-190, -4, 540), V(190, 0, 880), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_School" })

	-- Neighborhood: hedges (sides + behind spawn)
	hedgeRun(f, V(-W, 0, -66), V(-HW, 14, 260))
	hedgeRun(f, V(HW, 0, -66), V(W, 14, 260))
	hedgeRun(f, V(-W, 0, -66), V(W, 14, -60))
	-- Cemetery: mossy stone with mint cap balls
	stoneRun(f, V(-W, 0, 263), V(-HW, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	stoneRun(f, V(HW, 0, 263), V(W, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	-- School: brick with purple tops (sides + far end)
	brickRun(f, V(-W, 0, 543), V(-HW, 14, 877), 30)
	brickRun(f, V(HW, 0, 543), V(W, 14, 877), 30)
	-- Zones 4-8 build their own ground, side walls and outside scenery (see their builders).

	-- Zone separation walls with the gate opening centred on X = 0.
	for id, gate in Kit.Gates(Config.Layout) do
		local z = gate.Z
		local half = gate.Width / 2
		local h = 18
		local look = WALLS[id] or WALLS.School
		for _, s in { -1, 1 } do
			stoneRun(f, V(s * (half + 8), 0, z - 3), V(s * W, h, z + 3), look.Wall, look.Cap, look.Ball, 24)
		end
		-- painted band along the wall faces
		local band = Kit.Vivid(look.Band)
		for _, s in { -1, 1 } do
			for _, fz in { -1, 1 } do
				Kit.Box(f, V(s * (half + 6), 3, z + fz * 3.05), V(s * (W - 1), 3.6, z + fz * 3.25), band)
			end
			invisible(f, V(s * half, 0, z - 3), V(s * W, INVIS_TOP, z + 3))
		end
		-- above the arch beam (beam fills Y 30..36 of the opening)
		invisible(f, V(-half, 36, z - 3), V(half, INVIS_TOP, z + 3))
		-- pumpkins along the wall top on the approach side (the spooky-town zones only)
		for i = 1, if look.Pumpkins then 4 else 0 do
			for _, s in { -1, 1 } do
				local x = s * (half + 12 + i * 26)
				Props.Pumpkin(f, V(x, h + 1.2, z - 1.5), 3.6, 0, -1)
			end
		end
	end

	-- Invisible outer walls (play area is |X| <= 140, Z -60..END)
	invisible(f, V(-W, 0, -66), V(-HW, INVIS_TOP, END + 6))
	invisible(f, V(HW, 0, -66), V(W, INVIS_TOP, END + 6))
	invisible(f, V(-W, 0, -66), V(W, INVIS_TOP, -60))
	invisible(f, V(-W, 0, END), V(W, INVIS_TOP, END + 6))

	-- Outer scenery: soft purple hills and big trees just beyond the walls.
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i = 0, 9 do -- zones 1-3 (Z < 880)
		local z = -40 + i * 95
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 185, -12, z + s * 20), Kit.Pick(hill), { Mat = Enum.Material.Grass })
		end
	end
	for i = 0, 6 do
		local z = -30 + i * 140
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 156, 0, z), 22 + Kit.Rng:NextNumber(0, 10))
		end
	end
end

return Boundary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GHOST HUNTER SIMULATOR: procedural world builder. Call Builder.Build() once at server start.

	Layout (studs, +Z forward; ground top is Y = 0 everywhere walkable; play area |X| <= 140):

	  Z -60 ........ hedge wall behind spawn
	  Z -60..-36     Ghost Hunter HQ building (behind spawn)
	  Z   0          Spawn plaza (SpawnLocation at Config.Layout.Spawn, faces +Z)
	  Z  28          Beginner crate station (X -28, beacon) | Upgrade booth (X +28)
	  Z -36..260     ZONE 1 NEIGHBORHOOD: main road X -10..10 up to the gate, cross street
	                 Z 110..124 east to the Event Arena (95, 110, r32); houses on a 30-stud grid
	                 wherever ghost areas / roads / stations leave room.
	  Z 260          Stone wall + Gate_Cemetery (34-wide opening at X = 0)
	  Z 260..540     ZONE 2 CEMETERY: cobble path X -8..8, Haunted station (X -28, Z 292),
	                 giant mausoleum (X -122..-78, Z 477..513, spire to Y ~66), crypts, graves.
	  Z 540          Brick wall + Gate_School
	  Z 540..600     School courtyard: Elite station (X -28, Z 572), ghost bus, flagpole.
	  Z 600..860     ZONE 3 SCHOOL building (open-topped, see School.luau), clock tower to Y ~104.
	  Z 880          Gate_Carnival
	  Z 880..1220    ZONE 4 ABANDONED CARNIVAL (Carnival.luau)
	  Z 1220..1560   ZONE 5 HAUNTED HOSPITAL (Hospital.luau)
	  Z 1560..1920   ZONE 6 GHOST SHIP HARBOR (Harbor.luau)
	  Z 1920..2280   ZONE 7 CURSED CASTLE (Castle.luau)
	  Z 2280..2680   ZONE 8 SPIRIT REALM (SpiritRealm.luau); far wall at Z 2680.
	  Every zone from the Cemetery on: gate wall at its MinZ (Boundary + Gates), crate station at
	  (-28, MinZ + 32), Fast Travel arrival pad at Config.Layout.ZoneSpawns (kept free), main path
	  along X = 0 to the next gate.

	Every ghost area circle from Config.Layout.GhostAreas is registered as a keep-out, so no
	prop taller than ~0.3 studs is placed inside one (flat road paint / cracks / rune lines only).
	Instance tree:
	  workspace.Map.{Boundary, Gates, Stations, EventArena, Neighborhood, Cemetery, School, Carnival,
	                 Hospital, Harbor, Castle, SpiritRealm}
]]

local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local LightingSetup = require(script.Parent.Lighting)
local Boundary = require(script.Parent.Boundary)
local Gates = require(script.Parent.Gates)
local Stations = require(script.Parent.Stations)
local Arena = require(script.Parent.Arena)
local Neighborhood = require(script.Parent.Neighborhood)
local Cemetery = require(script.Parent.Cemetery)
local School = require(script.Parent.School)
local Carnival = require(script.Parent.Carnival)
local Hospital = require(script.Parent.Hospital)
local Harbor = require(script.Parent.Harbor)
local Castle = require(script.Parent.Castle)
local SpiritRealm = require(script.Parent.SpiritRealm)

local Builder = {}

local function registerKeepOuts()
	for _, area in Config.Layout.GhostAreas do
		Kit.AddCircle(area.Center.X, area.Center.Z, area.Radius + 1)
	end
	local spawnPos = Config.Layout.Spawn
	Kit.AddCircle(spawnPos.X, spawnPos.Z, 27)
	for _, gate in Kit.Gates(Config.Layout) do
		Kit.AddRect(-30, gate.Z - 24, 30, gate.Z + 24)
	end
	-- Fast Travel arrival pads
	for _, p in Kit.ZoneSpawns(Config.Layout) do
		Kit.AddCircle(p.X, p.Z, 9)
	end
	-- main path along X = 0 through zones 4-8 (zones 1-3 register their own roads)
	Kit.AddRect(-10, 880, 10, Config.Zones[#Config.Zones].MaxZ, true)
end

function Builder.Build()
	local old = Workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	Kit.Reset()
	registerKeepOuts()

	local map: Folder = Instance.new("Folder")
	map.Name = "Map"

	LightingSetup.Apply()
	Boundary.Build(map)
	Gates.Build(map)
	Stations.Build(map)
	Arena.Build(map)
	Neighborhood.Build(map)
	Cemetery.Build(map)
	School.Build(map)
	Carnival.Build(map)
	Hospital.Build(map)
	Harbor.Build(map)
	Castle.Build(map)
	SpiritRealm.Build(map)

	map.Parent = Workspace
	local s = Kit.Stats
	print(string.format("[GH World] built %d parts (%d neon), %d lights, %d emitters, %d floating, %d flicker", s.Parts, s.Neon, s.Lights, s.Emitters, s.Floating, s.Flicker))
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Carnival</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 4: Abandoned Carnival (Z 880..1220). Bright, candy-striped and only a little spooky.
--   Ground + boardwalk midway along X = 0 (flat paint), painted sawdust rings on the ghost areas
--   ((0,965) r30, (-82,1000) r24, (75,1055) r26, (-62,1115) r24, boss ring (0,1165) r22).
--   Entrance arch at Z 926 (pillars X ±13..19, beam Y 30..38) with two ticket booths.
--   Game stalls along the east side (X 52, Z 948..1006) and one west (X -48, Z 1062),
--   popcorn cart, balloon cart, high striker, prize booth with giant plushies (X ~-96, Z 1058).
--   String lights over the midway between the first ghost area and the boss ring (Z 1005..1130).
--   Landmarks seen from the School: ferris wheel (100, 1182, top ~Y 82), big top (-100, 1180,
--   top ~Y 52) and the carousel (78, 1125).
--   Side walls: red/cream board fence along X ±140..146 with blue posts; outside: hills, a
--   wooden roller coaster and two far tents.
-- Glow is kept to a few bulbs (arch, wheel, carousel, string lights), two lanterns, the striker
-- bell and small purple ectoplasm puddles; everything else is painted wood, fabric and plastic.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Carnival = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.WoodPlanks
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal

local MIN_Z, MAX_Z = 880, 1220
local RED = C(225, 60, 70)
local CREAM = C(255, 240, 215)
local YELLOW = C(255, 205, 60)
local BLUE = C(70, 140, 235)
local PURPLE = C(165, 100, 235)
local PINK = C(255, 140, 190)
local MINT = C(120, 220, 150)
local DARK = C(60, 35, 90)
local ECTO = C(200, 130, 255)
local BULB = C(255, 225, 130)
local WOODC = C(190, 135, 90)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

-- Straight bar between two points in the X/Y plane (wheel rims, spokes, legs).
local function bar(parent: Instance, a: Vector3, b: Vector3, w: number, color: Color3, opts: Kit.Opts?): Part
	local mid = (a + b) / 2
	return Kit.Part(parent, V(w, w, (b - a).Magnitude), CFrame.lookAt(mid, b, V(0, 0, 1)), color, opts)
end

local function glowOpts(glow: boolean): Kit.Opts?
	return if glow then { Mat = NEON } else nil
end

--==================================================================
-- GROUND, WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	-- Same grass as the School slab, which also covers Z 880..920 (no colour flicker there).
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Carnival" })
	-- boardwalk midway with red edges (flat paint)
	Kit.Box(f, V(-9, 0, MIN_Z), V(9, 0.05, MAX_Z), C(220, 170, 120), { Mat = WOOD, Name = "Midway" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, MIN_Z), V(s * 10, 0.06, MAX_Z), Kit.Vivid(RED))
	end
	-- sawdust rings on the ghost areas (flat; ghosts float above them)
	local sawdust = C(240, 215, 165)
	Kit.Disc(f, 0, 965, 0.08, 63, 0.04, Kit.Vivid(YELLOW))
	Kit.Disc(f, 0, 965, 0.1, 58, 0.04, sawdust)
	Kit.Disc(f, -82, 1000, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -82, 1000, 0.1, 47, 0.04, sawdust)
	Kit.Disc(f, 75, 1055, 0.08, 55, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 75, 1055, 0.1, 51, 0.04, sawdust)
	Kit.Disc(f, -62, 1115, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -62, 1115, 0.1, 47, 0.04, sawdust)
	-- boss: circus ring
	Kit.Disc(f, 0, 1165, 0.08, 47, 0.04, Kit.Vivid(RED))
	Kit.Disc(f, 0, 1165, 0.1, 42, 0.04, CREAM)
	Kit.Disc(f, 0, 1165, 0.12, 14, 0.04, Kit.Vivid(YELLOW))
	-- small purple ectoplasm puddles (flat neon accents)
	for _, p in { V(12, 0, 975), V(-75, 0, 1010), V(82, 0, 1046), V(-55, 0, 1122), V(-9, 0, 1172) } do
		Kit.Disc(f, p.X, p.Z, 0.16, 5, 0.04, ECTO, { Mat = NEON, Transp = 0.2 })
	end
end

local function sideWalls(f: Instance)
	-- red/cream board fence, leaving Z MinZ..MinZ+3 and MaxZ-3..MaxZ for the gate walls
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	local n = 16
	local step = (z1 - z0) / n
	local post = Kit.Vivid(BLUE)
	local ball = Kit.Vivid(YELLOW)
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local a = z0 + i * step
			Kit.Box(f, V(s * 140, 0, a), V(s * 146, 12, a + step), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = WOOD, Solid = true })
		end
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13, z1), ball, { Mat = WOOD })
		for i = 2, n - 2, 2 do
			local z = z0 + i * step
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), post, SOLID)
			Kit.Ball(f, 4, V(s * 143, 17, z), ball)
		end
	end
end

-- Round tent: fabric drum + stacked striped tiers + flag. Door faces the midway.
local function tent(f: Instance, x: number, z: number, d: number, c1: Color3, c2: Color3)
	local m = Kit.Model(f, "Tent")
	local fx = if x > 0 then -1 else 1
	Kit.Cyl(m, 8, d, CFrame.new(x, 4, z), c2, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Part(m, V(1.6, 7, d * 0.3), CFrame.new(x + fx * (d / 2 - 0.6), 3.5, z), DARK)
	local sizes = { 1.12, 0.86, 0.6, 0.34 }
	for i, k in sizes do
		Kit.Disc(m, x, z, 8 + i * 2.2, d * k, 2.2, if i % 2 == 1 then c1 else c2, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 3, 0.4, CFrame.new(x, 18.3, z), CREAM)
	Kit.Ball(m, 1.3, V(x, 20, z), Kit.Vivid(YELLOW))
	Kit.Box(m, V(x - 0.1, 18.4, z), V(x + 0.1, 19.8, z + 2.4), c1)
	Kit.AddCircle(x, z, d / 2 + 1.5)
end

local function outside(f: Instance)
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i, z in { 935, 1050, 1165 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 188, -14, z + s * 12), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- wooden roller coaster beyond the east wall
	local heights = { 12, 26, 34, 22, 14, 28, 20, 12 }
	local prev: Vector3? = nil
	for i, h in heights do
		local z = 975 + (i - 1) * 22
		Kit.Box(f, V(171.4, 0, z - 0.6), V(172.6, h, z + 0.6), CREAM, { Mat = WOOD })
		local top = V(172, h + 0.4, z)
		if prev then
			Props.Beam(f, prev, top, 2.6, 0.8, Kit.Vivid(RED))
		end
		prev = top
	end
	-- far tents beyond the west wall
	tent(f, -170, 990, 22, Kit.Vivid(RED), CREAM)
	tent(f, -172, 1105, 20, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	for _, z in { 905, 1205 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 22 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
end

--==================================================================
-- ENTRANCE
--==================================================================
local function entranceArch(f: Instance)
	local m = Kit.Model(f, "CarnivalArch")
	local z = 926
	for _, s in { -1, 1 } do
		for i = 0, 5 do
			Kit.Box(m, V(s * 13, i * 6, z - 3), V(s * 19, i * 6 + 6, z + 3), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, SOLID)
		end
		Kit.Box(m, V(s * 12.4, 0, z - 3.6), V(s * 19.6, 2.5, z + 3.6), Kit.Vivid(BLUE), SOLID)
		Kit.Cyl(m, 4, 8, CFrame.new(s * 16, 40, z), Kit.Vivid(YELLOW))
		Kit.Ball(m, 4.5, V(s * 16, 44, z), Kit.Vivid(RED))
		Kit.AddRect(s * 12, z - 4, s * 20.5, z + 4)
	end
	-- beam (bottom Y 30) + round crest
	Kit.Box(m, V(-22, 30, z - 3.5), V(22, 38, z + 3.5), Kit.Vivid(BLUE), SOLID)
	Kit.CylFlat(m, 3, 20, V(0, 40, z), "Z", Kit.Vivid(YELLOW))
	Kit.Ball(m, 4, V(0, 52, z), Kit.Vivid(RED))
	local sign = Kit.Part(m, V(38, 6, 0.4), CFrame.new(0, 34, z - 3.75), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎪 SPOOKY CARNIVAL 🎪", Kit.Vivid(YELLOW))
	local back = Kit.Part(m, V(30, 4.4, 0.4), CFrame.new(0, 34, z + 3.75) * CFrame.Angles(0, math.pi, 0), DARK)
	Kit.Sign(back, Enum.NormalId.Front, "COME BACK SOON... 👻", CREAM)
	-- bulbs under the beam (every other one glows)
	for i = 0, 8 do
		local glow = i % 2 == 0
		local b = Kit.Ball(m, 1.6, V(-18 + i * 4.5, 29.6, z - 3.6), if glow then BULB else Kit.Vivid(RED), glowOpts(glow))
		if i == 4 then
			Kit.Light(b, C(255, 210, 140), 26, 1.4)
		end
	end
	-- giant "ADMIT ONE" ticket by the gate
	local t = Kit.Part(m, V(12, 5, 0.6), CFrame.new(-62, 3.2, 905) * CFrame.Angles(0, 0.3, 0.1), Kit.Vivid(YELLOW))
	Kit.Sign(t, Enum.NormalId.Front, "ADMIT ONE\n👻 BOO 👻", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-62.5, 0, 904.5), V(-61.5, 1, 905.5), WOODC)
	Kit.AddCircle(-62, 905, 7)
end

local function ticketBooth(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TicketBooth")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	Kit.Part(m, V(7, 8, 6), base * CFrame.new(0, 4, 0), Kit.Vivid(RED), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(m, V(7.4, 1, 6.4), base * CFrame.new(0, 1.5, 0), CREAM)
	Kit.Part(m, V(4.4, 3, 0.3), base * CFrame.new(0, 5, -3.05), C(255, 235, 175))
	Kit.Part(m, V(5.6, 0.5, 1.4), base * CFrame.new(0, 3.3, -3.5), CREAM)
	local sign = Kit.Part(m, V(6.6, 1.5, 0.4), base * CFrame.new(0, 7.3, -3.15), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎟️ TICKETS", Kit.Vivid(YELLOW))
	Kit.Part(m, V(8.4, 1, 7.4), base * CFrame.new(0, 8.5, 0), Kit.Vivid(YELLOW))
	Kit.Cyl(m, 1.6, 7, CFrame.new(x, 9.8, z), Kit.Vivid(RED))
	Kit.Cyl(m, 1.6, 5, CFrame.new(x, 11.4, z), CREAM)
	Kit.Cyl(m, 1.6, 3, CFrame.new(x, 13, z), Kit.Vivid(RED))
	Kit.Ball(m, 1.4, V(x, 14.4, z), Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 6)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ferrisWheel(f: Instance)
	local m = Kit.Model(f, "FerrisWheel")
	local cx, cy, cz = 100, 47, 1182
	local R, N = 34, 20
	Kit.Box(m, V(70, 0, 1170), V(130, 1, 1194), WOODC, { Mat = WOOD, Solid = true })
	local function rim(a: number, dz: number): Vector3
		return V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz + dz)
	end
	local rimCol = Kit.Vivid(RED)
	for _, dz in { -3, 3 } do
		for i = 0, N - 1 do
			bar(m, rim(i / N * math.pi * 2, dz), rim((i + 1) / N * math.pi * 2, dz), 1.2, rimCol, { Mat = METAL })
		end
		for i = 0, 4 do
			local a = i / 5 * math.pi
			bar(m, rim(a, dz), rim(a + math.pi, dz), 0.7, CREAM)
		end
	end
	local hub = Kit.CylFlat(m, 9, 5, V(cx, cy, cz), "Z", Kit.Vivid(YELLOW))
	Kit.CylFlat(m, 10, 2, V(cx, cy, cz), "Z", Kit.Vivid(PURPLE))
	Kit.Light(hub, C(255, 200, 150), 34, 1.3)
	-- A-frame legs + braces
	local leg = C(240, 240, 250)
	for _, dz in { -6, 6 } do
		for _, sx in { -1, 1 } do
			bar(m, V(cx + sx * 22, 1, cz + dz), V(cx, cy, cz + dz * 0.6), 1.6, leg, { Mat = METAL, Solid = true })
		end
		Kit.Box(m, V(cx - 15, 15.5, cz + dz * 0.87 - 0.5), V(cx + 15, 16.5, cz + dz * 0.87 + 0.5), Kit.Vivid(BLUE))
	end
	-- gondolas hang from the spoke ends
	local cabs = { Kit.Vivid(BLUE), Kit.Vivid(YELLOW), Kit.Vivid(MINT), Kit.Vivid(PURPLE), Kit.Vivid(PINK) }
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local p = V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz)
		Kit.CylFlat(m, 6.4, 0.6, p, "Z", C(200, 200, 215))
		Kit.Box(m, p + V(-0.2, -3, -0.2), p + V(0.2, 0, 0.2), C(200, 200, 215))
		Kit.Box(m, p + V(-2.6, -7.2, -2.2), p + V(2.6, -3, 2.2), cabs[i % #cabs + 1], { Shadow = true })
		Kit.Disc(m, p.X, p.Z, p.Y - 2.2, 6.2, 0.8, CREAM)
	end
	-- bulbs between the gondolas on the front rim (half glow)
	for i = 0, 9 do
		local glow = i % 2 == 0
		Kit.Ball(m, 1.8, rim((i + 0.5) / 10 * math.pi * 2, -3.8), if glow then BULB else Kit.Vivid(YELLOW), glowOpts(glow))
	end
	Props.SignBoard(m, V(cx, 6, 1167.5), 16, 3, 0, -1, "🎡 BOO-RIS WHEEL", DARK, Kit.Vivid(YELLOW), RED)
	for _, sx in { -7, 7 } do
		Kit.Box(m, V(cx + sx - 0.4, 0, 1167.4), V(cx + sx + 0.4, 4.5, 1168.2), CREAM)
	end
	Kit.AddRect(66, 1163, 136, 1197)
end

local function carousel(f: Instance)
	local m = Kit.Model(f, "Carousel")
	local cx, cz = 78, 1125
	Kit.Disc(m, cx, cz, 0.6, 32, 0.6, Kit.Vivid(RED), { Solid = true })
	Kit.Disc(m, cx, cz, 1.2, 29, 0.6, CREAM, { Mat = WOOD, Solid = true })
	local column = Kit.Cyl(m, 13, 5, CFrame.new(cx, 7.7, cz), Kit.Vivid(YELLOW), SOLID)
	Kit.Light(column, C(255, 215, 150), 24, 1.2)
	local horses = { CREAM, Kit.Vivid(PINK), Kit.Vivid(C(150, 200, 255)), Kit.Vivid(MINT) }
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local px, pz = cx + math.cos(a) * 10, cz + math.sin(a) * 10
		Kit.Cyl(m, 13, 0.5, CFrame.new(px, 7.7, pz), C(255, 215, 120), { Mat = METAL })
		local base = faced(V(px, 5 + (i % 2) * 1.5, pz), -math.sin(a), math.cos(a))
		local col = horses[i % #horses + 1]
		Kit.Part(m, V(1.6, 1.8, 4.2), base, col)
		Kit.Part(m, V(1.3, 2.6, 1.5), base * CFrame.new(0, 1.6, -2) * CFrame.Angles(0.35, 0, 0), col)
		Kit.Part(m, V(1.2, 2.2, 3.4), base * CFrame.new(0, -1.9, 0), col:Lerp(C(0, 0, 0), 0.15))
	end
	-- striped roof: valance + 12 wedge panels
	Kit.Cyl(m, 2, 32, CFrame.new(cx, 15, cz), CREAM, { Mat = FABRIC })
	local L, h = 16, 7
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local dx, dz = math.cos(a), math.sin(a)
		local cf = CFrame.new(cx + dx * L / 2, 16 + h / 2, cz + dz * L / 2) * CFrame.Angles(0, Kit.FaceYaw(dx, dz), 0)
		Kit.Wedge(m, V(8.8, h, L), cf, if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 2, 3, CFrame.new(cx, 24, cz), Kit.Vivid(YELLOW))
	Kit.Ball(m, 2.6, V(cx, 26, cz), Kit.Vivid(BLUE))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local glow = i % 2 == 0
		Kit.Ball(m, 1.3, V(cx + math.cos(a) * 16.2, 15, cz + math.sin(a) * 16.2), if glow then BULB else Kit.Vivid(BLUE), glowOpts(glow))
	end
	Props.SignBoard(m, V(58.5, 7, cz), 12, 2.6, -1, 0, "🎠 MERRY-GO-BOO", DARK, Kit.Vivid(YELLOW), BLUE)
	for _, dz in { -5, 5 } do
		Kit.Box(m, V(58.2, 0, cz + dz - 0.4), V(59, 5.7, cz + dz + 0.4), CREAM)
	end
	Kit.AddCircle(cx, cz, 17)
	Kit.AddCircle(58.5, cz, 7)
end

local function bigTop(f: Instance)
	local m = Kit.Model(f, "BigTop")
	local cx, cz = -100, 1180
	Kit.Cyl(m, 16, 44, CFrame.new(cx, 8, cz), CREAM, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Cyl(m, 2, 44.6, CFrame.new(cx, 2, cz), Kit.Vivid(RED), { Mat = FABRIC })
	for i, d in { 48, 40, 32, 24, 16, 8 } do
		Kit.Disc(m, cx, cz, 16 + i * 4, d, 4, if i % 2 == 1 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 10, 1, CFrame.new(cx, 45, cz), C(240, 240, 250))
	Kit.Ball(m, 2.2, V(cx, 50.6, cz), Kit.Vivid(YELLOW))
	local flag = Kit.Box(m, V(cx + 0.5, 44, cz - 0.1), V(cx + 8.5, 48.5, cz + 0.1), Kit.Vivid(PURPLE))
	Kit.Sign(flag, Enum.NormalId.Front, "BOO", CREAM)
	-- doorway toward the midway (+X)
	local door = Kit.Box(m, V(cx + 20.5, 0, cz - 6), V(cx + 22.4, 13, cz + 6), DARK)
	Kit.Light(door, ECTO, 22, 1.2)
	for _, dz in { -1, 1 } do
		Kit.Part(m, V(0.6, 13, 3.2), CFrame.new(cx + 22.7, 6.5, cz + dz * 5.4) * CFrame.Angles(0, 0, dz * 0.08), Kit.Vivid(RED), { Mat = FABRIC })
	end
	Props.SignBoard(m, V(cx + 23.2, 14.2, cz), 18, 3.5, 1, 0, "🎪 THE BIG TOP", DARK, Kit.Vivid(YELLOW), RED)
	Kit.AddCircle(cx, cz, 25)
	Props.Wisp(f, V(-68, 0, cz), ECTO, 10, true)
	Kit.AddCircle(-68, cz, 5)
end

--==================================================================
-- STALLS, BOOTHS, CARTS
--==================================================================
local function stall(f: Instance, x: number, z: number, color: Color3, title: string)
	local m = Kit.Model(f, "GameStall")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	local col = Kit.Vivid(color)
	Kit.Part(m, V(12, 10, 1), base * CFrame.new(0, 5, 3.5), col, { Mat = WOOD, Solid = true, Shadow = true })
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 10, 8), base * CFrame.new(sx * 5.5, 5, 0), CREAM, { Mat = WOOD, Solid = true })
	end
	Kit.Part(m, V(10, 3.5, 1.6), base * CFrame.new(0, 1.75, -3.2), CREAM, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(10.2, 0.5, 2), base * CFrame.new(0, 3.75, -3.2), col)
	for i = 0, 3 do
		local cf = base * CFrame.new(-4.875 + i * 3.25, 11, -1) * CFrame.Angles(-0.25, 0, 0)
		Kit.Part(m, V(3.25, 0.5, 10), cf, if i % 2 == 0 then col else CREAM, { Mat = FABRIC })
	end
	Kit.Part(m, V(10, 0.5, 1.4), base * CFrame.new(0, 5.5, 2.4), CREAM)
	local prizes = { Kit.Vivid(PINK), Kit.Vivid(YELLOW), Kit.Vivid(MINT) }
	for i = 0, 2 do
		Kit.Ball(m, 1.9, (base * CFrame.new(-3 + i * 3, 6.7, 2.4)).Position, prizes[i + 1])
	end
	local sign = Kit.Part(m, V(10, 2.4, 0.5), base * CFrame.new(0, 13.6, 3.2), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, title, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 8)
end

local function plushBear(parent: Instance, pos: Vector3, s: number, color: Color3, fx: number, fz: number)
	local base = faced(pos, fx, fz)
	Kit.Ball(parent, s, (base * CFrame.new(0, s * 0.45, 0)).Position, color, { Mat = FABRIC })
	local head = base * CFrame.new(0, s * 1.15, 0)
	Kit.Ball(parent, s * 0.75, head.Position, color, { Mat = FABRIC })
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, s * 0.28, (head * CFrame.new(sx * s * 0.3, s * 0.3, 0)).Position, color, { Mat = FABRIC })
		Kit.Ball(parent, s * 0.1, (head * CFrame.new(sx * s * 0.14, s * 0.06, -s * 0.34)).Position, C(40, 30, 50))
	end
	Kit.Ball(parent, s * 0.28, (head * CFrame.new(0, -s * 0.1, -s * 0.3)).Position, CREAM)
	Kit.Part(parent, V(s * 0.5, s * 0.22, s * 0.15), base * CFrame.new(0, s * 0.85, -s * 0.38), Kit.Vivid(RED))
end

local function plushGhost(parent: Instance, pos: Vector3, s: number)
	Kit.Cyl(parent, s * 0.6, s, CFrame.new(pos + V(0, s * 0.3, 0)), CREAM, { Mat = FABRIC })
	Kit.Ball(parent, s, pos + V(0, s * 0.7, 0), CREAM, { Mat = FABRIC })
	for _, sz in { -1, 1 } do
		Kit.Ball(parent, s * 0.14, pos + V(s * 0.44, s * 0.8, sz * s * 0.16), C(40, 30, 50))
		Kit.Ball(parent, s * 0.12, pos + V(s * 0.42, s * 0.62, sz * s * 0.3), Kit.Vivid(PINK))
	end
end

local function prizeBooth(f: Instance)
	local m = Kit.Model(f, "PrizeBooth")
	Kit.Box(m, V(-106, 0, 1045), V(-86, 1, 1071), WOODC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(-108, 0, 1044), V(-106, 16, 1072), Kit.Vivid(BLUE), { Mat = WOOD, Solid = true })
	for _, z in { 1045, 1071 } do
		Kit.Box(m, V(-87, 1, z - 0.6), V(-85.8, 15, z + 0.6), Kit.Vivid(YELLOW), SOLID)
	end
	Kit.Box(m, V(-108, 15, 1044), V(-84, 17, 1072), Kit.Vivid(RED), { Mat = WOOD })
	local valance = Kit.Box(m, V(-84.4, 13, 1044), V(-84, 15, 1072), CREAM)
	Kit.Sign(valance, Enum.NormalId.Right, "🧸 PRIZES! 🧸", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-106, 1, 1047), V(-100, 4, 1069), CREAM, { Mat = WOOD, Solid = true })
	plushBear(m, V(-102.5, 4, 1058), 7, Kit.Vivid(PINK), 1, 0)
	plushBear(m, V(-95, 1, 1050), 5, Kit.Vivid(C(150, 200, 255)), 1, 0)
	plushGhost(m, V(-95, 1, 1066), 5)
	Kit.AddRect(-109, 1043, -83, 1073)
end

local function popcorn(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "PopcornCart")
	Kit.Box(m, V(x - 3, 1.2, z - 2.2), V(x + 3, 4.6, z + 2.2), Kit.Vivid(RED), { Solid = true })
	Kit.Box(m, V(x - 3.1, 3.2, z - 2.3), V(x + 3.1, 3.8, z + 2.3), CREAM)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 0.5, 2.4, V(x + sx * 1.8, 1.2, z + sz * 2.4), "Z", DARK)
		end
	end
	local glass = Kit.Box(m, V(x - 2.8, 4.6, z - 2), V(x + 2.8, 8.6, z + 2), C(220, 240, 255), { Transp = 0.5, Refl = 0.1 })
	Kit.Light(glass, C(255, 220, 150), 20, 1.2)
	for i = 0, 2 do
		Kit.Ball(m, 2.4, V(x - 1.4 + i * 1.4, 5.8 + (i % 2) * 0.6, z), C(255, 240, 190))
	end
	Kit.Box(m, V(x - 3.4, 8.6, z - 2.6), V(x + 3.4, 9.2, z + 2.6), Kit.Vivid(RED))
	Kit.Cyl(m, 1.4, 4, CFrame.new(x, 9.9, z), CREAM)
	Kit.Box(m, V(x - 0.2, 10.6, z - 0.2), V(x + 0.2, 11.7, z + 0.2), CREAM)
	local sign = Kit.Part(m, V(6, 1.8, 0.4), faced(V(x + 0.2, 12.6, z), 1, 0), Kit.Vivid(YELLOW))
	Kit.Sign(sign, Enum.NormalId.Front, "🍿 POPCORN", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.AddCircle(x, z, 5)
end

local function balloonCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "BalloonCart")
	Kit.Box(m, V(x - 2, 1, z - 1.5), V(x + 2, 4, z + 1.5), Kit.Vivid(BLUE), { Solid = true })
	Kit.Box(m, V(x - 2.2, 4, z - 1.7), V(x + 2.2, 4.4, z + 1.7), Kit.Vivid(YELLOW))
	for _, sz in { -1, 1 } do
		Kit.CylFlat(m, 0.4, 2.2, V(x, 1.1, z + sz * 1.7), "Z", DARK)
	end
	local cols = { RED, YELLOW, BLUE, PURPLE, PINK, MINT, CREAM }
	local top = V(x, 4.4, z)
	for i, col in cols do
		local a = i / #cols * math.pi * 2
		local p = V(x + math.cos(a) * 2.4, 11 + (i % 3) * 1.4, z + math.sin(a) * 2.4)
		Props.Beam(m, top, p - V(0, 1.4, 0), 0.1, 0.1, C(245, 245, 245))
		Kit.Ball(m, 2.8, p, Kit.Vivid(col), { Refl = 0.05 })
	end
	Kit.AddCircle(x, z, 5)
end

local function highStriker(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "HighStriker")
	Kit.Box(m, V(x - 3, 0, z - 3), V(x + 3, 1, z + 3), Kit.Vivid(RED), { Mat = WOOD, Solid = true })
	Kit.Box(m, V(x - 0.8, 1, z - 0.8), V(x + 0.8, 25, z + 0.8), CREAM, { Mat = WOOD, Solid = true })
	for i, col in { YELLOW, BLUE, RED } do
		local y = 2 + i * 6
		Kit.Box(m, V(x + 0.8, y, z - 1), V(x + 1, y + 3, z + 1), Kit.Vivid(col))
	end
	Kit.Ball(m, 2.6, V(x, 26.3, z), C(255, 230, 120), { Mat = NEON })
	Kit.Box(m, V(x + 0.8, 11, z - 0.5), V(x + 1.6, 12, z + 0.5), DARK)
	Kit.Box(m, V(x + 1, 1, z - 0.8), V(x + 2.8, 1.4, z + 0.8), Kit.Vivid(YELLOW))
	-- giant mallet leaning on the tower
	Props.Beam(m, V(x + 3.5, 0.2, z + 3), V(x + 1.5, 7, z + 3.6), 0.6, 0.6, WOODC)
	Kit.Part(m, V(3, 1.8, 1.8), CFrame.new(x + 1.4, 7.4, z + 3.6), Kit.Vivid(RED))
	Props.SignBoard(m, V(x + 1.2, 4.6, z), 5, 2.2, 1, 0, "BOO-O-METER", DARK, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 5)
end

--==================================================================
-- STREET FURNITURE + DECOR
--==================================================================
local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), WOODC, { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), WOODC, { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(RED))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function fence(f: Instance, a: Vector3, b: Vector3)
	local d = b - a
	local len = d.Magnitude
	local dir = d.Unit
	local yaw = Kit.FaceYaw(dir.X, dir.Z)
	for _, ry in { 1.2, 2.8 } do
		Kit.Part(f, V(0.3, 0.5, len), CFrame.new(a + d / 2 + V(0, ry, 0)) * CFrame.Angles(0, yaw, 0), Kit.Vivid(RED), { Mat = WOOD })
	end
	local n = math.max(1, math.floor(len / 4))
	for i = 0, n do
		local p = a + dir * (i * len / n)
		Kit.Box(f, p + V(-0.35, 0, -0.35), p + V(0.35, 3.8, 0.35), CREAM, { Mat = WOOD })
	end
	Kit.AddRect(math.min(a.X, b.X) - 1, math.min(a.Z, b.Z) - 1, math.max(a.X, b.X) + 1, math.max(a.Z, b.Z) + 1)
end

local function stringLights(f: Instance)
	local zs = { 1005, 1030, 1055, 1080, 1105, 1130 }
	local top = 17.5
	local cols = { Kit.Vivid(RED), Kit.Vivid(YELLOW), Kit.Vivid(BLUE), CREAM }
	for _, z in zs do
		for _, s in { -1, 1 } do
			Kit.Cyl(f, top + 0.5, 0.7, CFrame.new(s * 13, (top + 0.5) / 2, z), C(150, 100, 70), { Mat = WOOD })
			Kit.Ball(f, 1.4, V(s * 13, top + 0.9, z), Kit.Vivid(YELLOW))
			Kit.AddCircle(s * 13, z, 1.5)
		end
	end
	local nb = 0
	local lit = false
	local function wire(a: Vector3, b: Vector3)
		local mid = (a + b) / 2 - V(0, 2, 0)
		Props.Beam(f, a, mid, 0.15, 0.15, DARK)
		Props.Beam(f, mid, b, 0.15, 0.15, DARK)
		for k = 1, 4 do
			local t = k / 5
			local sag = 2 * (1 - math.abs(2 * t - 1))
			local p = a:Lerp(b, t) - V(0, sag + 0.5, 0)
			nb += 1
			local glow = nb % 4 == 0
			local bulb = Kit.Ball(f, 0.9, p, if glow then BULB else cols[nb % #cols + 1], glowOpts(glow))
			if glow and not lit then
				lit = true
				Kit.Light(bulb, C(255, 215, 150), 30, 1.1)
			end
		end
	end
	for i, z in zs do
		wire(V(-13, top, z), V(13, top, z))
		local nextZ = zs[i + 1]
		if nextZ then
			local s = if i % 2 == 1 then 1 else -1
			wire(V(-13 * s, top, z), V(13 * s, top, nextZ))
		end
	end
end

local function lollipop(f: Instance, x: number, z: number, color: Color3)
	Kit.Cyl(f, 12, 0.8, CFrame.new(x, 6, z), CREAM)
	Kit.CylFlat(f, 1.2, 7, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.CylFlat(f, 1.4, 4, V(x, 14, z), "Z", CREAM)
	Kit.CylFlat(f, 1.6, 1.6, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.AddCircle(x, z, 2)
end

local function circusBall(f: Instance, x: number, z: number, color: Color3, band: Color3)
	Kit.Ball(f, 6, V(x, 3, z), Kit.Vivid(color), { Solid = true })
	Kit.CylFlat(f, 1.4, 6.15, V(x, 3, z), "X", band)
	Kit.AddCircle(x, z, 3.5)
end

type BallSpot = { P: Vector3, Col: Color3, Band: Color3 }

local function decor(f: Instance)
	local rng = Kit.Rng
	-- benches between the string-light poles
	local benches = 0
	for _, z in { 1017, 1042, 1067, 1092, 1117 } do
		for _, s in { -1, 1 } do
			if benches < 7 and Kit.IsFree(s * 16.5, z, 3.5) then
				benches += 1
				bench(f, s * 16.5, z, -s, 0)
			end
		end
	end
	-- wooden fencing
	fence(f, V(68, 0, 1164), V(92, 0, 1164))
	fence(f, V(-124, 0, 1150), V(-78, 0, 1150))
	fence(f, V(128, 0, 1030), V(128, 0, 1078))
	-- lanterns flanking the boss ring (one flickers)
	Props.Lantern(f, V(-26, 0, 1142), C(200, 150, 255), true, true)
	Props.Lantern(f, V(26, 0, 1142), C(255, 220, 140), true, false)
	Kit.AddCircle(-26, 1142, 1.5)
	Kit.AddCircle(26, 1142, 1.5)
	-- oversized decorations
	local lolly = { RED, BLUE, PURPLE, PINK }
	for i, p in { V(-60, 0, 936), V(40, 0, 938), V(-125, 0, 1020), V(122, 0, 1092) } do
		if Kit.IsFree(p.X, p.Z, 2) then
			lollipop(f, p.X, p.Z, lolly[i])
		end
	end
	local balls: { BallSpot } = {
		{ P = V(34, 0, 1036), Col = RED, Band = CREAM },
		{ P = V(-30, 0, 1035), Col = BLUE, Band = Kit.Vivid(YELLOW) },
		{ P = V(112, 0, 1100), Col = PURPLE, Band = CREAM },
	}
	for _, b in balls do
		if Kit.IsFree(b.P.X, b.P.Z, 3.5) then
			circusBall(f, b.P.X, b.P.Z, b.Col, b.Band)
		end
	end
	-- floating balloons (single parts, client-animated)
	local fl = { RED, YELLOW, BLUE, PURPLE, PINK }
	for i, p in { V(36, 19, 1078), V(24, 22, 1090), V(-36, 18, 1040), V(60, 24, 940), V(-40, 22, 1150) } do
		local b = Kit.Ball(f, 3, p, Kit.Vivid(fl[i]), { Name = "FloatingBalloon" })
		Kit.Float(b, 1.2)
	end
	-- candy trees near the walls
	local trees = 0
	for _ = 1, 120 do
		if trees >= 6 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(100, 131)
		local z = rng:NextNumber(905, 1150)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(12, 17), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	-- wooden crates and pumpkins scattered around the grounds
	local crates, pumpkins = 0, 0
	for _ = 1, 300 do
		if crates >= 7 and pumpkins >= 6 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(908, 1212)
		if Kit.IsFree(x, z, 3) then
			if crates < 7 then
				crates += 1
				local s = rng:NextNumber(2.6, 3.8)
				local cf = CFrame.new(x, s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
				Kit.Part(f, V(s, s, s), cf, Kit.Pick({ WOODC, C(170, 115, 75), C(205, 160, 110) }), { Mat = WOOD, Solid = true })
			else
				pumpkins += 1
				Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 3.4), -x, 0)
			end
			Kit.AddCircle(x, z, 3)
		end
	end
end

function Carnival.Build(map: Instance)
	local f = Kit.Folder(map, "Carnival")
	ground(f)
	sideWalls(f)
	outside(f)
	entranceArch(f)
	ticketBooth(f, -46, 930)
	ticketBooth(f, 46, 930)
	ferrisWheel(f)
	carousel(f)
	bigTop(f)
	prizeBooth(f)
	-- striped tents (door toward the midway)
	tent(f, -112, 936, 16, Kit.Vivid(RED), CREAM)
	tent(f, -80, 950, 13, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 118, 952, 16, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 115, 1005, 14, Kit.Vivid(RED), CREAM)
	tent(f, -122, 1110, 14, Kit.Vivid(RED), CREAM)
	tent(f, 40, 1180, 12, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, -45, 1185, 12, Kit.Vivid(RED), CREAM)
	-- game stalls
	stall(f, 52, 948, BLUE, "RING TOSS")
	stall(f, 52, 977, PURPLE, "DUCK POND")
	stall(f, 52, 1006, RED, "BOO BALLOONS")
	stall(f, -48, 1062, YELLOW, "WHACK-A-GHOST")
	popcorn(f, -40, 958)
	balloonCart(f, 30, 1085)
	highStriker(f, -28, 1078)
	Props.Wisp(f, V(58, 0, 1158), ECTO, 10, true)
	Kit.AddCircle(58, 1158, 5)
	stringLights(f)
	decor(f)
end

return Carnival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Castle</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 7: Cursed Castle (Z 1920..2280).
--   Z 1926..1936  cosmetic moat (water over a solid floor at Y -0.5: a half-stud wade, no pit)
--                 crossed by a stone bridge on the path (X -12..12).
--   Z 1936..1962  outer bailey: Royal crate station (-28, 1952) and Fast Travel pad (26, 1952).
--   Z 1962..1975  gatehouse (archway X -16..16, clear to Y ~30, 26+ wide at Y 30) flanked by a
--                 crenellated curtain wall out to the side walls.
--   Z 1975..2186  open courtyard (no roofs): every non-boss ghost area, knight statues, a
--                 spectral fountain, braziers, sword in the stone, lawns.
--   Z 2186..2256  open-topped throne room (X -45..45) around the boss area (0, 2220); giant doors
--                 swung outward; the throne sits on a balcony over a 26-wide arch in the back
--                 wall that leads on to the Spirit Realm gate.
--   Library corner X 74..140, Z 2146..2254 (open front/top). Eight round towers with stepped cone
--   roofs (keep towers flank the throne room, tips ~117), cliffs beyond the side walls.
--   Glow: rune ring, cracks, tower windows (half the towers), torches, braziers, candles, the
--   fountain orb and the throne gem. Everything else is stone, wood, metal and fabric.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Castle = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SLATE = Enum.Material.Slate
local COBBLE = Enum.Material.Cobblestone
local WOOD = Enum.Material.Wood
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1920, 2280

local STONE = C(150, 150, 166)
local STONE_D = C(112, 114, 132)
local STONE_L = C(188, 188, 200)
local FLOOR = C(132, 130, 148)
local PATH = C(176, 170, 186)
local BLUE = C(55, 78, 150)
local ROOF = C(60, 75, 145)
local ROOF_P = C(100, 60, 150)
local ROYAL_RED = C(175, 40, 70)
local PURPLE = C(125, 65, 175)
local GOLD = C(255, 200, 70)
local SPECTRAL = C(120, 255, 170)
local GHOST_PURPLE = C(190, 120, 255)
local WARM = C(255, 185, 95)
local WOOD_C = C(112, 76, 52)
local IRON = C(60, 62, 78)
local SILVER = C(196, 200, 214)
local ROCKC = C(102, 106, 124)

local SOLID_SLATE: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }

--==================================================================
-- HELPERS
--==================================================================
-- Stepped cone roof (stacked cylinders) from y up to y + h, with a gold finial.
local function cone(parent: Instance, x: number, z: number, y: number, d: number, h: number, color: Color3)
	local tiers = 5
	local th = h / tiers
	for i = 0, tiers - 1 do
		local di = d * (1 - i / tiers)
		local col = if i % 2 == 0 then color else color:Lerp(Color3.new(1, 1, 1), 0.12)
		Kit.Cyl(parent, th, di, CFrame.new(x, y + th * (i + 0.5), z), col, { Mat = SLATE, Shadow = true })
	end
	Kit.Ball(parent, math.max(1.2, d * 0.12), V(x, y + h + 0.4, z), Kit.Vivid(GOLD), { Mat = METAL })
end

-- Round tower with crenellated top, cone roof, flag and two windows facing the path.
local function tower(parent: Instance, x: number, z: number, d: number, h: number, roof: Color3, glow: Color3?)
	local m = Kit.Model(parent, "Tower")
	Kit.Cyl(m, 3, d + 3, CFrame.new(x, 1.5, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, h, d, CFrame.new(x, h / 2, z), STONE, SOLID_SLATE)
	Kit.Cyl(m, 1.2, d + 0.6, CFrame.new(x, h * 0.62, z), Kit.Vivid(BLUE), { Mat = SLATE })
	Kit.Cyl(m, 4, d + 3, CFrame.new(x, h + 2, z), STONE_L, { Mat = SLATE, Shadow = true })
	local r = (d + 3) / 2 - 1.3
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * r, z + math.sin(a) * r
		Kit.Box(m, V(px - 1.4, h + 4, pz - 1.4), V(px + 1.4, h + 7, pz + 1.4), STONE_L, { Mat = SLATE })
	end
	local coneH = (d - 1) * 1.75
	cone(m, x, z, h + 4, d - 1, coneH, roof)
	local tip = h + 4 + coneH
	Kit.Cyl(m, 6, 0.3, CFrame.new(x, tip + 3, z), IRON, { Mat = METAL })
	Kit.Part(m, V(0.3, 2.6, 4.5), CFrame.new(x, tip + 4.6, z - 2.4), Kit.Vivid(if roof == ROOF then ROYAL_RED else PURPLE), { Mat = FABRIC })
	local dir = if x > 0 then -1 else 1
	local winOpts: Kit.Opts = if glow then { Mat = NEON, Transp = 0.1 } else {}
	for _, wy in { h * 0.42, h * 0.8 } do
		Kit.Part(m, V(2.2, 5, 1), CFrame.new(x + dir * (d / 2 - 0.2), wy, z) * CFrame.Angles(0, Kit.FaceYaw(dir, 0), 0), glow or C(40, 50, 85), winOpts)
	end
	Kit.AddCircle(x, z, d / 2 + 2.5)
end

-- Hanging banner facing (fx, fz); pos = centre of the cloth.
local function banner(parent: Instance, pos: Vector3, w: number, h: number, fx: number, fz: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(parent, V(w, h, 0.3), cf, color, { Mat = FABRIC })
	local e = w * 0.42
	Kit.Part(parent, V(e, e, 0.2), cf * CFrame.new(0, h * 0.12, -0.22) * CFrame.Angles(0, 0, math.pi / 4), gold, { Mat = METAL })
	Kit.Part(parent, V(w + 1.2, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.2, 0), gold, { Mat = METAL })
	Kit.Part(parent, V(w, 0.6, 0.36), cf * CFrame.new(0, -h / 2 + 0.3, 0), gold, { Mat = FABRIC })
end

local function knightStatue(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "KnightStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = C(178, 178, 190)
	local so: Kit.Opts = { Mat = Enum.Material.Concrete, Shadow = true }
	Kit.Part(m, V(6, 3, 6), base * CFrame.new(0, 1.5, 0), STONE_D, SOLID_SLATE)
	Kit.Part(m, V(3, 4, 1.8), base * CFrame.new(0, 5, 0), stone, so)
	Kit.Part(m, V(4.2, 4.6, 2.4), base * CFrame.new(0, 9.3, 0), stone, so)
	Kit.Ball(m, 2.8, (base * CFrame.new(0, 12.9, 0)).Position, stone, so)
	Kit.Wedge(m, V(0.6, 1.8, 2.6), base * CFrame.new(0, 14.6, 0.4), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Part(m, V(3.2, 4.2, 0.5), base * CFrame.new(-2.7, 8.6, -0.9), Kit.Vivid(ROYAL_RED), { Mat = METAL })
	Kit.Part(m, V(1.4, 1.4, 0.2), base * CFrame.new(-2.7, 8.8, -1.2) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.5, 9, 0.3), base * CFrame.new(2.6, 9.5, -1.3), SILVER, { Mat = METAL })
	Kit.Part(m, V(2.4, 0.45, 0.45), base * CFrame.new(2.6, 7.2, -1.3), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.AddCircle(x, z, 4.5)
end

local function armor(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "SuitOfArmor")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.15 }
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(0, 0.3, 0), WOOD_C, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(1.9, 3.6, 1.2), base * CFrame.new(0, 2.4, 0), SILVER, mo)
	Kit.Part(m, V(2.8, 2.8, 1.6), base * CFrame.new(0, 5.6, 0), SILVER, mo)
	Kit.Part(m, V(3.4, 0.9, 1.8), base * CFrame.new(0, 6.9, 0), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(1.6, 1.9, 1.6), base * CFrame.new(0, 8.3, 0), SILVER, mo)
	Kit.Part(m, V(1.2, 0.25, 0.12), base * CFrame.new(0, 8.4, -0.82), C(25, 25, 35))
	Kit.Wedge(m, V(0.4, 1.2, 1.6), base * CFrame.new(0, 9.8, 0.2), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Part(m, V(0.3, 10, 0.3), base * CFrame.new(1.9, 5, -0.5), WOOD_C, { Mat = WOOD })
	Kit.Part(m, V(0.2, 1.8, 1.4), base * CFrame.new(1.9, 9.6, -0.9), SILVER, mo)
	Kit.AddCircle(x, z, 2.5)
end

local function candelabra(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "Candelabra")
	local gold = Kit.Vivid(GOLD)
	Kit.Disc(m, x, z, 0.5, 2.4, 0.5, gold, { Mat = METAL })
	Kit.Cyl(m, 6, 0.6, CFrame.new(x, 3.5, z), gold, { Mat = METAL })
	Kit.CylFlat(m, 4.2, 0.4, V(x, 6.5, z), "X", gold, { Mat = METAL })
	for i = -1, 1 do
		Kit.Cyl(m, 1.4, 0.55, CFrame.new(x + i * 1.9, 7.4, z), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x + i * 1.9, 8.4, z), WARM, { Mat = NEON })
		if light and i == 0 then
			Kit.Light(flame, WARM, 20, 1.3, true)
		end
	end
	Kit.AddCircle(x, z, 2.5)
end

local function brazier(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "Brazier")
	Kit.Cyl(m, 4, 2.4, CFrame.new(x, 2, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, 1.6, 4.4, CFrame.new(x, 4.8, z), IRON, { Mat = METAL })
	local flame = Kit.Ball(m, 2.6, V(x, 5.9, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(flame, SPECTRAL, 26, 1.6)
	Kit.AddCircle(x, z, 3)
end

local function crack(parent: Instance, p: Vector3, segs: number)
	local rng = Kit.Rng
	local a = rng:NextNumber(0, math.pi * 2)
	for _ = 1, segs do
		a += rng:NextNumber(-0.9, 0.9)
		local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(4, 7)
		Props.Beam(parent, p, q, 0.45, 0.06, if rng:NextNumber() < 0.5 then SPECTRAL else GHOST_PURPLE, { Mat = NEON })
		p = q
	end
end

--==================================================================
-- GROUND, MOAT, BRIDGE, PATH, WALLS, CLIFFS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, 1926), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	Kit.Box(f, V(-190, -4, 1926), V(190, -0.5, 1936), C(60, 72, 95), { Mat = SLATE, Solid = true, Name = "MoatFloor" })
	Kit.Box(f, V(-146, -0.5, 1926), V(146, -0.12, 1936), C(45, 85, 150), { Transp = 0.2, Refl = 0.25, Name = "MoatWater" })
	Kit.Box(f, V(-190, -4, 1936), V(190, 0, Z1), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	-- low stone curbs along the moat banks (steppable)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 13.6, -0.5, 1925.2), V(s * 140, 0.3, 1926), STONE_D, { Mat = SLATE, Solid = true })
		Kit.Box(f, V(s * 13.6, -0.5, 1936), V(s * 140, 0.3, 1936.8), STONE_D, { Mat = SLATE, Solid = true })
	end
	-- stone bridge over the moat
	Kit.Box(f, V(-12, -0.5, 1923.5), V(12, 0.06, 1938.5), PATH, { Mat = COBBLE, Solid = true, Name = "Bridge" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12, 0, 1924.5), V(s * 13.6, 3.2, 1937.5), STONE, SOLID_SLATE)
		for _, z in { 1924.5, 1937.5 } do
			Kit.Box(f, V(s * 11.8, 0, z - 1.1), V(s * 14, 4.6, z + 1.1), STONE_L, SOLID_SLATE)
			Kit.Ball(f, 1.8, V(s * 12.9, 5.4, z), Kit.Vivid(GOLD), { Mat = METAL })
		end
	end
	-- main path with blue slate edging
	Kit.Box(f, V(-9, 0, 1938.5), V(9, 0.05, Z1), PATH, { Mat = COBBLE, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, 1938.5), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(BLUE), { Mat = SLATE })
	end
	-- flat lawns in the courtyard
	for _, l in { { 40, 1978, 136, 2062 }, { -136, 1978, -40, 2012 }, { -136, 2070, -92, 2130 }, { 28, 2130, 70, 2186 }, { -46, 2192, -136, 2250 } } do
		Kit.Box(f, V(l[1], 0, l[2]), V(l[3], 0.04, l[4]), C(100, 165, 105), { Mat = Enum.Material.Grass })
	end
end

local function sideWalls(f: Instance)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, Z0 + 3), V(s * 146, 30, Z1 - 3), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 139.6, 30, Z0 + 3), V(s * 146.4, 31.2, Z1 - 3), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 139.7, 24, Z0 + 3), V(s * 140, 25.2, Z1 - 3), Kit.Vivid(BLUE), { Mat = SLATE })
		for z = Z0 + 12, Z1 - 12, 16 do
			Kit.Box(f, V(s * 140, 31.2, z - 3), V(s * 146, 35, z + 3), STONE, { Mat = SLATE })
		end
		for _, z in { 2012, 2056, 2146, 2190 } do
			Kit.Box(f, V(s * 137.5, 0, z - 2.5), V(s * 140, 26, z + 2.5), STONE_D, SOLID_SLATE)
		end
		-- spectral crack climbing the wall
		local x = s * 139.75
		local z0 = if s < 0 then 2120 else 2040
		Props.Beam(f, V(x, 2, z0), V(x, 9, z0 + 5), 0.4, 0.4, SPECTRAL, { Mat = NEON })
		Props.Beam(f, V(x, 9, z0 + 5), V(x, 15, z0 + 1), 0.4, 0.4, SPECTRAL, { Mat = NEON })
	end
	-- royal banners on the inner wall faces
	for i, z in { 2034, 2078, 2130 } do
		for _, s in { -1, 1 } do
			banner(f, V(s * 139.5, 15, z), 7, 14, -s, 0, if (i + (if s > 0 then 1 else 0)) % 2 == 0 then ROYAL_RED else PURPLE)
		end
	end
end

local function cliffs(f: Instance)
	local rng = Kit.Rng
	local cols = { ROCKC, C(88, 92, 112), C(115, 118, 138) }
	for _, s in { -1, 1 } do
		for i = 0, 7 do
			local z = 1934 + i * 46
			local w = rng:NextNumber(26, 44)
			local h = rng:NextNumber(42, 66)
			local cf = CFrame.new(s * (149 + w / 2), h / 2 - 3, z) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), s * rng:NextNumber(0.02, 0.08))
			Kit.Part(f, V(w, h, rng:NextNumber(38, 52)), cf, Kit.Pick(cols), { Mat = ROCK })
			Kit.Ball(f, rng:NextNumber(40, 60), V(s * rng:NextNumber(185, 205), rng:NextNumber(4, 18), z + 20), Kit.Pick(cols), { Mat = ROCK })
		end
	end
end

--==================================================================
-- GATEHOUSE + CURTAIN WALL
--==================================================================
local function gatehouse(f: Instance)
	local m = Kit.Model(f, "Gatehouse")
	local zA, zB = 1962, 1975
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16, 0, zA), V(s * 34, 46, zB), STONE, SOLID_SLATE)
		Kit.Box(m, V(s * 15.6, 0, zA - 0.4), V(s * 34.4, 3, zB + 0.4), STONE_D, SOLID_SLATE)
		for _, mx in { 18.5, 31.5 } do
			for _, mz in { zA + 1.5, zB - 1.5 } do
				Kit.Box(m, V(s * (mx - 1.5), 46, mz - 1.5), V(s * (mx + 1.5), 50, mz + 1.5), STONE_L, { Mat = SLATE })
			end
		end
		-- little turret with a cone roof
		Kit.Cyl(m, 10, 7, CFrame.new(s * 25, 51, (zA + zB) / 2), STONE_L, { Mat = SLATE, Shadow = true })
		cone(m, s * 25, (zA + zB) / 2, 56, 8.5, 13, ROOF_P)
		-- banner and torch on the approach face
		banner(m, V(s * 25, 24, zA - 0.35), 8, 18, 0, -1, if s < 0 then ROYAL_RED else PURPLE)
		local tx = s * 18.2
		Kit.Box(m, V(tx - 0.4, 16.5, zA - 0.8), V(tx + 0.4, 19.5, zA), IRON, { Mat = METAL })
		local flame = Kit.Ball(m, 1.7, V(tx, 20.3, zA - 0.6), WARM, { Mat = NEON })
		Kit.Light(flame, WARM, 26, 1.6)
	end
	-- lintel over the archway (opening X -16..16, Y 0..32) + rounded arch corners
	Kit.Box(m, V(-16, 32, zA + 1), V(16, 46, zB - 1), STONE, SOLID_SLATE)
	Kit.Box(m, V(-16, 32, zA + 0.7), V(16, 33, zB - 0.7), Kit.Vivid(GOLD), { Mat = METAL })
	local mid = (zA + zB) / 2
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(-13.5, 29.5, mid), V(0, 0, -1), V(0, -1, 0)), STONE, { Mat = SLATE })
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(13.5, 29.5, mid), V(0, 0, 1), V(0, -1, 0)), STONE, { Mat = SLATE })
	-- raised portcullis teeth
	Kit.Box(m, V(-15, 31, mid - 0.4), V(15, 31.6, mid + 0.4), IRON, { Mat = METAL })
	for x = -12, 12, 4 do
		Kit.Box(m, V(x - 0.35, 30.4, mid - 0.3), V(x + 0.35, 32, mid + 0.3), IRON, { Mat = METAL })
	end
	Props.SignBoard(m, V(0, 39.5, zA + 0.6), 26, 5, 0, -1, "CURSED CASTLE", C(45, 35, 80), Kit.Vivid(GOLD), GOLD)

	-- curtain wall from the gatehouse to the side walls
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 34, 0, 1964), V(s * 140, 24, 1972), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 34, 24, 1963.6), V(s * 140, 25, 1972.4), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 34, 18, 1963.7), V(s * 122, 19, 1964), Kit.Vivid(BLUE), { Mat = SLATE })
		for x = 40, 116, 9.5 do
			Kit.Box(f, V(s * (x - 2), 25, 1963.6), V(s * (x + 2), 28.5, 1966.6), STONE, { Mat = SLATE })
		end
		for i, x in { 58, 96 } do
			banner(f, V(s * x, 12, 1963.4), 7, 14, 0, -1, if i == 1 then ROYAL_RED else PURPLE)
		end
	end
	Kit.AddRect(-140, 1961, -15, 1976)
	Kit.AddRect(15, 1961, 140, 1976)
end

--==================================================================
-- THRONE ROOM
--==================================================================
local function throneRoom(f: Instance)
	local m = Kit.Model(f, "ThroneRoom")
	local wall = C(138, 134, 160)
	local gold = Kit.Vivid(GOLD)
	local H = 28
	-- walls (open top)
	Kit.Box(m, V(-45, 0, 2186), V(-15, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(15, 0, 2186), V(45, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2186), V(-42, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(42, 0, 2186), V(45, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2248), V(-13, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(13, 0, 2248), V(45, H, 2256), wall, SOLID_SLATE)
	-- balcony over the back arch (opening X -13..13, Y 0..20) carries the throne
	Kit.Box(m, V(-13, 20, 2248), V(13, 24, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-13, 20, 2247.7), V(13, 21, 2248), gold, { Mat = METAL })
	-- gold trim and merlons
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 22, 2185.7), V(s * 45, 23, 2186), gold, { Mat = METAL })
		for _, x in { 22, 32, 42 } do
			Kit.Box(m, V(s * (x - 2), H, 2186), V(s * (x + 2), H + 3.5, 2189), wall, { Mat = SLATE })
		end
		for _, z in { 2200, 2218, 2236 } do
			Kit.Box(m, V(s * 42, H, z - 2), V(s * 45, H + 3.5, z + 2), wall, { Mat = SLATE })
		end
	end
	-- lintel + name over the doorway (doorway X -15..15, Y 0..28)
	Kit.Box(m, V(-17, H, 2185.5), V(17, H + 6, 2190.5), STONE_L, SOLID_SLATE)
	Props.SignBoard(m, V(0, H + 3, 2185.1), 24, 4.5, 0, -1, "THRONE ROOM", C(80, 25, 50), gold, GOLD)
	Props.SignBoard(m, V(-24, 9, 2185.4), 9, 3, 0, -1, "BEWARE OF\nTHE KING", C(240, 232, 215), Kit.Vivid(ROYAL_RED))
	-- giant doors, swung outward
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 0, 2171), V(s * 16.6, H, 2186), C(105, 68, 45), { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		for _, y in { 5, 14, 23 } do
			Kit.Box(m, V(s * 14.8, y, 2171), V(s * 16.8, y + 1, 2186), IRON, { Mat = METAL })
		end
		Kit.CylFlat(m, 0.4, 2.2, V(s * 14.7, 12, 2174), "X", gold, { Mat = METAL })
		Kit.AddRect(s * 14, 2170, s * 17.5, 2186)
	end
	-- royal carpet (flat) from the doors to the throne
	Kit.Box(m, V(-5, 0, 2166), V(5, 0.08, 2248), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5 - 0.4, 0, 2166), V(s * 5 + 0.4, 0.1, 2248), gold, { Mat = FABRIC })
	end
	-- columns
	for _, s in { -1, 1 } do
		for _, z in { 2200, 2222, 2244 } do
			Kit.Cyl(m, 24, 3.2, CFrame.new(s * 36, 12, z), STONE_L, SOLID_SLATE)
			Kit.Box(m, V(s * 36 - 2.2, 24, z - 2.2), V(s * 36 + 2.2, 25.2, z + 2.2), gold, { Mat = METAL })
		end
		banner(m, V(s * 41.8, 15, 2211), 6, 14, -s, 0, ROYAL_RED)
		banner(m, V(s * 41.8, 15, 2233), 6, 14, -s, 0, PURPLE)
	end
	candelabra(m, -30, 2195, true)
	candelabra(m, 30, 2195, false)

	-- the throne on the balcony
	Kit.Box(m, V(-8, 24, 2247.5), V(8, 25.2, 2256), gold, { Mat = METAL })
	Kit.Box(m, V(-5.5, 25.2, 2248), V(5.5, 28.6, 2254), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(-6.5, 25.2, 2253), V(6.5, 46, 2256), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Box(m, V(-7.6, 25.2, 2253.6), V(7.6, 47.6, 2256.3), gold, { Mat = METAL })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5.5, 25.2, 2248), V(s * 7.6, 30.6, 2254), gold, { Mat = METAL })
		Kit.Cyl(m, 3.4, 1.2, CFrame.new(s * 5, 49.3, 2255), gold, { Mat = METAL })
		Kit.Ball(m, 1.6, V(s * 5, 51.4, 2255), Kit.Vivid(ROYAL_RED), { Refl = 0.2 })
	end
	Kit.Cyl(m, 4.4, 1.4, CFrame.new(0, 49.8, 2255), gold, { Mat = METAL })
	local gem = Kit.Ball(m, 2.2, V(0, 52.6, 2255), GHOST_PURPLE, { Mat = NEON })
	Kit.Light(gem, GHOST_PURPLE, 40, 1.8)
	Props.Beam(m, V(-3, 28, 2252.9), V(1, 36, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	Props.Beam(m, V(1, 36, 2252.9), V(-1, 42, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	local mist = Kit.Part(m, V(14, 0.2, 6), CFrame.new(0, 26, 2251), GHOST_PURPLE, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(mist, GHOST_PURPLE, 1.5, 6, 0.4)
	local crown = Kit.Cyl(m, 1.8, 3.4, CFrame.new(0, 58, 2252), gold, { Mat = METAL, Name = "FloatingCrown" })
	Kit.Float(crown, 1.2)

	-- boss area paint: royal disc, gold ring, spectral rune ring (flat)
	Kit.Disc(m, 0, 2220, 0.09, 52, 0.09, gold, { Mat = METAL })
	Kit.Disc(m, 0, 2220, 0.11, 48, 0.11, C(70, 40, 95), { Mat = SLATE })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.1
		local a2 = a1 + math.pi / 4 - 0.2
		Props.Beam(m, V(math.cos(a1) * 20, 0.15, 2220 + math.sin(a1) * 20), V(math.cos(a2) * 20, 0.15, 2220 + math.sin(a2) * 20), 0.5, 0.06, GHOST_PURPLE, { Mat = NEON })
	end
	Kit.AddRect(-46, 2185, 46, 2257)
end

--==================================================================
-- LIBRARY CORNER (+X back)
--==================================================================
local function library(f: Instance)
	local m = Kit.Model(f, "Library")
	local rng = Kit.Rng
	local shelfC = C(92, 60, 42)
	Kit.Box(m, V(74, 0, 2249), V(140, 22, 2253), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2205), V(76, 16, 2230), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2230), V(76, 11, 2249), STONE, SOLID_SLATE)
	Kit.Box(m, V(80, 0, 2160), V(134, 0.06, 2244), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(84, 0, 2164), V(130, 0.08, 2240), C(95, 50, 135), { Mat = FABRIC })
	-- shelves along the back wall (facing -Z), two colours per row
	for _, x in { 84, 100, 116 } do
		Kit.Box(m, V(x - 7, 0, 2245), V(x + 7, 18, 2249), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			local split = rng:NextNumber(-2, 2)
			Kit.Box(m, V(x - 6.3, y, 2244.6), V(x + split, y + 3.6, 2245.1), Kit.Pick(Props.Colors.Book))
			Kit.Box(m, V(x + split, y, 2244.6), V(x + 6.3, y + 3.4, 2245.1), Kit.Pick(Props.Colors.Book))
		end
	end
	-- shelves along the side wall (facing -X)
	for _, z in { 2166, 2184, 2202, 2220 } do
		Kit.Box(m, V(135, 0, z - 7), V(139.5, 18, z + 7), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			Kit.Box(m, V(134.6, y, z - 6.3), V(135.1, y + 3.6, z + 6.3), Kit.Pick(Props.Colors.Book))
		end
	end
	-- ladder
	Props.Beam(m, V(91, 0, 2243.4), V(91.6, 17.5, 2244.6), 0.3, 0.3, shelfC)
	Props.Beam(m, V(93.4, 0, 2243.4), V(94, 17.5, 2244.6), 0.3, 0.3, shelfC)
	-- reading table with candles and a book pile
	Kit.Box(m, V(88, 3, 2190), V(100, 3.8, 2198), shelfC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(89, 0, 2191), V(90, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(98, 0, 2191), V(99, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(90.5, 3.8, 2192), V(93.5, 4.6, 2196), Kit.Vivid(ROYAL_RED))
	Kit.Box(m, V(90.8, 4.6, 2192.4), V(93.2, 5.3, 2195.6), Kit.Vivid(BLUE))
	for i, x in { 96, 98 } do
		Kit.Cyl(m, 1.6, 0.6, CFrame.new(x, 4.6, 2194), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x, 5.7, 2194), WARM, { Mat = NEON })
		if i == 1 then
			Kit.Light(flame, WARM, 24, 1.3, true)
		end
	end
	-- lectern with a giant open spell book
	Kit.Box(m, V(104, 0, 2214), V(107, 4.2, 2217), shelfC, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(6, 0.5, 4.2), CFrame.new(105.5, 4.8, 2215.5) * CFrame.Angles(-0.35, 0, 0), C(250, 245, 230))
	Kit.Part(m, V(2.8, 0.1, 0.25), CFrame.new(105.5, 5.1, 2215.2) * CFrame.Angles(-0.35, 0, 0), SPECTRAL, { Mat = NEON })
	-- floating books and a candle
	Props.FloatingBook(m, V(96, 10, 2214))
	Props.FloatingBook(m, V(112, 12, 2228))
	Props.FloatingBook(m, V(120, 9, 2204))
	Props.FloatingCandle(m, V(106, 10, 2196))
	Props.SignBoard(m, V(100, 20.2, 2248.6), 26, 3.4, 0, -1, "ROYAL LIBRARY - SHHH!", C(50, 35, 80), Kit.Vivid(GOLD), GOLD)
	Kit.AddRect(72, 2146, 140, 2254)
end

--==================================================================
-- COURTYARD FEATURES
--==================================================================
local function fountain(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SpectralFountain")
	Kit.Disc(m, x, z, 2, 14, 2, STONE_L, SOLID_SLATE)
	Kit.Disc(m, x, z, 2.1, 12, 0.2, C(80, 200, 190), { Transp = 0.25, Refl = 0.2 })
	Kit.Cyl(m, 5, 2, CFrame.new(x, 4.5, z), STONE, { Mat = SLATE })
	Kit.Cyl(m, 1, 6, CFrame.new(x, 7.2, z), STONE_L, { Mat = SLATE })
	local orb = Kit.Ball(m, 2.4, V(x, 8.6, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(orb, SPECTRAL, 24, 1.4)
	Kit.Emitter(orb, SPECTRAL, 2, 5, 0.8)
	Kit.AddCircle(x, z, 8)
end

local function swordInStone(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SwordInStone")
	Kit.Ball(m, 8, V(x, -1, z), ROCKC, { Mat = ROCK, Solid = true })
	Kit.Part(m, V(0.8, 9, 0.3), CFrame.new(x, 6.5, z) * CFrame.Angles(0, 0.4, 0.06), SILVER, { Mat = METAL, Refl = 0.2 })
	Kit.Part(m, V(3.2, 0.6, 0.6), CFrame.new(x + 0.6, 10.6, z) * CFrame.Angles(0, 0.4, 0.06), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.6, 2.2, 0.6), CFrame.new(x + 0.66, 12, z) * CFrame.Angles(0, 0.4, 0.06), C(90, 50, 40), { Mat = FABRIC })
	Kit.Ball(m, 0.9, V(x + 0.72, 13.3, z), Kit.Vivid(GOLD), { Mat = METAL })
	Props.SignBoard(m, V(x - 4.5, 2.4, z - 3), 5, 2, -1, -1, "TUG ME?", C(240, 232, 215), Kit.Vivid(PURPLE))
	Kit.AddCircle(x, z, 6)
end

local function scatter(f: Instance)
	local rng = Kit.Rng
	local rubble, barrels, broken = 0, 0, 0
	for _ = 1, 400 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1942, 2272)
		if rubble < 10 and Kit.IsFree(x, z, 3) then
			rubble += 1
			Kit.Ball(f, rng:NextNumber(2.5, 4.5), V(x, -0.4, z), Kit.Pick({ ROCKC, STONE_D, STONE }), { Mat = ROCK, Solid = true })
			Kit.Ball(f, rng:NextNumber(1.4, 2.2), V(x + 2, -0.2, z + 1), STONE_D, { Mat = ROCK })
			Kit.AddCircle(x, z, 3)
		elseif barrels < 7 and Kit.IsFree(x, z, 2.5) then
			barrels += 1
			Kit.Cyl(f, 4, 2.8, CFrame.new(x, 2, z), C(140, 95, 60), { Mat = WOOD, Solid = true })
			Kit.Cyl(f, 0.4, 2.95, CFrame.new(x, 2.8, z), IRON, { Mat = METAL })
			Kit.AddCircle(x, z, 2.5)
		elseif broken < 5 and Kit.IsFree(x, z, 5) then
			broken += 1
			local h = rng:NextNumber(5, 11)
			Kit.Box(f, V(x - 2, 0, z - 2), V(x + 2, 1, z + 2), STONE_D, SOLID_SLATE)
			Kit.Cyl(f, h, 3, CFrame.new(x, 1 + h / 2, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.05, 0.05)), STONE_L, SOLID_SLATE)
			Kit.CylFlat(f, 7, 3, V(x + 1, 1.5, z + 3.5), "X", STONE_L, { Mat = SLATE })
			Kit.AddCircle(x, z, 5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Castle.Build(map: Instance)
	local f = Kit.Folder(map, "Castle")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	cliffs(f)
	gatehouse(f)

	-- ghost-area paint (flat rune circles; the boss circle is painted by the throne room)
	local areas = { { 0, 2005, 30 }, { -82, 2040, 24 }, { 75, 2100, 26 }, { -62, 2160, 24 } }
	for i, a in areas do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, Kit.Vivid(if i % 2 == 0 then PURPLE else BLUE), { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, STONE_L, { Mat = SLATE })
		crack(f, V(a[1] + rng:NextNumber(-8, 8), 0.13, a[2] + rng:NextNumber(-8, 8)), 2)
	end

	-- towers: front corners, side middles, back corners and the two keep towers by the throne
	tower(f, -131, 1968, 18, 56, ROOF)
	tower(f, 131, 1968, 18, 56, ROOF)
	tower(f, -128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, 128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, -128, 2262, 18, 60, ROOF)
	tower(f, 128, 2262, 18, 60, ROOF)
	tower(f, -60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)
	tower(f, 60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)

	throneRoom(f)
	library(f)

	-- courtyard
	for _, p in { { -22, 2062 }, { 22, 2062 }, { -22, 2122 }, { 22, 2122 } } do
		if Kit.IsFree(p[1], p[2], 4) then
			knightStatue(f, p[1], p[2], if p[1] < 0 then 1 else -1, 0)
		end
	end
	if Kit.IsFree(-31, 2092, 8) then
		fountain(f, -31, 2092)
	end
	if Kit.IsFree(32, 2090, 6) then
		swordInStone(f, 32, 2090)
	end
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 16, 2150, 2.5, true) then
			brazier(f, s * 16, 2150)
		end
	end
	for _, p in { { -30, 2181, 0, -1 }, { 30, 2181, 0, -1 }, { -50, 1980, 1, 0 }, { 50, 1980, -1, 0 }, { 68, 2150, -1, 0 }, { -70, 2206, 1, 0 } } do
		if Kit.IsFree(p[1], p[2], 2.5) then
			armor(f, p[1], p[2], p[3], p[4])
		end
	end
	scatter(f)
	for _ = 1, 4 do
		crack(f, V(rng:NextNumber(-120, 120), 0.13, rng:NextNumber(1980, 2180)), 1)
	end
end

return Castle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Cemetery</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 2: Cemetery (Z 260..540). Cobblestone path along X = 0 from gate to gate, a giant
-- mausoleum in the north-west corner (tall dome + glowing spire orb, visible from spawn),
-- small crypts, rows of oversized slate gravestones, twisted trees, lanterns, neon cracks,
-- candy mushrooms, iron fences and slow purple fog. Palette: dark green, stone gray, muted
-- purple, warm lantern orange, ectoplasm green. Glow is kept to the lanterns, candles, crypt
-- doorways, the spire orb and the small ectoplasm cracks.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Cemetery = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local STONES = { C(158, 156, 170), C(140, 146, 150), C(175, 170, 182), C(150, 145, 168), C(128, 136, 138) }
local EPITAPHS = { "RIP", "BRB", "BOO", "LOL", "GG", "AFK", "R.I.P.\nIN PEACE", "BE BACK\nSOON", "NOT\nHERE" }

-- Gable roof with the ridge along local X (slopes toward local ±Z), bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, { Solid = true, Shadow = true })
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, { Solid = true, Shadow = true })
end

local function mausoleum(f: Instance)
	local m = Kit.Model(f, "Mausoleum")
	local stone, light, roof = C(178, 174, 190), C(214, 210, 220), C(92, 74, 128)
	local glow = C(120, 255, 170)
	local mint = Kit.Vivid(glow) -- solid trims in the glow colour
	-- stepped platform
	Kit.Box(m, V(-122, 0, 477), V(-78, 1.2, 513), C(150, 140, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(-120, 1.2, 479), V(-82, 2.4, 511), C(170, 160, 200), { Mat = Enum.Material.Slate, Solid = true })
	-- body (front faces +X toward the path)
	Kit.Box(m, V(-118, 2.4, 482), V(-90, 26, 508), stone, { Mat = Enum.Material.Slate, Solid = true, Name = "Body" })
	-- portico columns
	for i = 0, 4 do
		local z = 483.5 + i * 5.75
		Kit.Cyl(m, 22, 2.6, CFrame.new(-85.5, 13.4, z), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
		Kit.Box(m, V(-87, 2.4, z - 1.6), V(-84, 3.2, z + 1.6), light)
	end
	-- entablature + cornice
	Kit.Box(m, V(-119, 24.4, 480), V(-83, 27, 510), light, { Mat = Enum.Material.Marble, Solid = true })
	Kit.Box(m, V(-83.3, 25, 483), V(-82.9, 26.4, 507), mint)
	-- pediment roof (triangle face toward +X)
	gable(m, CFrame.new(-101, 27, 495), 37, 31, 9, roof)
	-- ectoplasm-filled doorway (solid mint, lit by its own green light)
	Kit.Box(m, V(-90.3, 2.4, 487.5), V(-89.9, 17.5, 502.5), light)
	local door = Kit.Box(m, V(-90.1, 2.4, 489), V(-89.6, 16, 501), mint, { Refl = 0.1 })
	Kit.Light(door, glow, 30, 2)
	-- name plate on the entablature, facing +X
	local plateCF = CFrame.new(-82.7, 25.7, 495) * CFrame.Angles(0, Kit.FaceYaw(1, 0), 0)
	local plate = Kit.Part(m, V(18, 2.4, 0.4), plateCF, C(60, 40, 100))
	Kit.Sign(plate, Enum.NormalId.Front, "REST IN PURPLE", C(150, 255, 170))
	-- drum + dome + spire (tall: visible from spawn)
	Kit.Cyl(m, 12, 15, CFrame.new(-104, 36, 495), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
	Kit.Cyl(m, 1, 16.5, CFrame.new(-104, 42.2, 495), mint)
	Kit.Ball(m, 15, V(-104, 42.5, 495), C(112, 92, 150), { Mat = Enum.Material.Slate, Shadow = true })
	Kit.Cyl(m, 14, 1.4, CFrame.new(-104, 56, 495), C(240, 220, 120))
	local orb = Kit.Ball(m, 4.5, V(-104, 64, 495), glow, { Mat = NEON })
	Kit.Light(orb, glow, 40, 1.5)
	Kit.Emitter(orb, glow, 2, 4, 0.8)
	-- corner obelisks
	for _, x in { -121, -79 } do
		for _, z in { 476, 514 } do
			Kit.Box(m, V(x - 1.2, 0, z - 1.2), V(x + 1.2, 12, z + 1.2), light, { Mat = Enum.Material.Slate, Solid = true })
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z - 0.6), light)
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z + 0.6) * CFrame.Angles(0, math.pi, 0), light)
			Kit.Ball(m, 1.6, V(x, 14.6, z), mint)
		end
	end
	-- floating candles by the door
	for i = 0, 3 do
		Props.FloatingCandle(m, V(-80, 8 + (i % 2) * 2.5, 486 + i * 6))
	end
	Kit.AddRect(-124, 474, -76, 516)
end

local function crypt(f: Instance, cx: number, cz: number, fx: number, fz: number, flicker: boolean)
	local m = Kit.Model(f, "Crypt")
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = Kit.Pick(STONES)
	Kit.Part(m, V(15, 1, 13), base * CFrame.new(0, 0.5, 0), C(120, 122, 130), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(12, 10, 10), base * CFrame.new(0, 6, 0), stone, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- roof ridge runs front-to-back (local Z) so the triangle faces the front
	gable(m, base * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.pi / 2, 0), 12, 14, 5, C(96, 78, 132))
	local glow = Kit.Pick({ C(120, 255, 170), C(200, 130, 255) })
	local door = Kit.Part(m, V(4.4, 7, 0.4), base * CFrame.new(0, 4.5, -5.1), glow, { Mat = NEON, Transp = 0.15 })
	local trim: Kit.Opts = { Mat = Enum.Material.Marble }
	Kit.Part(m, V(5.6, 8.2, 0.3), base * CFrame.new(0, 4.6, -5.05), C(214, 210, 220), trim)
	Kit.Part(m, V(1, 3.6, 0.6), base * CFrame.new(0, 13.5, -6.3), C(214, 210, 220), trim)
	Kit.Part(m, V(2.6, 1, 0.6), base * CFrame.new(0, 14.2, -6.3), C(214, 210, 220), trim)
	if flicker then
		Kit.Light(door, glow, 16, 1.4, true)
	end
	Props.FloatingCandle(m, (base * CFrame.new(-4, 7.5, -7.5)).Position)
	Kit.AddCircle(cx, cz, 10)
end

local function gravestone(f: Instance, x: number, z: number)
	local rng = Kit.Rng
	local w = rng:NextNumber(3.6, 5.2)
	local h = rng:NextNumber(3.5, 6)
	local yaw = rng:NextNumber(-0.25, 0.25)
	local tilt = rng:NextNumber(-0.08, 0.08)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt, 0, tilt * 0.5)
	local col = Kit.Pick(STONES)
	local kind = rng:NextInteger(1, 6)
	if kind == 6 then
		-- cross
		Kit.Part(f, V(1.4, h + 2, 1), base * CFrame.new(0, (h + 2) / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Part(f, V(w * 0.8, 1.2, 1), base * CFrame.new(0, h * 0.75 + 0.6, 0), col, { Mat = Enum.Material.Slate })
	else
		local slab = Kit.Part(f, V(w, h, 1.2), base * CFrame.new(0, h / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
		Kit.Part(f, V(1.2, w, w), base * CFrame.new(0, h, 0) * CFrame.Angles(0, math.pi / 2, 0), col, { Mat = Enum.Material.Slate, Shape = Enum.PartType.Cylinder })
		if kind <= 2 then
			Kit.Sign(slab, Enum.NormalId.Front, Kit.Pick(EPITAPHS), C(90, 60, 130), { Stroke = C(235, 235, 240), Font = Enum.Font.GothamBlack })
		elseif kind == 3 then
			Kit.Part(f, V(w * 0.5, 0.3, 0.2), base * CFrame.new(0, h * 0.55, -0.65), Kit.Vivid(C(120, 255, 170)))
		end
	end
	-- little dirt mound in front
	Kit.Part(f, V(w + 0.6, 0.4, 3.4), base * CFrame.new(0, 0.1, -2.4), C(92, 78, 70), { Mat = Enum.Material.Ground })
	Kit.AddCircle(x, z, 2.5)
end

function Cemetery.Build(map: Instance)
	local f = Kit.Folder(map, "Cemetery")
	local rng = Kit.Rng

	-- main path + branch to the mausoleum
	Kit.Box(f, V(-8, -0.4, 260), V(8, 0.1, 540), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "Path" })
	Kit.Box(f, V(-80, -0.4, 490), V(-8, 0.08, 500), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true })
	local edging = Kit.Vivid(C(120, 255, 170))
	for z = 270, 530, 20 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 8, 0.1, z), V(s * 8.6, 0.25, z + 10), edging)
		end
	end
	Kit.AddRect(-9, 260, 9, 540, true)
	Kit.AddRect(-80, 489, -8, 501, true)

	mausoleum(f)
	crypt(f, 112, 300, -1, 0, true)
	crypt(f, -110, 345, 1, 0, true)
	crypt(f, 116, 500, -1, 0, false)
	crypt(f, -116, 392, 1, 0, false)

	-- lanterns along the path
	local lit = 0
	for z = 280, 530, 30 do
		for _, s in { -1, 1 } do
			local x = s * 10.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				-- warm orange lanterns on the left, ectoplasm green on the right
				Props.Lantern(f, V(x, 0, z), if s < 0 then C(255, 170, 80) else C(140, 255, 170), lit % 3 == 1 and lit <= 10)
				Kit.AddCircle(x, z, 1.5)
			end
		end
	end

	-- twisted trees (tall ones near the back so they show over the wall from spawn)
	local treeSpots = {
		{ -125, 280, 26 }, { 126, 285, 24 }, { -100, 300, 30 }, { 45, 292, 22 }, { -30, 380, 26 }, { 110, 410, 30 },
		{ 128, 430, 34 }, { -128, 455, 36 }, { 30, 470, 28 }, { 100, 470, 34 }, { -60, 522, 38 }, { 60, 525, 40 },
		{ -128, 525, 34 }, { 128, 525, 36 },
	}
	for _, t in treeSpots do
		if Kit.IsFree(t[1], t[2], 4) then
			Props.TwistedTree(f, V(t[1], 0, t[2]), t[3])
		end
	end

	-- gravestone field on a jittered grid
	for gx = -128, 128, 11 do
		for gz = 272, 532, 12 do
			local x = gx + rng:NextNumber(-2, 2)
			local z = gz + rng:NextNumber(-2, 2)
			if rng:NextNumber() < 0.45 and Kit.IsFree(x, z, 3.2) then
				gravestone(f, x, z)
			end
		end
	end

	-- iron fences around the mausoleum yard and a few decorative runs
	Props.Fence(f, V(-126, 0, 472), V(-84, 0, 472), "iron")
	Props.Fence(f, V(-126, 0, 518), V(-84, 0, 518), "iron")
	Props.Fence(f, V(-133, 0, 300), V(-133, 0, 330), "iron")
	Props.Fence(f, V(133, 0, 330), V(133, 0, 360), "iron")

	-- neon ectoplasm cracks in the ground (flat, fine inside ghost areas)
	for _ = 1, 16 do
		local p = V(rng:NextNumber(-120, 120), 0.1, rng:NextNumber(275, 530))
		local a = rng:NextNumber(0, math.pi * 2)
		for _ = 1, 3 do
			a += rng:NextNumber(-1, 1)
			local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(3, 6)
			Props.Beam(f, p, q, 0.5, 0.12, C(120, 255, 170), { Mat = NEON })
			p = q
		end
	end

	-- glowing mushrooms
	local shrooms = 0
	for _ = 1, 200 do
		if shrooms >= 14 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(270, 530)
		if Kit.IsFree(x, z, 2.5) then
			shrooms += 1
			Props.Mushrooms(f, V(x, 0, z))
			Kit.AddCircle(x, z, 2.5)
		end
	end

	-- slow purple fog
	for _, p in { V(-40, 0, 300), V(40, 0, 395), V(-95, 0, 470), V(95, 0, 330), V(30, 0, 520) } do
		Props.Wisp(f, p, C(170, 110, 255), 14, true)
	end
	for _, p in { V(-60, 0, 360), V(80, 0, 500), V(-20, 0, 460) } do
		Props.Wisp(f, p, C(120, 255, 170), 10, false)
	end
end

return Cemetery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Gates</string>
            <string name="Source"><![CDATA[--!strict
-- Zone gates: workspace.Map.Gates.Gate_<ZoneId> with Barrier, Arch, PromptAnchor and Sign
-- (TextLabel "CostLabel" on the sign's Front face, which faces the approaching player at -Z).
-- The Barrier is a ForceField-material wall (shimmering, no neon blow-out); the client
-- (Ambience) toggles its collision, tweens its Color/Size/CFrame/Transparency on unlock.
-- Trims are painted (solid); only the hanging lanterns, pillar jack-o'-lanterns and the
-- skull's eyes glow.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Format = require(game:GetService("ReplicatedStorage").GH.Logic.Format)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Gates = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

type Theme = { Stone: Color3, Trim: Color3, Barrier: Color3, Lamp: Color3 }

local THEMES: { [string]: Theme } = {
	Cemetery = { Stone = C(150, 125, 200), Trim = C(140, 255, 120), Barrier = C(180, 110, 255), Lamp = C(140, 255, 160) },
	School = { Stone = C(225, 120, 100), Trim = C(210, 120, 255), Barrier = C(100, 255, 190), Lamp = C(220, 150, 255) },
	Carnival = { Stone = C(235, 75, 85), Trim = C(255, 210, 70), Barrier = C(255, 120, 200), Lamp = C(255, 220, 120) },
	Hospital = { Stone = C(220, 228, 238), Trim = C(100, 180, 255), Barrier = C(120, 255, 200), Lamp = C(170, 230, 255) },
	Harbor = { Stone = C(125, 90, 60), Trim = C(70, 200, 200), Barrier = C(90, 255, 210), Lamp = C(255, 200, 110) },
	Castle = { Stone = C(150, 150, 165), Trim = C(255, 200, 70), Barrier = C(190, 110, 255), Lamp = C(255, 190, 100) },
	SpiritRealm = { Stone = C(70, 60, 110), Trim = C(110, 230, 255), Barrier = C(110, 240, 255), Lamp = C(150, 255, 230) },
}

local function buildGate(folder: Instance, id: string, z: number, width: number)
	local zone = Config.ZoneById[id]
	local theme = THEMES[id] or THEMES.Cemetery
	local half = width / 2
	local m = Kit.Model(folder, "Gate_" .. id)
	local trim = Kit.Vivid(theme.Trim)

	-- Barrier: fills the opening. Other code toggles collision locally and tweens it.
	local barrier = Kit.Part(m, V(width, 30, 2), CFrame.new(0, 15, z), theme.Barrier, {
		Name = "Barrier",
		Mat = Enum.Material.ForceField,
		Transp = 0.4,
		Solid = true,
		Shadow = false,
	})
	barrier.CanQuery = false
	barrier.CanTouch = true

	-- Arch around the opening (never inside it).
	local arch = Kit.Model(m, "Arch")
	local pw = 8 -- pillar width
	for _, s in { -1, 1 } do
		local x1, x2 = s * half, s * (half + pw)
		Kit.Box(arch, V(x1, 0, z - 5), V(x2, 32, z + 5), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(arch, V(s * (half + 0.01), 0, z - 6), V(s * (half + pw + 1), 3, z + 6), theme.Stone:Lerp(Color3.new(0, 0, 0), 0.2), { Mat = Enum.Material.Slate, Solid = true })
		-- painted trims on the pillar fronts (both sides)
		for _, fz in { -1, 1 } do
			for _, ex in { 0.6, pw - 0.6 } do
				local x = s * (half + ex)
				Kit.Box(arch, V(x - 0.3, 3, z + fz * 5), V(x + 0.3, 30, z + fz * 5.3), trim)
			end
		end
		-- glowing jack-o'-lantern on top of each pillar
		Props.Pumpkin(arch, V(s * (half + pw / 2), 36, z), 6.5, 0, -1, true)
		-- hanging lantern on the approach side
		local lx = s * (half + pw / 2)
		Kit.Box(arch, V(lx - 0.3, 24, z - 5.8), V(lx + 0.3, 26, z - 5), C(50, 40, 70))
		local lamp = Kit.Box(arch, V(lx - 1.1, 21, z - 6.8), V(lx + 1.1, 24, z - 4.6), theme.Lamp, { Mat = NEON })
		Kit.Light(lamp, theme.Lamp, 22, 1.6)
	end
	-- top beam (Y 30..36) spanning the opening above the barrier
	Kit.Box(arch, V(-(half + pw + 1), 30, z - 4), V(half + pw + 1, 36, z + 4), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
	for _, fz in { -1, 1 } do
		Kit.Box(arch, V(-(half + pw + 1), 30, z + fz * 4), V(half + pw + 1, 30.6, z + fz * 4.3), trim)
	end
	-- crenellations
	for i = -2, 2 do
		local x = i * 9
		Kit.Box(arch, V(x - 2, 36, z - 3), V(x + 2, 38, z + 3), theme.Stone, { Mat = Enum.Material.Slate })
	end
	-- skull centrepiece on the approach face
	Props.Skull(arch, V(0, 33, z - 5), 4.5, 0, -1)
	-- low wisps either side of the opening
	Props.Wisp(arch, V(-(half + 5), 0, z - 9), theme.Barrier, 10, false)
	Props.Wisp(arch, V(half + 5, 0, z - 9), theme.Barrier, 10, false)

	-- Sign above the arch, Front face (-Z) toward players coming from the previous zone.
	local sign = Kit.Part(m, V(40, 10, 1), CFrame.new(0, 43, z - 3), C(45, 25, 80), { Name = "Sign" })
	Kit.Part(arch, V(42, 12, 0.6), CFrame.new(0, 43, z - 2.3), trim) -- frame
	local gui = Kit.Gui(sign, Enum.NormalId.Front, 30)
	Kit.Label(gui, zone.Name, zone.Accent, {
		Name = "ZoneLabel",
		Pos = UDim2.fromScale(0.03, 0.04),
		Size = UDim2.fromScale(0.94, 0.5),
	})
	Kit.Label(gui, "🔒 " .. Format.Short(zone.Cost) .. " ECTOPLASM", C(150, 255, 140), {
		Name = "CostLabel",
		Pos = UDim2.fromScale(0.08, 0.56),
		Size = UDim2.fromScale(0.84, 0.38),
	})

	-- Prompt anchor on the near side.
	Kit.Part(m, V(1, 1, 1), CFrame.new(0, 4, z - 6), C(255, 255, 255), { Name = "PromptAnchor", Transp = 1 })

	m.PrimaryPart = barrier
end

function Gates.Build(map: Instance)
	local folder = Kit.Folder(map, "Gates")
	for id, g in Kit.Gates(Config.Layout) do
		buildGate(folder, id, g.Z, g.Width)
	end
end

return Gates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Harbor</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 6: Ghost Ship Harbor (Z 1560..1920).
--   Cobblestone quay at Y = 0 with a WoodPlanks boardwalk along X = 0 (gate to gate) and
--   plank deck pads painted under every ghost area (flat, <= 0.17 tall).
--   -X side: muted-red brick harbour wall, three open-front warehouses (X -138..-112) and a row
--   of town houses behind the wall.
--   +X side: low quay curb + rope railing; the ocean (Y -1.5) beyond X = 146; a shallow
--   wading inlet (floor Y -0.5, no pit) at X 104..146, Z 1600..1650 with a pier and fishing hut.
--   Landmarks: the haunted ship "The Salty Specter" moored along +X (hull X 130..174,
--   Z 1672..1810, masts to Y ~102) and a red/white striped lighthouse at (116, 1866), ~94 tall.
--   Glow is limited to portholes, stern windows, a few rune lines, the figurehead heart, the
--   lighthouse lamp, lamp globes, a few ghostly windows and floating spectral lanterns.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Harbor = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local COBBLE = Enum.Material.Cobblestone
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1560, 1920

local SEA = C(28, 72, 128)
local SEA_TEAL = C(45, 135, 150)
local QUAY = C(118, 132, 150)
local PLANK = C(170, 125, 82)
local PLANK_DARK = C(112, 78, 55)
local HULL = C(92, 62, 48)
local MAST = C(110, 80, 58)
local RED = C(175, 72, 66)
local TEAL = C(60, 185, 185)
local SPECTRAL = C(120, 255, 170)
local PURPLE = C(160, 110, 230)
local SAIL = C(238, 232, 212)
local SAIL_TEAL = C(170, 222, 215)
local IRON = C(58, 60, 74)
local GOLD = C(255, 200, 60)
local ROPE = C(205, 178, 130)
local WARM = C(255, 205, 120)
local CRATES = { C(185, 135, 85), C(160, 110, 70), C(200, 150, 95), C(140, 100, 70) }

local SOLID_PLANKS: Kit.Opts = { Mat = PLANKS, Solid = true, Shadow = true }

-- Gable roof, ridge along local X, slopes toward local ±Z, bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = true, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Plan-view triangle (Y y0..y1): right angle at (xEdge, zBase), point at (xEdge, zTip) with
-- zTip > zBase, widest at (xOuter, zBase). Two mirrored halves make the ship's bow.
local function bowHalf(parent: Instance, xEdge: number, xOuter: number, zBase: number, zTip: number, y0: number, y1: number, color: Color3, opts: Kit.Opts)
	local s = if xOuter > xEdge then 1 else -1
	local center = V((xEdge + xOuter) / 2, (y0 + y1) / 2, (zBase + zTip) / 2)
	local cf = CFrame.fromMatrix(center, V(0, s, 0), V(s, 0, 0))
	Kit.Wedge(parent, V(y1 - y0, math.abs(xOuter - xEdge), zTip - zBase), cf, color, opts)
end

local function crate(parent: Instance, pos: Vector3, s: number, yaw: number)
	local cf = CFrame.new(pos + V(0, s / 2, 0)) * CFrame.Angles(0, yaw, 0)
	Kit.Part(parent, V(s, s, s), cf, Kit.Pick(CRATES), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(parent, V(s + 0.12, s * 0.18, s + 0.12), cf, PLANK_DARK, { Mat = WOOD })
end

local function barrel(parent: Instance, pos: Vector3, h: number)
	Kit.Cyl(parent, h, 2.8, CFrame.new(pos + V(0, h / 2, 0)), C(150, 100, 62), { Mat = WOOD, Solid = true })
	for _, t in { 0.22, 0.78 } do
		Kit.Cyl(parent, 0.35, 2.95, CFrame.new(pos + V(0, h * t, 0)), IRON, { Mat = METAL })
	end
end

--==================================================================
-- GROUND, WATER, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	local quay: Kit.Opts = { Mat = COBBLE, Solid = true }
	Kit.Box(f, V(-190, -4, Z0), V(104, 0, Z1), QUAY, { Mat = COBBLE, Solid = true, Name = "Ground_Harbor" })
	Kit.Box(f, V(104, -4, Z0), V(146, 0, 1600), QUAY, quay)
	Kit.Box(f, V(104, -4, 1650), V(146, 0, Z1), QUAY, quay)
	-- shallow wading inlet: solid floor at Y -0.5 (half-stud step, no pit) under clear water
	Kit.Box(f, V(104, -4, 1600), V(146, -0.5, 1650), C(80, 120, 125), { Mat = Enum.Material.Sand, Solid = true, Name = "InletFloor" })
	Kit.Box(f, V(104, -0.5, 1600), V(146, -0.15, 1650), SEA_TEAL, { Transp = 0.45, Refl = 0.2, Name = "InletWater" })
	-- timber edging around the inlet and a sea-gate beam hiding the step down to the ocean
	Kit.Box(f, V(102.8, -0.5, 1600), V(104, 0.3, 1650), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1598.8), V(140, 0.3, 1600), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1650), V(140, 0.3, 1651.2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(144, -2, 1598.8), V(146, 0.4, 1651.2), PLANK_DARK, { Mat = WOOD })
	Kit.AddRect(102, 1598, 140, 1652)

	-- the ocean (outside the play area), moonlit streaks and a few rocks
	Kit.Box(f, V(146, -3, Z0), V(190, -1.5, Z1), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(190, -3, 1520), V(560, -1.5, 1960), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(170, -1.5, 1700), V(540, -1.44, 1712), C(170, 225, 235), { Transp = 0.45 })
	Kit.Box(f, V(200, -1.5, 1726), V(540, -1.44, 1732), C(170, 225, 235), { Transp = 0.55 })
	Kit.Disc(f, 420, 1716, -1.42, 46, 0.06, C(250, 245, 215), { Transp = 0.35, Name = "MoonGlow" })
	for _, r in { { 232, 1612, 18 }, { 262, 1846, 24 }, { 205, 1900, 14 }, { 300, 1760, 12 } } do
		Kit.Ball(f, r[3], V(r[1], -4, r[2]), C(85, 95, 115), { Mat = ROCK })
	end

	-- boardwalk path along X = 0 with painted teal edges
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), PLANK, { Mat = PLANKS, Solid = true, Name = "Boardwalk" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, Z0), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(TEAL))
	end
	-- plank dock patches on the quay (flat)
	for _, d in { { 30, 1598, 102, 1660 }, { -110, 1576, -40, 1610 }, { 30, 1790, 100, 1840 }, { -108, 1830, -30, 1890 } } do
		Kit.Box(f, V(d[1], 0, d[2]), V(d[3], 0.04, d[4]), PLANK, { Mat = PLANKS })
	end
end

local function sideWalls(f: Instance)
	-- -X: brick harbour wall with slate cap and wooden posts topped with buoys
	local brick = C(160, 86, 74)
	Kit.Box(f, V(-146, 0, Z0 + 3), V(-140, 14, Z1 - 3), brick, { Mat = Enum.Material.Brick, Solid = true })
	Kit.Box(f, V(-146.6, 14, Z0 + 3), V(-139.4, 15.2, Z1 - 3), C(70, 110, 150), { Mat = Enum.Material.Slate })
	Kit.Box(f, V(-139.95, 3, Z0 + 3), V(-139.7, 3.8, Z1 - 3), Kit.Vivid(TEAL))
	local n = 0
	for z = Z0 + 20, Z1 - 15, 30 do
		n += 1
		Kit.Box(f, V(-147, 0, z - 2), V(-139, 17, z + 2), PLANK_DARK, { Mat = WOOD, Solid = true })
		Kit.Ball(f, 3, V(-143, 18.2, z), Kit.Vivid(if n % 2 == 0 then RED else TEAL))
	end
	-- life rings on the wall facing the docks
	for _, z in { 1650, 1770, 1890 } do
		Kit.CylFlat(f, 0.5, 3.4, V(-139.5, 8, z), "X", Kit.Vivid(RED))
		Kit.CylFlat(f, 0.6, 1.6, V(-139.45, 8, z), "X", C(240, 240, 235))
	end
	-- town houses behind the wall (backdrop)
	local houses = { C(120, 80, 110), C(70, 110, 140), C(150, 90, 75), C(80, 125, 120), C(120, 95, 70), C(95, 85, 140) }
	for i, z in { 1584, 1640, 1700, 1760, 1820, 1882 } do
		local h = 22 + (i % 3) * 6
		Kit.Box(f, V(-186, 0, z - 13), V(-152, h, z + 13), houses[i], { Mat = if i % 2 == 0 then PLANKS else Enum.Material.Brick })
		gable(f, CFrame.new(-169, h, z) * CFrame.Angles(0, math.pi / 2, 0), 28, 38, 10, C(55, 70, 105), Enum.Material.Slate)
		local ghostly = i % 2 == 1
		Kit.Box(f, V(-152.3, h - 9, z - 3), V(-151.9, h - 4, z + 3), if ghostly then SPECTRAL else WARM, { Mat = if ghostly then NEON else Enum.Material.SmoothPlastic })
	end

	-- +X: low quay curb, rope railing on posts (gaps at the inlet and where the ship's hull is)
	local curb = C(100, 112, 130)
	Kit.Box(f, V(140, 0, Z0 + 3), V(146, 1, 1600), curb, { Mat = COBBLE, Solid = true })
	Kit.Box(f, V(140, 0, 1650), V(146, 1, Z1 - 3), curb, { Mat = COBBLE, Solid = true })
	for _, seg in { { 1566, 1598 }, { 1652, 1664 }, { 1818, 1914 } } do
		local a, b = seg[1], seg[2]
		local z = a
		while z <= b do
			Kit.Cyl(f, 5, 1.2, CFrame.new(143, 3, z), PLANK_DARK, { Mat = WOOD })
			z += 16
		end
		Kit.CylFlat(f, b - a, 0.4, V(143, 4, (a + b) / 2), "Z", ROPE, { Mat = FABRIC })
	end
	-- decorative pier out into the ocean (beyond the wall)
	Kit.Box(f, V(146, -0.8, 1578), V(190, -0.2, 1590), PLANK, { Mat = PLANKS })
	for x = 152, 186, 11 do
		for _, z in { 1577.5, 1590.5 } do
			Kit.Cyl(f, 5, 1.3, CFrame.new(x, -1.5, z), PLANK_DARK, { Mat = WOOD })
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ship(f: Instance)
	local m = Kit.Model(f, "GhostShip")
	local cx = 152
	local x0, x1 = 130, 174
	local zs, ze, zt = 1672, 1778, 1810 -- stern, start of bow, bow tip
	local deckOpts: Kit.Opts = { Mat = PLANKS }

	-- hull + bow + deck
	Kit.Box(m, V(x0, -6, zs), V(x1, 17, ze), HULL, SOLID_PLANKS)
	bowHalf(m, cx, x0, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	bowHalf(m, cx, x1, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 17, zs), V(x1 - 1, 18, ze), PLANK, deckOpts)
	bowHalf(m, cx, x0 + 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	bowHalf(m, cx, x1 - 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	-- bulwarks
	Kit.Box(m, V(x0, 17, zs), V(x0 + 1.2, 21, ze), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1.2, 17, zs), V(x1, 21, ze), HULL, deckOpts)
	Props.Beam(m, V(x0 + 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	Props.Beam(m, V(x1 - 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	-- muted red wale, teal waterline and gold rail on the side players see (-X), plus the bow
	Kit.Box(m, V(x0 - 0.3, 9, zs), V(x0 + 0.2, 11.5, ze), Kit.Vivid(RED), { Mat = WOOD })
	Props.Beam(m, V(x0 - 0.2, 10.25, ze), V(cx, 10.25, zt + 0.3), 0.6, 2.5, Kit.Vivid(RED), { Mat = WOOD })
	Kit.Box(m, V(x0 - 0.25, -1.5, zs), V(x0 + 0.2, 0.3, ze), Kit.Vivid(TEAL))
	Kit.Box(m, V(x0 - 0.35, 20.6, zs), V(x0 + 1.3, 21.3, ze), Kit.Vivid(GOLD), { Mat = METAL })

	-- stern castle (faces players arriving from the gate)
	Kit.Box(m, V(x0, 17, zs), V(x1, 30, 1700), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 30, zs), V(x1 - 1, 31, 1700), PLANK, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x0 + 1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1, 30, zs), V(x1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x1, 33.5, zs + 1), HULL, deckOpts)
	Kit.Box(m, V(x0 - 0.3, 29, zs - 0.3), V(x1 + 0.3, 30, 1700), Kit.Vivid(RED), { Mat = WOOD })
	for i = -1, 1 do
		local x = cx + i * 12
		local win = Kit.Box(m, V(x - 2.6, 20, zs - 0.35), V(x + 2.6, 26.5, zs + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
		Kit.Box(m, V(x - 3.2, 19.4, zs - 0.2), V(x + 3.2, 27.1, zs + 0.1), Kit.Vivid(GOLD), { Mat = METAL })
		if i == 0 then
			Kit.Light(win, SPECTRAL, 30, 1.4)
		end
		Kit.Box(m, V(x - 2.4, 6, zs - 0.25), V(x + 2.4, 10.5, zs + 0.1), C(40, 60, 85))
	end
	-- forecastle
	Kit.Box(m, V(x0, 17, 1758), V(x1, 23, ze), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 23, 1758), V(x1 - 1, 23.6, ze), PLANK, deckOpts)

	-- masts, yards, tattered sails, crow's nest, ropes
	local masts = { { 1712, 80 }, { 1738, 102 }, { 1764, 88 } }
	local tops: { Vector3 } = {}
	for i, mst in masts do
		local z, top = mst[1], mst[2]
		Kit.Cyl(m, top - 17, 3, CFrame.new(cx, (17 + top) / 2, z), MAST, { Mat = WOOD, Shadow = true })
		local span = top - 17
		local yA = 17 + span * 0.55
		local yB = 17 + span * 0.88
		local lowW = 34 + i * 2
		Kit.CylFlat(m, lowW + 4, 1.2, V(cx, yA, z), "X", MAST, { Mat = WOOD })
		Kit.CylFlat(m, lowW - 4, 1.1, V(cx, yB, z), "X", MAST, { Mat = WOOD })
		local col = if i == 2 then SAIL_TEAL else SAIL
		local sailOpts: Kit.Opts = { Mat = FABRIC, Transp = 0.06 }
		-- lower sail torn into two ragged halves plus a dangling strip
		local h1 = (yA - 22) * 0.95
		local h2 = (yA - 22) * 0.7
		Kit.Part(m, V(lowW / 2 - 1, h1, 0.5), CFrame.new(cx - lowW / 4, yA - h1 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0), col, sailOpts)
		Kit.Part(m, V(lowW / 2 - 1, h2, 0.5), CFrame.new(cx + lowW / 4, yA - h2 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0.04), col, sailOpts)
		Kit.Part(m, V(3, h1 - h2 + 2, 0.4), CFrame.new(cx + lowW / 4 + 3, yA - h2 - (h1 - h2) / 2, z + 1.1) * CFrame.Angles(0, 0, 0.18), col, sailOpts)
		local hU = (yB - yA) - 3
		Kit.Part(m, V(lowW - 8, hU, 0.5), CFrame.new(cx, yB - hU / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.06, 0, 0), if i == 2 then SAIL else SAIL_TEAL, sailOpts)
		table.insert(tops, V(cx, top - 3, z))
		-- shrouds: two to the -X bulwark (visible side), one to +X
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z - 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z + 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x1 - 0.6, 21, z), 0.35, 0.35, ROPE)
	end
	Props.Beam(m, tops[1], tops[2], 0.35, 0.35, ROPE)
	Props.Beam(m, tops[2], tops[3], 0.35, 0.35, ROPE)
	Kit.Cyl(m, 3, 8, CFrame.new(cx, 86.5, 1738), PLANK_DARK, { Mat = WOOD })
	-- ghostly flag on the main mast
	local flag = Kit.Part(m, V(0.4, 7, 11), CFrame.new(cx, 97, 1738 - 6.5), C(40, 34, 55), { Mat = FABRIC })
	Kit.Sign(flag, Enum.NormalId.Left, "👻", C(240, 240, 240))
	-- bowsprit + forestay
	local sprTip = V(cx, 31, zt + 22)
	Props.Beam(m, V(cx, 20, zt - 6), sprTip, 1.6, 1.6, MAST, { Mat = WOOD })
	Props.Beam(m, tops[3], sprTip, 0.35, 0.35, ROPE)

	-- spectral figurehead
	Props.Beam(m, V(cx, 7, zt - 1), V(cx, 13.5, zt + 1.6), 3, 2.4, C(200, 240, 235), { Transp = 0.15 })
	Kit.Ball(m, 3.6, V(cx, 15.4, zt + 2), C(210, 245, 240), { Transp = 0.15 })
	Kit.Wedge(m, V(3.4, 4, 2), CFrame.new(cx, 14.5, zt + 0.6), C(150, 225, 220), { Transp = 0.15 })
	local heart = Kit.Ball(m, 1.6, V(cx, 11.6, zt + 2.2), SPECTRAL, { Mat = NEON })
	Kit.Light(heart, SPECTRAL, 28, 1.8)

	-- cannons and gun ports on the -X side
	for i = 0, 5 do
		local z = 1708 + i * 12
		Kit.Box(m, V(x0 - 0.25, 12.3, z - 1.6), V(x0 + 0.1, 15.3, z + 1.6), C(30, 25, 32))
		Kit.CylFlat(m, 6, 1.8, V(x0 - 2.6, 13.8, z), "X", IRON, { Mat = METAL })
	end
	-- glowing portholes with brass rims
	for i = 0, 7 do
		local z = 1680 + i * 12
		Kit.CylFlat(m, 0.3, 3.2, V(x0 - 0.15, 4.5, z), "X", Kit.Vivid(GOLD), { Mat = METAL })
		Kit.CylFlat(m, 0.2, 2.3, V(x0 - 0.38, 4.5, z), "X", SPECTRAL, { Mat = NEON })
	end
	-- spectral rune zigzag on the hull
	local runes = { V(x0 - 0.3, 0.8, 1690), V(x0 - 0.3, 7.6, 1700), V(x0 - 0.3, 1.2, 1712), V(x0 - 0.3, 7.2, 1724) }
	for i = 1, #runes - 1 do
		Props.Beam(m, runes[i], runes[i + 1], 0.35, 0.35, PURPLE, { Mat = NEON })
	end
	-- name board
	Props.SignBoard(m, V(x0 - 0.5, 13.8, 1690), 16, 3.2, -1, 0, "THE SALTY SPECTER", C(40, 30, 45), Kit.Vivid(GOLD), GOLD)

	-- green deck fog
	local fog = Kit.Part(m, V(30, 0.2, 70), CFrame.new(cx, 19, 1735), SPECTRAL, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, SPECTRAL, 2, 10, 0.3)

	-- mooring bollards with ropes up to the hull
	for _, z in { 1690, 1770 } do
		Kit.Cyl(m, 2.4, 2, CFrame.new(121, 1.2, z), IRON, { Mat = METAL, Solid = true })
		Kit.Cyl(m, 0.6, 2.8, CFrame.new(121, 2.5, z), IRON, { Mat = METAL })
		Props.Beam(m, V(121, 2.2, z), V(x0 - 0.2, 16, z + 4), 0.4, 0.4, ROPE)
		Kit.AddCircle(121, z, 2)
	end
	Kit.AddRect(124, zs - 6, 140, zt + 4)
end

local function lighthouse(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Lighthouse")
	local white, red = C(248, 245, 238), Kit.Vivid(C(205, 60, 60))
	local rock = C(105, 112, 125)
	Kit.Disc(m, x, z, 1.5, 24, 2, rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 9, V(x + 9, 0, z - 7), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 7, V(x - 7, 0, z + 9), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 6, V(x + 6, 0, z + 9), C(90, 100, 115), { Mat = ROCK })
	local seg = 12
	for i = 0, 5 do
		local d = 16 - i * 0.8
		Kit.Cyl(m, seg, d, CFrame.new(x, 1.5 + seg * i + seg / 2, z), if i % 2 == 0 then red else white, { Mat = Enum.Material.Plastic, Solid = true, Shadow = true })
	end
	-- door and windows on the side facing the boardwalk (-X)
	Kit.Box(m, V(x - 8.1, 1.5, z - 2.4), V(x - 7.4, 9, z + 2.4), PLANK_DARK, { Mat = WOOD })
	Kit.Box(m, V(x - 8.25, 8.6, z - 2.9), V(x - 7.4, 9.4, z + 2.9), Kit.Vivid(TEAL))
	for _, w in { { 1, 26 }, { 3, 50 } } do
		local r = (16 - w[1] * 0.8) / 2
		Kit.Box(m, V(x - r - 0.2, w[2] - 2, z - 1.2), V(x - r + 0.6, w[2] + 2, z + 1.2), C(55, 85, 120))
	end
	-- gallery + railing
	Kit.Disc(m, x, z, 75.5, 19, 1.5, IRON, { Mat = METAL })
	local posts: { Vector3 } = {}
	for i = 0, 5 do
		local a = i * math.pi / 3
		local p = V(x + math.cos(a) * 9, 75.5, z + math.sin(a) * 9)
		Kit.Box(m, p + V(-0.2, 0, -0.2), p + V(0.2, 3, 0.2), IRON, { Mat = METAL })
		table.insert(posts, p + V(0, 3, 0))
	end
	for i = 1, 6 do
		Props.Beam(m, posts[i], posts[(i % 6) + 1], 0.3, 0.3, red, { Mat = METAL })
	end
	-- lamp room: glass drum, warm lamp, frame
	Kit.Cyl(m, 8, 10, CFrame.new(x, 79.5, z), C(175, 230, 235), { Mat = Enum.Material.Glass, Transp = 0.5, Refl = 0.2 })
	local lamp = Kit.Ball(m, 4.5, V(x, 79.5, z), C(255, 225, 140), { Mat = NEON })
	Kit.Light(lamp, C(255, 215, 140), 60, 2.4)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * 5, z + math.sin(a) * 5
		Kit.Box(m, V(px - 0.25, 75.5, pz - 0.25), V(px + 0.25, 83.6, pz + 0.25), IRON, { Mat = METAL })
	end
	-- roof
	Kit.Disc(m, x, z, 84.5, 12.5, 1, red)
	Kit.Cyl(m, 2, 9, CFrame.new(x, 85.5, z), red)
	Kit.Cyl(m, 2, 6, CFrame.new(x, 87.5, z), red)
	Kit.Cyl(m, 2, 3, CFrame.new(x, 89.5, z), red)
	Kit.Ball(m, 1.8, V(x, 91.2, z), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Cyl(m, 3, 0.3, CFrame.new(x, 93.5, z), IRON, { Mat = METAL })
	Kit.AddCircle(x, z, 14)
end

local function warehouse(f: Instance, z1: number, z2: number, wall: Color3, roof: Color3, text: string, flicker: boolean)
	local m = Kit.Model(f, "Warehouse")
	local xb, xf = -138, -112
	local h = 18
	local sol: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }
	Kit.Box(m, V(xb, 0, z1), V(xb + 2, h, z2), wall, sol)
	Kit.Box(m, V(xb, 0, z1), V(xf, h, z1 + 2), wall, sol)
	Kit.Box(m, V(xb, 0, z2 - 2), V(xf, h, z2), wall, sol)
	for _, zz in { z1, z2 - 2 } do
		Kit.Box(m, V(xf - 0.6, 0, zz - 0.3), V(xf + 0.8, h + 0.4, zz + 2.3), PLANK_DARK, { Mat = WOOD, Solid = true })
	end
	local fascia = Kit.Box(m, V(xf - 1, h - 4, z1), V(xf + 0.6, h, z2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Sign(fascia, Enum.NormalId.Right, text, Kit.Vivid(C(255, 225, 120)), { Stroke = C(30, 40, 60) })
	gable(m, CFrame.new((xb + xf) / 2, h, (z1 + z2) / 2) * CFrame.Angles(0, math.pi / 2, 0), z2 - z1 + 2, xf - xb + 4, 9, roof, Enum.Material.Slate)
	Kit.Box(m, V(xb + 2, 0, z1 + 2), V(xf, 0.06, z2 - 2), PLANK, { Mat = PLANKS })
	-- one ghostly window on the side wall that faces the gate
	Kit.Box(m, V(-130, 8, z1 - 0.25), V(-122, 12.5, z1 + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	-- stacked cargo inside
	local rng = Kit.Rng
	for zz = z1 + 6, z2 - 6, 7 do
		crate(m, V(-133.5, 0, zz), 5, rng:NextNumber(-0.1, 0.1))
		if rng:NextNumber() < 0.6 then
			crate(m, V(-133.5, 5, zz), 4.2, rng:NextNumber(-0.25, 0.25))
		end
	end
	barrel(m, V(-124, 0, z1 + 6), 4)
	barrel(m, V(-121, 0, z1 + 8.5), 4)
	-- hanging lantern at the front
	local lx, lz = xf + 1.6, (z1 + z2) / 2
	Kit.Box(m, V(lx - 0.15, h - 6, lz - 0.15), V(lx + 0.15, h - 4, lz + 0.15), IRON)
	local lamp = Kit.Box(m, V(lx - 0.8, h - 8, lz - 0.8), V(lx + 0.8, h - 6, lz + 0.8), WARM, if flicker then { Mat = NEON } else {})
	if flicker then
		Kit.Light(lamp, WARM, 22, 1.4, true)
	end
	Kit.AddRect(xb - 2, z1 - 1, xf + 3, z2 + 1)
end

local function hut(f: Instance, x: number, z: number, fx: number, col: Color3)
	local m = Kit.Model(f, "FishingHut")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	Kit.Part(m, V(10, 9, 9), base * CFrame.new(0, 4.5, 0), col, { Mat = PLANKS, Solid = true, Shadow = true })
	Kit.Wedge(m, V(12, 3, 11), base * CFrame.new(0, 10.5, 0), C(60, 80, 115), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(3, 6, 0.3), base * CFrame.new(-2, 3, -4.6), PLANK_DARK, { Mat = WOOD })
	Kit.Part(m, V(2.6, 2.2, 0.3), base * CFrame.new(2.4, 5.2, -4.6), C(255, 215, 120))
	Kit.Part(m, V(0.2, 5, 6), base * CFrame.new(5.1, 4.8, 0), C(200, 190, 160), { Mat = FABRIC, Transp = 0.45 })
	Kit.CylFlat(m, 0.5, 2.6, (base * CFrame.new(2.4, 2.4, -4.8)).Position, "X", Kit.Vivid(RED))
	Props.Beam(m, (base * CFrame.new(-4.5, 1, -4.8)).Position, (base * CFrame.new(-6, 9, -9)).Position, 0.25, 0.25, PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function treasure(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TreasurePile")
	local gold = Kit.Vivid(GOLD)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.2 }
	Kit.Ball(m, 9, V(x, -2.2, z), gold, mo)
	Kit.Ball(m, 6, V(x + 4, -1.6, z - 3.5), gold, mo)
	-- chest
	local wood = C(135, 82, 48)
	Kit.Box(m, V(x - 3, 0, z + 2), V(x + 2.4, 3.2, z + 5.6), wood, { Mat = WOOD, Solid = true })
	Kit.CylFlat(m, 5.4, 3.6, V(x - 0.3, 3.2, z + 3.8), "X", wood, { Mat = WOOD })
	for _, bx in { -2.2, 1.6 } do
		Kit.Box(m, V(x + bx - 0.3, 0, z + 1.9), V(x + bx + 0.3, 5.1, z + 5.7), gold, { Mat = METAL })
	end
	Kit.Box(m, V(x - 0.8, 2.2, z + 1.8), V(x + 0.2, 3.4, z + 2), gold, { Mat = METAL })
	-- spilled coins, gems, a crown
	for i = 0, 3 do
		local a = i * 1.7
		Kit.Disc(m, x + math.cos(a) * 6, z + math.sin(a) * 6, 0.25, 1.8, 0.2, gold, mo)
	end
	for i, g in { C(230, 60, 90), C(60, 200, 210), C(170, 90, 240) } do
		Kit.Ball(m, 1.3, V(x - 2 + i * 1.4, 2.3 - i * 0.3, z - 1 + i * 0.6), Kit.Vivid(g), { Refl = 0.3 })
	end
	Kit.Cyl(m, 1.2, 2.6, CFrame.new(x + 0.4, 2.6, z - 0.4) * CFrame.Angles(0.2, 0, 0.15), gold, mo)
	Props.SignBoard(m, V(x - 6.5, 3, z - 4), 6, 2.4, -1, 0, "DO NOT TOUCH\n(CURSED)", C(245, 238, 220), Kit.Vivid(RED))
	Kit.Box(m, V(x - 6.65, 0, z - 4.2), V(x - 6.35, 1.8, z - 3.8), PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function anchor(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Anchor")
	local col = C(70, 95, 110)
	Kit.Disc(m, x, z, 0.6, 9, 0.6, C(90, 100, 115), { Mat = COBBLE, Solid = true })
	Kit.Box(m, V(x - 1, 0, z - 1), V(x + 1, 15, z + 1), col, { Mat = METAL, Solid = true })
	Kit.Box(m, V(x - 5, 12, z - 0.8), V(x + 5, 13.6, z + 0.8), col, { Mat = METAL })
	Kit.Ball(m, 2.6, V(x, 16.4, z), Kit.Vivid(TEAL), { Mat = METAL })
	for _, s in { -1, 1 } do
		Props.Beam(m, V(x, 1.2, z), V(x + s * 6, 5.5, z), 1.6, 1.6, col, { Mat = METAL })
		Kit.Ball(m, 2.8, V(x + s * 6.2, 5.8, z), col, { Mat = METAL })
	end
	Kit.AddCircle(x, z, 7)
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function deckPads(f: Instance)
	local pads = { { 0, 1645, 30 }, { -82, 1680, 24 }, { 75, 1740, 26 }, { -62, 1800, 24 }, { 0, 1860, 24 } }
	for i, p in pads do
		local ring = if i % 2 == 0 then Kit.Vivid(TEAL) else Kit.Vivid(C(110, 90, 170))
		Kit.Disc(f, p[1], p[2], 0.07, p[3] * 2 + 4, 0.07, ring)
		Kit.Disc(f, p[1], p[2], 0.1, p[3] * 2, 0.1, if i % 2 == 0 then PLANK else C(150, 108, 72), { Mat = PLANKS })
	end
	-- boss: compass rose + spectral rune ring
	local bx, bz = 0, 1860
	local gold = Kit.Vivid(GOLD)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Props.Beam(f, V(bx, 0.13, bz), V(bx + math.cos(a) * 18, 0.13, bz + math.sin(a) * 18), 2.6, 0.06, gold)
		local b = a + math.pi / 4
		Props.Beam(f, V(bx, 0.12, bz), V(bx + math.cos(b) * 11, 0.12, bz + math.sin(b) * 11), 1.8, 0.05, Kit.Vivid(TEAL))
	end
	Kit.Disc(f, bx, bz, 0.17, 5, 0.1, gold, { Mat = METAL })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.12
		local a2 = a1 + math.pi / 4 - 0.24
		Props.Beam(f, V(bx + math.cos(a1) * 21, 0.14, bz + math.sin(a1) * 21), V(bx + math.cos(a2) * 21, 0.14, bz + math.sin(a2) * 21), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Harbor.Build(map: Instance)
	local f = Kit.Folder(map, "Harbor")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	deckPads(f)
	ship(f)
	lighthouse(f, 116, 1866)
	warehouse(f, 1596, 1636, C(160, 82, 70), C(55, 95, 130), "FISH & SHIPS", false)
	warehouse(f, 1716, 1764, C(90, 110, 140), C(140, 60, 60), "CARGO", true)
	warehouse(f, 1836, 1880, C(130, 95, 75), C(60, 110, 120), "DOCK 13", false)

	-- pier across the inlet with a fishing hut at its end
	Kit.Box(f, V(104, -0.5, 1617), V(140, 0.06, 1631), PLANK, { Mat = PLANKS, Solid = true, Name = "Pier" })
	for _, x in { 107, 117, 127 } do
		for _, z in { 1616.6, 1631.4 } do
			Kit.Cyl(f, 3.5, 1.2, CFrame.new(x, 1.25, z), PLANK_DARK, { Mat = WOOD })
		end
	end
	hut(f, 133, 1624, -1, C(110, 140, 160))
	if Kit.IsFree(122, 1578, 7) then
		hut(f, 122, 1578, -1, C(170, 110, 90))
	end
	if Kit.IsFree(-64, 1600, 7) then
		hut(f, -64, 1600, 1, C(120, 150, 125))
	end
	if Kit.IsFree(70, 1830, 7) then
		hut(f, 70, 1830, -1, C(150, 120, 170))
	end

	-- floating spectral lanterns over the inlet and drifting bottles by the treasure
	for _, p in { V(110, 3.6, 1606), V(122, 4.2, 1644), V(136, 3.8, 1608), V(112, 4.4, 1641) } do
		local l = Kit.Part(f, V(1.2, 1.7, 1.2), CFrame.new(p), C(170, 255, 200), { Mat = NEON, Name = "FloatingLantern" })
		Kit.Float(l, rng:NextNumber(0.5, 1))
	end
	for _, p in { V(108, 3.5, 1712), V(124, 3.2, 1736) } do
		local b = Kit.Cyl(f, 1.8, 0.9, CFrame.new(p) * CFrame.Angles(0.5, 0, 0.3), C(120, 200, 170), { Mat = Enum.Material.Glass, Transp = 0.3, Name = "FloatingBottle" })
		Kit.Float(b, rng:NextNumber(0.5, 0.9))
	end
	-- pale fog rolling off the inlet
	local fog = Kit.Part(f, V(30, 0.2, 40), CFrame.new(122, 0.6, 1625), C(200, 235, 240), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(200, 235, 240), 1.5, 9, 0.3)

	treasure(f, 114, 1722)
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 40, 1872, 6) then
			anchor(f, s * 40, 1872)
		end
	end

	-- signs
	do
		local x, z = -60, 1578
		for _, s in { -1, 1 } do
			Kit.Cyl(f, 15, 1.4, CFrame.new(x + s * 11, 7.5, z), PLANK_DARK, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 12, z), 22, 6, 0, -1, "⚓ HARBOR ⚓", C(40, 70, 110), C(255, 235, 170), TEAL)
		Kit.AddCircle(x, z, 13)
	end
	if Kit.IsFree(18, 1698, 4) then
		Kit.Box(f, V(17.6, 0, 1698.2), V(18.4, 5, 1698.8), PLANK_DARK, { Mat = WOOD })
		Props.SignBoard(f, V(18, 6.5, 1698), 12, 5, 0, -1, "NO GHOSTS ALLOWED\n...OOPS", C(245, 240, 225), Kit.Vivid(RED), RED)
		Kit.AddCircle(18, 1698, 6)
	end

	-- harbour lamps along the boardwalk
	local lit = 0
	for z = 1590, 1900, 34 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 17 else 0)
			local x = s * 12.5
			if Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0, zz), WARM, lit == 1 or lit == 4 or lit == 7)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- cargo: crate stacks, barrel groups, rope coils, scattered on free quay
	local stacks, barrels, coils = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1572, 1908)
		if stacks < 16 and Kit.IsFree(x + 2.3, z, 5.5) then
			stacks += 1
			local yaw = rng:NextNumber(-0.3, 0.3)
			crate(f, V(x, 0, z), 4.5, yaw)
			crate(f, V(x + 4.6, 0, z + rng:NextNumber(-0.5, 0.5)), 4.5, yaw)
			if rng:NextNumber() < 0.6 then
				crate(f, V(x + 2.3, 4.5, z), 4, yaw + 0.2)
			end
			Kit.AddCircle(x + 2.3, z, 5.5)
		elseif barrels < 12 and Kit.IsFree(x + 1.4, z, 4) then
			barrels += 1
			barrel(f, V(x, 0, z), 4.2)
			barrel(f, V(x + 2.9, 0, z + 1), 4.2)
			if rng:NextNumber() < 0.5 then
				Kit.CylFlat(f, 4.2, 2.8, V(x + 1.4, 1.4, z - 2.6), "X", C(150, 100, 62), { Mat = WOOD })
			end
			Kit.AddCircle(x + 1.4, z, 4)
		elseif coils < 6 and Kit.IsFree(x, z, 2) then
			coils += 1
			Kit.Disc(f, x, z, 0.6, 3.6, 0.6, ROPE, { Mat = FABRIC })
			Kit.Disc(f, x, z, 0.65, 1.4, 0.1, PLANK_DARK)
			Kit.AddCircle(x, z, 2)
		end
	end

	-- a few spectral cracks in the quay
	for _ = 1, 4 do
		local p = V(rng:NextNumber(-120, 95), 0.13, rng:NextNumber(1600, 1890))
		local a = rng:NextNumber(0, math.pi * 2)
		Props.Beam(f, p, p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(5, 9), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

return Harbor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Hospital</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 5: Haunted Hospital (Z 1220..1560). Playful, pastel and a little supernatural (no gore).
--   Courtyard Z 1220..1268: path, Medical crate station (built by Stations), ambulance, sign,
--   planters, entrance canopy with the HOSPITAL facade and a red cross on a blue/white emblem.
--   Building X -113..113, Z 1269..1535, two-tone walls 16 tall, NO roof (parapet only) so the
--   camera and ghost taps work from above. Rooms (ghost areas in brackets):
--     Lobby / waiting room  X -51..49,  Z 1271..1351  [ (0,1305) r30 ]   reception desk, chairs
--     Ward B                X -111..-53, Z 1271..1397  [ (-82,1340) r24 ] beds in the corners
--     Patient rooms         X 51..111,   Z 1271..1351                    beds, curtains, monitors
--     X-Ray                 X 41..111,   Z 1353..1443  [ (75,1395) r26 ]  machine, lightbox
--     Atrium (hallway)      X -51..39,   Z 1353..1443                    elevators, carts
--     Paranormal lab        X -111..-33, Z 1399..1533  [ (-62,1455) r24 ] ecto tanks, spirit coil
--     Director's office     X -31..31,   Z 1445..1533  [ (0,1505) r22 boss ]
--     Pharmacy              X 33..111,   Z 1445..1533                    counter, shelves
--   Main path: front door (X -14..14) -> lobby -> atrium -> director's office -> back door
--   (X -14..14) -> back yard -> Harbor gate. Every doorway is a full-height opening >= 16 wide.
--   Landmark: the west wing tower (X -111..-85, Z 1507..1533, roof Y 72, antenna to ~Y 83).
-- Glow is kept to a few ghostly windows, ecto tanks, puddles, sconces and small lamps.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Hospital = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal
local CONCRETE = Enum.Material.Concrete
local WOOD = Enum.Material.WoodPlanks

local MIN_Z, MAX_Z = 1220, 1560
local H = 16
local FLOOR_Y = 0.13 -- top of the room floor paint
local WHITE = C(242, 244, 248)
local LBLUE = C(150, 205, 240)
local MGREEN = C(150, 200, 170)
local PURPLE = C(170, 120, 230)
local SPECT = C(130, 255, 190)
local DARK = C(45, 55, 85)
local REDX = C(235, 70, 80)
local GREY = C(190, 195, 210)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

--==================================================================
-- WALL HELPERS (two-tone: mint wainscot below, off-white above)
--==================================================================
type Opening = { c: number, w: number }

local LOWER = C(170, 215, 195)
local UPPER = C(236, 240, 244)

local function seg(parent: Instance, lo: Vector3, hi: Vector3)
	Kit.Box(parent, V(lo.X, 0, lo.Z), V(hi.X, 4.5, hi.Z), LOWER, SOLID)
	Kit.Box(parent, V(lo.X, 4.5, lo.Z), V(hi.X, H, hi.Z), UPPER, SOLID)
end

local function byCentre(a: Opening, b: Opening): boolean
	return a.c < b.c
end

-- Wall along X at fixed z (thickness 2) with full-height openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = x1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(cur, 0, z - 1), V(a, 0, z + 1))
		end
		cur = o.c + o.w / 2
	end
	if x2 > cur then
		seg(parent, V(cur, 0, z - 1), V(x2, 0, z + 1))
	end
end

-- Wall along Z at fixed x (thickness 2) with full-height openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = z1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(x - 1, 0, cur), V(x + 1, 0, a))
		end
		cur = o.c + o.w / 2
	end
	if z2 > cur then
		seg(parent, V(x - 1, 0, cur), V(x + 1, 0, z2))
	end
end

-- Wall lamp; fx = direction the lamp faces (wall face is behind it).
local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), DARK)
	Kit.Light(lamp, color, 24, 1.5, true)
end

local function puddle(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.22, d, 0.08, SPECT, { Mat = NEON, Transp = 0.25 })
end

--==================================================================
-- FURNITURE
--==================================================================
-- Hospital bed; (hx, hz) points toward the head end.
local function bed(f: Instance, x: number, z: number, hx: number, hz: number)
	local m = Kit.Model(f, "Bed")
	local base = faced(V(x, FLOOR_Y, z), hx, hz)
	Kit.Part(m, V(5, 2.2, 9), base * CFrame.new(0, 1.1, 0), WHITE, { Solid = true })
	Kit.Part(m, V(4.6, 1, 8.6), base * CFrame.new(0, 2.7, 0), Kit.Vivid(LBLUE), { Mat = FABRIC })
	Kit.Part(m, V(3.6, 0.8, 1.8), base * CFrame.new(0, 3.5, -3.2), WHITE, { Mat = FABRIC })
	Kit.Part(m, V(5.4, 5, 0.6), base * CFrame.new(0, 2.5, -4.7), Kit.Vivid(MGREEN))
	Kit.Part(m, V(4.8, 0.4, 4.6), base * CFrame.new(0, 3.3, 1.9), PURPLE:Lerp(WHITE, 0.35), { Mat = FABRIC })
	Kit.AddCircle(x, z, 5)
end

local function ivStand(f: Instance, x: number, z: number)
	Kit.Cyl(f, 7, 0.3, CFrame.new(x, FLOOR_Y + 3.5, z), GREY, { Mat = METAL })
	Kit.Box(f, V(x - 0.4, 5.6, z - 0.2), V(x + 0.4, 7, z + 0.2), Kit.Vivid(MGREEN), { Transp = 0.3 })
end

local function wheelchair(f: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(f, "Wheelchair")
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	local frame = Kit.Vivid(PURPLE)
	Kit.Part(m, V(2.6, 0.5, 2.4), base * CFrame.new(0, 2.2, 0), Kit.Vivid(LBLUE))
	Kit.Part(m, V(2.6, 3, 0.4), base * CFrame.new(0, 3.6, 1.2), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.3, 3.4, 3.4), base * CFrame.new(sx * 1.55, 1.7, 0.3), frame, { Shape = Enum.PartType.Cylinder })
	end
	Kit.Part(m, V(2.2, 0.3, 1), base * CFrame.new(0, 0.8, -1.8), frame)
	Kit.AddCircle(x, z, 2.5)
end

local function medCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "MedCart")
	Kit.Box(m, V(x - 2, 3.2, z - 1.3), V(x + 2, 3.6, z + 1.3), WHITE)
	Kit.Box(m, V(x - 2, 1, z - 1.3), V(x + 2, 1.3, z + 1.3), WHITE)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 1.85, FLOOR_Y, z - 1.3), V(x + s * 2.05, 3.2, z + 1.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x - 1.4, 3.6, z - 0.6), V(x - 0.2, 4.4, z + 0.6), Kit.Vivid(C(255, 150, 190)))
	Kit.Cyl(m, 1.2, 0.7, CFrame.new(x + 1, 4.2, z), Kit.Vivid(MGREEN))
	Kit.AddCircle(x, z, 3)
end

-- Bedside monitor with a SurfaceGui screen facing fx (-1 = -X, 1 = +X).
local function monitor(f: Instance, x: number, z: number, fx: number)
	Kit.Box(f, V(x - 0.25, FLOOR_Y, z - 0.25), V(x + 0.25, 5, z + 0.25), GREY, { Mat = METAL })
	local scr = Kit.Part(f, V(0.4, 2.2, 3), CFrame.new(x, 6, z), DARK)
	Kit.Sign(scr, if fx < 0 then Enum.NormalId.Left else Enum.NormalId.Right, "♥ BOO ♥", SPECT)
end

-- Row of joined waiting-room chairs along Z (facing +X when fx = 1).
local function chairRow(f: Instance, x: number, z1: number, z2: number, fx: number, color: Color3)
	Kit.Box(f, V(x - 1.5, 1.8, z1), V(x + 1.5, 2.4, z2), color, { Solid = true })
	Kit.Box(f, V(x - fx * 1.5, 2.4, z1), V(x - fx * 1, 5, z2), color)
	for _, z in { z1 + 0.8, z2 - 0.8 } do
		Kit.Box(f, V(x - 1.2, FLOOR_Y, z - 0.35), V(x + 1.2, 1.8, z + 0.35), GREY, { Mat = METAL })
	end
	Kit.AddRect(x - 2, z1, x + 2, z2)
end

local function chair(f: Instance, x: number, z: number, fx: number, fz: number, color: Color3)
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	Kit.Part(f, V(2.4, 2, 2.4), base * CFrame.new(0, 1, 0), color, { Solid = true })
	Kit.Part(f, V(2.4, 2.6, 0.5), base * CFrame.new(0, 3.3, 0.95), color)
end

local function plant(f: Instance, x: number, z: number)
	Kit.Cyl(f, 2.4, 2.4, CFrame.new(x, FLOOR_Y + 1.2, z), WHITE)
	Kit.Ball(f, 3.6, V(x, 4, z), C(110, 180, 120), { Mat = Enum.Material.Grass })
	Kit.AddCircle(x, z, 2)
end

local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), C(190, 140, 100), { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), C(190, 140, 100), { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(LBLUE))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function floater(f: Instance, size: Vector3, pos: Vector3, color: Color3, name: string, shape: Enum.PartType?)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local p = Kit.Part(f, size, cf, color, { Name = name, Shape = shape })
	Kit.Float(p, rng:NextNumber(0.6, 1.1))
end

--==================================================================
-- GROUND, SIDE WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(125, 190, 135), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Hospital" })
	-- paved path to the front door and from the back door to the Harbor gate (flat)
	local pave = C(210, 215, 225)
	Kit.Box(f, V(-10, 0, MIN_Z), V(10, 0.05, 1269), pave, { Mat = CONCRETE, Name = "Path" })
	Kit.Box(f, V(-10, 0, 1535), V(10, 0.05, MAX_Z), pave, { Mat = CONCRETE, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, MIN_Z), V(s * 10.8, 0.06, 1269), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 10, 0, 1535), V(s * 10.8, 0.06, MAX_Z), Kit.Vivid(LBLUE))
	end
end

local function sideWalls(f: Instance)
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, z0), V(s * 146, 12, z1), WHITE, { Mat = CONCRETE, Solid = true })
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13.2, z1), Kit.Vivid(LBLUE), { Mat = Enum.Material.Slate })
		Kit.Box(f, V(s * 139.8, 3, z0), V(s * 140, 4.2, z1), Kit.Vivid(MGREEN))
		for i = 1, 7 do
			local z = z0 + i * (z1 - z0) / 8
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), C(215, 225, 235), SOLID)
			Kit.Ball(f, 3.4, V(s * 143, 16.6, z), Kit.Vivid(C(140, 220, 180)))
		end
	end
end

local function outside(f: Instance)
	local hill = { C(110, 160, 140), C(140, 120, 200), C(120, 175, 150) }
	for i, z in { 1265, 1400, 1525 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 190, -14, z - s * 15), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- annex blocks beyond the walls
	for _, a in { V(-1, 0, 1330), V(1, 0, 1440) } do
		local s, z = a.X, a.Z
		Kit.Box(f, V(s * 156, 0, z - 22), V(s * 186, 30, z + 22), C(232, 236, 240), { Mat = CONCRETE })
		Kit.Box(f, V(s * 155.7, 18, z - 20), V(s * 155.9, 23, z + 20), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 155.5, 30, z - 22.5), V(s * 186.5, 31.5, z + 22.5), Kit.Vivid(MGREEN))
	end
	for _, z in { 1240, 1545 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 20 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

--==================================================================
-- COURTYARD
--==================================================================
local function ambulance(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Ambulance")
	local base = faced(V(x, 0, z), -1, 0) -- front toward the path (-X)
	local cargo = Kit.Part(m, V(8, 7.5, 11), base * CFrame.new(0, 5.25, 2.5), WHITE, SOLID)
	cargo.Name = "Cargo"
	Kit.Part(m, V(7.6, 5.5, 5), base * CFrame.new(0, 4.25, -5.5), WHITE, SOLID)
	local glass = Kit.Vivid(C(170, 225, 255))
	Kit.Part(m, V(6.6, 2.4, 0.3), base * CFrame.new(0, 5.6, -8.05), glass, { Refl = 0.2 })
	Kit.Part(m, V(7.7, 2.2, 3), base * CFrame.new(0, 5.6, -5.4), glass, { Refl = 0.2 })
	Kit.Part(m, V(8.1, 1.2, 11.1), base * CFrame.new(0, 4.5, 2.5), REDX)
	Kit.Part(m, V(7.7, 0.8, 5.1), base * CFrame.new(0, 3.2, -5.5), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.2, 3, 1), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		Kit.Part(m, V(0.2, 1, 3), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		for _, sz in { -5, 5.5 } do
			Kit.Part(m, V(1.2, 3.4, 3.4), base * CFrame.new(sx * 3.8, 1.7, sz), DARK, { Shape = Enum.PartType.Cylinder })
		end
		Kit.Part(m, V(0.9, 0.8, 0.2), base * CFrame.new(sx * 2.7, 3, -8.05), C(255, 240, 170))
		Kit.Part(m, V(2.2, 0.9, 1.2), base * CFrame.new(sx * 1.2, 9.45, -1.5), if sx < 0 then REDX else C(90, 160, 255), { Mat = NEON })
	end
	Kit.Part(m, V(7.8, 0.8, 0.6), base * CFrame.new(0, 1.8, -8.3), GREY)
	local tag = Kit.Part(m, V(6, 1, 0.2), base * CFrame.new(0, 7.6, -8.1), WHITE)
	Kit.Sign(tag, Enum.NormalId.Front, "AMBULANCE 👻", REDX, { Stroke = WHITE })
	Kit.AddCircle(x, z, 11)
end

local function courtyard(f: Instance)
	ambulance(f, 72, 1250)
	for _, z in { 1242, 1258 } do
		Kit.Box(f, V(60, 0, z - 0.3), V(86, 0.05, z + 0.3), WHITE)
	end
	-- welcome sign
	Kit.Box(f, V(-74, 0, 1256.5), V(-50, 3, 1259.5), WHITE, { Mat = CONCRETE, Solid = true })
	Props.SignBoard(f, V(-62, 6.4, 1258), 22, 6, 0, -1, "HAUNTED HOSPITAL\nvisiting hours: forever", C(60, 110, 170), WHITE, MGREEN)
	Kit.AddRect(-75, 1255, -49, 1261)
	-- planters
	for _, x in { -96, -44, 44, 96 } do
		if Kit.IsFree(x, 1263, 3) then
			Kit.Box(f, V(x - 2.5, 0, 1260.5), V(x + 2.5, 2, 1265.5), WHITE, { Mat = CONCRETE, Solid = true })
			Kit.Ball(f, 5, V(x, 3, 1263), C(110, 180, 120), { Mat = Enum.Material.Grass })
			Kit.AddCircle(x, 1263, 3)
		end
	end
	Props.StreetLamp(f, V(-104, 0, 1245), C(190, 235, 255), true)
	Props.StreetLamp(f, V(108, 0, 1240), C(190, 235, 255), false)
	Kit.AddCircle(-104, 1245, 1.5)
	Kit.AddCircle(108, 1240, 1.5)
	bench(f, -88, 1232, 0, 1)
	bench(f, 100, 1228, 0, 1)
end

local function entrance(f: Instance)
	-- canopy over the front door
	Kit.Box(f, V(-16.5, 12, 1254), V(16.5, 13.2, 1268.9), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-16.7, 12.2, 1253.8), V(16.7, 13, 1254.1), WHITE)
	for _, s in { -1, 1 } do
		Kit.Cyl(f, 12, 1.4, CFrame.new(s * 14.5, 6, 1258), WHITE, SOLID)
	end
	local lamp = Kit.Box(f, V(-3, 11.6, 1258), V(3, 12, 1262), C(225, 255, 240), { Mat = NEON })
	Kit.Light(lamp, C(210, 255, 235), 24, 1.3)
	Kit.AddRect(-17, 1253, 17, 1269)
	-- facade block over the door (bottom Y 16) with the big sign and the cross emblem
	Kit.Box(f, V(-20, 16, 1266.5), V(20, 30, 1271.5), WHITE, SOLID)
	Kit.Box(f, V(-20.3, 16, 1266.2), V(20.3, 17, 1266.5), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-20.5, 29.5, 1266), V(20.5, 31, 1272), Kit.Vivid(LBLUE))
	local sign = Kit.Part(f, V(30, 6.5, 0.4), CFrame.new(0, 23.4, 1266.2), C(60, 110, 170))
	Kit.Sign(sign, Enum.NormalId.Front, "HOSPITAL", WHITE, { Stroke = C(20, 40, 90) })
	Kit.CylFlat(f, 1, 13, V(0, 37.5, 1269.4), "Z", Kit.Vivid(LBLUE))
	Kit.CylFlat(f, 1, 11.4, V(0, 37.5, 1268.8), "Z", WHITE)
	Kit.Box(f, V(-1.3, 33.5, 1268), V(1.3, 41.5, 1268.4), REDX)
	Kit.Box(f, V(-4, 36.2, 1268), V(4, 38.8, 1268.4), REDX)
end

--==================================================================
-- BUILDING SHELL
--==================================================================
local function shell(f: Instance)
	Kit.Box(f, V(-113, -0.5, 1269), V(113, 0.1, 1535), C(215, 222, 230), { Solid = true, Name = "HospitalFloor" })
	-- room floors (flat paint, top Y 0.13)
	local function floor(x1: number, z1: number, x2: number, z2: number, color: Color3, mat: Enum.Material?)
		Kit.Box(f, V(x1, 0.1, z1), V(x2, FLOOR_Y, z2), color, { Mat = mat })
	end
	local tiles = { C(236, 241, 246), C(190, 222, 238) }
	for i = 0, 3 do
		for j = 0, 2 do
			local x0, z0 = -51 + i * 25, 1271 + j * (80 / 3)
			floor(x0, z0, x0 + 25, z0 + 80 / 3, tiles[((i + j) % 2) + 1])
		end
	end
	floor(-111, 1271, -53, 1397, C(205, 232, 214))
	floor(51, 1271, 111, 1351, C(228, 218, 242))
	floor(41, 1353, 111, 1443, C(205, 220, 242))
	floor(-51, 1353, 39, 1397, C(230, 236, 242))
	floor(-31, 1397, 39, 1443, C(230, 236, 242))
	floor(-111, 1399, -33, 1533, C(212, 236, 226))
	floor(-31, 1445, 31, 1533, C(185, 160, 215), FABRIC)
	floor(33, 1445, 111, 1533, C(242, 232, 214))
	-- light-blue runner along the main path + "follow the line" guides (flat)
	Kit.Box(f, V(-9, FLOOR_Y, 1271), V(9, 0.16, 1533), C(200, 228, 245), { Name = "Runner" })
	Kit.Box(f, V(-4.4, 0.16, 1271), V(-3.6, 0.19, 1533), Kit.Vivid(MGREEN))
	Kit.Box(f, V(3.6, 0.16, 1271), V(4.4, 0.19, 1533), Kit.Vivid(LBLUE))

	-- exterior walls (doors: front + back on the path, one side door each way)
	wallX(f, 1270, -113, 113, { { c = 0, w = 28 } })
	wallX(f, 1534, -113, 113, { { c = 0, w = 28 } })
	wallZ(f, -112, 1271, 1533, { { c = 1470, w = 16 } })
	wallZ(f, 112, 1271, 1533, { { c = 1460, w = 16 } })
	-- interior walls (all outside the ghost circles)
	wallZ(f, -52, 1271, 1398, { { c = 1310, w = 20 } }) -- lobby | ward
	wallZ(f, 50, 1271, 1351, { { c = 1315, w = 20 } }) -- lobby | patient rooms
	wallX(f, 1352, 39, 111, { { c = 80, w = 18 } }) -- patient rooms | x-ray
	wallX(f, 1352, -51, 39, { { c = -6, w = 60 } }) -- lobby | atrium (stubs)
	wallX(f, 1398, -111, -31, { { c = -80, w = 20 } }) -- ward | lab
	wallZ(f, 40, 1353, 1443, { { c = 1398, w = 24 } }) -- atrium | x-ray
	wallX(f, 1444, 31, 111, { { c = 75, w = 20 } }) -- x-ray | pharmacy
	wallZ(f, -32, 1399, 1533, { { c = 1422, w = 18 }, { c = 1505, w = 18 } }) -- lab | atrium, office
	wallZ(f, 32, 1445, 1533, { { c = 1490, w = 20 } }) -- office | pharmacy
	wallX(f, 1444, -31, 31, { { c = 0, w = 40 } }) -- atrium | office (stubs)

	-- parapet on the exterior walls (no roof over the rooms)
	local rim = Kit.Vivid(LBLUE)
	Kit.Box(f, V(-114, H, 1268), V(114, H + 1.6, 1272), rim, SOLID)
	Kit.Box(f, V(-114, H, 1532), V(114, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(-114, H, 1268), V(-110, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(110, H, 1268), V(114, H + 1.6, 1536), rim, SOLID)
	-- corner columns
	for _, x in { -113, 113 } do
		for _, z in { 1270, 1534 } do
			Kit.Cyl(f, 20, 6, CFrame.new(x, 10, z), WHITE, SOLID)
			Kit.Cyl(f, 1.4, 7, CFrame.new(x, 20.7, z), Kit.Vivid(MGREEN))
		end
	end

	-- windows: light-blue glass, a few ghostly ones glow
	local function window(lo: Vector3, hi: Vector3, glow: boolean)
		Kit.Box(f, lo, hi, if glow then SPECT else Kit.Vivid(C(175, 220, 245)), if glow then { Mat = NEON, Transp = 0.1 } else { Refl = 0.15 })
	end
	for _, x in { -100, -80, -55, -32, 32, 55, 80, 100 } do
		Kit.Box(f, V(x - 3.5, 5.5, 1268.7), V(x + 3.5, 12.5, 1268.95), WHITE)
		window(V(x - 2.8, 6, 1268.55), V(x + 2.8, 12, 1268.8), x == -55 or x == 80)
	end
	for _, s in { -1, 1 } do
		for _, z in { 1300, 1340, 1380, 1420, 1495 } do
			if not (s < 0 and z == 1495) then
				Kit.Box(f, V(s * 113, 5.5, z - 3.5), V(s * 113.25, 12.5, z + 3.5), WHITE)
				window(V(s * 113.15, 6, z - 2.8), V(s * 113.4, 12, z + 2.8), (s < 0 and z == 1340) or (s > 0 and z == 1420))
			end
		end
	end
	Kit.Box(f, V(-113.2, 14, 1268.7), V(113.2, 14.6, 1268.9), Kit.Vivid(MGREEN))
	Kit.AddRect(-116, 1266, 116, 1538)
end

--==================================================================
-- TOWER (landmark, back-west corner of the lab)
--==================================================================
local function tower(f: Instance)
	local m = Kit.Model(f, "HospitalTower")
	local x1, x2, z1, z2 = -111, -85, 1507, 1533
	Kit.Box(m, V(x1, 0, z1), V(x2, 64, z2), WHITE, { Solid = true, Shadow = true, Name = "Tower" })
	for _, y in { 16, 32, 48 } do
		Kit.Box(m, V(x1 - 0.3, y, z1 - 0.3), V(x2 + 0.3, y + 1, z2 + 0.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x1 - 0.5, 63.5, z1 - 0.5), V(x2 + 0.5, 65, z2 + 0.5), Kit.Vivid(PURPLE))
	Kit.Box(m, V(x1 + 3, 65, z1 + 3), V(x2 - 3, 72, z2 - 3), C(228, 236, 245), SOLID)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	Kit.Disc(m, cx, cz, 72.4, 16, 0.4, Kit.Vivid(MGREEN))
	local pad = Kit.Box(m, V(cx - 4, 72.4, cz - 4), V(cx + 4, 72.5, cz + 4), WHITE, { Transp = 1 })
	Kit.Sign(pad, Enum.NormalId.Top, "H", WHITE, { Stroke = C(60, 110, 170) })
	Kit.Cyl(m, 10, 0.6, CFrame.new(x2 - 5, 77, z2 - 5), GREY, { Mat = METAL })
	local beacon = Kit.Ball(m, 1.8, V(x2 - 5, 82.5, z2 - 5), C(255, 100, 120), { Mat = NEON })
	Kit.Light(beacon, C(255, 130, 140), 30, 1.2)
	-- windows on the -Z face (toward the Carnival) and the +X face (toward the lab)
	local glass = Kit.Vivid(C(175, 220, 245))
	for row = 0, 1 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local x = x1 + 5 + col * 8
			local glow = (row + col) % 3 == 1
			Kit.Box(m, V(x - 2.5, y - 3, z1 - 0.3), V(x + 2.5, y + 3, z1), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	for row = 0, 2 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local z = z1 + 5 + col * 8
			local glow = (row + col) % 4 == 2
			Kit.Box(m, V(x2, y - 3, z - 2.5), V(x2 + 0.3, y + 3, z + 2.5), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	-- red cross emblem near the top of the front face
	Kit.Box(m, V(-104, 51.5, z1 - 0.5), V(-92, 62.5, z1 - 0.1), Kit.Vivid(LBLUE))
	Kit.Box(m, V(-99.3, 53, z1 - 0.8), V(-96.7, 61, z1 - 0.4), REDX)
	Kit.Box(m, V(-102, 55.7, z1 - 0.8), V(-94, 58.3, z1 - 0.4), REDX)
	Kit.AddRect(x1 - 1, z1 - 1, x2 + 1, z2 + 1)
end

--==================================================================
-- ROOMS
