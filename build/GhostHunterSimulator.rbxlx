local function patientRooms(f: Instance)
	for _, z in { 1283, 1311, 1340 } do
		bed(f, 106, z, 1, 0)
		monitor(f, 108.5, z - 5.2, -1)
		chair(f, 96, z - 4, -1, 0, Kit.Vivid(PURPLE))
	end
	local curtain = C(225, 212, 242)
	for _, z in { 1297, 1326 } do
		Kit.Box(f, V(86, FLOOR_Y, z - 0.2), V(111, 8, z + 0.2), curtain, { Mat = FABRIC })
		Kit.AddRect(86, z - 1, 111, z + 1)
	end
	Props.SignBoard(f, V(51.4, 11, 1290), 14, 3, 1, 0, "PATIENT ROOMS", C(60, 110, 170), WHITE)
	Props.SignBoard(f, V(65, 11, 1350.6), 18, 3, 0, -1, "VISITING HOURS:\nMIDNIGHT ONLY", C(120, 80, 190), WHITE)
	medCart(f, 70, 1276)
end

local function xray(f: Instance)
	-- x-ray machine in the north-east corner
	Kit.Box(f, V(100, FLOOR_Y, 1355), V(110, 1.5, 1365), GREY, { Solid = true })
	Kit.Box(f, V(99.5, 1.5, 1356), V(105.5, 3.4, 1364), WHITE, { Solid = true })
	Kit.Box(f, V(108, 1.5, 1358), V(110, 13, 1362), WHITE, { Solid = true })
	Kit.Box(f, V(100, 10, 1359), V(108, 11.5, 1361), WHITE)
	Kit.Box(f, V(98, 7.6, 1357.5), V(102, 10, 1362.5), Kit.Vivid(LBLUE))
	Kit.AddRect(98, 1354, 111, 1366)
	-- lightbox on the north wall
	local panel = Kit.Part(f, V(16, 8, 0.4), faced(V(96, 9, 1442.6), 0, -1), C(225, 245, 255))
	Kit.Sign(panel, Enum.NormalId.Front, "X-RAY RESULTS:\n100% GHOST 👻", C(40, 80, 140), { Stroke = WHITE })
	Kit.Light(panel, C(200, 240, 255), 20, 1)
	Props.SignBoard(f, V(39.4, 11, 1418), 10, 3, -1, 0, "X-RAY", C(60, 110, 170), WHITE)
	puddle(f, 68, 1402, 6)
	floater(f, V(1.6, 2.2, 0.2), V(60, 9, 1362), C(205, 170, 120), "FloatingClipboard")
end

local function elevator(f: Instance, z: number)
	Kit.Box(f, V(-51, FLOOR_Y, z - 5), V(-50.2, 12, z + 5), C(180, 190, 205), { Mat = METAL, Solid = true })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(-50.2, FLOOR_Y, z + s * 0.1), V(-49.9, 10, z + s * 4), C(220, 225, 235), { Mat = METAL })
	end
	local disp = Kit.Box(f, V(-50.2, 10.4, z - 2), V(-49.9, 11.6, z + 2), DARK)
	Kit.Sign(disp, Enum.NormalId.Right, "▲ 13 ▼", C(255, 200, 90))
	Kit.AddRect(-52, z - 5, -48, z + 5)
end

local function atrium(f: Instance)
	elevator(f, 1362)
	elevator(f, 1386)
	Props.SignBoard(f, V(-50.4, 14, 1374), 18, 2.4, 1, 0, "ELEVATORS (GHOSTS ONLY)", C(60, 110, 170), WHITE)
	medCart(f, -20, 1380)
	medCart(f, 28, 1432)
	wheelchair(f, 20, 1368, -1, 0)
	wheelchair(f, -22, 1432, 0, 1)
	bench(f, 35, 1366, -1, 0)
	plant(f, 35, 1356)
	plant(f, -27, 1440)
	Props.SignBoard(f, V(39.4, 11, 1434), 14, 3.2, -1, 0, "QUIET PLEASE...\nBOO!", C(120, 80, 190), WHITE)
	sconce(f, V(38.4, 12, 1374), -1, C(255, 230, 170))
	-- overhead sign at the director's wing (Y 11..16, over the path, before the boss room)
	Kit.Box(f, V(-20, 14, 1443.5), V(20, 16, 1444.5), WHITE)
	local s = Kit.Part(f, V(24, 2.8, 0.4), CFrame.new(0, 12.4, 1443.3), C(60, 110, 170))
	Kit.Sign(s, Enum.NormalId.Front, "⬆ DIRECTOR'S OFFICE ⬆", WHITE)
	Props.Wisp(f, V(-10, 0, 1414), SPECT, 9, true)
	floater(f, V(1.6, 0.8, 0.8), V(4, 10, 1400), Kit.Vivid(C(255, 150, 200)), "FloatingPill", Enum.PartType.Cylinder)
end

local function lab(f: Instance)
	-- ecto tanks along the west wall
	for i, z in { 1415, 1455, 1492 } do
		Kit.Cyl(f, 1.5, 6, CFrame.new(-105, FLOOR_Y + 0.75, z), GREY, { Mat = METAL, Solid = true })
		Kit.Cyl(f, 8, 5, CFrame.new(-105, 5.9, z), C(200, 245, 225), { Transp = 0.55, Refl = 0.1 })
		local liquid = Kit.Cyl(f, 6, 4, CFrame.new(-105, 5, z), SPECT, { Mat = NEON, Transp = 0.3 })
		Kit.Cyl(f, 1, 5.6, CFrame.new(-105, 10.4, z), GREY, { Mat = METAL })
		if i == 2 then
			Kit.Light(liquid, SPECT, 24, 1.2)
			Kit.Emitter(liquid, SPECT, 2, 2, 0.6)
		end
		Kit.AddCircle(-105, z, 4)
	end
	-- lab bench with bubbling beakers
	Kit.Box(f, V(-66, 3.4, 1400), V(-40, 4, 1405.5), WHITE)
	Kit.Box(f, V(-65, FLOOR_Y, 1400.5), V(-41, 3.4, 1405), Kit.Vivid(MGREEN), { Solid = true })
	for i, col in { C(255, 150, 200), C(200, 140, 255), C(140, 230, 255) } do
		Kit.Cyl(f, 1.6, 1, CFrame.new(-60 + i * 5, 4.8, 1402.5), Kit.Vivid(col), { Transp = 0.2 })
	end
	Kit.AddRect(-67, 1399, -39, 1407)
	-- spirit coil "ghost-o-meter"
	local x, z = -60, 1515
	Kit.Cyl(f, 1, 6, CFrame.new(x, FLOOR_Y + 0.5, z), GREY, { Mat = METAL, Solid = true })
	Kit.Cyl(f, 10, 1.6, CFrame.new(x, 6, z), GREY, { Mat = METAL, Solid = true })
	for i, d in { 5, 4, 3 } do
		Kit.Cyl(f, 0.5, d, CFrame.new(x, 3 + i * 2.5, z), Kit.Vivid(PURPLE))
	end
	Kit.Ball(f, 2.2, V(x, 12, z), C(200, 150, 255), { Mat = NEON })
	Props.SignBoard(f, V(x, 3, z - 4), 7, 1.6, 0, -1, "GHOST-O-METER", DARK, SPECT)
	Kit.AddCircle(x, z, 5)
	Props.SignBoard(f, V(-100, 11, 1399.4), 14, 3, 0, 1, "PARANORMAL LAB", C(120, 80, 190), WHITE)
	puddle(f, -70, 1462, 6)
	floater(f, V(1, 1.8, 1), V(-45, 9, 1420), Kit.Vivid(C(200, 140, 255)), "FloatingBeaker", Enum.PartType.Cylinder)
end

local function office(f: Instance)
	-- director's desk (front-east corner, outside the boss circle)
	Kit.Box(f, V(16.5, FLOOR_Y, 1454.5), V(27.5, 3.6, 1461.5), C(140, 95, 65), { Mat = WOOD, Solid = true })
	Kit.Box(f, V(16, 3.6, 1454), V(28, 4.2, 1462), C(165, 115, 80), { Mat = WOOD })
	local plate = Kit.Part(f, V(4.5, 1, 0.4), faced(V(22, 4.7, 1454.5), 0, -1), DARK)
	Kit.Sign(plate, Enum.NormalId.Front, "DIRECTOR 👻", C(255, 215, 120))
	chair(f, 22, 1465, 0, -1, Kit.Vivid(PURPLE))
	Kit.AddRect(15, 1453, 29, 1467)
	-- boss ring painted on the carpet (flat)
	Kit.Disc(f, 0, 1505, 0.18, 46, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 0, 1505, 0.2, 42, 0.04, C(215, 195, 235))
	puddle(f, -6, 1500, 6)
	Props.SignBoard(f, V(-22, 10, 1532.6), 11, 6, 0, -1, "EMPLOYEE\nOF THE\nCENTURY 👻", C(120, 80, 190), C(255, 225, 130), C(255, 200, 80))
	plant(f, -27, 1449)
	plant(f, 27, 1530)
end

local function pharmacy(f: Instance)
	Kit.Box(f, V(50, FLOOR_Y, 1468), V(82, 4, 1471), WHITE, { Solid = true })
	Kit.Box(f, V(49.5, 4, 1467.5), V(82.5, 4.5, 1471.5), Kit.Vivid(MGREEN))
	Kit.AddRect(49, 1467, 83, 1472)
	local rows = { C(255, 150, 190), C(140, 220, 255), C(255, 210, 110) }
	for _, x in { 50, 70, 90 } do
		Kit.Box(f, V(x - 6, FLOOR_Y, 1529), V(x + 6, 10, 1533), WHITE, { Solid = true })
		for i, col in rows do
			local y = 1.2 + (i - 1) * 2.9
			Kit.Box(f, V(x - 5.6, y, 1528.7), V(x + 5.6, y + 1.8, 1529), Kit.Vivid(col))
		end
		Kit.AddRect(x - 7, 1527, x + 7, 1533)
	end
	Props.SignBoard(f, V(70, 13, 1532.6), 20, 3, 0, -1, "PHARMACY", C(60, 110, 170), WHITE)
	-- get-well balloons by the counter
	local top = V(80, 4.5, 1469.5)
	for i, col in { C(255, 140, 190), C(150, 205, 240), C(170, 120, 230) } do
		local p = top + V((i - 2) * 1.6, 7 + (i % 2) * 1.2, 0)
		Props.Beam(f, top, p - V(0, 1.3, 0), 0.1, 0.1, WHITE)
		Kit.Ball(f, 2.6, p, Kit.Vivid(col))
	end
	wheelchair(f, 100, 1480, -1, 0)
	Props.SignBoard(f, V(60, 11, 1445.4), 14, 3, 0, 1, "GET WELL BOO-N!", C(255, 140, 190), WHITE)
end

local function grounds(f: Instance)
	-- back yard
	bench(f, -42, 1546, 0, -1)
	bench(f, 42, 1546, 0, -1)
	-- trees in the garden strips and corners
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 10 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(60, 131)
		local z = rng:NextNumber(1226, 1555)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

function Hospital.Build(map: Instance)
	local f = Kit.Folder(map, "Hospital")
	ground(f)
	sideWalls(f)
	outside(f)
	courtyard(f)
	entrance(f)
	shell(f)
	tower(f)
	lobby(f)
	ward(f)
	patientRooms(f)
	xray(f)
	atrium(f)
	lab(f)
	office(f)
	pharmacy(f)
	grounds(f)
end

return Hospital
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Part helpers for the procedural map. Every builder goes through these so that parts
-- get the same performance defaults (anchored, non-colliding, no touch/query, no shadow)
-- unless `Solid = true` is passed for floors, walls and buildings.
-- Also holds the seeded RNG, budgets (lights, emitters, tagged props) and a keep-out
-- registry so scattered props never land inside ghost areas, roads or stations.
--
-- Neon is an accent, not a surface: keep it for small things whose glow means something
-- (windows, lamp globes, lanterns, jack-o'-lantern faces at landmarks, eyes, small ectoplasm
-- cracks/puddles). Trims, bands, rings, frames and pads use a solid material with a
-- Kit.Vivid colour instead. Kit.Stats.Neon counts the Neon parts so the build log shows it.

local CollectionService = game:GetService("CollectionService")

local Kit = {}

export type Opts = {
	Name: string?,
	Mat: Enum.Material?,
	Transp: number?,
	Solid: boolean?, -- CanCollide + CanQuery (+ shadow)
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Refl: number?,
}

Kit.Rng = Random.new(42)

Kit.Stats = { Parts = 0, Neon = 0, Lights = 0, Emitters = 0, Floating = 0, Flicker = 0 }
-- Budgets for the whole 8-zone map (zones 1-3 use about half of each).
local MAX_LIGHTS = 96
local MAX_EMITTERS = 34
local MAX_FLOATING = 80
local MAX_FLICKER = 20

local NO_OPTS: Opts = {}

local function apply(p: BasePart, size: Vector3, cf: CFrame, color: Color3, opts: Opts?)
	local o: Opts = opts or NO_OPTS
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.Mat or Enum.Material.SmoothPlastic
	p.Transparency = o.Transp or 0
	p.Reflectance = o.Refl or 0
	local solid = o.Solid == true
	p.CanCollide = solid
	p.CanQuery = solid
	p.CanTouch = false
	if o.Shadow ~= nil then
		p.CastShadow = o.Shadow
	else
		p.CastShadow = solid
	end
	if o.Name then
		p.Name = o.Name
	end
	Kit.Stats.Parts += 1
	if p.Material == Enum.Material.Neon then
		Kit.Stats.Neon += 1
	end
end

-- A slightly more saturated, brighter version of a colour. Solid materials are lit by the
-- scene instead of glowing, so former neon trims get this to stay candy-bright.
-- Near-greys/whites keep their saturation (no accidental tint).
function Kit.Vivid(c: Color3): Color3
	local h, s, v = c:ToHSV()
	local s2 = if s < 0.1 then s else math.min(1, s * 1.15 + 0.05)
	return Color3.fromHSV(h, s2, math.min(1, v * 1.06 + 0.03))
end

-- Block (or Ball/Cylinder via opts.Shape) at an arbitrary CFrame.
function Kit.Part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	apply(p, size, cf, color, opts)
	p.Parent = parent
	return p
end

-- Axis-aligned block from two corners.
function Kit.Box(parent: Instance, a: Vector3, b: Vector3, color: Color3, opts: Opts?): Part
	local lo = a:Min(b)
	local hi = a:Max(b)
	return Kit.Part(parent, hi - lo, CFrame.new((lo + hi) / 2), color, opts)
end

-- WedgePart: the slope faces local -Z (low edge at -Z, tall face at +Z).
function Kit.Wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): WedgePart
	local w: WedgePart = Instance.new("WedgePart")
	apply(w, size, cf, color, opts)
	w.Parent = parent
	return w
end

function Kit.Ball(parent: Instance, d: number, pos: Vector3, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	apply(p, Vector3.new(d, d, d), CFrame.new(pos), color, opts)
	p.Parent = parent
	return p
end

-- Vertical cylinder centred at cf.
function Kit.Cyl(parent: Instance, height: number, d: number, cf: CFrame, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	apply(p, Vector3.new(height, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, opts)
	p.Parent = parent
	return p
end

-- Flat vertical cylinder whose TOP surface is at topY.
function Kit.Disc(parent: Instance, x: number, z: number, topY: number, d: number, thick: number, color: Color3, opts: Opts?): Part
	return Kit.Cyl(parent, thick, d, CFrame.new(x, topY - thick / 2, z), color, opts)
end

-- Cylinder lying along the world axis given by `along` ("X" or "Z").
function Kit.CylFlat(parent: Instance, length: number, d: number, pos: Vector3, along: string, color: Color3, opts: Opts?): Part
	local p: Part = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	local cf = CFrame.new(pos)
	if along == "Z" then
		cf *= CFrame.Angles(0, math.pi / 2, 0)
	end
	apply(p, Vector3.new(length, d, d), cf, color, opts)
	p.Parent = parent
	return p
end

function Kit.Folder(parent: Instance, name: string): Folder
	local f: Folder = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.Model(parent: Instance, name: string): Model
	local m: Model = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Yaw (radians) that turns a part's local -Z (its Front face) toward world (dx, dz).
function Kit.FaceYaw(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

function Kit.Comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	while true do
		local replaced, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if k == 0 then
			break
		end
	end
	return out
end

--==================================================================
-- GUI
--==================================================================
function Kit.Gui(part: BasePart, face: Enum.NormalId, pps: number?): SurfaceGui
	local g: SurfaceGui = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps or 40
	g.LightInfluence = 0
	g.Brightness = 1.5
	g.ZOffset = 1
	g.ResetOnSpawn = false
	g.Parent = part
	return g
end

export type LabelOpts = {
	Name: string?,
	Pos: UDim2?,
	Size: UDim2?,
	Font: Enum.Font?,
	Stroke: Color3?,
	Rotation: number?,
}

local NO_LABEL: LabelOpts = {}

function Kit.Label(gui: GuiBase2d, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local o: LabelOpts = opts or NO_LABEL
	local t: TextLabel = Instance.new("TextLabel")
	t.Name = o.Name or "Label"
	t.BackgroundTransparency = 1
	t.Position = o.Pos or UDim2.fromScale(0, 0)
	t.Size = o.Size or UDim2.fromScale(1, 1)
	t.Font = o.Font or Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Rotation = o.Rotation or 0
	local stroke: UIStroke = Instance.new("UIStroke")
	stroke.Color = o.Stroke or Color3.fromRGB(40, 20, 70)
	stroke.Thickness = 3
	stroke.Parent = t
	t.Parent = gui
	return t
end

-- Whole-face sign on a part.
function Kit.Sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, opts: LabelOpts?): TextLabel
	local g = Kit.Gui(part, face)
	return Kit.Label(g, text, color, opts)
end

--==================================================================
-- EFFECTS (budgeted)
--==================================================================
function Kit.Light(part: BasePart, color: Color3, range: number, brightness: number, flicker: boolean?): PointLight?
	if Kit.Stats.Lights >= MAX_LIGHTS then
		return nil
	end
	Kit.Stats.Lights += 1
	local l: PointLight = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
	if flicker and Kit.Stats.Flicker < MAX_FLICKER then
		Kit.Stats.Flicker += 1
		CollectionService:AddTag(part, "FlickerLight")
	end
	return l
end

function Kit.Emitter(part: BasePart, color: Color3, rate: number, size: number?, speed: number?): ParticleEmitter?
	if Kit.Stats.Emitters >= MAX_EMITTERS then
		return nil
	end
	Kit.Stats.Emitters += 1
	local e: ParticleEmitter = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(4, 7)
	e.Speed = NumberRange.new(speed or 0.6, (speed or 0.6) * 2)
	e.SpreadAngle = Vector2.new(180, 15)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-15, 15)
	local s = size or 6
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s * 0.5),
		NumberSequenceKeypoint.new(0.5, s),
		NumberSequenceKeypoint.new(1, s * 1.2),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.75),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Acceleration = Vector3.new(0, 0.15, 0)
	e.Parent = part
	return e
end

-- Tag a single anchored part as a client-animated floating prop.
function Kit.Float(part: BasePart, bob: number): boolean
	if Kit.Stats.Floating >= MAX_FLOATING then
		return false
	end
	Kit.Stats.Floating += 1
	part:SetAttribute("BobHeight", bob)
	CollectionService:AddTag(part, "FloatingProp")
	return true
end

--==================================================================
-- KEEP-OUT REGISTRY (2D, X/Z)
--==================================================================
type Circle = { X: number, Z: number, R: number }
type Rect = { X1: number, Z1: number, X2: number, Z2: number, Road: boolean }

local circles: { Circle } = {}
local rects: { Rect } = {}

function Kit.ResetKeepOut()
	table.clear(circles)
	table.clear(rects)
end

-- Fresh RNG, budgets and keep-out map (so rebuilding gives the identical map).
function Kit.Reset()
	Kit.Rng = Random.new(42)
	Kit.Stats.Parts = 0
	Kit.Stats.Neon = 0
	Kit.Stats.Lights = 0
	Kit.Stats.Emitters = 0
	Kit.Stats.Floating = 0
	Kit.Stats.Flicker = 0
	Kit.ResetKeepOut()
end

function Kit.AddCircle(x: number, z: number, r: number)
	table.insert(circles, { X = x, Z = z, R = r })
end

function Kit.AddRect(x1: number, z1: number, x2: number, z2: number, road: boolean?)
	table.insert(rects, {
		X1 = math.min(x1, x2),
		Z1 = math.min(z1, z2),
		X2 = math.max(x1, x2),
		Z2 = math.max(z1, z2),
		Road = road == true,
	})
end

-- True when a circle of radius r at (x, z) touches no keep-out and stays inside the play area.
function Kit.IsFree(x: number, z: number, r: number, ignoreRoads: boolean?): boolean
	if math.abs(x) + r > 136 then
		return false
	end
	for _, c in circles do
		local dx, dz = x - c.X, z - c.Z
		if dx * dx + dz * dz < (c.R + r) * (c.R + r) then
			return false
		end
	end
	for _, q in rects do
		if not (ignoreRoads and q.Road) then
			if x + r > q.X1 and x - r < q.X2 and z + r > q.Z1 and z - r < q.Z2 then
				return false
			end
		end
	end
	return true
end

export type GateLayout = { Z: number, Width: number }

-- Typed views of Config.Layout tables (iterating a table literal yields unknown in strict mode).
function Kit.Gates(layout: any): { [string]: GateLayout }
	return layout.Gates
end

function Kit.CrateStations(layout: any): { [string]: Vector3 }
	return layout.CrateStations
end

function Kit.ZoneSpawns(layout: any): { [string]: Vector3 }
	return layout.ZoneSpawns
end

function Kit.Pick<T>(list: { T }): T
	return list[Kit.Rng:NextInteger(1, #list)]
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
-- Night-but-bright lighting: purple haze, big moon, punchy colours. Bloom is soft and only
-- catches the brightest pixels, so the few neon accents (windows, lamps, jack-o'-lantern
-- faces) glow without blowing out; the solid candy colours carry the scene.

local LightingService = game:GetService("Lighting")

local LightingSetup = {}

local function clear(name: string)
	local old = LightingService:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

function LightingSetup.Apply()
	local L = LightingService
	L.ClockTime = 0.5
	L.GeographicLatitude = 20
	L.Brightness = 2.5
	L.Ambient = Color3.fromRGB(150, 120, 200)
	L.OutdoorAmbient = Color3.fromRGB(160, 140, 210)
	L.ColorShift_Top = Color3.fromRGB(170, 140, 255)
	L.ColorShift_Bottom = Color3.fromRGB(60, 30, 90)
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.4
	L.GlobalShadows = true
	L.ShadowSoftness = 0.4
	L.ExposureCompensation = 0.25 -- a touch brighter now that fewer surfaces glow
	L.FogEnd = 100000

	for _, child in L:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "GHSky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 24
	sky.SunAngularSize = 10
	sky.Parent = L

	local atmo = Instance.new("Atmosphere")
	atmo.Name = "GHAtmosphere"
	atmo.Density = 0.26 -- the map is ~2.7k studs long now: keep the next zone's landmarks visible
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(190, 150, 255)
	atmo.Decay = Color3.fromRGB(110, 70, 180)
	atmo.Glare = 0.4
	atmo.Haze = 1.0
	atmo.Parent = L

	clear("GHBloom")
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GHBloom"
	bloom.Intensity = 0.3
	bloom.Size = 20
	bloom.Threshold = 2
	bloom.Parent = L

	clear("GHColor")
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "GHColor"
	cc.Saturation = 0.3
	cc.Contrast = 0.1
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(255, 245, 255)
	cc.Parent = L

	clear("GHSunRays")
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "GHSunRays"
	rays.Intensity = 0.06
	rays.Spread = 0.7
	rays.Parent = L
end

return LightingSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Neighborhood</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 1: Haunted Neighborhood (Z -60..260). Spawn plaza + Ghost Hunter HQ at the south end,
-- a main road along X = 0 to the Cemetery gate, a cross street at Z 110..124 leading east to
-- the event arena, and candy-coloured houses placed on a grid wherever the keep-out map allows.
-- Palette: bright grass, warm houses, orange accents, purple paranormal touches, ectoplasm
-- green. Glow is reserved for the front windows, street lamps, car headlights and the HQ
-- antenna; side windows, plaza rings, chevrons, bands, doors and tanks are solid colours.
-- Materials: Asphalt roads, Concrete sidewalks, Slate roof shingles, Brick chimneys, Wood posts.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Neighborhood = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local WALLS = {
	C(255, 175, 190), C(255, 214, 168), C(255, 225, 140), C(250, 236, 200), C(215, 180, 255),
	C(255, 190, 140), C(240, 200, 150), C(255, 155, 135),
}
local ROOFS = { C(120, 60, 170), C(60, 120, 190), C(200, 70, 110), C(70, 150, 110), C(230, 110, 50), C(90, 70, 160) }
local WINDOWS = { C(255, 235, 120), C(150, 255, 140), C(205, 140, 255), C(255, 200, 90) }
local DOORS = { C(140, 70, 200), C(255, 110, 70), C(60, 170, 150), C(230, 70, 120) }
local TRIM = C(255, 250, 245)

--==================================================================
-- HOUSE
--==================================================================
-- Front windows glow; side windows (lit = false) are warm painted glass.
local function window(m: Instance, cf: CFrame, glow: Color3, lit: boolean?)
	Kit.Part(m, V(4, 4, 0.3), cf, TRIM, { Mat = Enum.Material.Wood })
	local glass: Kit.Opts = if lit == false then { Refl = 0.2 } else { Mat = NEON }
	Kit.Part(m, V(3.2, 3.2, 0.3), cf * CFrame.new(0, 0, -0.12), if lit == false then Kit.Vivid(glow) else glow, glass)
end

local function house(parent: Instance, cx: number, cz: number, fx: number, fz: number)
	local rng = Kit.Rng
	local W = rng:NextInteger(18, 23) -- along local X
	local D = rng:NextInteger(15, 19) -- along local Z (front = -Z)
	local twoStory = rng:NextNumber() < 0.35
	local H = if twoStory then 20 else 13
	local RH = math.floor(W * 0.38)
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local m = Kit.Model(parent, "House")
	local wall = Kit.Pick(WALLS)
	local roof = Kit.Pick(ROOFS)
	local glow = Kit.Pick(WINDOWS)

	Kit.Part(m, V(W + 0.8, 1.2, D + 0.8), base * CFrame.new(0, 0.6, 0), C(150, 130, 170), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(W, H, D), base * CFrame.new(0, H / 2, 0), wall, { Solid = true, Shadow = true, Name = "Body" })
	-- corner trims (front)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.9, H, 0.9), base * CFrame.new(sx * W / 2, H / 2, -D / 2), TRIM)
	end
	-- gable roof: two wedges meeting at the ridge (ridge along local X)
	local half = D / 2 + 1.5
	Kit.Part(m, V(W + 2.4, 0.6, D + 3.4), base * CFrame.new(0, H + 0.3, 0), TRIM)
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, -half / 2), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Wedge(m, V(W + 2, RH, half), base * CFrame.new(0, H + 0.6 + RH / 2, half / 2) * CFrame.Angles(0, math.pi, 0), roof, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- chimney poking through the back slope
	local chX = (if rng:NextNumber() < 0.5 then -1 else 1) * W * 0.28
	Kit.Part(m, V(2.4, RH + 2.5, 2.4), base * CFrame.new(chX, H + (RH + 2.5) / 2 + 0.6, D * 0.22), C(190, 110, 100), { Mat = Enum.Material.Brick, Shadow = true })
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(chX, H + RH + 3.4, D * 0.22), C(90, 70, 110))
	if rng:NextNumber() < 0.25 then
		-- a puff of ectoplasm smoke
		Kit.Ball(m, 2.2, (base * CFrame.new(chX, H + RH + 5, D * 0.22)).Position, Kit.Vivid(C(150, 255, 160)), { Transp = 0.4 })
	end
	-- front windows
	local rows: { number } = if twoStory then { H * 0.3, H * 0.72 } else { H * 0.5 }
	for _, wy in rows do
		for _, sx in { -1, 1 } do
			window(m, base * CFrame.new(sx * W * 0.28, wy, -D / 2 - 0.15), glow)
		end
	end
	if twoStory then
		window(m, base * CFrame.new(0, H * 0.72, -D / 2 - 0.15), Kit.Pick(WINDOWS))
	end
	-- side windows
	for _, sx in { -1, 1 } do
		window(m, base * CFrame.new(sx * (W / 2 + 0.15), H * 0.5, 0) * CFrame.Angles(0, -sx * math.pi / 2, 0), glow, false)
	end
	-- door
	Kit.Part(m, V(5, 8, 0.3), base * CFrame.new(0, 4.6, -D / 2 - 0.1), TRIM)
	Kit.Part(m, V(4, 7, 0.4), base * CFrame.new(0, 4.4, -D / 2 - 0.2), Kit.Pick(DOORS))
	Kit.Ball(m, 0.6, (base * CFrame.new(1.3, 4.2, -D / 2 - 0.5)).Position, C(255, 215, 80), { Refl = 0.3 }) -- brass knob
	-- porch with a little roof
	local pw = W * 0.6
	Kit.Part(m, V(pw, 0.8, 5), base * CFrame.new(0, 0.4, -D / 2 - 2.5), C(170, 120, 85), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local porchTop = if twoStory then 9.5 else 9.2
	Kit.Part(m, V(pw + 0.6, 0.5, 5.6), base * CFrame.new(0, porchTop + 0.25, -D / 2 - 2.8), roof)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.6, porchTop - 0.8, 0.6), base * CFrame.new(sx * (pw / 2 - 0.4), 0.8 + (porchTop - 0.8) / 2, -D / 2 - 5), TRIM, { Mat = Enum.Material.Wood })
	end
	if rng:NextNumber() < 0.55 then
		local p = base * CFrame.new(pw * 0.32, 0.8, -D / 2 - 3.2)
		local front = base.LookVector
		Props.Pumpkin(m, p.Position, 2.4, front.X, front.Z)
	end

	-- yard extras (only where the keep-out map allows)
	local function free(lx: number, lz: number, r: number): boolean
		local p = (base * CFrame.new(lx, 0, lz)).Position
		return Kit.IsFree(p.X, p.Z, r)
	end
	local yard = -D / 2 - 9
	if rng:NextNumber() < 0.45 and free(-W / 2 - 1, yard, 1) and free(W / 2 + 1, yard, 1) then
		local a1 = (base * CFrame.new(-W / 2 - 1, 0, yard)).Position
		local a2 = (base * CFrame.new(-2.5, 0, yard)).Position
		local b1 = (base * CFrame.new(2.5, 0, yard)).Position
		local b2 = (base * CFrame.new(W / 2 + 1, 0, yard)).Position
		Props.Fence(m, a1, a2, "picket")
		Props.Fence(m, b1, b2, "picket")
	elseif free(-W / 2 + 1, yard + 1, 1.5) then
		-- mailbox
		local mp = base * CFrame.new(-W / 2 + 1, 0, yard + 1)
		Kit.Part(m, V(0.5, 3.4, 0.5), mp * CFrame.new(0, 1.7, 0), C(110, 80, 60), { Mat = Enum.Material.Wood })
		Kit.Part(m, V(1.4, 1.3, 2.2), mp * CFrame.new(0, 3.9, 0), Kit.Pick(DOORS))
		Kit.Part(m, V(0.15, 1.2, 0.4), mp * CFrame.new(0.8, 4.4, 0.6), C(255, 70, 90))
	end
	if rng:NextNumber() < 0.3 then
		Props.FloatingPumpkin(m, (base * CFrame.new(-pw * 0.3, 11 + rng:NextNumber(0, 3), -D / 2 - 6)).Position)
	end
	Kit.AddCircle(cx, cz, math.max(W, D) / 2 + 4)
end

--==================================================================
-- SPAWN PLAZA + HQ
--==================================================================
local function chevron(parent: Instance, tip: Vector3, dir: Vector3, color: Color3)
	local perp = V(-dir.Z, 0, dir.X)
	local paint = Kit.Vivid(color)
	for _, s in { -1, 1 } do
		local arm = (-dir + perp * s).Unit
		local center = tip + arm * 2
		Kit.Part(parent, V(1, 0.15, 4.6), CFrame.lookAt(center, center + arm), paint)
	end
end

local function plaza(f: Instance)
	local spawnPos = Config.Layout.Spawn
	local sx, sz = spawnPos.X, spawnPos.Z
	Kit.Disc(f, sx, sz, 0.25, 52, 0.6, C(175, 150, 220), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.Disc(f, sx, sz, 0.35, 44, 0.2, Kit.Vivid(C(150, 255, 140)))
	Kit.Disc(f, sx, sz, 0.42, 42, 0.3, C(120, 95, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Disc(f, sx, sz, 0.5, 20, 0.2, Kit.Vivid(C(210, 120, 255)))

	local spawn: SpawnLocation = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V(14, 1, 14)
	-- top surface at Y = 1.1; face +Z (forward)
	spawn.CFrame = CFrame.new(sx, 0.6, sz) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = C(130, 70, 220)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.CanCollide = true
	spawn.CanQuery = true
	spawn.CanTouch = true
	spawn.CastShadow = false
	spawn.Parent = f
	Kit.Stats.Parts += 1
	local g = Kit.Gui(spawn, Enum.NormalId.Top, 20)
	Kit.Label(g, "👻", C(255, 255, 255), { Pos = UDim2.fromScale(0.15, 0.15), Size = UDim2.fromScale(0.7, 0.7) })
	local border = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(sx - 7.4, 0.4, sz + s * 7) - V(0, 0, 0.4), V(sx + 7.4, 1.3, sz + s * 7) + V(0, 0, 0.4), border)
		Kit.Box(f, V(sx + s * 7, 0.4, sz - 7) - V(0.4, 0, 0), V(sx + s * 7, 1.3, sz + 7) + V(0.4, 0, 0), border)
	end

	-- plaza lamps on the rim
	for i, a in { 45, 135, 225, 315 } do
		local r = math.rad(a)
		Props.StreetLamp(f, V(sx + math.cos(r) * 23, 0.25, sz + math.sin(r) * 23), C(200, 140, 255), i <= 2)
	end

	-- guide chevrons to the Beginner crate and the upgrade booth
	local beg = Config.Layout.CrateStations.Beginner
	local up = Config.Layout.UpgradeStation
	for _, target in { beg, up } do
		local dir = (V(target.X, 0, target.Z) - V(sx, 0, sz)).Unit
		for i = 1, 3 do
			chevron(f, V(sx, 0.55, sz) + dir * (8 + i * 4.5), dir, if target == beg then C(255, 180, 60) else C(90, 210, 255))
		end
	end
	-- signpost straight ahead of spawn
	local post = V(sx, 0, sz + 19)
	Kit.Box(f, post - V(0.4, 0, 0.4), post + V(0.4, 11, 0.4), C(110, 80, 60), { Mat = Enum.Material.Wood })
	local boards = {
		{ Y = 10, Off = 0, Text = "👻 GHOSTS AHEAD", Col = C(150, 255, 140) },
		-- the player faces +Z, so -X is on their right
		{ Y = 7.6, Off = -3, Text = "CRATES ▶", Col = C(255, 190, 70) },
		{ Y = 5.2, Off = 3, Text = "◀ UPGRADES", Col = C(110, 220, 255) },
	}
	for _, b in boards do
		Props.SignBoard(f, post + V(b.Off, b.Y, -0.6), 8, 2, 0, -1, b.Text, C(50, 30, 85), b.Col)
	end
end

local function hq(f: Instance)
	local purple, dark = C(120, 75, 210), C(60, 40, 110)
	Kit.Box(f, V(-24, 0, -58), V(24, 16, -40), purple, { Mat = Enum.Material.Concrete, Solid = true, Name = "HQ" })
	Kit.Box(f, V(-26, 16, -60), V(26, 17.5, -38), dark, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Ball(f, 18, V(0, 17.5, -50), C(190, 160, 255), { Shadow = true })
	Kit.Box(f, V(-24.3, 5.6, -39.9), V(24.3, 6.4, -39.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Box(f, V(-24.3, 15, -39.9), V(24.3, 15.6, -39.6), Kit.Vivid(C(255, 150, 60)))
	-- big mint door
	Kit.Box(f, V(-7, 0, -39.85), V(7, 12, -39.6), TRIM)
	Kit.Box(f, V(-6, 0, -39.7), V(6, 11, -39.35), Kit.Vivid(C(150, 255, 160)), { Refl = 0.1 })
	-- windows
	for _, x in { -17, -11, 11, 17 } do
		Kit.Box(f, V(x - 2, 8, -39.8), V(x + 2, 12.5, -39.4), C(255, 235, 120), { Mat = NEON })
	end
	-- sign facing +Z (toward spawn)
	local signCF = CFrame.new(0, 21.5, -39) * CFrame.Angles(0, Kit.FaceYaw(0, 1), 0)
	local sign = Kit.Part(f, V(32, 6, 1), signCF, C(45, 25, 80))
	Kit.Part(f, V(33.5, 7.5, 0.5), signCF * CFrame.new(0, 0, 0.6), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sign, Enum.NormalId.Front, "GHOST HUNTER HQ", C(255, 230, 90))
	-- antenna + dish
	Kit.Cyl(f, 18, 0.8, CFrame.new(16, 26.5, -50), C(200, 200, 220), { Mat = Enum.Material.Metal })
	local orb = Kit.Ball(f, 2.6, V(16, 36, -50), C(255, 90, 160), { Mat = NEON })
	Kit.Light(orb, C(255, 120, 190), 30, 1.2)
	Kit.Cyl(f, 0.8, 9, CFrame.new(-16, 21, -50) * CFrame.Angles(math.rad(35), 0, 0), C(230, 230, 245))
	Kit.Cyl(f, 3, 1, CFrame.new(-16, 19, -50), C(150, 150, 170))
	-- containment tanks with captured ghosts
	for _, s in { -1, 1 } do
		local x = s * 30
		Kit.Cyl(f, 1, 9, CFrame.new(x, 0.5, -46), dark, { Mat = Enum.Material.Metal, Solid = true })
		local tank = Kit.Cyl(f, 12, 8, CFrame.new(x, 7, -46), Kit.Vivid(C(130, 255, 170)), { Transp = 0.55, Refl = 0.2 })
		Kit.Cyl(f, 1, 9, CFrame.new(x, 13.5, -46), dark, { Mat = Enum.Material.Metal })
		Kit.Ball(f, 3.6, V(x, 7.5, -46), C(240, 245, 255))
		Kit.Emitter(tank, C(150, 255, 180), 2, 2, 0.5)
	end
	Kit.AddRect(-36, -60, 36, -36)
end

--==================================================================
-- ROADS
--==================================================================
local function roads(f: Instance)
	local asphalt = C(72, 64, 92)
	local walk = C(200, 185, 230)
	-- main road X -10..10 from HQ to the gate
	local pave: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true }
	Kit.Box(f, V(-10, -0.4, -36), V(10, 0.1, 260), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "MainRoad" })
	for z = 34, 250, 12 do
		Kit.Box(f, V(-0.4, 0.1, z), V(0.4, 0.14, z + 6), C(255, 210, 80))
	end
	-- cross street toward the arena
	Kit.Box(f, V(-136, -0.4, 110), V(63, 0.06, 124), asphalt, { Mat = Enum.Material.Asphalt, Solid = true, Name = "CrossStreet" })
	for x = -130, 55, 12 do
		if x < -16 or x > 14 then
			Kit.Box(f, V(x, 0.06, 116.6), V(x + 6, 0.1, 117.4), C(255, 210, 80))
		end
	end
	-- sidewalks
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, -0.4, 26), V(s * 14, 0.22, 106), walk, pave)
		Kit.Box(f, V(s * 10, -0.4, 128), V(s * 14, 0.22, 257), walk, pave)
		Kit.Box(f, V(-136, -0.4, if s < 0 then 106 else 124), V(-14, 0.22, if s < 0 then 110 else 128), walk, pave)
		Kit.Box(f, V(14, -0.4, if s < 0 then 106 else 124), V(61, 0.22, if s < 0 then 110 else 128), walk, pave)
	end
	Kit.AddRect(-14, -36, 14, 260, true)
	Kit.AddRect(-136, 106, 63, 128, true)
end

--==================================================================
-- BUILD
--==================================================================
function Neighborhood.Build(map: Instance)
	local f = Kit.Folder(map, "Neighborhood")
	local rng = Kit.Rng

	plaza(f)
	hq(f)
	roads(f)

	-- Houses on a grid; each faces the main road.
	local houses = Kit.Folder(f, "Houses")
	for _, x in { -118, -88, -58, -28, 28, 58, 88, 118 } do
		for z = -40, 230, 30 do
			if Kit.IsFree(x, z, 15) then
				house(houses, x, z, if x < 0 then 1 else -1, 0)
			end
		end
	end

	-- Street lamps along the main road (skipped inside ghost areas)
	local lit = 0
	for z = 34, 250, 24 do
		for _, s in { -1, 1 } do
			local x = s * 12.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0.22, z), Kit.Pick({ C(255, 230, 120), C(170, 255, 150), C(210, 150, 255) }), lit % 2 == 1 and lit <= 9)
			end
		end
	end
	for x = -125, 50, 35 do
		if Kit.IsFree(x, 108, 1, true) then
			Props.StreetLamp(f, V(x, 0.22, 108), C(255, 200, 120), false)
		end
	end

	-- Parked cars (curbside)
	local cars = {
		{ -6, 150, 0, 1 }, { 6, 186, 0, -1 }, { -105, 113.5, 1, 0 }, { -42, 113.5, 1, 0 }, { 40, 120.5, -1, 0 },
		{ 70, -30, 0, 1 }, { -70, 20, 0, -1 },
	}
	for _, c in cars do
		if Kit.IsFree(c[1], c[2], 7.5, true) then
			Props.Car(f, V(c[1], 0.1, c[2]), c[3], c[4], Kit.Pick(Props.Colors.Car))
		end
	end

	-- Trees and pumpkins scattered on free grass
	local trees = 0
	for _ = 1, 260 do
		if trees >= 30 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(-54, 250)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(10, 17))
		end
	end
	local pumpkins = 0
	for _ = 1, 300 do
		if pumpkins >= 26 then
			break
		end
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(-54, 254)
		if Kit.IsFree(x, z, 2.5) then
			pumpkins += 1
			Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 4.6), -x, -z + 100)
			Kit.AddCircle(x, z, 2.5)
		end
	end
	local floats = 0
	for _ = 1, 200 do
		if floats >= 3 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(-40, 240)
		if Kit.IsFree(x, z, 3) then
			floats += 1
			Props.FloatingPumpkin(f, V(x, rng:NextNumber(8, 13), z))
		end
	end

	-- Spectral fog accents
	Props.Wisp(f, V(-40, 0, 40), C(170, 110, 255), 14, true)
	Props.Wisp(f, V(55, 0, 135), C(120, 255, 170), 12, true)
	Props.Wisp(f, V(-110, 0, 215), C(200, 120, 255), 16, true)
	Props.Wisp(f, V(30, 0, 240), C(120, 255, 170), 10, false)
	Props.Wisp(f, V(-60, 0, -20), C(170, 110, 255), 12, false)
	Props.Wisp(f, V(110, 0, 20), C(255, 140, 220), 12, false)
end

return Neighborhood
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable chunky props shared by every zone (pumpkins, trees, lamps, fences, cars...).
-- Positions are ground points (Y = 0 is the walkable surface) unless stated otherwise.

local Kit = require(script.Parent.Kit)

local Props = {}

local NEON = Enum.Material.Neon
local C = Color3.fromRGB

Props.Colors = {
	PumpkinBody = { C(255, 140, 30), C(255, 120, 40), C(255, 165, 50) },
	Canopy = { C(170, 90, 230), C(255, 140, 50), C(200, 110, 255), C(255, 110, 90), C(140, 220, 90) },
	Glow = { C(255, 230, 110), C(140, 255, 120), C(200, 130, 255), C(255, 170, 70) },
	Car = { C(255, 90, 140), C(80, 200, 255), C(255, 200, 60), C(140, 255, 140), C(190, 120, 255), C(255, 120, 60) },
	Book = { C(255, 90, 90), C(90, 170, 255), C(255, 210, 70), C(140, 230, 120), C(200, 120, 255), C(255, 140, 200) },
}

-- Segment between two points (square cross-section). Used for twisted trunks, branches, cracks.
function Props.Beam(parent: Instance, a: Vector3, b: Vector3, w: number, h: number, color: Color3, opts: Kit.Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local cf: CFrame
	if math.abs(d.Unit.Y) > 0.98 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	return Kit.Part(parent, Vector3.new(w, h, len), cf, color, opts)
end

-- Pumpkin / jack-o-lantern with a carved face toward (fx, fz). `pos` is the bottom of the pumpkin.
-- glow = true gives a Neon jack-o'-lantern face: use it only at landmarks (gate pillars, crate
-- stations, the arena rim, the school path). Every other pumpkin gets a warm solid-yellow
-- face, so the ~100 pumpkins on the map don't turn into glowing confetti.
local FACE_GLOW = C(255, 235, 90)
local FACE_SOLID = C(255, 205, 55)

function Props.Pumpkin(parent: Instance, pos: Vector3, d: number, fx: number, fz: number, glow: boolean?): Part
	local center = pos + Vector3.new(0, d * 0.45, 0)
	local body = Kit.Ball(parent, d, center, Kit.Pick(Props.Colors.PumpkinBody), { Shadow = false })
	local base = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Part(parent, Vector3.new(d * 0.12, d * 0.3, d * 0.12), base * CFrame.new(0, d * 0.55, 0) * CFrame.Angles(0, 0, 0.25), C(90, 160, 60))
	local face = if glow then FACE_GLOW else FACE_SOLID
	local faceOpts: Kit.Opts = if glow then { Mat = NEON } else {}
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(-d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.18, d * 0.16, d * 0.1), base * CFrame.new(d * 0.2, d * 0.12, -d * 0.46), face, faceOpts)
	Kit.Part(parent, Vector3.new(d * 0.42, d * 0.1, d * 0.1), base * CFrame.new(0, -d * 0.12, -d * 0.45), face, faceOpts)
	return body
end

-- Lollipop tree: trunk + three canopy balls.
function Props.Tree(parent: Instance, pos: Vector3, height: number, canopy: Color3?)
	local col = canopy or Kit.Pick(Props.Colors.Canopy)
	local rng = Kit.Rng
	Kit.Cyl(parent, height, 1.8, CFrame.new(pos + Vector3.new(0, height / 2, 0)), C(120, 75, 50), { Mat = Enum.Material.Wood, Solid = true, Shadow = true })
	local top = pos + Vector3.new(0, height, 0)
	local s = height * 0.55
	Kit.Ball(parent, s, top, col, { Shadow = true })
	Kit.Ball(parent, s * 0.75, top + Vector3.new(rng:NextNumber(-2, 2), s * 0.35, rng:NextNumber(-2, 2)), col:Lerp(Color3.new(1, 1, 1), 0.15))
	Kit.Ball(parent, s * 0.6, top + Vector3.new(rng:NextNumber(-3, 3), -s * 0.2, rng:NextNumber(-3, 3)), col:Lerp(Color3.new(0, 0, 0), 0.12))
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Twisted spooky tree made of crooked segments, bare branches and a few candy-coloured leaf puffs.
function Props.TwistedTree(parent: Instance, pos: Vector3, height: number)
	local rng = Kit.Rng
	local trunk = C(95, 70, 110)
	local pts = { pos }
	local seg = height / 3
	for i = 1, 3 do
		local prev = pts[i]
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1.2, 2.8)
		table.insert(pts, prev + Vector3.new(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 3 do
		local w = 3.2 - i * 0.7
		Props.Beam(parent, pts[i], pts[i + 1], w, w, trunk, { Mat = Enum.Material.Wood, Solid = i == 1, Shadow = true })
	end
	local leaf = { C(170, 90, 255), C(110, 255, 160), C(255, 120, 200) }
	for b = 1, 3 do
		local from = pts[2 + (b % 2)]
		local ang = b * 2.1 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.22, 0.32)
		local tip = from + Vector3.new(math.cos(ang) * len, len * 0.6, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 0.9, 0.9, trunk, { Mat = Enum.Material.Wood })
		Kit.Ball(parent, rng:NextNumber(3.5, 5.5), tip, Kit.Vivid(Kit.Pick(leaf)), { Transp = 0.1 })
	end
	Kit.AddCircle(pos.X, pos.Z, 3)
end

-- Street lamp: pole, arm and a glowing globe.
function Props.StreetLamp(parent: Instance, pos: Vector3, color: Color3, withLight: boolean)
	local pole = C(60, 45, 90)
	local metal: Kit.Opts = { Mat = Enum.Material.Metal }
	Kit.Cyl(parent, 13, 0.8, CFrame.new(pos + Vector3.new(0, 6.5, 0)), pole, metal)
	Kit.Cyl(parent, 0.8, 1.8, CFrame.new(pos + Vector3.new(0, 0.4, 0)), pole, metal)
	Kit.Box(parent, pos + Vector3.new(-0.3, 12.6, -0.3), pos + Vector3.new(0.3, 13.2, 0.3), pole, metal)
	local globe = Kit.Ball(parent, 2.4, pos + Vector3.new(0, 14, 0), color, { Mat = NEON })
	Kit.Cyl(parent, 0.5, 2.8, CFrame.new(pos + Vector3.new(0, 15.3, 0)), pole, metal)
	if withLight then
		Kit.Light(globe, color, 22, 1.6)
	end
end

-- Little post lantern (cemetery paths).
function Props.Lantern(parent: Instance, pos: Vector3, color: Color3, withLight: boolean, flicker: boolean?)
	local iron = C(50, 40, 70)
	Kit.Box(parent, pos + Vector3.new(-0.3, 0, -0.3), pos + Vector3.new(0.3, 7, 0.3), iron, { Mat = Enum.Material.Metal })
	local glow = Kit.Box(parent, pos + Vector3.new(-0.8, 7, -0.8), pos + Vector3.new(0.8, 9, 0.8), color, { Mat = NEON })
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, -0.55)), iron)
	Kit.Wedge(parent, Vector3.new(2.2, 1, 1.1), CFrame.new(pos + Vector3.new(0, 9.5, 0.55)) * CFrame.Angles(0, math.pi, 0), iron)
	if withLight then
		Kit.Light(glow, color, 18, 1.4, flicker)
	end
end

-- Mushroom cluster with bright candy caps.
function Props.Mushrooms(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local caps = { C(120, 255, 200), C(200, 120, 255), C(255, 150, 220), C(120, 220, 255) }
	for _ = 1, rng:NextInteger(2, 3) do
		local p = pos + Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.8, 2)
		Kit.Cyl(parent, h, 0.5, CFrame.new(p + Vector3.new(0, h / 2, 0)), C(245, 240, 225))
		Kit.Ball(parent, rng:NextNumber(1.3, 2), p + Vector3.new(0, h, 0), Kit.Vivid(Kit.Pick(caps)))
	end
end

-- Fence run from a to b (ground points). style: "picket" (crooked white wood) or "iron" (dark
-- metal with mint tips).
function Props.Fence(parent: Instance, a: Vector3, b: Vector3, style: string)
	local rng = Kit.Rng
	local d = b - a
	local len = d.Magnitude
	if len < 1 then
		return
	end
	local dir = d.Unit
	local yaw = math.atan2(-dir.X, -dir.Z) -- local -Z along the run
	local iron = style == "iron"
	local col = if iron then C(55, 45, 80) else C(250, 240, 255)
	local h = if iron then 6 else 3.6
	local mat: Kit.Opts = { Mat = if iron then Enum.Material.Metal else Enum.Material.Wood }
	local step = if iron then 2 else 1.6
	local rails = { h * 0.3, h * 0.75 }
	for _, ry in rails do
		local mid = a + d / 2 + Vector3.new(0, ry, 0)
		Kit.Part(parent, Vector3.new(0.3, 0.3, len), CFrame.new(mid) * CFrame.Angles(0, yaw, 0), col, mat)
	end
	local n = math.floor(len / step)
	for i = 0, n do
		local p = a + dir * (i * step) + Vector3.new(0, h / 2, 0)
		local tilt = if iron then 0 else rng:NextNumber(-0.14, 0.14)
		local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt * 0.3, 0, tilt)
		Kit.Part(parent, Vector3.new(if iron then 0.35 else 0.25, h, if iron then 0.35 else 0.9), cf, col, mat)
		if iron and i % 3 == 0 then
			Kit.Ball(parent, 0.7, p + Vector3.new(0, h / 2 + 0.3, 0), Kit.Vivid(C(120, 255, 170)))
		end
	end
end

-- Low translucent spectral puddle on the ground (solid colour, the fog particles do the
-- glowing); optional slow particle fog.
function Props.Wisp(parent: Instance, pos: Vector3, color: Color3, d: number, emit: boolean)
	local p = Kit.Disc(parent, pos.X, pos.Z, 0.3, d, 0.12, Kit.Vivid(color), { Transp = 0.6 })
	if emit then
		local src = Kit.Part(parent, Vector3.new(d * 0.6, 0.2, d * 0.6), CFrame.new(pos + Vector3.new(0, 1, 0)), color, { Transp = 1, Name = "FogSource" })
		Kit.Emitter(src, color, 1.5, 7, 0.4)
	end
	return p
end

-- Chunky cartoon car. `along` = direction the car faces (unit X/Z vector).
function Props.Car(parent: Instance, pos: Vector3, fx: number, fz: number, color: Color3)
	local m = Kit.Model(parent, "Car")
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	-- body (length along local Z)
	Kit.Part(m, Vector3.new(7.5, 3, 14), base * CFrame.new(0, 2.6, 0), color, { Solid = true, Shadow = true })
	Kit.Part(m, Vector3.new(6.6, 2.8, 7), base * CFrame.new(0, 5.4, 0.8), color:Lerp(Color3.new(1, 1, 1), 0.25), { Solid = true })
	local glass = Kit.Vivid(C(170, 230, 255))
	Kit.Part(m, Vector3.new(5.8, 2, 0.3), base * CFrame.new(0, 5.5, -2.75), glass, { Transp = 0.2, Refl = 0.25 })
	Kit.Part(m, Vector3.new(6.7, 1.8, 5.4), base * CFrame.new(0, 5.5, 0.8), glass, { Transp = 0.3, Refl = 0.25 })
	local axle = if math.abs(fx) > math.abs(fz) then "Z" else "X"
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 1.2, 3.4, (base * CFrame.new(sx * 3.5, 1.7, sz * 4.4)).Position, axle, C(40, 35, 55), { Mat = Enum.Material.Rubber })
		end
		Kit.Part(m, Vector3.new(1.4, 1, 0.3), base * CFrame.new(sx * 2.6, 3, -7.05), C(255, 250, 200), { Mat = NEON })
		-- tail lights: glossy painted red (headlights are the only glow on a car)
		Kit.Part(m, Vector3.new(1.2, 0.8, 0.3), base * CFrame.new(sx * 2.7, 3, 7.05), Kit.Vivid(C(230, 40, 70)), { Refl = 0.3 })
	end
	Kit.AddCircle(pos.X, pos.Z, 8)
end

-- Cute skull (big white ball with black eyes) facing (fx, fz). pos = centre.
function Props.Skull(parent: Instance, pos: Vector3, d: number, fx: number, fz: number)
	local base = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(parent, d, pos, C(250, 245, 235))
	Kit.Part(parent, Vector3.new(d * 0.55, d * 0.35, d * 0.5), base * CFrame.new(0, -d * 0.4, -d * 0.1), C(250, 245, 235))
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, d * 0.28, (base * CFrame.new(sx * d * 0.18, d * 0.05, -d * 0.38)).Position, C(120, 255, 170), { Mat = NEON })
	end
end

-- Single-part floating book (tagged). pos = centre in the air.
function Props.FloatingBook(parent: Instance, pos: Vector3)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local b = Kit.Part(parent, Vector3.new(1.8, 0.5, 2.4), cf, Kit.Pick(Props.Colors.Book), { Name = "FloatingBook" })
	Kit.Float(b, rng:NextNumber(0.6, 1.2))
end

-- Single-part floating candle (tagged).
function Props.FloatingCandle(parent: Instance, pos: Vector3)
	local c = Kit.Cyl(parent, 1.6, 0.6, CFrame.new(pos), C(255, 230, 160), { Mat = NEON, Name = "FloatingCandle" })
	Kit.Float(c, Kit.Rng:NextNumber(0.5, 1))
end

-- Single-part floating pumpkin (tagged).
function Props.FloatingPumpkin(parent: Instance, pos: Vector3)
	local p = Kit.Ball(parent, 2.4, pos, C(255, 150, 40), { Name = "FloatingPumpkin" })
	Kit.Float(p, Kit.Rng:NextNumber(0.6, 1.1))
end

-- A sign board facing (fx, fz) with text on its Front face.
function Props.SignBoard(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, bg: Color3, fg: Color3, frame: Color3?): Part
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local board = Kit.Part(parent, Vector3.new(w, h, 0.6), cf, bg, { Name = "SignBoard" })
	if frame then
		Kit.Part(parent, Vector3.new(w + 1, h + 1, 0.4), cf * CFrame.new(0, 0, 0.35), Kit.Vivid(frame))
	end
	Kit.Sign(board, Enum.NormalId.Front, text, fg)
	return board
end

-- Graffiti: an invisible thin panel with neon text, flat against a wall, facing (fx, fz).
function Props.Graffiti(parent: Instance, center: Vector3, w: number, h: number, fx: number, fz: number, text: string, color: Color3, rot: number?)
	local cf = CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local panel = Kit.Part(parent, Vector3.new(w, h, 0.1), cf, color, { Transp = 1, Name = "Graffiti" })
	Kit.Sign(panel, Enum.NormalId.Front, text, color, { Font = Enum.Font.FredokaOne, Stroke = C(30, 10, 50), Rotation = rot })
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">School</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 3: Haunted School (Z 540..880).
--   Courtyard Z 540..600: path, Elite crate station (built by Stations), ghost bus, flagpole.
--   Building X -100..100, Z 600..860, walls 16 tall, NO roof over the interior (only rim
--   ledges and a few thin beams) so the camera and ghost taps work from above.
--     Front wall Z=600 with a 20-wide entrance under the clock tower (top ~Y 104).
--     Central hallway X -16..16, Z 601..761 (ghost areas at Z 640 and 700).
--     Library   X -99..-18, Z 601..648   | Cafeteria X 18..99, Z 601..648
--     Class 1-A X -99..-18, Z 650..761   | Class 1-B X 18..99, Z 650..761 (ghost areas at X ±62, Z 690)
--     Gym       X -99..99,  Z 763..859 (Headmaster area at Z 805), bleachers along the back wall
--               in two halves either side of the back exit.
--   Doorways: hallway→library/cafeteria 14 wide, hallway→classes 20 wide, library/cafeteria→class
--   14 wide, classes→gym 16 wide, hallway→gym 32 wide, gym→back exit 28 wide (X -14..14, Z 860,
--   12 tall under an "EXIT → CARNIVAL" sign), then a flat path to Gate_Carnival at Z 880.
--   The strips X 105..136 beside the building stay walkable from the courtyard to the back.
--   Palette: warm brick exterior, cream inner walls and trims, school-blue roofs/ledges, purple
--   spectral accents, green ectoplasm. Glow is kept to the front windows, sconces, desk lamps,
--   the bell, slime puddles, bus headlights and the jack-o'-lanterns along the path; bands,
--   rings, lines, frames, trims and side windows are painted.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local School = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local H = 16
local EXT = C(190, 98, 76) -- warm brick
local CREAM = C(245, 232, 205)
local BLUE = C(70, 112, 190) -- school blue
local TRIMC = C(70, 105, 185)
local WHITE = C(255, 250, 245)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }
local BRICK: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }

type Opening = { c: number, w: number, h: number? }

local function sortOpenings(list: { Opening })
	table.sort(list, function(a: Opening, b: Opening)
		return a.c < b.c
	end)
end

-- Wall along X at fixed z (thickness 2), from x1 to x2, with doorway openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = x1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(cur, 0, z - 1), V(a, H, z + 1), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(a, oh, z - 1), V(b, H, z + 1), color, wo)
		end
		cur = b
	end
	if x2 > cur then
		Kit.Box(parent, V(cur, 0, z - 1), V(x2, H, z + 1), color, wo)
	end
end

-- Wall along Z at fixed x (thickness 2), from z1 to z2, with doorway openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, color: Color3, openings: { Opening }, opts: Kit.Opts?)
	local wo = opts or SOLID
	sortOpenings(openings)
	local cur = z1
	for _, o in openings do
		local a, b = o.c - o.w / 2, o.c + o.w / 2
		if a > cur then
			Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, a), color, wo)
		end
		local oh = o.h
		if oh and oh < H then
			Kit.Box(parent, V(x - 1, oh, a), V(x + 1, H, b), color, wo)
		end
		cur = b
	end
	if z2 > cur then
		Kit.Box(parent, V(x - 1, 0, cur), V(x + 1, H, z2), color, wo)
	end
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, SOLID)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, SOLID)
end

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	-- wall lamp on a wall whose inner face is at pos.X - fx * 0.5
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), C(60, 40, 90))
	Kit.Light(lamp, color, 24, 1.6, true)
end

--==================================================================
-- SHELL
--==================================================================
local function shell(f: Instance)
	-- floors (top Y 0.15)
	Kit.Box(f, V(-101, -0.5, 599), V(101, 0.1, 861), C(110, 90, 150), { Solid = true, Name = "SchoolFloor" })
	local tiles = { C(240, 230, 210), C(95, 135, 205) }
	for i = 0, 3 do
		for j = 0, 19 do
			local x0, z0 = -16 + i * 8, 601 + j * 8
			Kit.Box(f, V(x0, 0.05, z0), V(x0 + 8, 0.15, z0 + 8), tiles[((i + j) % 2) + 1], { Solid = true })
		end
	end
	Kit.Box(f, V(-99, 0.05, 601), V(-18, 0.15, 648), C(190, 130, 90), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 601), V(99, 0.15, 648), C(255, 225, 175), { Solid = true })
	Kit.Box(f, V(-99, 0.05, 650), V(-18, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(18, 0.05, 650), V(99, 0.15, 761), C(215, 170, 120), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(f, V(-99, 0.05, 763), V(99, 0.15, 859), C(235, 160, 90), { Mat = Enum.Material.WoodPlanks, Solid = true, Name = "GymFloor" })

	-- exterior walls
	wallX(f, 600, -101, 101, EXT, { { c = 0, w = 20 } }, BRICK)
	-- back exit out of the gym toward Gate_Carnival (X -14..14, 12 tall)
	wallX(f, 860, -101, 101, EXT, { { c = 0, w = 28, h = 12 } }, BRICK)
	wallZ(f, -100, 601, 859, EXT, {}, BRICK)
	wallZ(f, 100, 601, 859, EXT, {}, BRICK)
	-- hallway walls
	local hall = CREAM
	wallZ(f, -17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	wallZ(f, 17, 601, 761, hall, { { c = 624, w = 14, h = 12 }, { c = 690, w = 20, h = 13 } })
	-- front rooms / classrooms divider and the gym wall
	local inner = C(120, 160, 215)
	wallX(f, 649, -99, -18, inner, { { c = -60, w = 14, h = 12 } })
	wallX(f, 649, 18, 99, inner, { { c = 60, w = 14, h = 12 } })
	wallX(f, 762, -99, 99, C(235, 215, 180), { { c = 0, w = 32 }, { c = -60, w = 16, h = 13 }, { c = 60, w = 16, h = 13 } })

	-- parapet on the exterior walls + partial roof ledges (no roof over the interior)
	local rim: Kit.Opts = { Mat = Enum.Material.Concrete, Solid = true, Shadow = true }
	Kit.Box(f, V(-102, H, 598), V(102, H + 2, 602), CREAM, rim)
	Kit.Box(f, V(-102, H, 858), V(102, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(-102, H, 598), V(-98, H + 2, 862), CREAM, rim)
	Kit.Box(f, V(98, H, 598), V(102, H + 2, 862), CREAM, rim)
	local ledge = BLUE
	Kit.Box(f, V(-98, H + 0.5, 602), V(98, H + 1.5, 607), ledge)
	Kit.Box(f, V(-98, H + 0.5, 853), V(98, H + 1.5, 858), ledge)
	Kit.Box(f, V(-98, H + 0.5, 602), V(-93, H + 1.5, 858), ledge)
	Kit.Box(f, V(93, H + 0.5, 602), V(98, H + 1.5, 858), ledge)
	-- sloped eaves on the outside
	local eave = C(55, 85, 150)
	local eaveOpts: Kit.Opts = { Mat = Enum.Material.Slate, Shadow = true }
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 596), 0, -1), eave, eaveOpts)
	Kit.Wedge(f, V(208, 3, 4), faced(V(0, H + 0.5, 864), 0, 1), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(-104, H + 0.5, 730), -1, 0), eave, eaveOpts)
	Kit.Wedge(f, V(268, 3, 4), faced(V(104, H + 0.5, 730), 1, 0), eave, eaveOpts)
	-- painted band along the front
	Kit.Box(f, V(-101.2, 14, 598.7), V(101.2, 14.6, 598.9), Kit.Vivid(C(150, 255, 140)))

	-- corner turrets
	local turretRing, turretTop = Kit.Vivid(C(200, 130, 255)), Kit.Vivid(C(150, 255, 140))
	for _, x in { -100, 100 } do
		for _, z in { 600, 860 } do
			Kit.Cyl(f, 24, 10, CFrame.new(x, 12, z), EXT:Lerp(C(255, 255, 255), 0.08), BRICK)
			Kit.Cyl(f, 1, 10.6, CFrame.new(x, 14.3, z), turretRing)
			Kit.Cyl(f, 2, 11.5, CFrame.new(x, 25, z), CREAM, { Mat = Enum.Material.Concrete })
			Kit.Cyl(f, 3, 8, CFrame.new(x, 27.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Cyl(f, 3, 4.5, CFrame.new(x, 30.5, z), TRIMC, { Mat = Enum.Material.Slate })
			Kit.Ball(f, 2.6, V(x, 33, z), turretTop)
		end
	end

	-- facade windows glow (ghostly); side windows are warm painted glass
	for _, x in { -88, -70, -50, -30, 30, 50, 70, 88 } do
		Kit.Box(f, V(x - 3, 4.5, 598.75), V(x + 3, 12.5, 599), WHITE)
		Kit.Box(f, V(x - 2.4, 5, 598.6), V(x + 2.4, 12, 598.85), Kit.Pick({ C(255, 230, 120), C(150, 255, 140), C(210, 150, 255) }), { Mat = NEON })
	end
	for _, s in { -1, 1 } do
		for _, z in { 625, 690, 735, 790, 830 } do
			Kit.Box(f, V(s * 101, 4.5, z - 3), V(s * 101.25, 12.5, z + 3), WHITE)
			Kit.Box(f, V(s * 101.15, 5, z - 2.4), V(s * 101.4, 12, z + 2.4), Kit.Vivid(Kit.Pick({ C(255, 225, 130), C(160, 235, 150), C(200, 160, 245) })), { Refl = 0.2 })
		end
	end
	-- entrance steps
	Kit.Box(f, V(-12, 0, 592), V(12, 0.5, 599), C(200, 190, 220), { Mat = Enum.Material.Slate, Solid = true })
end

--==================================================================
-- CLOCK TOWER (over the entrance)
--==================================================================
local function clockTower(f: Instance)
	local body = EXT:Lerp(C(0, 0, 0), 0.05)
	local mint, orange = Kit.Vivid(C(150, 255, 140)), Kit.Vivid(C(255, 160, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, 594), V(s * 14, 22, 606), body, BRICK)
		Kit.Box(f, V(s * 9.8, 0, 593.8), V(s * 10.3, 22, 594.3), mint)
	end
	Kit.Box(f, V(-14, 22, 594), V(14, 62, 606), body, { Mat = Enum.Material.Brick, Solid = true, Shadow = true, Name = "ClockTower" })
	Kit.Box(f, V(-14.3, 22, 593.7), V(14.3, 23, 606.3), mint)
	Kit.Box(f, V(-14.3, 61, 593.7), V(14.3, 62, 606.3), orange)
	-- SPOOKY HIGH sign
	local sign = Kit.Part(f, V(26, 6, 0.6), CFrame.new(0, 26.5, 593.6), C(45, 25, 80))
	Kit.Part(f, V(27.5, 7.5, 0.3), CFrame.new(0, 26.5, 593.85), orange)
	Kit.Sign(sign, Enum.NormalId.Front, "SPOOKY HIGH", C(255, 200, 80))
	-- clock (11:55, almost midnight)
	Kit.CylFlat(f, 0.5, 17.5, V(0, 44, 593.75), "Z", Kit.Vivid(C(200, 120, 255)))
	Kit.CylFlat(f, 0.6, 16, V(0, 44, 593.4), "Z", C(255, 245, 225))
	local function hand(len: number, w: number, angle: number, z: number, color: Color3)
		Kit.Part(f, V(w, len, 0.25), CFrame.new(0, 44, z) * CFrame.Angles(0, 0, angle) * CFrame.new(0, len / 2, 0), color)
	end
	hand(5, 1, -0.05, 593.0, C(60, 30, 90))
	hand(7, 0.7, -0.52, 592.9, C(130, 60, 200))
	Kit.Ball(f, 1.2, V(0, 44, 592.9), orange)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.Part(f, V(0.8, 1.6, 0.3), CFrame.new(math.sin(a) * 6.5, 44 + math.cos(a) * 6.5, 593.0) * CFrame.Angles(0, 0, -a), C(130, 60, 200))
	end
	-- bell loft
	for _, x in { -12.5, 12.5 } do
		for _, z in { 595.5, 604.5 } do
			Kit.Box(f, V(x - 1.5, 62, z - 1.5), V(x + 1.5, 74, z + 1.5), CREAM, { Mat = Enum.Material.Concrete, Solid = true, Shadow = true })
		end
	end
	local bell = Kit.Ball(f, 7, V(0, 68, 600), C(255, 200, 70))
	Kit.Ball(f, 3, V(0, 64.8, 600), C(150, 255, 140), { Mat = NEON })
	Kit.Light(bell, C(170, 255, 160), 30, 1.4)
	Kit.Box(f, V(-15.5, 74, 592.5), V(15.5, 76, 607.5), TRIMC, SOLID)
	gable(f, CFrame.new(0, 76, 600), 31, 15, 14, C(55, 85, 150))
	Kit.Cyl(f, 12, 1.2, CFrame.new(0, 96, 600), C(240, 220, 120))
	Kit.Ball(f, 3.2, V(0, 103, 600), Kit.Vivid(C(200, 120, 255)))
end

--==================================================================
-- HALLWAY
--==================================================================
local function hallway(f: Instance)
	local lockerCols = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	local runs = { { 606, 616 }, { 632, 679 }, { 701, 760 } }
	local slimed = Kit.Vivid(C(140, 255, 150))
	local n = 0
	for _, s in { -1, 1 } do
		for _, r in runs do
			local z0 = r[1]
			while z0 + 3 <= r[2] do
				n += 1
				Kit.Box(f, V(s * 16, 0.15, z0), V(s * 14.5, 8.5, z0 + 3), lockerCols[(n % #lockerCols) + 1], { Mat = Enum.Material.Metal, Solid = true })
				if n % 7 == 0 then
					Kit.Box(f, V(s * 14.5, 1, z0 + 0.4), V(s * 14.35, 8, z0 + 2.6), slimed) -- slimed locker door
				end
				z0 += 3.2
			end
			Kit.Box(f, V(s * 16, 8.5, r[1]), V(s * 14.3, 9, r[2]), C(120, 70, 190))
		end
	end
	-- painted guide lines on the floor (flat)
	local guide = Kit.Vivid(C(200, 130, 255))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 7 - 0.25, 0.15, 603), V(s * 7 + 0.25, 0.2, 760), guide)
	end
	-- thin beams overhead (Y 16..17.5), clear of the ghost areas' height
	for _, z in { 615, 670, 732, 758 } do
		Kit.Box(f, V(-18, H, z - 0.75), V(18, H + 1.5, z + 0.75), C(120, 80, 60), { Mat = Enum.Material.WoodPlanks })
	end
	local gymSign = Kit.Part(f, V(14, 3, 0.4), CFrame.new(0, 13.6, 758), C(45, 25, 80))
	Kit.Sign(gymSign, Enum.NormalId.Front, "🏀 GYM 🏀", C(255, 190, 80))
	for _, x in { -5, 5 } do
		Kit.Box(f, V(x - 0.1, 15.1, 757.9), V(x + 0.1, H, 758.1), C(60, 50, 70))
	end
	-- flickering sconces
	for _, z in { 612, 668, 722 } do
		sconce(f, V(-15.6, 12.4, z), 1, C(255, 230, 140))
	end
	for _, z in { 640, 712, 750 } do
		sconce(f, V(15.6, 12.4, z), -1, C(200, 150, 255))
	end
	-- door signs
	Props.SignBoard(f, V(-15.6, 14, 624), 12, 2.8, 1, 0, "📚 LIBRARY", C(45, 25, 80), C(255, 220, 120))
	Props.SignBoard(f, V(15.6, 14, 624), 12, 2.8, -1, 0, "🍕 CAFETERIA", C(45, 25, 80), C(150, 255, 140))
	Props.SignBoard(f, V(-15.6, 14.5, 690), 14, 2.6, 1, 0, "CLASS 1-A", C(45, 25, 80), C(255, 170, 220))
	Props.SignBoard(f, V(15.6, 14.5, 690), 14, 2.6, -1, 0, "CLASS 1-B", C(45, 25, 80), C(120, 220, 255))
	-- ghostly graffiti
	Props.Graffiti(f, V(-15.9, 12.3, 650), 10, 5, 1, 0, "BOO!", C(150, 255, 140), -6)
	Props.Graffiti(f, V(15.9, 12.3, 655), 14, 5, -1, 0, "NO RUNNING\n(FLOATING OK)", C(255, 150, 220), 4)
	Props.Graffiti(f, V(-15.9, 12.3, 740), 14, 5, 1, 0, "GHOSTS RULE", C(200, 140, 255), -3)
	Props.Graffiti(f, V(15.9, 12.3, 728), 12, 5, -1, 0, "HALL PASS?\nNAH.", C(120, 230, 255), 5)
	-- slime puddles (flat)
	local slime = Kit.Disc(f, -4, 662, 0.22, 6, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
	Kit.Emitter(slime, C(150, 255, 160), 1.5, 3, 0.4)
	Kit.Disc(f, 6, 721, 0.22, 4, 0.08, C(130, 255, 140), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- LIBRARY + CAFETERIA
--==================================================================
local function shelf(f: Instance, a: Vector3, b: Vector3, faceAxis: string, faceSign: number)
	Kit.Box(f, a, b, C(120, 75, 55), { Mat = Enum.Material.WoodPlanks, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	for i = 0, 2 do
		local y = 1.4 + i * 3.1
		local col = Kit.Pick(Props.Colors.Book)
		if faceAxis == "X" then
			local x = if faceSign > 0 then hi.X else lo.X
			Kit.Box(f, V(x, y, lo.Z + 0.4), V(x + faceSign * 0.3, y + 2.3, hi.Z - 0.4), col)
		else
			local z = if faceSign > 0 then hi.Z else lo.Z
			Kit.Box(f, V(lo.X + 0.4, y, z), V(hi.X - 0.4, y + 2.3, z + faceSign * 0.3), col)
		end
	end
end

local function library(f: Instance)
	for z = 607, 638, 8.5 do
		shelf(f, V(-99, 0.15, z), V(-96, 11, z + 8), "X", 1)
	end
	for x = -93, -30, 9 do
		shelf(f, V(x, 0.15, 601), V(x + 8, 11, 604), "Z", 1)
	end
	for _, x in { -70, -45 } do
		Kit.Box(f, V(x - 6, 3, 621), V(x + 6, 3.6, 631), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
		Kit.Box(f, V(x - 1, 0.15, 624), V(x + 1, 3, 628), C(110, 70, 50))
		Kit.Cyl(f, 1.6, 0.3, CFrame.new(x + 3, 4.4, 626), C(70, 60, 80))
		Kit.Ball(f, 1.3, V(x + 3, 5.4, 626), C(150, 255, 140), { Mat = NEON })
	end
	local rng = Kit.Rng
	for _ = 1, 7 do
		Props.FloatingBook(f, V(rng:NextNumber(-90, -26), rng:NextNumber(6, 11), rng:NextNumber(608, 644)))
	end
	Props.Graffiti(f, V(-82, 11, 647.9), 16, 5, 0, -1, "SHHH!\nGHOSTS READING", C(150, 255, 140), -3)
end

local function cafeteria(f: Instance)
	-- counter + sneeze guard + menu
	Kit.Box(f, V(90, 0.15, 607), V(96, 4, 643), C(205, 205, 225), { Solid = true })
	local pans = { C(130, 255, 140), C(255, 160, 60), C(200, 120, 255), C(255, 110, 140) }
	for i = 0, 3 do
		Kit.Box(f, V(91, 4, 609 + i * 8.5), V(95, 4.5, 615 + i * 8.5), Kit.Vivid(pans[i + 1]))
	end
	Kit.Box(f, V(89.8, 4, 607), V(90.2, 7, 643), C(200, 240, 255), { Transp = 0.6 })
	local menuCF = faced(V(98.7, 11, 625), -1, 0)
	local menu = Kit.Part(f, V(26, 6, 0.4), menuCF, C(40, 30, 60))
	Kit.Part(f, V(27, 7, 0.2), menuCF * CFrame.new(0, 0, 0.3), Kit.Vivid(C(255, 160, 60)))
	Kit.Sign(menu, Enum.NormalId.Front, "TODAY: ECTO-LOAF\n& SCREAM PIE", C(150, 255, 140))
	-- long tables with benches and trays
	local trays = { C(255, 120, 170), C(90, 210, 230), C(255, 210, 90), C(170, 120, 255) }
	for _, x in { 35, 55, 75 } do
		Kit.Box(f, V(x - 2.5, 3, 610), V(x + 2.5, 3.6, 640), C(240, 240, 250), { Solid = true })
		Kit.Box(f, V(x - 0.5, 0.15, 612), V(x + 0.5, 3, 638), C(130, 130, 160))
		for _, s in { -1, 1 } do
			Kit.Box(f, V(x + s * 3.6, 0.15, 611), V(x + s * 5, 2, 639), C(170, 110, 230), { Solid = true })
		end
		for i = 0, 3 do
			local s = if i % 2 == 0 then -1 else 1
			local tz = 614 + i * 7
			Kit.Box(f, V(x + s * 0.3, 3.6, tz - 0.8), V(x + s * 2.2, 3.85, tz + 0.8), trays[i + 1])
			Kit.Ball(f, 0.9, V(x + s * 1.25, 4.2, tz), Kit.Vivid(Kit.Pick(pans)))
		end
	end
	Props.Graffiti(f, V(35, 11, 647.9), 16, 5, 0, -1, "FOOD FIGHT\nAT MIDNIGHT", C(255, 170, 220), 4)
	Props.FloatingPumpkin(f, V(45, 10, 628))
end

--==================================================================
-- CLASSROOMS
--==================================================================
local function classroom(f: Instance, side: number, title: string, graffiti: string)
	-- side = -1 (west, Class 1-A) or +1 (east, Class 1-B); board on the outer wall
	local gx, gz, gr = side * 62, 690, 20
	local boardCF = faced(V(side * 98.7, 8.5, 705), -side, 0)
	local board = Kit.Part(f, V(30, 8, 0.4), boardCF, C(40, 95, 75))
	Kit.Part(f, V(31.6, 9.6, 0.3), boardCF * CFrame.new(0, 0, 0.3), C(150, 100, 60), { Mat = Enum.Material.WoodPlanks })
	Kit.Sign(board, Enum.NormalId.Front, title, C(235, 255, 235), { Stroke = C(30, 70, 55), Font = Enum.Font.FredokaOne })
	-- teacher's desk + apple
	local tx = side * 90.5
	Kit.Box(f, V(tx - 2.5, 0.15, 698), V(tx + 2.5, 3.6, 710), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Ball(f, 1.2, V(tx, 4.2, 702), C(255, 70, 80))
	-- student desks (facing the board), kept out of the ghost circle and doorways
	local desk, chair = C(255, 210, 120), C(130, 90, 220)
	for ax = 91, 31, -12 do
		local x = side * ax
		for z = 656, 752, 12 do
			local dx, dz = x - gx, z - gz
			local inCircle = dx * dx + dz * dz < (gr + 4) * (gr + 4)
			local teacher = ax >= 85 and z >= 690 and z <= 716
			local gymDoor = z >= 736 and math.abs(ax - 60) < 9
			local divDoor = z <= 660 and math.abs(ax - 60) < 9
			local hallDoor = ax <= 31 and z >= 672 and z <= 708
			if not (inCircle or teacher or gymDoor or divDoor or hallDoor) then
				local back = side -- chairs sit on the side away from the board
				Kit.Box(f, V(x - 1.5, 3, z - 1.4), V(x + 1.5, 3.4, z + 1.4), desk, { Solid = true })
				Kit.Box(f, V(x + side * 1.5, 0.15, z - 1.2), V(x + side * 1.1, 3, z + 1.2), desk:Lerp(C(0, 0, 0), 0.2))
				Kit.Box(f, V(x - back * 2, 1.8, z - 1.1), V(x - back * 4.2, 2.1, z + 1.1), chair)
				Kit.Box(f, V(x - back * 4, 0.15, z - 1.1), V(x - back * 4.3, 4.4, z + 1.1), chair)
			end
		end
	end
	-- floating books near the back of the room
	local rng = Kit.Rng
	for i = 0, 3 do
		Props.FloatingBook(f, V(side * (36 + i * 14), rng:NextNumber(9, 12), 745 + rng:NextNumber(-4, 6)))
	end
	sconce(f, V(side * 98.4, 12.4, 740), -side, C(150, 255, 160))
	Props.Graffiti(f, V(side * 85, 11, 760.9), 18, 5, 0, -1, graffiti, C(200, 140, 255), side * 4)
	Kit.Disc(f, side * 40, 735, 0.22, 5, 0.08, C(200, 130, 255), { Mat = NEON, Transp = 0.2 })
end

--==================================================================
-- GYM
--==================================================================
local function gym(f: Instance)
	-- court lines (white paint) and the purple centre circle
	local line = C(255, 250, 240)
	Kit.Box(f, V(-0.3, 0.15, 765), V(0.3, 0.2, 857), line)
	for _, x in { -92, 92 } do
		Kit.Box(f, V(x - 0.3, 0.15, 768), V(x + 0.3, 0.2, 840), line)
	end
	for _, z in { 768, 840 } do
		Kit.Box(f, V(-92, 0.15, z - 0.3), V(92, 0.2, z + 0.3), line)
	end
	local circle = Kit.Vivid(C(200, 130, 255))
	for i = 0, 15 do
		local a = (i + 0.5) / 16 * math.pi * 2
		local p = V(math.cos(a) * 10, 0.17, 805 + math.sin(a) * 10)
		Kit.Part(f, V(0.6, 0.06, 4.4), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), circle)
	end
	-- hoops on the side walls
	local hoop = Kit.Vivid(C(255, 120, 60))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 97.4, 9.5, 800.5), V(s * 97.9, 14.5, 809.5), WHITE)
		Kit.Box(f, V(s * 97.3, 10.6, 803.5), V(s * 97.4, 13, 806.5), hoop)
		Kit.Box(f, V(s * 97.9, 11.4, 804.6), V(s * 99, 12.2, 805.4), C(80, 80, 100))
		Kit.Disc(f, s * 95.4, 805, 10.3, 3.6, 0.3, hoop)
		Kit.Cyl(f, 2, 3.2, CFrame.new(s * 95.4, 9.1, 805), WHITE, { Transp = 0.5 })
	end
	-- bleachers along the back wall, split either side of the back exit (X -15..15 open)
	local cols = { C(95, 135, 205), C(235, 150, 70), C(240, 225, 195), C(150, 100, 220) }
	for i = 0, 3 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 15, 0.15, 842 + i * 4), V(s * 60, 1.6 * (i + 1) + 0.15, 859), cols[i + 1], { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		end
	end
	for k, px in { -50, -36, -22, 22, 36, 50 } do
		local i = (k - 1) % 4
		Props.Pumpkin(f, V(px, 1.6 * (i + 1) + 0.15, 844 + i * 4), 2.6, 0, -1)
	end
	-- back exit: cream door frame, EXIT sign on the lintel, path to Gate_Carnival
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 14 - 0.6, 0, 858.6), V(s * 14 + 0.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	end
	Kit.Box(f, V(-14.6, 12, 858.6), V(14.6, 12.6, 861.4), CREAM, { Mat = Enum.Material.Concrete })
	local exitSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 858.7), C(30, 60, 45))
	Kit.Part(f, V(25, 3.6, 0.2), CFrame.new(0, 14.2, 858.95), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(exitSign, Enum.NormalId.Front, "EXIT → CARNIVAL 🎡", C(170, 255, 160), { Stroke = C(20, 50, 30) })
	local backSign = Kit.Part(f, V(24, 3, 0.4), CFrame.new(0, 14.2, 861.3) * CFrame.Angles(0, math.pi, 0), C(30, 60, 45))
	Kit.Sign(backSign, Enum.NormalId.Front, "SPOOKY HIGH 🏫", C(255, 220, 120), { Stroke = C(20, 50, 30) })
	Kit.Box(f, V(-12, 0, 861), V(12, 0.05, 877), C(175, 165, 190), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "ExitPath" })
	local guide = Kit.Vivid(C(150, 255, 140))
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12 - 0.3, 0.05, 862), V(s * 12 + 0.3, 0.1, 876), guide)
	end
	Props.Pumpkin(f, V(-15.5, 0, 865), 2.6, 1, 0)
	Props.Pumpkin(f, V(15.5, 0, 865), 2.6, -1, 0)
	-- scoreboard (on the back wall over the west bleachers)
	local sbCF = CFrame.new(-40, 12.5, 858.5)
	local sb = Kit.Part(f, V(26, 6, 0.6), sbCF, C(30, 20, 50))
	Kit.Part(f, V(27.4, 7.4, 0.3), sbCF * CFrame.new(0, 0, 0.35), Kit.Vivid(C(150, 255, 140)))
	Kit.Sign(sb, Enum.NormalId.Front, "HOME 0  •  GHOSTS 999", C(255, 210, 80), { Font = Enum.Font.GothamBlack })
	-- banners
	Props.SignBoard(f, V(-98.6, 10, 780), 14, 5, 1, 0, "GO GHOULS!", C(130, 70, 220), C(255, 220, 90))
	Props.SignBoard(f, V(-98.6, 10, 830), 14, 5, 1, 0, "TEAM SPIRIT\n(LITERALLY)", C(255, 120, 60), WHITE)
	Props.SignBoard(f, V(98.6, 10, 780), 14, 5, -1, 0, "SPIRIT WEEK", C(60, 170, 150), WHITE)
	Props.SignBoard(f, V(98.6, 10, 830), 14, 5, -1, 0, "BOO CREW", C(220, 70, 140), C(255, 230, 120))
	Props.Graffiti(f, V(-80, 11, 763.1), 18, 5, 0, 1, "DETENTION\nFOREVER", C(150, 255, 140), -4)
	sconce(f, V(-98.4, 13.5, 792), 1, C(255, 200, 120))
	sconce(f, V(98.4, 13.5, 818), -1, C(255, 200, 120))
	Props.FloatingPumpkin(f, V(-30, 13, 850))
	Props.FloatingPumpkin(f, V(30, 13, 850))
end

--==================================================================
-- COURTYARD
--==================================================================
local function courtyard(f: Instance)
	Kit.Box(f, V(-10, -0.4, 540), V(10, 0.1, 592), C(190, 175, 215), { Mat = Enum.Material.Cobblestone, Solid = true })
	Kit.AddRect(-12, 540, 12, 600, true)
	Kit.AddRect(-104, 592, 104, 864)
	Kit.AddRect(-18, 860, 18, 880, true) -- back exit path to Gate_Carnival
	-- ghost bus
	local yellow = C(255, 205, 50)
	Kit.Box(f, V(55, 1.5, 566), V(85, 10.5, 578), yellow, SOLID)
	Kit.Box(f, V(55.5, 10.5, 566.5), V(84.5, 11.3, 577.5), C(255, 225, 120))
	Kit.Box(f, V(54.9, 5.5, 565.9), V(85.1, 6.1, 578.1), C(40, 30, 50))
	-- windows: warm pale yellow sides, glassy windshield (solid; too long to glow nicely)
	for _, z in { 565.8, 578.0 } do
		Kit.Box(f, V(58, 6.8, z), V(82, 9.6, z + 0.2), C(255, 240, 160), { Refl = 0.15 })
	end
	Kit.Box(f, V(54.8, 6.5, 567), V(55, 9.8, 577), Kit.Vivid(C(170, 230, 255)), { Transp = 0.2, Refl = 0.25 })
	for _, x in { 60, 80 } do
		for _, z in { 565.6, 578.4 } do
			Kit.CylFlat(f, 1.4, 4, V(x, 2, z), "Z", C(40, 35, 55))
		end
	end
	for _, z in { 568, 576 } do
		Kit.Box(f, V(54.7, 3, z - 0.8), V(54.9, 4.2, z + 0.8), C(255, 250, 200), { Mat = NEON })
	end
	local busSign = Kit.Box(f, V(62, 2.2, 565.6), V(78, 5.2, 565.9), yellow)
	Kit.Sign(busSign, Enum.NormalId.Front, "SPOOKY HIGH 👻", C(60, 30, 90), { Stroke = C(255, 255, 255) })
	Kit.AddCircle(70, 572, 17)
	-- flagpole
	Kit.Cyl(f, 26, 0.6, CFrame.new(28, 13, 590), C(220, 220, 235))
	Kit.Ball(f, 1.2, V(28, 26.4, 590), C(255, 210, 80), { Refl = 0.3 })
	local flag = Kit.Box(f, V(28.3, 20, 589.9), V(37, 25, 590.1), C(150, 80, 230))
	Kit.Sign(flag, Enum.NormalId.Front, "👻", WHITE)
	Kit.AddCircle(28, 590, 2)
	-- jack-o'-lanterns lining the path
	for z = 548, 590, 14 do
		for _, s in { -1, 1 } do
			Props.Pumpkin(f, V(s * 12.5, 0, z), 2.8, -s, 0, true)
		end
	end
	-- trees (courtyard and the strips around the building)
	local rng = Kit.Rng
	local trees = 0
	for _ = 1, 200 do
		if trees >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(546, 874)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(11, 16), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	local lampGlobe = C(210, 150, 255)
	Props.StreetLamp(f, V(-15, 0, 594), lampGlobe, true)
	Props.StreetLamp(f, V(15, 0, 594), lampGlobe, false)
end

function School.Build(map: Instance)
	local f = Kit.Folder(map, "School")
	courtyard(f)
	shell(f)
	clockTower(f)
	hallway(f)
	library(f)
	cafeteria(f)
	classroom(f, -1, "GHOST 101\nBOO = HELLO 👋", "NO HOMEWORK\nONLY HAUNTWORK")
	classroom(f, 1, "BOO-OLOGY\nCHAPTER 13 🕸️", "A+ IN\nSCARING")
	gym(f)
end

return School
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">SpiritRealm</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 8: Spirit Realm (Z 2280..2680), the endgame: "you have entered another dimension".
--   Play area (|X| <= 140): a dark translucent "void glass" floor (top Y = 0, no holes) with
--   flat-topped floating islands of dark slate (tops Y 0.04..0.06) sunk into it; their glowing
--   lips and rocky undersides show through the glass, with stars and nebula far below.
--   Rune path along X = 0 (flat, top 0.08) from the gate to the portal platform at the back.
--   Ghost areas (0,2365) r30, (-82,2400) r24, (75,2470) r26, (-62,2530) r24 and the boss
--   SPIRIT OVERLORD at (0,2605) r28 hold only flat paint; nothing stands in or hangs above them.
--   Side walls: crystal-capped rock ridges at X +-140..146 (Z 2283..2677).
--   Back (Z 2645..2677): a huge swirling portal, decorative "next destination" glimpse.
--   Outside the walls: open void with floating islands, spirit trees, crystals, waterfalls
--   pouring into nothing, broken bridges, distant islands, cloud banks and a ringed planet.
--   Glow: island lips, path edge runes, wall crystal tips, a few crystals, tree spirit-orbs,
--   portal runes and stars. Rock, ruins, trunks and most crystals are solid/glass.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local SpiritRealm = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local ROCK = Enum.Material.Rock
local SLATE = Enum.Material.Slate
local GLASS = Enum.Material.Glass
local WOOD = Enum.Material.Wood

local Z0, Z1 = 2280, 2680
local W = 146 -- outer face of the side walls

local ROCKS = { C(44, 38, 70), C(36, 34, 60), C(52, 44, 82), C(32, 36, 58) }
local LIPS = { C(150, 100, 255), C(80, 210, 255), C(110, 240, 190), C(120, 140, 255) }
local CRYSTAL = { C(160, 110, 255), C(90, 200, 255), C(120, 235, 200), C(195, 140, 255) }
local LEAVES = { C(80, 210, 255), C(160, 105, 255), C(110, 240, 200), C(130, 150, 255) }
local RUIN = C(82, 76, 112)
local RUIN_DARK = C(56, 50, 84)
local BARK = C(34, 28, 46)
local BLACK = C(0, 0, 0)

local function clearOfGhosts(x: number, z: number, r: number): boolean
	for _, a in Config.Layout.GhostAreas do
		local dx, dz = x - a.Center.X, z - a.Center.Z
		local rr = a.Radius + r
		if dx * dx + dz * dz < rr * rr then
			return false
		end
	end
	return true
end

--==================================================================
-- PIECES
--==================================================================

-- Floating island: flat slate top at topY, a glowing lip just under the top edge and a
-- rocky underside tapering into the void.
local function island(f: Instance, x: number, z: number, topY: number, d: number, solid: boolean, lip: boolean): Part
	local rock = Kit.Pick(ROCKS)
	local top = Kit.Disc(f, x, z, topY, d, 3, rock, { Mat = SLATE, Solid = solid, Shadow = true })
	if lip then
		Kit.Disc(f, x, z, topY - 0.5, d + 1.6, 0.8, Kit.Pick(LIPS), { Mat = NEON })
	end
	local under = rock:Lerp(BLACK, 0.2)
	Kit.Disc(f, x, z, topY - 3, d * 0.84, 5, under, { Mat = ROCK })
	Kit.Disc(f, x + d * 0.04, z, topY - 8, d * 0.58, 7, under:Lerp(BLACK, 0.2), { Mat = ROCK })
	Kit.Disc(f, x - d * 0.03, z + d * 0.03, topY - 15, d * 0.3, 9, under:Lerp(BLACK, 0.35), { Mat = ROCK })
	Kit.Ball(f, d * 0.17, V(x, topY - 23, z), under:Lerp(BLACK, 0.45), { Mat = ROCK })
	return top
end

-- Crystal prism with a diamond tip, leaning by (tiltX, tiltZ). Neon only when asked;
-- otherwise translucent glass in a vivid colour.
local function shard(parent: Instance, base: Vector3, h: number, w: number, tiltX: number, tiltZ: number, color: Color3, neon: boolean): Part
	local cf = CFrame.new(base) * CFrame.Angles(tiltX, 0, tiltZ) * CFrame.Angles(0, Kit.Rng:NextNumber(0, math.pi), 0)
	local opts: Kit.Opts = if neon then { Mat = NEON } else { Mat = GLASS, Transp = 0.2, Refl = 0.2 }
	local col = if neon then color else Kit.Vivid(color)
	local body = Kit.Part(parent, V(w, h, w), cf * CFrame.new(0, h / 2, 0), col, opts)
	Kit.Part(parent, V(w * 0.72, w * 0.72, w * 0.72), cf * CFrame.new(0, h, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), col, opts)
	return body
end

-- Cluster of crystals on a dark rock base; returns the big central crystal.
local function crystalCluster(parent: Instance, pos: Vector3, scale: number, neonMain: boolean): Part
	local rng = Kit.Rng
	local col = Kit.Pick(CRYSTAL)
	Kit.Part(parent, V(5, 2.2, 4.4) * scale, CFrame.new(pos + V(0, 0.5 * scale, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0.12), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
	local main = shard(parent, pos, 12 * scale, 2.6 * scale, rng:NextNumber(-0.1, 0.1), rng:NextNumber(-0.1, 0.1), col, neonMain)
	for k = 1, 3 do
		local a = k * 2.1 + rng:NextNumber(-0.3, 0.3)
		local t = rng:NextNumber(0.25, 0.45)
		local p = pos + V(math.cos(a), 0, math.sin(a)) * (1.7 * scale)
		shard(parent, p, rng:NextNumber(4.5, 8) * scale, rng:NextNumber(1.2, 1.8) * scale, math.sin(a) * t, -math.cos(a) * t, Kit.Pick(CRYSTAL), false)
	end
	return main
end

-- Enormous spirit tree: twisted dark trunk, roots, four branches with glowing leaf clusters
-- (solid translucent colour) and one small Neon spirit-orb. Returns the orb.
local function spiritTree(parent: Instance, pos: Vector3, height: number): Part
	local rng = Kit.Rng
	local pts = { pos }
	local seg = height / 4
	for i = 1, 4 do
		local sway = (if i % 2 == 0 then -1 else 1) * rng:NextNumber(1, 2.5)
		table.insert(pts, pts[i] + V(sway, seg, rng:NextNumber(-1.5, 1.5)))
	end
	for i = 1, 4 do
		local w = 4.6 - i * 0.85
		Props.Beam(parent, pts[i], pts[i + 1], w, w, BARK, { Mat = WOOD, Solid = i == 1, Shadow = true })
	end
	for r = 0, 2 do
		local a = r * 2.1 + rng:NextNumber(-0.3, 0.3)
		Props.Beam(parent, pos + V(0, 2.6, 0), pos + V(math.cos(a) * 5.5, -0.3, math.sin(a) * 5.5), 1.4, 1.4, BARK, { Mat = WOOD })
	end
	local s = height / 40
	local top = pts[5]
	local crown = Kit.Pick(LEAVES)
	Kit.Ball(parent, 12 * s, top + V(0, 1.5, 0), Kit.Vivid(crown), { Transp = 0.12, Shadow = true })
	for b = 1, 4 do
		local from = pts[3 + (b % 2)]
		local ang = b * 1.57 + rng:NextNumber(-0.4, 0.4)
		local len = height * rng:NextNumber(0.2, 0.28)
		local tip = from + V(math.cos(ang) * len, len * 0.5, math.sin(ang) * len)
		Props.Beam(parent, from, tip, 1.2, 1.2, BARK, { Mat = WOOD })
		Kit.Ball(parent, rng:NextNumber(7, 9.5) * s, tip, Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.15 })
	end
	local orb = Kit.Ball(parent, 3.2 * s, top + V(0, -4.5 * s, 0), crown:Lerp(C(255, 255, 255), 0.3), { Mat = NEON })
	return orb
end

-- Falling water pouring off an edge into the void: a translucent sheet facing X plus a paler
-- core streak and a misty lip.
local function waterfall(parent: Instance, top: Vector3, width: number, len: number, mist: boolean)
	local cf = CFrame.new(top - V(0, len / 2, 0))
	Kit.Part(parent, V(1.2, len, width), cf, C(110, 180, 255), { Mat = GLASS, Transp = 0.45, Refl = 0.1, Name = "Waterfall" })
	Kit.Part(parent, V(1.6, len, width * 0.4), cf, C(205, 235, 255), { Transp = 0.6 })
	local lip = Kit.Part(parent, V(3, 0.8, width + 1), CFrame.new(top + V(0, 0.2, 0)), C(170, 220, 255), { Transp = 0.35 })
	if mist then
		Kit.Emitter(lip, C(190, 225, 255), 4, 7, 1.2)
	end
end

local function brokenColumn(parent: Instance, x: number, z: number)
	local rng = Kit.Rng
	Kit.Box(parent, V(x - 2.2, 0, z - 2.2), V(x + 2.2, 1.2, z + 2.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	local h = rng:NextNumber(4, 17)
	Kit.Cyl(parent, h, 3, CFrame.new(x, 1.2 + h / 2, z), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
	if h > 13 then
		Kit.Box(parent, V(x - 2.2, 1.2 + h, z - 2.2), V(x + 2.2, 2.6 + h, z + 2.2), RUIN_DARK, { Mat = SLATE })
	else
		Kit.Part(parent, V(2.4, 1.4, 2.4), CFrame.new(x, 1.6 + h, z) * CFrame.Angles(0.35, rng:NextNumber(0, 3), 0.25), RUIN, { Mat = SLATE })
		if rng:NextNumber() < 0.5 then
			Kit.CylFlat(parent, 4, 3, V(x + 2.2, 1.5, z + 2.4), "X", RUIN, { Mat = SLATE, Solid = true })
		end
	end
end

local function brokenArch(parent: Instance, x: number, z: number, yaw: number)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0)
	local o: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }
	Kit.Part(parent, V(3, 18, 3), base * CFrame.new(-7, 9, 0), RUIN, o)
	Kit.Part(parent, V(3, 11, 3), base * CFrame.new(7, 5.5, 0), RUIN, o)
	Kit.Part(parent, V(3, 2, 3), base * CFrame.new(7, 11.6, 0) * CFrame.Angles(0, 0, 0.4), RUIN_DARK, { Mat = SLATE })
	Kit.Part(parent, V(10, 3, 3.2), base * CFrame.new(-3.2, 19.3, 0) * CFrame.Angles(0, 0, -0.08), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Part(parent, V(6, 3, 3), base * CFrame.new(9.5, 1.3, 5) * CFrame.Angles(0.25, 0.6, 0.1), RUIN_DARK, o)
	-- faint rune carved on the standing pillar
	Kit.Part(parent, V(1.2, 1.2, 0.2), base * CFrame.new(-7, 12, -1.55) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(C(120, 220, 255)))
	Kit.AddCircle(x, z, 10)
end

local function temple(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "AncientTemple")
	Kit.Box(m, V(x - 13, 0, z - 11), V(x + 13, 0.9, z + 11), RUIN_DARK, { Mat = SLATE, Solid = true })
	Kit.Box(m, V(x - 10, 0.9, z - 8), V(x + 10, 1.8, z + 8), RUIN, { Mat = SLATE, Solid = true })
	local rng = Kit.Rng
	for _, cx in { -8, 8 } do
		for _, cz in { -6, 0, 6 } do
			local intact = cz >= 0
			local h = if intact then 14 else rng:NextNumber(4, 9)
			Kit.Cyl(m, h, 2.6, CFrame.new(x + cx, 1.8 + h / 2, z + cz), RUIN, { Mat = SLATE, Solid = true, Shadow = true })
		end
	end
	Kit.Box(m, V(x - 9.6, 15.8, z - 1.6), V(x + 9.6, 17.4, z + 7.6), RUIN_DARK, { Mat = SLATE, Shadow = true })
	Kit.Wedge(m, V(19.2, 4, 4.6), CFrame.new(x, 19.4, z + 5.3) * CFrame.Angles(0, math.pi, 0), RUIN_DARK, { Mat = SLATE })
	Kit.Part(m, V(9, 1.6, 4), CFrame.new(x + 3, 2.4, z - 9) * CFrame.Angles(0.15, 0.4, -0.2), RUIN_DARK, { Mat = SLATE, Solid = true })
	-- altar with a spirit flame
	Kit.Box(m, V(x - 1.6, 1.8, z - 4.6), V(x + 1.6, 4.4, z - 1.4), C(70, 62, 102), { Mat = SLATE, Solid = true })
	local flame = Kit.Ball(m, 1.8, V(x, 5.3, z - 3), C(140, 255, 210), { Mat = NEON })
	Kit.Light(flame, C(140, 255, 210), 26, 1.6, true)
	Kit.AddCircle(x, z, 15)
end

local function monolithRing(parent: Instance, mx: number, mz: number)
	local rng = Kit.Rng
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local p = V(mx + math.cos(a) * 9, 0, mz + math.sin(a) * 9)
		local h = rng:NextNumber(7, 12)
		local cf = CFrame.new(p) * CFrame.Angles(0, Kit.FaceYaw(mx - p.X, mz - p.Z), 0) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
		Kit.Part(parent, V(2.8, h, 1.8), cf * CFrame.new(0, h / 2 - 0.3, 0), RUIN_DARK, { Mat = SLATE, Solid = true, Shadow = true })
	end
	Kit.Disc(parent, mx, mz, 0.1, 9, 0.06, Kit.Vivid(C(150, 100, 255)))
	Kit.Disc(parent, mx, mz, 0.13, 3.2, 0.06, C(150, 240, 255), { Mat = NEON })
	Kit.AddCircle(mx, mz, 12)
end

-- Flat ring of paint segments.
local function paintRing(parent: Instance, cx: number, cz: number, r: number, n: number, w: number, color: Color3, topY: number)
	local segLen = 2 * math.pi * r / n + 0.3
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V(cx + math.cos(a) * r, topY - 0.03, cz + math.sin(a) * r)
		Kit.Part(parent, V(w, 0.06, segLen), CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), color)
	end
end

--==================================================================
-- SECTIONS
--==================================================================
local function ground(f: Instance)
	-- void glass: walkable everywhere in the play area, dark and see-through
	Kit.Box(f, V(-W, -1, Z0), V(W, 0, Z1), C(16, 12, 34), { Solid = true, Transp = 0.3, Refl = 0.15, Name = "VoidGlass" })
	-- islands sunk into the glass (tops alternate 0.04 / 0.06 so overlaps never flicker)
	local islands = {
		{ 0, 2320, 92, 0.04 }, { 6, 2382, 70, 0.06 }, { -82, 2400, 66, 0.06 }, { 92, 2352, 46, 0.04 },
		{ 75, 2470, 70, 0.04 }, { -20, 2462, 40, 0.06 }, { -62, 2530, 66, 0.04 }, { 60, 2562, 42, 0.04 },
		{ 0, 2605, 90, 0.06 }, { -106, 2612, 36, 0.04 }, { 102, 2640, 34, 0.04 }, { -108, 2322, 40, 0.06 },
		{ 0, 2658, 60, 0.04 },
	}
	for _, i in islands do
		island(f, i[1], i[2], i[4], i[3], true, true)
	end
	-- starfield and nebula far below the glass
	local rng = Kit.Rng
	for _ = 1, 12 do
		Kit.Ball(f, rng:NextNumber(0.6, 1.4), V(rng:NextNumber(-135, 135), rng:NextNumber(-110, -35), rng:NextNumber(Z0 + 10, Z1 - 10)), Kit.Pick({ C(220, 230, 255), C(180, 150, 255), C(150, 240, 255) }), { Mat = NEON })
	end
	local nebula = { V(-180, -200, 2400), V(200, -230, 2560), V(0, -260, 2480) }
	local nebulaCol = { C(90, 50, 160), C(40, 80, 160), C(40, 120, 130) }
	for k, n in nebula do
		Kit.Disc(f, n.X, n.Z, n.Y, 520, 2, nebulaCol[k], { Transp = 0.55 })
	end
end

local function runePath(f: Instance)
	local z2 = 2648
	Kit.Box(f, V(-5, 0.02, Z0 + 3), V(5, 0.08, z2), C(40, 36, 68), { Mat = SLATE, Solid = true, Name = "RunePath" })
	local edge = C(120, 210, 255)
	for z = Z0 + 10, z2 - 14, 28 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 5, 0.02, z), V(s * 5.6, 0.1, z + 14), edge, { Mat = NEON })
		end
	end
	local glyph = C(190, 140, 255)
	for z = Z0 + 30, z2 - 10, 48 do
		Kit.Part(f, V(1.8, 0.04, 1.8), CFrame.new(0, 0.1, z) * CFrame.Angles(0, math.pi / 4, 0), glyph, { Mat = NEON })
	end
	-- painted (solid) dashes between the glyphs
	local dash = Kit.Vivid(C(130, 110, 220))
	for z = Z0 + 54, z2 - 10, 48 do
		Kit.Box(f, V(-0.3, 0.08, z - 4), V(0.3, 0.1, z + 4), dash)
	end
end

local function bossRing(f: Instance)
	local cx, cz = 0, 2605
	paintRing(f, cx, cz, 31, 28, 1.2, Kit.Vivid(C(150, 100, 255)), 0.12)
	paintRing(f, cx, cz, 20, 20, 0.8, Kit.Vivid(C(90, 200, 255)), 0.12)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Kit.Disc(f, cx + math.cos(a) * 33, cz + math.sin(a) * 33, 0.14, 2.4, 0.06, C(170, 240, 255), { Mat = NEON })
	end
end

local function portal(f: Instance)
	local m = Kit.Model(f, "SpiritPortal")
	local cy, pz, R = 38, 2666, 32
	Kit.Box(m, V(-40, 0, 2648), V(40, 0.8, 2677), C(48, 42, 78), { Mat = SLATE, Solid = true })
	Kit.Box(m, V(-36, 0.8, 2654), V(36, 1.4, 2676), C(60, 52, 92), { Mat = SLATE, Solid = true })
	-- stone ring
	local n = 28
	local segLen = 2 * math.pi * R / n + 0.6
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local pos = V(math.cos(a) * R, cy + math.sin(a) * R, pz)
		Kit.Part(m, V(segLen, 4.5, 4), CFrame.new(pos) * CFrame.Angles(0, 0, a + math.pi / 2), if i % 2 == 0 then C(52, 44, 84) else C(40, 36, 66), { Mat = SLATE, Shadow = true })
		if i % 4 == 1 then
			Kit.Part(m, V(1.4, 1.4, 0.3), CFrame.new(pos.X, pos.Y, pz - 2.1) * CFrame.Angles(0, 0, math.pi / 4), C(150, 240, 255), { Mat = NEON })
		end
	end
	-- swirl: dark backing, two shimmering ForceField layers, pale core and two spiral arms
	Kit.CylFlat(m, 1, 62, V(0, cy, pz + 0.6), "Z", C(10, 6, 22))
	Kit.CylFlat(m, 0.3, 58, V(0, cy, pz - 0.4), "Z", C(160, 90, 255), { Mat = Enum.Material.ForceField, Transp = 0.2 })
	Kit.CylFlat(m, 0.3, 42, V(0, cy, pz - 0.8), "Z", C(80, 220, 255), { Mat = Enum.Material.ForceField, Transp = 0.25 })
	local core = Kit.CylFlat(m, 0.3, 18, V(0, cy, pz - 1.2), "Z", C(225, 210, 255), { Transp = 0.35 })
	local arms = { Kit.Vivid(C(170, 110, 255)), Kit.Vivid(C(100, 220, 255)) }
	for arm = 0, 1 do
		for i = 0, 8 do
			local ang = arm * math.pi + i * 0.7
			local r = 3 + i * 3
			local p = V(math.cos(ang) * r, cy + math.sin(ang) * r, pz - 1.6)
			Kit.Part(m, V(r * 0.7 + 1, 0.9, 0.3), CFrame.new(p) * CFrame.Angles(0, 0, ang + math.pi / 2), arms[arm + 1], { Transp = 0.15 })
		end
	end
	Kit.Light(core, C(190, 150, 255), 60, 2)
	Kit.Emitter(core, C(200, 160, 255), 5, 5, 2.5)
	-- supports from the platform to the ring
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16 - 2, 1.4, pz - 2), V(s * 16 + 2, 11, pz + 2), C(44, 38, 70), { Mat = ROCK, Solid = true, Shadow = true })
	end
	-- flanking obelisks with crystal tips
	for _, s in { -1, 1 } do
		local x = s * 43
		Kit.Box(m, V(x - 2.5, 0, 2657.5), V(x + 2.5, 2, 2662.5), RUIN_DARK, { Mat = SLATE, Solid = true })
		Kit.Box(m, V(x - 1.8, 2, 2658.2), V(x + 1.8, 28, 2661.8), C(48, 42, 78), { Mat = SLATE, Solid = true, Shadow = true })
		shard(m, V(x, 28, 2660), 6, 2.2, 0, 0, if s < 0 then C(170, 110, 255) else C(90, 220, 255), true)
	end
	-- two rocks drifting around the portal
	for _, s in { -1, 1 } do
		local rock = Kit.Part(m, V(6, 4.5, 5), CFrame.new(s * 52, 30 + s * 6, 2655) * CFrame.Angles(0.4, s * 0.7, 0.3), Kit.Pick(ROCKS), { Mat = ROCK, Name = "FloatingRock" })
		Kit.Float(rock, 1.6)
	end
	Kit.AddRect(-47, 2645, 47, 2678)
end

local function sideWalls(f: Instance)
	local rng = Kit.Rng
	local zA, zB = Z0 + 3, Z1 - 3
	local n = 10
	local len = (zB - zA) / n
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local z = zA + i * len
			local h = rng:NextNumber(8, 13)
			Kit.Box(f, V(s * 140, -26, z), V(s * W, h, z + len), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
			for k = 1, 2 do
				local cz = z + len * (k / 3) + rng:NextNumber(-3, 3)
				local lean = rng:NextNumber(0.1, 0.35)
				shard(f, V(s * 143, h - 0.5, cz), rng:NextNumber(5, 10), rng:NextNumber(1.6, 2.4), rng:NextNumber(-0.2, 0.2), -s * lean, Kit.Pick(CRYSTAL), k == 1 and i % 4 == 1)
			end
		end
	end
end

local function insideScenery(f: Instance)
	local rng = Kit.Rng
	temple(f, 105, 2545)
	if Kit.IsFree(-104, 2345, 12) then
		monolithRing(f, -104, 2345)
	end
	-- broken arches beside the path
	local arches = { { -45, 2330, 0.3 }, { 48, 2412, -0.4 }, { -28, 2495, 0.2 }, { 40, 2525, -0.2 }, { -100, 2478, 1.2 } }
	local placed = 0
	for _, a in arches do
		if placed < 3 and Kit.IsFree(a[1], a[2], 10) then
			placed += 1
			brokenArch(f, a[1], a[2], a[3])
		end
	end
	-- entry pylons flanking the path just past the gate
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 13, 2318, 3, true) then
			local c = crystalCluster(f, V(s * 13, 0, 2318), 0.9, s > 0)
			if s > 0 then
				Kit.Light(c, C(120, 230, 255), 30, 1.5)
			else
				Kit.Emitter(c, C(170, 140, 255), 2, 2.5, 0.8)
			end
			Kit.AddCircle(s * 13, 2318, 4)
		end
	end
	-- enormous spirit trees along the edges (crowns kept clear of the ghost areas)
	local trees = { { -120, 2296, 42 }, { 120, 2298, 38 }, { -122, 2445, 44 }, { 124, 2395, 40 }, { 122, 2600, 42 }, { -124, 2566, 38 }, { 118, 2510, 34 } }
	local lit = 0
	for _, t in trees do
		if Kit.IsFree(t[1], t[2], 5) and clearOfGhosts(t[1], t[2], 19) then
			local orb = spiritTree(f, V(t[1], 0, t[2]), t[3])
			lit += 1
			if lit <= 2 then
				Kit.Light(orb, orb.Color, 28, 1.3)
			end
			Kit.AddCircle(t[1], t[2], 6)
		end
	end
	-- giant spectral crystal clusters
	local clusters, lights = 0, 0
	for _ = 1, 300 do
		if clusters >= 9 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 45)
		if math.abs(x) > 14 and Kit.IsFree(x, z, 6) then
			clusters += 1
			local neon = clusters % 2 == 1
			local main = crystalCluster(f, V(x, 0, z), rng:NextNumber(0.9, 1.4), neon)
			if neon and lights < 3 then
				lights += 1
				Kit.Light(main, main.Color, 26, 1.4)
			end
			Kit.AddCircle(x, z, 6)
		end
	end
	-- broken colonnade lining the path
	for z = Z0 + 46, 2640, 30 do
		for _, s in { -1, 1 } do
			local x = s * rng:NextNumber(17, 24)
			if Kit.IsFree(x, z, 5) then
				brokenColumn(f, x, z)
				Kit.AddCircle(x, z, 4)
			end
		end
	end
	-- loose boulders
	local boulders = 0
	for _ = 1, 200 do
		if boulders >= 14 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 40)
		if Kit.IsFree(x, z, 3) then
			boulders += 1
			local sz = V(rng:NextNumber(2, 4.5), rng:NextNumber(1.5, 3), rng:NextNumber(2, 4.5))
			Kit.Part(f, sz, CFrame.new(x, sz.Y * 0.35, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Kit.Pick(ROCKS), { Mat = ROCK, Solid = true, Shadow = true })
			Kit.AddCircle(x, z, 3)
		end
	end
	-- floating ruin pieces and crystals (never over a ghost area)
	local floats = 0
	for _ = 1, 300 do
		if floats >= 8 then
			break
		end
		local x, z = rng:NextNumber(-125, 125), rng:NextNumber(Z0 + 40, Z1 - 50)
		if math.abs(x) > 12 and Kit.IsFree(x, z, 6) then
			floats += 1
			local y = rng:NextNumber(9, 18)
			local cf = CFrame.new(x, y, z) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5))
			local p: Part
			if floats <= 2 then
				p = Kit.Part(f, V(1.8, 6, 1.8), cf, Kit.Vivid(Kit.Pick(CRYSTAL)), { Mat = GLASS, Transp = 0.15, Refl = 0.2, Name = "FloatingCrystal" })
			elseif floats % 2 == 0 then
				p = Kit.Part(f, V(3, 5, 3), cf, RUIN, { Mat = SLATE, Shape = Enum.PartType.Cylinder, Name = "FloatingColumn" })
			else
				p = Kit.Part(f, V(4, 2.4, 3), cf, RUIN_DARK, { Mat = SLATE, Name = "FloatingBlock" })
			end
			Kit.Float(p, rng:NextNumber(0.8, 1.6))
		end
	end
end

local function outsideScenery(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Void")
	-- floating islands just beyond the walls: { x, z, topY, d, content, waterfall? }
	type Outer = { x: number, z: number, y: number, d: number, kind: string, falls: boolean }
	local outer: { Outer } = {
		{ x = -186, z = 2322, y = 6, d = 44, kind = "tree", falls = true },
		{ x = -206, z = 2420, y = -2, d = 52, kind = "crystal", falls = false },
		{ x = -182, z = 2522, y = 10, d = 36, kind = "ruin", falls = true },
		{ x = -214, z = 2622, y = 2, d = 50, kind = "tree", falls = false },
		{ x = 190, z = 2342, y = 2, d = 50, kind = "crystal", falls = true },
		{ x = 182, z = 2450, y = 12, d = 34, kind = "tree", falls = false },
		{ x = 210, z = 2552, y = -4, d = 56, kind = "ruin", falls = true },
		{ x = 188, z = 2652, y = 8, d = 40, kind = "crystal", falls = false },
	}
	local mist = false
	local litOuter = false
	for _, i in outer do
		island(o, i.x, i.z, i.y, i.d, false, true)
		local top = V(i.x, i.y, i.z)
		if i.kind == "tree" then
			spiritTree(o, top, rng:NextNumber(30, 40))
		elseif i.kind == "crystal" then
			local c = crystalCluster(o, top, 1.8, not litOuter)
			if not litOuter then
				litOuter = true
				Kit.Light(c, c.Color, 40, 1.6)
			end
			crystalCluster(o, top + V(i.d * 0.25, 0, i.d * 0.2), 0.9, false)
		else
			for k = 0, 2 do
				local h = 8 + k * 4
				Kit.Cyl(o, h, 3.2, CFrame.new(i.x - 8 + k * 8, i.y + h / 2, i.z - 6 + k * 3), RUIN, { Mat = SLATE })
			end
			Kit.Part(o, V(14, 2.4, 3.4), CFrame.new(i.x, i.y + 17, i.z) * CFrame.Angles(0, 0.3, 0.2), RUIN_DARK, { Mat = SLATE })
		end
		if i.falls then
			local s = if i.x < 0 then -1 else 1
			-- pours off the island edge that faces the play area
			-- (offset in Z so it never lands on a bridge)
			waterfall(o, V(i.x - s * (i.d / 2 - 2), i.y, i.z + i.d * 0.22), rng:NextNumber(7, 10), 170, not mist)
			mist = true
		end
	end
	-- broken bridges from the walls to two islands
	local bridges = { { -1, 2322, 6, 186 - 22 }, { 1, 2450, 12, 182 - 17 } }
	for _, b in bridges do
		local s, z, y, reach = b[1], b[2], b[3], b[4]
		local slabs = math.floor((reach - W) / 4.5)
		for k = 0, slabs - 1 do
			if k ~= 2 then
				local x = s * (W + 2.25 + k * 4.5)
				local cf = CFrame.new(x, y - 0.6, z)
				if k == slabs - 1 then
					cf = CFrame.new(x, y - 4, z + 1) * CFrame.Angles(0.3, 0, s * 0.5)
				end
				Kit.Part(o, V(4.2, 1.2, 7), cf, RUIN, { Mat = SLATE })
				if k % 2 == 0 then
					Kit.Box(o, V(x - 0.4, y, z + 3), V(x + 0.4, y + 3.5, z + 3.8), RUIN_DARK, { Mat = SLATE })
				end
			end
		end
	end
	-- loose rocks hanging in the void
	for _ = 1, 12 do
		local s = if rng:NextNumber() < 0.5 then -1 else 1
		local sz = V(rng:NextNumber(4, 12), rng:NextNumber(3, 8), rng:NextNumber(4, 12))
		Kit.Part(o, sz, CFrame.new(s * rng:NextNumber(160, 290), rng:NextNumber(-30, 45), rng:NextNumber(Z0, Z1 + 40)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)), Kit.Pick(ROCKS), { Mat = ROCK })
	end
	-- distant islands (low detail silhouettes)
	local far = { { -340, 2330, 30, 120 }, { -410, 2520, 55, 150 }, { -330, 2690, 20, 100 }, { 350, 2300, 45, 130 }, { 420, 2480, 25, 150 }, { 340, 2660, 60, 110 } }
	for _, d in far do
		local x, z, y, dia = d[1], d[2], d[3], d[4]
		Kit.Disc(o, x, z, y, dia, 6, C(40, 34, 66), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 6, dia * 0.7, 12, C(30, 26, 50), { Mat = ROCK })
		Kit.Disc(o, x, z, y - 18, dia * 0.36, 18, C(22, 20, 40), { Mat = ROCK })
		Props.Beam(o, V(x, y, z), V(x + 4, y + 30, z), 4, 4, BARK, { Mat = WOOD })
		Kit.Ball(o, 22, V(x + 4, y + 34, z), Kit.Vivid(Kit.Pick(LEAVES)), { Transp = 0.25 })
	end
	-- the next destination beyond the portal
	Kit.Disc(o, 0, 2880, 34, 150, 6, C(46, 38, 80), { Mat = ROCK })
	Kit.Disc(o, 0, 2880, 28, 100, 14, C(32, 28, 56), { Mat = ROCK })
	Kit.Disc(o, 0, 2880, 14, 50, 20, C(24, 20, 42), { Mat = ROCK })
	shard(o, V(0, 34, 2880), 46, 7, 0, 0, C(170, 230, 255), true)
	-- cloud banks and a ringed planet in a strange sky
	local clouds = {
		{ -260, 2300, 90, 160 }, { -420, 2460, 130, 220 }, { -300, 2640, 110, 180 }, { 280, 2340, 120, 200 },
		{ 440, 2560, 95, 230 }, { 260, 2700, 140, 170 }, { 0, 2820, 120, 260 }, { -150, 2800, 80, 150 },
		{ 160, 2790, 70, 150 }, { 0, 2250, 170, 200 },
	}
	for i, c in clouds do
		local col = if i % 2 == 0 then C(120, 90, 200) else C(80, 120, 210)
		Kit.Cyl(o, rng:NextNumber(6, 12), c[4], CFrame.new(c[1], c[3], c[2]) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)), col, { Transp = 0.75 })
	end
	local planet = V(-520, 230, 2760)
	Kit.Ball(o, 220, planet, C(110, 80, 180), { Transp = 0.15 })
	Kit.Cyl(o, 1, 400, CFrame.new(planet) * CFrame.Angles(0.35, 0, 0.25), C(170, 150, 230), { Transp = 0.65 })
	Kit.Ball(o, 60, V(480, 190, 2480), C(150, 220, 235), { Transp = 0.1 })
end

function SpiritRealm.Build(map: Instance)
	local f = Kit.Folder(map, "SpiritRealm")
	ground(f)
	runePath(f)
	bossRing(f)
	portal(f)
	sideWalls(f)
	insideScenery(f)
	outsideScenery(f)
end

return SpiritRealm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[--!strict
-- Crate stations (workspace.Map.Stations.CrateStation_<id>) and the upgrade booth
-- (workspace.Map.Stations.UpgradeStation). Stations sit beside the main path (X = 0);
-- their PromptAnchor and the OddsBoard's Front face point toward the path.
-- Pads, frames and trims are solid candy colours; the glow is kept to the arch lamps, the
-- corner jack-o'-lanterns and a couple of gadget lights.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Stations = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WHITE = C(255, 255, 255)

local function anchors(m: Model, x: number, z: number, dir: number)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x, 4, z), WHITE, { Name = "DisplaySlot", Transp = 1 })
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })
end

local function pad(m: Model, x: number, z: number, color: Color3, trim: Color3): Part
	local ring = Kit.Vivid(trim)
	Kit.Disc(m, x, z, 0.6, 16.5, 0.6, ring)
	local p = Kit.Disc(m, x, z, 1, 14, 1, color, { Name = "Pad", Solid = true })
	Kit.Disc(m, x, z, 1.12, 9, 0.2, ring)
	Kit.Disc(m, x, z, 1.18, 6, 0.2, color:Lerp(WHITE, 0.3))
	return p
end

local function crateStation(folder: Instance, crate: Config.CrateDef, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1 -- toward the path
	local m = Kit.Model(folder, "CrateStation_" .. crate.Id)
	local padPart = pad(m, x, z, crate.Color, crate.Trim)
	anchors(m, x, z, dir)
	local trim = Kit.Vivid(crate.Trim)

	-- Odds board behind the pad, Front face toward the path.
	local yaw = Kit.FaceYaw(dir, 0)
	local boardCF = CFrame.new(x - dir * 9.5, 7, z) * CFrame.Angles(0, yaw, 0)
	Kit.Part(m, V(12, 9, 0.6), boardCF, C(35, 22, 60), { Name = "OddsBoard", Solid = true })
	Kit.Part(m, V(13.4, 10.4, 0.5), boardCF * CFrame.new(0, 0, 0.45), trim)
	Kit.Part(m, V(14.2, 1.8, 1.2), boardCF * CFrame.new(0, 5.6, 0.3), crate.Color)
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 2.6, 1), boardCF * CFrame.new(sx * 5, -5.8, 0.4), crate.Color:Lerp(C(0, 0, 0), 0.3), { Solid = true })
		Kit.Ball(m, 1.6, (boardCF * CFrame.new(sx * 7.1, 5.6, 0.3)).Position, trim)
	end

	-- Arch over the back half of the pad with the crate's name facing the path; the two
	-- orbs on top are its lamps (the beam carries the light).
	local ax = x - dir * 3
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(ax - 1.3, 0, z + sz * 9.5 - 1.3), V(ax + 1.3, 15, z + sz * 9.5 + 1.3), crate.Color, { Solid = true })
		Kit.Box(m, V(ax - 1.6, 0, z + sz * 9.5 - 1.6), V(ax + 1.6, 1.4, z + sz * 9.5 + 1.6), trim)
		Kit.Ball(m, 3, V(ax, 18.4, z + sz * 10.5), crate.Trim, { Mat = NEON })
	end
	local beam = Kit.Box(m, V(ax - 1.5, 15, z - 11.5), V(ax + 1.5, 17, z + 11.5), crate.Color:Lerp(WHITE, 0.15))
	Kit.Light(beam, crate.Trim, 18, 1.8)
	local signCF = CFrame.new(ax, 19, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(20, 4, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(21, 5, 0.4), signCF * CFrame.new(0, 0, 0.4), trim)
	Kit.Sign(sign, Enum.NormalId.Front, crate.Name, crate.Trim)

	-- glowing corner jack-o'-lanterns
	Props.Pumpkin(m, V(x + dir * 6, 0, z + 9), 2.8, dir, 0, true)
	Props.Pumpkin(m, V(x + dir * 6, 0, z - 9), 2.8, dir, 0, true)

	Kit.AddCircle(ax, z, 13)
	m.PrimaryPart = padPart
	return m
end

local function beginnerExtras(m: Model, x: number, z: number, crate: Config.CrateDef)
	-- Tall shimmering beacon so the first crate is obvious from spawn (ForceField: reads as a
	-- light pillar without a 70-stud neon tube blooming over everything).
	local beacon = Kit.Cyl(m, 70, 5, CFrame.new(x, 57, z), Kit.Vivid(crate.Trim), { Mat = Enum.Material.ForceField, Transp = 0.5, Name = "Beacon" })
	Kit.Emitter(beacon, crate.Trim, 3, 3, 2)
	Kit.Ball(m, 6, V(x, 22.5, z), Kit.Vivid(crate.Color), { Refl = 0.15 })
	-- World-space label sized in studs (BillboardGui scale = studs), so it shrinks with
	-- distance like the station instead of filling a phone screen; text capped for readability.
	local bb: BillboardGui = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(10, 2.5)
	bb.StudsOffsetWorldSpace = V(0, -24, 0)
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Parent = beacon
	local label = Kit.Label(bb, "🎁 OPEN CRATES! 🎁", C(255, 230, 90), { Stroke = C(120, 50, 10) })
	label.TextScaled = true
	local limit: UITextSizeConstraint = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 10
	limit.MaxTextSize = 36
	limit.Parent = label
end

local function upgradeStation(folder: Instance, pos: Vector3)
	local x, z = pos.X, pos.Z
	local dir = if x < 0 then 1 else -1
	local m = Kit.Model(folder, "UpgradeStation")
	local color, trim = C(80, 200, 255), C(255, 220, 80)
	local padPart = pad(m, x, z, color, trim)
	Kit.Part(m, V(1, 1, 1), CFrame.new(x + dir * 7, 3, z), WHITE, { Name = "PromptAnchor", Transp = 1 })

	local bx = x - dir * 9.5 -- workbench centre line
	local back = bx - dir * 3 -- back panel
	local yaw = Kit.FaceYaw(dir, 0)
	-- workbench
	Kit.Box(m, V(bx - 2, 0, z - 8), V(bx + 2, 3.6, z + 8), C(150, 95, 60), { Mat = Enum.Material.WoodPlanks, Solid = true })
	Kit.Box(m, V(bx - 2.4, 3.6, z - 8.4), V(bx + 2.4, 4.2, z + 8.4), C(90, 230, 255), { Solid = true })
	-- back panel + big sign
	Kit.Box(m, V(back - 0.6, 0, z - 10.5), V(back + 0.6, 17, z + 10.5), C(110, 70, 200), { Solid = true })
	local signCF = CFrame.new(back + dir * 0.9, 13.2, z) * CFrame.Angles(0, yaw, 0)
	local sign = Kit.Part(m, V(19, 5, 0.6), signCF, C(35, 22, 60))
	Kit.Part(m, V(20, 6, 0.3), signCF * CFrame.new(0, 0, 0.4), Kit.Vivid(trim))
	Kit.Sign(sign, Enum.NormalId.Front, "⚡ UPGRADES ⚡", trim)
	-- upgrade icons
	for i, upId in Config.UpgradeOrder do
		local up = Config.Upgrades[upId]
		local icf = CFrame.new(back + dir * 0.8, 7.8, z + (i - 2) * 6) * CFrame.Angles(0, yaw, 0)
		local icon = Kit.Part(m, V(4.4, 4.4, 0.4), icf, C(60, 40, 110))
		Kit.Part(m, V(5, 5, 0.3), icf * CFrame.new(0, 0, 0.3), Kit.Vivid(color))
		Kit.Sign(icon, Enum.NormalId.Front, up.Icon, WHITE)
	end
	-- gadgets on the bench (potion vials are solid candy colours; the orange status light glows)
	Kit.CylFlat(m, 4.5, 1.6, V(bx, 5, z - 4.5), "Z", C(255, 120, 200))
	Kit.CylFlat(m, 1.5, 0.8, V(bx, 5, z - 7.4), "Z", Kit.Vivid(C(140, 255, 160)))
	for i = 0, 1 do
		Kit.Cyl(m, 3.2, 1.6, CFrame.new(bx, 5.8, z + 1 + i * 2.2), Kit.Vivid(C(120, 255, 170)), { Transp = 0.15, Refl = 0.15 })
		Kit.Cyl(m, 0.5, 1.8, CFrame.new(bx, 7.6, z + 1 + i * 2.2), C(70, 70, 90))
	end
	Kit.CylFlat(m, 0.6, 3.2, V(bx, 5.9, z + 6), "X", C(255, 210, 70))
	Kit.Ball(m, 1.2, V(bx, 5.9, z + 6), C(255, 120, 60), { Mat = NEON })
	-- striped awning on posts
	local tilt = -dir * 0.22
	local stripes = { C(255, 140, 50), C(160, 90, 255) }
	for i = 0, 3 do
		local sz = z - 8.25 + i * 5.5
		Kit.Part(m, V(9, 0.5, 5.5), CFrame.new(bx - dir * 0.5, 17.2, sz) * CFrame.Angles(0, 0, tilt), stripes[(i % 2) + 1], { Shadow = true })
	end
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(bx + dir * 3.7 - 0.4, 0, z + sz * 10.5 - 0.4), V(bx + dir * 3.7 + 0.4, 16.3, z + sz * 10.5 + 0.4), C(70, 50, 110))
	end
	local bulb = Kit.Ball(m, 1.4, V(bx + dir * 2, 15, z), C(255, 240, 160), { Mat = NEON })
	Kit.Light(bulb, C(255, 220, 150), 18, 1.5)

	Kit.AddCircle(x - dir * 4, z, 14)
	m.PrimaryPart = padPart
end

function Stations.Build(map: Instance)
	local folder = Kit.Folder(map, "Stations")
	for id, pos in Kit.CrateStations(Config.Layout) do
		local crate = Config.Crates[id]
		if crate then
			local m = crateStation(folder, crate, pos)
			if id == "Beginner" then
				beginnerExtras(m, pos.X, pos.Z, crate)
			end
		end
	end
	upgradeStation(folder, Config.Layout.UpgradeStation)
end

return Stations
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="49">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="50">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">GHClient</string>
        </Properties>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- World liveliness + interactions:
--  * per-zone lighting blend (ambient + fog colour) as you walk between areas
--  * floating books/pumpkins (FloatingProp), flickering lights (FlickerLight), spinning
--    display crates (SpinProp) - one loop, only props near the camera are animated
--  * gates: open locally for zones you own, the NEW AREA UNLOCKED! sequence, sign text
--  * station prompts open the right panel
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local CratePanel = require(script.Parent.CratePanel)
local GatePanel = require(script.Parent.GatePanel)
local Reveal = require(script.Parent.Reveal)

local Ambience = {}

local player = Players.LocalPlayer
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end
local currentZone = 0
local unlocking: { [string]: boolean } = {}

type Prop = { Part: BasePart, Base: CFrame, Phase: number, Bob: number, Kind: string }
local props: { [BasePart]: Prop } = {}

local function addProp(inst: Instance, kind: string)
	if not inst:IsA("BasePart") or props[inst] then
		return
	end
	local bob = inst:GetAttribute("BobHeight")
	props[inst] = {
		Part = inst,
		Base = inst.CFrame,
		Phase = math.random() * 10,
		Bob = if type(bob) == "number" then bob else 0.6,
		Kind = kind,
	}
end

local flickers: { BasePart } = {}

local function blendZone(idx: number)
	local z = Config.Zones[idx]
	if not z then
		return
	end
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { Ambient = z.Ambient, OutdoorAmbient = z.Ambient:Lerp(Color3.new(1, 1, 1), 0.15) }):Play()
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		TweenService:Create(atmo, info, { Color = z.FogColor, Decay = z.FogColor:Lerp(Color3.new(0, 0, 0), 0.35) }):Play()
	end
end

local function gateParts(zoneId: string): (BasePart?, TextLabel?, ProximityPrompt?)
	local map = workspace:FindFirstChild("Map")
	local gates = map and map:FindFirstChild("Gates")
	local gate = gates and gates:FindFirstChild("Gate_" .. zoneId)
	if not gate then
		return nil, nil, nil
	end
	local barrier = gate:FindFirstChild("Barrier") :: BasePart?
	local sign = gate:FindFirstChild("Sign")
	local sg = sign and sign:FindFirstChildOfClass("SurfaceGui")
	local cost = sg and sg:FindFirstChild("CostLabel", true) :: TextLabel?
	local anchor = gate:FindFirstChild("PromptAnchor")
	local prompt = anchor and anchor:FindFirstChildOfClass("ProximityPrompt")
	return barrier, cost, prompt
end

local barrierOriginal: { [BasePart]: { Size: Vector3, CFrame: CFrame, Transparency: number } } = {}

local function applyGates()
	local d = State.Data
	if not d then
		return
	end
	for _, z in Config.Zones do
		if not Config.Layout.Gates[z.Id] or unlocking[z.Id] then
			continue
		end
		local barrier, cost, prompt = gateParts(z.Id)
		local owned = d.Zones[z.Id] == true
		if barrier then
			if not barrierOriginal[barrier] then
				barrierOriginal[barrier] = { Size = barrier.Size, CFrame = barrier.CFrame, Transparency = barrier.Transparency }
			end
			local o = barrierOriginal[barrier]
			barrier.CanCollide = not owned
			barrier.Transparency = if owned then 1 else o.Transparency
			if not owned then
				barrier.Size = o.Size
				barrier.CFrame = o.CFrame
			end
		end
		if cost then
			cost.Text = if owned then "✓ UNLOCKED" else "🔒 " .. Format.Short(z.Cost) .. " ECTOPLASM"
		end
		if prompt then
			prompt.Enabled = not owned
		end
	end
end

local function unlockSequence(zoneId: string)
	local zone = Config.ZoneById[zoneId]
	if not zone then
		return
	end
	unlocking[zoneId] = true
	local barrier, cost, prompt = gateParts(zoneId)
	Sound.Play("ZoneUnlock")
	Hud.Banner("NEW AREA UNLOCKED!", zone.Name .. "  •  NEW GHOSTS  •  NEW CRATE", zone.Accent)
	if prompt then
		prompt.Enabled = false
	end
	if cost then
		cost.Text = "✓ UNLOCKED"
	end
	-- camera emphasis: quick punch-in + shake
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = 58
		TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Back), { FieldOfView = 70 }):Play()
	end
	if barrier then
		barrier.CanCollide = false
		local cf = barrier.CFrame
		local size = barrier.Size
		barrier.Color = Color3.new(1, 1, 1)
		TweenService:Create(barrier, TweenInfo.new(0.25), { Color = zone.Accent }):Play()
		for i = -2, 2 do
			local p = cf.Position + cf.RightVector * (i * size.X / 5) + Vector3.new(0, -size.Y / 2 + 4, 0)
			Effects.Burst(p, { Color = zone.Accent, Color2 = Color3.new(1, 1, 1), Count = 30, Size = 1.4, Speed = 24, Life = 1 })
		end
		Effects.Ring(cf.Position - Vector3.new(0, size.Y / 2 - 0.3, 0), zone.Accent, 30, 0.9)
		task.wait(0.3)
		-- the force field drains into the ground
		TweenService:Create(barrier, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(size.X, 0.2, size.Z),
			CFrame = cf - Vector3.new(0, size.Y / 2, 0),
			Transparency = 1,
		}):Play()
		task.wait(1.2)
	end
	unlocking[zoneId] = nil
	applyGates()
end

local stepParts: { BasePart } = {}
local stepCfs: { CFrame } = {}

local function step()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	table.clear(stepParts)
	table.clear(stepCfs)
	local parts, cfs = stepParts, stepCfs
	for part, p in props do
		if (p.Base.Position - camPos).Magnitude > 160 then
			continue
		end
		local cf
		if p.Kind == "Spin" then
			cf = p.Base * CFrame.new(0, math.sin(t * 1.8 + p.Phase) * 0.4, 0) * CFrame.Angles(0, t * 0.9, 0)
		else
			cf = p.Base * CFrame.new(0, math.sin(t * 1.4 + p.Phase) * p.Bob, 0) * CFrame.Angles(math.sin(t * 0.9 + p.Phase) * 0.12, t * 0.35 + p.Phase, math.cos(t * 0.7 + p.Phase) * 0.1)
		end
		table.insert(parts, part)
		table.insert(cfs, cf)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ambience.Init() end

function Ambience.Start()
	for _, inst in CollectionService:GetTagged("FloatingProp") do
		addProp(inst, "Float")
	end
	CollectionService:GetInstanceAddedSignal("FloatingProp"):Connect(function(inst)
		addProp(inst, "Float")
	end)
	for _, inst in CollectionService:GetTagged("SpinProp") do
		addProp(inst, "Spin")
	end
	CollectionService:GetInstanceAddedSignal("SpinProp"):Connect(function(inst)
		addProp(inst, "Spin")
	end)
	for _, inst in CollectionService:GetTagged("FlickerLight") do
		if inst:IsA("BasePart") then
			table.insert(flickers, inst)
		end
	end
	-- flicker: every so often one light stutters
	task.spawn(function()
		while true do
			task.wait(0.15 + math.random() * 0.35)
			if #flickers > 0 then
				local part = flickers[math.random(1, #flickers)]
				local light = part:FindFirstChildWhichIsA("Light")
				if light then
					local base = part:GetAttribute("BaseTransparency")
					if type(base) ~= "number" then
						base = part.Transparency
						part:SetAttribute("BaseTransparency", base)
					end
					local n = math.random(1, 3)
					for _ = 1, n do
						light.Enabled = false
						part.Transparency = math.max(base :: number, 0.6)
						task.wait(0.04 + math.random() * 0.08)
						light.Enabled = true
						part.Transparency = base :: number
						task.wait(0.03 + math.random() * 0.06)
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)

	-- zone blend
	task.spawn(function()
		while true do
			task.wait(0.5)
			local cam = workspace.CurrentCamera
			if cam and not Reveal.IsPlaying() then
				local idx = Rules.ZoneIndexAt(cam.Focus.Position.Z, zoneRanges)
				if idx ~= currentZone then
					currentZone = idx
					blendZone(idx)
				end
			end
		end
	end)

	-- gates
	State.OnData(function()
		applyGates()
	end)
	State.OnFx("ZoneUnlocked", function(data: any)
		if type(data) == "table" and type(data.Zone) == "string" then
			unlockSequence(data.Zone)
		end
	end)

	-- prompts → panels
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player or Reveal.IsPlaying() then
			return
		end
		local crate = prompt:GetAttribute("Crate")
		local station = prompt:GetAttribute("Station")
		local zone = prompt:GetAttribute("Zone")
		if type(crate) == "string" then
			CratePanel.Open(crate)
		elseif station == "Upgrades" then
			Hud.Open("Upgrades")
		elseif type(zone) == "string" then
			GatePanel.Open(zone)
		end
	end)
	-- keep prompts out of the way while a menu is open
	Kit.PanelOpened:Connect(function(name)
		ProximityPromptService.Enabled = name == nil
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Boss</string>
              <string name="Source"><![CDATA[--!strict
-- GIANT POLTERGEIST event presentation: warning announcement + countdown, a beacon over the
-- arena, dramatic spawn (flash, rings, camera shake), a big boss Spirit bar with timer, and
-- defeat / escape banners. Rewards arrive as normal Ectoplasm drops (the shower).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Boss = {}

local player = Players.LocalPlayer
local frame: Frame
local fill: Frame
local spiritLabel: TextLabel
local timerLabel: TextLabel
local titleLabel: TextLabel
local goButton: TextButton
local beacon: Part? = nil
local state = "Idle"
local warnAt = 0
local endsAt = 0
local bossUid = 0
local arenaPos = Config.Layout.EventArena.Center
local dismissed = false -- the player closed the event bar for this event (a small pill reopens it)
local reopen: TextButton

local function setBeacon(on: boolean)
	if on and not beacon then
		local b = Instance.new("Part")
		b.Name = "BossBeacon"
		b.Shape = Enum.PartType.Cylinder
		b.Anchored = true
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CastShadow = false
		b.Material = Enum.Material.Neon
		b.Color = Color3.fromRGB(255, 120, 230)
		b.Transparency = 0.55
		b.Size = Vector3.new(220, 5, 5)
		b.CFrame = CFrame.new(arenaPos + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
		b.Parent = workspace
		beacon = b
		task.spawn(function()
			while beacon == b do
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.8 }):Play()
				task.wait(0.6)
				TweenService:Create(b, TweenInfo.new(0.6), { Transparency = 0.45 }):Play()
				task.wait(0.6)
			end
		end)
	elseif not on and beacon then
		beacon:Destroy()
		beacon = nil
	end
end

local function show(on: boolean)
	reopen.Visible = on and dismissed
	if on and dismissed then
		on = false
	end
	if on == frame.Visible then
		return
	end
	frame.Visible = true
	local sc = frame:FindFirstChildOfClass("UIScale") :: UIScale
	if on then
		sc.Scale = 0.4
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		Kit.Tween(sc, 0.2, { Scale = 0.4 })
		task.delay(0.2, function()
			frame.Visible = false
		end)
	end
end

local function nearArena(): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - arenaPos).Magnitude < 150
end

local function onBoss(data: any)
	if data.Pos then
		arenaPos = data.Pos
	end
	if data.State == "Warning" then
		state = "Warning"
		dismissed = false -- every new event shows its bar again
		warnAt = data.At or 0
		Hud.Announce("⚠️ GIANT POLTERGEIST INCOMING!", Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 200, 60))
		Sound.Play("BossAppear")
		setBeacon(true)
		titleLabel.Text = "⚠️ GIANT POLTERGEIST"
		fill.Size = UDim2.fromScale(1, 1)
		spiritLabel.Text = "APPEARS SOON!"
		goButton.Visible = not nearArena()
		show(true)
	elseif data.State == "Active" then
		state = "Active"
		bossUid = data.Uid or 0
		endsAt = data.EndsAt or 0
		titleLabel.Text = "👑 GIANT POLTERGEIST"
		setBeacon(true)
		Sound.Boss(true)
		show(true)
		if nearArena() then
			Sound.Play("BossAppear")
			Effects.Flash(arenaPos + Vector3.new(0, 14, 0), Color3.fromRGB(255, 120, 230), 30, 0.7)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Color3.fromRGB(255, 230, 90), 40, 0.9)
			Effects.Burst(arenaPos + Vector3.new(0, 14, 0), { Color = Color3.fromRGB(255, 120, 230), Color2 = Color3.fromRGB(255, 230, 90), Count = 120, Size = 2.5, Speed = 40, Life = 1.2 })
			-- camera shake
			task.spawn(function()
				local cam = workspace.CurrentCamera
				local t0 = os.clock()
				while os.clock() - t0 < 0.6 and cam.CameraType ~= Enum.CameraType.Scriptable do
					local k = 0.6 * (1 - (os.clock() - t0) / 0.6)
					cam.CFrame *= CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
					RunService.RenderStepped:Wait()
				end
			end)
		end
	elseif data.State == "Defeated" then
		state = "Idle"
		dismissed = false
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("GIANT POLTERGEIST DEFEATED!", "Grab the Ectoplasm shower!", Theme.Gold)
		if data.Pos and nearArena() then
			Effects.Poof(data.Pos, Color3.fromRGB(255, 120, 230), 4, true)
			Effects.Ring(arenaPos + Vector3.new(0, 0.4, 0), Theme.Ecto, 45, 1)
		end
	elseif data.State == "Escaped" then
		state = "Idle"
		dismissed = false
		Sound.Boss(false)
		setBeacon(false)
		show(false)
		Hud.Banner("IT ESCAPED...", "It'll be back. Bring more hunters!", Theme.Muted)
	end
end

function Boss.Init()
	local screen = Kit.Screen()
	frame = Kit.new("Frame", {
		Name = "BossBar",
		Size = UDim2.fromOffset(420, 62),
		Position = UDim2.new(0.5, 10, 0, 104),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		Parent = screen,
	})
	Kit.Corner(frame, UDim.new(0, 14))
	Kit.Stroke(frame, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(frame, Color3.fromRGB(110, 40, 120), Color3.fromRGB(50, 20, 70), 90)
	Kit.new("UIScale", { Parent = frame })
	titleLabel = Kit.Label(frame, "👑 GIANT POLTERGEIST", { Size = UDim2.new(0.68, 0, 0, 22), Position = UDim2.fromOffset(10, 4), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, Style = "Heading", Fit = true, ZIndex = 31 })
	timerLabel = Kit.Label(frame, "", { Size = UDim2.new(0.3, 0, 0, 22), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Style = "Body", Fit = true, ZIndex = 31 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 31), BackgroundColor3 = Color3.fromRGB(30, 12, 45), ZIndex = 31, Parent = frame })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 32, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Color3.fromRGB(255, 120, 230), Color3.fromRGB(255, 220, 80), 0)
	spiritLabel = Kit.Label(bar, "", { Style = "Small", ZIndex = 33 })
	-- "take me there" helper: walks you nowhere, just points the way (see Tutorial arrow)
	goButton = Kit.Button(frame, {
		Text = "📍 SHOW ME",
		Color = "Pink",
		Size = UDim2.fromOffset(140, 40),
		TextStyle = "Small",
		Position = UDim2.new(0.5, 0, 1, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 31,
		OnClick = function()
			Boss.PointRequested:Fire()
		end,
	})
	goButton.Visible = false
	-- ✕ closes the event bar (the event keeps running; the boss's own label still shows)
	Kit.Button(frame, {
		Text = "✕",
		Color = "Red",
		Size = UDim2.fromOffset(30, 30),
		TextStyle = "Body",
		Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 34,
		OnClick = function()
			dismissed = true
			show(false)
		end,
	})
	-- small pill to bring it back while the event is still on
	reopen = Kit.Button(screen, {
		Text = "👑 EVENT",
		Color = "Pink",
		Size = UDim2.fromOffset(96, 30),
		TextStyle = "Small",
		Position = UDim2.new(0.5, 10, 0, 104),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 30,
		OnClick = function()
			dismissed = false
			show(true)
		end,
	})
	reopen.Visible = false
end

Boss.PointRequested = Signal.new()

function Boss.State(): (string, Vector3)
	return state, arenaPos
end

function Boss.Start()
	State.OnFx("Boss", onBoss)
	RunService.Heartbeat:Connect(function()
		if state == "Warning" then
			local left = math.max(0, warnAt - workspace:GetServerTimeNow())
			timerLabel.Text = Format.Time(left)
			goButton.Visible = not nearArena()
		elseif state == "Active" then
			local left = math.max(0, endsAt - workspace:GetServerTimeNow())
			timerLabel.Text = "⏱ " .. Format.Time(left)
			timerLabel.TextColor3 = if left < 20 then Theme.Bad else Theme.Text
			goButton.Visible = not nearArena()
			local e = Ghosts.Get(bossUid)
			if e then
				local frac = math.clamp(e.Spirit / math.max(e.Max, 1), 0, 1)
				fill.Size = UDim2.fromScale(math.max(frac, 0.01), 1)
				spiritLabel.Text = Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max) .. " SPIRIT"
			end
		end
	end)
end

return Boss
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">CratePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Crate station panel: odds (with luck boost), possible hunters, price and the OPEN button.
-- Opened by the station's ProximityPrompt. The server rolls; we only play the reveal.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Reveal = require(script.Parent.Reveal)

local CratePanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local list: ScrollingFrame
local openButton: TextButton
local infoLabel: TextLabel
local luckLabel: TextLabel
local current: string? = nil
local crateIcon: ImageLabel
local busy = false
local openedSignal = Signal.new()
CratePanel.Opened = openedSignal -- (result) after a successful purchase

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function nearStation(crateId: string): boolean
	local pos = Config.Layout.CrateStations[crateId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return pos ~= nil and root ~= nil and (root.Position - pos).Magnitude < 28
end

local cardsKey = ""
local refreshCards: (string, any, { [string]: number }, number) -> ()
local refreshButton: (string, any, number) -> ()

local function refresh()
	local crateId = current
	local d = State.Data
	if not crateId or not d then
		return
	end
	local crate = Config.Crates[crateId]
	panel.Title.Text = crate.Name
	local img = Icons.Get(Icons.ForCrate[crateId])
	crateIcon.Image = img or ""
	crateIcon.Visible = img ~= nil
	-- the luck boost ends on the server clock even if no new snapshot arrives
	local luck = if (d.Boosts.Luck or 0) > State.Now() then Config.Boosts.Luck.Multiplier else 1
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, luck, Config.LuckAffectsFromOrder)
	-- cards only change with the crate, luck or discoveries; the button changes with Ectoplasm
	local key = crateId .. "|" .. luck
	for _, e in crate.Pool do
		key ..= if d.Discovered[e.Hunter] then "1" else "0"
	end
	if key ~= cardsKey then
		cardsKey = key
		refreshCards(crateId, d, odds, luck)
	end
	refreshButton(crateId, d, luck)
end

function refreshCards(crateId: string, d: any, odds: { [string]: number }, luck: number)
	local crate = Config.Crates[crateId]
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local found = d.Discovered[e.Hunter] == true
		local card: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = list,
		})
		Kit.Corner(card, UDim.new(0, 14))
		Kit.Stroke(card, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(card, rar.Color, rar.Color2, 90)
		local pic: Frame = Kit.new("Frame", {
			Size = UDim2.fromOffset(88, 88),
			Position = UDim2.new(0.5, 0, 0, 8),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(30, 18, 55),
			BackgroundTransparency = 0.3,
			ZIndex = 63,
			Parent = card,
		})
		Kit.Corner(pic, UDim.new(1, 0))
		Portrait.Face(pic, e.Hunter, not found)
		Kit.Label(card, if found then string.upper(def.Name) else "???", { Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 100), ZIndex = 64, Style = "Body", Fit = true })
		Kit.Label(card, rar.Name, { Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 121), ZIndex = 64, Color = Color3.fromRGB(255, 255, 240), Style = "Small", Fit = true })
		Kit.Label(card, "⚡ " .. Format.Commas(def.Power), { Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.new(0, 8, 1, -28), ZIndex = 64, Color = Theme.Gold, Align = Enum.TextXAlignment.Left, Style = "Small", Fit = true })
		local pct = Kit.Label(card, Format.Percent(odds[e.Hunter]), { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(1, -8, 1, -29), AnchorPoint = Vector2.new(1, 0), ZIndex = 64, Align = Enum.TextXAlignment.Right, Style = "Heading", Fit = true })
		if luck > 1 and rar.Order >= Config.LuckAffectsFromOrder then
			pct.TextColor3 = Theme.Ecto
		end
	end
end

function refreshButton(crateId: string, d: any, luck: number)
	local crate = Config.Crates[crateId]
	local free = d.FreeCrates[crateId] or 0
	local price = crate.Price
	if free > 0 then
		Kit.SetButtonText(openButton, "OPEN FREE! (" .. free .. ")")
		openButton:SetAttribute("Color", "Orange")
	elseif d.Ecto >= price then
		Kit.SetButtonText(openButton, "OPEN  💚 " .. Format.Commas(price))
		openButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(openButton, "NEED 💚 " .. Format.Short(price - d.Ecto) .. " MORE")
		openButton:SetAttribute("Color", "Gray")
	end
	if not d.Zones[crate.Zone] then
		infoLabel.Text = "Unlock " .. (Config.ZoneById[crate.Zone] :: Config.ZoneDef).Name .. " to open this crate"
	else
		infoLabel.Text = "Hunters jump out of crates! Better crates → stronger hunters."
	end
	luckLabel.Visible = luck > 1
end

local function buy()
	local crateId = current
	if busy or not crateId or Reveal.IsPlaying() then
		return
	end
	local d = State.Data
	local crate = Config.Crates[crateId]
	if d and (d.FreeCrates[crateId] or 0) <= 0 and d.Ecto < crate.Price then
		Kit.Toast("Defeat ghosts to collect more Ectoplasm!", "Bad")
		return
	end
	if not nearStation(crateId) then
		Kit.Toast("Walk to the crate first!", "Bad")
		return
	end
	busy = true
	local res = State.Request("OpenCrate", crateId)
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Couldn't open the crate", "Bad")
		return
	end
	panel:Close()
	local result: Reveal.Result = { Crate = crateId, Hunter = res.Hunter, Uid = res.Uid, IsNew = res.IsNew == true }
	openedSignal:Fire(result)
	local function again()
		if busy then
			return
		end
		local dd = State.Data
		if dd and (dd.FreeCrates[crateId] or 0) <= 0 and dd.Ecto < crate.Price then
			Kit.Toast("Not enough Ectoplasm!", "Bad")
			return
		end
		busy = true
		local r2 = State.Request("OpenCrate", crateId)
		busy = false
		if r2.ok then
			local res2: Reveal.Result = { Crate = crateId, Hunter = r2.Hunter, Uid = r2.Uid, IsNew = r2.IsNew == true }
			openedSignal:Fire(res2)
			Reveal.Play(res2, again)
		else
			Kit.Toast(r2.err or "Couldn't open the crate", "Bad")
		end
	end
	Reveal.Play(result, again)
end

function CratePanel.Open(crateId: string)
	if not Config.Crates[crateId] or Reveal.IsPlaying() then
		return
	end
	current = crateId
	refresh()
	panel:Open()
end

function CratePanel.Init()
	panel = Kit.Panel("Crate", "HUNTER CRATE", Vector2.new(700, 380), "Orange")
	-- crate picture in the top-left corner (uploaded icon per crate, see Icons.ForCrate)
	crateIcon = Kit.new("ImageLabel", {
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(72, 72),
		Position = UDim2.fromOffset(-14, -34),
		ZIndex = 64,
		Visible = false,
		Parent = panel.Root,
	})
	infoLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 12), Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	luckLabel = Kit.Label(panel.Body, "🍀 LUCK BOOST: rare odds boosted!", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 32), Color = Theme.Ecto, Style = "Small", ZIndex = 62 })
	luckLabel.Visible = false
	-- cards wrap onto more rows (and scroll) when the panel is narrow (phones, portrait)
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -118),
		Position = UDim2.fromOffset(0, 54),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(148, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = list })
	openButton = Kit.Button(panel.Body, {
		Text = "OPEN",
		Color = "Green",
		Size = UDim2.fromOffset(280, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = buy,
	})
	openButton.Name = "OpenButton"
	panel.Primary = openButton
end

function CratePanel.Start()
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh() -- keeps the odds honest when a luck boost runs out
			end
		end
	end)
end

function CratePanel.Button(): TextButton
	return openButton
end

function CratePanel.IsOpen(): boolean
	return panel.IsOpen
end

return CratePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Crew</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every player's equipped Ghost Hunters (client-side, never collide with anything).
-- Idle: follow in a formation behind their player. Assigned (player's "Target" attribute):
-- run to a ring around the ghost, aim and fire a wobbly energy beam, celebrate on the poof,
-- then come back. All crews update in ONE RenderStepped loop: BulkMoveTo for roots, Motor6D
-- transforms for poses, staggered ground raycasts, and far-away crews are hidden.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local HunterRig = require(GH.Rigs.HunterRig)
local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Ghosts = require(script.Parent.Ghosts)
local Targeting = require(script.Parent.Targeting)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Crew = {}

type Member = {
	Id: string,
	Rig: HunterRig.Rig,
	Pos: Vector3,
	Yaw: number,
	State: string,
	GroundY: number,
	NextRay: number,
	Beam: Beam,
	CelebrateUntil: number,
	Phase: number,
	Color: Color3,
}

type CrewData = {
	Player: Player,
	Members: { Member },
	Visible: boolean,
	LastTarget: number,
	NextSpark: number,
	NextSound: number,
	Conns: { RBXScriptConnection },
}

local player = Players.LocalPlayer
local crews: { [Player]: CrewData } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local nextFilter = 0

local VISIBLE_RANGE = 170
local HUNTER_SCALE = 0.88 -- rigs are ~4-4.6 studs; this puts them at a player's chest height
local RUN_SPEED = Config.Combat.HunterRunSpeed

local function refreshFilter()
	local list: { Instance } = { folder }
	for _, name in { "Ghosts", "GHEffects", "GHOrbs", "GHReveal" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function makeBeam(m: Member)
	local beam = Instance.new("Beam")
	beam.Name = "CaptureBeam"
	beam.Attachment0 = m.Rig.Tip
	beam.Color = ColorSequence.new(m.Color, Color3.new(1, 1, 1))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.8, 0.15), NumberSequenceKeypoint.new(1, 0.4) })
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Width0 = 0.35
	beam.Width1 = 0.9
	beam.Enabled = false
	beam.Parent = m.Rig.Model
	m.Beam = beam
end

-- One small line over each hunter: "★ Name" in its rarity colour. Short range (your own crew
-- reads it when the camera is close; it never stacks into clutter from afar).
local function addTag(m: Member, isLocal: boolean)
	local def = Config.Hunters[m.Id]
	local rar = Config.Rarities[def.Rarity]
	local gui = WorldLabel.New({
		Name = "Tag",
		Adornee = m.Rig.Root,
		Parent = m.Rig.Model,
		Size = Theme.World.CrewTag,
		Offset = Vector3.new(0, m.Rig.Height + 0.7, 0),
		MaxDistance = if isLocal then Theme.World.CrewMaxDistance else Theme.World.CrewMaxDistance * 0.6,
	})
	WorldLabel.Text(gui, string.rep("★", math.min(rar.Order, 5)) .. " " .. def.Name, { Style = "Tiny", Color = rar.Color })
	-- rare+ hunters stand on a soft rarity-coloured disc
	if rar.Order >= 3 then
		local disc = Instance.new("Part")
		disc.Name = "RarityDisc"
		disc.Shape = Enum.PartType.Cylinder
		disc.Size = Vector3.new(0.12, 3.4, 3.4)
		disc.Material = Enum.Material.SmoothPlastic
		disc.Color = rar.Color
		disc.Transparency = 0.45
		disc.CanCollide = false
		disc.CanQuery = false
		disc.CanTouch = false
		disc.CastShadow = false
		disc.Massless = true
		disc.CFrame = m.Rig.Root.CFrame * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = m.Rig.Root
		w.Part1 = disc
		w.Parent = disc
		disc.Parent = m.Rig.Model
	end
end

local function newMember(id: string, at: Vector3, isLocal: boolean): Member
	local rig = HunterRig.Build(id)
	rig.Model:ScaleTo(HUNTER_SCALE)
	rig.Height *= HUNTER_SCALE
	for _, p in rig.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	rig.Model:PivotTo(CFrame.new(at))
	rig.Model.Parent = folder
	local def = Config.Hunters[id]
	local m: Member = {
		Id = id,
		Rig = rig,
		Pos = at,
		Yaw = 0,
		State = "Idle",
		GroundY = at.Y,
		NextRay = 0,
		Beam = nil :: any,
		CelebrateUntil = 0,
		Phase = math.random() * 10,
		Color = def.Look.Beam,
	}
	makeBeam(m)
	addTag(m, isLocal)
	return m
end

local function rootOf(pl: Player): BasePart?
	local char = pl.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function rebuild(c: CrewData)
	local raw = c.Player:GetAttribute("Crew")
	local ids = {}
	if type(raw) == "string" and raw ~= "" then
		for id in raw:gmatch("[^,]+") do
			if Config.Hunters[id] and #ids < 12 then
				table.insert(ids, id)
			end
		end
	end
	local root = rootOf(c.Player)
	local at = if root then root.Position - Vector3.new(0, 3, 0) else Vector3.zero
	local isLocal = c.Player == player
	for i, id in ids do
		local m = c.Members[i]
		if not m or m.Id ~= id then
			if m then
				m.Rig.Model:Destroy()
			end
			local spawnAt = if m then m.Pos else at + Vector3.new((i - 2.5) * 2, 0, 3)
			c.Members[i] = newMember(id, spawnAt, isLocal)
			if isLocal and m == nil and os.clock() > 3 then
				Effects.Burst(spawnAt + Vector3.new(0, 2, 0), { Color = Config.Rarities[Config.Hunters[id].Rarity].Color, Count = 14, Size = 0.7, Speed = 10 })
			end
		end
	end
	for i = #c.Members, #ids + 1, -1 do
		c.Members[i].Rig.Model:Destroy()
		c.Members[i] = nil
	end
	if not c.Visible then
		for _, m in c.Members do
			m.Rig.Model.Parent = nil
		end
	end
end

local function addPlayer(pl: Player)
	if crews[pl] then
		return
	end
	local c: CrewData = {
		Player = pl,
		Members = {},
		Visible = true,
		LastTarget = 0,
		NextSpark = 0,
		NextSound = 0,
		Conns = {},
	}
	crews[pl] = c
	table.insert(c.Conns, pl:GetAttributeChangedSignal("Crew"):Connect(function()
		rebuild(c)
	end))
	rebuild(c)
end

local function removePlayer(pl: Player)
	local c = crews[pl]
	if not c then
		return
	end
	for _, conn in c.Conns do
		conn:Disconnect()
	end
	for _, m in c.Members do
		m.Rig.Model:Destroy()
	end
	crews[pl] = nil
end

local function setVisible(c: CrewData, on: boolean, root: BasePart?)
	if c.Visible == on then
		return
	end
	c.Visible = on
	for i, m in c.Members do
		m.Rig.Model.Parent = if on then folder else nil
		if on and root then
			-- snap back into formation instead of sprinting across the map
			m.Pos = root.Position + Vector3.new((i - 2.5) * 2.5, -3, 4)
			m.NextRay = 0
		end
	end
end

local function angleDiff(a: number, b: number): number
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

local function centerAttachment(e: Ghosts.Entry): Attachment
	local a = e.Core:FindFirstChild("Center")
	if a and a:IsA("Attachment") then
		return a
	end
	local made = Instance.new("Attachment")
	made.Name = "Center"
	made.Parent = e.Core
	return made
end

local roots: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	dt = math.min(dt, 0.1)
	local clock = os.clock()
	if clock > nextFilter then
		nextFilter = clock + 2
		refreshFilter()
	end
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(roots)
	table.clear(cframes)

	for pl, c in crews do
		local root = rootOf(pl)
		local isLocal = pl == player
		if not root or #c.Members == 0 then
			setVisible(c, false, nil)
			continue
		end
		local far = not isLocal and (root.Position - camPos).Magnitude > VISIBLE_RANGE
		setVisible(c, not far, root)
		if far then
			continue
		end
		local footY = root.Position.Y - 3
		-- your own crew reacts to your tap instantly; others follow the server's choice
		local uid = if isLocal then Targeting.LocalTarget() else ((pl:GetAttribute("Target") :: number?) or 0)
		local ghost = if uid ~= 0 then Ghosts.Get(uid) else nil
		if ghost and (ghost.Pos - root.Position).Magnitude > Config.Combat.MaxRange * 1.5 then
			ghost = nil
		end
		if ghost then
			c.LastTarget = uid
		end
		local n = #c.Members
		local anyAttacking = false
		local rootLook = root.CFrame.LookVector
		local rootYaw = math.atan2(-rootLook.X, -rootLook.Z)
		local flatRoot = CFrame.new(root.Position) * CFrame.Angles(0, rootYaw, 0)
		local speedNow = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude

		for i, m in c.Members do
			local goal: Vector3
			local faceTo: Vector3? = nil
			local attackMode = false
			if m.CelebrateUntil > clock then
				goal = m.Pos
			elseif ghost then
				attackMode = true
				local gp = ghost.Pos
				local away = Vector3.new(root.Position.X - gp.X, 0, root.Position.Z - gp.Z)
				local base = if away.Magnitude > 0.1 then math.atan2(away.X, away.Z) else 0
				local spread = math.rad(math.min(160, 42 * (n - 1)))
				local a = base + (if n > 1 then -spread / 2 + spread * (i - 1) / (n - 1) else 0)
				local r = 3.2 + ghost.Def.Scale * 2.2
				goal = Vector3.new(gp.X + math.sin(a) * r, m.Pos.Y, gp.Z + math.cos(a) * r)
				faceTo = gp
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local inRow = math.min(3, n - row * 3)
				local x = (col - (inRow - 1) / 2) * 3.2
				local z = 4.6 + row * 3.4
				goal = (flatRoot * CFrame.new(x, 0, z)).Position
			end
			-- move (XZ), teleport if hopelessly far
			local delta = Vector3.new(goal.X - m.Pos.X, 0, goal.Z - m.Pos.Z)
			local dist = delta.Magnitude
			if dist > 75 then
				m.Pos = Vector3.new(goal.X, footY, goal.Z)
				m.NextRay = 0
				dist = 0
			elseif dist > 0.05 then
				local speed = if attackMode then RUN_SPEED else math.max(14, speedNow * 1.15 + dist * 2)
				local stepLen = math.min(dist, speed * dt)
				m.Pos += delta.Unit * stepLen
			end
			-- ground snap (staggered raycasts)
			if clock >= m.NextRay then
				m.NextRay = clock + 0.18 + math.random() * 0.08
				local hit = workspace:Raycast(Vector3.new(m.Pos.X, root.Position.Y + 3, m.Pos.Z), Vector3.new(0, -20, 0), rayParams)
				m.GroundY = if hit then math.clamp(hit.Position.Y, footY - 10, footY + 4) else footY
			end
			local y = m.Pos.Y + (m.GroundY - m.Pos.Y) * math.min(1, dt * 14)
			m.Pos = Vector3.new(m.Pos.X, y, m.Pos.Z)

			-- facing
			local wantYaw = m.Yaw
			if faceTo and dist < 4 then
				local f = Vector3.new(faceTo.X - m.Pos.X, 0, faceTo.Z - m.Pos.Z)
				if f.Magnitude > 0.1 then
					wantYaw = math.atan2(-f.X, -f.Z)
				end
			elseif dist > 0.6 then
				wantYaw = math.atan2(-delta.X, -delta.Z)
			elseif not ghost then
				wantYaw = rootYaw
			end
			m.Yaw += angleDiff(m.Yaw, wantYaw) * math.min(1, dt * 12)

			-- state
			local state
			if m.CelebrateUntil > clock then
				state = "Celebrate"
			elseif attackMode and dist < 4 then
				state = "Attack"
			elseif dist > 0.6 then
				state = "Run"
			else
				state = "Idle"
			end
			m.State = state
			HunterRig.Pose(m.Rig, state, clock + m.Phase, 1)

			-- beam
			local beam = m.Beam
			if state == "Attack" and ghost then
				anyAttacking = true
				local att = centerAttachment(ghost)
				if beam.Attachment1 ~= att then
					beam.Attachment1 = att
				end
				beam.Enabled = true
				local w = math.sin(clock * 9 + m.Phase)
				beam.CurveSize0 = w * 1.6
				beam.CurveSize1 = -w * 1.1
				beam.Width0 = 0.3 + 0.12 * math.sin(clock * 22 + m.Phase)
				beam.Width1 = 0.7 + 0.25 * math.sin(clock * 17 + m.Phase)
			elseif beam.Enabled then
				beam.Enabled = false
			end

			table.insert(roots, m.Rig.Root)
			table.insert(cframes, CFrame.new(m.Pos) * CFrame.Angles(0, m.Yaw, 0))
		end

		-- impact sparks + soft zaps for your own crew only (keeps busy servers cheap)
		if isLocal and anyAttacking and ghost then
			if clock >= c.NextSpark then
				c.NextSpark = clock + 0.3
				local m = c.Members[math.random(1, n)]
				local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * ghost.Def.Scale * 2
				Effects.Burst(ghost.Pos + off, { Color = m.Color, Count = 7, Size = 0.5, Speed = 9, Life = 0.4 })
			end
			if clock >= c.NextSound then
				c.NextSound = clock + 0.45
				Sound.Play("Attack", 0.15)
			end
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Crew.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHCrews"
	folder.Parent = workspace
end

function Crew.Start()
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(removePlayer)
	for _, pl in Players:GetPlayers() do
		addPlayer(pl)
	end
	-- victory pose when a ghost they were fighting poofs
	Ghosts.Died:Connect(function(uid: number)
		local until_ = os.clock() + 0.9
		for _, c in crews do
			if c.LastTarget == uid then
				for _, m in c.Members do
					if m.State == "Attack" then
						m.CelebrateUntil = until_
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(step)
end

-- Local crew members (for the crate reveal / tutorial).
function Crew.LocalCount(): number
	local c = crews[player]
	return if c then #c.Members else 0
end

return Crew
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">DailyPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DAILY reward: Day 1-7 tiles, a big golden Day 7, CLAIM button or a countdown.
-- Timing is decided by the server's clock (the client only displays it).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local DailyPanel = {}

type Tile = { Frame: Frame, Check: TextLabel, Today: TextLabel, Reward: TextLabel, Scale: UIScale }

local panel: Kit.Panel
local tiles: { Tile } = {}
local claimButton: TextButton
local statusLabel: TextLabel
local busy = false

local function rewardLabel(i: number, mult: number): string
	local r = Config.Daily.Rewards[i]
	if r.Amount and mult > 1 then
		return (r.Label:gsub(Format.Commas(r.Amount), Format.Commas(r.Amount * mult)))
	end
	return r.Label
end

local function remaining(d: any): number
	local info = d.DailyInfo
	if not info then
		return 0
	end
	return math.max(0, info.Wait - (State.Now() - (d.ServerTime or State.Now())))
end

local function refresh()
	local d = State.Data
	if not d or not d.DailyInfo then
		return
	end
	local info = d.DailyInfo
	local left = remaining(d)
	local canClaim = info.CanClaim or left <= 0
	local day = info.Day
	local claimed = if canClaim then day - 1 elseif day == 1 then #Config.Daily.Rewards else day - 1
	local mult = d.ZoneMultiplier or 1
	for i, t in tiles do
		t.Reward.Text = rewardLabel(i, mult)
		t.Check.Visible = i <= claimed
		t.Today.Visible = canClaim and i == day
		t.Frame.BackgroundTransparency = if i <= claimed then 0.45 else 0
	end
	if canClaim then
		Kit.SetButtonText(claimButton, "CLAIM DAY " .. day .. "!")
		claimButton:SetAttribute("Color", "Green")
		statusLabel.Text = if info.StreakBroken then "Streak reset - start again from Day 1!" else "Come back every day for bigger rewards!"
	else
		Kit.SetButtonText(claimButton, "NEXT IN " .. Format.Time(left))
		claimButton:SetAttribute("Color", "Gray")
		statusLabel.Text = "Day " .. day .. " unlocks in " .. Format.Time(left) .. ". Don't miss a day or your streak resets!"
	end
end

local function claim()
	if busy then
		return
	end
	busy = true
	local res = State.Request("ClaimDaily")
	busy = false
	if not res.ok then
		Kit.Toast(res.err or "Not yet!", "Bad")
		return
	end
	Sound.Play("Daily")
	Hud.Banner("DAY " .. tostring(res.Day) .. " REWARD!", res.Label, Theme.Gold)
	local t = tiles[res.Day]
	if t then
		t.Scale.Scale = 1.25
		Kit.Tween(t.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Effects.Burst(root.Position + Vector3.new(0, 2, 0), { Color = Theme.Gold, Color2 = Theme.Ecto, Count = 50, Size = 1, Speed = 20 })
	end
end

function DailyPanel.Init()
	panel = Kit.Panel("Daily", "DAILY REWARDS", Vector2.new(700, 440), "Purple")
	-- tiles wrap to the panel width (4 per row on wide screens) and scroll if short
	local grid: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -96),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(148, 124), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6), Parent = grid })
	for i = 1, #Config.Daily.Rewards do
		local big = i == #Config.Daily.Rewards
		local f: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = i,
			ZIndex = 62,
			Parent = grid,
		})
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		if big then
			Kit.Gradient(f, Theme.Gold, Color3.fromRGB(255, 120, 40), 90)
		else
			Kit.Gradient(f, Theme.Panel3, Theme.Panel2, 90)
		end
		local sc = Kit.new("UIScale", { Parent = f })
		Kit.Label(f, "DAY " .. i, { Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 4), Style = "Heading", ZIndex = 63 })
		local r = Config.Daily.Rewards[i]
		local icon = if r.Kind == "Day7" then "🎁" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "🍀" else "⚡") else "💚"
		local iconKey = if r.Kind == "Day7" then "menu_daily" elseif r.Kind == "Boost" then (if r.Boost == "Luck" then "boost_luck" else "boost_ecto2x") else "ecto_pile"
		Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 28), Style = "Icon", TextSize = 28, ZIndex = 63, Stroke = 0 })
		local reward = Kit.Label(f, r.Label, { Size = UDim2.new(1, -12, 0, 52), Position = UDim2.fromOffset(6, 66), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Style = "Small" })
		local check = Kit.Label(f, "✓", { Size = UDim2.fromScale(1, 1), Color = Theme.Good, ZIndex = 66, Style = "Banner", Stroke = 3 })
		check.Visible = false
		local today = Kit.Label(f, "TODAY!", { Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, 4, 0, -8), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 67, Stroke = 2 })
		today.Rotation = 8
		today.Visible = false
		table.insert(tiles, { Frame = f, Check = check, Today = today, Reward = reward, Scale = sc })
	end
	statusLabel = Kit.Label(panel.Body, "", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 1, -82), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 })
	claimButton = Kit.Button(panel.Body, {
		Text = "CLAIM",
		Color = "Green",
		Size = UDim2.fromOffset(280, 48),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = claim,
	})
	panel.Primary = claimButton
	Hud.RegisterPanel("Daily", function()
		panel:Toggle()
	end)
end

function DailyPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
	-- a returning player with a reward waiting gets the panel once, a few seconds after joining
	task.spawn(function()
		local d = State.WaitForData()
		task.wait(6)
		if d.DailyInfo and d.DailyInfo.CanClaim and (d.Tutorial or 1) > #Config.Tutorial.Steps and not Kit.CurrentPanel() then
			panel:Open()
		end
	end)
end

return DailyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DEV panel: owner-only test tools. The 🛠 button appears only when the server marked this
-- player as a developer (attribute "IsDev"); every action is checked again on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)

local DevPanel = {}

local player = Players.LocalPlayer
local panel: Kit.Panel
local devButton: TextButton

type Action = { Text: string, Cmd: string, Arg: any?, Color: string }
local ACTIONS: { Action } = {
	{ Text = "+10K ECTO", Cmd = "Ecto", Arg = 10000, Color = "Green" },
	{ Text = "+1M ECTO", Cmd = "Ecto", Arg = 1000000, Color = "Green" },
	{ Text = "+1B ECTO", Cmd = "Ecto", Arg = 1000000000, Color = "Green" },
	{ Text = "+1T ECTO", Cmd = "Ecto", Arg = 1000000000000, Color = "Green" },
	{ Text = "UNLOCK ALL AREAS", Cmd = "Zones", Color = "Blue" },
	{ Text = "ALL 32 HUNTERS", Cmd = "Hunters", Color = "Orange" },
	{ Text = "MAX UPGRADES", Cmd = "MaxUpgrades", Color = "Teal" },
	{ Text = "START EVENT", Cmd = "Event", Color = "Pink" },
	{ Text = "RESET DAILY", Cmd = "ResetDaily", Color = "Purple" },
	{ Text = "AUTO ATTACK PASS", Cmd = "AutoAttack", Color = "Purple" },
	{ Text = "REPLAY TUTORIAL", Cmd = "Tutorial", Color = "Gray" },
}

local function run(a: Action)
	local res = State.Request("Dev", a.Cmd, a.Arg)
	if res.ok then
		Kit.Toast(if a.Cmd == "Ecto" then "+" .. Format.Short(a.Arg :: number) .. " Ectoplasm" else a.Text .. " ✓", "Good")
	else
		Kit.Toast(res.err or "Failed", "Bad")
	end
end

function DevPanel.Init()
	panel = Kit.Panel("Dev", "🛠 DEV TOOLS", Vector2.new(620, 360), "Gray")
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 46), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = list })
	for i, a in ACTIONS do
		local b = Kit.Button(list, { Text = a.Text, Color = a.Color, TextStyle = "Small", ZIndex = 62, OnClick = function()
			run(a)
		end })
		b.LayoutOrder = i
		if i == 1 then
			panel.Primary = b
		end
	end
	Kit.Label(panel.Body, "Only you can see this. In a live server these change your real save.", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), Color = Theme.Muted, Font = Theme.Body, Style = "Tiny", Stroke = 0, ZIndex = 62 })

	devButton = Kit.Button(Kit.Screen(), {
		Text = "🛠",
		Color = "Gray",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, -60, 0.5, -48),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	devButton.Visible = false
end

function DevPanel.Start()
	local function refresh()
		devButton.Visible = player:GetAttribute("IsDev") == true
	end
	player:GetAttributeChangedSignal("IsDev"):Connect(refresh)
	refresh()
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Short-lived VFX helpers (bursts, rings, sparkles). All local, all self-cleaning, and capped
-- so a busy moment never turns into a GPU benchmark.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

Effects.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local folder: Folder
local live = 0
local MAX_LIVE = 24

local function holder(pos: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = folder
	return p
end

export type BurstOpts = {
	Color: Color3,
	Color2: Color3?,
	Count: number?,
	Size: number?,
	Speed: number?,
	Life: number?,
	Texture: string?,
	Spread: number?,
	Gravity: number?,
	LightEmission: number?,
}

function Effects.Burst(pos: Vector3, o: BurstOpts)
	if live >= MAX_LIVE then
		return
	end
	live += 1
	local p = holder(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or Effects.Textures.Sparkle
	e.Color = ColorSequence.new(o.Color, o.Color2 or o.Color)
	local size = o.Size or 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.6, size * 0.8), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	local life = o.Life or 0.7
	e.Lifetime = NumberRange.new(life * 0.6, life)
	local speed = o.Speed or 18
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Acceleration = Vector3.new(0, -(o.Gravity or 0), 0)
	e.Drag = 3
	e.LightEmission = o.LightEmission or 1
	e.Rate = 0
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = p
	e:Emit(math.min(o.Count or 20, 160))
	task.delay(life + 0.2, function()
		live -= 1
		p:Destroy()
	end)
end

-- Expanding flat neon ring on the ground / around a point.
function Effects.Ring(pos: Vector3, color: Color3, radius: number, time: number?)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Size = Vector3.new(0.3, 1, 1)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	r.Parent = folder
	local t = time or 0.5
	TweenService:Create(r, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(r, t + 0.05)
end

-- Expanding glowing sphere (poofs, reveal flashes).
function Effects.Flash(pos: Vector3, color: Color3, radius: number, time: number?)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.Neon
	s.Color = color
	s.Transparency = 0.15
	s.Size = Vector3.new(1, 1, 1) * radius * 0.4
	s.CFrame = CFrame.new(pos)
	s.Parent = folder
	local t = time or 0.35
	TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(1, 1, 1) * radius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(s, t + 0.05)
end

-- The signature ghost POOF: flash + cloud + sparkles + ring.
function Effects.Poof(pos: Vector3, color: Color3, scale: number, big: boolean)
	Effects.Flash(pos, Color3.new(1, 1, 1), 3 * scale, 0.25)
	Effects.Flash(pos, color, 4.5 * scale, 0.45)
	Effects.Burst(pos, { Color = Color3.fromRGB(245, 240, 255), Color2 = color, Count = if big then 40 else 18, Size = 2.2 * scale, Speed = 10 * scale, Life = 0.8, Texture = Effects.Textures.Smoke, LightEmission = 0.3 })
	Effects.Burst(pos, { Color = color, Count = if big then 60 else 24, Size = 0.9 * math.sqrt(scale), Speed = 22 * math.sqrt(scale), Life = 0.7 })
	Effects.Ring(pos, color, 7 * scale, 0.5)
end

function Effects.Folder(): Folder
	return folder
end

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHEffects"
	folder.Parent = workspace
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">GatePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Zone gate confirm: "UNLOCK CEMETERY?" with cost, progress and what you get. The gate's
-- ProximityPrompt opens it; the server checks cost, order and distance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)

local GatePanel = {}

local panel: Kit.Panel
local costLabel: TextLabel
local fill: Frame
local progressLabel: TextLabel
local unlockButton: TextButton
local current: string? = nil
local busy = false

local function refresh()
	local d = State.Data
	local zone = current and Config.ZoneById[current]
	if not d or not zone then
		return
	end
	panel.Title.Text = "UNLOCK " .. zone.Name .. "?"
	costLabel.Text = "💚 " .. Format.Commas(zone.Cost) .. " ECTOPLASM"
	local frac = math.clamp(d.Ecto / math.max(zone.Cost, 1), 0, 1)
	Kit.Tween(fill, 0.25, { Size = UDim2.fromScale(math.max(frac, 0.03), 1) })
	progressLabel.Text = Format.Short(math.min(d.Ecto, zone.Cost)) .. " / " .. Format.Short(zone.Cost)
	if d.Zones[zone.Id] then
		Kit.SetButtonText(unlockButton, "UNLOCKED ✓")
		unlockButton:SetAttribute("Color", "Gray")
	elseif d.Ecto >= zone.Cost then
		Kit.SetButtonText(unlockButton, "UNLOCK!")
		unlockButton:SetAttribute("Color", "Green")
	else
		Kit.SetButtonText(unlockButton, "NEED " .. Format.Short(zone.Cost - d.Ecto) .. " MORE")
		unlockButton:SetAttribute("Color", "Gray")
	end
end

function GatePanel.Open(zoneId: string)
	if not Config.ZoneById[zoneId] then
		return
	end
	current = zoneId
	refresh()
	panel:Open()
end

function GatePanel.Init()
	panel = Kit.Panel("Gate", "UNLOCK?", Vector2.new(520, 330), "Green")
	local body = panel.Body
	costLabel = Kit.Label(body, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 14), Color = Theme.Ecto, Style = "Heading", ZIndex = 62 })
	local bar: Frame = Kit.new("Frame", { Size = UDim2.new(0.8, 0, 0, 24), Position = UDim2.new(0.1, 0, 0, 48), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	fill = Kit.new("Frame", { Size = UDim2.fromScale(0.03, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, Theme.Ecto, Theme.Ecto2, 0)
	progressLabel = Kit.Label(bar, "", { Style = "Small", ZIndex = 64 })
	local perks: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), Position = UDim2.fromOffset(0, 84), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 38), CellPadding = UDim2.fromOffset(10, 8), Parent = perks })
	for _, p in { "👻 NEW GHOSTS", "📦 NEW CRATE", "🔦 BETTER HUNTERS", "💚 HIGHER REWARDS" } do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Theme.Panel3, ZIndex = 62, Parent = perks })
		Kit.Corner(f, UDim.new(0, 10))
		Kit.Label(f, p, { Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0), Style = "Body", Fit = true, ZIndex = 63 })
	end
	unlockButton = Kit.Button(body, {
		Text = "UNLOCK!",
		Color = "Green",
		Size = UDim2.fromOffset(260, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 63,
		OnClick = function()
			local zoneId = current
			local d = State.Data
			if busy or not zoneId or not d or d.Zones[zoneId] then
				return
			end
			if d.Ecto < (Config.ZoneById[zoneId] :: Config.ZoneDef).Cost then
				Kit.Toast("Defeat more ghosts to earn Ectoplasm!", "Bad")
				return
			end
			busy = true
			local res = State.Request("UnlockZone", zoneId)
			busy = false
			if res.ok then
				panel:Close()
			else
				Kit.Toast(res.err or "Couldn't unlock", "Bad")
			end
		end,
	})
	panel.Primary = unlockButton
end

function GatePanel.Start()
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return GatePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Ghosts</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side ghost presentation. The server sends each ghost as a single invisible hitbox
-- (`Core`, the tap target) plus attributes; this module builds the visual rig locally
-- (GhostRig), moves both along the server's wander segments, and handles bobbing, facing,
-- Spirit labels, the selected-ghost state (active label + ground ring), hit wobble, spawn-in
-- and the POOF. One RenderStepped loop for all ghosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Signal = require(GH.Signal)
local Format = require(GH.Logic.Format)
local GhostRig = require(GH.Rigs.GhostRig)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Ghosts = {}

export type Entry = {
	Uid: number,
	Model: Model, -- server model (hitbox)
	Core: BasePart, -- server hitbox (tap target, beam attachments)
	Vis: Model, -- local visual rig
	VisCore: BasePart,
	Def: Config.GhostDef,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	Phase: number,
	Max: number,
	Spirit: number,
	Gui: BillboardGui,
	NameLabel: TextLabel,
	Bar: Frame,
	Fill: Frame,
	SpiritText: TextLabel,
	HitT: number,
	Yaw: number,
	Dying: boolean,
	Pos: Vector3, -- visual centre this frame
	Base: Vector3, -- centre without bob (for the ground ring)
	Selected: boolean,
	Culled: boolean,
}

local entries: { [number]: Entry } = {}
local player = Players.LocalPlayer
local diedSignal = Signal.new()
Ghosts.Died = diedSignal -- (uid, pos)
local addedSignal = Signal.new()
Ghosts.Added = addedSignal -- (entry)
local selectedUid = 0
local ring: Part
local ringStroke: UIStroke

function Ghosts.Get(uid: number): Entry?
	return entries[uid]
end

function Ghosts.All(): { [number]: Entry }
	return entries
end

-- Finds the ghost entry owning an instance (for tap targeting).
function Ghosts.FromInstance(inst: Instance?): Entry?
	local cur = inst
	while cur and cur ~= workspace do
		if cur:IsA("Model") then
			local uid = cur:GetAttribute("Uid")
			if type(uid) == "number" and entries[uid] then
				return entries[uid]
			end
		end
		cur = cur.Parent
	end
	return nil
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

local function labelSize(e: Entry): Vector2
	local boss = e.Def.Kind == "Boss" or e.Def.Kind == "Event"
	if e.Selected then
		return if boss then Theme.World.BossLabelSelected else Theme.World.GhostLabelSelected
	end
	return if boss then Theme.World.BossLabel else Theme.World.GhostLabel
end

local function maxDistance(e: Entry): number
	if e.Selected then
		return Theme.World.SelectedMaxDistance
	end
	return if e.Def.Kind == "Normal" then Theme.World.GhostMaxDistance else Theme.World.BossMaxDistance
end

-- Spirit value on the bar: "x / max" when selected (and on bosses), just "x" otherwise.
local function spiritText(e: Entry)
	e.SpiritText.Text = if e.Selected or e.Def.Kind ~= "Normal"
		then Format.Short(e.Spirit) .. " / " .. Format.Short(e.Max)
		else Format.Short(e.Spirit)
end

-- Unselected: name + slim bar. Selected: bigger bar with numbers, brighter, visible further,
-- drawn on top so you never lose your target.
local function styleLabel(e: Entry)
	spiritText(e)
	WorldLabel.Resize(e.Gui, labelSize(e))
	e.Gui.MaxDistance = maxDistance(e)
	e.Gui.AlwaysOnTop = e.Selected
	WorldLabel.SetTextStyle(e.SpiritText, if e.Selected then "Small" else "Tiny")
	e.Bar.Size = UDim2.fromScale(0.9, if e.Selected then 0.5 else 0.42)
	local st = e.Bar:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = if e.Selected then Color3.new(1, 1, 1) else Theme.Outline
		st.Thickness = if e.Selected then 2 else 1.5
	end
	e.NameLabel.TextColor3 = if e.Selected then Theme.Gold elseif e.Def.Kind ~= "Normal" then Color3.fromRGB(255, 230, 150) else Theme.Text
end

local function buildLabel(e: Entry)
	local def = e.Def
	-- above the head: hitbox top + a little, scaled with the ghost
	local gui = WorldLabel.New({
		Name = "SpiritGui",
		Adornee = e.Core,
		Parent = e.Model,
		Size = labelSize(e),
		Offset = Vector3.new(0, 2.6 * def.Scale + 0.8, 0),
		MaxDistance = Theme.World.GhostMaxDistance,
	})
	local nameText = def.Name
	if def.Kind == "MiniBoss" then
		nameText = "⭐ " .. nameText
	elseif def.Kind == "Boss" or def.Kind == "Event" then
		nameText = "👑 " .. nameText
	end
	e.NameLabel = WorldLabel.Text(gui, nameText, { Size = UDim2.fromScale(1, 0.48), Style = if def.Kind == "Normal" or def.Kind == "MiniBoss" then "Small" else "Body" })
	local bar: Frame = Kit.new("Frame", {
		Size = UDim2.fromScale(0.9, 0.42),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 15, 50),
		Parent = gui,
	})
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 1.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local fill: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar })
	Kit.Corner(fill, UDim.new(1, 0))
	Kit.Gradient(fill, def.Glow, Color3.fromRGB(180, 120, 255), 0)
	e.SpiritText = WorldLabel.Text(bar, "", { Style = "Tiny", ZIndex = 3 })
	e.Bar = bar
	e.Fill = fill
	e.Gui = gui
end

local function updateSpirit(e: Entry, spirit: number)
	local old = e.Spirit
	e.Spirit = spirit
	local frac = if e.Max > 0 then math.clamp(spirit / e.Max, 0, 1) else 0
	TweenService:Create(e.Fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(frac, 1) }):Play()
	spiritText(e)
	if spirit < old then
		e.HitT = os.clock()
	end
end

local function readSegment(e: Entry)
	local m = e.Model
	local from = m:GetAttribute("From")
	local to = m:GetAttribute("To")
	e.From = if typeof(from) == "Vector3" then from else e.Pos
	e.To = if typeof(to) == "Vector3" then to else e.From
	e.T0 = (m:GetAttribute("T0") :: number?) or 0
	e.Dur = (m:GetAttribute("Dur") :: number?) or 0
end

-- Selected ghost: active label + soft ground ring (set by Targeting).
function Ghosts.SetSelected(uid: number)
	if uid == selectedUid then
		return
	end
	local old = entries[selectedUid]
	if old then
		old.Selected = false
		styleLabel(old)
	end
	selectedUid = uid
	local e = entries[uid]
	if e then
		e.Selected = true
		styleLabel(e)
		local d = math.max(4, 2.8 * e.Def.Scale + 1.5)
		ring.Size = Vector3.new(d, 0.1, d)
		ringStroke.Color = e.Def.Glow
	else
		ring.CFrame = CFrame.new(0, -500, 0)
	end
end

local function add(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local uid = model:GetAttribute("Uid")
	local ghostId = model:GetAttribute("GhostId")
	if type(uid) ~= "number" or type(ghostId) ~= "string" or entries[uid] then
		return
	end
	local def = Config.Ghosts[ghostId]
	local core = model.PrimaryPart or model:WaitForChild("Core", 5)
	if not def or not core or not core:IsA("BasePart") or model:GetAttribute("Dead") then
		return
	end
	local vis = GhostRig.Build(ghostId)
	vis.Name = "Visual"
	local visCore = vis.PrimaryPart :: BasePart
	visCore.CanQuery = false -- the server hitbox is the tap target
	vis:PivotTo(core.CFrame)
	vis.Parent = model
	local e: Entry = {
		Uid = uid,
		Model = model,
		Core = core,
		Vis = vis,
		VisCore = visCore,
		Def = def,
		From = core.Position,
		To = core.Position,
		T0 = 0,
		Dur = 0,
		Phase = math.random() * math.pi * 2,
		Max = (model:GetAttribute("MaxSpirit") :: number?) or def.Spirit,
		Spirit = (model:GetAttribute("Spirit") :: number?) or def.Spirit,
		Gui = nil :: any,
		NameLabel = nil :: any,
		Bar = nil :: any,
		Fill = nil :: any,
		SpiritText = nil :: any,
		HitT = 0,
		Yaw = math.random() * math.pi * 2,
		Dying = false,
		Pos = core.Position,
		Base = core.Position,
		Selected = false,
		Culled = false,
	}
	readSegment(e)
	buildLabel(e)
	updateSpirit(e, e.Spirit)
	entries[uid] = e
	if uid == selectedUid then
		selectedUid = 0
		Ghosts.SetSelected(uid)
	end
	model:GetAttributeChangedSignal("T0"):Connect(function()
		-- From/To/T0/Dur are set together; read them once they have all arrived
		task.defer(readSegment, e)
	end)
	model:GetAttributeChangedSignal("Spirit"):Connect(function()
		updateSpirit(e, (model:GetAttribute("Spirit") :: number?) or 0)
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) and entries[uid] == e then
			entries[uid] = nil
		end
	end)
	-- spawn-in: grow from nothing (the event boss gets its own dramatic entrance)
	if def.Kind ~= "Event" then
		local s = Instance.new("NumberValue")
		s.Value = 0.2
		vis:ScaleTo(def.Scale * 0.2)
		local conn
		conn = s.Changed:Connect(function(v)
			-- (vis.Parent is nil while culled: keep growing so it isn't stuck small on return)
			if e.Dying or not model.Parent then
				conn:Disconnect()
				return
			end
			vis:ScaleTo(def.Scale * v)
		end)
		local tw = TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Value = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			conn:Disconnect()
			s:Destroy()
		end)
	end
	addedSignal:Fire(e)
end

local function poof(data: any)
	local e = entries[data.Uid]
	local pos: Vector3 = data.Pos
	local color: Color3 = data.Color
	local scale: number = data.Scale or 1
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = root == nil or (root.Position - pos).Magnitude < 160
	if e then
		e.Dying = true
		pos = e.Pos
		entries[data.Uid] = nil
		if selectedUid == data.Uid then
			selectedUid = 0
			ring.CFrame = CFrame.new(0, -500, 0)
		end
		diedSignal:Fire(data.Uid, pos)
		e.Gui.Enabled = false
		-- squash-and-stretch pop: inflate, then vanish
		local vis = e.Vis
		local v = Instance.new("NumberValue")
		v.Value = 1
		v.Changed:Connect(function(x)
			if vis.Parent then
				vis:ScaleTo(math.max(0.05, e.Def.Scale * x))
			end
		end)
		local up = TweenService:Create(v, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1.35 })
		up:Play()
		up.Completed:Connect(function()
			if near then
				Effects.Poof(pos, color, scale, data.Big == true)
			end
			for _, p in vis:GetDescendants() do
				if p:IsA("BasePart") then
					p.Transparency = 1
				elseif p:IsA("ParticleEmitter") then
					p.Enabled = false
				elseif p:IsA("Light") then
					p.Enabled = false
				end
			end
			v:Destroy()
		end)
	elseif near then
		Effects.Poof(pos, color, scale, data.Big == true)
	end
	if near then
		Sound.Play(if data.Big then "BigPoof" else "Poof", 0.08)
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}
-- Ghost visuals further than this from the camera are parked (unparented): with 8 zones most
-- ghosts are far away, and mobile shouldn't draw or animate them. Hysteresis avoids flicker.
local CULL_OUT = 330
local CULL_IN = 300

local function step()
	local t = workspace:GetServerTimeNow()
	local clock = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	table.clear(parts)
	table.clear(cframes)
	for _, e in entries do
		if e.Dying then
			continue
		end
		local a = if e.Dur > 0 then math.clamp((t - e.T0) / e.Dur, 0, 1) else 1
		local base = e.From:Lerp(e.To, smooth(a))
		local camDist = (base - camPos).Magnitude
		if e.Culled then
			if camDist > CULL_IN and not e.Selected then
				-- keep the position fresh for readers (Targeting fallback, Crew, Boss)
				e.Pos = base
				e.Base = base
				continue
			end
			e.Culled = false
			e.Vis.Parent = e.Model
			e.Gui.Enabled = true
		elseif camDist > CULL_OUT and not e.Selected then
			e.Culled = true
			e.Vis.Parent = nil
			e.Gui.Enabled = false
			e.Pos = base
			e.Base = base
			continue
		end
		WorldLabel.SetDistance(e.Gui, camDist)
		local s = e.Def.Scale
		local bob = math.sin(clock * 2.2 + e.Phase) * 0.45 * math.sqrt(s)
		local pos = base + Vector3.new(0, bob, 0)
		-- hit shake
		local since = clock - e.HitT
		if since < 0.15 then
			local k = (0.15 - since) / 0.15
			pos += Vector3.new(math.sin(clock * 90) * 0.25 * k * s, 0, math.cos(clock * 80) * 0.2 * k * s)
		end
		-- face the camera horizontally (cute + readable), with a gentle sway
		local dx, dz = camPos.X - pos.X, camPos.Z - pos.Z
		if dx * dx + dz * dz > 1 then
			local target = math.atan2(-dx, -dz)
			local diff = (target - e.Yaw + math.pi) % (2 * math.pi) - math.pi
			e.Yaw += diff * 0.08
		end
		local sway = math.sin(clock * 1.7 + e.Phase) * 0.12
		local moving = a < 1 and (e.To - e.From).Magnitude > 0.5
		local lean = if moving then 0.12 else 0
		e.Pos = pos
		e.Base = base
		local cf = CFrame.new(pos) * CFrame.Angles(0, e.Yaw, 0) * CFrame.Angles(-lean, 0, sway)
		table.insert(parts, e.Core)
		table.insert(cframes, CFrame.new(pos))
		table.insert(parts, e.VisCore)
		table.insert(cframes, cf)
	end
	-- ground ring under the selected ghost
	local sel = entries[selectedUid]
	if sel and not sel.Dying then
		local groundY = sel.Base.Y - sel.Def.Hover + 0.15
		table.insert(parts, ring)
		table.insert(cframes, CFrame.new(sel.Base.X, groundY, sel.Base.Z) * CFrame.Angles(0, clock * 0.8, 0))
		ringStroke.Transparency = 0.25 + 0.2 * math.sin(clock * 4)
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ghosts.Init()
	ring = Instance.new("Part")
	ring.Name = "TargetRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(6, 0.1, 6)
	ring.CFrame = CFrame.new(0, -500, 0)
	ring.Parent = workspace
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 24,
		LightInfluence = 0,
		Brightness = 1.5,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = sg })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 7, Color = Theme.Ecto, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
	-- dashed look: a second, inner faint circle
	local inner: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = circle })
	Kit.Corner(inner, UDim.new(1, 0))
	Kit.new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1), Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inner })
end

function Ghosts.Start()
	local folder = workspace:WaitForChild("Ghosts")
	folder.ChildAdded:Connect(function(m)
		task.defer(add, m)
	end)
	for _, m in folder:GetChildren() do
		task.spawn(add, m)
	end
	State.OnFx("Poof", poof)
	RunService.RenderStepped:Connect(step)
end

return Ghosts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD, kept compact so the screen stays free for seeing and tapping ghosts:
-- Ectoplasm counter, crew power, active boosts, menu buttons (one column on big screens,
-- a 2-column block in the top-left on phones, clear of the thumbstick), settings, the
-- AUTO ATTACK toggle (pass owners only), toasts, announcements and zone banners.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Rules = require(GH.Logic.Rules)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Sound = require(script.Parent.Sound)

local Hud = {}

local player = Players.LocalPlayer
local openers: { [string]: () -> () } = {}
Hud.Buttons = {} :: { [string]: TextButton }

local ectoLabel: TextLabel
local ectoPill: Frame
local powerLabel: TextLabel
local powerPrefix = "⚡ "
local boostHolder: Frame
local dailyBadge: Frame
local menu: Frame
local autoButton: TextButton
local shownEcto = 0
local targetEcto = 0
local bannerLabel: TextLabel
local bannerSub: TextLabel
local announceFrame: Frame
local announceToken = 0

function Hud.RegisterPanel(name: string, open: () -> ())
	openers[name] = open
end

function Hud.Open(name: string)
	local fn = openers[name]
	if fn then
		fn()
	end
end

-- Pulsing ring on a menu button (tutorial).
local pulses: { [string]: Frame } = {}
function Hud.Pulse(name: string, on: boolean)
	local b = Hud.Buttons[name]
	if not b then
		return
	end
	if on and not pulses[name] then
		local ring: Frame = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 20,
			Parent = b,
		})
		Kit.Corner(ring, UDim.new(0, 14))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		pulses[name] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.fromScale(1.35, 1.35) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and pulses[name] then
		pulses[name]:Destroy()
		pulses[name] = nil
	end
end

local function floatText(text: string, color: Color3)
	local l = Kit.Label(Kit.Overlay(), text, {
		Size = UDim2.fromOffset(160, 24),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = color,
		Style = "Heading",
		ZIndex = 80,
	})
	Kit.Tween(l, 0.8, { Position = UDim2.new(0.5, 0, 0, 40), TextTransparency = 1 })
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		Kit.Tween(st, 0.8, { Transparency = 1 })
	end
	task.delay(0.85, function()
		l:Destroy()
	end)
end

local function buildTop(screen: ScreenGui)
	-- Ectoplasm pill
	ectoPill = Kit.new("Frame", {
		Name = "Ecto",
		Size = UDim2.fromOffset(190, 40),
		Position = UDim2.new(0.5, 10, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = screen,
	})
	Kit.Corner(ectoPill, UDim.new(1, 0))
	Kit.Stroke(ectoPill, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ectoPill, Theme.Panel2, Theme.Bg, 90)
	Kit.new("UIScale", { Parent = ectoPill })
	local orb: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, -12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = ectoPill,
	})
	Kit.Corner(orb, UDim.new(1, 0))
	Kit.Stroke(orb, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(orb, Theme.Ecto, Theme.Ecto2, 135)
	local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.3, 0.24), Position = UDim2.fromScale(0.26, 0.2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3, ZIndex = 4, Parent = orb })
	Kit.Corner(shine, UDim.new(1, 0))
	if Icons.Get("ecto") then
		-- uploaded Ectoplasm icon replaces the drawn orb
		orb.BackgroundTransparency = 1
		shine.Visible = false
		local st = orb:FindFirstChildOfClass("UIStroke")
		if st then
			st.Enabled = false
		end
		local g = orb:FindFirstChildOfClass("UIGradient")
		if g then
			g.Enabled = false
		end
		Kit.Icon(orb, "ecto", "", { Size = UDim2.fromScale(1.15, 1.15), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 })
	end
	ectoLabel = Kit.Label(ectoPill, "0", { Size = UDim2.new(1, -46, 1, 0), Position = UDim2.fromOffset(40, 0), Color = Theme.Ecto, Style = "Currency", Fit = true })
	-- crew power
	local power: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(170, 22),
		Position = UDim2.new(0.5, 10, 0, 52),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.25,
		Parent = screen,
	})
	Kit.Corner(power, UDim.new(1, 0))
	local powerIcon = Icons.Get("power") ~= nil
	if powerIcon then
		Kit.Icon(power, "power", "", { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 2, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 3 })
	end
	powerPrefix = if powerIcon then "" else "⚡ "
	powerLabel = Kit.Label(power, powerPrefix .. "0 POWER", { Size = UDim2.new(1, if powerIcon then -30 else -12, 1, 0), Position = UDim2.fromOffset(if powerIcon then 26 else 6, 0), Color = Theme.Gold, Style = "Small", Fit = true })
	-- boosts (only while active)
	boostHolder = Kit.new("Frame", {
		Size = UDim2.fromOffset(340, 22),
		Position = UDim2.new(0.5, 10, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), Parent = boostHolder })
end

local MENU = {
	{ Name = "Hunters", Icon = "🔦", Text = "HUNTERS", Color = "Orange" },
	{ Name = "Worlds", Icon = "🌍", Text = "WORLDS", Color = "Teal" },
	{ Name = "Index", Icon = "📖", Text = "INDEX", Color = "Blue" },
	{ Name = "Upgrades", Icon = "🧲", Text = "UPGRADES", Color = "Green" },
	{ Name = "Shop", Icon = "🛒", Text = "SHOP", Color = "Pink" },
	{ Name = "Daily", Icon = "🎁", Text = "DAILY", Color = "Purple" },
}
local CELL_MAX = 70
local CELL_MIN = 50
local GAP = 6
local menuScale: UIScale

-- One vertical column down the left edge. Buttons are as big as CELL_MAX allows; on short
-- screens (phone landscape) the whole column shrinks so it fits between the top bar and the
-- bottom edge (it starts under the top-left Roblox buttons).
local function layoutMenu()
	local n = #MENU
	local full = CELL_MAX * n + GAP * (n - 1)
	local logical = Kit.LogicalSize()
	local compact = Kit.IsCompact()
	local top = if compact then 56 else 0
	local room = logical.Y - top - 12
	local fit = math.clamp(room / full, CELL_MIN / CELL_MAX, 1)
	menuScale.Scale = fit
	menu.Size = UDim2.fromOffset(CELL_MAX, full)
	if compact or full * fit > logical.Y - 120 then
		menu.Position = UDim2.fromOffset(8, top)
		menu.AnchorPoint = Vector2.zero
	else
		menu.Position = UDim2.new(0, 10, 0.5, 0)
		menu.AnchorPoint = Vector2.new(0, 0.5)
	end
end

local function buildMenu(screen: ScreenGui)
	menu = Kit.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Parent = screen,
	})
	menuScale = Kit.new("UIScale", { Parent = menu })
	Kit.new("UIListLayout", {
		Padding = UDim.new(0, GAP),
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	for i, m in MENU do
		local b = Kit.Button(menu, {
			Text = "",
			Color = m.Color,
			OnClick = function()
				Hud.Open(m.Name)
			end,
		})
		b.LayoutOrder = i
		b.Size = UDim2.fromOffset(CELL_MAX, CELL_MAX)
		Kit.Icon(b, "menu_" .. string.lower(m.Name), m.Icon, { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 6), Style = "Icon", TextSize = 30, Stroke = 0, ZIndex = 3 })
		Kit.Label(b, m.Text, { Size = UDim2.new(1, -4, 0, 16), Position = UDim2.new(0, 2, 1, -21), Style = "Tiny", TextSize = 12, Fit = true, ZIndex = 3 })
		Hud.Buttons[m.Name] = b
	end
	-- red "!" on DAILY when a reward is waiting
	dailyBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, 5, 0, -5),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Bad,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Daily,
	})
	Kit.Corner(dailyBadge, UDim.new(1, 0))
	Kit.Stroke(dailyBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(dailyBadge, "!", { Style = "Small", ZIndex = 11 })
	layoutMenu()
	Kit.ScaleChanged:Connect(layoutMenu)
end

-- Settings panel (gear, top right)
local function buildSettings(screen: ScreenGui)
	local panel = Kit.Panel("Settings", "SETTINGS", Vector2.new(400, 290), "Gray")
	local list: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel.Body, ZIndex = 61 })
	Kit.new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = list })
	local toggles = {
		{ Key = "Music", Text = "MUSIC" },
		{ Key = "Sfx", Text = "SOUND EFFECTS" },
		{ Key = "FastReveal", Text = "FAST CRATE OPENING" },
	}
	local buttons: { [string]: TextButton } = {}
	for _, t in toggles do
		local b = Kit.Button(list, {
			Text = t.Text,
			Color = "Green",
			Size = UDim2.fromOffset(320, 44),
			ZIndex = 62,
			OnClick = function()
				local d = State.Data
				if not d then
					return
				end
				local res = State.Request("Setting", t.Key, not d.Settings[t.Key])
				if not res.ok then
					Kit.Toast(res.err or "Couldn't change that", "Bad")
				end
			end,
		})
		buttons[t.Key] = b
	end
	State.OnData(function(d)
		for _, t in toggles do
			local on = d.Settings[t.Key] == true
			local b = buttons[t.Key]
			b:SetAttribute("Color", if on then "Green" else "Gray")
			Kit.SetButtonText(b, t.Text .. (if on then ": ON" else ": OFF"))
		end
	end)
	Hud.RegisterPanel("Settings", function()
		panel:Toggle()
	end)
	local gear = Kit.Button(screen, {
		Text = if Icons.Get("menu_settings") then "" else "⚙",
		Color = "Gray",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, -10, 0.5, -48),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Heading",
		OnClick = function()
			panel:Toggle()
		end,
	})
	if Icons.Get("menu_settings") then
		Kit.Icon(gear, "menu_settings", "", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 })
	end
end

-- AUTO ATTACK toggle: only shown to Auto Attack pass owners. The server checks ownership.
local busyAuto = false
local function refreshAuto()
	local d = State.Data
	local owned = d ~= nil and d.Passes ~= nil and d.Passes[Config.AutoAttack.Pass] == true
	autoButton.Visible = owned
	local on = player:GetAttribute("AutoAttack") == true
	Kit.SetButtonText(autoButton, if on then "🤖 AUTO: ON" else "🤖 AUTO: OFF")
	autoButton:SetAttribute("Color", if on then "Green" else "Gray")
end

local function buildAuto(screen: ScreenGui)
	autoButton = Kit.Button(screen, {
		Text = "🤖 AUTO: OFF",
		Color = "Gray",
		Size = UDim2.fromOffset(132, 40),
		Position = UDim2.new(1, -10, 0.5, 4),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Small",
		OnClick = function()
			if busyAuto then
				return
			end
			busyAuto = true
			local on = player:GetAttribute("AutoAttack") == true
			local res = State.Request("AutoAttack", not on)
			busyAuto = false
			if not res.ok then
				Kit.Toast(res.err or "Couldn't switch Auto Attack", "Bad")
			else
				Kit.Toast(if res.On then "AUTO ATTACK ON: your crew picks nearby ghosts" else "AUTO ATTACK OFF: tap a ghost to attack", "Good")
			end
		end,
	})
	autoButton.Name = "AutoAttack"
	autoButton.Visible = false
	player:GetAttributeChangedSignal("AutoAttack"):Connect(refreshAuto)
	State.OnData(function()
		refreshAuto()
	end)
end

local function buildBanners()
	local overlay = Kit.Overlay()
	bannerLabel = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(640, 48),
		Position = UDim2.fromScale(0.5, 0.27),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Ecto,
		Style = "Banner",
		Fit = true,
		ZIndex = 70,
	})
	bannerLabel.TextTransparency = 1
	bannerSub = Kit.Label(overlay, "", {
		Size = UDim2.fromOffset(560, 24),
		Position = UDim2.new(0.5, 0, 0.27, 30),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Theme.Text,
		Style = "Body",
		Fit = true,
		ZIndex = 70,
	})
	bannerSub.TextTransparency = 1
	announceFrame = Kit.new("Frame", {
		Size = UDim2.fromOffset(500, 36),
		Position = UDim2.new(0.5, 0, 0, -60),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 75,
		Parent = overlay,
	})
	Kit.Corner(announceFrame, UDim.new(0, 12))
	Kit.Stroke(announceFrame, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(announceFrame, Theme.Gold, Color3.fromRGB(255, 120, 40), 0)
	local l = Kit.Label(announceFrame, "", { Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(10, 0), Style = "Body", Fit = true, ZIndex = 76 })
	l.Name = "Text"
	-- ✕ (or tapping the bar anywhere) dismisses the announcement right away
	local function dismiss()
		announceToken += 1
		local my = announceToken
		Kit.Tween(announceFrame, 0.2, { Position = UDim2.new(0.5, 0, 0, -60) })
		task.delay(0.2, function()
			if announceToken == my then
				announceFrame.Visible = false
			end
		end)
	end
	local tap: TextButton = Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 77, Parent = announceFrame })
	tap.Activated:Connect(dismiss)
	Kit.Label(announceFrame, "✕", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -6, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Style = "Body", ZIndex = 78 })
end

local bannerToken = 0
-- Centre-screen title (zone names, NEW AREA UNLOCKED!). The one place for big text.
function Hud.Banner(title: string, sub: string?, color: Color3?)
	bannerToken += 1
	local my = bannerToken
	bannerLabel.Text = title
	bannerLabel.TextColor3 = color or Theme.Ecto
	bannerSub.Text = sub or ""
	local s1 = bannerLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
	local s2 = bannerSub:FindFirstChildOfClass("UIStroke") :: UIStroke
	bannerLabel.TextTransparency = 1
	bannerSub.TextTransparency = 1
	s1.Transparency = 1
	s2.Transparency = 1
	local sc = bannerLabel:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = bannerLabel })
	sc.Scale = 0.6
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.Tween(bannerLabel, 0.3, { TextTransparency = 0 })
	Kit.Tween(s1, 0.3, { Transparency = 0 })
	Kit.Tween(bannerSub, 0.3, { TextTransparency = 0 })
	Kit.Tween(s2, 0.3, { Transparency = 0 })
	task.delay(2.4, function()
		if bannerToken ~= my then
			return
		end
		Kit.Tween(bannerLabel, 0.45, { TextTransparency = 1 })
		Kit.Tween(s1, 0.45, { Transparency = 1 })
		Kit.Tween(bannerSub, 0.45, { TextTransparency = 1 })
		Kit.Tween(s2, 0.45, { Transparency = 1 })
	end)
end

-- Sliding top announcement (legendary hatches, boss events).
function Hud.Announce(text: string, c1: Color3?, c2: Color3?)
	announceToken += 1
	local my = announceToken
	local l = announceFrame:FindFirstChild("Text") :: TextLabel
	l.Text = text
	local g = announceFrame:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(c1 or Theme.Gold, c2 or Color3.fromRGB(255, 120, 40))
	-- below the boss bar / goal chip so event warnings never stack on top of each other
	announceFrame.Visible = true
	Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, 174) }, Enum.EasingStyle.Back)
	task.delay(4, function()
		if announceToken == my then
			Kit.Tween(announceFrame, 0.3, { Position = UDim2.new(0.5, 0, 0, -60) })
			task.wait(0.3)
			if announceToken == my then
				announceFrame.Visible = false -- parked off-screen must not peek under the top bar
			end
		end
	end)
end

local boostLabels: { [string]: TextLabel } = {}
local function refreshBoosts()
	local d = State.Data
	if not d then
		return
	end
	local now = State.Now()
	for id, def in Config.Boosts :: any do
		if type(def) ~= "table" then
			continue
		end
		local expiry = d.Boosts[id]
		local left = if expiry then expiry - now else 0
		local l = boostLabels[id]
		if left > 0 then
			if not l then
				local f: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Theme.Panel2, BackgroundTransparency = 0.1, Parent = boostHolder })
				Kit.Corner(f, UDim.new(1, 0))
				l = Kit.Label(f, "", { Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0), Color = Theme.Ecto, Style = "Tiny", Fit = true })
				boostLabels[id] = l
			end
			(l :: TextLabel).Text = def.Icon .. " " .. def.Name .. " " .. Format.Time(left)
		elseif l then
			(l.Parent :: Instance):Destroy()
			boostLabels[id] = nil
		end
	end
	local info = d.DailyInfo
	if info then
		local canClaim = info.CanClaim or info.Wait - (now - (d.ServerTime or now)) <= 0
		dailyBadge.Visible = canClaim
	end
end

local seeded = false
local function onData(d: any)
	powerLabel.Text = powerPrefix .. Format.Short(d.CrewPower or 0) .. " POWER"
	targetEcto = d.Ecto
	if not seeded then
		-- first snapshot: show the balance as-is (no count-up from 0 on every join)
		seeded = true
		shownEcto = d.Ecto
		ectoLabel.Text = Format.Short(d.Ecto)
	end
	refreshBoosts()
end

local lastZone = 0
local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

function Hud.Init()
	local screen = Kit.Screen()
	Kit.SetSound(function(name)
		Sound.Play(name)
	end)
	buildTop(screen)
	buildMenu(screen)
	buildSettings(screen)
	buildAuto(screen)
	buildBanners()
end

function Hud.Start()
	State.OnData(onData)
	State.EctoChanged:Connect(function(new: number, old: number)
		targetEcto = new
		if new > old then
			floatText("+" .. Format.Short(new - old), Theme.Ecto)
			local sc = ectoPill:FindFirstChildOfClass("UIScale") :: UIScale
			sc.Scale = 1.1
			Kit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
	-- smooth count-up
	RunService.RenderStepped:Connect(function(dt: number)
		if shownEcto ~= targetEcto then
			local diff = targetEcto - shownEcto
			local step = diff * math.min(1, dt * 10)
			if math.abs(diff) < 1 or math.abs(step) < 1 then
				shownEcto = targetEcto
			else
				shownEcto += step
			end
			ectoLabel.Text = Format.Short(math.floor(shownEcto + 0.5))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshBoosts()
			-- zone banner when walking into a different zone
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
				if idx ~= lastZone then
					if lastZone ~= 0 then
						local z = Config.Zones[idx]
						Hud.Banner(z.Name, nil, z.Accent)
					end
					lastZone = idx
				end
			end
		end
	end)
	State.OnFx("Toast", function(data: any)
		Kit.Toast(data.Text, data.Color)
	end)
	State.OnFx("Announce", function(data: any)
		local r = Config.Rarities[data.Color]
		Hud.Announce(data.Text, r and r.Color, r and r.Color2)
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">HuntersPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTERS inventory: grid of cards (portrait, name, rarity, Capture Power, equipped/locked
-- badges), an inspect pane with a 3D preview, EQUIP / UNEQUIP / EQUIP BEST / LOCK / RELEASE,
-- sort by power or rarity, and a release mode with "select weak" for clearing storage.
-- Cards are cached per hunter uid, so data updates only touch what changed.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)

local HuntersPanel = {}

type Card = {
	Frame: TextButton,
	Equip: Frame,
	Lock: TextLabel,
	Select: Frame,
}

local panel: Kit.Panel
local grid: ScrollingFrame
local cards: { [string]: Card } = {}
local equippedLabel: TextLabel
local powerLabel: TextLabel
local storageLabel: TextLabel
local sortButton: TextButton
local releaseButton: TextButton
local equipBestButton: TextButton
local top: Frame
local actionsRow: Frame
local side: Frame
-- inspect pane
local inspect: ScrollingFrame
local viewHolder: Frame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local rarityRibbon: Frame
local statLabel: TextLabel
local blurbLabel: TextLabel
local equipButton: TextButton
local lockButton: TextButton
local relOneButton: TextButton
local emptyHint: TextLabel
-- release mode
local releaseBar: Frame
local releaseConfirm: TextButton
local releaseMode = false
local selected: { [string]: boolean } = {}
local inspectUid: string? = nil
local sortMode = "Power"
local spinModel: Model? = nil
local spinConn: RBXScriptConnection? = nil

local function powerOf(id: string): number
	local h = Config.Hunters[id]
	return if h then h.Power else 0
end

local function rarityOf(id: string): Config.RarityDef
	return Config.Rarities[Config.Hunters[id].Rarity]
end

local function crateRefund(id: string): number
	local def = Config.Hunters[id]
	local zone = Config.ZoneById[def.Zone]
	local crate = zone and Config.Crates[zone.Crate]
	return if crate then math.floor(crate.Price * Config.Inventory.ReleaseRefund) else 0
end

local function sortedUids(d: any): { string }
	local uids = {}
	for uid in d.Hunters do
		table.insert(uids, uid)
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	table.sort(uids, function(a, b)
		if eq[a] ~= eq[b] then
			return eq[a] == true
		end
		local ha, hb = d.Hunters[a].Id, d.Hunters[b].Id
		local pa, pb = powerOf(ha), powerOf(hb)
		local ra, rb = rarityOf(ha).Order, rarityOf(hb).Order
		if sortMode == "Rarity" and ra ~= rb then
			return ra > rb
		end
		if pa ~= pb then
			return pa > pb
		end
		if ra ~= rb then
			return ra > rb
		end
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	return uids
end

local previewUid: string? = nil

local function clearPreview()
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in viewHolder:GetChildren() do
		if c:IsA("ViewportFrame") then
			c:Destroy()
		end
	end
	spinModel = nil
	previewUid = nil
end

local function setInspect(uid: string?)
	inspectUid = uid
	local d = State.Data
	local h = uid and d and d.Hunters[uid]
	inspect.Visible = h ~= nil and not releaseMode
	emptyHint.Visible = not inspect.Visible and not releaseMode
	if not h or not d or not uid then
		clearPreview()
		return
	end
	local def = Config.Hunters[h.Id]
	local rar = rarityOf(h.Id)
	-- the 3D preview is only rebuilt when you pick a different hunter (not on every update)
	if previewUid ~= uid then
		clearPreview()
		previewUid = uid
		local _, model = Portrait.Viewport(viewHolder, h.Id, false)
		spinModel = model
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				if spinModel then
					spinModel:PivotTo(CFrame.Angles(0, math.sin((os.clock() - t0) * 0.8) * 0.6, 0))
				end
			end)
		end
	end
	nameLabel.Text = string.upper(def.Name)
	rarityLabel.Text = rar.Name
	local g = rarityRibbon:FindFirstChildOfClass("UIGradient") :: UIGradient
	g.Color = ColorSequence.new(rar.Color, rar.Color2)
	statLabel.Text = "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER"
	blurbLabel.Text = def.Blurb
	local isEq = table.find(d.Equipped, uid) ~= nil
	Kit.SetButtonText(equipButton, if isEq then "UNEQUIP" else "EQUIP")
	equipButton:SetAttribute("Color", if isEq then "Red" else "Green")
	Kit.SetButtonText(lockButton, if h.Locked then "🔓 UNLOCK" else "🔒 LOCK")
	relOneButton.Visible = not isEq and not h.Locked
	Kit.SetButtonText(relOneButton, "RELEASE +" .. Format.Short(crateRefund(h.Id)))
end

local function updateReleaseBar()
	local d = State.Data
	local n, refund = 0, 0
	if d then
		for uid in selected do
			local h = d.Hunters[uid]
			if h then
				n += 1
				refund += crateRefund(h.Id)
			else
				selected[uid] = nil
			end
		end
	end
	Kit.SetButtonText(releaseConfirm, "RELEASE " .. n .. "  (+💚" .. Format.Short(refund) .. ")")
	releaseConfirm:SetAttribute("Color", if n > 0 then "Red" else "Gray")
end

local function makeCard(uid: string, hunterId: string): Card
	local def = Config.Hunters[hunterId]
	local rar = rarityOf(hunterId)
	local f: TextButton = Kit.new("TextButton", {
		Name = uid,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 63,
		Parent = grid,
	})
	Kit.Corner(f, UDim.new(0, 16))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(f, rar.Color, rar.Color2, 90)
	if rar.Order >= 5 then
		-- legendary cards shimmer
		local shine: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, ZIndex = 63, Parent = f })
		Kit.Corner(shine, UDim.new(0, 16))
		local sg = Kit.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1) }),
			Rotation = 25,
			Parent = shine,
		})
		task.spawn(function()
			while shine.Parent do
				sg.Offset = Vector2.new(-1, 0)
				Kit.Tween(sg, 1.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear)
				task.wait(2.4)
			end
		end)
	end
	local pic: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(30, 18, 55),
		BackgroundTransparency = 0.35,
		ZIndex = 64,
		Parent = f,
	})
	Kit.Corner(pic, UDim.new(1, 0))
	Portrait.Face(pic, hunterId, false)
	Kit.Label(f, string.upper(def.Name), { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
	Kit.Label(f, "⚡" .. Format.Short(def.Power), { Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 98), ZIndex = 66, Color = Theme.Gold, Style = "Body", Fit = true })
	local eqBadge: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.fromOffset(-5, -5),
		BackgroundColor3 = Theme.Good,
		Visible = false,
		ZIndex = 68,
		Parent = f,
	})
	Kit.Corner(eqBadge, UDim.new(1, 0))
	Kit.Stroke(eqBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(eqBadge, "✓", { Style = "Body", ZIndex = 69 })
	local lock = Kit.Label(f, "🔒", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, 2, 0, -3), AnchorPoint = Vector2.new(1, 0), ZIndex = 68, Stroke = 0, Style = "Small" })
	lock.Visible = false
	local sel: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bad, BackgroundTransparency = 0.45, Visible = false, ZIndex = 70, Parent = f })
	Kit.Corner(sel, UDim.new(0, 12))
	Kit.Label(sel, "✖", { Style = "Title", ZIndex = 71 })
	f.Activated:Connect(function()
		Kit.Play("Click")
		if releaseMode then
			local d = State.Data
			local h = d and d.Hunters[uid]
			if not h or h.Locked or table.find(d.Equipped, uid) then
				Kit.Toast("Equipped or locked hunters can't be released", "Bad")
				return
			end
			if selected[uid] then
				selected[uid] = nil
			else
				selected[uid] = true
			end
			sel.Visible = selected[uid] == true
			updateReleaseBar()
		else
			setInspect(uid)
		end
	end)
	return { Frame = f, Equip = eqBadge, Lock = lock, Select = sel }
end

local BATCH = 24 -- new cards per frame: a 150-hunter inventory opens without a hitch
local rebuildQueued = false

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local created = 0
	-- remove cards for hunters that are gone
	for uid, c in cards do
		if not d.Hunters[uid] then
			c.Frame:Destroy()
			cards[uid] = nil
			selected[uid] = nil
		end
	end
	local eq: { [string]: boolean } = {}
	for _, uid in d.Equipped do
		eq[uid] = true
	end
	for i, uid in sortedUids(d) do
		local h = d.Hunters[uid]
		local c = cards[uid]
		if not c then
			if created >= BATCH then
				-- finish the rest next frame
				if not rebuildQueued then
					rebuildQueued = true
					task.spawn(function()
						task.wait() -- next frame
						rebuildQueued = false
						if panel.IsOpen then
							rebuild()
						end
					end)
				end
				continue
			end
			created += 1
			c = makeCard(uid, h.Id)
			cards[uid] = c
		end
		c.Frame.LayoutOrder = i
		c.Equip.Visible = eq[uid] == true
		c.Lock.Visible = h.Locked == true
		c.Select.Visible = releaseMode and selected[uid] == true
	end
	local count = State.CountOwned()
	local slots = d.Slots or Config.Inventory.BaseSlots
	equippedLabel.Text = "EQUIPPED " .. #d.Equipped .. "/" .. slots
	powerLabel.Text = "⚡ " .. Format.Short(d.CrewPower or 0)
	storageLabel.Text = "STORAGE " .. count .. "/" .. Config.Inventory.MaxHunters
	storageLabel.TextColor3 = if count >= Config.Inventory.MaxHunters - 5 then Theme.Bad else Theme.Muted
	if inspectUid and not d.Hunters[inspectUid] then
		inspectUid = nil
	end
	setInspect(inspectUid)
	if releaseMode then
		updateReleaseBar()
	end
end

local function setReleaseMode(on: boolean)
	releaseMode = on
	table.clear(selected)
	releaseBar.Visible = on
	Kit.SetButtonText(releaseButton, if on then "DONE" else "RELEASE")
	releaseButton:SetAttribute("Color", if on then "Gray" else "Red")
	rebuild()
end

local function act(action: string, ...: any)
	local res = State.Request(action, ...)
	if not res.ok then
		Kit.Toast(res.err or "Couldn't do that", "Bad")
	end
	return res
end

function HuntersPanel.Init()
	panel = Kit.Panel("Hunters", "GHOST HUNTERS", Vector2.new(860, 500), "Orange")
	local body = panel.Body
	-- top bar: counts on the left, actions on the right (actions drop to a 2nd row when narrow)
	top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 10), BackgroundTransparency = 1, ZIndex = 61, Parent = body })
	equippedLabel = Kit.Label(top, "EQUIPPED 0/4", { Size = UDim2.fromOffset(150, 22), Position = UDim2.fromOffset(0, 0), Align = Enum.TextXAlignment.Left, Style = "Heading", Fit = true, ZIndex = 62 })
	powerLabel = Kit.Label(top, "⚡ 0", { Size = UDim2.fromOffset(120, 22), Position = UDim2.fromOffset(152, 0), Align = Enum.TextXAlignment.Left, Color = Theme.Gold, Style = "Heading", Fit = true, ZIndex = 62 })
	storageLabel = Kit.Label(top, "STORAGE 0/150", { Size = UDim2.fromOffset(200, 16), Position = UDim2.fromOffset(0, 25), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0, ZIndex = 62 })
	actionsRow = Kit.new("Frame", { Size = UDim2.new(0, 400, 0, 40), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 61, Parent = top })
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = actionsRow })
	local buttons = actionsRow
	sortButton = Kit.Button(buttons, {
		Text = "SORT: POWER",
		Color = "Blue",
		Size = UDim2.fromOffset(124, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			sortMode = if sortMode == "Power" then "Rarity" else "Power"
			Kit.SetButtonText(sortButton, "SORT: " .. string.upper(sortMode))
			rebuild()
		end,
	})
	releaseButton = Kit.Button(buttons, {
		Text = "RELEASE",
		Color = "Red",
		Size = UDim2.fromOffset(100, 38),
		TextStyle = "Small",
		ZIndex = 62,
		OnClick = function()
			setReleaseMode(not releaseMode)
		end,
	})
	equipBestButton = Kit.Button(buttons, {
		Text = "EQUIP BEST",
		Color = "Green",
		Size = UDim2.fromOffset(140, 38),
		ZIndex = 62,
		OnClick = function()
			local res = act("EquipBest")
			if res.ok then
				Kit.Toast("Best crew equipped! ⚡ " .. Format.Commas(res.Power or 0), "Good")
			end
		end,
	})
	equipBestButton.Name = "EquipBest"
	panel.Primary = equipBestButton
	-- grid
	grid = Kit.new("ScrollingFrame", {
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.5,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.Corner(grid, UDim.new(0, 12))
	Kit.Padding(grid, 8)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(100, 122),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	-- inspect pane (scrolls, so it fits short phone screens)
	side = Kit.new("Frame", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	emptyHint = Kit.Label(side, "Tap a hunter to inspect it.\n\nEQUIP BEST picks your strongest crew!", { Size = UDim2.new(1, -24, 0.6, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	inspect = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		ZIndex = 63,
		Parent = side,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = inspect })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = inspect })
	viewHolder = Kit.new("Frame", { Size = UDim2.fromOffset(150, 132), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 63, Parent = inspect })
	nameLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 64 })
	nameLabel.LayoutOrder = 2
	rarityRibbon = Kit.new("Frame", { Size = UDim2.fromOffset(150, 22), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 3, ZIndex = 64, Parent = inspect })
	Kit.Corner(rarityRibbon, UDim.new(1, 0))
	Kit.Stroke(rarityRibbon, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(rarityRibbon, Theme.Panel2, Theme.Panel, 0)
	rarityLabel = Kit.Label(rarityRibbon, "", { Style = "Small", ZIndex = 65 })
	statLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 20), Color = Theme.Gold, Style = "Body", Fit = true, ZIndex = 64 })
	statLabel.LayoutOrder = 4
	blurbLabel = Kit.Label(inspect, "", { Size = UDim2.new(1, 0, 0, 0), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	blurbLabel.AutomaticSize = Enum.AutomaticSize.Y
	blurbLabel.LayoutOrder = 5
	local actions: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 86), BackgroundTransparency = 1, LayoutOrder = 6, ZIndex = 63, Parent = inspect })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = actions })
	equipButton = Kit.Button(actions, {
		Text = "EQUIP",
		Color = "Green",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			if not d or not uid then
				return
			end
			if table.find(d.Equipped, uid) then
				act("Unequip", uid)
			else
				act("Equip", uid)
			end
		end,
	})
	equipButton.LayoutOrder = 1
	lockButton = Kit.Button(actions, {
		Text = "🔒 LOCK",
		Color = "Blue",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local d = State.Data
			local uid = inspectUid
			local h = uid and d and d.Hunters[uid]
			if h then
				act("Lock", uid, not h.Locked)
			end
		end,
	})
	lockButton.LayoutOrder = 2
	relOneButton = Kit.Button(actions, {
		Text = "RELEASE",
		Color = "Red",
		TextStyle = "Small",
		ZIndex = 64,
		OnClick = function()
			local uid = inspectUid
			if uid then
				act("Release", { uid })
			end
		end,
	})
	relOneButton.LayoutOrder = 3
	-- release bar (replaces the inspect pane in release mode)
	releaseBar = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 63, Parent = side })
	Kit.Label(releaseBar, "Tap hunters to select them. Released hunters give back a little Ectoplasm.", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 8), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 64, Stroke = 0 })
	Kit.Button(releaseBar, {
		Text = "SELECT WEAK",
		Color = "Orange",
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.fromOffset(10, 74),
		ZIndex = 64,
		OnClick = function()
			-- every unequipped, unlocked hunter weaker than your weakest equipped one
			local d = State.Data
			if not d then
				return
			end
			local weakest = math.huge
			for _, uid in d.Equipped do
				local h = d.Hunters[uid]
				if h then
					weakest = math.min(weakest, powerOf(h.Id))
				end
			end
			table.clear(selected)
			for uid, h in d.Hunters do
				if not h.Locked and not table.find(d.Equipped, uid) and powerOf(h.Id) < weakest then
					selected[uid] = true
				end
			end
			rebuild()
		end,
	})
	releaseConfirm = Kit.Button(releaseBar, {
		Text = "RELEASE 0",
		Color = "Gray",
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0, 10, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 64,
		OnClick = function()
			local list = {}
			for uid in selected do
				table.insert(list, uid)
			end
			if #list == 0 then
				return
			end
			local res = act("Release", list)
			if res.ok then
				table.clear(selected)
				rebuild()
			end
		end,
	})
	Hud.RegisterPanel("Hunters", function()
		panel:Toggle()
	end)
end

-- Responsive layout from the panel's actual (logical) width: the inspect pane takes ~30%,
-- and the action buttons move under the counters when the panel is narrow.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local narrow = w < 700
	local topH = if narrow then 88 else 44
	top.Size = UDim2.new(1, 0, 0, topH)
	if narrow then
		actionsRow.AnchorPoint = Vector2.zero
		actionsRow.Position = UDim2.fromOffset(0, 46)
		actionsRow.Size = UDim2.new(1, 0, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Left
		end
	else
		actionsRow.AnchorPoint = Vector2.new(1, 0)
		actionsRow.Position = UDim2.fromScale(1, 0)
		actionsRow.Size = UDim2.new(0, 400, 0, 40)
		local list = actionsRow:FindFirstChildOfClass("UIListLayout")
		if list then
			list.HorizontalAlignment = Enum.HorizontalAlignment.Right
		end
	end
	local sideW = math.clamp(math.floor(w * 0.3), 200, 260)
	local y = topH + 16
	grid.Position = UDim2.fromOffset(0, y)
	grid.Size = UDim2.new(1, -(sideW + 8), 1, -y)
	side.Position = UDim2.new(1, 0, 0, y)
	side.Size = UDim2.new(0, sideW, 1, -y)
end

function HuntersPanel.Start()
	panel.OnOpen:Connect(function()
		layout()
		rebuild()
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if releaseMode then
			setReleaseMode(false)
		end
		clearPreview()
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
end

function HuntersPanel.EquipBestButton(): TextButton
	return equipBestButton
end

function HuntersPanel.IsOpen(): boolean
	return panel.IsOpen
end

return HuntersPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--!strict
-- HUNTER INDEX: discovery tracking per zone ("HAUNTED NEIGHBORHOOD 3/4 DISCOVERED"),
-- overall completion %, silhouettes for unknown hunters, a 3D preview for known ones and a
-- NEW! indicator (menu badge + card sticker) for discoveries you haven't looked at yet.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Portrait = require(Client.UI.Portrait)
local Hud = require(script.Parent.Hud)
local CratePanel = require(script.Parent.CratePanel)

local IndexPanel = {}

local panel: Kit.Panel
local scroll: ScrollingFrame
local totalLabel: TextLabel
local totalFill: Frame
local bar: Frame
local side: Frame
local detail: ScrollingFrame
local detailView: Frame
local detailName: TextLabel
local detailInfo: TextLabel
local detailBlurb: TextLabel
local menuBadge: Frame
local newIds: { [string]: boolean } = {}
local spinConn: RBXScriptConnection? = nil
local lastKey = ""

local function hunterList(zoneId: string): { Config.HunterDef }
	local out = {}
	local crate = Config.Crates[(Config.ZoneById[zoneId] :: Config.ZoneDef).Crate]
	for _, e in crate.Pool do
		table.insert(out, Config.Hunters[e.Hunter])
	end
	return out
end

local function oddsOf(h: Config.HunterDef): number
	local zone = Config.ZoneById[h.Zone]
	local crate = Config.Crates[zone.Crate]
	local odds = Rules.Odds(crate.Pool :: any, function(id)
		return Config.Rarities[Config.Hunters[id].Rarity].Order
	end, 1, Config.LuckAffectsFromOrder)
	return odds[h.Id] or 0
end

local function showDetail(h: Config.HunterDef, found: boolean)
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	for _, c in detailView:GetChildren() do
		c:Destroy()
	end
	detail.Visible = true
	local rar = Config.Rarities[h.Rarity]
	local crate = Config.Crates[(Config.ZoneById[h.Zone] :: Config.ZoneDef).Crate]
	if found then
		local _, model = Portrait.Viewport(detailView, h.Id, false)
		if model then
			local t0 = os.clock()
			spinConn = RunService.RenderStepped:Connect(function()
				model:PivotTo(CFrame.Angles(0, (os.clock() - t0) * 0.9, 0))
			end)
		end
		detailName.Text = string.upper(h.Name)
		detailBlurb.Text = h.Blurb
	else
		Portrait.Viewport(detailView, h.Id, true)
		detailName.Text = "???"
		detailBlurb.Text = "Not discovered yet. Keep opening crates!"
	end
	detailName.TextColor3 = rar.Color
	detailInfo.Text = rar.Name .. "  •  ⚡ " .. (if found then Format.Commas(h.Power) else "?") .. "\n" .. crate.Name .. "  •  " .. Format.Percent(oddsOf(h))
end

local function rebuild()
	local d = State.Data
	if not d then
		return
	end
	local key = ""
	for _, z in Config.Zones do
		for _, h in hunterList(z.Id) do
			key ..= (if d.Discovered[h.Id] then "1" else "0") .. (if newIds[h.Id] then "n" else "")
		end
	end
	if key == lastKey then
		return
	end
	lastKey = key
	for _, c in scroll:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local total, found = 0, 0
	for zi, z in Config.Zones do
		local list = hunterList(z.Id)
		local zf = 0
		for _, h in list do
			if d.Discovered[h.Id] then
				zf += 1
			end
		end
		total += #list
		found += zf
		local section: Frame = Kit.new("Frame", {
			Size = UDim2.new(1, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.45,
			LayoutOrder = zi,
			ZIndex = 62,
			Parent = scroll,
		})
		Kit.Corner(section, UDim.new(0, 12))
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = section })
		Kit.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = section })
		local unlocked = d.Zones[z.Id] == true
		local complete = zf == #list
		local header: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 62, Parent = section })
		Kit.Label(header, (if unlocked then "" else "🔒 ") .. z.Name, { Size = UDim2.new(0.6, 0, 1, 0), Align = Enum.TextXAlignment.Left, Color = z.Accent, Style = "Heading", Fit = true, ZIndex = 63 })
		Kit.Label(header, (if complete then "★ " else "") .. zf .. "/" .. #list .. " DISCOVERED", { Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), Align = Enum.TextXAlignment.Right, Color = if complete then Theme.Gold else Theme.Text, Style = "Small", Fit = true, ZIndex = 63 })
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 62, Parent = section })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 124), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		for _, h in list do
			local rar = Config.Rarities[h.Rarity]
			local known = d.Discovered[h.Id] == true
			local card: TextButton = Kit.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 63,
				Parent = row,
			})
			Kit.Corner(card, UDim.new(0, 12))
			Kit.Stroke(card, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
			if known then
				Kit.Gradient(card, rar.Color, rar.Color2, 90)
			else
				Kit.Gradient(card, Color3.fromRGB(70, 60, 100), Color3.fromRGB(40, 32, 66), 90)
			end
			local pic: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 18, 55), BackgroundTransparency = 0.35, ZIndex = 64, Parent = card })
			Kit.Corner(pic, UDim.new(1, 0))
			Portrait.Face(pic, h.Id, not known)
			Kit.Label(card, if known then string.upper(h.Name) else "???", { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 80), ZIndex = 66, Style = "Small", Fit = true })
			Kit.Label(card, rar.Name, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 100), ZIndex = 66, Color = if known then Color3.new(1, 1, 1) else rar.Color, Style = "Tiny", Fit = true })
			if newIds[h.Id] then
				local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(46, 18), Position = UDim2.new(1, 6, 0, -6), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Body", ZIndex = 70, Stroke = 2 })
				stamp.Rotation = 12
			end
			card.Activated:Connect(function()
				Kit.Play("Click")
				if newIds[h.Id] then
					newIds[h.Id] = nil
					menuBadge.Visible = next(newIds) ~= nil
				end
				showDetail(h, known)
			end)
		end
	end
	local pct = if total > 0 then found / total else 0
	totalLabel.Text = found .. " / " .. total .. " DISCOVERED  •  " .. math.floor(pct * 100 + 0.5) .. "%"
	Kit.Tween(totalFill, 0.4, { Size = UDim2.fromScale(math.max(pct, 0.02), 1) })
end

function IndexPanel.Init()
	panel = Kit.Panel("Index", "HUNTER INDEX", Vector2.new(860, 500), "Blue")
	local body = panel.Body
	bar = Kit.new("Frame", { Size = UDim2.new(1, -270, 0, 28), Position = UDim2.fromOffset(0, 12), BackgroundColor3 = Theme.Bg, ZIndex = 62, Parent = body })
	Kit.Corner(bar, UDim.new(1, 0))
	Kit.Stroke(bar, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	totalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = bar })
	Kit.Corner(totalFill, UDim.new(1, 0))
	Kit.Gradient(totalFill, Theme.Ecto, Theme.Ecto2, 0)
	totalLabel = Kit.Label(bar, "COLLECTION", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Body", Fit = true, ZIndex = 64 })
	scroll = Kit.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 50),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Panel3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	side = Kit.new("Frame", { Position = UDim2.new(1, 0, 0, 12), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.5, ZIndex = 62, Parent = body })
	Kit.Corner(side, UDim.new(0, 12))
	Kit.Label(side, "Tap a card to take a closer look!", { Size = UDim2.new(1, -24, 0, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 63, Stroke = 0 })
	detail = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 64,
		Parent = side,
	})
	Kit.Corner(detail, UDim.new(0, 12))
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = detail })
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = detail })
	detailView = Kit.new("Frame", { Size = UDim2.fromOffset(160, 160), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 65, Parent = detail })
	detailName = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 22), Style = "Heading", Fit = true, ZIndex = 66 })
	detailName.LayoutOrder = 2
	detailInfo = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Text, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailInfo.AutomaticSize = Enum.AutomaticSize.Y
	detailInfo.LayoutOrder = 3
	detailBlurb = Kit.Label(detail, "", { Size = UDim2.new(1, 0, 0, 0), ZIndex = 66, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Stroke = 0 })
	detailBlurb.AutomaticSize = Enum.AutomaticSize.Y
	detailBlurb.LayoutOrder = 4
	-- NEW badge on the INDEX menu button
	menuBadge = Kit.new("Frame", {
		Size = UDim2.fromOffset(36, 18),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Ecto,
		Visible = false,
		ZIndex = 10,
		Parent = Hud.Buttons.Index,
	})
	Kit.Corner(menuBadge, UDim.new(1, 0))
	Kit.Stroke(menuBadge, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Label(menuBadge, "NEW", { Style = "Tiny", ZIndex = 11 })
	Hud.RegisterPanel("Index", function()
		panel:Toggle()
	end)
end

-- Side pane takes ~30% of the panel's actual width; sections wrap their cards.
local function layout()
	local w = panel.Root.Size.X.Offset - 28
	local sideW = math.clamp(math.floor(w * 0.3), 190, 250)
	bar.Size = UDim2.new(1, -(sideW + 10), 0, 28)
	scroll.Size = UDim2.new(1, -(sideW + 10), 1, -50)
	side.Size = UDim2.new(0, sideW, 1, -12)
end

function IndexPanel.Start()
	panel.OnOpen:Connect(function()
		layout()
		lastKey = ""
		detail.Visible = false
		rebuild()
	end)
	Kit.ScaleChanged:Connect(function()
		if panel.IsOpen then
			layout()
		end
	end)
	panel.OnClose:Connect(function()
		if spinConn then
			spinConn:Disconnect()
			spinConn = nil
		end
		-- looked at the index: discoveries are no longer "new"
		table.clear(newIds)
		menuBadge.Visible = false
	end)
	State.Changed:Connect(function()
		if panel.IsOpen then
			rebuild()
		end
	end)
	CratePanel.Opened:Connect(function(res: any)
		if res.IsNew then
			newIds[res.Hunter] = true
			menuBadge.Visible = true
		end
	end)
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[--!strict
-- Ectoplasm orbs (visual only; the server owns values and decides pickups).
--   Drops   → orbs pop out of the poof on an arc, bounce twice, then hover and glow.
--   Pickup  → as soon as an orb is inside your pickup radius it starts accelerating toward you
--             (predicted locally so it feels instant); it is "eaten" when the server confirms
--             the pickup (Collect). Unconfirmed orbs wait at your side briefly, then go back.
-- One RenderStepped loop moves every orb with BulkMoveTo; parts are pooled.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Orbs = {}

type Orb = {
	Id: number,
	Part: BasePart,
	Value: number,
	Start: Vector3,
	Land: Vector3,
	T0: number,
	FlyDur: number,
	Phase: string, -- Fly | Rest | Magnet | Held | Fade
	Confirmed: boolean,
	MagnetT0: number,
	MagnetFrom: Vector3,
	HeldT0: number,
	NoPredictUntil: number,
	ExpireAt: number,
	Spin: number,
	Size: number,
	Pos: Vector3,
}

local player = Players.LocalPlayer
local orbs: { [number]: Orb } = {}
local pool: { BasePart } = {}
local folder: Folder
local hidden = CFrame.new(0, -500, 0)
local streak = 0
local lastPickup = 0
local ring: Part
local ringGui: SurfaceGui
local ringStroke: UIStroke
local ringAlpha = 0
local collectedSignal = Signal.new()
Orbs.Collected = collectedSignal -- (amount)

local GREEN = Theme.Ecto
local CYAN = Theme.Ecto2

local function getPart(): BasePart
	local p = table.remove(pool)
	if p then
		p.Transparency = 0.05
		return p
	end
	local b = Instance.new("Part")
	b.Name = "Ecto"
	b.Shape = Enum.PartType.Ball
	b.Material = Enum.Material.Neon
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.CastShadow = false
	b.Transparency = 0.05
	b.CFrame = hidden
	b.Parent = folder
	return b
end

local function release(o: Orb)
	orbs[o.Id] = nil
	o.Part.CFrame = hidden
	if #pool < 300 then
		table.insert(pool, o.Part)
	else
		o.Part:Destroy()
	end
end

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function radius(): number
	local d = State.Data
	return if d and d.PickupRadius then d.PickupRadius else Config.Upgrades.PickupRadius.Levels[1]
end

local function spawnDrops(origin: Vector3, list: { any }, removed: { number }?)
	local now = os.clock()
	-- the server retired these (too many uncollected orbs): fade them out like a timeout
	if type(removed) == "table" then
		for _, id in removed do
			local old = orbs[id]
			if old and old.Phase ~= "Magnet" and old.Phase ~= "Held" then
				old.Phase = "Fade"
				old.T0 = now
			end
		end
	end
	for i, item in list do
		local id, land, value = item[1], item[2], item[3]
		if type(id) ~= "number" or typeof(land) ~= "Vector3" or type(value) ~= "number" or orbs[id] then
			continue
		end
		-- size by value relative to your best area (ZoneMultiplier ~ typical income there), so
		-- boss and big drops stand out in every zone instead of all late orbs being max size
		local rel = value / math.max(1, (State.Data and State.Data.ZoneMultiplier) or 1)
		local size = math.clamp(0.9 + 0.35 * math.log10(math.max(1, rel)), 0.9, 1.9)
		local part = getPart()
		part.Size = Vector3.new(size, size, size)
		part.Color = GREEN:Lerp(CYAN, math.random() * 0.6)
		local o: Orb = {
			Id = id,
			Part = part,
			Value = value,
			Start = origin,
			Land = land,
			T0 = now + (i - 1) * 0.025, -- tiny stagger so a burst "sprays"
			FlyDur = 0.45 + math.random() * 0.25,
			Phase = "Fly",
			Confirmed = false,
			MagnetT0 = 0,
			MagnetFrom = origin,
			HeldT0 = 0,
			NoPredictUntil = 0,
			ExpireAt = now + Config.Drops.Lifetime,
			Spin = math.random() * 6.28,
			Size = size,
			Pos = origin,
		}
		orbs[id] = o
	end
	-- ectoplasm splash where the ghost popped
	Effects.Burst(origin, { Color = GREEN, Color2 = CYAN, Count = math.min(6 + #list * 2, 30), Size = 0.7, Speed = 14, Life = 0.5, Gravity = 25 })
	Sound.Play("Drop", 0.1)
end

local function startMagnet(o: Orb)
	if o.Phase == "Magnet" or o.Phase == "Held" or o.Phase == "Fade" then
		return
	end
	o.Phase = "Magnet"
	o.MagnetT0 = os.clock()
	o.MagnetFrom = o.Pos
end

local function eat(o: Orb, at: Vector3)
	local now = os.clock()
	if now - lastPickup < 0.6 then
		streak = math.min(streak + 1, 14)
	else
		streak = 0
	end
	lastPickup = now
	Effects.Burst(at, { Color = o.Part.Color, Count = 5, Size = 0.45, Speed = 6, Life = 0.35 })
	Sound.Play("Pickup", 0.02, 1 + streak * 0.045) -- rising pitch on a pickup streak
	release(o)
	collectedSignal:Fire(o.Value)
end

local function onCollect(ids: { number }, _total: number)
	for _, id in ids do
		local o = orbs[id]
		if o then
			o.Confirmed = true
			if o.Phase == "Held" then
				local r = rootPart()
				eat(o, if r then r.Position else o.Pos)
			else
				startMagnet(o)
			end
		end
	end
end

local parts: { BasePart } = {}
local cframes: { CFrame } = {}

local function step(dt: number)
	local now = os.clock()
	local root = rootPart()
	local rpos = if root then root.Position else nil
	local rad = radius()
	local r2 = rad * rad
	local nearCount = 0
	table.clear(parts)
	table.clear(cframes)
	for _, o in orbs do
		local pos: Vector3
		if o.Phase == "Fly" then
			local a = math.clamp((now - o.T0) / o.FlyDur, 0, 1)
			local dist = (o.Land - o.Start).Magnitude
			local arc = (2.5 + dist * 0.35) * 4 * a * (1 - a)
			pos = o.Start:Lerp(o.Land, a) + Vector3.new(0, arc, 0)
			if a >= 1 then
				o.Phase = "Rest"
				o.T0 = now
			end
		elseif o.Phase == "Rest" then
			local b = now - o.T0
			local bounce = 0
			if b < 0.5 then
				local k = b / 0.5
				bounce = math.abs(math.sin(k * math.pi * 2)) * 1.3 * (1 - k)
			end
			pos = o.Land + Vector3.new(0, 0.35 + bounce + math.sin(now * 3 + o.Spin) * 0.22, 0)
			if now >= o.ExpireAt then
				o.Phase = "Fade"
				o.T0 = now
			elseif rpos and now >= o.NoPredictUntil then
				local dx, dz = pos.X - rpos.X, pos.Z - rpos.Z
				if dx * dx + dz * dz <= r2 and math.abs(pos.Y - rpos.Y) < 14 then
					startMagnet(o)
				end
			end
			if rpos and (pos - rpos).Magnitude < rad + 25 then
				nearCount += 1
			end
		elseif o.Phase == "Magnet" then
			local a = math.clamp((now - o.MagnetT0) / Config.Drops.FlyTime, 0, 1)
			local target = if rpos then rpos else o.MagnetFrom
			local e = a * a -- accelerate in
			pos = o.MagnetFrom:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 2, 0)
			if a >= 1 then
				if o.Confirmed then
					eat(o, target)
					continue
				end
				o.Phase = "Held"
				o.HeldT0 = now
			end
		elseif o.Phase == "Held" then
			pos = if rpos then rpos else o.Pos
			if now - o.HeldT0 > 1.2 then
				-- server didn't agree (moved away too fast?) - send it back to where it was
				o.Phase = "Rest"
				o.T0 = now - 1
				o.NoPredictUntil = now + 1.5
				pos = o.Land
			end
		else -- Fade
			local a = math.clamp((now - o.T0) / 0.4, 0, 1)
			local s = o.Size * (1 - a)
			o.Part.Size = Vector3.new(s, s, s) + Vector3.new(0.05, 0.05, 0.05)
			pos = o.Land + Vector3.new(0, 0.35, 0)
			if a >= 1 then
				release(o)
				continue
			end
		end
		o.Pos = pos
		table.insert(parts, o.Part)
		-- hidden while held at the player (waiting for the server)
		table.insert(cframes, if o.Phase == "Held" then hidden else CFrame.new(pos) * CFrame.Angles(0, now * 2 + o.Spin, 0))
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- pickup radius ring: fades in while orbs are lying around nearby
	local want = if nearCount > 0 and rpos then 1 else 0
	ringAlpha += (want - ringAlpha) * math.min(1, dt * 6)
	if rpos and ringAlpha > 0.02 then
		local d = rad * 2
		if math.abs(ring.Size.X - d) > 0.05 then
			ring.Size = Vector3.new(d, 0.1, d)
			local pps = math.clamp(math.floor(600 / d), 6, 30)
			ringGui.PixelsPerStud = pps
			ringStroke.Thickness = math.max(2, 0.4 * pps)
		end
		ring.CFrame = CFrame.new(rpos.X, rpos.Y - 2.85, rpos.Z)
		ringStroke.Transparency = 1 - 0.55 * ringAlpha
		ringGui.Enabled = true
	elseif ringGui.Enabled then
		ringGui.Enabled = false
		ring.CFrame = hidden
	end
end

function Orbs.Count(): number
	local n = 0
	for _, o in orbs do
		if o.Phase == "Rest" or o.Phase == "Fly" then
			n += 1
		end
	end
	return n
end

function Orbs.Nearest(pos: Vector3): Vector3?
	local best, bestD = nil, math.huge
	for _, o in orbs do
		if o.Phase == "Rest" then
			local d = (o.Pos - pos).Magnitude
			if d < bestD then
				best, bestD = o.Pos, d
			end
		end
	end
	return best
end

function Orbs.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHOrbs"
	folder.Parent = workspace
	ring = Instance.new("Part")
	ring.Name = "PickupRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Size = Vector3.new(28, 0.1, 28)
	ring.CFrame = hidden
	ring.Parent = folder
	ringGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Top,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Brightness = 2,
		Enabled = false,
		Parent = ring,
	})
	local circle: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = ringGui })
	Kit.Corner(circle, UDim.new(1, 0))
	ringStroke = Kit.new("UIStroke", { Thickness = 6, Color = GREEN, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = circle })
end

function Orbs.Start()
	Net.Event("Drops").OnClientEvent:Connect(spawnDrops)
	Net.Event("Collect").OnClientEvent:Connect(onCollect)
	RunService.RenderStepped:Connect(step)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Crate opening cinematic. Plays on a private stage far from the map with a scripted camera:
--   crate drops in → bounces → shakes (rare+: levitates while rarity energy converges) →
--   locks pop → lid flies open → light burst → the hunter leaps out and poses → result card.
-- Intensity comes from Config.Rarities (RevealPause, ShakeIntensity, Particles, Darken,
-- CameraPunch). Commons are quick; "Fast crate opening" in settings shortens everything; SKIP
-- jumps straight to the result. Every step is written as anim(duration, apply(alpha)) so a
-- skip simply applies each step's end state.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Signal = require(GH.Signal)
local HunterRig = require(GH.Rigs.HunterRig)
local CrateRig = require(GH.Rigs.CrateRig)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local Targeting = require(script.Parent.Targeting)

local Reveal = {}

export type Result = {
	Crate: string,
	Hunter: string,
	Uid: string,
	IsNew: boolean,
}

local player = Players.LocalPlayer
local STAGE = Vector3.new(0, 900, -2500)
local CAM_FOV = 50

local playing = false
local skipping = false
local stage: Folder? = nil
local gui: ScreenGui? = nil
local cc: ColorCorrectionEffect? = nil
local rays: Frame? = nil
local raySpeed = 20
local poseConn: RBXScriptConnection? = nil
local hunterRig: HunterRig.Rig? = nil
local hunterState = "Idle"
local againFn: (() -> ())? = nil
local liveTweens: { Tween } = {}
local shakeToken = 0
local cardShown = false
local okButton: TextButton? = nil

-- Tweens the reveal starts are tracked so closing it can stop them (no lingering darkening
-- or FOV changes after a quick SKIP + OK).
local function tween(obj: Instance, info: TweenInfo, props: { [string]: any }): Tween
	local tw = TweenService:Create(obj, info, props)
	table.insert(liveTweens, tw)
	tw:Play()
	return tw
end
local finishedSignal = Signal.new()
Reveal.Finished = finishedSignal -- (result)
local startedSignal = Signal.new()
Reveal.Started = startedSignal

function Reveal.IsPlaying(): boolean
	return playing
end

local function fast(): boolean
	local d = State.Data
	return d ~= nil and d.Settings.FastReveal == true
end

-- Runs fn(alpha) every frame for `t` seconds (alpha 0→1). On skip: fn(1) immediately.
local function anim(t: number, fn: (number) -> ())
	if skipping or t <= 0 then
		fn(1)
		return
	end
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / t, 0, 1)
		fn(a)
		if a >= 1 or skipping then
			if skipping then
				fn(1)
			end
			return
		end
		RunService.RenderStepped:Wait()
	end
end

local function easeOutBack(a: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end

local function easeOutBounce(a: number): number
	local n1, d1 = 7.5625, 2.75
	if a < 1 / d1 then
		return n1 * a * a
	elseif a < 2 / d1 then
		a -= 1.5 / d1
		return n1 * a * a + 0.75
	elseif a < 2.5 / d1 then
		a -= 2.25 / d1
		return n1 * a * a + 0.9375
	end
	a -= 2.625 / d1
	return n1 * a * a + 0.984375
end

local controls: any = nil
local function setControls(on: boolean)
	if not controls then
		local ok, mod = pcall(function()
			local ps = player:WaitForChild("PlayerScripts")
			return (require :: any)(ps:WaitForChild("PlayerModule"))
		end)
		if ok and mod then
			controls = mod:GetControls()
		end
	end
	if controls then
		pcall(function()
			if on then
				controls:Enable()
			else
				controls:Disable()
			end
		end)
	end
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = stage
	return p
end

local function buildStage(rarity: Config.RarityDef)
	local f = Instance.new("Folder")
	f.Name = "GHReveal"
	f.Parent = workspace
	stage = f
	-- floor disc with glowing trim
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 18, 18), Color = Color3.fromRGB(45, 28, 80), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 19, 19), Color = rarity.Color, Material = Enum.Material.Neon, CFrame = CFrame.new(STAGE - Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	-- backdrop with spinning rays (SurfaceGui, unaffected by lighting)
	local back = part({ Size = Vector3.new(70, 44, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 6, 14)) })
	local sg: SurfaceGui = Kit.new("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 14,
		LightInfluence = 0,
		Brightness = 1,
		Parent = back,
	})
	local bg: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sg })
	Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 40)),
			ColorSequenceKeypoint.new(0.5, rarity.Color2:Lerp(Color3.fromRGB(40, 20, 70), 0.55)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 10, 40)),
		}),
		Rotation = 90,
		Parent = bg,
	})
	local holder: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(1400, 1400),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = bg,
	})
	-- six full-length bars through the centre = twelve rays (GUI rotation pivots on the centre)
	for i = 0, 5 do
		local ray: Frame = Kit.new("Frame", {
			Size = UDim2.new(0, 110, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Rotation = i * 30,
			Parent = holder,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.15),
				NumberSequenceKeypoint.new(0.58, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
	end
	rays = holder
	-- lights
	local l1 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 7, -6)) })
	Kit.new("PointLight", { Range = 22, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 255), Parent = l1 })
	local l2 = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 3, 3)) })
	Kit.new("PointLight", { Name = "RarityLight", Range = 16, Brightness = 0, Color = rarity.Color, Parent = l2 })
end

local function buildGui(): (ScreenGui, TextButton)
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = "GHRevealGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Kit.new("UIScale", { Scale = Kit.UIScale(), Parent = g })
	local skip = Kit.Button(g, {
		Text = "SKIP ⏩",
		Color = "Gray",
		Size = UDim2.fromOffset(110, 40),
		Position = UDim2.new(1, -16, 1, -16),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 5,
		OnClick = function()
			skipping = true
		end,
	})
	gui = g
	return g, skip
end

local function flash(color: Color3, t: number)
	local g = gui
	if not g then
		return
	end
	local f: Frame = Kit.new("Frame", { Size = UDim2.fromScale(4, 4), Position = UDim2.fromScale(-1.5, -1.5), BackgroundColor3 = color, BackgroundTransparency = 0.1, ZIndex = 20, Parent = g })
	Kit.Tween(f, t, { BackgroundTransparency = 1 })
	task.delay(t, function()
		f:Destroy()
	end)
end

local function cameraShake(intensity: number, t: number)
	local cam = workspace.CurrentCamera
	if not cam or skipping then
		return
	end
	local my = shakeToken
	local base = cam.CFrame
	anim(t, function(a)
		if my ~= shakeToken or not playing then
			return
		end
		local k = intensity * (1 - a)
		cam.CFrame = base * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end)
	if my == shakeToken and playing then
		cam.CFrame = base
	end
end

local function resultCard(g: ScreenGui, res: Result, rarity: Config.RarityDef)
	local def = Config.Hunters[res.Hunter]
	local d = State.Data
	local card: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(470, 196),
		Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = g,
	})
	Kit.Corner(card, UDim.new(0, 18))
	Kit.Stroke(card, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(card, Theme.Panel2, Theme.Bg, 90)
	local sc = Kit.new("UIScale", { Scale = 0.3, Parent = card })
	Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- rarity ribbon
	local ribbon: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(200, 32),
		Position = UDim2.new(0.5, 0, 0, -16),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 12,
		Parent = card,
	})
	Kit.Corner(ribbon, UDim.new(0, 10))
	Kit.Stroke(ribbon, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(ribbon, rarity.Color, rarity.Color2, 0)
	Kit.Label(ribbon, rarity.Name, { Style = "Heading", ZIndex = 13 })
	Kit.Label(card, string.upper(def.Name), { Size = UDim2.new(1, -30, 0, 30), Position = UDim2.fromOffset(15, 22), Style = "Title", Fit = true, ZIndex = 11 })
	Kit.Label(card, "⚡ " .. Format.Commas(def.Power) .. " CAPTURE POWER", { Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 54), Color = Theme.Gold, Style = "Body", ZIndex = 11 })
	Kit.Label(card, def.Blurb, { Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 76), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 11, Stroke = 0 })
	if res.IsNew then
		local stamp = Kit.Label(card, "NEW!", { Size = UDim2.fromOffset(80, 30), Position = UDim2.new(1, 8, 0, 4), AnchorPoint = Vector2.new(1, 0), Color = Theme.Ecto, Style = "Title", ZIndex = 14 })
		stamp.Rotation = 14
		local ssc = Kit.new("UIScale", { Scale = 3, Parent = stamp })
		Kit.Tween(ssc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	-- buttons
	local row: Frame = Kit.new("Frame", {
		Size = UDim2.new(1, -30, 0, 46),
		Position = UDim2.new(0, 15, 1, -58),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = card,
	})
	Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), Parent = row })
	local equipped = d and table.find(d.Equipped, res.Uid) ~= nil
	local slots = if d then d.Slots or Config.Inventory.BaseSlots else Config.Inventory.BaseSlots
	if d and not equipped then
		local free = #d.Equipped < slots
		-- with full slots, offer EQUIP BEST only if this hunter beats the weakest equipped one
		local weakest = math.huge
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h then
				weakest = math.min(weakest, Config.Hunters[h.Id].Power)
			end
		end
		if free or def.Power > weakest then
			local b: TextButton
			b = Kit.Button(row, {
				Text = if free then "EQUIP" else "EQUIP BEST",
				Color = "Green",
				Size = UDim2.fromOffset(140, 44),
				ZIndex = 12,
				OnClick = function()
					local r = if free then State.Request("Equip", res.Uid) else State.Request("EquipBest")
					if r.ok then
						Kit.SetButtonText(b, "EQUIPPED ✓")
						b:SetAttribute("Color", "Gray")
						b.Active = false
					else
						Kit.Toast(r.err or "Couldn't equip", "Bad")
					end
				end,
			})
			b.Name = "EquipButton"
		end
	end
	if againFn then
		local crate = Config.Crates[res.Crate]
		local fnAgain = againFn
		Kit.Button(row, {
			Text = "AGAIN 💚" .. Format.Short(crate.Price),
			Color = "Purple",
			Size = UDim2.fromOffset(150, 44),
			ZIndex = 12,
			OnClick = function()
				fnAgain()
			end,
		})
	end
	okButton = Kit.Button(row, {
		Text = "OK",
		Color = "Blue",
		Size = UDim2.fromOffset(100, 44),
		ZIndex = 12,
		OnClick = function()
			Reveal.Close()
		end,
	})
end

local function teardownStage()
	shakeToken += 1
	for _, tw in liveTweens do
		tw:Cancel()
	end
	table.clear(liveTweens)
	cardShown = false
	okButton = nil
	if poseConn then
		poseConn:Disconnect()
		poseConn = nil
	end
	if stage then
		stage:Destroy()
		stage = nil
	end
	if gui then
		gui:Destroy()
		gui = nil
	end
	hunterRig = nil
	rays = nil
end

-- Ends the reveal and gives the camera back.
function Reveal.Close()
	if not playing then
		return
	end
	teardownStage()
	if cc then
		cc.Brightness = 0
		cc.Saturation = 0
		cc.Contrast = 0
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
	Kit.Screen().Enabled = true
	setControls(true)
	Targeting.SetBlocked(false)
	ProximityPromptService.Enabled = Kit.CurrentPanel() == nil
	ContextActionService:UnbindAction("GHRevealB")
	if GuiService.SelectedObject and not GuiService.SelectedObject:IsDescendantOf(Kit.Screen()) then
		GuiService.SelectedObject = nil
	end
	playing = false
	finishedSignal:Fire()
end

-- Plays the opening for a server-confirmed result. `again` (optional) re-buys the same crate.
function Reveal.Play(res: Result, again: (() -> ())?)
	local def = Config.Hunters[res.Hunter]
	local crateDef = Config.Crates[res.Crate]
	if not def or not crateDef then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	againFn = again
	if playing then
		teardownStage() -- "AGAIN": keep the camera, rebuild the stage
	end
	playing = true
	skipping = false
	startedSignal:Fire()
	Targeting.SetBlocked(true)
	setControls(false)
	Kit.Screen().Enabled = false
	ProximityPromptService.Enabled = false -- station prompts would float over the cinematic
	ContextActionService:BindActionAtPriority("GHRevealB", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			if cardShown then
				Reveal.Close()
			else
				skipping = true
			end
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.ButtonB)
	buildStage(rarity)
	local g, skip = buildGui()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = CAM_FOV
	local camCF = CFrame.lookAt(STAGE + Vector3.new(0, 4.6, -13), STAGE + Vector3.new(0, 2.6, 0))
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0)) -- lighting detail follows Focus
	flash(Color3.new(1, 1, 1), 0.35)

	local f = if fast() then 0.5 else 1
	local my = stage

	-- crate
	local crate = CrateRig.Build(res.Crate)
	crate.Model:ScaleTo(1.25)
	crate.Model.Parent = stage
	local base = CFrame.new(STAGE)
	local function placeCrate(cf: CFrame)
		crate.Model:PivotTo(cf)
	end
	placeCrate(base + Vector3.new(0, 9, 0))

	-- rays spin + hunter poses
	raySpeed = 20
	local hunterT0 = os.clock()
	poseConn = RunService.RenderStepped:Connect(function(dt: number)
		if rays then
			rays.Rotation = (rays.Rotation + dt * raySpeed) % 360
		end
		if hunterRig then
			HunterRig.Pose(hunterRig, hunterState, os.clock() - hunterT0, 1)
		end
	end)

	Sound.Play("CrateBuy")
	-- 1) drop in with a bounce
	anim(0.45 * f, function(a)
		placeCrate(base + Vector3.new(0, 9 * (1 - easeOutBounce(a)), 0))
	end)
	if stage ~= my then
		return
	end
	-- 2) shake (+ levitate, darken and converging energy for rarer pulls)
	local shakeT = (0.55 + rarity.RevealPause) * f
	local levitate = if rarity.Order >= 3 then 1.4 else 0
	local charge: ParticleEmitter? = nil
	if rarity.RevealPause > 0.3 and not skipping then
		local sphere = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(STAGE + Vector3.new(0, 2.5, 0)) })
		local e = Instance.new("ParticleEmitter")
		e.Shape = Enum.ParticleEmitterShape.Sphere
		e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Texture = Effects.Textures.Sparkle
		e.Color = ColorSequence.new(rarity.Color, rarity.Color2)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) })
		e.Speed = NumberRange.new(9, 12)
		e.Lifetime = NumberRange.new(0.45, 0.6)
		e.Rate = 0
		e.Parent = sphere
		charge = e
	end
	if cc and rarity.Darken > 0 and not skipping then
		tween(cc, TweenInfo.new(shakeT * 0.6), { Brightness = -rarity.Darken * 0.35, Saturation = -rarity.Darken * 0.4 })
	end
	local rl = (if stage then stage:FindFirstChild("RarityLight", true) else nil) :: any
	if not skipping then
		Sound.Play("CrateShake")
	end
	local nextShakeSound = os.clock() + 0.45
	anim(shakeT, function(a)
		local k = rarity.ShakeIntensity * (0.4 + a)
		local tt = os.clock()
		local wob = CFrame.Angles(math.sin(tt * 38) * 0.06 * k, math.sin(tt * 29) * 0.1 * k, math.sin(tt * 47) * 0.09 * k)
		local lift = levitate * math.sin(math.min(a * 1.6, 1) * math.pi / 2)
		placeCrate(base * CFrame.new(math.sin(tt * 53) * 0.12 * k, lift, 0) * wob)
		raySpeed = 20 + 160 * a * rarity.Order / 5
		if charge then
			charge.Rate = 15 + 110 * a
		end
		if rl then
			rl.Brightness = 3 * a * math.min(1, rarity.Order / 3)
		end
		if tt >= nextShakeSound and a < 0.95 then
			nextShakeSound = tt + 0.45
			Sound.Play("CrateShake", 0.1)
		end
	end)
	if charge then
		charge.Rate = 0
	end
	if stage ~= my then
		return
	end
	placeCrate(base + Vector3.new(0, levitate, 0))
	-- 3) locks pop off
	if not skipping then
		Sound.Play("LockPop")
	end
	anim(0.22 * f, function(a)
		local e = easeOutBack(a)
		crate.Motors.LockL.Transform = CFrame.new(-1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, 2.5 * a)
		crate.Motors.LockR.Transform = CFrame.new(1.2 * e, 1.4 * e - 2.5 * a * a, -0.8 * e) * CFrame.Angles(0, 0, -2.5 * a)
	end)
	-- drop the padlocks (and their welded shackles) out of sight
	crate.Motors.LockL.Transform = CFrame.new(0, -60, 0)
	crate.Motors.LockR.Transform = CFrame.new(0, -60, 0)
	-- 4) lid flies open + light burst
	local burstPos = crate.Burst.WorldPosition
	if not skipping then
		Sound.Play(rarity.Sound)
		flash(rarity.Color, 0.45)
		Effects.Flash(burstPos, rarity.Color, 5 + rarity.Order, 0.5)
		Effects.Burst(burstPos, { Color = rarity.Color, Color2 = Color3.new(1, 1, 1), Count = rarity.Particles, Size = 0.9, Speed = 26, Life = 1.1, Gravity = 18 })
		Effects.Ring(STAGE + Vector3.new(0, 0.2, 0), rarity.Color, 10, 0.6)
		if cc then
			tween(cc, TweenInfo.new(0.5), { Brightness = 0.12, Saturation = 0.15 })
			task.delay(0.5, function()
				if cc then
					tween(cc, TweenInfo.new(0.6), { Brightness = 0, Saturation = 0 })
				end
			end)
		end
		if rarity.CameraPunch then
			cam.FieldOfView = CAM_FOV - 10
			tween(cam, TweenInfo.new(0.45, Enum.EasingStyle.Back), { FieldOfView = CAM_FOV })
			task.spawn(cameraShake, 0.5 * rarity.ShakeIntensity, 0.35)
		end
	end
	crate.Glow.Color = rarity.Color
	anim(0.3 * f, function(a)
		crate.Motors.Lid.Transform = CFrame.Angles(math.rad(115) * easeOutBack(a), 0, 0)
		crate.Glow.Transparency = 1 - 0.85 * a
	end)
	if stage ~= my then
		return
	end
	-- 5) hunter leaps out
	local rig = HunterRig.Build(res.Hunter)
	rig.Model:ScaleTo(1.2)
	rig.Model.Parent = stage
	hunterRig = rig
	hunterState = "Celebrate"
	hunterT0 = os.clock()
	local from = STAGE + Vector3.new(0, levitate + 0.6, 0.2)
	local to = STAGE + Vector3.new(0, 0, -3.4)
	anim(0.55 * f, function(a)
		local p = from:Lerp(to, a) + Vector3.new(0, 5.5 * 4 * a * (1 - a), 0)
		local spin = (1 - a) * math.pi * 2
		rig.Model:PivotTo(CFrame.new(p) * CFrame.Angles(0, spin, 0))
	end)
	rig.Model:PivotTo(CFrame.new(to))
	-- the crate settles back down behind the hunter
	placeCrate(base)
	if not skipping then
		Effects.Ring(to + Vector3.new(0, 0.15, 0), Color3.new(1, 1, 1), 5, 0.4)
		Effects.Burst(to + Vector3.new(0, 3, 0), { Color = rarity.Color, Count = math.floor(rarity.Particles / 3), Size = 0.6, Speed = 14, Life = 0.7 })
	end
	if stage ~= my then
		return
	end
	-- 6) legendary title slam
	if rarity.Order >= 5 and not skipping then
		local title = Kit.Label(g, rarity.Name .. "!", { Size = UDim2.fromOffset(600, 70), Position = UDim2.fromScale(0.5, 0.2), AnchorPoint = Vector2.new(0.5, 0.5), Color = rarity.Color, Style = "Banner", TextSize = 54, ZIndex = 8, Stroke = 4 })
		Kit.new("UIGradient", { Color = ColorSequence.new(rarity.Color, rarity.Color2), Rotation = 90, Parent = title })
		local tsc = Kit.new("UIScale", { Scale = 3, Parent = title })
		Kit.Tween(tsc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		task.spawn(cameraShake, 0.35, 0.3)
	end
	skip.Visible = false
	skipping = false
	raySpeed = 25
	cam.CFrame = camCF
	cam.Focus = CFrame.new(STAGE + Vector3.new(0, 2.6, 0))
	resultCard(g, res, rarity)
	cardShown = true
	if okButton and UserInputService.GamepadEnabled and UserInputService:GetLastInputType() == Enum.UserInputType.Gamepad1 then
		GuiService.SelectedObject = okButton
	end
end

function Reveal.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "GHRevealCC"
	effect.Parent = Lighting
	cc = effect
end

function Reveal.Start()
	-- respawning mid-reveal must not leave the camera stuck
	player.CharacterAdded:Connect(function()
		if playing then
			Reveal.Close()
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- SHOP: Robux products (Ectoplasm packs, boosts) and game passes. Items without an id in
-- Config show "SOON". Purchases are prompted and granted by the server only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)

local ShopPanel = {}

local panel: Kit.Panel
local passButtons: { [string]: TextButton } = {}
local ectoLabels: { [string]: TextLabel } = {}

local function card(parent: Instance, order: number, iconKey: string?, icon: string, name: string, sub: string, price: string, available: boolean, color: string, onBuy: () -> ()): (TextButton, TextLabel)
	local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, ZIndex = 62, Parent = parent })
	Kit.Corner(f, UDim.new(0, 14))
	Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local c = Theme.Buttons[color] or Theme.Buttons.Purple
	Kit.Gradient(f, c[1], c[2], 90)
	Kit.Icon(f, iconKey, icon, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), Style = "Icon", TextSize = 32, ZIndex = 63, Stroke = 0 })
	Kit.Label(f, name, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 48), Style = "Body", ZIndex = 63 })
	local subLabel = Kit.Label(f, sub, { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 84), ZIndex = 63, Color = Color3.fromRGB(255, 255, 230), Font = Theme.Body, Style = "Tiny", Stroke = 1 })
	local b = Kit.Button(f, {
		Text = if available then price else "SOON",
		Color = if available then "Green" else "Gray",
		Size = UDim2.new(1, -16, 0, 38),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 64,
		OnClick = onBuy,
	})
	return b, subLabel
end

local function buy(key: string)
	local res = State.Request("Buy", key)
	if not res.ok then
		Kit.Toast(res.err or "Can't buy that right now", "Bad")
	end
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local mult = d.ZoneMultiplier or 1
	for _, p in Config.Products do
		local l = ectoLabels[p.Key]
		if l and p.Amount then
			l.Text = "+" .. Format.Short(p.Amount * mult) .. " ECTOPLASM"
		end
	end
	for _, pass in Config.GamePasses do
		local b = passButtons[pass.Key]
		if b and d.Passes and d.Passes[pass.Key] then
			Kit.SetButtonText(b, "OWNED ✓")
			b:SetAttribute("Color", "Gray")
		end
	end
end

function ShopPanel.Init()
	panel = Kit.Panel("Shop", "SHOP", Vector2.new(780, 500), "Pink")
	local scroll: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 10),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	-- cards wrap to as many rows as the panel width needs
	local function section(order: number, title: string): Frame
		Kit.Label(scroll, title, { Size = UDim2.new(1, 0, 0, 24), Style = "Heading", ZIndex = 62 }).LayoutOrder = order
		local row: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, ZIndex = 61, Parent = scroll })
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 168), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		return row
	end
	local prodRow = section(1, "BOOSTS & ECTOPLASM")
	for i, p in Config.Products do
		local sub = if p.Kind == "Ecto" then "+" .. Format.Short(p.Amount or 0) .. " ECTOPLASM" else Format.Time(p.Seconds or 0) .. " BOOST"
		local _, subLabel = card(prodRow, i, Icons.ForProduct[p.Key], p.Icon, p.Name, sub, p.PriceLabel, p.ProductId ~= nil, if p.Kind == "Ecto" then "Green" else "Purple", function()
			buy(p.Key)
		end)
		if p.Kind == "Ecto" then
			ectoLabels[p.Key] = subLabel
		end
	end
	local passRow = section(3, "GAME PASSES (FOREVER)")
	for i, pass in Config.GamePasses do
		local sub = if pass.Blurb then pass.Blurb elseif pass.Slots then "+" .. pass.Slots .. " EQUIPPED HUNTERS" else "x" .. tostring(pass.Multiplier or 2) .. " ALL ECTOPLASM"
		local b = card(passRow, i, Icons.ForProduct[pass.Key], pass.Icon, pass.Name, sub, pass.PriceLabel, pass.PassId ~= nil, "Orange", function()
			buy(pass.Key)
		end)
		passButtons[pass.Key] = b
	end
	Kit.Label(scroll, "Ectoplasm packs grow with the furthest area you've unlocked. Auto Attack only picks targets for you: same damage, same rewards.", { Size = UDim2.new(1, -10, 0, 36), Color = Theme.Muted, Font = Theme.Body, Style = "Small", ZIndex = 62, Stroke = 0 }).LayoutOrder = 5
	Hud.RegisterPanel("Shop", function()
		panel:Toggle()
	end)
end

function ShopPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds by key from GH.Sounds; respects the player's Music/SFX settings.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Sounds = require(GH.Sounds)
local State = require(script.Parent.Parent.State)

local Sound = {}

local pool: { [string]: { Sound } } = {}
local folder: Folder
local music: Sound? = nil
local bossMusic: Sound? = nil
local lastPlay: { [string]: number } = {}

local function sfxOn(): boolean
	local d = State.Data
	return not d or d.Settings.Sfx ~= false
end

local function make(key: string): Sound?
	local def = Sounds[key]
	if not def or not def.Id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch or 1
	s.Looped = def.Looped == true
	s.Parent = folder
	return s
end

-- pitchJitter adds small random variation; pitchMul shifts the pitch (pickup streaks).
function Sound.Play(key: string, pitchJitter: number?, pitchMul: number?)
	if not sfxOn() then
		return
	end
	local now = os.clock()
	if now - (lastPlay[key] or 0) < 0.035 then
		return -- de-dupe bursts (e.g. 20 orbs landing at once)
	end
	lastPlay[key] = now
	local list = pool[key]
	if not list then
		list = {}
		pool[key] = list
	end
	local s: Sound? = nil
	for _, c in list do
		if not c.IsPlaying then
			s = c
			break
		end
	end
	if not s and #list < 4 then
		s = make(key)
		if s then
			table.insert(list, s)
		end
	end
	if s then
		local def = Sounds[key]
		s.PlaybackSpeed = (def.Pitch or 1) * (pitchMul or 1) * (1 + (if pitchJitter then (math.random() * 2 - 1) * pitchJitter else 0))
		s.TimePosition = 0
		s:Play()
	end
end

local function refreshMusic()
	local d = State.Data
	local on = not d or d.Settings.Music ~= false
	for _, m in { music, bossMusic } do
		if m then
			m.Volume = if on then (Sounds[m.Name].Volume) else 0
		end
	end
end

function Sound.Boss(active: boolean)
	if bossMusic and music then
		if active then
			bossMusic:Play()
			music:Pause()
		else
			bossMusic:Stop()
			music:Resume()
		end
	end
end

function Sound.Init()
	folder = Instance.new("Folder")
	folder.Name = "GHSounds"
	folder.Parent = SoundService
end

function Sound.Start()
	music = make("Music")
	bossMusic = make("BossMusic")
	if music then
		music:Play()
	end
	State.OnData(function()
		refreshMusic()
	end)
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Targeting</string>
              <string name="Source"><![CDATA[--!strict
-- Ghost selection. PC: click a ghost. Mobile: tap a ghost. Console: ButtonX (or F on a
-- keyboard) targets the ghost nearest the centre of the screen and cycles on repeat presses.
-- The selection is optimistic (instant highlight + sound) and then follows the server's
-- authoritative "Target" attribute.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Ghosts = require(script.Parent.Ghosts)
local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)

local Targeting = {}

local player = Players.LocalPlayer
local selectRemote: RemoteEvent
local selectHL: Highlight
local hoverHL: Highlight
local pending: number? = nil
local pendingAt = 0
local blocked = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local selectedSignal = Signal.new()
Targeting.Selected = selectedSignal -- (uid) fired on a local selection

function Targeting.SetBlocked(on: boolean)
	blocked = on
end

function Targeting.Current(): number
	return (player:GetAttribute("Target") :: number?) or 0
end

-- The target your crew should be heading for right now: your fresh tap (before the server
-- confirms it) or the server's choice. Lets your hunters react the instant you tap.
function Targeting.LocalTarget(): number
	return pending or Targeting.Current()
end

local function showHighlight(uid: number)
	local e = if uid ~= 0 then Ghosts.Get(uid) else nil
	if e then
		selectHL.Adornee = e.Model
		selectHL.OutlineColor = e.Def.Glow
		selectHL.FillColor = e.Def.Glow
		selectHL.Enabled = true
		Ghosts.SetSelected(uid)
	else
		selectHL.Adornee = nil
		selectHL.Enabled = false
		Ghosts.SetSelected(0)
	end
end

local function rootPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

function Targeting.Select(uid: number)
	if blocked then
		return
	end
	local e = Ghosts.Get(uid)
	if not e then
		return
	end
	local zone = Config.ZoneById[e.Def.Zone]
	local d = State.Data
	if d and zone and not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " first!", "Bad")
		return
	end
	local p = rootPos()
	if p and (e.Pos - p).Magnitude > Config.Combat.MaxRange + 10 then
		Kit.Toast("Get closer to that ghost!", "Bad")
		return
	end
	pending = uid
	pendingAt = os.clock()
	showHighlight(uid)
	Sound.Play("Select")
	Effects.Ring(e.Pos, e.Def.Glow, 4 * e.Def.Scale, 0.35)
	if Targeting.Current() ~= uid then
		selectRemote:FireServer(uid)
	end
	selectedSignal:Fire(uid)
end

-- `pos` is in GUI coordinates (InputObject.Position, TouchTap) unless `viewport` is true
-- (GetMouseLocation); the matching camera functions keep the top-bar inset consistent.
local function ghostAtScreen(pos: Vector2, viewport: boolean?): Ghosts.Entry?
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Ghosts")
	if not cam or not folder then
		return nil
	end
	rayParams.FilterDescendantsInstances = { folder }
	local ray = if viewport then cam:ViewportPointToRay(pos.X, pos.Y) else cam:ScreenPointToRay(pos.X, pos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams)
	-- (a culled ghost's hitbox isn't moved while parked, so a hit on it is a stale position)
	local hitEntry = if hit then Ghosts.FromInstance(hit.Instance) else nil
	if hitEntry and not hitEntry.Culled then
		return hitEntry
	end
	-- Forgiving fallback (no surgical taps needed): the ghost whose centre is nearest the tap,
	-- within ~8% of the screen. When ghosts overlap, the one nearer the camera wins ties.
	local vp = cam.ViewportSize
	local radius = math.clamp(math.min(vp.X, vp.Y) * 0.08, 40, 72)
	local camPos = cam.CFrame.Position
	local best, bestScore = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Dying or e.Culled then
			continue
		end
		local sp, onScreen
		if viewport then
			sp, onScreen = cam:WorldToViewportPoint(e.Pos)
		else
			sp, onScreen = cam:WorldToScreenPoint(e.Pos)
		end
		if onScreen then
			-- bigger ghosts are bigger targets on screen
			local reach = radius + 12 * e.Def.Scale
			local dist = (Vector2.new(sp.X, sp.Y) - pos).Magnitude
			if dist <= reach then
				local score = dist + 0.15 * (e.Pos - camPos).Magnitude
				if score < bestScore then
					best, bestScore = e, score
				end
			end
		end
	end
	return best
end

-- Console / keyboard: pick the ghost closest to screen centre (within range), cycling.
local function cycleTarget()
	local cam = workspace.CurrentCamera
	local p = rootPos()
	if not cam or not p then
		return
	end
	local list = {}
	local d = State.Data
	for uid, e in Ghosts.All() do
		if e.Dying or (d and not d.Zones[e.Def.Zone]) then
			continue
		end
		if (e.Pos - p).Magnitude <= Config.Combat.MaxRange then
			local sp, onScreen = cam:WorldToViewportPoint(e.Pos)
			if onScreen then
				local c = cam.ViewportSize / 2
				table.insert(list, { Uid = uid, Score = (Vector2.new(sp.X, sp.Y) - c).Magnitude })
			end
		end
	end
	if #list == 0 then
		Kit.Toast("No ghosts nearby!", "Bad")
		return
	end
	table.sort(list, function(a, b)
		return a.Score < b.Score
	end)
	local cur = pending or Targeting.Current()
	local idx = 1
	for i, item in list do
		if item.Uid == cur then
			idx = (i % #list) + 1
			break
		end
	end
	Targeting.Select(list[idx].Uid)
end

function Targeting.Init()
	selectHL = Instance.new("Highlight")
	selectHL.Name = "GHSelect"
	selectHL.FillTransparency = 0.75
	selectHL.OutlineTransparency = 0
	selectHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	selectHL.Enabled = false
	selectHL.Parent = workspace
	hoverHL = Instance.new("Highlight")
	hoverHL.Name = "GHHover"
	hoverHL.FillTransparency = 1
	hoverHL.OutlineColor = Color3.new(1, 1, 1)
	hoverHL.OutlineTransparency = 0.3
	hoverHL.DepthMode = Enum.HighlightDepthMode.Occluded
	hoverHL.Enabled = false
	hoverHL.Parent = workspace
end

function Targeting.Start()
	selectRemote = Net.Event("SelectTarget")

	-- Mouse click (PC). Taps use TouchTap so camera drags never select by accident.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or blocked then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local e = ghostAtScreen(Vector2.new(input.Position.X, input.Position.Y))
			if e then
				Targeting.Select(e.Uid)
			end
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or blocked or #positions == 0 then
			return
		end
		local e = ghostAtScreen(positions[1])
		if e then
			Targeting.Select(e.Uid)
		end
	end)
	ContextActionService:BindAction("GHTarget", function(_, state)
		if state == Enum.UserInputState.Begin and not blocked then
			cycleTarget()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.ButtonX, Enum.KeyCode.F)

	-- authoritative target from the server
	player:GetAttributeChangedSignal("Target"):Connect(function()
		local uid = Targeting.Current()
		pending = nil
		showHighlight(uid)
	end)
	Ghosts.Died:Connect(function(uid)
		if selectHL.Adornee and Targeting.Current() == uid then
			showHighlight(0)
		end
	end)

	-- hover outline (mouse only) + reconcile a rejected optimistic selection
	RunService.RenderStepped:Connect(function()
		if pending and os.clock() - pendingAt > 0.8 then
			pending = nil
			showHighlight(Targeting.Current())
		end
		if not UserInputService.MouseEnabled or blocked then
			hoverHL.Enabled = false
			return
		end
		local m = UserInputService:GetMouseLocation()
		local e = ghostAtScreen(m, true)
		if e and e.Model ~= selectHL.Adornee then
			hoverHL.Adornee = e.Model
			hoverHL.Enabled = true
		else
			hoverHL.Enabled = false
		end
	end)
end

return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time guidance without walls of text:
--   1 TAP A GHOST!  →  2 COLLECT ECTOPLASM!  →  3 OPEN A HUNTER CRATE!  →
--   4 EQUIP YOUR NEW HUNTER!  →  5 UNLOCK THE CEMETERY!  →  done
-- A glowing breadcrumb trail on the ground + a bouncing arrow over the target show where to
-- go; menu buttons pulse when they're the next step. After the tutorial a small NEXT GOAL
-- chip keeps the next zone in view. Progress is saved (server only accepts forward steps).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local WorldLabel = require(Client.UI.WorldLabel)
local Hud = require(script.Parent.Hud)
local Ghosts = require(script.Parent.Ghosts)
local Orbs = require(script.Parent.Orbs)
local Reveal = require(script.Parent.Reveal)
local CratePanel = require(script.Parent.CratePanel)
local HuntersPanel = require(script.Parent.HuntersPanel)
local Boss = require(script.Parent.Boss)
local Sound = require(script.Parent.Sound)

local Tutorial = {}

local player = Players.LocalPlayer
local STEPS = #Config.Tutorial.Steps
local step = 0 -- 0 = not loaded yet
local promptFrame: Frame
local promptLabel: TextLabel
local promptSub: TextLabel
local goalChip: Frame
local goalLabel: TextLabel
local goalFill: Frame
local dots: { BasePart } = {}
local marker: BillboardGui
local markerPart: Part
local guideTarget: (() -> Vector3?)? = nil
local guideUntil = math.huge
local framed = false

local DOTS = 12
local SPACING = 3.6

--------------------------------------------------------------------------------
-- guide (breadcrumbs + marker)
--------------------------------------------------------------------------------
local function setGuide(fn: (() -> Vector3?)?, seconds: number?)
	guideTarget = fn
	guideUntil = if seconds then os.clock() + seconds else math.huge
end
Tutorial.SetGuide = setGuide

local function rootPart(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local hidden = CFrame.new(0, -400, 0)
local dotsHidden = true
local parts: { BasePart } = {}
local cfs: { CFrame } = {}

local function hideDots()
	if dotsHidden then
		return -- nothing to do: no per-frame writes while the guide is off
	end
	dotsHidden = true
	for _, d in dots do
		d.CFrame = hidden
	end
end

local function updateGuide()
	local root = rootPart()
	local target = if guideTarget and os.clock() < guideUntil then guideTarget() else nil
	if not root or not target or Reveal.IsPlaying() then
		hideDots()
		if marker.Enabled then
			marker.Enabled = false
		end
		return
	end
	markerPart.CFrame = CFrame.new(target)
	marker.Enabled = true
	local from = root.Position - Vector3.new(0, 2.7, 0)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 6 then
		hideDots()
		return
	end
	dotsHidden = false
	local dir = flat.Unit
	local t = os.clock()
	local offset = (t * 6) % SPACING -- dots flow toward the target
	local groundEnd = math.min(target.Y, from.Y + 2)
	table.clear(parts)
	table.clear(cfs)
	for i, d in dots do
		local along = 2.5 + (i - 1) * SPACING + offset
		if along > dist - 2 then
			table.insert(parts, d)
			table.insert(cfs, hidden)
		else
			local k = along / dist
			local y = from.Y + (groundEnd - from.Y) * k + 0.35
			local pulse = 0.75 + 0.25 * math.sin(t * 6 - i * 0.6)
			d.Size = Vector3.new(pulse, pulse, pulse)
			table.insert(parts, d)
			table.insert(cfs, CFrame.new(from.X + dir.X * along, y, from.Z + dir.Z * along))
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

--------------------------------------------------------------------------------
-- prompts
--------------------------------------------------------------------------------
local shownText = ""
local function setPrompt(text: string?, sub: string?)
	if not text then
		if promptFrame.Visible then
			promptFrame.Visible = false
			shownText = ""
		end
		return
	end
	promptSub.Text = sub or ""
	promptSub.Visible = sub ~= nil
	if text ~= shownText then
		shownText = text
		promptLabel.Text = text
		promptFrame.Visible = true
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		sc.Scale = 0.5
		Kit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.Play("Select")
	end
end

local function tapWord(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Gamepad1 then
		return "PRESS Ⓧ TO TARGET A GHOST!"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "TAP A GHOST!"
	end
	return "CLICK A GHOST!"
end

local function nearestGhost(): Vector3?
	local root = rootPart()
	if not root then
		return nil
	end
	local d = State.Data
	local best, bestD = nil, math.huge
	for _, e in Ghosts.All() do
		if e.Def.Kind ~= "Event" and (not d or d.Zones[e.Def.Zone]) then
			local dist = (e.Pos - root.Position).Magnitude
			if dist < bestD then
				best, bestD = e, dist
			end
		end
	end
	return if best then best.Pos + Vector3.new(0, 2.5 * best.Def.Scale + 1, 0) else nil
end

local function cratePos(): Vector3?
	local p = Config.Layout.CrateStations.Beginner
	return p + Vector3.new(0, 8, 0)
end

local function gatePos(): Vector3?
	local g = Config.Layout.Gates.Cemetery
	return if g then Vector3.new(0, 10, g.Z - 4) else nil
end

local function advance(to: number)
	if to <= step then
		return
	end
	step = to
	task.spawn(State.Request, "Tutorial", to)
	if to > STEPS then
		setPrompt(nil)
		setGuide(nil)
		Hud.Pulse("Hunters", false)
		Hud.Banner("TUTORIAL COMPLETE!", "Keep hunting, collecting and unlocking!", Theme.Gold)
	end
end

-- Pulsing ring on a button inside a menu: while a menu is open the guidance lives on the
-- button itself (a prompt pill would sit under/over the menu).
local rings: { [GuiObject]: Frame } = {}
local function pulseRing(b: GuiObject, on: boolean)
	local existing = rings[b]
	if on and not existing then
		local ring: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 80, Parent = b })
		Kit.Corner(ring, UDim.new(0, 12))
		local st = Kit.Stroke(ring, 4, Theme.Ecto, Enum.ApplyStrokeMode.Border)
		rings[b] = ring
		task.spawn(function()
			while ring.Parent do
				ring.Size = UDim2.fromScale(1, 1)
				st.Transparency = 0
				Kit.Tween(ring, 0.8, { Size = UDim2.new(1, 20, 1, 20) })
				Kit.Tween(st, 0.8, { Transparency = 1 })
				task.wait(0.9)
			end
		end)
	elseif not on and existing then
		existing:Destroy()
		rings[b] = nil
	end
end

local function setEquipRing(on: boolean)
	pulseRing(HuntersPanel.EquipBestButton(), on)
end

-- One-time camera framing of the nearest ghost for brand-new players.
local function frameGhost()
	if framed then
		return
	end
	framed = true
	local root = rootPart()
	local target = nearestGhost()
	local cam = workspace.CurrentCamera
	if not root or not target or not cam then
		return
	end
	local start = cam.CFrame
	local eye = root.Position + Vector3.new(0, 5, 0) - (target - root.Position).Unit * 10
	local look = CFrame.lookAt(eye, target)
	cam.CameraType = Enum.CameraType.Scriptable
	local tw = TweenService:Create(cam, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { CFrame = look })
	tw:Play()
	tw.Completed:Wait()
	task.wait(0.8)
	local back = TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { CFrame = start })
	back:Play()
	back.Completed:Wait()
	if not Reveal.IsPlaying() then
		cam.CameraType = Enum.CameraType.Custom
	end
end

local collectedOnce = false

local function tick()
	local d = State.Data
	if not d or step == 0 then
		return
	end
	local panel = Kit.CurrentPanel()
	if step > STEPS then
		-- NEXT GOAL chip
		local nextZone: Config.ZoneDef? = nil
		for _, z in Config.Zones do
			if not d.Zones[z.Id] then
				nextZone = z
				break
			end
		end
		local bossState = Boss.State()
		if nextZone and not panel and bossState == "Idle" and not Reveal.IsPlaying() then
			goalChip.Visible = true
			goalLabel.Text = "NEXT: UNLOCK " .. nextZone.Name .. "  " .. Format.Short(math.min(d.Ecto, nextZone.Cost)) .. " / " .. Format.Short(nextZone.Cost)
			goalFill.Size = UDim2.fromScale(math.clamp(d.Ecto / nextZone.Cost, 0.02, 1), 1)
		elseif not nextZone and not panel and bossState == "Idle" and not Reveal.IsPlaying() then
			-- every area open: the goal becomes the full Hunter Index
			local total, found = 0, 0
			for id in Config.Hunters do
				total += 1
				if d.Discovered[id] then
					found += 1
				end
			end
			goalChip.Visible = found < total
			goalLabel.Text = "NEXT: DISCOVER EVERY HUNTER  " .. found .. " / " .. total
			goalFill.Size = UDim2.fromScale(math.clamp(found / math.max(total, 1), 0.02, 1), 1)
		else
			goalChip.Visible = false
		end
		return
	end
	goalChip.Visible = false
	if Reveal.IsPlaying() or (panel ~= nil and panel ~= "Crate" and panel ~= "Hunters") then
		setPrompt(nil)
		return
	end
	local target = (player:GetAttribute("Target") :: number?) or 0
	if step == 1 then
		setPrompt(tapWord())
		setGuide(nearestGhost)
		if target ~= 0 then
			advance(2)
		end
	elseif step == 2 then
		if Orbs.Count() > 0 then
			setPrompt("COLLECT ECTOPLASM!", "Walk close - it flies to you!")
			setGuide(function()
				local root = rootPart()
				return if root then Orbs.Nearest(root.Position) else nil
			end)
		elseif target ~= 0 then
			setPrompt("YOUR HUNTER IS ON IT!", "Ghosts POOF into Ectoplasm")
			setGuide(nil)
		else
			setPrompt(tapWord())
			setGuide(nearestGhost)
		end
		if collectedOnce then
			advance(3)
		end
	elseif step == 3 then
		local price = Config.Crates.Beginner.Price
		if (d.Stats.Crates or 0) >= 1 then
			pulseRing(CratePanel.Button(), false)
			advance(4)
		elseif d.Ecto >= price or (d.FreeCrates.Beginner or 0) > 0 then
			if CratePanel.IsOpen() then
				setPrompt(nil)
				pulseRing(CratePanel.Button(), true)
				setGuide(nil)
			else
				pulseRing(CratePanel.Button(), false)
				setPrompt("OPEN A HUNTER CRATE!", "Follow the trail to the crate")
				setGuide(cratePos)
			end
		else
			setPrompt("COLLECT " .. price .. " ECTOPLASM", Format.Commas(d.Ecto) .. " / " .. price .. "  -  tap more ghosts!")
			setGuide(if target == 0 then nearestGhost else nil)
		end
	elseif step == 4 then
		-- done once a second hunter is equipped (or all you own, if you released the new one)
		if #d.Equipped >= math.min(2, State.CountOwned()) then
			Hud.Pulse("Hunters", false)
			setEquipRing(false)
			advance(5)
		elseif panel == "Hunters" then
			setPrompt(nil)
			Hud.Pulse("Hunters", false)
			setEquipRing(true)
		else
			setPrompt("EQUIP YOUR NEW HUNTER!", "Open HUNTERS")
			Hud.Pulse("Hunters", true)
			setEquipRing(false)
		end
		setGuide(nil)
	elseif step == 5 then
		local zone = Config.ZoneById.Cemetery
		if d.Zones.Cemetery then
			advance(6)
		elseif panel then
			setPrompt(nil)
		elseif d.Ecto >= zone.Cost then
			setPrompt("UNLOCK THE CEMETERY!", "Follow the trail to the gate")
			setGuide(gatePos)
		else
			setPrompt("UNLOCK THE CEMETERY!", Format.Commas(d.Ecto) .. " / " .. Format.Commas(zone.Cost) .. " Ectoplasm  -  open crates, equip the best!")
			setGuide(nil)
		end
	end
end

function Tutorial.Init()
	local screen = Kit.Screen()
	-- compact pill low in the middle of the screen (between the thumbstick and jump button)
	promptFrame = Kit.new("Frame", {
		Name = "TutorialPrompt",
		Size = UDim2.fromOffset(400, 58),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = screen,
	})
	Kit.Corner(promptFrame, UDim.new(0, 14))
	Kit.new("UIScale", { Parent = promptFrame })
	promptLabel = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 28), Position = UDim2.fromOffset(12, 4), Color = Theme.Ecto, Style = "Heading", TextSize = 22, Fit = true, ZIndex = 41 })
	promptSub = Kit.Label(promptFrame, "", { Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(12, 32), Color = Theme.Text, Style = "Small", Fit = true, ZIndex = 41 })
	Kit.Button(promptFrame, {
		Text = "SKIP",
		Color = "Gray",
		Size = UDim2.fromOffset(58, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextStyle = "Tiny",
		ZIndex = 42,
		OnClick = function()
			advance(STEPS + 1)
		end,
	})
	-- pulse the prompt gently
	task.spawn(function()
		local sc = promptFrame:FindFirstChildOfClass("UIScale") :: UIScale
		while true do
			if promptFrame.Visible then
				Kit.Tween(sc, 0.5, { Scale = 1.04 }, Enum.EasingStyle.Sine)
				task.wait(0.5)
				Kit.Tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Sine)
			end
			task.wait(0.5)
		end
	end)
	goalChip = Kit.new("Frame", {
		Size = UDim2.fromOffset(360, 24),
		Position = UDim2.new(0.5, 10, 0, 104),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	})
	Kit.Corner(goalChip, UDim.new(1, 0))
	Kit.Stroke(goalChip, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	goalFill = Kit.new("Frame", { Size = UDim2.fromScale(0.02, 1), BackgroundColor3 = Theme.Ecto, BackgroundTransparency = 0.55, ZIndex = 21, Parent = goalChip })
	Kit.Corner(goalFill, UDim.new(1, 0))
	goalLabel = Kit.Label(goalChip, "", { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Style = "Small", Fit = true, ZIndex = 22 })

	-- breadcrumbs + marker
	local folder = Instance.new("Folder")
	folder.Name = "GHGuide"
	folder.Parent = workspace
	for _ = 1, DOTS do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.9, 0.9, 0.9)
		p.Material = Enum.Material.Neon
		p.Color = Theme.Ecto
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = hidden
		p.Parent = folder
		table.insert(dots, p)
	end
	markerPart = Instance.new("Part")
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(1, 1, 1)
	markerPart.CFrame = hidden
	markerPart.Parent = folder
	-- device-scaled bouncing arrow over the target (always readable, never huge)
	marker = WorldLabel.New({
		Name = "GuideArrow",
		Adornee = markerPart,
		Parent = folder,
		Size = Vector2.new(Theme.World.Marker, Theme.World.Marker),
		Offset = Vector3.new(0, 2.5, 0),
		MaxDistance = 600,
		AlwaysOnTop = true,
	})
	marker.Enabled = false
	local arrow = WorldLabel.Text(marker, "⬇", { Color = Theme.Ecto, Style = "Banner", Stroke = 3 })
	task.spawn(function()
		while true do
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0.2) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
			Kit.Tween(arrow, 0.45, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Sine)
			task.wait(0.45)
		end
	end)
end

function Tutorial.Start()
	Orbs.Collected:Connect(function()
		collectedOnce = true
	end)
	RunService.RenderStepped:Connect(updateGuide)
	-- "SHOW ME" on the boss bar reuses the trail for a few seconds
	Boss.PointRequested:Connect(function()
		local _, pos = Boss.State()
		setGuide(function()
			return pos + Vector3.new(0, 16, 0)
		end, 10)
	end)
	task.spawn(function()
		local d = State.WaitForData()
		step = math.clamp(d.Tutorial or 1, 1, STEPS + 1)
		if step == 1 then
			-- let the world settle, then frame the first ghost
			task.wait(2)
			if (player:GetAttribute("Target") or 0) == 0 then
				frameGhost()
			end
		end
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[--!strict
-- UPGRADES: Pickup Radius, Ectoplasm Bonus, Movement Speed. Level pips, current → next value
-- and an escalating price; the server validates every purchase.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local UpgradesPanel = {}

type Row = { Pips: { Frame }, Value: TextLabel, Buy: TextButton }

local panel: Kit.Panel
local rows: { [string]: Row } = {}

local function fmt(up: Config.UpgradeDef, v: number): string
	if up.Format == "percent" then
		return "+" .. math.floor(v * 100 + 0.5) .. "%"
	elseif up.Format == "studs" then
		return v .. " studs"
	end
	return tostring(v)
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	for id, row in rows do
		local up = Config.Upgrades[id]
		local level = d.Upgrades[id] or 1
		for i, pip in row.Pips do
			pip.BackgroundColor3 = if i <= level then Theme.Ecto else Theme.Bg
		end
		local cur = Rules.UpgradeValue(up.Levels, level)
		local cost = Rules.UpgradeCost(up.Costs, level)
		if cost then
			row.Value.Text = fmt(up, cur) .. "  →  " .. fmt(up, Rules.UpgradeValue(up.Levels, level + 1))
			Kit.SetButtonText(row.Buy, "💚 " .. Format.Short(cost))
			row.Buy:SetAttribute("Color", if d.Ecto >= cost then "Green" else "Gray")
		else
			row.Value.Text = fmt(up, cur) .. "  (MAX)"
			Kit.SetButtonText(row.Buy, "MAXED ★")
			row.Buy:SetAttribute("Color", "Orange")
		end
	end
end

function UpgradesPanel.Init()
	panel = Kit.Panel("Upgrades", "UPGRADES", Vector2.new(640, 380), "Green")
	-- rows are full-width with the text area stretching (Scale) and the button pinned right,
	-- so they work from a phone to a wide monitor; the list scrolls if the panel is short
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -12),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	for i, id in Config.UpgradeOrder do
		local up = Config.Upgrades[id]
		local r: Frame = Kit.new("Frame", { Size = UDim2.new(1, -6, 0, 88), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.4, LayoutOrder = i, ZIndex = 62, Parent = list })
		Kit.Corner(r, UDim.new(0, 14))
		local icon: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = r })
		Kit.Corner(icon, UDim.new(0, 14))
		Kit.Stroke(icon, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(icon, Theme.Panel3, Theme.Panel, 90)
		Kit.Icon(icon, Icons.ForUpgrade[id], up.Icon, { Size = UDim2.fromScale(0.86, 0.86), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Style = "Icon", TextSize = 30, ZIndex = 64, Stroke = 0 })
		-- text column: everything between the icon and the buy button
		local text: Frame = Kit.new("Frame", { Size = UDim2.new(1, -(84 + 160), 1, -12), Position = UDim2.fromOffset(84, 6), BackgroundTransparency = 1, ZIndex = 62, Parent = r })
		Kit.Label(text, up.Name, { Size = UDim2.new(1, 0, 0, 22), Align = Enum.TextXAlignment.Left, Style = "Heading", Fit = true, ZIndex = 63 })
		Kit.Label(text, up.Description, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 24), Align = Enum.TextXAlignment.Left, Color = Theme.Muted, Font = Theme.Body, Style = "Small", Fit = true, ZIndex = 63, Stroke = 0 })
		local n = #up.Levels
		local pipW = if n > 5 then 10 else 15
		local pipRowW = n * pipW + (n - 1) * 3
		local value = Kit.Label(text, "", { Size = UDim2.new(1, -(pipRowW + 6), 0, 20), Position = UDim2.new(0, 0, 1, -20), Align = Enum.TextXAlignment.Left, Color = Theme.Ecto, Style = "Body", Fit = true, ZIndex = 63 })
		local pipRow: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(pipRowW, 12), Position = UDim2.new(1, 0, 1, -16), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 63, Parent = text })
		Kit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = pipRow })
		local pips = {}
		for _ = 1, n do
			local pip: Frame = Kit.new("Frame", { Size = UDim2.fromOffset(pipW, 12), BackgroundColor3 = Theme.Bg, ZIndex = 64, Parent = pipRow })
			Kit.Corner(pip, UDim.new(0, 4))
			Kit.Stroke(pip, 1.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
			table.insert(pips, pip)
		end
		local buy = Kit.Button(r, {
			Text = "",
			Color = "Green",
			Size = UDim2.fromOffset(140, 48),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 64,
			OnClick = function()
				local res = State.Request("BuyUpgrade", id)
				if res.ok then
					Sound.Play("Upgrade")
					Kit.Toast(up.Name .. " upgraded to level " .. tostring(res.Level) .. "!", "Good")
					local char = game:GetService("Players").LocalPlayer.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						Effects.Burst(root.Position, { Color = Theme.Ecto, Count = 30, Size = 0.8, Speed = 16 })
						Effects.Ring(root.Position - Vector3.new(0, 2.8, 0), Theme.Ecto, 8, 0.5)
					end
				else
					Kit.Toast(res.err or "Can't buy that yet", "Bad")
				end
			end,
		})
		rows[id] = { Pips = pips, Value = value, Buy = buy }
		if i == 1 then
			panel.Primary = buy
		end
	end
	Hud.RegisterPanel("Upgrades", function()
		panel:Toggle()
	end)
end

function UpgradesPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	State.EctoChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

function UpgradesPanel.Open()
	if not panel.IsOpen then
		panel:Open()
	end
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">WorldsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- WORLDS (Fast Travel): a card per zone. Unlocked zones teleport you to their arrival pad
-- (the server checks ownership and places you); locked zones show a lock and their price.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Icons = require(GH.Icons)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(script.Parent.Hud)
local Sound = require(script.Parent.Sound)

local WorldsPanel = {}

type Card = { Frame: Frame, Status: TextLabel, Lock: GuiObject, Go: TextButton }

local player = Players.LocalPlayer
local panel: Kit.Panel
local cards: { [string]: Card } = {}
local busy = false

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function currentZone(): string?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local z = Config.Zones[Rules.ZoneIndexAt(root.Position.Z, zoneRanges)]
	return if z then z.Id else nil
end

local function refresh()
	local d = State.Data
	if not d then
		return
	end
	local here = currentZone()
	for _, z in Config.Zones do
		local c = cards[z.Id]
		local owned = d.Zones[z.Id] == true
		c.Lock.Visible = not owned
		c.Frame.BackgroundTransparency = if owned then 0 else 0.35
		if not owned then
			c.Status.Text = "🔒 " .. Format.Short(z.Cost)
			c.Status.TextColor3 = Theme.Muted
			Kit.SetButtonText(c.Go, "LOCKED")
			c.Go:SetAttribute("Color", "Gray")
		elseif z.Id == here then
			c.Status.Text = "YOU ARE HERE"
			c.Status.TextColor3 = Theme.Ecto
			Kit.SetButtonText(c.Go, "HERE")
			c.Go:SetAttribute("Color", "Gray")
		else
			c.Status.Text = "UNLOCKED"
			c.Status.TextColor3 = Theme.Ecto
			Kit.SetButtonText(c.Go, "GO!")
			c.Go:SetAttribute("Color", "Green")
		end
	end
end

local function travel(zone: Config.ZoneDef)
	local d = State.Data
	if busy or not d then
		return
	end
	if not d.Zones[zone.Id] then
		Kit.Toast("Unlock " .. zone.Name .. " at its gate first!", "Bad")
		return
	end
	if zone.Id == currentZone() then
		panel:Close()
		return
	end
	busy = true
	local res = State.Request("Travel", zone.Id)
	busy = false
	if res.ok then
		panel:Close()
		Sound.Play("ZoneUnlock")
		Hud.Banner(zone.Name, "Fast travel complete!", zone.Accent)
	else
		Kit.Toast(res.err or "Can't travel right now", "Bad")
	end
end

function WorldsPanel.Init()
	panel = Kit.Panel("Worlds", "WORLDS", Vector2.new(720, 420), "Blue")
	local list: ScrollingFrame = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -8),
		Position = UDim2.fromOffset(0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 61,
		Parent = panel.Body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(160, 150),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 6), Parent = list })
	for _, z in Config.Zones do
		local f: Frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = z.Order, ZIndex = 62, Parent = list })
		Kit.Corner(f, UDim.new(0, 14))
		Kit.Stroke(f, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
		Kit.Gradient(f, z.Accent:Lerp(Theme.Panel3, 0.35), z.FogColor, 90)
		Kit.Label(f, tostring(z.Order), { Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(6, 6), Style = "Heading", ZIndex = 64 })
		-- optional uploaded zone badge (docs/ICON_PROMPTS.md) between the number and the lock
		local hasIcon = Icons.Get(Icons.ForZone(z.Id)) ~= nil
		if hasIcon then
			Kit.Icon(f, Icons.ForZone(z.Id), "", { Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 63 })
		end
		Kit.Label(f, z.Name, { Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, if hasIcon then 38 else 32), Style = "Body", ZIndex = 64 })
		local status = Kit.Label(f, "", { Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(6, 74), Style = "Small", Fit = true, ZIndex = 64 })
		local lock = Kit.Icon(f, "lock", "🔒", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -6, 0, 4), AnchorPoint = Vector2.new(1, 0), Style = "Icon", Stroke = 0, ZIndex = 65 })
		local go = Kit.Button(f, {
			Text = "GO!",
			Color = "Green",
			Size = UDim2.new(1, -20, 0, 40),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 64,
			OnClick = function()
				travel(z)
			end,
		})
		cards[z.Id] = { Frame = f, Status = status, Lock = lock, Go = go }
		if z.Order == 1 then
			panel.Primary = go
		end
	end
	Hud.RegisterPanel("Worlds", function()
		panel:Toggle()
	end)
end

function WorldsPanel.Start()
	panel.OnOpen:Connect(refresh)
	State.Changed:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return WorldsPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="75">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR client entry: initialises every controller, then starts them.
local StarterGui = game:GetService("StarterGui")

local State = require(script.Parent.State)
State.Init()

-- no tools or health in this game: keep the screen clean
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local Controllers = script.Parent.Controllers
local order = {
	"Sound",
	"Effects",
	"Hud",
	"Ghosts",
	"Targeting",
	"Crew",
	"Orbs",
	"Reveal",
	"CratePanel",
	"HuntersPanel",
	"IndexPanel",
	"UpgradesPanel",
	"ShopPanel",
	"DailyPanel",
	"GatePanel",
	"WorldsPanel",
	"DevPanel",
	"Boss",
	"Ambience",
	"Tutorial",
}
local loaded: { any } = {}
for _, name in order do
	local mod = require(Controllers:FindFirstChild(name) :: ModuleScript) :: any
	table.insert(loaded, mod)
	if mod.Init then
		mod.Init()
	end
end
for _, mod in loaded do
	if mod.Start then
		task.spawn(mod.Start)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client mirror of the server snapshot (read-only; the server is the authority), the request
-- helper, and the single Fx dispatcher.
--
-- Why one dispatcher: a RemoteEvent that arrives before anything listens is queued and then
-- delivered only to the FIRST connection. State connects to every remote as the very first
-- client code, and buffers Fx messages per kind until a controller subscribes (e.g. a player
-- joining mid-event still gets the boss UI).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)
local Signal = require(GH.Signal)

local State = {}

State.Data = nil :: any -- latest snapshot (see DataService.snapshot on the server)
State.Ecto = 0
local changed = Signal.new()
local ectoChanged = Signal.new()
State.Changed = changed -- (data)
State.EctoChanged = ectoChanged -- (new, old); not fired for the first snapshot

-- os.time() on the server minus the client's, so countdowns use server time.
State.ClockOffset = 0

local request: RemoteFunction? = nil

type FxHandler = (any) -> ()
local fxHandlers: { [string]: { FxHandler } } = {}
local fxBuffer: { [string]: { any } } = {}

local function dispatchFx(kind: string, data: any)
	local list = fxHandlers[kind]
	if list and #list > 0 then
		for _, fn in list do
			task.spawn(fn, data)
		end
	else
		-- nobody listening yet: keep the latest few for the first subscriber
		local buf = fxBuffer[kind]
		if not buf then
			buf = {}
			fxBuffer[kind] = buf
		end
		table.insert(buf, data)
		if #buf > 8 then
			table.remove(buf, 1)
		end
	end
end

-- Subscribe to one Fx kind ("Poof", "Toast", "Announce", "ZoneUnlocked", "Boss", ...).
function State.OnFx(kind: string, fn: FxHandler)
	local list = fxHandlers[kind]
	if not list then
		list = {}
		fxHandlers[kind] = list
	end
	table.insert(list, fn)
	local buf = fxBuffer[kind]
	if buf then
		fxBuffer[kind] = nil
		for _, data in buf do
			task.spawn(fn, data)
		end
	end
end

-- Like State.Changed:Connect, but also runs right away if a snapshot already arrived.
function State.OnData(fn: (any) -> ())
	changed:Connect(fn)
	if State.Data then
		task.spawn(fn, State.Data)
	end
end

function State.Init()
	request = Net.Function("Request")
	Net.Event("Sync").OnClientEvent:Connect(function(data: any)
		State.ClockOffset = (data.ServerTime or os.time()) - os.time()
		local first = State.Data == nil
		State.Data = data
		local old = State.Ecto
		State.Ecto = data.Ecto
		changed:Fire(data)
		if not first and old ~= data.Ecto then
			ectoChanged:Fire(data.Ecto, old)
		end
	end)
	Net.Event("Ecto").OnClientEvent:Connect(function(value: number)
		local old = State.Ecto
		State.Ecto = value
		if State.Data then
			State.Data.Ecto = value
		end
		ectoChanged:Fire(value, old)
	end)
	Net.Event("Fx").OnClientEvent:Connect(function(kind: any, data: any)
		if type(kind) == "string" then
			dispatchFx(kind, data)
		end
	end)
end

function State.Now(): number
	return os.time() + State.ClockOffset
end

-- Calls a server action; returns the response table (never errors).
function State.Request(action: string, ...: any): any
	local rf = request
	if not rf then
		return { ok = false, err = "Loading..." }
	end
	local args = table.pack(...)
	local ok, res = pcall(function()
		return rf:InvokeServer(action, table.unpack(args, 1, args.n))
	end)
	if not ok or type(res) ~= "table" then
		return { ok = false, err = "Connection hiccup, try again" }
	end
	return res
end

function State.WaitForData(): any
	while not State.Data do
		changed:Wait()
	end
	return State.Data
end

function State.CountOwned(): number
	local n = 0
	if State.Data then
		for _ in State.Data.Hunters do
			n += 1
		end
	end
	return n
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="77">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny UI toolkit: creation helpers, typography styles, chunky animated buttons, responsive
-- modal panels (one open at a time, dimmed background, X button) and toasts.
--
-- Responsive rules (see Theme.Scale): every ScreenGui has one UIScale; layouts are written in
-- logical pixels; panels shrink to fit the logical screen and their content scrolls/wraps.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Theme = require(script.Parent.Theme)
local Signal = require(game:GetService("ReplicatedStorage"):WaitForChild("GH").Signal)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("GH").Icons)

local Kit = {}

local player = Players.LocalPlayer
local sound: ((string) -> ())? = nil

function Kit.SetSound(fn: (string) -> ())
	sound = fn
end

local function play(name: string)
	if sound then
		(sound :: (string) -> ())(name)
	end
end
Kit.Play = play

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.Tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function Kit.Corner(parent: Instance, radius: UDim?): UICorner
	return Kit.new("UICorner", { CornerRadius = radius or UDim.new(0, 12), Parent = parent })
end

function Kit.Stroke(parent: Instance, thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return Kit.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Theme.Outline,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Kit.Gradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?): UIGradient
	return Kit.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90, Parent = parent })
end

function Kit.Padding(parent: Instance, px: number)
	Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

--------------------------------------------------------------------------------
-- Text
--------------------------------------------------------------------------------
export type LabelProps = {
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Font: Enum.Font?,
	Align: Enum.TextXAlignment?,
	AlignY: Enum.TextYAlignment?,
	Stroke: number?, -- outline thickness; 0 = none; default depends on Style
	Style: string?, -- key in Theme.Type (default "Body")
	TextSize: number?, -- explicit size (overrides Style)
	Fit: boolean?, -- single line; cut with "…" if the box is too narrow (never grows)
	ZIndex: number?,
	Wrap: boolean?,
}

local STROKE_BY_STYLE: { [string]: number } = {
	Banner = 3,
	Title = 2.5,
	Currency = 2.5,
	Heading = 2,
	Button = 2,
	Icon = 0,
	Body = 1.5,
	Small = 1,
	Tiny = 1,
}

-- Text with a fixed size from the typography scale. No TextScaled anywhere: the screen's
-- UIScale does the device scaling, so the hierarchy is identical on desktop, tablet and phone.
function Kit.Label(parent: Instance?, text: string, p: LabelProps?): TextLabel
	local o: LabelProps = p or {}
	local style = o.Style or "Body"
	local size = o.TextSize or Theme.Type[style] or Theme.Type.Body
	local singleLine = o.Fit == true or o.Wrap == false
	local l: TextLabel = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero,
		Text = text,
		TextColor3 = o.Color or Theme.Text,
		Font = o.Font or Theme.Title,
		TextSize = size,
		TextScaled = false,
		TextWrapped = not singleLine,
		TextTruncate = if singleLine then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		TextXAlignment = o.Align or Enum.TextXAlignment.Center,
		TextYAlignment = o.AlignY or Enum.TextYAlignment.Center,
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	local stroke = if o.Stroke ~= nil then o.Stroke else (STROKE_BY_STYLE[style] or 1.5)
	if stroke > 0 then
		Kit.new("UIStroke", { Thickness = stroke, Color = Theme.Outline, Parent = l })
	end
	return l
end

-- An icon: the uploaded image for `key` (shared Icons.luau) when it has an id, otherwise the
-- emoji as text. Same props as Kit.Label (the image fits inside the label's box).
function Kit.Icon(parent: Instance?, key: string?, emoji: string, p: LabelProps?): GuiObject
	local image = Icons.Get(key)
	if not image then
		return Kit.Label(parent, emoji, p)
	end
	local o: LabelProps = p or {}
	local img: ImageLabel = Kit.new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = image,
		ScaleType = Enum.ScaleType.Fit,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero,
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	return img
end

--------------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------------
export type ButtonProps = {
	Text: string?,
	Icon: string?,
	Color: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	OnClick: (() -> ())?,
	ZIndex: number?,
	TextStyle: string?, -- typography key, default "Button"
}

-- Chunky gradient button with press/hover animation and click sound.
function Kit.Button(parent: Instance?, p: ButtonProps): TextButton
	local colors = Theme.Buttons[p.Color or "Green"] or Theme.Buttons.Green
	local b: TextButton = Kit.new("TextButton", {
		Size = p.Size or UDim2.fromOffset(140, 44),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		ZIndex = p.ZIndex or 1,
		Parent = parent,
	})
	Kit.Corner(b, UDim.new(0, 10))
	Kit.Stroke(b, 2.5, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local grad = Kit.Gradient(b, colors[1], colors[2], 90)
	b:SetAttribute("Color", p.Color or "Green")
	-- glossy top highlight
	local gloss = Kit.new("Frame", {
		Size = UDim2.new(1, -8, 0.36, 0),
		Position = UDim2.fromOffset(4, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		ZIndex = b.ZIndex,
		Parent = b,
	})
	Kit.Corner(gloss, UDim.new(0, 8))
	local text = (if p.Icon then p.Icon .. " " else "") .. (p.Text or "")
	local label = Kit.Label(b, text, {
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Style = p.TextStyle or "Button",
		Fit = true,
		ZIndex = b.ZIndex + 1,
	})
	label.Name = "Label"
	local scale = Kit.new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		Kit.Tween(scale, 0.12, { Scale = 1.05 })
		play("Hover")
	end)
	b.MouseLeave:Connect(function()
		Kit.Tween(scale, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		Kit.Tween(scale, 0.06, { Scale = 0.93 })
	end)
	b.MouseButton1Up:Connect(function()
		Kit.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	b.Activated:Connect(function()
		play("Click")
		if p.OnClick then
			(p.OnClick :: () -> ())()
		end
	end)
	b:GetAttributeChangedSignal("Color"):Connect(function()
		local c = Theme.Buttons[b:GetAttribute("Color") :: string] or Theme.Buttons.Green
		grad.Color = ColorSequence.new(c[1], c[2])
	end)
	return b
end

function Kit.SetButtonText(b: TextButton, text: string)
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l then
		l.Text = text
	end
end

--------------------------------------------------------------------------------
-- Screen scaling
--------------------------------------------------------------------------------
local screen: ScreenGui? = nil
local overlay: ScreenGui? = nil
local currentScale = 1
local scaleChanged = Signal.new()
Kit.ScaleChanged = scaleChanged -- (scale)

local function computeScale(): number
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local s
	if vp.X >= vp.Y then
		s = vp.Y / Theme.Scale.LandscapeRef
	else
		s = vp.X / Theme.Scale.PortraitRef
	end
	return math.clamp(s, Theme.Scale.Min, Theme.Scale.Max)
end

local function applyScale()
	currentScale = computeScale()
	for _, gui in { screen, overlay } do
		local sc = gui and gui:FindFirstChildOfClass("UIScale")
		if sc then
			sc.Scale = currentScale
		end
	end
	scaleChanged:Fire(currentScale)
end

local function makeScreen(name: string, order: number): ScreenGui
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
	})
	-- keep clear of the Roblox top bar and device notches (set after creation: the older
	-- IgnoreGuiInset property would otherwise overwrite it depending on assignment order)
	g.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	g.Parent = player:WaitForChild("PlayerGui")
	Kit.new("UIScale", { Scale = currentScale, Parent = g })
	return g
end

-- Main HUD screen (UIScale'd).
function Kit.Screen(): ScreenGui
	if not screen then
		currentScale = computeScale()
		local s = makeScreen("GHHud", 10)
		screen = s
		overlay = makeScreen("GHOverlay", 20)
		local cam = workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
		end
		applyScale()
	end
	return screen :: ScreenGui
end

function Kit.Overlay(): ScreenGui
	Kit.Screen()
	return overlay :: ScreenGui
end

-- Device scale shared by ScreenGuis and world labels.
function Kit.UIScale(): number
	return currentScale
end

-- Logical (pre-UIScale) screen size: what layouts are written against.
function Kit.LogicalSize(): Vector2
	local g = Kit.Screen()
	local abs = g.AbsoluteSize
	if abs.X <= 0 then
		local cam = workspace.CurrentCamera
		abs = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	end
	return abs / currentScale
end

-- Short screens (landscape phones) use the compact HUD layout.
function Kit.IsCompact(): boolean
	return Kit.LogicalSize().Y < Theme.Scale.CompactHeight
end

--------------------------------------------------------------------------------
-- Panels
--------------------------------------------------------------------------------
export type Panel = {
	Name: string,
	Root: Frame,
	Body: Frame,
	Title: TextLabel,
	Design: Vector2,
	IsOpen: boolean,
	Open: (Panel) -> (),
	Close: (Panel) -> (),
	Toggle: (Panel) -> (),
	Fit: (Panel) -> (),
	OnOpen: Signal.Signal,
	OnClose: Signal.Signal,
	Primary: GuiObject?, -- gamepad: selected when the panel opens (else the X button)
	CloseButton: GuiObject?,
}

local function usingGamepad(): boolean
	return UserInputService.GamepadEnabled and UserInputService:GetLastInputType().Name:match("^Gamepad") ~= nil
end

local current: Panel? = nil
local dim: TextButton? = nil
local panels: { Panel } = {}
local panelOpenedSignal = Signal.new()
Kit.PanelOpened = panelOpenedSignal -- (name or nil)

local function getDim(): TextButton
	if not dim then
		local d: TextButton = Kit.new("TextButton", {
			Name = "Dim",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(4, 4),
			Position = UDim2.fromScale(-1.5, -1.5),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 50,
			Parent = Kit.Screen(),
		})
		d.Activated:Connect(function()
			if current then
				(current :: Panel):Close()
			end
		end)
		dim = d
	end
	return dim :: TextButton
end

function Kit.CurrentPanel(): string?
	return if current then (current :: Panel).Name else nil
end

-- Modal panel centred on screen. `size` is the design size; on small screens the panel
-- shrinks to fit (keep content in scrolling/wrapping containers).
function Kit.Panel(name: string, title: string, size: Vector2, color: string?): Panel
	local root: Frame = Kit.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.new(0.5, 0, 0.5, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 60,
		Parent = Kit.Screen(),
	})
	Kit.Corner(root, UDim.new(0, 18))
	Kit.Stroke(root, 4, Theme.Outline, Enum.ApplyStrokeMode.Border)
	Kit.Gradient(root, Theme.Panel2, Theme.Panel, 90)
	local scale = Kit.new("UIScale", { Parent = root })
	-- title banner
	local banner: Frame = Kit.new("Frame", {
		Size = UDim2.new(0, math.clamp(#title * 15 + 60, 200, 420), 0, 44),
		Position = UDim2.new(0.5, 0, 0, -20),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 62,
		Parent = root,
	})
	Kit.Corner(banner, UDim.new(0, 14))
	Kit.Stroke(banner, 3, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local bc = Theme.Buttons[color or "Purple"] or Theme.Buttons.Purple
	Kit.Gradient(banner, bc[1], bc[2], 90)
	local titleLabel = Kit.Label(banner, title, { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 63, Style = "Title", Fit = true })
	local body: Frame = Kit.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -28, 1, -50),
		Position = UDim2.fromOffset(14, 36),
		BackgroundTransparency = 1,
		ZIndex = 61,
		Parent = root,
	})
	local panel: Panel
	panel = {
		Name = name,
		Root = root,
		Body = body,
		Title = titleLabel,
		Design = size,
		IsOpen = false,
		OnOpen = Signal.new(),
		OnClose = Signal.new(),
		Fit = function(self: Panel)
			local logical = Kit.LogicalSize()
			local w = math.min(self.Design.X, logical.X - 32)
			local h = math.min(self.Design.Y, logical.Y - 64)
			root.Size = UDim2.fromOffset(math.max(w, 240), math.max(h, 200))
		end,
		Open = function(self: Panel)
			if current and current ~= self then
				(current :: Panel):Close()
			end
			if self.IsOpen then
				return
			end
			self:Fit()
			current = self
			self.IsOpen = true
			local d = getDim()
			d.Visible = true
			Kit.Tween(d, 0.2, { BackgroundTransparency = 0.5 })
			root.Visible = true
			scale.Scale = 0.7
			Kit.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			play("PanelOpen")
			self.OnOpen:Fire()
			panelOpenedSignal:Fire(self.Name)
			if usingGamepad() then
				GuiService.SelectedObject = self.Primary or self.CloseButton
			end
		end,
		Close = function(self: Panel)
			if not self.IsOpen then
				return
			end
			self.IsOpen = false
			if current == self then
				current = nil
				local d = getDim()
				Kit.Tween(d, 0.15, { BackgroundTransparency = 1 })
				task.delay(0.15, function()
					if not current then
						d.Visible = false
					end
				end)
			end
			local sel = GuiService.SelectedObject
			if sel and sel:IsDescendantOf(root) then
				GuiService.SelectedObject = nil
			end
			Kit.Tween(scale, 0.12, { Scale = 0.75 })
			task.delay(0.12, function()
				if not self.IsOpen then
					root.Visible = false
				end
			end)
			self.OnClose:Fire()
			panelOpenedSignal:Fire(nil)
		end,
		Toggle = function(self: Panel)
			if self.IsOpen then
				self:Close()
			else
				self:Open()
			end
		end,
	}
	-- obvious X (44 logical px ≈ a comfortable finger target even on phones)
	panel.CloseButton = Kit.Button(root, {
		Text = "X",
		Color = "Red",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, 12, 0, -14),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 64,
		TextStyle = "Heading",
		OnClick = function()
			panel:Close()
		end,
	})
	table.insert(panels, panel)
	return panel
end

scaleChanged:Connect(function()
	for _, p in panels do
		if p.IsOpen then
			p:Fit()
		end
	end
end)

-- Close any open panel (gamepad B / Backspace / Roblox menu).
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.ButtonB or (input.KeyCode == Enum.KeyCode.Backspace and not processed) then
		if current then
			(current :: Panel):Close()
		end
	end
end)
GuiService.MenuOpened:Connect(function()
	if current then
		(current :: Panel):Close()
	end
end)

--------------------------------------------------------------------------------
-- Toasts
--------------------------------------------------------------------------------
local toastHolder: Frame? = nil

function Kit.Toast(text: string, color: string?)
	if not toastHolder then
		local h: Frame = Kit.new("Frame", {
			Name = "Toasts",
			Size = UDim2.fromOffset(420, 200),
			Position = UDim2.new(0.5, 0, 0, 96),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			ZIndex = 90,
			Parent = Kit.Overlay(),
		})
		Kit.new("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = h,
		})
		toastHolder = h
	end
	local holder = toastHolder :: Frame
	local col = if color == "Bad" then Theme.Bad elseif color == "Good" then Theme.Good elseif color == "Gold" then Theme.Gold else Theme.Panel3
	local f: Frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(400, 32),
		BackgroundColor3 = col,
		BackgroundTransparency = 0.08,
		LayoutOrder = math.floor(os.clock() * 100),
		ZIndex = 90,
		Parent = holder,
	})
	Kit.Corner(f, UDim.new(0, 10))
	Kit.Stroke(f, 2, Theme.Outline, Enum.ApplyStrokeMode.Border)
	local l = Kit.Label(f, text, { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 91, Style = "Body", Fit = true })
	local sc = Kit.new("UIScale", { Scale = 0.6, Parent = f })
	Kit.Tween(sc, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	if color == "Bad" then
		play("Error")
	end
	-- cap visible toasts
	local kids = {}
	for _, c in holder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 3 then
		table.sort(kids, function(a: any, b: any)
			return a.LayoutOrder < b.LayoutOrder
		end)
		kids[1]:Destroy()
	end
	task.delay(2.4, function()
		if f.Parent then
			Kit.Tween(f, 0.3, { BackgroundTransparency = 1 })
			Kit.Tween(l, 0.3, { TextTransparency = 1 })
			local st = l:FindFirstChildOfClass("UIStroke")
			if st then
				Kit.Tween(st, 0.3, { Transparency = 1 })
			end
			task.wait(0.3)
			f:Destroy()
		end
	end)
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Portrait</string>
              <string name="Source"><![CDATA[--!strict
-- Hunter portraits. Face(): cheap 2D portrait built from Frames (used in big grids).
-- Viewport(): real 3D model in a ViewportFrame (used for the index detail / inspect view).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local HunterRig = require(GH.Rigs.HunterRig)
local Kit = require(script.Parent.Kit)

local Portrait = {}

Portrait.ToolIcon = {
	Flashlight = "🔦",
	Vacuum = "🌀",
	Scanner = "📟",
	Blaster = "⚡",
	Cannon = "💥",
	Lantern = "🏮",
	Staff = "🪄",
	Projector = "📡",
	Megaphone = "📣",
	Wand = "✨",
	Orb = "🔮",
	Spyglass = "🔭",
	Sword = "⚔️",
} :: { [string]: string }

local GOLD = Color3.fromRGB(255, 205, 60)
local RED = Color3.fromRGB(230, 50, 70)
local NAVY = Color3.fromRGB(35, 50, 120)
local WHITE = Color3.new(1, 1, 1)

local function shade(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- plain (optionally rounded) rectangle, anchored at its centre
local function rect(parent: Instance, size: UDim2, pos: UDim2, color: Color3, z: number, radius: number?): Frame
	local f: Frame = Kit.new("Frame", {
		Size = size,
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
	if radius then
		Kit.Corner(f, UDim.new(radius, 0))
	end
	return f
end

local function circle(parent: Instance, size: UDim2, pos: UDim2, color: Color3, z: number): Frame
	local f: Frame = Kit.new("Frame", {
		Size = size,
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
	Kit.Corner(f, UDim.new(1, 0))
	return f
end

-- Fills `parent` (a square frame) with a cartoon face. silhouette = undiscovered.
function Portrait.Face(parent: GuiObject, hunterId: string, silhouette: boolean?)
	local def = Config.Hunters[hunterId]
	if not def then
		return
	end
	local L = def.Look
	local z = parent.ZIndex + 1
	local dark = Color3.fromRGB(20, 12, 35)
	local function col(c: Color3): Color3
		return if silhouette then dark else c
	end
	local holder: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = z, Parent = parent })
	-- shoulders / shirt
	local body = circle(holder, UDim2.fromScale(0.78, 0.5), UDim2.fromScale(0.5, 1.02), col(L.Shirt), z)
	body.AnchorPoint = Vector2.new(0.5, 1)
	-- back item peeking out
	if L.Back == "Wings" or L.Back == "Cape" then
		local w = circle(holder, UDim2.fromScale(0.95, 0.45), UDim2.fromScale(0.5, 0.82), col(L.BackColor or L.Shirt), z - 0)
		w.ZIndex = z
		body.ZIndex = z + 1
	elseif L.Back == "Shield" or L.Back == "LifeRing" or L.Back == "MedKit" then
		-- peeking out from behind a shoulder
		local bc = L.BackColor or L.Shirt
		body.ZIndex = z + 1
		if L.Back == "Shield" then
			local sh = circle(holder, UDim2.fromScale(0.36, 0.38), UDim2.fromScale(0.84, 0.76), col(bc), z)
			Kit.Stroke(sh, 2, col(Color3.fromRGB(150, 155, 170)))
			rect(sh, UDim2.fromScale(0.16, 0.7), UDim2.fromScale(0.5, 0.5), col(GOLD), z)
			rect(sh, UDim2.fromScale(0.7, 0.16), UDim2.fromScale(0.5, 0.45), col(GOLD), z)
		elseif L.Back == "LifeRing" then
			local lr = circle(holder, UDim2.fromScale(0.34, 0.34), UDim2.fromScale(0.16, 0.74), col(bc), z)
			lr.BackgroundTransparency = 1
			Kit.Stroke(lr, 5, col(bc))
			local inner = circle(lr, UDim2.fromScale(0.62, 0.62), UDim2.fromScale(0.5, 0.5), col(WHITE), z)
			inner.BackgroundTransparency = 1
			Kit.Stroke(inner, 1.5, col(WHITE))
		else
			local mk = rect(holder, UDim2.fromScale(0.3, 0.26), UDim2.fromScale(0.84, 0.72), col(bc), z, 0.2)
			Kit.Stroke(mk, 1.5, col(shade(bc, 0.7)))
			rect(mk, UDim2.fromScale(0.5, 0.16), UDim2.fromScale(0.5, 0.4), col(RED), z)
			rect(mk, UDim2.fromScale(0.16, 0.5), UDim2.fromScale(0.5, 0.4), col(RED), z)
		end
	elseif L.Back == "Balloons" then
		local cols = { L.BackColor or L.Shirt, Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 215, 70) }
		local spots = { Vector2.new(0.12, 0.3), Vector2.new(0.88, 0.22), Vector2.new(0.72, 0.1) }
		for i, p in spots do
			rect(holder, UDim2.fromScale(0.012, 0.3), UDim2.fromScale(p.X, p.Y + 0.27), col(WHITE), z) -- string
			circle(holder, UDim2.fromScale(0.2, 0.24), UDim2.fromScale(p.X, p.Y), col(cols[i]), z + 1)
		end
	elseif L.Back == "Orbs" then
		for _, p in { Vector2.new(0.1, 0.62), Vector2.new(0.92, 0.42), Vector2.new(0.12, 0.2) } do
			local o = circle(holder, UDim2.fromScale(0.13, 0.13), UDim2.fromScale(p.X, p.Y), col(L.BackColor or L.Shirt), z + 1)
			if not silhouette then
				Kit.Stroke(o, 2, WHITE)
			end
		end
	end
	-- head
	local head = circle(holder, UDim2.fromScale(0.64, 0.6), UDim2.fromScale(0.5, 0.46), col(L.Skin), z + 2)
	-- hair cap (top half)
	if L.HairStyle ~= "None" then
		local hair = circle(head, UDim2.fromScale(1.08, 0.62), UDim2.fromScale(0.5, 0.18), col(L.Hair), z + 3)
		if L.HairStyle == "Spiky" then
			for i = -1, 1 do
				local s = circle(head, UDim2.fromScale(0.3, 0.3), UDim2.fromScale(0.5 + i * 0.28, -0.05), col(L.Hair), z + 3)
				s.Rotation = 45
				local c = s:FindFirstChildOfClass("UICorner")
				if c then
					c.CornerRadius = UDim.new(0.15, 0)
				end
			end
		elseif L.HairStyle == "Puff" then
			circle(head, UDim2.fromScale(0.5, 0.45), UDim2.fromScale(0.2, 0.15), col(L.Hair), z + 3)
			circle(head, UDim2.fromScale(0.5, 0.45), UDim2.fromScale(0.8, 0.15), col(L.Hair), z + 3)
		elseif L.HairStyle == "Long" or L.HairStyle == "Bob" then
			circle(head, UDim2.fromScale(0.28, 0.75), UDim2.fromScale(0.02, 0.5), col(L.Hair), z + 1)
			circle(head, UDim2.fromScale(0.28, 0.75), UDim2.fromScale(0.98, 0.5), col(L.Hair), z + 1)
		end
		hair.ZIndex = z + 3
	end
	-- hat
	if L.Hat and L.Hat ~= "Goggles" and L.Hat ~= "Visor" then
		local hc = col(L.HatColor or L.Shirt)
		if L.Hat == "Halo" then
			local halo = circle(head, UDim2.fromScale(0.7, 0.18), UDim2.fromScale(0.5, -0.12), hc, z + 4)
			Kit.Stroke(halo, 2, if silhouette then dark else Color3.fromRGB(255, 255, 200))
		elseif L.Hat == "Mortarboard" then
			local top: Frame = Kit.new("Frame", { Size = UDim2.fromScale(1.1, 0.14), Position = UDim2.fromScale(0.5, 0.0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = hc, ZIndex = z + 4, Parent = head })
			top.Rotation = -4
		elseif L.Hat == "Hood" then
			local hood = circle(holder, UDim2.fromScale(0.82, 0.74), UDim2.fromScale(0.5, 0.44), hc, z + 1)
			hood.ZIndex = z + 1
		elseif L.Hat == "TopHat" then
			local base = L.HatColor or L.Shirt
			local bandC = if base.R + base.G + base.B > 1.6 then shade(base, 0.35) else GOLD
			rect(head, UDim2.fromScale(0.62, 0.42), UDim2.fromScale(0.5, -0.08), hc, z + 4, 0.08)
			rect(head, UDim2.fromScale(0.64, 0.09), UDim2.fromScale(0.5, 0.06), col(bandC), z + 5)
			rect(head, UDim2.fromScale(1.15, 0.1), UDim2.fromScale(0.5, 0.14), hc, z + 5, 1)
		elseif L.Hat == "Jester" then
			local alt = col(GOLD)
			circle(head, UDim2.fromScale(1.04, 0.5), UDim2.fromScale(0.5, 0.1), hc, z + 4)
			for _, s in { -1, 1 } do
				local pt = rect(head, UDim2.fromScale(0.3, 0.42), UDim2.fromScale(0.5 + 0.36 * s, -0.04), if s < 0 then hc else alt, z + 4, 0.5)
				pt.Rotation = 40 * s
				circle(head, UDim2.fromScale(0.15, 0.16), UDim2.fromScale(0.5 + 0.6 * s, -0.2), if s < 0 then alt else hc, z + 5) -- bell
			end
		elseif L.Hat == "NurseCap" then
			local cap = rect(head, UDim2.fromScale(0.62, 0.24), UDim2.fromScale(0.5, 0.02), hc, z + 4, 0.2)
			Kit.Stroke(cap, 1.5, col(Color3.fromRGB(200, 205, 215)))
			rect(head, UDim2.fromScale(0.16, 0.05), UDim2.fromScale(0.5, 0.02), col(RED), z + 5)
			rect(head, UDim2.fromScale(0.05, 0.17), UDim2.fromScale(0.5, 0.02), col(RED), z + 5)
		elseif L.Hat == "HeadMirror" then
			rect(head, UDim2.fromScale(1.04, 0.07), UDim2.fromScale(0.5, 0.25), col(shade(L.HatColor or L.Shirt, 0.45)), z + 4)
			local m = circle(head, UDim2.fromScale(0.3, 0.32), UDim2.fromScale(0.66, 0.2), hc, z + 5)
			Kit.Stroke(m, 2, col(Color3.fromRGB(120, 125, 140)))
			circle(m, UDim2.fromScale(0.3, 0.3), UDim2.fromScale(0.5, 0.5), col(Color3.fromRGB(40, 40, 55)), z + 6)
		elseif L.Hat == "SailorCap" then
			local cap = rect(head, UDim2.fromScale(0.66, 0.3), UDim2.fromScale(0.5, -0.04), hc, z + 4, 0.3)
			Kit.Stroke(cap, 1.5, col(Color3.fromRGB(190, 200, 215)))
			rect(head, UDim2.fromScale(0.86, 0.12), UDim2.fromScale(0.5, 0.1), hc, z + 5, 1)
			rect(head, UDim2.fromScale(0.86, 0.04), UDim2.fromScale(0.5, 0.1), col(NAVY), z + 6)
		elseif L.Hat == "Bandana" then
			circle(head, UDim2.fromScale(1.04, 0.5), UDim2.fromScale(0.5, 0.1), hc, z + 4)
			circle(head, UDim2.fromScale(0.2, 0.2), UDim2.fromScale(0.96, 0.24), hc, z + 4) -- knot
			local tail = rect(head, UDim2.fromScale(0.1, 0.26), UDim2.fromScale(1.02, 0.4), hc, z + 3, 0.4)
			tail.Rotation = -20
			for _, p in { Vector2.new(0.3, 0.02), Vector2.new(0.55, 0.14), Vector2.new(0.74, -0.02) } do
				circle(head, UDim2.fromScale(0.08, 0.08), UDim2.fromScale(p.X, p.Y), col(WHITE), z + 5)
			end
		elseif L.Hat == "Tricorn" then
			circle(head, UDim2.fromScale(0.72, 0.42), UDim2.fromScale(0.5, -0.02), hc, z + 4)
			local brim = rect(head, UDim2.fromScale(1.25, 0.2), UDim2.fromScale(0.5, 0.12), hc, z + 5, 0.5)
			Kit.Stroke(brim, 2, col(GOLD))
			for _, s in { -1, 1 } do
				local corner = rect(head, UDim2.fromScale(0.26, 0.28), UDim2.fromScale(0.5 + 0.56 * s, 0.03), hc, z + 5, 0.15)
				corner.Rotation = 45
			end
		elseif L.Hat == "KnightHelm" then
			-- plume behind, helm over the top and sides, a visor slit, face open
			local plumeC = L.Shirt
			circle(head, UDim2.fromScale(0.22, 0.36), UDim2.fromScale(0.5, -0.12), col(plumeC), z + 3)
			local helm = circle(head, UDim2.fromScale(1.14, 0.62), UDim2.fromScale(0.5, 0.14), hc, z + 4)
			Kit.Stroke(helm, 2, col(shade(L.HatColor or L.Shirt, 0.6)))
			for _, x in { 0.06, 0.94 } do
				rect(head, UDim2.fromScale(0.16, 0.42), UDim2.fromScale(x, 0.55), hc, z + 4, 0.4) -- cheek guards
			end
			rect(head, UDim2.fromScale(0.56, 0.05), UDim2.fromScale(0.5, 0.22), col(Color3.fromRGB(30, 25, 40)), z + 5)
		elseif L.Hat == "Wizard" then
			local cone = rect(head, UDim2.fromScale(0.38, 0.4), UDim2.fromScale(0.5, 0.0), hc, z + 4)
			cone.Rotation = 45
			rect(head, UDim2.fromScale(1.2, 0.14), UDim2.fromScale(0.5, 0.22), hc, z + 5, 1)
			local star = rect(head, UDim2.fromScale(0.1, 0.1), UDim2.fromScale(0.56, -0.02), col(GOLD), z + 5)
			star.Rotation = 45
		elseif L.Hat == "Crown" then
			rect(head, UDim2.fromScale(0.62, 0.16), UDim2.fromScale(0.5, 0.04), hc, z + 4)
			for i = -1, 1 do
				local pt = rect(head, UDim2.fromScale(0.14, 0.15), UDim2.fromScale(0.5 + i * 0.22, -0.06), hc, z + 4)
				pt.Rotation = 45
			end
			circle(head, UDim2.fromScale(0.1, 0.1), UDim2.fromScale(0.5, 0.04), col(RED), z + 5)
		elseif L.Hat == "Crystal" then
			for i = -2, 2 do
				local s = if i == 0 then 0.17 else 0.11
				local g = rect(head, UDim2.fromScale(s, s * 1.07), UDim2.fromScale(0.5 + i * 0.2, -0.04 + math.abs(i) * 0.05), hc, z + 4)
				g.Rotation = 45
				if not silhouette then
					Kit.Stroke(g, 1.5, WHITE)
				end
			end
		else
			local cap = circle(head, UDim2.fromScale(1.0, 0.5), UDim2.fromScale(0.5, 0.08), hc, z + 4)
			if L.Hat == "Cap" or L.Hat == "Fedora" then
				local brim: Frame = Kit.new("Frame", { Size = UDim2.fromScale(if L.Hat == "Fedora" then 1.3 else 0.7, 0.1), Position = UDim2.fromScale(if L.Hat == "Fedora" then 0.5 else 0.7, 0.3), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = hc, ZIndex = z + 5, Parent = head })
				Kit.Corner(brim, UDim.new(1, 0))
			end
			cap.ZIndex = z + 4
		end
	end
	-- eyes
	if not silhouette then
		for _, x in { 0.33, 0.67 } do
			local e = circle(head, UDim2.fromScale(0.2, 0.24), UDim2.fromScale(x, 0.56), Color3.fromRGB(25, 20, 35), z + 5)
			circle(e, UDim2.fromScale(0.4, 0.4), UDim2.fromScale(0.65, 0.3), Color3.new(1, 1, 1), z + 6)
		end
		local mouth: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.22, 0.09), Position = UDim2.fromScale(0.5, 0.8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(150, 40, 60), ZIndex = z + 5, Parent = head })
		Kit.Corner(mouth, UDim.new(1, 0))
		-- blush
		for _, x in { 0.18, 0.82 } do
			local b = circle(head, UDim2.fromScale(0.14, 0.08), UDim2.fromScale(x, 0.74), Color3.fromRGB(255, 130, 150), z + 5)
			b.BackgroundTransparency = 0.4
		end
		if L.Hat == "Goggles" or L.Hat == "Visor" then
			local g: Frame = Kit.new("Frame", { Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = L.HatColor or Color3.new(0, 0, 0), BackgroundTransparency = 0.25, ZIndex = z + 7, Parent = head })
			Kit.Corner(g, UDim.new(0.5, 0))
		end
		-- tool badge
		Kit.Label(holder, Portrait.ToolIcon[L.Tool] or "👻", { Size = UDim2.fromScale(0.34, 0.34), Position = UDim2.fromScale(0.97, 0.97), AnchorPoint = Vector2.new(1, 1), ZIndex = z + 8, Stroke = 0 })
	else
		Kit.Label(holder, "?", { Size = UDim2.fromScale(0.4, 0.4), Position = UDim2.fromScale(0.5, 0.46), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z + 6, Color = Color3.fromRGB(160, 140, 210) })
	end
end

-- 3D portrait. Returns the ViewportFrame so callers can spin `model` if they want.
function Portrait.Viewport(parent: GuiObject, hunterId: string, silhouette: boolean?): (ViewportFrame, Model?)
	local vf: ViewportFrame = Kit.new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 190, 230),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
		ZIndex = parent.ZIndex + 1,
		Parent = parent,
	})
	if not Config.Hunters[hunterId] then
		return vf, nil
	end
	local model = HunterRig.BuildStatic(hunterId)
	if silhouette then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Color = Color3.fromRGB(15, 8, 30)
				p.Material = Enum.Material.SmoothPlastic
			elseif p:IsA("ParticleEmitter") or p:IsA("Light") then
				p:Destroy()
			end
		end
	end
	-- rigs face -Z and the camera sits on the -Z side: a slight turn gives a 3/4 view
	model:PivotTo(CFrame.Angles(0, math.rad(-22), 0))
	model.Parent = vf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local _, size = model:GetBoundingBox()
	local h = math.max(size.Y, 3.5)
	cam.CFrame = CFrame.lookAt(Vector3.new(0, h * 0.55, -h * 2.6), Vector3.new(0, h * 0.48, 0))
	cam.Parent = vf
	vf.CurrentCamera = cam
	return vf, model
end

return Portrait
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Central UI configuration: colours, fonts, the typography scale, screen-scaling rules and
-- world-label (BillboardGui) sizes. All sizes are LOGICAL pixels: one UIScale per ScreenGui
-- converts them for the device (see Kit.Screen), so desktop, tablet and phone share one layout.
local C = Color3.fromRGB

local Theme = {
	Bg = C(28, 16, 50),
	Panel = C(46, 28, 82),
	Panel2 = C(64, 40, 112),
	Panel3 = C(86, 56, 146),
	Outline = C(18, 8, 36),
	Text = C(255, 255, 255), -- default text colour
	Muted = C(205, 190, 240),
	Ecto = C(90, 255, 160),
	Ecto2 = C(40, 220, 210),
	Good = C(90, 230, 120),
	Bad = C(255, 85, 110),
	Gold = C(255, 200, 60),
	Buttons = {
		Green = { C(110, 240, 120), C(40, 185, 95) },
		Purple = { C(175, 110, 255), C(115, 60, 220) },
		Orange = { C(255, 180, 60), C(245, 110, 40) },
		Blue = { C(90, 200, 255), C(50, 120, 240) },
		Red = { C(255, 110, 120), C(215, 50, 80) },
		Gray = { C(150, 145, 170), C(105, 100, 130) },
		Pink = { C(255, 130, 220), C(220, 70, 170) },
		Teal = { C(90, 235, 215), C(30, 160, 170) },
	} :: { [string]: { Color3 } },
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,

	-- Typography hierarchy (logical px). LARGE = major screen titles only.
	Type = {
		Banner = 36, -- centre-screen moments (NEW AREA UNLOCKED!)
		Title = 26, -- panel titles
		Currency = 24, -- the Ectoplasm counter
		Heading = 19, -- section headings, important values
		Button = 16, -- button labels
		Body = 15, -- names, prices, stats
		Small = 13, -- secondary info, descriptions
		Tiny = 11, -- captions under icons, badges
		Icon = 24, -- emoji icons on menu buttons
	} :: { [string]: number },

	-- Screen scaling: UIScale = clamp(viewport height / LandscapeRef) in landscape and
	-- clamp(viewport width / PortraitRef) in portrait. Desktop/laptop/tablet land at 1.0;
	-- a landscape phone (375-430 pt tall) lands at ~0.72-0.83: menu buttons ~42-48 pt,
	-- panel buttons ~32-36 pt, body text ~11-12 pt.
	Scale = {
		LandscapeRef = 520,
		PortraitRef = 600,
		Min = 0.55,
		Max = 1,
		CompactHeight = 650, -- logical height below which the HUD uses its compact layout
	},

	-- World labels (BillboardGui) in logical px; multiplied by the same device scale.
	World = {
		GhostLabel = Vector2.new(150, 38), -- name + Spirit bar with the Spirit value
		GhostLabelSelected = Vector2.new(190, 48), -- selected: bigger bar + numbers
		BossLabel = Vector2.new(190, 44), -- zone bosses: a more prominent bar
		BossLabelSelected = Vector2.new(240, 58),
		FullSizeDistance = 24, -- world labels are full size up to this distance from the camera...
		MinFactor = 0.62, -- ...then ease down to this fraction (never bigger) until MaxDistance hides them
		GhostMaxDistance = 55, -- unselected labels vanish beyond this (studs)
		BossMaxDistance = 90,
		SelectedMaxDistance = 160,
		CrewTag = Vector2.new(120, 16),
		CrewMaxDistance = 24,
		Marker = 56, -- tutorial arrow
	},
}

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">WorldLabel</string>
              <string name="Source"><![CDATA[--!strict
-- World-space labels (BillboardGuis) that behave the same on phones and desktops:
--  * size is in screen pixels (constant on-screen size, never balloons when the camera is
--    close) multiplied by the same device scale as the HUD (Kit.UIScale), and re-applied when
--    the screen size changes
--  * text sizes are fixed (no TextScaled), also device-scaled
--  * every label has a MaxDistance, so far-away labels disappear instead of cluttering
--  * optional distance factor (SetDistance): a label never grows as you walk away; it eases
--    down a little with distance (like the world does) until MaxDistance hides it
-- Inside a label, lay elements out with Scale-based sizes (fractions of the label).
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local WorldLabel = {}

export type Props = {
	Adornee: Instance?,
	Parent: Instance?,
	Size: Vector2, -- logical px
	Offset: Vector3?, -- StudsOffsetWorldSpace
	MaxDistance: number,
	AlwaysOnTop: boolean?,
	Name: string?,
}

local guis: { [BillboardGui]: Vector2 } = setmetatable({} :: any, { __mode = "k" })
local texts: { [TextLabel]: number } = setmetatable({} :: any, { __mode = "k" })
-- weak values too: guiTexts holds the labels strongly, so a strong gui value here would form a
-- cycle that keeps every destroyed ghost label alive
local textGui: { [TextLabel]: BillboardGui } = setmetatable({} :: any, { __mode = "kv" })
local factors: { [BillboardGui]: number } = setmetatable({} :: any, { __mode = "k" })
local guiTexts: { [BillboardGui]: { TextLabel } } = setmetatable({} :: any, { __mode = "k" })

local function applyGui(g: BillboardGui, base: Vector2)
	local s = Kit.UIScale() * (factors[g] or 1)
	g.Size = UDim2.fromOffset(math.floor(base.X * s + 0.5), math.floor(base.Y * s + 0.5))
end

local function applyText(l: TextLabel, base: number)
	local g = textGui[l]
	local f = if g then factors[g] or 1 else 1
	l.TextSize = math.max(8, math.floor(base * Kit.UIScale() * f + 0.5))
end

-- Distance factor: full size up to Theme.World.FullSizeDistance studs from the camera, then
-- (ref / d) ^ 0.6 down to Theme.World.MinFactor. Cheap to call every frame: it only touches the
-- instance when the factor moves by more than 4%.
function WorldLabel.SetDistance(g: BillboardGui, dist: number)
	local W = Theme.World
	local f = if dist <= W.FullSizeDistance then 1 else math.max(W.MinFactor, (W.FullSizeDistance / dist) ^ 0.6)
	local old = factors[g] or 1
	if math.abs(f - old) < 0.04 and not (f == 1 and old ~= 1) then
		return
	end
	factors[g] = f
	local base = guis[g]
	if base then
		applyGui(g, base)
	end
	local list = guiTexts[g]
	if list then
		for _, l in list do
			local tb = texts[l]
			if tb then
				applyText(l, tb)
			end
		end
	end
end

function WorldLabel.New(p: Props): BillboardGui
	local g: BillboardGui = Kit.new("BillboardGui", {
		Name = p.Name or "WorldLabel",
		StudsOffsetWorldSpace = p.Offset or Vector3.zero,
		MaxDistance = p.MaxDistance,
		AlwaysOnTop = p.AlwaysOnTop == true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		ClipsDescendants = false,
		Adornee = p.Adornee,
		Parent = p.Parent,
	})
	guis[g] = p.Size
	applyGui(g, p.Size)
	return g
end

function WorldLabel.Resize(g: BillboardGui, base: Vector2)
	guis[g] = base
	applyGui(g, base)
end

export type TextProps = {
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Style: string?, -- Theme.Type key (default Small)
	Stroke: number?,
	Font: Enum.Font?,
	ZIndex: number?,
}

-- Single-line text inside a world label (truncates instead of overflowing).
function WorldLabel.Text(parent: Instance, text: string, p: TextProps?): TextLabel
	local o: TextProps = p or {}
	local base = Theme.Type[o.Style or "Small"] or Theme.Type.Small
	local l: TextLabel = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.zero,
		Text = text,
		TextColor3 = o.Color or Theme.Text,
		Font = o.Font or Theme.Title,
		TextScaled = false,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	texts[l] = base
	local g = parent:FindFirstAncestorOfClass("BillboardGui") or (if parent:IsA("BillboardGui") then parent else nil)
	if g then
		textGui[l] = g
		local list = guiTexts[g]
		if not list then
			list = {}
			guiTexts[g] = list
		end
		table.insert(list, l)
	end
	applyText(l, base)
	local stroke = o.Stroke or 1.5
	if stroke > 0 then
		Kit.new("UIStroke", { Thickness = stroke, Color = Theme.Outline, Parent = l })
	end
	return l
end

function WorldLabel.SetTextStyle(l: TextLabel, style: string)
	local base = Theme.Type[style] or Theme.Type.Small
	texts[l] = base
	applyText(l, base)
end

Kit.ScaleChanged:Connect(function(s: number)
	for g, base in guis do
		applyGui(g, base)
	end
	for l, base in texts do
		applyText(l, base)
	end
end)

return WorldLabel
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="82">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <token name="SignalBehavior2">2</token>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>