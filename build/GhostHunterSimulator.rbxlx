	Kit.Box(f, V(-111, FLOOR_Y, 1287.8), V(-102, 8, 1288.2), curtain, { Mat = FABRIC })
	Kit.Box(f, V(-111, FLOOR_Y, 1386.8), V(-102, 8, 1387.2), curtain, { Mat = FABRIC })
