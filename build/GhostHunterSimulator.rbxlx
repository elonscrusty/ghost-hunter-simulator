  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">GHServer</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GHOST HUNTER SIMULATOR server entry. Builds the world, then initialises services in order.
-- Every step is protected: one failing system logs a warning instead of stopping the others.
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Net = require(GH.Net)

Net.Init()

-- Players pass through each other (busy crate stations); hunters are client-side and non-colliding.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
end)

local okWorld, errWorld = pcall(function()
	require(script.Parent.World.Builder).Build()
end)
if not okWorld then
	warn("[Main] world build failed: " .. tostring(errWorld))
end

local Services = script.Parent.Services
local order = {
	"Fx",
	"SafetyService",
	"Remotes",
	"DataService",
	"PlayerInfo",
	"HunterService",
	"CrewService",
	"PetService",
	"DropService",
	"GhostService",
	"ProgressService",
	"EventService",
	"TowerService",
	"ShopService",
	"TradeService",
	"StationService",
	"GlobalEventService",
	"RarePetEventService",
	"DevService",
	"FeedbackService",
	"LeaderboardService",
}
local loaded: { [string]: any } = {}
for _, name in order do
	local ok, mod = pcall(require, Services:FindFirstChild(name) :: ModuleScript)
	if not ok then
		warn("[Main] couldn't load " .. name .. ": " .. tostring(mod))
		continue
	end
	loaded[name] = mod
	if (mod :: any).Init then
		local okInit, err = pcall((mod :: any).Init)
		if not okInit then
			warn("[Main] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end
for _, name in order do
	local mod = loaded[name]
	if mod and mod.Start then
		local okStart, err = pcall(mod.Start)
		if not okStart then
			warn("[Main] " .. name .. ".Start failed: " .. tostring(err))
		end
	end
end

-- Developer tools (DEV button + chat commands) live in Services/DevService.

-- One fixed text size per world sign (see World/TextFit): run after every service has built
-- its signs and boards.
pcall(function()
	local n = require(script.Parent.World.TextFit).Apply(workspace)
	print(string.format("[Main] fixed text sizes on %d world labels", n))
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CrewService</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter health, knockouts and recovery (v1.6).
--  * HP lives only in this server session (hunters start every session healthy); max HP comes
--    from the hunter's (tiered) power and the owner's pet HP bonus.
--  * A hunter at 0 HP is KNOCKED OUT: d.Knocked[uid] = os.time() when it recovers. The timer is
--    real time, so it keeps running while the player is offline and rejoining can't reset or
--    skip it. Knocked-out hunters are never deleted; they just don't fight until they recover.
-- Ghosts call CrewService.Hit through GhostService, only for crews attacking that ghost.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Fx = require(script.Parent.Fx)

local CrewService = {}

type Health = { HP: number, LastHit: number }
local health: { [Player]: { [string]: Health } } = {}
local dirty: { [Player]: boolean } = {}

local R = Config.Retaliation

function CrewService.MaxHP(player: Player, uid: string): number
	return Rules.HunterMaxHP(HunterService.HunterPower(player, uid), R.HPPerPower, PlayerInfo.PetBonus(player, "HP"))
end

local function entry(player: Player, uid: string): Health
	local h = health[player]
	if not h then
		h = {}
		health[player] = h
	end
	local e = h[uid]
	if not e then
		e = { HP = CrewService.MaxHP(player, uid), LastHit = 0 }
		h[uid] = e
	end
	return e
end

-- Crew uids that can be hit right now.
function CrewService.Targets(player: Player): { string }
	return HunterService.ActiveUids(player)
end

-- Pushes "uid=pct,..." for the owner's HP bars (and everyone's crew rigs).
local function publish(player: Player)
	local parts = {}
	for _, uid in CrewService.Targets(player) do
		local e = entry(player, uid)
		local pct = math.clamp(math.floor(e.HP / CrewService.MaxHP(player, uid) * 100 + 0.5), 0, 100)
		table.insert(parts, uid .. "=" .. pct)
	end
	player:SetAttribute("CrewHP", table.concat(parts, ","))
end

-- Damages one hunter. Returns true if it was knocked out by this hit.
function CrewService.Hit(player: Player, uid: string, amount: number): boolean
	local d = DataService.Get(player)
	if not d or amount ~= amount or amount <= 0 then
		return false
	end
	if not d.Hunters[uid] or HunterService.IsKnocked(d, uid) then
		return false
	end
	local e = entry(player, uid)
	e.HP -= amount
	e.LastHit = os.clock()
	dirty[player] = true
	if e.HP > 0 then
		return false
	end
	local seconds = Rules.RecoverySeconds(R.RecoverySeconds, PlayerInfo.PetBonus(player, "Recovery"))
	d.Knocked[uid] = os.time() + math.ceil(seconds)
	local list = health[player]
	if list then
		list[uid] = nil
	end
	HunterService.Refresh(player)
	local def = Config.Hunters[d.Hunters[uid].Id]
	Fx.To(player, "Knocked", { Uid = uid, Name = def and def.Name or "Hunter", Until = d.Knocked[uid] })
	if #HunterService.ActiveUids(player) == 0 and player:GetAttribute("InTower") ~= true then
		Fx.Toast(player, "Your whole crew is recovering! Equip other hunters (EQUIP BEST) or wait for them.", "Bad")
	end
	return true
end

-- Heals a hunter fully (e.g. entering a new tower room).
function CrewService.HealAll(player: Player)
	health[player] = nil
	dirty[player] = true
end

local function regenTick(dt: number)
	local now = os.clock()
	for player, list in health do
		local d = DataService.Get(player)
		for uid, e in list do
			if not d or not d.Hunters[uid] then
				list[uid] = nil -- traded / merged / sold away: forget its session HP
				continue
			end
			local max = CrewService.MaxHP(player, uid)
			if e.HP > max then
				e.HP = max
				dirty[player] = true
			elseif e.HP < max and now - e.LastHit >= R.RegenDelay then
				e.HP = math.min(max, e.HP + max * R.RegenPerSecond * dt)
				dirty[player] = true
			end
		end
	end
	for player in dirty do
		if player.Parent then
			publish(player)
		end
	end
	table.clear(dirty)
end

-- Knockout timers end on the server clock (also covers hunters that recovered offline).
local function recoveryTick()
	local t = os.time()
	for _, player in Players:GetPlayers() do
		local d = DataService.Get(player)
		if d then
			local any = false
			for uid, untilT in d.Knocked do
				if untilT <= t then
					d.Knocked[uid] = nil
					any = true
					local h = d.Hunters[uid]
					local def = h and Config.Hunters[h.Id]
					Fx.To(player, "Recovered", { Uid = uid, Name = def and def.Name or "Hunter" })
				end
			end
			if any then
				HunterService.Refresh(player)
				dirty[player] = true
			end
		end
	end
end

function CrewService.Init()
	DataService.AddDecorator(function(player, s)
		local d = DataService.Get(player)
		if d then
			s.Knocked = d.Knocked
		end
	end)
end

function CrewService.Start()
	Players.PlayerRemoving:Connect(function(player)
		health[player] = nil
		dirty[player] = nil
	end)
	DataService.Loaded:Connect(function(player)
		dirty[player] = true
	end)
	task.spawn(function()
		local last = os.clock()
		local nextRecover = 0
		while true do
			task.wait(0.5)
			local c = os.clock()
			local dt = math.min(c - last, 2)
			last = c
			local ok, err = pcall(function()
				regenTick(dt)
				if c >= nextRecover then
					nextRecover = c + 1
					recoveryTick()
				end
			end)
			if not ok then
				warn("[Crew] tick error: " .. tostring(err))
			end
		end
	end)
end

return CrewService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load/save with retries, a per-session lock (prevents duplication when a
-- player hops or rejoins quickly), autosave, BindToClose and schema migration. Every other
-- service reads and writes data ONLY through DataService.Get(player) on the server.
--
-- Safety rules:
--  * a save only writes while OUR session holds the lock; otherwise it reports failure
--  * the save snapshot is a deep copy taken at save time (consistent even if the write retries)
--  * once a player is leaving, only the final releasing save runs
--  * a join waits for this server's in-flight leave-save of the same user
--  * the no-saving fallback exists only in Studio; live servers kick instead of using a blank profile
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Eggs = require(GH.Logic.Eggs)

local DataService = {}

export type HunterRecord = { Id: string, Locked: boolean?, T: number?, Tier: number? } -- Tier nil = Normal
export type PetRecord = { Id: string, T: number, Nick: string? } -- Nick: server-filtered nickname
export type EventPlay = { S: number, G: boolean } -- active seconds counted, reward granted
export type Data = {
	Version: number,
	Ecto: number,
	TotalEcto: number,
	Hunters: { [string]: HunterRecord },
	NextUid: number,
	Equipped: { string },
	Discovered: { [string]: boolean },
	Zones: { [string]: boolean },
	Upgrades: { [string]: number },
	Daily: { Last: number, Streak: number },
	Boosts: { [string]: number }, -- boost id -> os.time expiry
	FreeCrates: { [string]: number },
	-- Tour = the menu tour is still owed (set when the tutorial is finished in-session, cleared
	-- when the tour ends): saves from before the tour fill in false, so they never get it forced
	Settings: { Music: boolean, Sfx: boolean, FastReveal: boolean, Names: boolean, Tour: boolean },
	Tutorial: number,
	SeenUpdate: string, -- Config.UpdateNotes.Version the player has seen ("" = none)
	Stats: { Ghosts: number, Crates: number, Events: number, Seconds: number },
	Purchases: { string }, -- recent receipt ids (ring buffer)
	SkipTokens: number, -- bought Single Crate Skips not used yet (added in 1.4; old saves get 0)
	LuckyOpens: { [string]: number }, -- crate id -> lucky opens left (added in 1.5; old saves get {})
	-- v1.6 (all optional for old saves: missing fields get these defaults, nothing else changes)
	Knocked: { [string]: number }, -- hunter uid -> os.time when it recovers (real time, counts offline)
	Shards: number, -- Spirit Shards (Boss Tower only)
	Pets: { [string]: PetRecord }, -- pet uid ("p1", "p2", ...) -> pet
	PetNextUid: number,
	EquippedPets: { string },
	TowerBest: number, -- personal best room cleared
	TowerRuns: number,
	TowerRooms: number, -- rooms cleared in total
	TowerShards: number, -- shards earned from the tower in total (reward record)
	EventPlay: { [string]: EventPlay }, -- event id -> progress
	TradesApplied: { string }, -- recent trade ids applied to this profile (exactly-once)
	-- v1.7
	TowerCheckpoint: number, -- highest checkpoint room cleared (5, 10, ...); next run may start after it
	PendingHatch: { [string]: Eggs.Record }, -- v1.8: hatch request id -> result (last 20; exactly-once egg retries)
	Variants: { [string]: boolean }, -- "HunterId:1" / "HunterId:2" = Shiny / Mega discovered (Normal stays in Discovered)
	Orphans: { [string]: any }, -- hunters whose id no longer exists in Config (kept, not used)
	Extra: { [string]: any }, -- unknown top-level keys from a newer/older version (kept as-is)
}

local IS_STUDIO = RunService:IsStudio()

local function defaults(): Data
	local d: Data = {
		Version = Config.DataSchemaVersion,
		Ecto = 0,
		TotalEcto = 0,
		Hunters = {},
		NextUid = 1,
		Equipped = {},
		Discovered = {},
		Zones = { [Config.Zones[1].Id] = true },
		Upgrades = {},
		Daily = { Last = 0, Streak = 0 },
		Boosts = {},
		FreeCrates = {},
		Settings = { Music = true, Sfx = true, FastReveal = false, Names = true, Tour = false },
		Tutorial = 1,
		SeenUpdate = "",
		Stats = { Ghosts = 0, Crates = 0, Events = 0, Seconds = 0 },
		Purchases = {},
		SkipTokens = 0,
		LuckyOpens = {},
		Knocked = {},
		Shards = 0,
		Pets = {},
		PetNextUid = 1,
		EquippedPets = {},
		TowerBest = 0,
		TowerRuns = 0,
		TowerRooms = 0,
		TowerShards = 0,
		EventPlay = {},
		TradesApplied = {},
		TowerCheckpoint = 0,
		PendingHatch = {},
		Variants = {},
		Orphans = {},
		Extra = {},
	}
	for id in Config.Upgrades do
		d.Upgrades[id] = 1
	end
	return d
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

local NICK_MAX = 40 -- longest pet nickname this version accepts (PetService)

local function finite(v: any): boolean
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end

-- whole number >= lo; NaN, inf and wrong types become lo
local function num(v: any, lo: number): number
	return if finite(v) then math.max(lo, math.floor(v)) else lo
end

-- a profile saved by a NEWER schema than this server knows (rolling update): never load or save it
local function tooNew(raw: any): boolean
	return type(raw) == "table" and finite(raw.Version) and raw.Version > Config.DataSchemaVersion
end

-- highest numeric hunter uid in use (owned or parked)
local function topUid(d: Data): number
	local top = 0
	for _, list in { d.Hunters :: any, d.Orphans } do
		for uid in list do
			local n = tonumber(uid)
			if finite(n) and (n :: number) > top then
				top = math.floor(n :: number)
			end
		end
	end
	return top
end

-- Fills missing fields (new features) and upgrades old schemas. Never deletes player data:
-- unknown keys go to Extra, hunters that no longer exist go to Orphans, a field of the wrong
-- type is kept in Extra["_bad_<name>"], and values above this version's caps are kept in
-- Extra._over (see cap below).
local function migrate(raw: any): Data
	local d = defaults()
	if type(raw) ~= "table" then
		return d
	end
	for k, v in raw do
		if k == "_lock" or k == "_seq" or k == "_sess" then
			continue
		end
		local cur = (d :: any)[k]
		if cur ~= nil then
			if k == "Extra" then
				continue -- merged below
			elseif type(v) == type(cur) then
				(d :: any)[k] = v
			else
				-- wrong type: keep the original (NaN/inf can't be stored, keep them as text)
				d.Extra["_bad_" .. k] = if type(v) == "number" and not finite(v) then tostring(v) else v
			end
		elseif type(k) == "string" then
			d.Extra[k] = v
		end
	end
	if type(raw.Extra) == "table" then
		for k, v in raw.Extra do
			if d.Extra[k] == nil and (d :: any)[k] == nil then
				d.Extra[k] = v
			elseif raw[k] == nil and k ~= "Extra" and type(v) == type((d :: any)[k]) then
				-- a field this version knows was parked in Extra by an older server (e.g. a
				-- player hopped to a not-yet-updated server): restore it instead of dropping it
				(d :: any)[k] = v
			end
		end
	end
	-- Values above this version's caps (saved by a newer server, or before a cap was lowered)
	-- are clamped so nothing indexes past the end of a table, and the original is parked in
	-- Extra._over. A version whose cap allows it restores it, as long as the clamped value was
	-- not changed in between (spent, merged, traded); otherwise the parked value is dropped.
	local parked = if type(d.Extra._over) == "table" then d.Extra._over else {}
	local over: { [string]: { [any]: any } } = {}
	local function wasParked(list: string, key: any): any
		local t = parked[list]
		return if type(t) == "table" then t[key] else nil
	end
	local function park(list: string, key: any, v: any)
		local t = over[list]
		if not t then
			t = {}
			over[list] = t
		end
		t[key] = v
	end
	-- count = true for spendable stacks (LuckyOpens): the parked SURPLUS comes back on top of
	-- whatever is left after spending, instead of being dropped when the value changed
	local function cap(list: string, key: any, v: number, max: number, count: boolean?): number
		local o = wasParked(list, key)
		if type(o) == "table" and finite(o.v) then
			if count and finite(o.c) and o.v > o.c then
				v += math.floor(o.v - o.c)
			elseif o.c == v then
				v = math.floor(o.v)
			end
		end
		if v > max then
			park(list, key, { v = v, c = max })
			v = max
		end
		return v
	end
	-- a uid/id table saved as an array has number keys: use the string keys this version expects
	local function stringKeys(t: { [any]: any }, clash: ((any) -> any)?)
		local nums = {}
		for k in t do
			if type(k) == "number" then
				table.insert(nums, k)
			end
		end
		for _, k in nums do
			local v = t[k]
			t[k] = nil
			local s = tostring(k)
			if t[s] == nil then
				t[s] = v
			elseif clash then
				t[clash(k)] = v
			end
		end
	end
	local topKey = math.max(topUid(d), num(d.NextUid, 1))
	local function freshUid(_: any): string
		topKey += 1
		return tostring(topKey)
	end
	stringKeys(d.Hunters :: any, freshUid)
	stringKeys(d.Orphans, freshUid)
	stringKeys(d.Discovered :: any)
	-- nested defaults
	local base = defaults()
	local settings = d.Settings :: any
	for k, v in (if type(parked.Settings) == "table" then parked.Settings else {}) :: { [any]: any } do
		if (base.Settings :: any)[k] == nil then
			park("Settings", k, v) -- still unknown here: keep it parked
		elseif settings[k] == nil and type(v) == type((base.Settings :: any)[k]) then
			settings[k] = v -- a setting an older server didn't know: restore it
		end
	end
	for k, v in settings do
		if (base.Settings :: any)[k] == nil then
			park("Settings", k, v) -- retired or newer setting (e.g. the old free auto-target)
			settings[k] = nil
		end
	end
	for k, v in base.Settings :: any do
		if type(settings[k]) ~= type(v) then
			settings[k] = v
		end
	end
	for k in base.Stats do
		(d.Stats :: any)[k] = num((d.Stats :: any)[k], 0)
	end
	for k in base.Daily do
		(d.Daily :: any)[k] = num((d.Daily :: any)[k], 0)
	end
	for id, t in d.Boosts do
		if not finite(t) then
			d.Boosts[id] = nil
		end
	end
	for id, n in d.FreeCrates do
		if not finite(n) or n < 0 then
			d.FreeCrates[id] = nil
		else
			d.FreeCrates[id] = math.floor(n)
		end
	end
	for id, up in Config.Upgrades do
		d.Upgrades[id] = cap("Upgrades", id, num(d.Upgrades[id], 1), #up.Levels)
	end
	d.Ecto = if finite(d.Ecto) then math.max(0, d.Ecto) else 0
	d.TotalEcto = if finite(d.TotalEcto) then math.max(0, d.TotalEcto) else 0
	d.SkipTokens = num(d.SkipTokens, 0)
	d.Tutorial = if finite(d.Tutorial) then math.floor(d.Tutorial) else 1
	for id, n in d.LuckyOpens do
		if type(id) ~= "string" or not finite(n) or n < 1 then
			d.LuckyOpens[id] = nil
		else
			d.LuckyOpens[id] = cap("LuckyOpens", id, math.floor(n), Config.LuckyOpens.MaxStack, true)
		end
	end
	d.Shards = num(d.Shards, 0)
	d.TowerBest = num(d.TowerBest, 0)
	d.TowerRuns = num(d.TowerRuns, 0)
	d.TowerRooms = num(d.TowerRooms, 0)
	d.TowerShards = num(d.TowerShards, 0)
	d.TowerCheckpoint = num(d.TowerCheckpoint, 0)
	for k, v in d.Variants do
		if type(k) ~= "string" or v ~= true then
			d.Variants[k] = nil
		end
	end
	-- pets: unknown pet ids are kept (never deleted) but not equippable
	local maxPet = 0
	for uid, pet in d.Pets do
		if type(uid) ~= "string" or type(pet) ~= "table" or type(pet.Id) ~= "string" then
			d.Pets[uid] = nil
		else
			pet.T = num(pet.T, 0)
			if pet.Nick ~= nil and (type(pet.Nick) ~= "string" or #pet.Nick > NICK_MAX) then
				if type(pet.Nick) == "string" then
					park("Nick", uid, pet.Nick)
				end
				pet.Nick = nil
			elseif pet.Nick == nil then
				local o = wasParked("Nick", uid)
				if type(o) == "string" then
					if #o <= NICK_MAX then
						pet.Nick = o
					else
						park("Nick", uid, o)
					end
				end
			end
			local n = tonumber(string.match(uid, "^p(%d+)$"))
			if n and n > maxPet then
				maxPet = n
			end
		end
	end
	d.PetNextUid = math.max(num(d.PetNextUid, 1), maxPet + 1)
	local eqPets, seenPet = {}, {}
	for _, uid in d.EquippedPets do
		local pet = if type(uid) == "string" then d.Pets[uid] else nil
		if pet and Config.Pets[pet.Id] and not seenPet[uid] and #eqPets < Config.PetRules.MaxEquipped then
			seenPet[uid] = true
			table.insert(eqPets, uid)
		end
	end
	d.EquippedPets = eqPets
	-- egg hatch records (exactly-once retries): drop malformed entries, keep the newest 20
	for id, rec in d.PendingHatch do
		if not Eggs.ValidRequestId(id) or type(rec) ~= "table" or type(rec.Egg) ~= "string" or type(rec.Pet) ~= "string" or type(rec.Uid) ~= "string" then
			d.PendingHatch[id] = nil
		else
			rec.T = num(rec.T, 0)
		end
	end
	for _, id in Eggs.Prune(d.PendingHatch, Eggs.KEEP_RECORDS) do
		d.PendingHatch[id] = nil
	end
	for id, ev in d.EventPlay do
		if type(id) ~= "string" or type(ev) ~= "table" then
			d.EventPlay[id] = nil
		else
			ev.S = num(ev.S, 0)
			ev.G = ev.G == true
		end
	end
	local applied = {}
	for _, id in d.TradesApplied do
		if type(id) == "string" then
			table.insert(applied, id)
		end
	end
	while #applied > Config.Trade.AppliedMemory do
		table.remove(applied, 1)
	end
	d.TradesApplied = applied
	d.Zones[Config.Zones[1].Id] = true
	-- hunters whose definition was removed are parked in Orphans (restored if the id returns)
	for uid, h in d.Orphans do
		if type(h) == "table" and Config.Hunters[h.Id] and d.Hunters[uid] == nil then
			d.Hunters[uid] = h
			d.Orphans[uid] = nil
		end
	end
	for uid, h in d.Hunters do
		if type(h) ~= "table" or not Config.Hunters[h.Id] then
			d.Orphans[uid] = h
			d.Hunters[uid] = nil
		end
	end
	for uid, h in d.Hunters do
		local tier = cap("Tier", uid, num(h.Tier, 0), Config.Merge.MaxTier)
		h.Tier = if tier > 0 then tier else nil
		if h.Locked ~= nil and type(h.Locked) ~= "boolean" then
			h.Locked = false
		end
	end
	for _, h in d.Hunters do
		if h.Tier and h.Tier > 0 then
			d.Variants[h.Id .. ":" .. h.Tier] = true -- owned Shiny/Mega count as discovered
		end
	end
	for uid, t in d.Knocked do
		if type(uid) ~= "string" or d.Hunters[uid] == nil or not finite(t) then
			d.Knocked[uid] = nil
		end
	end
	local eq = {}
	local seen = {}
	for _, uid in d.Equipped do
		if d.Hunters[uid] and not seen[uid] then
			seen[uid] = true
			table.insert(eq, uid)
		end
	end
	d.Equipped = eq
	-- uids must never be reused: NextUid stays above every existing numeric uid
	d.NextUid = math.max(num(d.NextUid, 1), topUid(d) + 1)
	d.Extra._over = if next(over) then over else nil
	-- (future) if d.Version < 2 then ... end
	-- never stamp a lower version than the stored one (a newer profile is refused before this)
	d.Version = math.max(num(d.Version, 0), Config.DataSchemaVersion)
	return d
end

type SaveJob = { Release: boolean, Done: boolean, Ok: boolean }

local SAVE_GAP = 7 -- seconds between writes of the same key (DataStore limit: 6)
local SYNC_GAP = 0.5 -- seconds between full snapshots sent to one client

type Profile = {
	Data: Data,
	Key: string,
	Session: string,
	Loaded: boolean,
	Leaving: boolean,
	Saving: boolean,
	SyncQueued: boolean,
	JoinedAt: number,
	Seq: number, -- save counter: an older snapshot can never overwrite a newer one
	-- _sess/_seq of the stored profile when we loaded it: if the stored profile later carries
	-- another session's stamp, a newer session (lock takeover) has written it and we never may
	LoadedSess: any,
	LoadedSeq: any,
	Pending: SaveJob?, -- the one save waiting to start; later save requests join it
	LastWrite: number, -- os.clock of the last write of this key (load or save)
	LastSync: number, -- os.clock of the last full snapshot sent to the client
}

local profiles: { [Player]: Profile } = {}
local leavingSaves: { [number]: boolean } = {} -- userId -> final save in flight on this server
local inflight = 0
local store: DataStore? = nil
local storeOk = false
local loadedSignal = Signal.new()
DataService.Loaded = loadedSignal -- (player, data) by reference
local resetSignal = Signal.new()
DataService.ProgressReset = resetSignal -- (player) after ResetProgress (e.g. the leaderboard entry)

local syncRemote: RemoteEvent
local ectoRemote: RemoteEvent
-- Extra values other services add to the client snapshot (crew power, slots, ...).
local decorators: { (Player, any) -> () } = {}
-- run after a profile loads but BEFORE the player can act (may yield; e.g. trade recovery)
local loadHooks: { (Player, any) -> () } = {}
-- run just before the final save when a player leaves or the server closes (e.g. unpicked orbs)
local leaveHooks: { (Player, any) -> () } = {}

function DataService.AddLoadHook(fn: (Player, any) -> ())
	table.insert(loadHooks, fn)
end

function DataService.AddLeaveHook(fn: (Player, any) -> ())
	table.insert(leaveHooks, fn)
end

local function runHooks(list: { (Player, any) -> () }, player: Player, data: any)
	for _, fn in list do
		local ok, err = pcall(function()
			fn(player, data)
		end)
		if not ok then
			warn("[Data] hook failed: " .. tostring(err))
		end
	end
end

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local delayS = 1
	for attempt = 1, Config.Data.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[Data] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < Config.Data.Retries then
			task.wait(delayS)
			delayS = math.min(delayS * 2, 8)
		end
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

local function lockFresh(lock: any, session: string): boolean
	return type(lock) == "table" and lock.session ~= session and os.time() - (tonumber(lock.t) or 0) < Config.Data.SessionLockSeconds
end

-- Loads with a session lock. Returns data, or nil if the player should be kicked ("newer" =
-- the stored profile comes from a newer version of the game than this server).
local function loadProfile(player: Player, p: Profile): (Data?, string?)
	if not storeOk or not store then
		return if IS_STUDIO then migrate(nil) else nil, nil
	end
	local ds = store :: DataStore
	local key = p.Key
	local corrupt = false
	local newer = false
	-- Another session holding the lock (player just hopped) normally releases it with its final
	-- save within seconds. A live server refreshes the lock time on every save, so the lock is
	-- only taken over once its time has not moved for a whole autosave period (+ margin).
	local stuckFor = Config.Data.AutosaveSeconds + 30
	local giveUp = os.clock() + Config.Data.SessionLockSeconds + 60
	local seenT: number? = nil
	local seenAt = os.clock()
	local stealT: number? = nil
	local attempt = 0
	while true do
		attempt += 1
		local locked = false
		local lockT: number? = nil
		local ok, result = retry("load " .. key, function()
			return ds:UpdateAsync(key, function(old: any)
				locked, lockT = false, nil
				if old ~= nil and type(old) ~= "table" then
					corrupt = true -- never overwrite a stored value we can't read
					return nil
				end
				if tooNew(old) then
					newer = true -- never touch a newer version's profile
					return nil
				end
				old = if type(old) == "table" then old else {}
				if lockFresh(old._lock, p.Session) then
					lockT = tonumber(old._lock.t)
					if stealT == nil or lockT ~= stealT then
						locked = true
						return nil -- don't write
					end
					-- take over: the lock time is still the one we watched go stale
				end
				old._lock = { job = jobId(), session = p.Session, t = os.time() }
				return old
			end)
		end)
		if not ok or corrupt or newer then
			if corrupt then
				warn("[Data] stored profile for " .. key .. " is not a table; refusing to load over it")
			elseif newer then
				warn("[Data] stored profile for " .. key .. " is from a newer version; not loading it here")
			end
			return nil, if newer then "newer" else nil
		end
		if not locked then
			p.LastWrite = os.clock()
			if type(result) == "table" then
				p.LoadedSess, p.LoadedSeq = result._sess, result._seq
			end
			return migrate(result), nil
		end
		stealT = nil
		if lockT ~= seenT then
			seenT, seenAt = lockT, os.clock() -- the other server is still saving: keep waiting
		end
		if os.clock() - seenAt >= stuckFor then
			warn("[Data] session lock for " .. key .. " not refreshed for " .. stuckFor .. " s; taking over")
			stealT = seenT
		elseif os.clock() > giveUp then
			warn("[Data] session lock for " .. key .. " is still held by a live session; not loading")
			return nil, nil
		else
			task.wait(math.min(2 + attempt * 2, 8))
		end
		if not player.Parent then
			return nil, nil
		end
	end
end

-- One write of the profile (the caller has waited its turn). True only if the data really
-- reached the DataStore.
local function writeP(p: Profile, release: boolean): boolean
	p.Saving = true
	local ds = store :: DataStore
	p.Data.Stats.Seconds += math.floor(os.clock() - p.JoinedAt)
	p.JoinedAt = os.clock()
	local snapshot = deepCopy(p.Data)
	p.Seq += 1
	local seq = p.Seq
	snapshot._seq = seq
	snapshot._sess = p.Session -- with _seq: our older snapshot never lands on our newer one,
	-- even after the final save released the lock
	local aborted = false
	local stale = false
	local ok = retry("save " .. p.Key, function()
		aborted = false
		stale = false
		return ds:UpdateAsync(p.Key, function(old: any)
			if tooNew(old) then
				aborted = true -- a newer version of the game saved this profile: never overwrite it
				return nil
			end
			if type(old) == "table" and lockFresh(old._lock, p.Session) then
				-- another session owns this profile now: never overwrite its newer data
				aborted = true
				return nil
			end
			if type(old) == "table" and old._sess ~= p.Session and (old._sess ~= p.LoadedSess or old._seq ~= p.LoadedSeq) then
				-- another session saved this profile after we loaded it (it took over our lock
				-- and may have released it since): our snapshot is older, never write it
				aborted = true
				return nil
			end
			if type(old) == "table" and old._sess == p.Session and (tonumber(old._seq) or 0) > seq then
				stale = true -- our own NEWER snapshot is already stored
				return nil
			end
			snapshot._lock = if release then nil else { job = jobId(), session = p.Session, t = os.time() }
			return snapshot
		end)
	end)
	if ok and stale and release then
		-- the newer snapshot still holds our lock; release it without touching the data
		pcall(function()
			ds:UpdateAsync(p.Key, function(old: any)
				if type(old) == "table" and type(old._lock) == "table" and old._lock.session == p.Session then
					old._lock = nil
					return old
				end
				return nil
			end)
		end)
	end
	p.LastWrite = os.clock()
	p.Saving = false
	if ok and aborted then
		warn("[Data] save skipped for " .. p.Key .. ": another session owns the profile")
		-- this server can never save this profile again: send the player to the newer session
		-- instead of letting them play on with progress that can't be kept
		if not p.Leaving then
			p.Leaving = true
			local player = Players:GetPlayerByUserId(tonumber(string.sub(p.Key, 3)) or 0)
			if player and profiles[player] == p then
				player:Kick("Your Ghost Hunter data was opened on another server. Please rejoin - your saved progress is safe.")
			end
		end
	end
	return ok and not aborted
end

-- Saves the profile. Returns true only if the data really reached the DataStore.
-- At most one save waits per profile: a request made while one is waiting joins it (that save
-- copies the data when it starts, so it includes the joiner's changes) and gets its result.
local function saveP(p: Profile, release: boolean): boolean
	if not p.Loaded then
		return false
	end
	if not storeOk or not store then
		return IS_STUDIO -- Studio without API access: nothing to save
	end
	if p.Leaving and not release then
		return false -- only the final, releasing save runs for a leaving player
	end
	local job = p.Pending
	if job then
		if release then
			job.Release = true -- the waiting save becomes the final one
		end
		while not job.Done do
			task.wait(0.1)
		end
		return job.Ok
	end
	local mine: SaveJob = { Release = release, Done = false, Ok = false }
	p.Pending = mine
	inflight += 1 -- counted while waiting too, so BindToClose never stops before this save runs
	-- wait for the running write and keep writes of this key SAVE_GAP apart; the final save skips
	-- the gap so BindToClose finishes in time. After 20 s go ahead anyway: the save counter (_seq)
	-- makes sure an older snapshot can never land on top of a newer one, so the final save of a
	-- leaving player is never skipped just because an autosave was slow
	local t0 = os.clock()
	while (p.Saving or (not mine.Release and os.clock() - p.LastWrite < SAVE_GAP)) and os.clock() - t0 < 20 do
		task.wait(0.2)
	end
	p.Pending = nil
	local ok = false
	-- the player started leaving while this routine save waited: only the final save may write
	-- (else this save could put the lock back after the final save released it)
	if not (p.Leaving and not mine.Release) then
		ok = writeP(p, mine.Release)
	end
	inflight -= 1
	mine.Ok, mine.Done = ok, true
	return ok
end

local function saveProfile(player: Player, release: boolean): boolean
	local p = profiles[player]
	return if p then saveP(p, release) else false
end

function DataService.Get(player: Player): Data?
	local p = profiles[player]
	return if p and p.Loaded and not p.Leaving then p.Data else nil
end

-- DEV ONLY (DevService checks): wipes this player's progress back to a new profile, in place
-- (other services keep the same table). Keeps purchase receipts (so Robux products are never
-- granted twice), bought Crate Skips and settings. Game passes live on Roblox, not in the save.
function DataService.ResetProgress(player: Player): boolean
	local d = DataService.Get(player)
	if not d then
		return false
	end
	local keep = { Purchases = d.Purchases, Settings = d.Settings, SkipTokens = d.SkipTokens, TradesApplied = d.TradesApplied }
	local fresh = defaults()
	table.clear(d :: any)
	for k, v in fresh :: any do
		(d :: any)[k] = v
	end
	d.Purchases = keep.Purchases
	d.Settings = keep.Settings
	d.SkipTokens = keep.SkipTokens
	d.TradesApplied = keep.TradesApplied
	DataService.Changed(player)
	resetSignal:Fire(player)
	return true
end

-- Waits (up to timeout) for the player's data.
function DataService.WaitFor(player: Player, timeout: number?): Data?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < (timeout or 30) do
		local d = DataService.Get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return nil
end

function DataService.AddDecorator(fn: (Player, any) -> ())
	table.insert(decorators, fn)
end

local function snapshot(player: Player, d: Data): any
	local s = {
		Ecto = d.Ecto,
		Hunters = d.Hunters,
		Equipped = d.Equipped,
		Discovered = d.Discovered,
		Zones = d.Zones,
		Upgrades = d.Upgrades,
		Daily = d.Daily,
		Boosts = d.Boosts,
		FreeCrates = d.FreeCrates,
		LuckyOpens = d.LuckyOpens,
		SkipTokens = d.SkipTokens,
		TowerRuns = d.TowerRuns,
		TowerBest = d.TowerBest,
		TowerCheckpoint = d.TowerCheckpoint,
		Variants = d.Variants,
		Settings = d.Settings,
		Tutorial = d.Tutorial,
		SeenUpdate = d.SeenUpdate,
		Stats = d.Stats,
		ServerTime = os.time(),
	}
	for _, fn in decorators do
		local ok, err = pcall(function()
			fn(player, s)
		end)
		if not ok then
			warn("[Data] snapshot decorator failed: " .. tostring(err))
		end
	end
	return s
end

-- Sends the client a fresh snapshot, batched: at most one per SYNC_GAP per player. The queued
-- send builds the snapshot when it runs, so the latest state always arrives.
function DataService.Changed(player: Player)
	local p = profiles[player]
	if not p or not p.Loaded or p.SyncQueued then
		return
	end
	p.SyncQueued = true
	local function send()
		p.SyncQueued = false
		if player.Parent and profiles[player] == p and not p.Leaving then
			p.LastSync = os.clock()
			syncRemote:FireClient(player, snapshot(player, p.Data))
		end
	end
	local wait = p.LastSync + SYNC_GAP - os.clock()
	if wait > 0 then
		task.delay(wait, send)
	else
		task.defer(send)
	end
end

-- Adds (negative: removes) Ectoplasm on a profile table: ignores NaN/inf, never below 0.
-- Leave hooks use this directly (the player can no longer be messaged then).
function DataService.AddEctoData(d: Data, amount: number): boolean
	if not finite(amount) then
		return false
	end
	amount = math.floor(amount)
	d.Ecto = math.max(0, d.Ecto + amount)
	if amount > 0 then
		d.TotalEcto += amount
	end
	return true
end

-- Currency changes are frequent: send only the number.
function DataService.AddEcto(player: Player, amount: number)
	local p = profiles[player]
	if not p or not p.Loaded or p.Leaving then
		return
	end
	if DataService.AddEctoData(p.Data, amount) then
		ectoRemote:FireClient(player, p.Data.Ecto)
	end
end

-- Spends Ectoplasm. Returns false if the player can't afford it.
function DataService.Spend(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or amount ~= amount or amount < 0 or d.Ecto < amount then
		return false
	end
	DataService.AddEcto(player, -amount)
	return true
end

-- Next unique hunter id (never reuses an id that is already owned).
function DataService.NewUid(d: Data): string
	if not finite(d.NextUid) or d.NextUid < 1 then
		d.NextUid = topUid(d) + 1
	end
	d.NextUid = math.floor(d.NextUid)
	local uid = tostring(d.NextUid)
	while d.Hunters[uid] ~= nil or d.Orphans[uid] ~= nil do
		d.NextUid += 1
		uid = tostring(d.NextUid)
	end
	d.NextUid += 1
	return uid
end

function DataService.Save(player: Player)
	task.spawn(saveProfile, player, false)
end

-- Saves now and waits (joins the next write); used by ProcessReceipt and trades. True only if
-- that write really happened.
function DataService.SaveNow(player: Player): boolean
	return saveProfile(player, false)
end

function DataService.Init()
	syncRemote = Net.Event("Sync")
	ectoRemote = Net.Event("Ecto")
	local ok, result = pcall(function()
		-- Studio play tests use their own scope, so testing never reads or writes live players' data
		return if IS_STUDIO
			then DataStoreService:GetDataStore(Config.DataStoreName, "studio")
			else DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		store = result
		if IS_STUDIO then
			-- Studio without "Enable Studio Access to API Services" errors on any request
			storeOk = pcall(function()
				(result :: DataStore):GetAsync("__probe")
			end)
		else
			storeOk = true -- live: per-player loads retry and kick on failure
		end
	end
	if not storeOk then
		warn(if IS_STUDIO
			then "[Data] DataStores unavailable in Studio (turn on API access). Progress will NOT be saved this test."
			else "[Data] DataStore unavailable: players will be asked to rejoin.")
	end
end

local function onPlayerAdded(player: Player)
	local p: Profile = {
		Data = defaults(),
		Key = keyFor(player),
		Session = HttpService:GenerateGUID(false),
		Loaded = false,
		Leaving = false,
		Saving = false,
		SyncQueued = false,
		JoinedAt = os.clock(),
		Seq = 0,
		LoadedSess = nil,
		LoadedSeq = nil,
		Pending = nil,
		LastWrite = -math.huge,
		LastSync = -math.huge,
	}
	profiles[player] = p
	-- rejoined this same server while the previous session was still saving: wait for it
	local t0 = os.clock()
	while leavingSaves[player.UserId] and os.clock() - t0 < 30 do
		task.wait(0.2)
	end
	local data, why = loadProfile(player, p)
	if data and player.Parent and profiles[player] == p then
		runHooks(loadHooks, player, data) -- e.g. finish a trade that a crash interrupted
	end
	if not player.Parent or profiles[player] ~= p then
		-- left while loading: release OUR lock (only if it is still ours) without writing data
		if data and storeOk and store then
			local ds = store :: DataStore
			pcall(function()
				ds:UpdateAsync(p.Key, function(old: any)
					if type(old) == "table" and type(old._lock) == "table" and old._lock.session == p.Session then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		if profiles[player] == p then
			profiles[player] = nil
		end
		return
	end
	if not data then
		profiles[player] = nil
		player:Kick(if why == "newer"
			then "This server is updating - please rejoin in a moment, your progress is safe."
			else "Couldn't load your Ghost Hunter data. Please rejoin in a moment - your progress is safe.")
		return
	end
	p.Data = data
	p.Loaded = true
	loadedSignal:Fire(player, data)
	DataService.Changed(player)
end

local function onPlayerRemoving(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	if p.Loaded and not p.Leaving then
		runHooks(leaveHooks, player, p.Data) -- e.g. pay out orbs that weren't picked up
	end
	p.Leaving = true
	if p.Loaded then
		leavingSaves[player.UserId] = true
		local saved = saveP(p, true)
		if not saved and storeOk then
			-- keep trying in the background (the data is still in memory; the lock is still ours)
			task.spawn(function()
				for i = 1, 3 do
					task.wait(8 * i)
					if saveP(p, true) then
						break
					end
				end
				leavingSaves[player.UserId] = nil
			end)
		else
			leavingSaves[player.UserId] = nil
		end
	end
	if profiles[player] == p then
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, pl in Players:GetPlayers() do
		task.spawn(onPlayerAdded, pl)
	end
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveSeconds)
			for player, p in profiles do
				if p.Loaded and not p.Leaving then
					task.spawn(saveProfile, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		if not storeOk then
			return
		end
		for player, p in profiles do
			if p.Loaded and not p.Leaving then
				runHooks(leaveHooks, player, p.Data)
				p.Leaving = true
				task.spawn(saveP, p, true)
			end
		end
		task.wait() -- let the saves start
		local t0 = os.clock()
		while inflight > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

-- Records a processed receipt id so a purchase is never granted twice.
function DataService.HasPurchase(d: Data, receipt: string): boolean
	return table.find(d.Purchases, receipt) ~= nil
end

function DataService.AddPurchase(d: Data, receipt: string)
	table.insert(d.Purchases, receipt)
	while #d.Purchases > 100 do
		table.remove(d.Purchases, 1)
	end
end

-- exposed for the save-compatibility test (tools/datacompat.sh); not used by the game
DataService._Migrate = migrate
DataService._TooNew = tooNew

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--!strict
-- Developer-only tools (DEV button + Studio chat commands). A player is a dev ONLY when the game
-- runs in Studio, or when their UserId is listed in Config.DevUserIds (live servers); being the
-- place creator or a group owner does NOT make anyone a dev. Every command is re-checked here on
-- the server, so the button showing up on a client means nothing by itself.
-- NOTE: in a live server these change the dev's REAL saved profile.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local PetService = require(script.Parent.PetService)
local CrewService = require(script.Parent.CrewService)
local GlobalEventService = require(script.Parent.GlobalEventService)
local RarePetEventService = require(script.Parent.RarePetEventService)
local TradeService = require(script.Parent.TradeService)
local Remotes = require(script.Parent.Remotes)

local DevService = {}

local devs: { [Player]: boolean } = {}

local function checkDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	-- live servers: ONLY the explicitly allowed developer UserIds (Config.DevUserIds)
	return table.find(Config.DevUserIds, player.UserId) ~= nil
end

function DevService.IsDev(player: Player): boolean
	return devs[player] == true
end

local MAX_ECTO_GRANT = 1e12
local MAX_SHARD_GRANT = 1e6
local MAX_TOWER_ROOM = 400
local ECTO2X_DEFAULT_HOURS = 48 -- "ON" without hours: never an endless global event

-- Dev-granted hunters: no release refund and can't be traded (they never leave the dev's profile).
local function markDevHunter(d: DataService.Data, uid: string?)
	local h = if uid then d.Hunters[uid] else nil
	if h then
		(h :: any).NoRefund = true;
		(h :: any).Dev = true
	end
end

-- whole number in [lo, hi], else nil
local function int(arg: any, lo: number, hi: number): number?
	if type(arg) ~= "number" or arg ~= arg or arg % 1 ~= 0 or arg < lo or arg > hi then
		return nil
	end
	return arg
end

-- Runs one dev command; returns an error text or nil (+ optional extra result fields).
function DevService.Run(player: Player, cmd: string, arg: any): (string?, any)
	if cmd == "StartRarePetEvent" then
		-- GLOBAL launch event: ONLY Config.RarePetEvent.AdminUserIds (any tester in Studio, where it
		-- stays in memory). Checked here AND inside the service; dev status alone is not enough.
		if not RarePetEventService.IsAdmin(player) then
			return "Not allowed"
		end
		local res = RarePetEventService.Activate(player)
		return (if res.ok then nil else res.err or "Failed"), { Event = res.Event, Created = res.Created }
	elseif cmd == "RarePetStatus" then
		if not RarePetEventService.IsAdmin(player) then
			return "Not allowed"
		end
		return nil, { Event = RarePetEventService.Status() }
	end
	if not devs[player] then
		return "Not allowed"
	end
	local d = DataService.Get(player)
	if not d then
		return "Loading..."
	end
	if cmd == "Ecto" then
		local n = tonumber(arg)
		if not n or n ~= n or n <= 0 then
			return "Bad amount"
		end
		DataService.AddEcto(player, math.min(math.floor(n), MAX_ECTO_GRANT))
	elseif cmd == "Zones" then
		for _, z in Config.Zones do
			d.Zones[z.Id] = true
		end
		DataService.Changed(player)
	elseif cmd == "Hunters" then
		-- one of every hunter the dev doesn't own yet (all areas, incl. new ones; storage cap ignored)
		local owned: { [string]: boolean } = {}
		for _, h in d.Hunters do
			owned[h.Id] = true
		end
		for id in Config.Hunters do
			if not owned[id] then
				markDevHunter(d, (HunterService.Add(player, id)))
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "IndexAll" then
		-- complete the Index: every hunter in Normal, Shiny and Mega + every pet seen
		for id in Config.Hunters do
			d.Discovered[id] = true
			d.Variants[id .. ":1"] = true
			d.Variants[id .. ":2"] = true
		end
		DataService.Changed(player)
	elseif cmd == "MegaCrew" then
		-- equipped hunters become Mega (tests tiers, power and HP without merging)
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h and (h.Tier or 0) < Config.Merge.MaxTier then -- only hunters it changes get the dev flag
				(h :: any).Tier = Config.Merge.MaxTier
				d.Variants[h.Id .. ":" .. Config.Merge.MaxTier] = true
				markDevHunter(d, uid)
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "ShinyCrew" then
		for _, uid in d.Equipped do
			local h = d.Hunters[uid]
			if h and (h.Tier or 0) < 1 then -- never downgrades a Mega
				(h :: any).Tier = 1
				d.Variants[h.Id .. ":1"] = true
				markDevHunter(d, uid)
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "MergeCopies" then
		-- 4 more copies of each equipped hunter (5 in total: enough to test a merge)
		for _, uid in table.clone(d.Equipped) do
			local h = d.Hunters[uid]
			if h then
				for _ = 1, Config.Merge.Count - 1 do
					markDevHunter(d, (HunterService.Add(player, h.Id)))
				end
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "Teleport" then
		-- quick trips around the lobby (outside the Boss Tower only)
		if player:GetAttribute("InTower") then
			return "Leave the Boss Tower first"
		end
		local spots: { [string]: Vector3 } = {
			Lobby = Config.Layout.Spawn,
			Tower = Config.Layout.TowerEntrance.Pad,
			Hatchery = Config.Layout.Hatchery,
		}
		local spot = if type(arg) == "string" then spots[arg] else nil
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not spot or not char or not root then
			return "Can't teleport"
		end
		local to = spot + Vector3.new(0, 4, if arg == "Lobby" then 0 else 8)
		char:PivotTo(CFrame.new(to))
	elseif cmd == "UnlockEggs" then
		-- the tower checkpoint every egg needs (checkpoint and best room only ever go up)
		local need = 0
		for _, egg in Config.Eggs do
			need = math.max(need, egg.Unlock)
		end
		d.TowerCheckpoint = math.max(d.TowerCheckpoint, need)
		d.TowerBest = math.max(d.TowerBest, need)
		DataService.Changed(player)
	elseif cmd == "LuckyOpens" then
		for id in Config.Crates do
			d.LuckyOpens[id] = Config.LuckyOpens.MaxStack
		end
		DataService.Changed(player)
	elseif cmd == "SkipTokens" then
		d.SkipTokens += 10
		DataService.Changed(player)
	elseif cmd == "Boosts" then
		PlayerInfo.AddBoost(d, "Ecto", 1800)
		PlayerInfo.AddBoost(d, "Luck", 1800)
		DataService.Changed(player)
	elseif cmd == "KnockCrew" then
		-- knock out the equipped crew for 30 s (tests knockouts, countdowns and recovery)
		for _, uid in d.Equipped do
			d.Knocked[uid] = os.time() + 30
		end
		HunterService.Refresh(player)
	elseif cmd == "MaxUpgrades" then
		for id, up in Config.Upgrades do
			d.Upgrades[id] = #up.Levels
		end
		DataService.Changed(player)
	elseif cmd == "Ecto2x" then
		-- GLOBAL 2X Ectoplasm (all servers); arg = true (48 h) / false (OFF) / hours (timed, 1-168)
		local err
		if type(arg) == "number" and arg == arg then
			err = GlobalEventService.SetEcto2x(true, math.clamp(arg, 1, 168) * 3600)
		elseif arg == true then
			err = GlobalEventService.SetEcto2x(true, ECTO2X_DEFAULT_HOURS * 3600)
		else
			err = GlobalEventService.SetEcto2x(false)
		end
		if err then
			return err
		end
	elseif cmd == "ResetProgress" then
		-- the dev's OWN progress only (back to a new player); purchases/passes are kept
		if TradeService.InTrade(player) then
			return "Finish or cancel your trade first"
		end
		if not DataService.ResetProgress(player) then
			return "Couldn't reset"
		end
		-- a new profile starts with the starter hunter equipped (normally given on join)
		local fresh = DataService.Get(player)
		local uid = HunterService.Add(player, Config.StarterHunter)
		if fresh and uid then
			fresh.Equipped = { uid }
		end
		HunterService.Refresh(player)
		player:LoadCharacter() -- back to spawn (the old area may be locked now)
	elseif cmd == "AllPets" then
		-- one copy of each pet the dev doesn't own yet (repeat-safe)
		local owned: { [string]: boolean } = {}
		for _, pet in d.Pets do
			owned[pet.Id] = true
		end
		for _, petId in Config.PetOrder do
			if Config.Pets[petId] and not owned[petId] then
				PetService.Add(d, petId)
				owned[petId] = true
			end
		end
		PetService.Refresh(player)
		DataService.Save(player)
	elseif cmd == "HealAll" then
		table.clear(d.Knocked)
		CrewService.HealAll(player)
		HunterService.Refresh(player)
	elseif cmd == "Shards" then
		-- spendable shards only; TowerShards stays the earned-reward record
		local n = int(arg, 1, MAX_SHARD_GRANT)
		if not n then
			return "Amount must be a whole number 1-1000000"
		end
		d.Shards += n
		DataService.Changed(player)
	elseif cmd == "TowerRoom" then
		local room = int(arg, 1, MAX_TOWER_ROOM)
		if not room then
			return "Room must be a whole number 1-400"
		end
		-- lazy require: TowerService loads after DevService's dependencies
		local ok, TS = pcall(require, (script.Parent :: any).TowerService)
		if not ok or type(TS) ~= "table" or type(TS.DevStart) ~= "function" then
			return "Tower dev jump not available"
		end
		local err = TS.DevStart(player, room)
		if err then
			return err
		end
	elseif cmd == "ResetDaily" then
		d.Daily.Last = 0
		DataService.Changed(player)
	elseif cmd == "AutoAttack" then
		-- the LEGACY Auto Attack pass (no longer sold; Auto Attack is free): owning it grants Auto Open
		PlayerInfo.SetPass(player, "AutoAttack", true)
		HunterService.Refresh(player)
	elseif cmd == "AllPasses" then
		-- every game pass for this session only (testing; nothing is saved or bought)
		for _, pass in Config.GamePasses do
			PlayerInfo.SetPass(player, pass.Key, true)
		end
		local shop = (script.Parent :: any).ShopService
		if shop then
			local ok, mod = pcall(require, shop)
			if ok and mod.ApplyPassLooks then
				mod.ApplyPassLooks(player)
			end
		end
		HunterService.Refresh(player)
	elseif cmd == "ServerLuck" then
		PlayerInfo.AddServerLuck(900)
		for _, other in Players:GetPlayers() do
			DataService.Changed(other)
		end
	elseif cmd == "Exclusive" then
		markDevHunter(d, (HunterService.GrantExclusive(player)))
	elseif cmd == "RarePetAddMinutes" then
		-- Studio only: +N minutes of rare pet event play time (tests the reward without waiting)
		local err = RarePetEventService.StudioAddMinutes(player, tonumber(arg) or 5)
		if err then
			return err
		end
	elseif cmd == "Tutorial" then
		d.Tutorial = 1
		DataService.Changed(player)
	else
		return "Unknown command"
	end
	return nil
end

function DevService.Init()
	Remotes.Register("Dev", "Default", function(player, cmd, arg)
		if type(cmd) ~= "string" then
			return Remotes.Fail("Bad command")
		end
		local err, extra = DevService.Run(player, cmd, arg)
		local res: { [string]: any } = if err then Remotes.Fail(err) else { ok = true }
		if type(extra) == "table" then
			for k, v in extra do
				res[k] = v
			end
		end
		return res
	end)
end

local CHAT: { [string]: string } = {
	["/reset-daily"] = "ResetDaily",
	["/autoattack"] = "AutoAttack",
	["/zones"] = "Zones",
	["/hunters"] = "Hunters",
	["/maxupgrades"] = "MaxUpgrades",
	["/tutorial"] = "Tutorial",
}

function DevService.Start()
	local function hook(player: Player)
		task.spawn(function()
			devs[player] = checkDev(player)
			-- the client shows the DEV button for this attribute; the server still checks every call
			player:SetAttribute("IsDev", devs[player])
		end)
		player.Chatted:Connect(function(msg)
			if not devs[player] then
				return
			end
			local n = msg:match("^/ecto%s+(%d+)")
			if n then
				DevService.Run(player, "Ecto", tonumber(n))
			elseif CHAT[msg] then
				DevService.Run(player, CHAT[msg], nil)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		devs[player] = nil
	end)
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DropService</string>
            <string name="Source"><![CDATA[--!strict
-- Physical Ectoplasm orbs. The SERVER decides where each orb lands, what it is worth and
-- when it is picked up (player's root within their pickup radius). Clients only draw orbs
-- (bounce, glow, magnet flight). Orbs are per player, so nobody can steal another's loot.
-- One loop checks every player's orbs on a short interval; no per-orb connections.
-- v1.6: an orb is an EARNED payout, so it is never lost: orbs that time out or are pushed out
-- by the per-player cap are credited automatically, and when a player leaves (or the server
-- closes) every orb still on the ground is credited before the final save.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Signal = require(GH.Signal)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)

local DropService = {}

type Drop = { Id: number, Pos: Vector3, Value: number, Expires: number }
type Bag = { List: { Drop }, NextId: number }

local bags: { [Player]: Bag } = {}
local dropsRemote: RemoteEvent
local collectRemote: RemoteEvent
local rng = Random.new()
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local collectedSignal = Signal.new()
DropService.Collected = collectedSignal -- (player, amount)

-- Ground raycasts ignore ghosts and characters (filter built once per Spawn call).
local function refreshFilter()
	local filter: { Instance } = {}
	local ghosts = workspace:FindFirstChild("Ghosts")
	if ghosts then
		table.insert(filter, ghosts)
	end
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(filter, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
end

local function groundAt(x: number, y: number, z: number): number
	local hit = workspace:Raycast(Vector3.new(x, y + 4, z), Vector3.new(0, -80, 0), rayParams)
	return if hit then hit.Position.Y else 0
end

-- Spawns `total` Ectoplasm split into `count` orbs around `origin` for `player`.
-- scatter = {min, max} studs (defaults from Config.Drops).
function DropService.Spawn(player: Player, origin: Vector3, total: number, count: number, scatter: { number }?)
	local bag = bags[player]
	if not bag then
		return
	end
	local values = Rules.Split(total, math.max(1, count))
	local sMin = if scatter then scatter[1] else Config.Drops.ScatterMin
	local sMax = if scatter then scatter[2] else Config.Drops.ScatterMax
	local expires = os.clock() + Config.Drops.Lifetime
	local out: { { any } } = {}
	local removed: { number } = {}
	local autoCredit = 0
	refreshFilter()
	for _, v in values do
		-- over the cap (nobody is collecting): the oldest orb is auto-collected to make room
		if #bag.List >= Config.Drops.MaxPerPlayer then
			local oldest = 1
			for i, d in bag.List do
				if d.Expires < bag.List[oldest].Expires then
					oldest = i
				end
			end
			table.insert(removed, bag.List[oldest].Id)
			autoCredit += bag.List[oldest].Value
			bag.List[oldest] = bag.List[#bag.List]
			bag.List[#bag.List] = nil
		end
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber(sMin, sMax)
		local x = origin.X + math.cos(a) * r
		local z = origin.Z + math.sin(a) * r
		-- keep orbs inside the playable area
		x = math.clamp(x, -Config.Layout.HalfWidth + 4, Config.Layout.HalfWidth - 4)
		local y = groundAt(x, origin.Y, z) + 1.1
		local drop: Drop = { Id = bag.NextId, Pos = Vector3.new(x, y, z), Value = v, Expires = expires }
		bag.NextId += 1
		table.insert(bag.List, drop)
		table.insert(out, { drop.Id, drop.Pos, drop.Value } :: { any })
	end
	if #out > 0 then
		dropsRemote:FireClient(player, origin, out, removed)
	end
	if autoCredit > 0 then
		DataService.AddEcto(player, autoCredit)
	end
end

local function pickupTick()
	local t = os.clock()
	for player, bag in bags do
		if #bag.List == 0 then
			continue
		end
		local root = Remotes.Root(player)
		local radius = PlayerInfo.PickupRadius(player) + 1.5 -- latency slack
		local r2 = radius * radius
		local got = 0
		local ids = {}
		local i = 1
		while i <= #bag.List do
			local d = bag.List[i]
			local take = false
			if root then
				local dx = d.Pos.X - root.Position.X
				local dz = d.Pos.Z - root.Position.Z
				take = dx * dx + dz * dz <= r2 and math.abs(d.Pos.Y - root.Position.Y) < 14
			end
			if take then
				got += d.Value
				table.insert(ids, d.Id)
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			elseif t >= d.Expires then
				got += d.Value -- timed out: still paid (it was earned)
				table.insert(ids, d.Id)
				bag.List[i] = bag.List[#bag.List]
				bag.List[#bag.List] = nil
			else
				i += 1
			end
		end
		if got > 0 then
			DataService.AddEcto(player, got)
			collectRemote:FireClient(player, ids, got)
			collectedSignal:Fire(player, got)
		end
	end
end

function DropService.Init()
	dropsRemote = Net.Event("Drops")
	collectRemote = Net.Event("Collect")
	-- leaving / server closing: credit every orb still on the ground before the final save
	DataService.AddLeaveHook(function(player, data)
		local bag = bags[player]
		if not bag then
			return
		end
		local total = 0
		for _, d in bag.List do
			total += d.Value
		end
		table.clear(bag.List)
		if total > 0 then
			DataService.AddEctoData(data, total) -- same guarded path as AddEcto (finite, never below 0)
		end
	end)
end

function DropService.Start()
	local function add(player: Player)
		bags[player] = { List = {}, NextId = 1 }
	end
	Players.PlayerAdded:Connect(add)
	for _, pl in Players:GetPlayers() do
		add(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- DataService's leave hook credits the orbs; drop the bag a little later so the hook
		-- never finds it already gone (PlayerRemoving handlers run in any order)
		task.delay(30, function()
			if not player.Parent then
				bags[player] = nil
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Drops.PickupTick)
			local ok, err = pcall(function()
				pickupTick()
			end)
			if not ok then
				warn("[Drops] tick error: " .. tostring(err))
			end
		end
	end)
end

return DropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- RETIRED: the GIANT POLTERGEIST lobby event (a server-wide boss in front of the Boss Tower) was
-- removed; the Endless Boss Tower replaces it. This module stays so older callers keep working:
-- nothing is scheduled or spawned, and TriggerNow is a harmless no-op.
-- (The "SummonEvent" Robux product is no longer sold; ShopService grants a substitute for
-- any old receipt.)
local EventService = {}

function EventService.Init() end

function EventService.Start() end

-- Old entry point (DEV button / Summon product): does nothing now. Returns false = not started.
function EventService.TriggerNow(): boolean
	return false
end

function EventService.IsBusy(): boolean
	return false
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FeedbackService</string>
            <string name="Source"><![CDATA[--!strict
-- Player feedback (bug reports + ideas). Players send short text from the FEEDBACK panel; it is
-- run through Roblox's text filter and kept in a DataStore inbox (one key per day, newest first,
-- capped) that only developers can read from the DEV panel. Cooldown + per-server cap + a
-- durable per-day cap (counted in that day's inbox) stop spam. Studio keeps feedback in memory.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local DevService = require(script.Parent.DevService)
local Remotes = require(script.Parent.Remotes)

local FeedbackService = {}

export type Entry = { T: number, UserId: number, Name: string, Kind: string, Text: string, Zone: string, Version: string }

local KEY = "Inbox" -- day shards are "Inbox_<day>"; "Inbox" itself is the old single inbox
local DAY = 86400
local store: DataStore? = nil
local memory: { Entry } = {} -- Studio without API access: keep this session's feedback here
local lastSent: { [Player]: number } = {}
local sentCount: { [Player]: number } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function zoneOf(player: Player): string
	local root = Remotes.Root(player)
	if not root then
		return "?"
	end
	local z = Config.Zones[Rules.ZoneIndexAt(root.Position.Z, zoneRanges)]
	return if z then z.Id else "?"
end

local function filter(player: Player, text: string): string?
	local ok, result = pcall(function()
		local r = TextService:FilterStringAsync(text, player.UserId)
		return r:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	-- the filter is unavailable in some Studio setups; never store unfiltered text live
	return if RunService:IsStudio() then text else nil
end

local function day(t: number): number
	return math.floor(t / DAY)
end

-- messages this user already sent on the entry's day
local function countToday(list: { any }, entry: Entry): number
	local n = 0
	for _, e in list do
		if type(e) == "table" and e.UserId == entry.UserId and type(e.T) == "number" and day(e.T) == day(entry.T) then
			n += 1
		end
	end
	return n
end

-- Returns (saved, over the daily cap).
local function save(entry: Entry): (boolean, boolean)
	local s = store
	if not s then
		if countToday(memory, entry) >= Config.Feedback.PerServer then
			return false, true
		end
		table.insert(memory, 1, entry)
		return true, false
	end
	local full = false
	local ok = pcall(function()
		s:UpdateAsync(KEY .. "_" .. day(entry.T), function(old: any)
			local list = if type(old) == "table" then old else {}
			full = countToday(list, entry) >= Config.Feedback.PerServer
			if full then
				return nil -- don't write
			end
			table.insert(list, 1, entry)
			while #list > Config.Feedback.InboxSize do
				table.remove(list)
			end
			return list
		end)
	end)
	return ok and not full, ok and full
end

-- Newest first: today's shard, the days before, then the old single inbox.
local function load(): { Entry }
	local s = store
	if not s then
		return memory
	end
	local out: { Entry } = {}
	local today = day(os.time())
	for i = 0, 7 do
		local key = if i < 7 then KEY .. "_" .. (today - i) else KEY
		local ok, list = pcall(function()
			return s:GetAsync(key)
		end)
		if ok and type(list) == "table" then
			for _, e in list do
				table.insert(out, e)
			end
		end
		if #out >= 60 then
			break
		end
	end
	return out
end

function FeedbackService.Init()
	if not RunService:IsStudio() then -- Studio: memory only, never the live inbox
		local ok, ds = pcall(function()
			return DataStoreService:GetDataStore(Config.Feedback.DataStoreName)
		end)
		store = if ok then ds else nil
	end

	Remotes.Register("Feedback", "Default", function(player, kind, text)
		local fb = Config.Feedback
		if kind ~= "Bug" and kind ~= "Idea" then
			return Remotes.Fail("Pick BUG or IDEA")
		end
		if type(text) ~= "string" then
			return Remotes.Fail("Write something first")
		end
		if #text > fb.MaxLength * 4 then
			return Remotes.Fail("That's too long") -- don't run pattern work on huge strings
		end
		local clean = text:gsub("%c", " "):gsub("^%s+", ""):gsub("%s+$", "")
		if #clean < fb.MinLength then
			return Remotes.Fail("Tell us a bit more (" .. fb.MinLength .. "+ letters)")
		end
		if #clean > fb.MaxLength then
			clean = clean:sub(1, fb.MaxLength)
		end
		local now = os.clock()
		if now - (lastSent[player] or -math.huge) < fb.Cooldown then
			return Remotes.Fail("Thanks! Wait a minute before sending more.")
		end
		if (sentCount[player] or 0) >= fb.PerServer then
			return Remotes.Fail("Thanks! You've sent a lot already today.")
		end
		lastSent[player] = now
		local filtered = filter(player, clean)
		if not filtered then
			return Remotes.Fail("Couldn't send right now, try again later")
		end
		local entry: Entry = {
			T = os.time(),
			UserId = player.UserId,
			Name = player.Name,
			Kind = kind,
			Text = filtered,
			Zone = zoneOf(player),
			Version = Config.Version,
		}
		local saved, full = save(entry)
		if not player.Parent then
			lastSent[player] = nil -- left while the filter/save yielded: don't keep their entries
			return { ok = saved }
		end
		if full then
			sentCount[player] = fb.PerServer
			return Remotes.Fail("Thanks! You've sent a lot already today.")
		end
		if not saved then
			lastSent[player] = nil
			return Remotes.Fail("Couldn't send right now, try again later")
		end
		sentCount[player] = (sentCount[player] or 0) + 1
		return { ok = true }
	end)

	-- developers read the inbox from the DEV panel
	Remotes.Register("FeedbackInbox", "Default", function(player)
		if not DevService.IsDev(player) then
			return Remotes.Fail("Not allowed")
		end
		local list = load()
		local out = {}
		for i = 1, math.min(#list, 60) do
			table.insert(out, list[i])
		end
		return { ok = true, Entries = out }
	end)
end

function FeedbackService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastSent[player] = nil
		sentCount[player] = nil
	end)
	local _ = DataService
end

return FeedbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Server → client effect/announcement messages over the "Fx" remote.
-- Kinds: Poof, Announce, ZoneUnlocked, Boss, Toast, Upgrade, Daily (see docs/ARCHITECTURE.md).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("GH").Net)

local Fx = {}
local remote: RemoteEvent

function Fx.Init()
	remote = Net.Event("Fx")
end

function Fx.All(kind: string, data: any?)
	remote:FireAllClients(kind, data)
end

-- Everyone except one player (e.g. the opener of a legendary crate, who sees the reveal).
function Fx.AllExcept(except: Player, kind: string, data: any?)
	for _, pl in game:GetService("Players"):GetPlayers() do
		if pl ~= except then
			remote:FireClient(pl, kind, data)
		end
	end
end

function Fx.To(player: Player, kind: string, data: any?)
	remote:FireClient(player, kind, data)
end

function Fx.Toast(player: Player, text: string, color: string?)
	remote:FireClient(player, "Toast", { Text = text, Color = color })
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">GhostService</string>
            <string name="Source"><![CDATA[--!strict
-- Ghost spawning, wandering, targeting and server-authoritative damage.
--
-- Movement is NOT simulated per frame on the server. Each ghost has a straight wander segment
-- (one packed string attribute "Seg" = "fx,fy,fz|tx,ty,tz|t0|dur", server time, so each move
-- replicates one attribute instead of four); the server evaluates the position only when it
-- needs it (range checks, drops) and every client animates the model locally along the same
-- segment. One loop handles all ghosts, so there is no per-ghost Heartbeat connection.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)
local Signal = require(GH.Signal)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local CrewService = require(script.Parent.CrewService)
local DropService = require(script.Parent.DropService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local GhostService = {}

export type Ghost = {
	Uid: number,
	Def: Config.GhostDef,
	Model: Model,
	Spirit: number,
	Max: number,
	From: Vector3,
	To: Vector3,
	T0: number,
	Dur: number,
	NextMove: number,
	Center: Vector3,
	Radius: number,
	Alive: boolean,
	Event: boolean,
	Area: number?, -- index into Config.Layout.GhostAreas (nil for event ghosts)
	-- effective damage per player (health actually removed; overkill never counts). The record
	-- belongs to this one encounter and goes away with the ghost.
	Damage: { [Player]: number },
	DirtySpirit: boolean,
	Tower: any?, -- Boss Tower run that owns this boss (only its members may fight it)
	HitFrac: number?, -- tower bosses: hit = target max HP * this
	NextAttack: number, -- os.clock of the next retaliation
	Pending: { Player: Player, Uid: string, Lands: number, Seen: { Player } }?, -- telegraphed hit in flight
	LastKey: string?, -- "userId:uid" hit last (targets rotate)
}

local buildHitbox: (Config.GhostDef, Vector3) -> Model
local ghosts: { [number]: Ghost } = {}
local byArea: { [number]: { Ghost } } = {} -- live ghosts per spawn area (spacedPoint scans only its own area)
local nextUid = 1
local folder: Folder
local rng = Random.new()

-- Ready = os.clock() when damage may start (hunters need time to run over).
-- Auto = picked by Auto Attack (manual picks are never replaced automatically).
type Target = { Uid: number, Ready: number, Auto: boolean }
local targets: { [Player]: Target } = {}

-- Auto Attack toggle (session only, default OFF). Free for every player.
local autoOn: { [Player]: boolean } = {}

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local killedSignal = Signal.new()
GhostService.Killed = killedSignal -- (ghost: Ghost, killer: Player?) by reference

local function now(): number
	return workspace:GetServerTimeNow()
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function GhostService.Position(g: Ghost, t: number?): Vector3
	local a = if g.Dur > 0 then math.clamp(((t or now()) - g.T0) / g.Dur, 0, 1) else 1
	return g.From:Lerp(g.To, smooth(a))
end

function GhostService.Get(uid: number): Ghost?
	return ghosts[uid]
end

function GhostService.All(): { [number]: Ghost }
	return ghosts
end

local function randomPoint(center: Vector3, radius: number, hover: number): Vector3
	local a = rng:NextNumber() * math.pi * 2
	local r = math.sqrt(rng:NextNumber()) * radius
	return Vector3.new(center.X + math.cos(a) * r, center.Y + hover, center.Z + math.sin(a) * r)
end

-- A random point that keeps clear of the other live ghosts of the same spawn area (first try
-- that leaves `spacing` studs, else the roomiest of a few tries), so ghosts don't stack and
-- each one stays easy to tap.
local SPREAD_TRIES = 5
local function spacedPoint(center: Vector3, radius: number, hover: number, area: number?, self: Ghost?, spacing: number): Vector3
	local best, bestGap = randomPoint(center, radius, hover), -1
	if area == nil then
		return best
	end
	local want = spacing * spacing
	local peers: { Ghost } = byArea[area] or {}
	for i = 1, SPREAD_TRIES do
		local p = if i == 1 then best else randomPoint(center, radius, hover)
		local gap = math.huge
		for _, o in peers do
			if o ~= self and o.Alive then
				local q = o.To
				local dx, dz = p.X - q.X, p.Z - q.Z
				gap = math.min(gap, dx * dx + dz * dz)
			end
		end
		if gap >= want then
			return p
		end
		if gap > bestGap then
			best, bestGap = p, gap
		end
	end
	return best
end

local function setSegment(g: Ghost, to: Vector3)
	local t = now()
	local from = GhostService.Position(g, t)
	g.From = from
	g.To = to
	g.T0 = t
	g.Dur = math.max(0.5, (to - from).Magnitude / math.max(g.Def.Speed, 0.1))
	g.NextMove = t + g.Dur + rng:NextNumber(0.4, g.Def.Wander)
	local m = g.Model
	local f, o = g.From, g.To
	m:SetAttribute("Seg", string.format("%.2f,%.2f,%.2f|%.2f,%.2f,%.2f|%.3f|%.3f", f.X, f.Y, f.Z, o.X, o.Y, o.Z, g.T0, g.Dur))
end

-- The server's ghost is only an invisible, generously sized tap target (Core) with the
-- attachments beams and labels use. Every client builds the visual rig (GhostRig) locally,
-- so a kill/respawn replicates one part instead of a whole model.
function buildHitbox(def: Config.GhostDef, pos: Vector3): Model
	local s = def.Scale
	local model = Instance.new("Model")
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(1, 1, 1) * (Config.Combat.HitboxDiameter * s)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = true
	core.CastShadow = false
	core.CFrame = CFrame.new(pos)
	core.Parent = model
	local attachments: { [string]: number } = { Center = 0, Top = 2.4 * s, Bottom = -2.1 * s }
	for name, y in attachments do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = Vector3.new(0, y, 0)
		a.Parent = core
	end
	model.PrimaryPart = core
	return model
end

-- Creates a ghost. `spirit` overrides the config value (event ghost scaling).
export type SpawnOpts = { Spirit: number?, Event: boolean?, Area: number?, Tower: any?, HitFrac: number?, Pos: Vector3? }

function GhostService.Spawn(def: Config.GhostDef, center: Vector3, radius: number, opts: SpawnOpts?): Ghost
	local o: SpawnOpts = opts or {}
	local uid = nextUid
	nextUid += 1
	local spirit = math.floor(o.Spirit or def.Spirit)
	local pos = o.Pos or spacedPoint(center, radius, def.Hover, o.Area, nil, Config.Combat.HitboxDiameter * def.Scale * 1.4)
	local model = buildHitbox(def, pos)
	model.Name = "Ghost_" .. uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("GhostId", def.Id)
	model:SetAttribute("Spirit", spirit)
	model:SetAttribute("MaxSpirit", spirit)
	model:SetAttribute("Zone", def.Zone)
	model:SetAttribute("Event", o.Event == true)
	model:SetAttribute("Tower", o.Tower ~= nil)
	local g: Ghost = {
		Uid = uid,
		Def = def,
		Model = model,
		Spirit = spirit,
		Max = spirit,
		From = pos,
		To = pos,
		T0 = now(),
		Dur = 0,
		NextMove = 0,
		Center = center,
		Radius = radius,
		Alive = true,
		Event = o.Event == true,
		Area = o.Area,
		Damage = {},
		DirtySpirit = false,
		Tower = o.Tower,
		HitFrac = o.HitFrac,
		NextAttack = 0,
		Pending = nil,
	}
	ghosts[uid] = g
	if o.Area then
		local list = byArea[o.Area]
		if not list then
			list = {}
			byArea[o.Area] = list
		end
		table.insert(list, g)
	end
	setSegment(g, pos)
	g.NextMove = now() + rng:NextNumber(0, def.Wander)
	model.Parent = folder
	return g
end

local function rootPos(player: Player): Vector3?
	local root = Remotes.Root(player)
	return if root then root.Position else nil
end

local function setTarget(player: Player, uid: number?, auto: boolean?)
	local g = uid and ghosts[uid]
	if uid and g then
		-- damage starts once the crew could plausibly have run to the ghost
		local p = rootPos(player)
		local run = if p then (GhostService.Position(g) - p).Magnitude / Config.Combat.HunterRunSpeed else 0
		targets[player] = { Uid = uid, Ready = os.clock() + Config.Combat.EngageDelay + math.min(run, 2), Auto = auto == true }
		player:SetAttribute("Target", uid)
	else
		targets[player] = nil
		player:SetAttribute("Target", 0)
	end
end

function GhostService.AutoActive(player: Player): boolean
	return autoOn[player] == true -- FREE for every player (no pass)
end

-- Auto Attack pick: nearest living ghost the player may fight, in the zone the player is
-- standing in (so hunters never run through zone walls), within Config.AutoAttack.Range.
local function autoCandidate(player: Player): Ghost?
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not d or not p then
		return nil
	end
	local here = Rules.ZoneIndexAt(p.Z, zoneRanges)
	local best, bestDist = nil, Config.AutoAttack.Range
	local t = now()
	for _, g in ghosts do
		local zone = Config.ZoneById[g.Def.Zone]
		if g.Alive and not g.Tower and zone and zone.Order == here and d.Zones[zone.Id] then
			local dist = (GhostService.Position(g, t) - p).Magnitude
			if dist < bestDist then
				best, bestDist = g, dist
			end
		end
	end
	return best
end

-- Contribution list for a finished encounter: players still in the server with damage > 0
-- (stable order: biggest damage first, then UserId).
function GhostService.SplitDamage(g: Ghost): { Players: { Player }, Weights: { number }, Total: number }
	local list = {}
	for player, dmg in g.Damage do
		if player.Parent and dmg > 0 then
			table.insert(list, { P = player, D = dmg })
		end
	end
	table.sort(list, function(a, b)
		if a.D ~= b.D then
			return a.D > b.D
		end
		return a.P.UserId < b.P.UserId
	end)
	local out = { Players = {}, Weights = {}, Total = 0 }
	for _, e in list do
		table.insert(out.Players, e.P)
		table.insert(out.Weights, e.D)
		out.Total += e.D
	end
	return out
end

-- Removes a ghost. reward=false for escapes/cleanup.
function GhostService.Remove(g: Ghost, killer: Player?, reward: boolean)
	if not g.Alive then
		return
	end
	g.Alive = false
	ghosts[g.Uid] = nil
	local list = g.Area and byArea[g.Area]
	if list then
		local i = table.find(list, g)
		if i then
			list[i] = list[#list]
			list[#list] = nil
		end
	end
	local pos = GhostService.Position(g)
	g.Model:SetAttribute("Spirit", 0)
	g.Model:SetAttribute("Dead", true)
	Fx.All("Poof", {
		Uid = g.Uid,
		Pos = pos,
		Scale = g.Def.Scale,
		Color = g.Def.Glow,
		Big = g.Def.Kind ~= "Normal",
		Escaped = not reward,
	})
	task.delay(1.2, function()
		g.Model:Destroy()
	end)

	if reward and not g.Event and not g.Tower then
		-- SHARED REWARD: the ghost's reward is one pool, split by each player's share of the
		-- damage (all of their hunters; overkill never counts). Whole units, largest remainder,
		-- so the base pool is always paid out exactly. No last-hit bonus; no damage, no reward.
		-- Each share is then scaled by that player's own Ectoplasm multiplier (upgrades, passes,
		-- boosts, pets, events).
		local shares = GhostService.SplitDamage(g)
		local pool = Rules.SplitPool(g.Def.Reward, shares.Weights)
		for i, player in shares.Players do
			local base = pool[i]
			local d = DataService.Get(player)
			if d and shares.Weights[i] > 0 then
				d.Stats.Ghosts += 1
				if base > 0 then
					local total = math.max(1, math.floor(base * PlayerInfo.EctoMultiplier(player) + 0.5))
					DropService.Spawn(player, pos, total, g.Def.Drops, nil)
					if #shares.Players > 1 or g.Def.Kind ~= "Normal" then
						Fx.To(player, "Payout", { Name = g.Def.Name, Pct = shares.Weights[i] / shares.Total, Ecto = total })
					end
				end
			end
		end
	end
	if reward then
		killedSignal:Fire(g, killer)
	end

	-- Hunters on this ghost come home. Only players with Auto Attack ON get a new
	-- ghost picked for them; everyone else chooses their next ghost by clicking/tapping it.
	for player, tg in targets do
		if tg.Uid == g.Uid then
			local nextG = if GhostService.AutoActive(player) then autoCandidate(player) else nil
			setTarget(player, if nextG then nextG.Uid else nil, true)
		end
	end

	if g.Area then
		local area = Config.Layout.GhostAreas[g.Area]
		task.delay(g.Def.Respawn, function()
			GhostService.Spawn(g.Def, area.Center, area.Radius, { Area = g.Area })
		end)
	end
end

local function onSelect(player: Player, uid: any)
	if not Remotes.Allow(player, "SelectTarget") then
		return
	end
	if uid == nil or uid == 0 then
		setTarget(player, nil)
		return
	end
	if type(uid) ~= "number" then
		return
	end
	local g = ghosts[uid]
	local d = DataService.Get(player)
	local p = rootPos(player)
	if not g or not g.Alive or not d or not p then
		return
	end
	if g.Tower then
		if not (g.Tower :: any).Members[player] then
			return -- only the party that owns this tower room may fight its boss
		end
	elseif not d.Zones[g.Def.Zone] then
		Fx.Toast(player, "Unlock " .. (Config.ZoneById[g.Def.Zone] :: Config.ZoneDef).Name .. " first!", "Bad")
		return
	end
	if (GhostService.Position(g) - p).Magnitude > Config.Combat.MaxRange + 15 then
		Fx.Toast(player, "Get closer to that ghost!", "Bad")
		return
	end
	local cur = targets[player]
	if cur and cur.Uid == uid then
		cur.Auto = false -- the player chose it: Auto Attack OFF won't drop it
		return
	end
	setTarget(player, uid, false)
end

-- Gives Auto Attack players a ghost whenever their crew is idle.
local function autoTick()
	for player, on in autoOn do
		if on and not targets[player] and player.Parent and GhostService.AutoActive(player) then
			local g = autoCandidate(player)
			if g then
				setTarget(player, g.Uid, true)
			end
		end
	end
end

local function damageTick(dt: number)
	local t = now()
	local clock = os.clock()
	for player, tg in targets do
		local g = ghosts[tg.Uid]
		if not g or not g.Alive or not player.Parent then
			targets[player] = nil
			if player.Parent then
				player:SetAttribute("Target", 0)
			end
			continue
		end
		local p = rootPos(player)
		if not p then
			continue
		end
		local dist = (GhostService.Position(g, t) - p).Magnitude
		if dist > Config.Combat.MaxRange * 1.4 then
			setTarget(player, nil) -- walked away: hunters come home
			continue
		end
		if dist > Config.Combat.MaxRange or clock < tg.Ready then
			continue
		end
		local power = HunterService.CrewPower(player)
		if power <= 0 then
			continue
		end
		local dmg = Rules.Effective(power * dt, g.Spirit) -- overkill never counts
		g.Spirit -= dmg
		g.Damage[player] = (g.Damage[player] or 0) + dmg
		g.DirtySpirit = true
		if g.Spirit <= 0 then
			GhostService.Remove(g, player, true)
		end
	end
	for _, g in ghosts do
		if g.DirtySpirit and g.Alive then
			g.DirtySpirit = false
			g.Model:SetAttribute("Spirit", math.max(0, math.ceil(g.Spirit)))
		end
	end
end

-- Players whose crews are attacking `g` right now (same condition that deals damage).
local function attackers(g: Ghost, t: number, clock: number): { Player }
	local out = {}
	for player, tg in targets do
		if tg.Uid == g.Uid and clock >= tg.Ready and player.Parent then
			local p = rootPos(player)
			if p and (GhostService.Position(g, t) - p).Magnitude <= Config.Combat.MaxRange then
				table.insert(out, player)
			end
		end
	end
	return out
end

-- GHOST RETALIATION: a ghost only fights back against crews attacking it. Every Interval it
-- telegraphs a hit on one hunter of one attacking crew (Fx "GhostWindup"); when the windup ends
-- the hit only lands if that crew is STILL attacking this ghost (retreat or switching target
-- dodges it). Other players and unrelated hunters are never hit.
local function retaliationTick()
	local t = now()
	local clock = os.clock()
	local RC = Config.Retaliation
	for _, g in ghosts do
		if not g.Alive then
			continue
		end
		local pend = g.Pending
		if pend and clock >= pend.Lands then
			g.Pending = nil
			local tg = targets[pend.Player]
			local list = attackers(g, t, clock)
			local still = tg and tg.Uid == g.Uid and table.find(list, pend.Player) ~= nil
			-- everyone fighting this ghost sees the bolt land (or fizzle); damage only if the SAME
			-- hunter is still eligible (never redirected to someone else)
			for _, p in pend.Seen do -- everyone who saw the windup sees the bolt land / fizzle
				if not table.find(list, p) then
					table.insert(list, p)
				end
			end
			if still and table.find(CrewService.Targets(pend.Player), pend.Uid) then
				local maxHP = CrewService.MaxHP(pend.Player, pend.Uid)
				local hit
				if g.HitFrac then
					hit = maxHP * g.HitFrac
				else
					local kind = g.Def.Kind
					hit = Rules.RetaliationHit(g.Max, RC.HitPerSpirit[kind] or RC.HitPerSpirit.Normal, maxHP, RC.HitCap[kind] or RC.HitCap.Normal)
				end
				local ko = CrewService.Hit(pend.Player, pend.Uid, hit)
				for _, p in list do
					if p.Parent then
						Fx.To(p, "GhostHit", { Ghost = g.Uid, Hunter = pend.Uid, Owner = pend.Player.UserId, Knocked = ko })
					end
				end
			else
				for _, p in list do
					if p.Parent then
						Fx.To(p, "GhostHit", { Ghost = g.Uid, Hunter = pend.Uid, Owner = pend.Player.UserId, Dodged = true })
					end
				end
			end
		end
		if g.Pending == nil and clock >= g.NextAttack then
			local list = attackers(g, t, clock)
			if #list == 0 then
				g.NextAttack = clock + 0.5 -- passive until someone attacks it
				continue
			end
			-- every eligible hunter of every attacking player; rotate so hits spread out
			local keys: { string } = {}
			local who: { [string]: { P: Player, U: string } } = {}
			for _, p in list do
				for _, uid in CrewService.Targets(p) do
					local key = p.UserId .. ":" .. uid
					table.insert(keys, key)
					who[key] = { P = p, U = uid }
				end
			end
			local key = Rules.NextTarget(keys, g.LastKey)
			if not key then
				g.NextAttack = clock + 0.5
				continue
			end
			local pick = who[key]
			g.LastKey = key
			local interval = if g.Tower then Config.Tower.Interval else RC.Interval
			g.NextAttack = clock + interval -- one attack per interval, whoever the target is
			g.Pending = { Player = pick.P, Uid = pick.U, Lands = clock + RC.Windup, Seen = table.clone(list) }
			for _, p in list do
				Fx.To(p, "GhostWindup", { Ghost = g.Uid, Hunter = pick.U, Owner = pick.P.UserId, Time = RC.Windup })
			end
		end
	end
end

local function moveTick()
	local t = now()
	for _, g in ghosts do
		if g.Alive and t >= g.NextMove then
			setSegment(g, spacedPoint(g.Center, g.Radius, g.Def.Hover, g.Area, g, Config.Combat.HitboxDiameter * g.Def.Scale * 1.4))
		end
	end
end

function GhostService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Ghosts"
	folder.Parent = workspace
	Net.Event("SelectTarget").OnServerEvent:Connect(onSelect)

	-- AUTO ATTACK toggle: FREE for everyone. It only automates picking targets: damage,
	-- rewards and pickups are exactly the same as tapping ghosts yourself.
	Remotes.Register("AutoAttack", "Default", function(player, on)
		if type(on) ~= "boolean" then
			return Remotes.Fail("Bad value")
		end
		if on then
			autoOn[player] = true
		else
			autoOn[player] = nil
		end
		player:SetAttribute("AutoAttack", on)
		if not on then
			-- back to manual: a ghost Auto Attack picked is dropped, one you chose is kept
			local tg = targets[player]
			if tg and tg.Auto then
				setTarget(player, nil)
			end
		end
		return { ok = true, On = on }
	end)
end

function GhostService.Start()
	for i, area in Config.Layout.GhostAreas do
		local def = Config.Ghosts[area.Ghost]
		for _ = 1, area.Count do
			GhostService.Spawn(def, area.Center, area.Radius, { Area = i })
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		autoOn[player] = nil
		for _, g in ghosts do
			g.Damage[player] = nil
		end
	end)
	task.spawn(function()
		local tick = Config.Combat.TickSeconds
		local last = os.clock()
		local nextAuto = 0
		while true do
			task.wait(tick)
			local c = os.clock()
			-- cap dt so a server hitch can't produce a burst of damage
			local dt = math.min(c - last, tick * 2)
			last = c
			local ok, err = pcall(function()
				damageTick(dt)
				retaliationTick()
				moveTick()
				if c >= nextAuto then
					nextAuto = c + Config.AutoAttack.ScanSeconds
					autoTick()
				end
			end)
			if not ok then
				warn("[Ghosts] tick error: " .. tostring(err))
			end
		end
	end)
end

return GhostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">GlobalEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Developer-controlled GLOBAL events (currently: 2X ECTOPLASM). Never automatic: the state is
-- OFF unless a developer turns it on from the DEV panel, and it stays whatever was last set.
--   * state is stored in a DataStore (Config.GlobalEvents) so NEW servers read it at start
--   * a change is broadcast with MessagingService so RUNNING servers update within seconds
--   * every server also re-reads the DataStore every RefreshSeconds (a missed message heals)
--   * clients see workspace attribute "Ecto2x" (indicator) and get an "Ecto2xEvent" message
--   * an event can have an end time (Ends, unix seconds; 0 = until turned off). Every server
--     switches itself OFF when it passes, so a timed event needs no further action
-- Only DevService (server-checked developer UserIds) can change it. In Studio changes stay in
-- the test server, so a Studio test can never switch the event on for live players.
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Fx = require(script.Parent.Fx)

local GlobalEventService = {}

type State = { Ecto2x: boolean, T: number, Ends: number }

local G = Config.GlobalEvents
local IS_STUDIO = RunService:IsStudio()
local store: DataStore? = nil
local current: State = { Ecto2x = false, T = 0, Ends = 0 }

local function sanitize(v: any): State
	if type(v) == "table" then
		return {
			Ecto2x = v.Ecto2x == true,
			T = if type(v.T) == "number" then v.T else 0,
			Ends = if type(v.Ends) == "number" then v.Ends else 0,
		}
	end
	return { Ecto2x = false, T = 0, Ends = 0 }
end

local function active(st: State): boolean
	return st.Ecto2x and (st.Ends <= 0 or os.time() < st.Ends)
end

local shownOn = false -- what this server currently applies (saved state + end time)

-- Applies a state in this server (idempotent; older states are ignored).
local function apply(new: State, announce: boolean)
	if new.T < current.T then
		return
	end
	current = new
	local on = active(new)
	local was = shownOn
	shownOn = on
	PlayerInfo.SetGlobalEctoMultiplier(if on then G.Ecto2xMultiplier else 1)
	workspace:SetAttribute("Ecto2x", on)
	workspace:SetAttribute("Ecto2xEnds", if on then new.Ends else 0)
	if was ~= on then
		for _, p in Players:GetPlayers() do
			DataService.Changed(p) -- refresh the multiplier shown in their HUD
		end
		if announce then
			Fx.All("Ecto2xEvent", { On = on })
		end
	end
end

local function load(): State?
	local s = store
	if not s then
		return nil
	end
	local ok, v = pcall(function()
		return s:GetAsync(G.Key)
	end)
	return if ok then sanitize(v) else nil
end

function GlobalEventService.Ecto2x(): boolean
	return shownOn
end

-- Developer action (DevService checks the player first). `seconds` > 0 makes a timed event
-- that ends by itself on every server. Returns an error text or nil.
function GlobalEventService.SetEcto2x(on: boolean, seconds: number?): string?
	local now = os.time()
	local ends = if on and seconds and seconds > 0 then now + math.floor(seconds) else 0
	local new: State = { Ecto2x = on, T = now, Ends = ends }
	if IS_STUDIO or not store then
		apply(new, true)
		return nil
	end
	local s = store :: DataStore
	local ok, err = pcall(function()
		-- the stamp always grows past the saved one (and this server's), so servers whose clocks
		-- differ by a few seconds never ignore a quick ON -> OFF as "older"
		s:UpdateAsync(G.Key, function(old: any)
			new.T = math.max(new.T, sanitize(old).T + 1, current.T + 1)
			return new
		end)
	end)
	if not ok then
		return "Couldn't save the event state: " .. tostring(err)
	end
	apply(new, true)
	pcall(function()
		MessagingService:PublishAsync(G.Topic, new)
	end)
	return nil
end

function GlobalEventService.Init()
	if not IS_STUDIO then
		local ok, ds = pcall(function()
			return DataStoreService:GetDataStore(G.DataStoreName)
		end)
		store = if ok then ds else nil
	end
	workspace:SetAttribute("Ecto2x", false)
end

function GlobalEventService.Start()
	-- new server: read the saved state (missing = OFF; nothing ever turns it on by itself)
	task.spawn(function()
		local s = load()
		if s then
			apply(s, false)
		end
	end)
	-- timed events: switch OFF locally once the end time passes (the saved state stays as is;
	-- every server and every new server reaches the same answer from Ends)
	task.spawn(function()
		while true do
			task.wait(5)
			if shownOn and not active(current) then
				apply(current, true)
			end
		end
	end)
	if not IS_STUDIO then
		-- SubscribeAsync yields: never hold up the Start of the services after this one
		task.spawn(pcall, function()
			MessagingService:SubscribeAsync(G.Topic, function(msg)
				apply(sanitize(msg.Data), true)
			end)
		end)
		task.spawn(function()
			while true do
				task.wait(G.RefreshSeconds)
				local s = load()
				if s then
					apply(s, true)
				end
			end
		end)
	end
end

return GlobalEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">HunterService</string>
            <string name="Source"><![CDATA[--!strict
-- Hunter inventory, equipping and crate opening (server-authoritative rolls).
-- Replicates each player's crew to everyone through player attributes:
--   Crew = "HunterId|tier|uid,..." (equipped hunters that can fight, in order), CrewPower = number.
-- v1.6: hunter tiers (Normal / Shiny / Mega), knockouts (d.Knocked, real-time timers), merging,
-- and a per-player "busy" registry so one hunter can't be merged, traded or released at once.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local HunterService = {}
-- player -> token of their running Auto Open loop (a new token stops the old loop)
local autoOpen: { [Player]: {} } = {}
-- player -> os.clock() before which their Auto Open may not open again (OFF/ON spam can't speed it up)
local autoNext: { [Player]: number } = {}
HunterService.GrantExclusive = nil :: any

local rng = Random.new()
local STATION_RANGE = 30

local function powerOf(id: string, tier: number?): number
	local h = Config.Hunters[id]
	local t = Config.Tiers[tier or 0] or Config.Tiers[0]
	return if h then Rules.HunterPower(h.Power, t.Mult) else 0
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	local r = h and Config.Rarities[h.Rarity]
	return if r then r.Order else 1
end
HunterService.PowerOf = powerOf
HunterService.RarityOrder = rarityOrder

local function countOwned(d: DataService.Data): number
	local n = 0
	for _ in d.Hunters do
		n += 1
	end
	return n
end

-- player -> uid -> reason ("In a trade", ...) while another system holds that hunter
local busy: { [Player]: { [string]: string } } = {}

function HunterService.SetBusy(player: Player, uid: string, reason: string?)
	local b = busy[player]
	if not b then
		if reason == nil or not player.Parent then
			return -- nothing to clear / player already left (never re-create their entry)
		end
		b = {}
		busy[player] = b
	end
	(b :: { [string]: string? })[uid] = reason
end

-- player -> reason while a trade of theirs is committing: no crate opens, releases, merges,
-- locks or crew changes until it finishes (TradeService sets and clears it)
local frozen: { [Player]: string } = {}
-- a skip token spent while the reveal was already over can be handed back once (os.clock of the spend)
local skipSpent: { [Player]: number } = {}

function HunterService.SetFrozen(player: Player, reason: string?)
	if reason and not player.Parent then
		return
	end
	(frozen :: { [Player]: string? })[player] = reason
end

function HunterService.FrozenReason(player: Player): string?
	return frozen[player]
end

function HunterService.BusyReason(player: Player, uid: string): string?
	local b = busy[player]
	return if b then b[uid] else nil
end

function HunterService.IsKnocked(d: DataService.Data, uid: string): boolean
	local t = d.Knocked[uid]
	return t ~= nil and t > os.time()
end

-- Equipped hunters that can fight right now (not knocked out), in equipped order.
function HunterService.ActiveUids(player: Player): { string }
	local d = DataService.Get(player)
	local out = {}
	if d then
		for _, uid in d.Equipped do
			if d.Hunters[uid] and not HunterService.IsKnocked(d, uid) then
				table.insert(out, uid)
			end
		end
	end
	return out
end

function HunterService.HunterPower(player: Player, uid: string): number
	local d = DataService.Get(player)
	local h = d and d.Hunters[uid]
	return if h then powerOf(h.Id, h.Tier) else 0
end

-- Damage per second of the player's crew: hunters that can fight (+ pet Power bonus).
function HunterService.CrewPower(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	local base = Rules.CrewPower(HunterService.ActiveUids(player), d.Hunters, powerOf)
	return base * (1 + PlayerInfo.PetBonus(player, "Power"))
end

-- Pushes the crew to attributes (for everyone's visuals) and re-syncs the owner.
function HunterService.Refresh(player: Player)
	local d = DataService.Get(player)
	if not d then
		return
	end
	local ids = {}
	for _, uid in HunterService.ActiveUids(player) do
		local h = d.Hunters[uid]
		table.insert(ids, string.format("%s|%d|%s", h.Id, h.Tier or 0, uid))
	end
	player:SetAttribute("Crew", table.concat(ids, ","))
	player:SetAttribute("CrewPower", HunterService.CrewPower(player))
	DataService.Changed(player)
end

function HunterService.Add(player: Player, hunterId: string): (string?, boolean)
	local d = DataService.Get(player)
	if not d or not Config.Hunters[hunterId] then
		return nil, false
	end
	local uid = DataService.NewUid(d)
	d.Hunters[uid] = { Id = hunterId, Locked = false, T = os.time() }
	local isNew = not d.Discovered[hunterId]
	d.Discovered[hunterId] = true
	return uid, isNew
end

-- A profile with nothing equipped (new player) gets its best hunters equipped.
-- hunters that can fight (EQUIP BEST skips knocked-out ones)
local function fitHunters(d: DataService.Data): { [string]: DataService.HunterRecord }
	local out = {}
	for uid, h in d.Hunters do
		if not HunterService.IsKnocked(d, uid) then
			out[uid] = h
		end
	end
	return out
end

local function ensureEquipped(player: Player, d: DataService.Data)
	if #d.Equipped == 0 then
		d.Equipped = Rules.EquipBest(fitHunters(d), powerOf, rarityOrder, PlayerInfo.Slots(player))
		if #d.Equipped == 0 then
			d.Equipped = Rules.EquipBest(d.Hunters, powerOf, rarityOrder, PlayerInfo.Slots(player))
		end
	end
	-- lost the extra-slots pass: keep only as many equipped as there are slots. Never while the
	-- pass state is unknown (still being checked / Roblox unreachable): that would save a trimmed crew
	if PlayerInfo.PassUnknown(player, "ExtraSlots") then
		return
	end
	while #d.Equipped > PlayerInfo.Slots(player) do
		table.remove(d.Equipped)
	end
end

function HunterService.EnsureEquipped(player: Player)
	local d = DataService.Get(player)
	if d then
		ensureEquipped(player, d)
	end
end

-- Ectoplasm price of the crate a hunter comes from (release refund / merge cost base).
local function cratePrice(id: string): number
	local def = Config.Hunters[id]
	local zone = def and Config.ZoneById[def.Zone]
	local crate = zone and Config.Crates[zone.Crate]
	return if crate then crate.Price else 0
end
HunterService.CratePrice = cratePrice

-- Ectoplasm back for releasing a hunter: a share of its crate price, scaled by tier (Shiny/Mega
-- took several hunters + a merge fee, so this stays far below what was paid). Traded-in and
-- dev-granted hunters (NoRefund) give nothing, so they can't be farmed for Ectoplasm.
local function releaseRefund(h: DataService.HunterRecord): number
	if (h :: any).NoRefund then
		return 0
	end
	local t = Config.Tiers[h.Tier or 0] or Config.Tiers[0]
	return math.floor(cratePrice(h.Id) * Config.Inventory.ReleaseRefund * t.Mult)
end
HunterService.ReleaseRefund = releaseRefund

local function crateRoll(player: Player, crate: Config.CrateDef, extraLuck: number): string
	return Rules.Roll(crate.Pool :: any, rarityOrder, PlayerInfo.LuckMultiplier(player) * extraLuck, Config.LuckAffectsFromOrder, rng:NextNumber())
end

-- Opens one crate. `free` = paid by a free-crate token (daily day 7) instead of Ectoplasm.
local function openCrate(player: Player, crateId: any): any
	if type(crateId) ~= "string" then
		return Remotes.Fail("Bad crate")
	end
	local crate = Config.Crates[crateId]
	local d = DataService.Get(player)
	if not crate or not d then
		return Remotes.Fail("Bad crate")
	end
	local frozenWhy = frozen[player]
	if frozenWhy then
		return Remotes.Fail(frozenWhy)
	end
	if not d.Zones[crate.Zone] then
		return Remotes.Fail("Unlock this zone first!")
	end
	local station = Config.Layout.CrateStations[crateId]
	if not station or not Remotes.Near(player, station, STATION_RANGE) then
		return Remotes.Fail("Walk to the crate first!")
	end
	if countOwned(d) >= PlayerInfo.MaxHunters(player) then
		return Remotes.Fail("Hunter storage full! Release some hunters.")
	end
	local usedFree = false
	if (d.FreeCrates[crateId] or 0) > 0 then
		d.FreeCrates[crateId] -= 1
		if d.FreeCrates[crateId] <= 0 then
			d.FreeCrates[crateId] = nil
		end
		usedFree = true
	elseif not DataService.Spend(player, crate.Price) then
		return Remotes.Fail("Not enough Ectoplasm!")
	end
	-- a bought Lucky Open for this crate is used up by this (paid or free) open
	local lucky = (d.LuckyOpens[crateId] or 0) > 0
	if lucky then
		d.LuckyOpens[crateId] -= 1
		if d.LuckyOpens[crateId] <= 0 then
			d.LuckyOpens[crateId] = nil
		end
	end
	local hunterId = crateRoll(player, crate, if lucky then Config.LuckyOpens.Multiplier else 1)
	local uid, isNew = HunterService.Add(player, hunterId)
	d.Stats.Crates += 1
	local def = Config.Hunters[hunterId]
	local rarity = Config.Rarities[def.Rarity]
	if rarity.Announce then
		Fx.AllExcept(player, "Announce", {
			Text = string.format("%s hatched a %s %s!", player.DisplayName, rarity.Name, string.upper(def.Name)),
			Color = def.Rarity,
		})
	end
	DataService.Changed(player)
	return { ok = true, Uid = uid, Hunter = hunterId, IsNew = isNew, Free = usedFree, Crate = crateId, Lucky = lucky }
end

local function validUid(d: DataService.Data, uid: any): boolean
	return type(uid) == "string" and #uid < 20 and d.Hunters[uid] ~= nil
end

function HunterService.Init()
	DataService.AddDecorator(function(player, s)
		s.CrewPower = HunterService.CrewPower(player)
	end)

	-- (crateId, count?): count 3 only with the Triple Open pass; stops early when money or storage
	-- runs out. Returns the first result plus `More` = the extra results.
	Remotes.Register("OpenCrate", "OpenCrate", function(player, crateId, count)
		local n = if count == Config.TripleOpen.Count and PlayerInfo.HasPass(player, Config.TripleOpen.Pass) then count else 1
		local first = openCrate(player, crateId)
		if not first.ok or n == 1 then
			return first
		end
		local more = {}
		for _ = 2, n do
			local r = openCrate(player, crateId)
			if not r.ok then
				first.Stopped = r.err -- why the multi-open stopped early (client shows it)
				break
			end
			table.insert(more, { Uid = r.Uid, Hunter = r.Hunter, IsNew = r.IsNew })
		end
		first.More = more
		return first
	end)

	-- LUCKY OPENS: pay Ectoplasm (crate price x PriceMultiplier) for the next few opens of this
	-- crate at higher luck. Bound to the crate, so cheap crates can't buy luck for expensive ones.
	Remotes.Register("BuyLuckyOpens", "Default", function(player, crateId)
		if type(crateId) ~= "string" then
			return Remotes.Fail("Bad crate")
		end
		local crate = Config.Crates[crateId]
		local d = DataService.Get(player)
		if not crate or not d or not Config.Layout.CrateStations[crateId] then
			return Remotes.Fail("Bad crate")
		end
		if not d.Zones[crate.Zone] then
			return Remotes.Fail("Unlock this zone first!")
		end
		local L = Config.LuckyOpens
		local have = d.LuckyOpens[crateId] or 0
		if have + L.Opens > L.MaxStack then
			return Remotes.Fail("You already have plenty of lucky opens for this crate!")
		end
		if not DataService.Spend(player, crate.Price * L.PriceMultiplier) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.LuckyOpens[crateId] = have + L.Opens
		DataService.Changed(player)
		return { ok = true, Left = d.LuckyOpens[crateId] }
	end)

	-- CRATE SKIP: the reveal is client-side only (the hunter is already rolled and saved), so a
	-- skip never touches the reward. Permanent Crate Skip owners skip for free; otherwise one
	-- bought Single Crate Skip token is used.
	Remotes.Register("UseSkip", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		if PlayerInfo.HasPermanentSkip(player) then
			return { ok = true, Permanent = true }
		end
		if (d.SkipTokens or 0) > 0 then
			d.SkipTokens -= 1
			skipSpent[player] = os.clock()
			DataService.Changed(player)
			return { ok = true, Left = d.SkipTokens }
		end
		return { ok = false, err = "NeedSkip" }
	end)

	-- the reveal finished while UseSkip was in flight: give that one token back (only the last
	-- spend, only within a few seconds, only once)
	Remotes.Register("RefundSkip", "Default", function(player)
		local d = DataService.Get(player)
		local t = skipSpent[player]
		skipSpent[player] = nil
		if not d or not t or os.clock() - t > 10 then
			return Remotes.Fail("Nothing to refund")
		end
		d.SkipTokens = (d.SkipTokens or 0) + 1
		DataService.Changed(player)
		return { ok = true, Left = d.SkipTokens }
	end)

	-- AUTO OPEN (game pass): one server loop per player re-opens the chosen crate through the
	-- normal openCrate checks (zone, distance, price, storage), so it can't bypass anything or
	-- run twice at once. Stops on OFF, failure, leaving, or when the pass is missing.
	Remotes.Register("AutoOpen", "Default", function(player, crateId)
		if crateId == nil or crateId == false then
			autoOpen[player] = nil
			player:SetAttribute("AutoOpen", nil)
			return { ok = true, On = false }
		end
		if not PlayerInfo.HasAutoOpen(player) then
			return Remotes.Fail("NeedPass")
		end
		if type(crateId) ~= "string" or not Config.Crates[crateId] or not Config.Layout.CrateStations[crateId] then
			return Remotes.Fail("Bad crate")
		end
		local token = {}
		autoOpen[player] = token
		player:SetAttribute("AutoOpen", crateId)
		task.spawn(function()
			local waitLeft = (autoNext[player] or 0) - os.clock()
			if waitLeft > 0 then
				task.wait(waitLeft)
			end
			while autoOpen[player] == token and player.Parent do
				local interval = if PlayerInfo.HasPermanentSkip(player) then Config.AutoOpen.FastInterval else Config.AutoOpen.Interval
				if frozen[player] then
					task.wait(interval) -- a trade is finishing: pause, don't stop
					continue
				end
				autoNext[player] = os.clock() + interval
				local r = openCrate(player, crateId)
				if autoOpen[player] ~= token then
					break
				end
				if not r.ok then
					autoOpen[player] = nil
					player:SetAttribute("AutoOpen", nil)
					Fx.To(player, "AutoOpenStopped", { Reason = r.err })
					break
				end
				Fx.To(player, "AutoOpened", { Crate = crateId, Hunter = r.Hunter, Uid = r.Uid, IsNew = r.IsNew })
				task.wait(interval)
			end
		end)
		return { ok = true, On = true }
	end)

	-- Robux Exclusive Crate (granted by ShopService after a purchase)
	HunterService.GrantExclusive = function(p: Player): (string?, string?, boolean)
		local zone = Config.Zones[PlayerInfo.BestZone(p)]
		local hunterId = zone and Config.Exclusives[zone.Id]
		if not hunterId then
			return nil, nil, false
		end
		local uid, isNew = HunterService.Add(p, hunterId)
		local d = DataService.Get(p)
		if uid and d and d.Hunters[uid] then
			d.Hunters[uid].Locked = true -- paid hunter: protect it from an accidental release
		end
		HunterService.Refresh(p)
		local def = Config.Hunters[hunterId]
		Fx.All("Announce", { Text = string.format("%s got the EXCLUSIVE %s!", p.DisplayName, string.upper(def.Name)), Color = "Exclusive" })
		return uid, hunterId, isNew
	end

	Remotes.Register("Equip", "Inventory", function(player, uid)
		if player:GetAttribute("InTower") then
			return Remotes.Fail("Can't change your crew inside the Boss Tower")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		if table.find(d.Equipped, uid) then
			return { ok = true }
		end
		if #d.Equipped >= PlayerInfo.Slots(player) then
			return Remotes.Fail("All slots full! Unequip one first.")
		end
		table.insert(d.Equipped, uid)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("Unequip", "Inventory", function(player, uid)
		if player:GetAttribute("InTower") then
			return Remotes.Fail("Can't change your crew inside the Boss Tower")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) then
			return Remotes.Fail("Unknown hunter")
		end
		local i = table.find(d.Equipped, uid)
		if not i then
			return { ok = true }
		end
		if #d.Equipped <= 1 then
			return Remotes.Fail("Keep at least one hunter equipped!")
		end
		table.remove(d.Equipped, i)
		HunterService.Refresh(player)
		return { ok = true }
	end)

	Remotes.Register("EquipBest", "Inventory", function(player)
		if player:GetAttribute("InTower") then
			return Remotes.Fail("Can't change your crew inside the Boss Tower")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		local best = Rules.EquipBest(fitHunters(d), powerOf, rarityOrder, PlayerInfo.Slots(player))
		if #best == 0 then
			return Remotes.Fail("All your hunters are recovering!")
		end
		d.Equipped = best
		HunterService.Refresh(player)
		return { ok = true, Power = HunterService.CrewPower(player) }
	end)

	Remotes.Register("Lock", "Inventory", function(player, uid, locked)
		local d = DataService.Get(player)
		if not d or not validUid(d, uid) or type(locked) ~= "boolean" then
			return Remotes.Fail("Unknown hunter")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		local why = HunterService.BusyReason(player, uid)
		if why then
			return Remotes.Fail(why)
		end
		d.Hunters[uid].Locked = locked
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Releases (deletes) unlocked, unequipped hunters for a small refund.
	Remotes.Register("Release", "Inventory", function(player, uids)
		local d = DataService.Get(player)
		if not d or type(uids) ~= "table" or #uids == 0 or #uids > PlayerInfo.MaxHunters(player) then
			return Remotes.Fail("Nothing selected")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		local refund = 0
		local released = 0
		local total = countOwned(d)
		for _, uid in uids do
			if total - released <= 1 then
				break
			end
			if validUid(d, uid) and not table.find(d.Equipped, uid) and not d.Hunters[uid].Locked and not HunterService.BusyReason(player, uid) then
				refund += releaseRefund(d.Hunters[uid])
				d.Hunters[uid] = nil
				d.Knocked[uid] = nil
				released += 1
			end
		end
		if released == 0 then
			return Remotes.Fail("Can't release equipped or locked hunters")
		end
		if refund > 0 then
			DataService.AddEcto(player, refund)
		end
		DataService.Changed(player)
		Fx.Toast(player, string.format("Released %d hunter%s (+%s Ectoplasm)", released, if released == 1 then "" else "s", Format.Commas(refund)))
		return { ok = true, Released = released, Refund = refund }
	end)

	-- MERGE: 5 identical hunters (same hunter, same tier, unlocked, not busy, not knocked out)
	-- -> 1 hunter of the next tier. All checks and the swap happen in one step on the server, so a
	-- repeated request finds the hunters already gone and fails harmlessly.
	Remotes.Register("Merge", "Inventory", function(player, uids)
		if player:GetAttribute("InTower") then
			return Remotes.Fail("Can't change your crew inside the Boss Tower")
		end
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		if frozen[player] then
			return Remotes.Fail(frozen[player])
		end
		-- only a plain list of uid strings (keys exactly 1..n): extra keys could sneak in more hunters
		if type(uids) ~= "table" then
			return Remotes.Fail("Pick exactly " .. Config.Merge.Count .. " hunters")
		end
		local nKeys = 0
		for _ in uids do
			nKeys += 1
		end
		for i = 1, nKeys do
			if type(uids[i]) ~= "string" then
				return Remotes.Fail("Pick different hunters")
			end
		end
		local ok, err, id, tier = Rules.MergeCheck(d.Hunters :: any, uids, Config.Merge.Count, Config.Merge.MaxTier, function(uid)
			local why = HunterService.BusyReason(player, uid)
			if why then
				return why
			end
			return if HunterService.IsKnocked(d, uid) then "Knocked-out hunters can't be merged" else nil
		end)
		if not ok then
			return Remotes.Fail(err or "Can't merge those")
		end
		local hunterId, fromTier = id :: string, tier :: number
		local newTier = fromTier + 1
		local cost = math.floor(cratePrice(hunterId) * (Config.Merge.CostMult[newTier] or 1))
		if cost > 0 and not DataService.Spend(player, cost) then
			return Remotes.Fail("Merging costs " .. Format.Commas(cost) .. " Ectoplasm")
		end
		-- consume, then create; the new hunter takes the first equipped slot of the consumed ones
		local slot: number? = nil
		for _, uid in uids :: { string } do
			local i = table.find(d.Equipped, uid)
			if i then
				slot = if slot then math.min(slot, i) else i
			end
		end
		local keep = {}
		for _, uid in d.Equipped do
			if not table.find(uids :: { string }, uid) then
				table.insert(keep, uid)
			end
		end
		-- a merge made from any traded-in / dev-granted hunter keeps those limits (no refund laundering)
		local noRefund, dev = false, false
		for _, uid in uids :: { string } do
			local h = d.Hunters[uid] :: any
			noRefund = noRefund or h.NoRefund == true
			dev = dev or h.Dev == true
			d.Hunters[uid] = nil
			d.Knocked[uid] = nil
		end
		local newUid = DataService.NewUid(d)
		d.Hunters[newUid] = { Id = hunterId, Locked = false, T = os.time(), Tier = newTier }
		if noRefund then
			(d.Hunters[newUid] :: any).NoRefund = true
		end
		if dev then
			(d.Hunters[newUid] :: any).Dev = true
		end
		d.Variants[hunterId .. ":" .. newTier] = true -- Shiny/Mega variant discovered (Index)
		if slot then
			table.insert(keep, math.min(slot, #keep + 1), newUid)
		end
		d.Equipped = keep
		ensureEquipped(player, d)
		HunterService.Refresh(player)
		DataService.Save(player)
		local tdef = Config.Tiers[newTier]
		local def = Config.Hunters[hunterId]
		if newTier >= 2 then
			Fx.AllExcept(player, "Announce", { Text = string.format("%s merged a %s %s!", player.DisplayName, tdef.Name, string.upper(def.Name)), Color = "Exclusive" })
		end
		return { ok = true, Uid = newUid, Hunter = hunterId, Tier = newTier, Cost = cost }
	end)

	DataService.Loaded:Connect(function(player: Player)
		-- always work on the live profile (never a copy)
		local d = DataService.Get(player)
		if not d then
			return
		end
		if next(d.Hunters) == nil then
			HunterService.Add(player, Config.StarterHunter)
		end
		local t = os.time()
		for uid, untilT in d.Knocked do
			if untilT <= t then
				d.Knocked[uid] = nil -- recovered while offline
			end
		end
		ensureEquipped(player, d)
		HunterService.Refresh(player)
	end)
end

function HunterService.Start()
	Players.PlayerRemoving:Connect(function(player)
		autoOpen[player] = nil -- stops their Auto Open loop
		autoNext[player] = nil
		busy[player] = nil
		frozen[player] = nil
		skipSpent[player] = nil
		PlayerInfo.Forget(player)
	end)
end

return HunterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Fills the two lobby boards every RefreshSeconds:
--   TOP GHOST HUNTERS: each online player's all-time Ectoplasm (current value) in
--     Config.Leaderboard.DataStoreName.
--   TOP POWER: each player's best-ever crew power (HunterService.CrewPower) in
--     Config.Leaderboard.PowerDataStoreName; written with UpdateAsync only when it rises above
--     the stored best, so the entry never goes down.
-- Then the top rows are read back. Without DataStore access (Studio with API off) a board ranks
-- the players in this server instead. Studio never writes, and developer accounts stay off the
-- public boards.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local HunterService = require(script.Parent.HunterService)

local LeaderboardService = {}

type Row = { Name: string, Value: number }

local store: OrderedDataStore? = nil
local powerStore: OrderedDataStore? = nil
local names: { [number]: string } = {}
local written: { [number]: number } = {} -- userId -> value this server last wrote
local bestPower: { [number]: number } = {} -- userId -> best power known to be stored
local MAX_VALUE = 2 ^ 53
local IS_STUDIO = RunService:IsStudio()

local function isDev(userId: number): boolean
	return table.find(Config.DevUserIds, userId) ~= nil
end

local function canWrite(userId: number): boolean
	return not IS_STUDIO and userId > 0 and not isDev(userId)
end

local function nameOf(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local n = if ok and type(name) == "string" then name else "Hunter"
	names[userId] = n
	return n
end

local function valueOf(player: Player): number?
	local d = DataService.Get(player)
	if not d then
		return nil
	end
	return math.clamp(math.floor(d.TotalEcto), 0, MAX_VALUE)
end

local function powerOf(player: Player): number?
	if not DataService.Get(player) then
		return nil
	end
	local p = HunterService.CrewPower(player)
	if p ~= p then
		return 0
	end
	return math.clamp(math.floor(p), 0, MAX_VALUE)
end

local function localRows(get: (Player) -> number?): { Row }
	local rows: { Row } = {}
	for _, pl in Players:GetPlayers() do
		local v = get(pl)
		if v then
			table.insert(rows, { Name = pl.Name, Value = v })
		end
	end
	table.sort(rows, function(a: Row, b: Row)
		return a.Value > b.Value
	end)
	return rows
end

local readTop: (OrderedDataStore) -> { Row }?

local function globalRows(): { Row }?
	local s = store
	if not s then
		return nil
	end
	for _, pl in Players:GetPlayers() do
		local id = pl.UserId
		local v = valueOf(pl)
		-- the current value (not the best): after a progress reset the entry goes down too
		if v and canWrite(id) and v ~= written[id] and (v > 0 or written[id] ~= nil) then
			names[id] = pl.Name
			if pcall(function()
				s:SetAsync(tostring(id), v)
			end) then
				written[id] = v
			end
		end
	end
	return readTop(s)
end

-- Best-ever power: UpdateAsync keeps the larger of the stored and current values, and is only
-- called when the current power beats the best this server knows about.
local function globalPowerRows(): { Row }?
	local s = powerStore
	if not s then
		return nil
	end
	for _, pl in Players:GetPlayers() do
		local id = pl.UserId
		local v = powerOf(pl)
		if v and v > 0 and canWrite(id) and v > (bestPower[id] or 0) then
			names[id] = pl.Name
			-- returning nil cancels the write, so the stored best never goes down
			local keep: any = function(old: any): number?
				local prev = tonumber(old) or 0
				return if v > prev then v else nil
			end
			local ok, stored = pcall(function(): any
				return s:UpdateAsync(tostring(id), keep)
			end)
			if ok then
				bestPower[id] = math.max(v, tonumber(stored) or 0)
			end
		end
	end
	return readTop(s)
end

function readTop(s: OrderedDataStore): { Row }?
	local ok, pages = pcall(function()
		return s:GetSortedAsync(false, Config.Leaderboard.Rows + #Config.DevUserIds)
	end)
	if not ok or not pages then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local id = tonumber(entry.key)
		if id and not isDev(id) and #rows < Config.Leaderboard.Rows then
			table.insert(rows, { Name = nameOf(id), Value = tonumber(entry.value) or 0 })
		end
	end
	return rows
end

local function render(modelName: string, rows: { Row })
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Leaderboard")
	local model = folder and folder:FindFirstChild(modelName)
	local board = model and model:FindFirstChild("Board")
	local gui = board and board:FindFirstChild("BoardGui")
	if not gui then
		return
	end
	for i = 1, Config.Leaderboard.Rows do
		local row = gui:FindFirstChild("Row" .. i)
		if row then
			local r = rows[i]
			local nameLabel = row:FindFirstChild("PlayerName") :: TextLabel?
			local valueLabel = row:FindFirstChild("Value") :: TextLabel?
			if nameLabel then
				-- VIP pass owners who are in this server show in gold with a crown
				local online = r and Players:FindFirstChild(r.Name)
				local vip = online ~= nil and online:IsA("Player") and online:GetAttribute("VIP") == true
				nameLabel.Text = if r then (if vip then "👑 " else "") .. r.Name else "..."
				nameLabel.TextColor3 = if vip then Color3.fromRGB(255, 215, 80) else Color3.fromRGB(255, 255, 255)
			end
			if valueLabel then
				valueLabel.Text = if r then Format.Short(r.Value) else ""
			end
		end
	end
end

-- One board per pcall, so a DataStore error on one never blanks the other.
local function refreshBoard(modelName: string, global: () -> { Row }?, get: (Player) -> number?)
	local ok, err = pcall(function()
		render(modelName, global() or localRows(get))
	end)
	if not ok then
		warn("[Leaderboard] " .. modelName .. ": " .. tostring(err))
		-- e.g. no API access in Studio: show this server's players
		pcall(function()
			render(modelName, localRows(get))
		end)
	end
end

function LeaderboardService.Init()
	local ok, ds = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Leaderboard.DataStoreName)
	end)
	store = if ok then ds else nil
	local okP, dsP = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Leaderboard.PowerDataStoreName)
	end)
	powerStore = if okP then dsP else nil
	-- a progress reset removes the entry right away (the next refresh writes the new value)
	DataService.ProgressReset:Connect(function(player: Player)
		local s = store
		local id = player.UserId
		if s and canWrite(id) then
			written[id] = nil
			pcall(function()
				s:RemoveAsync(tostring(id))
			end)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		written[player.UserId] = nil
		bestPower[player.UserId] = nil
	end)
end

function LeaderboardService.Start()
	task.spawn(function()
		task.wait(8) -- let the first profiles load
		while true do
			refreshBoard("TopHunters", globalRows, valueOf)
			refreshBoard("TopPower", globalPowerRows, powerOf)
			task.wait(Config.Leaderboard.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!strict
-- Ghost pets (v1.6): hatched from eggs bought with Spirit Shards (Boss Tower only; v1.8 eggs
-- replaced direct purchases), up to Config.PetRules.MaxEquipped equipped. Equipped pets boost
-- ALL of the owner's hunters (Normal, Shiny, Mega) everywhere (world and tower): Power, Ecto, HP or Recovery. Bonuses are recomputed from the saved
-- equipped list every time (PlayerInfo.PetBonuses), so nothing can stack twice.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Format = require(GH.Logic.Format)
local Eggs = require(GH.Logic.Eggs)
local DataService = require(script.Parent.DataService)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)

local PetService = {}

local lastBuy: { [Player]: number } = {}
local lastRename: { [Player]: number } = {}
local RENAME_COOLDOWN = 3 -- seconds between nickname requests (each one calls the text filter)
local rng = Random.new()

local NICK_MAX = 20 -- characters

-- Roblox text filter for a nickname everyone can see. Returns nil when filtering fails.
local function filterNick(player: Player, text: string): string?
	local ok, res = pcall(function()
		local r = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return r:GetNonChatStringForBroadcastAsync()
	end)
	return if ok and type(res) == "string" then res else nil
end

local function count(t: { [string]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Adds a pet to a profile (egg hatch or event reward). Returns the new pet uid.
function PetService.Add(d: DataService.Data, petId: string): string?
	if not Config.Pets[petId] then
		return nil
	end
	local uid = "p" .. d.PetNextUid
	d.PetNextUid += 1
	d.Pets[uid] = { Id = petId, T = os.time() }
	if #d.EquippedPets < Config.PetRules.MaxEquipped then
		table.insert(d.EquippedPets, uid)
	end
	return uid
end

-- Pet bonuses changed: refresh crew power (Power / HP bonuses) and the client snapshot.
local function refresh(player: Player)
	HunterService.Refresh(player)
end
PetService.Refresh = refresh

function PetService.Init()
	-- Buy + hatch an egg (the only way to get pets with shards). Exactly-once: the client sends
	-- a request id; a retry with the same id returns the stored result and never charges or
	-- rolls again. Check + roll + spend + add + record happen in ONE non-yielding step and go
	-- into the same profile write, so a crash either loses the whole hatch (nothing was saved)
	-- or keeps all of it. The client's hatch animation is presentation only.
	Remotes.Register("BuyEgg", "Default", function(player, eggId, requestId)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		if type(eggId) ~= "string" or not Eggs.ValidRequestId(requestId) then
			return Remotes.Fail("Unknown egg")
		end
		local egg = Config.Eggs[eggId]
		if not egg then
			return Remotes.Fail("Unknown egg")
		end
		local done = d.PendingHatch[requestId]
		if done then
			if done.Egg ~= eggId then
				return Remotes.Fail("Unknown egg")
			end
			return { ok = true, Egg = done.Egg, Pet = done.Pet, Uid = done.Uid, Shards = d.Shards }
		end
		-- buy at the hatchery (pavilion at Config.Layout.Hatchery in the lobby, see
		-- World/Hatchery), like crates at their station
		-- (checked after the retry lookup, so a retry of a hatch that already went through succeeds)
		if not Remotes.Near(player, Config.Layout.Hatchery, 25) then
			return Remotes.Fail("Walk to the Pet Hatchery first!")
		end
		-- a double tap (two different ids) can't buy twice by accident
		local now = os.clock()
		if lastBuy[player] and now - lastBuy[player] < 1 then
			return Remotes.Fail("One moment...")
		end
		if not Eggs.Unlocked(egg, d.TowerCheckpoint) then
			return Remotes.Fail(string.format("Reach Boss Tower checkpoint %d to unlock the %s", egg.Unlock, egg.Name))
		end
		if count(d.Pets) >= Config.PetRules.MaxOwned then
			return Remotes.Fail("Your pet room is full!")
		end
		if d.Shards < egg.Price then
			return Remotes.Fail(string.format("Needs %s Spirit Shards (earn them in the Boss Tower)", Format.Commas(egg.Price)))
		end
		local petId = Eggs.Roll(egg, rng:NextNumber())
		if not Config.Pets[petId] then
			return Remotes.Fail("Something went wrong")
		end
		lastBuy[player] = now
		d.Shards -= egg.Price
		local uid = PetService.Add(d, petId) :: string
		d.PendingHatch[requestId] = { Egg = eggId, Pet = petId, Uid = uid, T = os.time() }
		for _, id in Eggs.Prune(d.PendingHatch, Eggs.KEEP_RECORDS) do
			d.PendingHatch[id] = nil
		end
		refresh(player)
		DataService.Save(player)
		return { ok = true, Egg = eggId, Pet = petId, Uid = uid, Shards = d.Shards }
	end)

	Remotes.Register("EquipPet", "Inventory", function(player, uid, on)
		if player:GetAttribute("InTower") then
			return Remotes.Fail("Can't change pets inside the Boss Tower")
		end
		local d = DataService.Get(player)
		if not d or type(uid) ~= "string" or type(on) ~= "boolean" then
			return Remotes.Fail("Unknown pet")
		end
		local pet = d.Pets[uid]
		if not pet or not Config.Pets[pet.Id] then
			return Remotes.Fail("Unknown pet")
		end
		local i = table.find(d.EquippedPets, uid)
		if on and not i then
			if #d.EquippedPets >= Config.PetRules.MaxEquipped then
				return Remotes.Fail(string.format("Only %d pets can follow you at once", Config.PetRules.MaxEquipped))
			end
			table.insert(d.EquippedPets, uid)
		elseif not on and i then
			table.remove(d.EquippedPets, i)
		end
		refresh(player)
		return { ok = true }
	end)

	-- Nickname a pet. Only the FILTERED text is ever stored or shown; empty text clears it.
	Remotes.Register("RenamePet", "Default", function(player, uid, text)
		local d = DataService.Get(player)
		if not d or type(uid) ~= "string" or not d.Pets[uid] then
			return Remotes.Fail("Unknown pet")
		end
		if type(text) ~= "string" or #text > 200 then
			return Remotes.Fail("Bad name")
		end
		local now = os.clock()
		if lastRename[player] and now - lastRename[player] < RENAME_COOLDOWN then
			return Remotes.Fail("Wait a moment before renaming again")
		end
		lastRename[player] = now
		-- invisible characters (zero-width, direction marks) can't make a "blank" name
		for _, cp in { 0x200B, 0x200C, 0x200D, 0x200E, 0x200F, 0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2060, 0x2061, 0x2062, 0x2063, 0x2064, 0xFEFF } do
			text = string.gsub(text, utf8.char(cp), "")
		end
		text = string.match(string.gsub(text, "%c", " "), "^%s*(.-)%s*$") or ""
		local n = utf8.len(text)
		if not n or n > NICK_MAX or #text > 40 then
			return Remotes.Fail(string.format("Names can be up to %d letters", NICK_MAX))
		end
		local nick: string? = nil
		if n > 0 then
			nick = filterNick(player, text) -- yields
			if not nick then
				-- filter unavailable: keep the current (already filtered) name, store nothing new
				return Remotes.Fail("Couldn't check that name right now, try again later")
			end
		end
		local pet = d.Pets[uid] -- re-read after the yield
		if not pet then
			return Remotes.Fail("Unknown pet")
		end
		pet.Nick = if nick and #nick <= 40 and string.find(nick, "%S") then nick else nil
		refresh(player)
		DataService.Save(player)
		return { ok = true, Nick = pet.Nick }
	end)

	DataService.AddDecorator(function(player, s)
		local d = DataService.Get(player)
		if d then
			s.Pets = d.Pets
			s.EquippedPets = d.EquippedPets
			s.Shards = d.Shards
		end
	end)
end

function PetService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastBuy[player] = nil
		lastRename[player] = nil
	end)
	-- equipped pets replicate to everyone for the follower visuals: "Pets" = "PetId,PetId" and
	-- "PetNames" = the matching filtered nicknames, one per line ("" = default name). Names are
	-- set first so the follower rebuild on "Pets" already sees them.
	local function publish(player: Player)
		local d = DataService.Get(player)
		if not d then
			return
		end
		local ids, names = {}, {}
		for _, uid in d.EquippedPets do
			local pet = d.Pets[uid]
			if pet and Config.Pets[pet.Id] then
				table.insert(ids, pet.Id)
				table.insert(names, (string.gsub(pet.Nick or "", "%c", " ")))
			end
		end
		player:SetAttribute("PetNames", table.concat(names, "\n"))
		player:SetAttribute("Pets", table.concat(ids, ","))
	end
	DataService.AddDecorator(function(player, _s)
		publish(player)
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PlayerInfo</string>
            <string name="Source"><![CDATA[--!strict
-- Derived per-player numbers (slots, multipliers, radius) from data + game passes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)

local PlayerInfo = {}

-- Game passes owned this session (filled by ShopService).
local passes: { [Player]: { [string]: boolean } } = {}
-- Pass keys whose ownership Roblox couldn't confirm (check kept failing). They count as NOT owned
-- for gameplay, but the shop won't re-sell them and equipped slots are never trimmed for them.
local unknownPasses: { [Player]: { [string]: boolean } } = {}
-- Players whose first pass check has finished this session (until then every pass is unknown).
local passesChecked: { [Player]: boolean } = {}

function PlayerInfo.SetPass(player: Player, key: string, owned: boolean)
	passes[player] = passes[player] or {}
	passes[player][key] = owned
	local u = unknownPasses[player]
	if u then
		u[key] = nil -- a definite answer replaces "unknown"
	end
end

function PlayerInfo.SetPassUnknown(player: Player, key: string)
	if not player.Parent then
		return
	end
	unknownPasses[player] = unknownPasses[player] or {}
	unknownPasses[player][key] = true
end

function PlayerInfo.SetPassesChecked(player: Player)
	if player.Parent then
		passesChecked[player] = true
	end
end

-- True while this pass's ownership isn't known yet (first check still running, or it failed).
function PlayerInfo.PassUnknown(player: Player, key: string): boolean
	if not passesChecked[player] then
		return true
	end
	local u = unknownPasses[player]
	return u ~= nil and u[key] == true
end

function PlayerInfo.HasUnknownPasses(player: Player): boolean
	local u = unknownPasses[player]
	return u ~= nil and next(u) ~= nil
end

function PlayerInfo.HasPass(player: Player, key: string): boolean
	local p = passes[player]
	return p ~= nil and p[key] == true
end

-- Global Ectoplasm multiplier (2X ECTOPLASM event, set by GlobalEventService; 1 = off).
local globalEcto = 1
function PlayerInfo.SetGlobalEctoMultiplier(m: number)
	globalEcto = m
end

-- Server-wide luck (Robux product): os.time() expiry, shared by everyone in this server.
local serverLuckUntil = 0

function PlayerInfo.ServerLuckUntil(): number
	return serverLuckUntil
end

-- uncapped = a paid (Robux) grant: never throw bought time away, even past the usual cap
function PlayerInfo.AddServerLuck(seconds: number, uncapped: boolean?)
	local now = os.time()
	local total = math.max(serverLuckUntil, now) + seconds
	serverLuckUntil = if uncapped then total else math.min(total, now + Config.ServerLuck.MaxStackSeconds)
end

-- AUTO OPEN pass, or the legacy (hidden, no longer sold) Auto Attack pass: Auto Attack itself is
-- free for everyone now, so its old buyers get Auto Open instead
function PlayerInfo.HasAutoOpen(player: Player): boolean
	return PlayerInfo.HasPass(player, Config.AutoOpen.Pass)
		or (Config.LegacyAutoAttackGrantsAutoOpen and PlayerInfo.HasPass(player, "AutoAttack"))
end

function PlayerInfo.HasPermanentSkip(player: Player): boolean
	return PlayerInfo.HasPass(player, Config.CrateSkip.Pass)
end

function PlayerInfo.Forget(player: Player)
	passes[player] = nil
	unknownPasses[player] = nil
	passesChecked[player] = nil
end

local function passDef(key: string): Config.PassDef?
	for _, p in Config.GamePasses do
		if p.Key == key then
			return p
		end
	end
	return nil
end

function PlayerInfo.Slots(player: Player): number
	local extra = 0
	local def = passDef("ExtraSlots")
	if def and PlayerInfo.HasPass(player, "ExtraSlots") then
		extra = def.Slots or 0
	end
	return Config.Inventory.BaseSlots + extra
end

function PlayerInfo.BoostActive(d: DataService.Data, boost: string): boolean
	local t = d.Boosts[boost]
	return t ~= nil and t > os.time()
end

-- uncapped = a paid (Robux) grant: never throw bought time away, even past the usual cap
function PlayerInfo.AddBoost(d: DataService.Data, boost: string, seconds: number, uncapped: boolean?)
	local now = os.time()
	local cur = math.max(d.Boosts[boost] or 0, now)
	d.Boosts[boost] = if uncapped then cur + seconds else math.min(cur + seconds, now + Config.Boosts.MaxStackSeconds)
end

-- Bonuses from the player's EQUIPPED ghost pets: { Power, Ecto, HP, Recovery } fractions.
-- Computed from the saved equipped list every time (never accumulated), so re-equipping,
-- reconnecting or respawning can't stack a bonus twice.
function PlayerInfo.PetBonuses(player: Player): { [string]: number }
	local d = DataService.Get(player)
	if not d then
		return {}
	end
	local list = {}
	local seen = {}
	for _, uid in d.EquippedPets do
		local pet = d.Pets[uid]
		local def = pet and Config.Pets[pet.Id]
		if def and not seen[uid] and #list < Config.PetRules.MaxEquipped then
			seen[uid] = true
			table.insert(list, def.Bonus)
		end
	end
	return Rules.PetBonuses(list, Config.PetRules.Caps)
end

function PlayerInfo.PetBonus(player: Player, kind: string): number
	return PlayerInfo.PetBonuses(player)[kind] or 0
end

function PlayerInfo.EctoMultiplier(player: Player): number
	local d = DataService.Get(player)
	if not d then
		return 1
	end
	local up = Config.Upgrades.EctoBonus
	local bonus = Rules.UpgradeValue(up.Levels, d.Upgrades.EctoBonus or 1)
	local passMul = 1
	local def = passDef("DoubleEcto")
	if def and PlayerInfo.HasPass(player, "DoubleEcto") then
		passMul = def.Multiplier or 1
	end
	local vip = passDef("VIP")
	if vip and PlayerInfo.HasPass(player, "VIP") then
		passMul *= vip.Multiplier or 1
	end
	-- FinalReward = BaseGhostReward * this (upgrades, boost, passes, global event)
	return Rules.EctoMultiplier(bonus, PlayerInfo.BoostActive(d, "Ecto"), Config.Boosts.Ecto.Multiplier, passMul)
		* globalEcto
		* (1 + PlayerInfo.PetBonus(player, "Ecto"))
end

function PlayerInfo.LuckMultiplier(player: Player): number
	local d = DataService.Get(player)
	local m = 1
	if d and PlayerInfo.BoostActive(d, "Luck") then
		m *= Config.Boosts.Luck.Multiplier
	end
	local lucky = passDef("LuckyHunter")
	if lucky and PlayerInfo.HasPass(player, "LuckyHunter") then
		m *= lucky.Multiplier or 1
	end
	if serverLuckUntil > os.time() then
		m *= Config.ServerLuck.Multiplier
	end
	return m
end

function PlayerInfo.MaxHunters(player: Player): number
	local def = passDef("Storage")
	if def and PlayerInfo.HasPass(player, "Storage") then
		return Config.Inventory.MaxHunters + (def.Storage or 0)
	end
	return Config.Inventory.MaxHunters
end

function PlayerInfo.PickupRadius(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.PickupRadius or 1 else 1
	local r = Rules.UpgradeValue(Config.Upgrades.PickupRadius.Levels, lv)
	local magnet = passDef("SuperMagnet")
	if magnet and PlayerInfo.HasPass(player, "SuperMagnet") then
		r *= magnet.Multiplier or 1
	end
	return r
end

function PlayerInfo.WalkSpeed(player: Player): number
	local d = DataService.Get(player)
	local lv = if d then d.Upgrades.MoveSpeed or 1 else 1
	return Rules.UpgradeValue(Config.Upgrades.MoveSpeed.Levels, lv)
end

-- Index (1-based) of the furthest unlocked zone, used to scale flat rewards.
function PlayerInfo.BestZone(player: Player): number
	local d = DataService.Get(player)
	local best = 1
	if d then
		for i, z in Config.Zones do
			if d.Zones[z.Id] then
				best = math.max(best, i)
			end
		end
	end
	return best
end

function PlayerInfo.ZoneMultiplier(player: Player): number
	local m = Config.Daily.ZoneMultiplier
	return m[math.min(PlayerInfo.BestZone(player), #m)]
end

function PlayerInfo.Init()
	DataService.AddDecorator(function(player, s)
		s.Slots = PlayerInfo.Slots(player)
		s.EctoMultiplier = PlayerInfo.EctoMultiplier(player)
		s.LuckMultiplier = PlayerInfo.LuckMultiplier(player)
		-- luck without the timed boost (pass, Server Luck): the crate panel adds the boost itself
		local dd = DataService.Get(player)
		s.LuckOther = s.LuckMultiplier / (if dd and PlayerInfo.BoostActive(dd, "Luck") then Config.Boosts.Luck.Multiplier else 1)
		s.PickupRadius = PlayerInfo.PickupRadius(player)
		s.ZoneMultiplier = PlayerInfo.ZoneMultiplier(player)
		s.MaxHunters = PlayerInfo.MaxHunters(player)
		s.ServerLuckUntil = serverLuckUntil
		s.PetBonuses = PlayerInfo.PetBonuses(player)
		local owned = {}
		for _, p in Config.GamePasses do
			owned[p.Key] = PlayerInfo.HasPass(player, p.Key)
		end
		owned[Config.AutoOpen.Pass] = PlayerInfo.HasAutoOpen(player)
		s.Passes = owned
	end)
end

return PlayerInfo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
-- Zone unlocks (+ keeping players out of locked zones), upgrades, daily reward,
-- settings and tutorial progress.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ProgressService = {}

local GATE_RANGE = 40
local TRAVEL_COOLDOWN = 3 -- seconds between Fast Travel jumps
local lastTravel: { [Player]: number } = {}
local lastGuardToast: { [Player]: number } = {}
local GUARD_TOAST_COOLDOWN = 5 -- seconds between "Unlock <zone> first!" toasts

local zoneRanges: { { number } } = {}
for _, z in Config.Zones do
	table.insert(zoneRanges, { z.MinZ, z.MaxZ })
end

local function applyWalkSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = PlayerInfo.WalkSpeed(player)
	end
end

-- Daily reward grant (also used by Day 7 crate token).
local function grantReward(player: Player, d: DataService.Data, reward: Config.RewardDef): string
	local mult = PlayerInfo.ZoneMultiplier(player)
	if reward.Amount and reward.Amount > 0 then
		DataService.AddEcto(player, reward.Amount * mult)
	end
	if reward.Boost and reward.Seconds then
		PlayerInfo.AddBoost(d, reward.Boost, reward.Seconds)
	end
	if reward.Crate then
		d.FreeCrates[reward.Crate] = (d.FreeCrates[reward.Crate] or 0) + 1
	end
	if reward.Amount and mult > 1 then
		return (reward.Label:gsub(Format.Commas(reward.Amount), Format.Commas(reward.Amount * mult)))
	end
	return reward.Label
end
ProgressService.GrantReward = grantReward

function ProgressService.Init()
	DataService.AddDecorator(function(_player, s)
		local d = s :: any
		local info = Rules.Daily(os.time(), d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		s.DailyInfo = info
	end)

	Remotes.Register("UnlockZone", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if d.Zones[zone.Id] then
			return { ok = true }
		end
		local prev = Config.Zones[zone.Order - 1]
		if prev and not d.Zones[prev.Id] then
			return Remotes.Fail("Unlock " .. prev.Name .. " first!")
		end
		local gate = Config.Layout.Gates[zone.Id]
		if gate and not Remotes.Near(player, Vector3.new(0, 3, gate.Z), GATE_RANGE) then
			return Remotes.Fail("Walk to the gate first!")
		end
		if not DataService.Spend(player, zone.Cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Zones[zone.Id] = true
		DataService.Changed(player)
		Fx.To(player, "ZoneUnlocked", { Zone = zone.Id })
		return { ok = true }
	end)

	-- Fast Travel (WORLDS menu): only to zones this profile owns, onto the zone's arrival pad.
	Remotes.Register("Travel", "Default", function(player, zoneId)
		local d = DataService.Get(player)
		local zone = type(zoneId) == "string" and Config.ZoneById[zoneId] or nil
		if not d or not zone then
			return Remotes.Fail("Unknown area")
		end
		if not d.Zones[zone.Id] then
			return Remotes.Fail("Unlock " .. zone.Name .. " first!")
		end
		if player:GetAttribute("InTower") == true then
			return Remotes.Fail("Leave the Boss Tower first!")
		end
		local now = os.clock()
		if now - (lastTravel[player] or -math.huge) < TRAVEL_COOLDOWN then
			return Remotes.Fail("Wait a moment...")
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = Remotes.Root(player)
		if not char or not hum or hum.Health <= 0 or not root then
			return Remotes.Fail("Can't travel right now")
		end
		local spawnPos = (Config.Layout.ZoneSpawns :: any)[zone.Id] :: Vector3?
		if not spawnPos then
			return Remotes.Fail("Unknown area")
		end
		lastTravel[player] = now
		-- small random offset so a group travelling together doesn't stack
		local a = math.random() * math.pi * 2
		local r = math.random() * 3
		local pos = spawnPos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		root.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)))
		return { ok = true }
	end)

	-- shownLevel = the level the client displayed with the price; if it changed meanwhile (double
	-- tap, lag) the purchase is refused instead of charging a price the player never saw. nil = old client.
	Remotes.Register("BuyUpgrade", "Default", function(player, upgradeId, shownLevel)
		local d = DataService.Get(player)
		local up = type(upgradeId) == "string" and Config.Upgrades[upgradeId] or nil
		if not d or not up then
			return Remotes.Fail("Unknown upgrade")
		end
		local level = d.Upgrades[up.Id] or 1
		if type(shownLevel) == "number" and shownLevel ~= level then
			return Remotes.Fail("Price changed, try again")
		end
		local cost = Rules.UpgradeCost(up.Costs, level)
		if not cost then
			return Remotes.Fail("Already maxed!")
		end
		if not DataService.Spend(player, cost) then
			return Remotes.Fail("Not enough Ectoplasm!")
		end
		d.Upgrades[up.Id] = level + 1
		if up.Id == "MoveSpeed" then
			applyWalkSpeed(player)
		end
		DataService.Changed(player)
		return { ok = true, Level = level + 1 }
	end)

	Remotes.Register("ClaimDaily", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		local now = os.time()
		local info = Rules.Daily(now, d.Daily.Last, d.Daily.Streak, Config.Daily.Cooldown, Config.Daily.StreakReset, #Config.Daily.Rewards)
		if not info.CanClaim then
			return Remotes.Fail("Come back in " .. Format.Time(info.Wait))
		end
		local reward = Config.Daily.Rewards[info.Day]
		local streak = if info.Day == 1 then 1 else d.Daily.Streak + 1
		d.Daily.Last = now
		d.Daily.Streak = streak
		local label = grantReward(player, d, reward)
		DataService.Changed(player)
		DataService.Save(player)
		return { ok = true, Day = info.Day, Label = label }
	end)

	Remotes.Register("Setting", "Default", function(player, key, value)
		local d = DataService.Get(player)
		if not d or type(key) ~= "string" or type(value) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		if type((d.Settings :: any)[key]) ~= "boolean" then
			return Remotes.Fail("Bad setting")
		end
		(d.Settings :: any)[key] = value
		DataService.Changed(player)
		return { ok = true }
	end)

	-- The "what's new" popup was closed: remember this version so it shows once per update.
	Remotes.Register("SeenUpdate", "Default", function(player)
		local d = DataService.Get(player)
		if not d then
			return Remotes.Fail("Loading...")
		end
		d.SeenUpdate = Config.UpdateNotes.Version
		DataService.Changed(player)
		return { ok = true }
	end)

	-- Tutorial progress is cosmetic (client-driven guidance); only allow moving forward.
	Remotes.Register("Tutorial", "Default", function(player, step)
		local d = DataService.Get(player)
		if not d or type(step) ~= "number" or step ~= step then
			return Remotes.Fail("Bad step")
		end
		step = math.clamp(math.floor(step), 1, #Config.Tutorial.Steps + 1)
		if step > d.Tutorial then
			d.Tutorial = step
			DataService.Changed(player)
		end
		return { ok = true }
	end)
end

-- Server-side guard: anyone standing in a zone they don't own is moved back to the gate.
local function zoneGuardTick()
	for _, player in Players:GetPlayers() do
		local d = DataService.Get(player)
		local root = Remotes.Root(player)
		if not d or not root or player:GetAttribute("InTower") == true then
			continue -- Boss Tower rooms are outside the zone strip; TowerService moves them
		end
		local idx = Rules.ZoneIndexAt(root.Position.Z, zoneRanges)
		local zone = Config.Zones[idx]
		if zone and not d.Zones[zone.Id] then
			-- find the furthest owned zone and drop them in front of its exit gate
			local safeZ = Config.Layout.Spawn.Z
			for i = idx - 1, 1, -1 do
				local z = Config.Zones[i]
				if d.Zones[z.Id] then
					local nextZone = Config.Zones[i + 1]
					local gate = nextZone and Config.Layout.Gates[nextZone.Id]
					safeZ = if gate then gate.Z - 12 else z.MinZ + 20
					break
				end
			end
			local char = player.Character
			if char then
				char:PivotTo(CFrame.new(math.clamp(root.Position.X, -10, 10), 4, safeZ))
				local now = os.clock()
				if now - (lastGuardToast[player] or -math.huge) >= GUARD_TOAST_COOLDOWN then
					lastGuardToast[player] = now
					Fx.Toast(player, "Unlock " .. zone.Name .. " first!", "Bad")
				end
			end
		end
	end
end

function ProgressService.Start()
	local function setup(player: Player, char: Model)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			applyWalkSpeed(player)
			-- players pass through each other: characters go in their own collision group
			for _, part in char:GetDescendants() do
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end
			char.DescendantAdded:Connect(function(part)
				if part:IsA("BasePart") then
					part.CollisionGroup = "Players"
				end
			end)
		end
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			setup(player, char)
		end)
		-- a character that spawned while the world was still building
		if player.Character then
			task.spawn(setup, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(player)
		lastTravel[player] = nil
		lastGuardToast[player] = nil
	end)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	DataService.Loaded:Connect(function(player)
		applyWalkSpeed(player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				zoneGuardTick()
			end)
			if not ok then
				warn("[Zones] guard error: " .. tostring(err))
			end
		end
	end)
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">RarePetEventService</string>
            <string name="Source"><![CDATA[--!strict
-- FREE RARE PET launch event (Config.RarePetEvent). ONE global 48-hour window, started only by
-- an admin (Config.RarePetEvent.AdminUserIds) from the DEV panel. Never starts by itself.
--   * state { Id, Start, End } lives in a DataStore under "<Key>_<Id>". Activation is a single
--     UpdateAsync that writes ONLY when nothing is saved yet, so double taps, retries or two
--     servers at once can never create a second event or move the deadline. An Id that was ever
--     started can never start again (a future event needs a new Id in Config).
--   * after activation the server publishes on Config.RarePetEvent.Topic; every server also reads
--     the state at start and every RefreshSeconds (a missed message heals)
--   * clients see workspace attributes RarePetEventId / RarePetStart / RarePetEnd (+ RarePetChecked
--     once this server has read the saved state)
--   * Studio: state is kept in memory only (the production DataStore is never touched), so a
--     Studio test can never start the live event or grant live rewards
-- Players earn active play time (d.EventPlay[Id].S) only inside [Start, End) and only while not
-- idle. Reaching RequiredSeconds grants the pet once per account (G), also on a later join.
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local RarePetEventService = {}

export type EventState = { Id: string, Start: number, End: number }
export type Status = { State: string, Start: number?, End: number? } -- Checking | NotStarted | Active | Ended
export type ActivateResult = { ok: boolean, err: string?, Created: boolean, Event: Status }

local E = Config.RarePetEvent
local IS_STUDIO = RunService:IsStudio()
local KEY = E.Key .. "_" .. E.Id
local MOVE_STUDS = 3

local store: DataStore? = nil
local current: EventState? = nil
local checked = false -- this server has read the saved state at least once
local activating = false

type Track = { Pos: Vector3?, Moved: number? } -- last root position, os.clock() of last movement
local track: { [Player]: Track } = {}

local function sanitize(v: any): EventState?
	if type(v) == "table" and v.Id == E.Id and type(v.Start) == "number" and type(v.End) == "number" and v.End > v.Start then
		return { Id = E.Id, Start = math.floor(v.Start), End = math.floor(v.End) }
	end
	return nil
end

function RarePetEventService.IsAdmin(player: Player): boolean
	if IS_STUDIO then
		return true -- the local tester (memory-only state, see above)
	end
	return table.find(E.AdminUserIds, player.UserId) ~= nil
end

function RarePetEventService.Status(): Status
	local st = current
	if not st then
		return { State = if checked then "NotStarted" else "Checking" }
	end
	local now = os.time()
	return { State = if now < st.End then "Active" else "Ended", Start = st.Start, End = st.End }
end

function RarePetEventService.Active(): boolean
	local st = current
	local now = os.time()
	return st ~= nil and now >= st.Start and now < st.End
end

-- Applies a state in this server. Saved state (fromStore) is the truth; a message is only used
-- while nothing is known yet (the periodic re-read corrects anything else).
local function apply(st: EventState?, fromStore: boolean)
	if fromStore then
		checked = true
		workspace:SetAttribute("RarePetChecked", true)
	end
	if not st then
		return
	end
	if current and not fromStore then
		return
	end
	local old = current
	current = st
	workspace:SetAttribute("RarePetEventId", st.Id)
	workspace:SetAttribute("RarePetStart", st.Start)
	workspace:SetAttribute("RarePetEnd", st.End)
	if not old and os.time() < st.End then
		Fx.All("RarePetEventStarted", { Start = st.Start, End = st.End })
	end
end

-- Reads the saved state. ok = false when the read failed (state unknown).
local function load(): (boolean, EventState?)
	local s = store
	if not s then
		return IS_STUDIO, if IS_STUDIO then current else nil
	end
	for attempt = 1, 3 do
		local ok, v = pcall(function()
			return s:GetAsync(KEY)
		end)
		if ok then
			return true, sanitize(v)
		end
		if attempt < 3 then
			task.wait(attempt)
		end
	end
	return false, nil
end

-- Admin action (DevService checks too). Never errors; always reports the state it ended with.
function RarePetEventService.Activate(player: Player): ActivateResult
	if not RarePetEventService.IsAdmin(player) then
		return { ok = false, err = "Not allowed", Created = false, Event = RarePetEventService.Status() }
	end
	if current then
		return { ok = false, err = "This event was already started (it can't be restarted)", Created = false, Event = RarePetEventService.Status() }
	end
	if activating then
		return { ok = false, err = "Already starting, please wait...", Created = false, Event = RarePetEventService.Status() }
	end
	if IS_STUDIO then
		-- memory only: never the production DataStore
		local now = os.time()
		apply({ Id = E.Id, Start = now, End = now + E.Seconds }, true)
		return { ok = true, Created = true, Event = RarePetEventService.Status() }
	end
	local s = store
	if not s then
		return { ok = false, err = "Event storage unavailable on this server", Created = false, Event = RarePetEventService.Status() }
	end
	activating = true
	local now = os.time()
	local new: EventState = { Id = E.Id, Start = now, End = now + E.Seconds }
	local decision = "none" -- decided by the LAST transform call (the one that committed)
	local existing: EventState? = nil
	local ok, err = pcall(function()
		s:UpdateAsync(KEY, function(old: any)
			if old ~= nil then
				-- anything already saved for this Id (even an ended or unreadable state) = no write
				existing = sanitize(old)
				decision = if existing then "exists" else "bad"
				return nil
			end
			decision = "wrote"
			existing = nil
			return { Id = new.Id, Start = new.Start, End = new.End }
		end)
	end)
	local result: ActivateResult
	if ok and decision == "wrote" then
		apply(new, true)
		pcall(function()
			MessagingService:PublishAsync(E.Topic, new)
		end)
		result = { ok = true, Created = true, Event = RarePetEventService.Status() }
	elseif ok and decision == "exists" then
		apply(existing, true)
		result = { ok = false, err = "This event was already started (it can't be restarted)", Created = false, Event = RarePetEventService.Status() }
	else
		-- error or uncertain result: report what is really saved
		local readOk, st = load()
		if readOk then
			apply(st, true)
		end
		local why = if ok then "the saved event data is invalid" else tostring(err)
		if readOk and st then
			result = { ok = false, err = "Couldn't confirm the start (" .. why .. "). Saved state:", Created = false, Event = RarePetEventService.Status() }
			-- our write may have gone through before the error: tell the other servers anyway
			if st.Start == new.Start then
				pcall(function()
					MessagingService:PublishAsync(E.Topic, st)
				end)
			end
		elseif readOk then
			result = { ok = false, err = "Not started (" .. why .. "). Nothing was saved; try again.", Created = false, Event = RarePetEventService.Status() }
		else
			result = { ok = false, err = "Couldn't reach the event storage (" .. why .. "). State unknown; check again in a minute.", Created = false, Event = { State = "Checking" } }
		end
	end
	activating = false
	return result
end

--------------------------------------------------------------------------------
-- Rewards
--------------------------------------------------------------------------------
local function record(d: DataService.Data): DataService.EventPlay
	local ev = d.EventPlay[E.Id]
	if not ev then
		ev = { S = 0, G = false }
		d.EventPlay[E.Id] = ev
	end
	return ev
end

local function publishProgress(player: Player, ev: DataService.EventPlay)
	player:SetAttribute("RarePetPlay", ev.S)
	player:SetAttribute("RarePetGot", ev.G)
end

-- Grants the pet once per account when the play time is reached (also after the event ended).
local function tryGrant(player: Player, d: DataService.Data)
	local ev = d.EventPlay[E.Id]
	if not ev or ev.G or ev.S < E.RequiredSeconds then
		return
	end
	-- add + mark happen in one step (no yield), so the reward can never be given twice
	local uid = PetService.Add(d, E.Pet)
	if not uid then
		warn("[RarePetEvent] unknown reward pet " .. tostring(E.Pet))
		return
	end
	ev.G = true
	PetService.Refresh(player)
	DataService.Save(player)
	DataService.Changed(player)
	publishProgress(player, ev)
	local def = Config.Pets[E.Pet]
	Fx.To(player, "RarePetGranted", { Pet = E.Pet, Name = def and def.Name or E.Pet, Uid = uid })
end

local function isActive(player: Player, nowClock: number): boolean
	local t = track[player]
	if not t then
		t = {}
		track[player] = t
	end
	local root = Remotes.Root(player)
	if root then
		local pos = root.Position
		if t.Pos and (pos - (t.Pos :: Vector3)).Magnitude > MOVE_STUDS then
			t.Moved = nowClock
		end
		t.Pos = pos
	end
	local moved = t.Moved
	if moved and nowClock - moved <= E.IdleSeconds then
		return true
	end
	local acted = Remotes.LastAction(player)
	return acted ~= nil and nowClock - acted <= E.IdleSeconds
end

local function tick()
	local st = current
	local now = os.time()
	local nowClock = os.clock()
	for _, player in Players:GetPlayers() do
		local active = isActive(player, nowClock) -- keeps the movement tracker fresh
		local d = DataService.Get(player)
		if st and d and active then
			local credit = Rules.EventCredit(now, st.Start, st.End, E.TickSeconds)
			if credit > 0 then
				local ev = record(d)
				if not ev.G then
					ev.S += credit
					publishProgress(player, ev)
					tryGrant(player, d)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Studio test helper (DevService "RarePetAddMinutes"): adds play time, Studio only
--------------------------------------------------------------------------------
function RarePetEventService.StudioAddMinutes(player: Player, minutes: number): string?
	if not IS_STUDIO then
		return "Studio only"
	end
	if not RarePetEventService.Active() then
		return "Start the event first"
	end
	local d = DataService.Get(player)
	if not d then
		return "Loading..."
	end
	local ev = record(d)
	if ev.G then
		return "Already earned"
	end
	ev.S += math.clamp(math.floor(minutes), 1, 60) * 60
	publishProgress(player, ev)
	tryGrant(player, d)
	return nil
end

function RarePetEventService.Init()
	if not IS_STUDIO then
		local ok, ds = pcall(function()
			return DataStoreService:GetDataStore(E.DataStoreName)
		end)
		store = if ok then ds else nil
	end
	workspace:SetAttribute("RarePetChecked", false)
	DataService.AddDecorator(function(player, s)
		local d = DataService.Get(player)
		if d then
			s.EventPlay = d.EventPlay
		end
	end)
end

function RarePetEventService.Start()
	local function onLoaded(player: Player)
		local d = DataService.Get(player)
		if not d then
			return
		end
		local ev = d.EventPlay[E.Id]
		if ev then
			publishProgress(player, ev)
		end
		-- entitlement is kept even after the event ended
		tryGrant(player, d)
	end
	DataService.Loaded:Connect(function(player: Player, _data: any)
		onLoaded(player)
	end)
	local function added(player: Player)
		player:SetAttribute("RarePetAdmin", RarePetEventService.IsAdmin(player))
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		added(p)
		onLoaded(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		track[player] = nil
	end)

	-- read the saved state (never starts anything by itself); keep retrying until known
	task.spawn(function()
		while true do
			local ok, st = load()
			if ok then
				apply(st, true)
			end
			task.wait(if ok then E.RefreshSeconds else 15)
		end
	end)
	if not IS_STUDIO then
		task.spawn(function()
			pcall(function()
				MessagingService:SubscribeAsync(E.Topic, function(msg)
					apply(sanitize(msg.Data), false)
				end)
			end)
		end)
	end
	task.spawn(function()
		while true do
			task.wait(E.TickSeconds)
			local ok, err = pcall(function()
				tick()
			end)
			if not ok then
				warn("[RarePetEvent] tick failed: " .. tostring(err))
			end
		end
	end)
end

return RarePetEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Validated, rate-limited request dispatcher. Clients call
--   Request:InvokeServer(action, ...) -> { ok: boolean, err: string?, ... }
-- Handlers never trust arguments: they type-check everything they receive.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Net = require(GH.Net)
local Rules = require(GH.Logic.Rules)

local Remotes = {}

type Handler = (Player, ...any) -> any
local handlers: { [string]: { fn: Handler, bucket: string } } = {}
local limiters: { [string]: Rules.Limiter } = {}
local lastAction: { [Player]: number } = {} -- os.clock() of the player's last accepted request (activity)

local function limiter(bucket: string): Rules.Limiter
	local l = limiters[bucket]
	if not l then
		local def = (Config.RateLimits :: any)[bucket] or Config.RateLimits.Default
		l = Rules.NewLimiter(def.Count, def.Window)
		limiters[bucket] = l
	end
	return l
end

function Remotes.Allow(player: Player, bucket: string): boolean
	return Rules.Allow(limiter(bucket), tostring(player.UserId), os.clock())
end

function Remotes.Register(action: string, bucket: string, fn: Handler)
	assert(not handlers[action], "duplicate action " .. action)
	handlers[action] = { fn = fn, bucket = bucket }
end

function Remotes.Init()
	local rf = Net.Function("Request")
	rf.OnServerInvoke = function(player: Player, action: any, ...: any): any
		if type(action) ~= "string" then
			return { ok = false, err = "Bad request" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, err = "Unknown action" }
		end
		if not Remotes.Allow(player, h.bucket) then
			return { ok = false, err = "Slow down!" }
		end
		local ok, result = pcall(h.fn, player, ...)
		if not ok then
			warn(string.format("[Remotes] %s from %s errored: %s", action, player.Name, tostring(result)))
			return { ok = false, err = "Something went wrong" }
		end
		-- only requests that did something count as activity (rejected spam doesn't)
		if player.Parent and (result == true or (type(result) == "table" and result.ok == true)) then
			lastAction[player] = os.clock()
		end
		if type(result) ~= "table" then
			return { ok = result == true }
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
		local key = tostring(player.UserId)
		for _, l in limiters do
			l.hits[key] = nil
		end
	end)
end

-- os.clock() of the player's last accepted request, or nil (activity checks, e.g. idle detection)
function Remotes.LastAction(player: Player): number?
	return lastAction[player]
end

-- Helpers for handlers
function Remotes.Fail(err: string): any
	return { ok = false, err = err }
end

function Remotes.Root(player: Player): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Remotes.Near(player: Player, pos: Vector3, maxDist: number): boolean
	local root = Remotes.Root(player)
	return root ~= nil and (root.Position - pos).Magnitude <= maxDist
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SafetyService</string>
            <string name="Source"><![CDATA[--!strict
-- Fall-through-map safety net. Remembers where each character last stood on solid ground and,
-- if a character ever drops below Config.FallSafety.MinY (well under every floor), puts it
-- back there with a friendly toast. Never kills, never removes anything, no penalty.
-- workspace.FallenPartsDestroyHeight is lowered so this rescue always fires before Roblox
-- deletes a falling character.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Fx = require(script.Parent.Fx)

local SafetyService = {}

local cfg = Config.FallSafety
local MIN_Y: number = cfg.MinY
local CHECK_SECONDS: number = cfg.CheckSeconds
local SAFE_EVERY: number = cfg.SafeEvery
local SAFE_MAX_Y = -2 -- root must be above this (lowest walkable floor top is ~ -0.5)
local RESCUE_COOLDOWN = 2 -- seconds; lets the teleport replicate before checking again
local TOAST = "Whoops! You fell out of the world - put you back safely."

type Track = { LastSafe: CFrame?, SafeInTower: boolean, SafeAt: number, RescuedAt: number }
local tracks: { [Player]: Track } = {}

local function track(player: Player): Track
	local t = tracks[player]
	if not t then
		t = { LastSafe = nil, SafeInTower = false, SafeAt = 0, RescuedAt = 0 }
		tracks[player] = t
	end
	return t
end

-- True when there is solid ground within a few studs below `pos`.
local function groundBelow(pos: Vector3, character: Model): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	return Workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params) ~= nil
end

-- Fast Travel arrival pad nearest to `pos` (falls back to the main spawn).
local function nearestZoneSpawn(pos: Vector3): Vector3
	local best: Vector3 = Config.Layout.Spawn
	local bestD = math.huge
	local spawns: { [string]: Vector3 } = (Config.Layout :: any).ZoneSpawns or {}
	for _, p in spawns do
		local d = (Vector3.new(p.X, 0, p.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
		if d < bestD then
			best, bestD = p, d
		end
	end
	return Vector3.new(best.X, 3, best.Z)
end

local function rescue(player: Player, character: Model, root: BasePart, t: Track)
	local fellAt = root.Position
	local target: CFrame? = nil
	local source = "zone spawn"

	if player:GetAttribute("InTower") == true then
		local towerSafe = player:GetAttribute("TowerSafe")
		if typeof(towerSafe) == "Vector3" then
			target = CFrame.new(towerSafe + Vector3.new(0, 3, 0))
			source = "TowerSafe"
		end
	end
	-- a spot saved inside a tower room never counts on the main map (and vice versa)
	if not target and t.LastSafe and t.SafeInTower == (player:GetAttribute("InTower") == true) then
		local cf = (t.LastSafe :: CFrame) + Vector3.new(0, 3, 0)
		if groundBelow(cf.Position, character) then
			target = cf
			source = "last safe spot"
		end
	end
	if not target then
		target = CFrame.new(nearestZoneSpawn(fellAt))
	end
	local dest = target :: CFrame

	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	character:PivotTo(dest)
	t.RescuedAt = os.clock()

	warn(string.format(
		"[Safety] %s fell out of the world at (%.1f, %.1f, %.1f) -> back to %s (%.1f, %.1f, %.1f)%s",
		player.Name,
		fellAt.X,
		fellAt.Y,
		fellAt.Z,
		source,
		dest.Position.X,
		dest.Position.Y,
		dest.Position.Z,
		if player:GetAttribute("InTower") == true then " [in tower]" else ""
	))
	pcall(Fx.Toast, player, TOAST)
end

local function check(player: Player, now: number)
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end
	local t = track(player)
	local y = root.Position.Y
	if y < MIN_Y then
		if now - t.RescuedAt >= RESCUE_COOLDOWN then
			rescue(player, character, root, t)
		end
	elseif y > SAFE_MAX_Y and humanoid.FloorMaterial ~= Enum.Material.Air and now - t.SafeAt >= SAFE_EVERY then
		-- keep only position + facing (no tilt)
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local pos = root.Position
		t.LastSafe = if flat.Magnitude > 0.01 then CFrame.lookAt(pos, pos + flat.Unit) else CFrame.new(pos)
		t.SafeInTower = player:GetAttribute("InTower") == true
		t.SafeAt = now
	end
end

function SafetyService.Init()
	-- (scripts may not set Workspace.FallenPartsDestroyHeight; the default -500 is far below the
	-- MinY -40 rescue line, so the rescue always fires first)
end

function SafetyService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			local t = track(player)
			t.LastSafe = nil
			t.SafeAt = 0
		end)
	end
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		tracks[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_SECONDS)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(function()
					check(player, now)
				end)
				if not ok then
					warn("[Safety] check failed for " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end)
end

return SafetyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux shop: developer products (Ectoplasm packs, boosts) and game passes.
-- ProcessReceipt is idempotent: receipts are recorded in the profile and saved before
-- returning PurchaseGranted, so a purchase is never lost or granted twice.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local ShopService = {}

-- Products no longer sold: Buy refuses them; ProcessReceipt still honours old receipts.
local RETIRED_KINDS: { [string]: boolean } = { SummonEvent = true }
local LEGACY_SUMMON_LUCK_SECONDS = 900

local function productById(id: number): Config.ProductDef?
	for _, p in Config.Products do
		if p.ProductId == id then
			return p
		end
	end
	return nil
end

local function nextLockedZone(d: DataService.Data): Config.ZoneDef?
	for _, z in Config.Zones do
		if not d.Zones[z.Id] then
			return z
		end
	end
	return nil
end

local function grantProduct(player: Player, d: DataService.Data, p: Config.ProductDef)
	if p.Kind == "Ecto" and p.Amount then
		DataService.AddEcto(player, p.Amount * PlayerInfo.ZoneMultiplier(player))
	elseif p.Kind == "Boost" and p.Boost and p.Seconds then
		PlayerInfo.AddBoost(d, p.Boost, p.Seconds, true) -- paid: never capped away
	elseif p.Kind == "CrateSkip" then
		-- never cap here: this skip is already paid for (the cap is enforced before prompting)
		d.SkipTokens = (d.SkipTokens or 0) + 1
		Fx.To(player, "SkipGranted", {})
	elseif p.Kind == "SkipArea" then
		local z = nextLockedZone(d)
		if z then
			d.Zones[z.Id] = true
			Fx.To(player, "ZoneUnlocked", { Zone = z.Id })
		else
			-- everything was already open (bought twice quickly): pay out a big Ectoplasm pack instead
			DataService.AddEcto(player, (p.Amount or 0) * PlayerInfo.ZoneMultiplier(player))
		end
	elseif p.Kind == "ExclusiveCrate" then
		local uid, hunterId, isNew = HunterService.GrantExclusive(player)
		if uid and hunterId then
			Fx.To(player, "Exclusive", { Uid = uid, Hunter = hunterId, IsNew = isNew })
		end
	elseif p.Kind == "ServerLuck" and p.Seconds then
		PlayerInfo.AddServerLuck(p.Seconds, true) -- paid: never capped away
		Fx.All("Announce", { Text = player.DisplayName .. " turned on SERVER LUCK for everyone! 🍀", Color = "Rare" })
		for _, other in Players:GetPlayers() do
			DataService.Changed(other)
		end
	elseif p.Kind == "SummonEvent" then
		-- RETIRED product (the Giant Poltergeist event is gone and it is no longer sold). An old
		-- or delayed receipt still gets something fair that can never be capped away: the
		-- biggest Ectoplasm pack for the buyer.
		local _ = LEGACY_SUMMON_LUCK_SECONDS
		local pack = 0
		for _, q in Config.Products do
			if q.Kind == "Ecto" and q.Amount and q.Amount > pack then
				pack = q.Amount
			end
		end
		DataService.AddEcto(player, pack * PlayerInfo.ZoneMultiplier(player))
		DataService.Changed(player)
		Fx.Toast(player, "Thanks! The Giant Poltergeist event was retired, so you got a big Ectoplasm pack instead!", "Good")
		return
	end
	DataService.Changed(player)
	Fx.Toast(player, "Thanks! " .. p.Name .. " added!", "Good")
end

-- Cosmetic / social pass effects that other players can see.
local function applyPassLooks(player: Player)
	player:SetAttribute("VIP", PlayerInfo.HasPass(player, "VIP"))
	player:SetAttribute("RainbowBeams", PlayerInfo.HasPass(player, "RainbowBeams"))
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local old = root:FindFirstChild("GHSparkleTrail")
	if PlayerInfo.HasPass(player, "SparkleTrail") and not old then
		local a0 = Instance.new("Attachment")
		a0.Name = "GHTrailA"
		a0.Position = Vector3.new(0, 0.6, 0.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "GHTrailB"
		a1.Position = Vector3.new(0, -1.6, 0.4)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "GHSparkleTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.6
		t.LightEmission = 0.6
		t.FaceCamera = true
		t.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 220)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 240, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 255, 140)),
		})
		t.Transparency = NumberSequence.new(0.2, 1)
		t.Parent = root
	end
	-- VIP tag over the head
	local head = (char :: Model):FindFirstChild("Head")
	if head and PlayerInfo.HasPass(player, "VIP") and not head:FindFirstChild("GHVipTag") then
		local bb = Instance.new("BillboardGui")
		bb.Name = "GHVipTag"
		bb.Size = UDim2.fromOffset(60, 20)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.MaxDistance = 70
		bb.LightInfluence = 0
		bb.Parent = head
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Text = "👑 VIP"
		l.Font = Enum.Font.FredokaOne
		l.TextSize = 16
		l.TextColor3 = Color3.fromRGB(255, 215, 80)
		l.TextStrokeTransparency = 0.3
		l.Parent = bb
	end
end
ShopService.ApplyPassLooks = applyPassLooks

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = DataService.WaitFor(player, 20)
	if not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipt = tostring(info.PurchaseId)
	if DataService.HasPurchase(d, receipt) then
		-- already granted in this session; only confirm once it is really saved
		return if DataService.SaveNow(player)
			then Enum.ProductPurchaseDecision.PurchaseGranted
			else Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = productById(info.ProductId)
	if not p then
		warn("[Shop] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(player, d, p)
	DataService.AddPurchase(d, receipt)
	if not DataService.SaveNow(player) then
		-- Roblox will retry the receipt later; our record prevents a double grant in this session
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Asks Roblox (3 tries with backoff). true/false = answer, nil = still unknown.
local function ownsPass(player: Player, passId: number): boolean?
	for attempt = 1, 3 do
		local ok, owned = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		end)
		if ok then
			return owned == true
		end
		if attempt < 3 then
			task.wait(2 * attempt)
		end
		if not player.Parent then
			return nil
		end
	end
	return nil
end

local RECHECK_SECONDS = 180 -- passes Roblox couldn't confirm are asked about again this often
local checking: { [Player]: boolean } = {}
-- passes bought this session that Roblox hasn't confirmed yet: a "false" answer stays unknown
local unconfirmed: { [Player]: { [string]: boolean } } = {}

-- onlyUnknown = re-check just the passes whose earlier check failed.
local function checkPasses(player: Player, onlyUnknown: boolean?)
	if checking[player] then
		return
	end
	checking[player] = true
	for _, pass in Config.GamePasses do
		if pass.PassId and (not onlyUnknown or PlayerInfo.PassUnknown(player, pass.Key)) then
			local owned = ownsPass(player, pass.PassId :: number)
			if not player.Parent then
				checking[player] = nil
				return -- left while we were asking Roblox
			end
			if owned == nil then
				-- unknown: not owned for gameplay, but never re-sold and slots are never trimmed
				PlayerInfo.SetPass(player, pass.Key, PlayerInfo.HasPass(player, pass.Key))
				PlayerInfo.SetPassUnknown(player, pass.Key)
			elseif not owned and unconfirmed[player] and unconfirmed[player][pass.Key] then
				PlayerInfo.SetPassUnknown(player, pass.Key) -- bought, Roblox's cache is behind: ask again later
			else
				if owned and unconfirmed[player] then
					unconfirmed[player][pass.Key] = nil
				end
				-- never take back a pass granted this session (a purchase can lag Roblox's cache)
				PlayerInfo.SetPass(player, pass.Key, owned or PlayerInfo.HasPass(player, pass.Key))
			end
		end
	end
	checking[player] = nil
	PlayerInfo.SetPassesChecked(player)
	applyPassLooks(player)
	-- pass state is known now: only now may a lost Extra Slots pass trim the equipped list
	HunterService.EnsureEquipped(player)
	HunterService.Refresh(player)
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.PassId == passId then
				-- the client's "purchased" flag isn't proof: confirm with Roblox first
				local owned: boolean? = nil
				for attempt = 1, 3 do
					owned = ownsPass(player, passId)
					if owned or not player.Parent then
						break
					end
					task.wait(attempt)
				end
				if not player.Parent then
					return
				end
				if owned then
					PlayerInfo.SetPass(player, pass.Key, true)
					applyPassLooks(player)
					HunterService.Refresh(player)
					Fx.Toast(player, "Thanks! " .. pass.Name .. " unlocked!", "Good")
				elseif not PlayerInfo.HasPass(player, pass.Key) then
					-- not confirmed yet: keep it "unknown" (not re-sold) and let the re-check unlock it
					unconfirmed[player] = unconfirmed[player] or {}
					unconfirmed[player][pass.Key] = true
					PlayerInfo.SetPassUnknown(player, pass.Key)
					Fx.Toast(player, "Checking your " .. pass.Name .. " purchase... it unlocks in a few minutes.", "Good")
				end
			end
		end
	end)

	-- Client asks to buy: server validates the key and prompts (ids never come from the client).
	Remotes.Register("Buy", "Default", function(player, key)
		if type(key) ~= "string" then
			return Remotes.Fail("Bad item")
		end
		for _, p in Config.Products do
			if p.Key == key then
				if RETIRED_KINDS[p.Kind] then
					return Remotes.Fail("This isn't sold anymore")
				end
				if not p.ProductId then
					return Remotes.Fail("Coming soon!")
				end
				local d = DataService.Get(player)
				if p.Kind == "CrateSkip" and PlayerInfo.HasPermanentSkip(player) then
					return Remotes.Fail("You already have Permanent Crate Skip!")
				end
				if p.Kind == "CrateSkip" and d and (d.SkipTokens or 0) >= Config.CrateSkip.MaxTokens then
					return Remotes.Fail("You already have the most skips you can hold!")
				end
				if p.Kind == "SkipArea" and d and not nextLockedZone(d) then
					return Remotes.Fail("Every area is already unlocked!")
				end
				if p.Kind == "ExclusiveCrate" and d then
					local count = 0
					for _ in d.Hunters do
						count += 1
					end
					if count >= PlayerInfo.MaxHunters(player) then
						return Remotes.Fail("Hunter storage full! Release some hunters first.")
					end
				end
				if p.Kind == "ServerLuck" and PlayerInfo.ServerLuckUntil() - os.time() + (p.Seconds or 0) > Config.ServerLuck.MaxStackSeconds then
					return Remotes.Fail("Server luck is already maxed!")
				end
				if p.Kind == "Boost" and p.Boost and p.Seconds then
					-- boosts stack up to a cap; don't sell time that would be thrown away
					local left = if d then (d.Boosts[p.Boost] or 0) - os.time() else 0
					if left + p.Seconds > Config.Boosts.MaxStackSeconds then
						return Remotes.Fail("That boost is already stacked to the max!")
					end
				end
				MarketplaceService:PromptProductPurchase(player, p.ProductId)
				return { ok = true }
			end
		end
		for _, pass in Config.GamePasses do
			if pass.Key == key then
				if not pass.PassId then
					return Remotes.Fail("Coming soon!")
				end
				if PlayerInfo.HasPass(player, pass.Key) then
					return Remotes.Fail("You already own this!")
				end
				if PlayerInfo.PassUnknown(player, pass.Key) then
					return Remotes.Fail("Still checking your passes, try again in a moment")
				end
				if pass.Key == Config.AutoOpen.Pass and PlayerInfo.HasAutoOpen(player) then
					return Remotes.Fail("You already have Auto Open!")
				end
				if pass.Hidden then
					return Remotes.Fail("This isn't sold anymore")
				end
				MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
				return { ok = true }
			end
		end
		return Remotes.Fail("Bad item")
	end)

	DataService.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
	-- trail / VIP tag again after every respawn
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart", 10)
			char:WaitForChild("Head", 10)
			applyPassLooks(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
end

function ShopService.Start()
	-- passes Roblox couldn't confirm (check failed, or a purchase not visible yet): ask again
	task.spawn(function()
		while true do
			task.wait(RECHECK_SECONDS)
			for _, player in Players:GetPlayers() do
				if PlayerInfo.HasUnknownPasses(player) and DataService.Get(player) then
					task.spawn(checkPasses, player, true)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		checking[player] = nil
		unconfirmed[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">StationService</string>
            <string name="Source"><![CDATA[--!strict
-- Dresses the stations the world builder made: crate display models, odds boards and
-- ProximityPrompts (crates, upgrades, gates). Prompts only open client UI; every purchase
-- goes through validated Requests.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local Format = require(GH.Logic.Format)
local CrateRig = require(GH.Rigs.CrateRig)

local StationService = {}

local function find(path: { string }): Instance?
	local cur: Instance? = workspace
	for _, name in path do
		cur = cur and cur:FindFirstChild(name)
	end
	return cur
end

local function prompt(parent: Instance, action: string, object: string, attrs: { [string]: any }): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "GHPrompt"
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonY
	p.Style = Enum.ProximityPromptStyle.Default
	for k, v in attrs do
		p:SetAttribute(k, v)
	end
	p.Parent = parent
	return p
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(25, 10, 45)
	stroke.Parent = t
	t.Parent = parent
	return t
end

local function rarityOrder(id: string): number
	local h = Config.Hunters[id]
	return if h then Config.Rarities[h.Rarity].Order else 1
end

local function buildOddsBoard(board: BasePart, crate: Config.CrateDef)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Odds"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 1.15
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(35, 20, 60)
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(70, 40, 120), Color3.fromRGB(25, 15, 45))
	grad.Rotation = 90
	grad.Parent = bg
	label(bg, crate.Name, UDim2.fromScale(0.94, 0.13), UDim2.fromScale(0.03, 0.03), crate.Trim)
	label(bg, Format.Short(crate.Price) .. " ECTOPLASM", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.1, 0.17), Color3.fromRGB(150, 255, 150))
	local odds = Rules.Odds(crate.Pool :: any, rarityOrder, 1, Config.LuckAffectsFromOrder)
	for i, e in crate.Pool do
		local def = Config.Hunters[e.Hunter]
		local rar = Config.Rarities[def.Rarity]
		local row = Instance.new("Frame")
		row.Size = UDim2.fromScale(0.92, 0.155)
		row.Position = UDim2.fromScale(0.04, 0.29 + (i - 1) * 0.175)
		row.BackgroundColor3 = rar.Color
		row.BackgroundTransparency = 0.15
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = row
		local g2 = Instance.new("UIGradient")
		g2.Color = ColorSequence.new(rar.Color, rar.Color2)
		g2.Parent = row
		row.Parent = bg
		label(row, string.upper(def.Name), UDim2.fromScale(0.55, 0.55), UDim2.fromScale(0.03, 0.05), Color3.new(1, 1, 1))
		label(row, rar.Name .. "  ·  ⚡" .. Format.Commas(def.Power), UDim2.fromScale(0.55, 0.38), UDim2.fromScale(0.03, 0.58), Color3.fromRGB(255, 255, 230))
		label(row, Format.Percent(odds[e.Hunter]), UDim2.fromScale(0.35, 0.8), UDim2.fromScale(0.62, 0.1), Color3.new(1, 1, 1))
	end
	gui.Parent = board
end

function StationService.Init() end

function StationService.Start()
	for crateId, crate in Config.Crates do
		if not Config.Layout.CrateStations[crateId] then
			continue -- no station (Exclusive Crate is Robux-only)
		end
		local station = find({ "Map", "Stations", "CrateStation_" .. crateId })
		if not station then
			warn("[Stations] missing CrateStation_" .. crateId)
			continue
		end
		local slot = station:FindFirstChild("DisplaySlot") :: BasePart?
		if slot then
			local rig = CrateRig.Build(crateId)
			rig.Model.Name = "DisplayCrate"
			rig.Model:ScaleTo(1.3)
			rig.Model:PivotTo(CFrame.new(slot.Position - Vector3.new(0, 1.6, 0)))
			rig.Model.Parent = station
			CollectionService:AddTag(rig.Base, "SpinProp")
		end
		local board = station:FindFirstChild("OddsBoard") :: BasePart?
		if board then
			buildOddsBoard(board, crate)
		end
		local anchor = station:FindFirstChild("PromptAnchor")
		if anchor then
			prompt(anchor, "Open Crate", crate.Name .. " · " .. Format.Commas(crate.Price), { Crate = crateId })
		end
	end
	local up = find({ "Map", "Stations", "UpgradeStation", "PromptAnchor" })
	if up then
		prompt(up, "Upgrades", "Upgrade Station", { Station = "Upgrades" })
	end
	for _, zone in Config.Zones do
		local anchor = find({ "Map", "Gates", "Gate_" .. zone.Id, "PromptAnchor" })
		if anchor then
			prompt(anchor, "Unlock", zone.Name .. " · " .. Format.Commas(zone.Cost), { Zone = zone.Id })
		end
	end
end

return StationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">TowerService</string>
            <string name="Source"><![CDATA[--!strict
-- ENDLESS BOSS TOWER: parties of up to Config.Tower.MaxParty fight one boss per room in their
-- own room space far outside the main map. A run starts at Room 1 or, if the starter picks it,
-- just after the party's lowest common CHECKPOINT (clearing room 5, 10, ... saves one; skipped
-- rooms pay nothing). Each room's boss is scaled to the party's power at room start; rewards
-- (Ectoplasm + Spirit Shards) are credited the moment a boss is beaten and are never taken back.
-- DEV runs (TowerService.DevStart) are solo, start at any room and give no rewards at all.
--
-- Flow (all decided here; clients only ask to start, vote CONTINUE or LEAVE):
--   pad (prompt or "TowerStart"(startRoom)) -> countdown -> party = players on the pad -> room built ->
--   teleport -> FIGHT (RoomSeconds) -> boss killed: rewards + chest -> BETWEEN (vote window)
--   -> next room ... until a timeout, a wipe, no votes, or everyone left.
--
-- Client messages:
--   Fx "Tower" { State = "Pad", EndsAt, Count, Max, StartRoom } / { State = "PadCancel" }
--              { State = "Fight", Room, Uid, Boss, EndsAt, Party, Dev, Earned = { Ecto, Shards } }
--              { State = "Votes", Votes, Party }
--              { State = "Ended", Reason, Best, Earned }
--   Fx "TowerRoomCleared" { Room, EndsAt, Ecto, Shards, Pct, Earned, Party, Pos, Dev, Checkpoint? } (chest visual)
--   Fx "Payout" (the usual share popup, plus Shards)
-- Player attributes while in a run: InTower = true, TowerRoom = n.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local Rules = require(GH.Logic.Rules)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local CrewService = require(script.Parent.CrewService)
local GhostService = require(script.Parent.GhostService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)
local TowerRoom = require(script.Parent.Parent.World.TowerRoom)

local TowerService = {}

local TC = Config.Tower
local TICK = 0.25
local STARTING_LIMIT = 15 -- seconds a run may sit in "Starting" before the watchdog ends it
local SLOT_X, SLOT_Z, SLOT_STEP, SLOTS_PER_ROW = 1400, -600, 300, 4

type Earned = { Ecto: number, Shards: number }
export type Run = {
	Id: number,
	Slot: number,
	Origin: Vector3,
	Members: { [Player]: boolean }, -- GhostService only lets these players target the boss
	Room: number,
	Phase: string, -- "Fight" | "Between" | "Starting" | "Ended"
	Boss: GhostService.Ghost?,
	Claimed: { [number]: boolean }, -- room -> rewards paid (exactly once)
	Votes: { [Player]: boolean },
	Earned: { [Player]: Earned },
	Best: number, -- highest room cleared in this run
	Dealt: { [Player]: boolean }, -- members who damaged at least one boss this run (checkpoint/best progress)
	Model: Model?,
	EndsAt: number,
	Dev: boolean, -- developer test run: no rewards, no checkpoint, no stats
}

local runs: { [number]: Run } = {}
local slots: { [number]: Run } = {}
local memberOf: { [Player]: Run } = {}
local nextId = 1
local roomsFolder: Folder
local padPart: BasePart? = nil

type Lobby = { EndsAt: number, Seen: { [Player]: boolean }, Joined: { [Player]: boolean }, StartRoom: number }
local lobby: Lobby? = nil

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function slotOrigin(slot: number): Vector3
	local i = slot - 1
	return Vector3.new(SLOT_X + (i % SLOTS_PER_ROW) * SLOT_STEP, 0, SLOT_Z - math.floor(i / SLOTS_PER_ROW) * SLOT_STEP)
end

local function freeSlot(): number?
	for i = 1, TC.Slots do
		if not slots[i] then
			return i
		end
	end
	return nil
end

local function memberList(run: Run): { Player }
	local list = {}
	for p in run.Members do
		table.insert(list, p)
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

local function voteCount(run: Run): number
	local n = 0
	for p in run.Votes do
		if run.Members[p] then
			n += 1
		end
	end
	return n
end

local function earnedOf(run: Run, p: Player): Earned
	local e = run.Earned[p]
	if not e then
		e = { Ecto = 0, Shards = 0 }
		run.Earned[p] = e
	end
	return e
end

-- Zeroes velocity and pivots the character; false if there is no live character or it failed.
local function teleport(player: Player, pos: Vector3, facing: Vector3): boolean
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = Remotes.Root(player)
	if not char or not hum or hum.Health <= 0 or not root then
		return false
	end
	local ok = pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		char:PivotTo(CFrame.lookAt(pos, pos + facing))
	end)
	-- fall rescue inside the tower returns here, never to the main map
	player:SetAttribute("TowerSafe", if ok and player:GetAttribute("InTower") then pos else nil)
	return ok
end

local function sendHome(player: Player)
	local a = math.random() * math.pi * 2
	local r = math.random() * 4
	local pos = Config.Layout.Spawn + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	teleport(player, pos, Vector3.new(0, 0, 1))
end

local function clearPlayer(player: Player)
	player:SetAttribute("InTower", nil)
	player:SetAttribute("TowerRoom", nil)
	player:SetAttribute("TowerSafe", nil)
	if player.Parent then
		-- a failed refresh (player half-way out) must not abort the run cleanup that called us
		local ok, err = pcall(function()
			HunterService.Refresh(player)
		end)
		if not ok then
			warn("[Tower] refresh failed: " .. tostring(err))
		end
	end
end

local function sendAll(run: Run, kind: string, make: (Player) -> any)
	for p in run.Members do
		if p.Parent then
			Fx.To(p, kind, make(p))
		end
	end
end

local cleanup: (Run) -> ()

-- Takes one member out of the run (rewards already credited stay). teleportHome=false when the
-- player is gone or already respawned at the spawn.
local function leave(run: Run, player: Player, reason: string, teleportHome: boolean)
	if not run.Members[player] then
		return
	end
	run.Members[player] = nil
	run.Votes[player] = nil
	if memberOf[player] == run then
		memberOf[player] = nil
	end
	if player.Parent then
		clearPlayer(player)
		if teleportHome then
			sendHome(player)
		end
		Fx.To(player, "Tower", { State = "Ended", Reason = reason, Best = run.Best, Earned = earnedOf(run, player) })
	end
	if next(run.Members) == nil then
		cleanup(run)
	elseif run.Phase == "Between" then
		local party = #memberList(run)
		sendAll(run, "Tower", function()
			return { State = "Votes", Votes = voteCount(run), Party = party }
		end)
	end
end

function cleanup(run: Run)
	if run.Phase == "Ended" then
		return
	end
	run.Phase = "Ended"
	-- free the slot first so an error below can never leak it
	if slots[run.Slot] == run then
		slots[run.Slot] = nil
	end
	runs[run.Id] = nil
	for _, p in memberList(run) do
		run.Members[p] = nil
		if memberOf[p] == run then
			memberOf[p] = nil
		end
		if p.Parent then
			clearPlayer(p)
		end
	end
	local g = run.Boss
	run.Boss = nil
	if g and g.Alive then
		local ok, err = pcall(function()
			GhostService.Remove(g, nil, false)
		end)
		if not ok then
			warn("[Tower] boss removal failed: " .. tostring(err))
		end
	end
	local model = run.Model
	run.Model = nil
	if model then
		pcall(function()
			model:Destroy()
		end)
	end
end

-- Ends the run for everyone: each member goes back to the spawn with a message.
local function endRun(run: Run, reason: string)
	if run.Phase == "Ended" then
		return
	end
	for _, p in memberList(run) do
		leave(run, p, reason, true)
	end
	cleanup(run)
end

-- Starts room n: heals crews, moves the party to the entry (rooms after the first), spawns the
-- boss scaled to the party's power right now.
local function startRoom(run: Run, n: number)
	local model = run.Model
	if not model then
		endRun(run, "The tower room vanished...")
		return
	end
	run.Room = n
	run.Votes = {}
	run.Phase = "Starting"
	run.EndsAt = serverNow() + STARTING_LIMIT -- watchdog: tickRun ends a run stuck here
	TowerRoom.SetRoom(model, n)
	local chest = model:FindFirstChild("Chest")
	if chest then
		chest:Destroy()
	end
	local members = memberList(run)
	local entry = TowerRoom.Entry(run.Origin)
	for i, p in members do
		CrewService.HealAll(p)
		p:SetAttribute("TowerRoom", n)
		if n > 1 then
			local pos = entry + Vector3.new((i - (#members + 1) / 2) * 5, 3, 0)
			if not teleport(p, pos, Vector3.new(0, 0, 1)) then
				leave(run, p, "You couldn't follow your party to the next room.", true)
			end
		end
	end
	if run.Phase == "Ended" then
		return
	end
	local power = 0
	for p in run.Members do
		power += HunterService.CrewPower(p)
	end
	power = math.max(1, power)
	local bossHP, hitFrac = Rules.TowerScale(n, TC, power)
	local def = Config.Ghosts[TC.Bosses[(n - 1) % #TC.Bosses + 1]]
	local g = GhostService.Spawn(def, TowerRoom.BossCenter(run.Origin), TowerRoom.BossRadius, {
		Spirit = bossHP,
		Tower = run,
		HitFrac = hitFrac,
	})
	run.Boss = g
	run.EndsAt = serverNow() + TC.RoomSeconds
	g.Model:SetAttribute("EndsAt", run.EndsAt)
	run.Phase = "Fight"
	local party = #memberList(run)
	sendAll(run, "Tower", function(p)
		return { State = "Fight", Room = n, Uid = g.Uid, Boss = def.Name, EndsAt = run.EndsAt, Party = party, Dev = run.Dev, Earned = earnedOf(run, p) }
	end)
end

local function startRoomSafe(run: Run, n: number)
	local ok, err = pcall(function()
		startRoom(run, n)
	end)
	if not ok then
		warn("[Tower] room start failed: " .. tostring(err))
		pcall(endRun, run, "Something went wrong in the tower. Your rewards are safe!")
	end
end

-- Boss beaten: pay every contributor once, open the chest, start the vote window.
local function onCleared(run: Run, g: GhostService.Ghost)
	local room = run.Room
	run.Best = math.max(run.Best, room)
	run.Boss = nil
	local members = memberList(run)
	-- Ecto is paid like farming: by the time the room took, capped by what the same damage earns
	-- on the player's best-zone ghosts (Rules.TowerReward)
	local fightSeconds = math.clamp(TC.RoomSeconds - (run.EndsAt - serverNow()), 0, TC.RoomSeconds)
	-- SHARED POOLS: (reward per member * party size), split by effective damage among the
	-- members still in the run (no damage = no share).
	local split = GhostService.SplitDamage(g)
	local players, weights, total = {}, {}, 0
	for i, p in split.Players do
		if run.Members[p] and not run.Dev then -- dev runs pay nothing
			table.insert(players, p)
			table.insert(weights, split.Weights[i])
			total += split.Weights[i]
		end
	end
	-- pool size counts members who did at least 10% of the damage (idle alts add nothing)
	local _ = members
	local sized = Rules.PoolMembers(weights, 0.1)
	local shardsEach = Rules.TowerReward(room, TC)
	local shardShares = Rules.SplitPool(shardsEach * sized, weights)
	local hpEach = g.Max / sized
	local paid: { [Player]: { Ecto: number, Shards: number, Pct: number } } = {}
	for i, p in players do
		local d = DataService.Get(p)
		if not d or weights[i] <= 0 then
			continue
		end
		run.Dealt[p] = true
		local shards = shardShares[i]
		local zoneMult = PlayerInfo.ZoneMultiplier(p)
		local zone = Config.Zones[math.min(PlayerInfo.BestZone(p), #Config.Zones)]
		local perSpirit = Rules.ZoneEctoPerSpirit(Config.Ghosts, zone.Id) / zoneMult
		local _, ectoEach = Rules.TowerReward(room, TC, fightSeconds, hpEach, perSpirit)
		local base = Rules.SplitPool(ectoEach * sized, weights)[i]
		local ecto = if base > 0 then math.max(1, math.floor(base * zoneMult * PlayerInfo.EctoMultiplier(p) + 0.5)) else 0
		if ecto > 0 then
			DataService.AddEcto(p, ecto)
		end
		d.Shards += shards
		d.TowerShards += shards
		d.TowerRooms += 1
		local e = earnedOf(run, p)
		e.Ecto += ecto
		e.Shards += shards
		local pct = if total > 0 then weights[i] / total else 0
		paid[p] = { Ecto = ecto, Shards = shards, Pct = pct }
		Fx.To(p, "Payout", { Name = g.Def.Name, Pct = pct, Ecto = ecto, Shards = shards })
	end
	local cp = Rules.TowerCheckpoint(room, TC.CheckpointEvery)
	local saved: { [Player]: boolean } = {}
	for _, p in members do
		local d = DataService.Get(p)
		-- no damage dealt this whole run = no checkpoint / best-room progress (no free carries)
		if d and not run.Dev and run.Dealt[p] then
			d.TowerBest = math.max(d.TowerBest, room)
			if cp > d.TowerCheckpoint then
				d.TowerCheckpoint = cp
				saved[p] = true
			end
			DataService.Changed(p)
			DataService.Save(p)
		end
	end

	run.Phase = "Between"
	run.Votes = {}
	run.EndsAt = serverNow() + TC.BetweenRoomsSeconds
	local chestPos = TowerRoom.BossCenter(run.Origin)
	local model = run.Model
	if model then
		local chest = TowerRoom.Chest(model, run.Origin)
		chestPos = chest:GetPivot().Position
		task.delay(0.8, function()
			if chest.Parent then
				TowerRoom.OpenChest(chest)
			end
		end)
	end
	local party = #members
	sendAll(run, "TowerRoomCleared", function(p)
		local got = paid[p]
		return {
			Room = room,
			EndsAt = run.EndsAt,
			Ecto = if got then got.Ecto else 0,
			Shards = if got then got.Shards else 0,
			Pct = if got then got.Pct else 0,
			Earned = earnedOf(run, p),
			Party = party,
			Pos = chestPos,
			Dev = run.Dev,
			Checkpoint = if saved[p] then cp else nil,
		}
	end)
end

local function nextRoom(run: Run)
	if run.Phase ~= "Between" then
		return
	end
	run.Phase = "Starting"
	startRoomSafe(run, run.Room + 1)
end

--==================================================================
-- PARTY PAD
--==================================================================
local function padCenter(): Vector3?
	local pad = padPart
	return if pad and pad.Parent then pad.Position else nil
end

local function padDistance(player: Player): number
	local c = padCenter()
	local root = Remotes.Root(player)
	if not c or not root then
		return math.huge
	end
	local d = root.Position - c
	if math.abs(d.Y) > 10 then
		return math.huge
	end
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

local function onPad(player: Player): boolean
	return padDistance(player) <= TC.PadRadius + 0.5
end

-- Why this player can't join a run right now (nil = they can).
local function blocked(player: Player): string?
	if not DataService.Get(player) then
		return "Loading..."
	end
	if player:GetAttribute("InTower") == true or memberOf[player] then
		return "You're already in the tower!"
	end
	-- lazy require: TradeService loads after TowerService
	if require(script.Parent.TradeService).InTrade(player) then
		return "Finish your trade first!"
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return "Can't enter right now"
	end
	if #HunterService.ActiveUids(player) == 0 then
		return "Your crew is knocked out! Wait until a hunter recovers."
	end
	return nil
end

-- Builds a room and moves the party in, starting at room `first`. Returns an error text when
-- nobody could enter (each player was already told why).
local function startRun(party: { Player }, first: number, dev: boolean): string?
	local slot = freeSlot()
	if not slot then
		for _, p in party do
			Fx.Toast(p, "The tower is full right now. Try again in a moment!", "Bad")
		end
		return "The tower is full right now"
	end
	local origin = slotOrigin(slot)
	local run: Run = {
		Id = nextId,
		Slot = slot,
		Origin = origin,
		Members = {},
		Room = 0,
		Phase = "Starting",
		Boss = nil,
		Claimed = {},
		Votes = {},
		Earned = {},
		Best = 0,
		Dealt = {},
		Model = nil,
		EndsAt = serverNow() + STARTING_LIMIT,
		Dev = dev,
	}
	nextId += 1
	slots[slot] = run
	runs[run.Id] = run
	-- the room exists before anyone is moved there
	local okBuild, model = pcall(TowerRoom.Build, roomsFolder, origin, slot)
	if not okBuild then
		warn("[Tower] room build failed: " .. tostring(model))
		cleanup(run)
		for _, p in party do
			Fx.Toast(p, "The tower door is stuck. Try again!", "Bad")
		end
		return "The tower door is stuck"
	end
	run.Model = model
	local entry = TowerRoom.Entry(origin)
	for i, p in party do
		if blocked(p) ~= nil then
			continue
		end
		p:SetAttribute("InTower", true)
		p:SetAttribute("TowerRoom", first)
		local pos = entry + Vector3.new((i - (#party + 1) / 2) * 5, 3, 0)
		if teleport(p, pos, Vector3.new(0, 0, 1)) then
			run.Members[p] = true
			memberOf[p] = run
			earnedOf(run, p)
			HunterService.Refresh(p)
			local d = DataService.Get(p)
			if d and not dev then
				d.TowerRuns += 1
				DataService.Changed(p)
			end
		else
			clearPlayer(p)
			sendHome(p)
			Fx.Toast(p, "Couldn't enter the tower. Try again!", "Bad")
		end
	end
	if next(run.Members) == nil then
		cleanup(run)
		return "Couldn't enter the tower"
	end
	startRoomSafe(run, first)
	return nil
end

-- Lowest checkpoint every player in the list has reached (0 = someone has none).
local function commonCheckpoint(list: { Player }): number
	local cp = math.huge
	for _, p in list do
		local d = DataService.Get(p)
		cp = math.min(cp, if d then d.TowerCheckpoint else 0)
	end
	return if cp == math.huge then 0 else cp
end

local function runLobby(l: Lobby)
	while serverNow() < l.EndsAt do
		local here = {}
		for _, p in Players:GetPlayers() do
			if onPad(p) and not memberOf[p] and l.Joined[p] then -- only players who chose to enter
				table.insert(here, p)
			end
		end
		for _, p in here do
			Fx.To(p, "Tower", { State = "Pad", EndsAt = l.EndsAt, Count = math.min(#here, TC.MaxParty), Max = TC.MaxParty, StartRoom = l.StartRoom })
			l.Seen[p] = true
		end
		for p in l.Seen do
			if not table.find(here, p) then
				l.Seen[p] = nil
				if p.Parent then
					Fx.To(p, "Tower", { State = "PadCancel" })
				end
			end
		end
		task.wait(0.5)
	end
	lobby = nil
	-- party = eligible players on the pad now, nearest first
	local cands = {}
	for _, p in Players:GetPlayers() do
		if onPad(p) and blocked(p) == nil and l.Joined[p] then
			table.insert(cands, { P = p, D = padDistance(p) })
		end
	end
	table.sort(cands, function(a, b)
		return a.D < b.D
	end)
	local party = {}
	for i, c in cands do
		if i <= TC.MaxParty then
			table.insert(party, c.P)
		end
	end
	for p in l.Seen do
		if p.Parent and not table.find(party, p) then
			Fx.To(p, "Tower", { State = "PadCancel" })
			local why = blocked(p)
			if why then
				Fx.Toast(p, why, "Bad")
			elseif onPad(p) then
				Fx.Toast(p, "The party was full! Try the next run.", "Bad")
			end
		end
	end
	if #party > 0 then
		-- a checkpoint start uses the party's lowest common checkpoint (skipped rooms pay nothing)
		local first = 1
		if l.StartRoom > 1 then
			first = math.min(l.StartRoom, commonCheckpoint(party) + 1)
			if first ~= l.StartRoom then
				for _, p in party do
					Fx.Toast(p, if first > 1
						then string.format("Party starts at Room %d (the lowest checkpoint in the party)", first)
						else "Someone in the party has no checkpoint yet: starting at Room 1", "Bad")
				end
			end
		end
		startRun(party, first, false)
		-- anyone who didn't get in (tower full, door stuck, teleport failed) leaves the pad UI
		for _, p in party do
			if p.Parent and not memberOf[p] then
				Fx.To(p, "Tower", { State = "PadCancel" })
			end
		end
	end
end

-- Pad prompt / "TowerStart"(startRoom): opens the countdown for everyone on the pad.
-- startRoom is 1 or (the starter's checkpoint + 1); anything else is refused.
local function requestStart(player: Player, startRoom: any): any
	local first = if startRoom == nil then 1 else startRoom
	if type(first) ~= "number" or first ~= math.floor(first) then
		return Remotes.Fail("Bad room")
	end
	local why = blocked(player)
	if why then
		return Remotes.Fail(why)
	end
	if not onPad(player) then
		return Remotes.Fail("Stand on the tower pad first!")
	end
	if lobby then
		-- joins the countdown that is already running (its starter already chose the room)
		(lobby :: Lobby).Joined[player] = true
		return { ok = true, EndsAt = (lobby :: Lobby).EndsAt, StartRoom = (lobby :: Lobby).StartRoom }
	end
	if first ~= 1 then
		local d = DataService.Get(player)
		local cp = if d then d.TowerCheckpoint else 0
		if cp <= 0 or first ~= cp + 1 then
			return Remotes.Fail("You can start at Room 1" .. (if cp > 0 then " or Room " .. (cp + 1) else ""))
		end
	end
	if not freeSlot() then
		return Remotes.Fail("The tower is full right now. Try again in a moment!")
	end
	local l: Lobby = { EndsAt = serverNow() + TC.Countdown, Seen = {}, Joined = { [player] = true }, StartRoom = first }
	lobby = l
	task.spawn(function()
		local ok, err = pcall(function()
			runLobby(l)
		end)
		if not ok then
			warn("[Tower] lobby error: " .. tostring(err))
			if lobby == l then
				lobby = nil
			end
		end
	end)
	return { ok = true, EndsAt = l.EndsAt }
end

local function setupPrompt()
	local map = workspace:FindFirstChild("Map")
	local plaza = map and map:FindFirstChild("TowerEntrance") -- lobby, next to the Pet Hatchery
	local pad = plaza and plaza:FindFirstChild("TowerPad")
	if not pad or not pad:IsA("BasePart") then
		warn("[Tower] TowerPad not found; the pad prompt is off (TowerStart still works only on a pad)")
		return
	end
	padPart = pad
	local att = Instance.new("Attachment")
	att.Name = "PromptPoint"
	att.Parent = pad
	att.WorldPosition = pad.Position + Vector3.new(0, 3.5, 0)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TowerPrompt"
	prompt.ActionText = "Enter Boss Tower"
	prompt.ObjectText = "Endless Boss Tower"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = TC.PadRadius + 4
	prompt.RequiresLineOfSight = false
	prompt.Parent = att
	prompt.Triggered:Connect(function(player)
		if not Remotes.Allow(player, "Default") then
			return
		end
		local d = DataService.Get(player)
		if not lobby and d and d.TowerCheckpoint > 0 then
			-- they have a checkpoint: let them pick the start room with the pad buttons
			Fx.Toast(player, "Pick Room 1 or your checkpoint with the buttons below!", "Good")
			return
		end
		local res = requestStart(player, 1)
		if not res.ok and res.err then
			Fx.Toast(player, res.err, "Bad")
		end
	end)
end

--==================================================================
-- LOOP (one for all runs)
--==================================================================
local function tickRun(run: Run, t: number)
	for _, p in memberList(run) do
		if not p.Parent then
			leave(run, p, "", false)
		end
	end
	if next(run.Members) == nil then
		cleanup(run) -- safety: an empty run (e.g. a leave that errored half-way) frees its slot
		return
	end
	if run.Phase == "Starting" then
		-- rooms start synchronously; a run still "Starting" this long hit an error mid-start
		if t >= run.EndsAt then
			endRun(run, "Something went wrong in the tower. Your rewards are safe!")
		end
	elseif run.Phase == "Fight" then
		-- wipe: nobody has a hunter that can fight
		local anyActive = false
		for p in run.Members do
			if #HunterService.ActiveUids(p) > 0 then
				anyActive = true
				break
			end
		end
		local g = run.Boss
		if not anyActive then
			endRun(run, "Your whole crew was knocked out! The run is over (rewards kept).")
		elseif t >= run.EndsAt and g and g.Alive then
			endRun(run, "Time's up! The boss held its room (rewards kept).")
		elseif (not g or not g.Alive) and t >= run.EndsAt + 5 then
			endRun(run, "The run ended.") -- safety: a boss gone without a kill message
		end
	elseif run.Phase == "Between" then
		local party = 0
		for _ in run.Members do
			party += 1
		end
		local votes = voteCount(run)
		if party > 0 and votes >= party then
			nextRoom(run)
		elseif t >= run.EndsAt then
			if votes > 0 then
				nextRoom(run)
			else
				endRun(run, "Nobody chose CONTINUE. Run over: great job!")
			end
		end
	end
end

function TowerService.Init()
	roomsFolder = Instance.new("Folder")
	roomsFolder.Name = "TowerRooms"
	roomsFolder.Parent = workspace

	Remotes.Register("TowerStart", "Default", function(player, startRoom)
		return requestStart(player, startRoom)
	end)

	Remotes.Register("TowerContinue", "Default", function(player)
		local run = memberOf[player]
		if not run or not run.Members[player] then
			return Remotes.Fail("You're not in the tower")
		end
		if run.Phase ~= "Between" then
			return Remotes.Fail("Beat the boss first!")
		end
		run.Votes[player] = true
		local party = #memberList(run)
		local votes = voteCount(run)
		sendAll(run, "Tower", function()
			return { State = "Votes", Votes = votes, Party = party }
		end)
		if votes >= party then
			nextRoom(run)
		end
		return { ok = true }
	end)

	Remotes.Register("TowerLeave", "Default", function(player)
		local run = memberOf[player]
		if not run or not run.Members[player] then
			return Remotes.Fail("You're not in the tower")
		end
		leave(run, player, "You left the tower. Rewards kept!", true)
		return { ok = true }
	end)
end

function TowerService.Start()
	setupPrompt()

	GhostService.Killed:Connect(function(g: GhostService.Ghost, _killer: Player?)
		local tower = g.Tower
		if type(tower) ~= "table" then
			return
		end
		local run = tower :: Run
		if runs[run.Id] ~= run or run.Phase ~= "Fight" or run.Boss ~= g or run.Claimed[run.Room] then
			return
		end
		run.Claimed[run.Room] = true
		local ok, err = pcall(function()
			onCleared(run, g)
		end)
		if not ok then
			warn("[Tower] reward error: " .. tostring(err))
			pcall(endRun, run, "Something went wrong in the tower. Your rewards are safe!")
		end
	end)

	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			-- a respawned character appears at the spawn: that member's run is over
			local run = memberOf[player]
			if run then
				leave(run, player, "You respawned outside the tower. Rewards kept!", false)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local run = memberOf[player]
		if run then
			leave(run, player, "", false)
		end
		memberOf[player] = nil
		if lobby then
			(lobby :: Lobby).Seen[player] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local t = serverNow()
			for _, run in runs do
				local ok, err = pcall(function()
					tickRun(run, t)
				end)
				if not ok then
					warn("[Tower] tick error: " .. tostring(err))
					pcall(endRun, run, "Something went wrong in the tower. Your rewards are safe!")
				end
			end
		end
	end)
end

-- DEV: starts a SOLO test run at `room` (1..MaxScaledRoom) right away. The caller (DevService)
-- already checked dev auth. Dev runs give no Ectoplasm/Shards, no checkpoint and no tower stats.
-- Returns an error text, or nil when the run started.
function TowerService.DevStart(player: Player, room: number): string?
	if type(room) ~= "number" or room ~= room or room ~= math.floor(room) or room < 1 or room > TC.MaxScaledRoom then
		return "Room must be 1-" .. TC.MaxScaledRoom
	end
	local why = blocked(player)
	if why then
		return why
	end
	if lobby then
		(lobby :: Lobby).Joined[player] = nil -- don't also join a pad countdown
	end
	return startRun({ player }, room, true)
end

-- Players in a run (for other systems / debugging).
function TowerService.RunOf(player: Player): Run?
	return memberOf[player]
end

return TowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Player-to-player HUNTER trading (v1.6). Both players must be in the same server.
--
-- Flow: request -> accept -> both sides edit their offer (any change clears BOTH confirmations)
-- -> both CONFIRM -> commit. Either player can cancel before the commit starts. Offered hunters
-- are marked busy (HunterService.SetBusy) so they can't be merged, released or offered elsewhere.
--
-- Durability (separate player saves can't be written together, so we never pretend they are):
--   1. the trade id is added to BOTH players' pending lists (Trades store, key "p_<userId>")
--   2. the full trade record is written once, State = "committed" (key "t_<tradeId>")
--   3. both profiles are changed in memory (one step, no yield) and the id is added to each
--      profile's TradesApplied list, then both are saved
--   4. after both saves, the pending ids are removed
-- If the server crashes or a save fails anywhere after step 2, each player's next join (on any
-- server) finds the id in their pending list, reads the committed record and applies THEIR side
-- unless TradesApplied already has it (DataService load hook). A trade whose record never got
-- written is simply dropped: nothing moved. So a trade is applied exactly once on each side and
-- can never leave only one side transferred.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GH = ReplicatedStorage:WaitForChild("GH")
local Config = require(GH.Config)
local DataService = require(script.Parent.DataService)
local PlayerInfo = require(script.Parent.PlayerInfo)
local HunterService = require(script.Parent.HunterService)
local Remotes = require(script.Parent.Remotes)
local Fx = require(script.Parent.Fx)

local TradeService = {}

type Session = {
	Id: string,
	A: Player,
	B: Player,
	Offer: { [Player]: { string } },
	Confirmed: { [Player]: boolean },
	LastChange: number,
	Committing: boolean,
	Done: boolean,
}
type Record = { Id: string, State: string, A: number, B: number, GiveA: { [string]: any }, GiveB: { [string]: any }, T: number }

local T = Config.Trade
local IS_STUDIO = RunService:IsStudio()
local store: DataStore? = nil
local sessions: { [Player]: Session } = {}
local requests: { [Player]: { From: Player, Expires: number } } = {} -- target -> pending request

local function other(s: Session, p: Player): Player
	return if s.A == p then s.B else s.A
end

local function count(t: { [string]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- What the client shows: both offers (the other side's hunters as {Id, Tier}).
local function push(s: Session)
	for _, p in { s.A, s.B } do
		local o = other(s, p)
		local dOther = DataService.Get(o)
		local theirs = {}
		for _, uid in s.Offer[o] do
			local h = dOther and dOther.Hunters[uid]
			if h then
				table.insert(theirs, { Uid = uid, Id = h.Id, Tier = h.Tier or 0 })
			end
		end
		if p.Parent then
			Fx.To(p, "Trade", {
				State = if s.Done then "Done" elseif s.Committing then "Committing" else "Open",
				Id = s.Id,
				Other = o.DisplayName,
				Mine = s.Offer[p],
				Theirs = theirs,
				MeOk = s.Confirmed[p] == true,
				ThemOk = s.Confirmed[o] == true,
			})
		end
	end
end

local function releaseBusy(s: Session)
	for _, p in { s.A, s.B } do
		for _, uid in s.Offer[p] do
			if HunterService.BusyReason(p, uid) == "In a trade" then
				HunterService.SetBusy(p, uid, nil)
			end
		end
	end
end

local function close(s: Session, reason: string?)
	if sessions[s.A] == s then
		sessions[s.A] = nil
	end
	if sessions[s.B] == s then
		sessions[s.B] = nil
	end
	releaseBusy(s)
	for _, p in { s.A, s.B } do
		if p.Parent then
			Fx.To(p, "Trade", { State = if s.Done then "Done" else "Cancelled", Id = s.Id, Reason = reason })
		end
	end
end

-- Validates one side's offer against the live profile. Returns an error text or nil.
local function checkSide(p: Player, uids: { string }, receive: number): string?
	local d = DataService.Get(p)
	if not d then
		return p.DisplayName .. " is still loading"
	end
	if p:GetAttribute("InTower") then
		return "Can't trade inside the Boss Tower"
	end
	for _, uid in uids do
		local h = d.Hunters[uid]
		if not h then
			return "A hunter in the offer is gone"
		end
		if h.Locked then
			return "Locked hunters can't be traded"
		end
		if (h :: any).Dev then
			return "Dev hunters can't be traded"
		end
		if HunterService.IsKnocked(d, uid) then
			return "Knocked-out hunters can't be traded"
		end
	end
	local total = count(d.Hunters)
	if total - #uids + receive < 1 then
		return p.DisplayName .. " must keep at least one hunter"
	end
	if total - #uids + receive > PlayerInfo.MaxHunters(p) then
		return p.DisplayName .. "'s hunter storage is full"
	end
	return nil
end

-- Applies one side of a committed record to a profile (idempotent via TradesApplied).
local function applySide(d: DataService.Data, rec: Record, userId: number): boolean
	if table.find(d.TradesApplied, rec.Id) then
		return false
	end
	local give: { [string]: any } = if rec.A == userId then rec.GiveA else rec.GiveB
	local get: { [string]: any } = if rec.A == userId then rec.GiveB else rec.GiveA
	for uid in give do
		d.Hunters[uid] = nil
		d.Knocked[uid] = nil
		local i = table.find(d.Equipped, uid)
		if i then
			table.remove(d.Equipped, i)
		end
	end
	-- received hunters never give a release refund (NoRefund): trading them around can't mint Ectoplasm
	for _, h in get do
		if type(h) == "table" and Config.Hunters[h.Id] then
			local uid = DataService.NewUid(d)
			d.Hunters[uid] = { Id = h.Id, Tier = h.Tier, Locked = false, T = os.time() };
			(d.Hunters[uid] :: any).NoRefund = true
			d.Discovered[h.Id] = true
			if type(h.Tier) == "number" and h.Tier > 0 then
				d.Variants[h.Id .. ":" .. h.Tier] = true
			end
		elseif type(h) == "table" and type(h.Id) == "string" then
			-- recovered on a server that doesn't know this hunter yet: park it in Orphans (same shape
			-- DataService uses; restored on a later join once the id exists) instead of losing it
			d.Orphans[DataService.NewUid(d)] = { Id = h.Id, Tier = h.Tier, Locked = false, T = os.time(), NoRefund = true }
		end
	end
	table.insert(d.TradesApplied, rec.Id)
	while #d.TradesApplied > T.AppliedMemory do
		table.remove(d.TradesApplied, 1)
	end
	return true
end

local function editPending(userId: number, id: string, add: boolean): boolean
	local s = store
	if not s then
		return true
	end
	local ok = pcall(function()
		(s :: DataStore):UpdateAsync("p_" .. userId, function(old: any)
			local list = if type(old) == "table" then old else {}
			local i = table.find(list, id)
			if add and not i then
				table.insert(list, id)
			elseif not add and i then
				table.remove(list, i)
			end
			return list
		end)
	end)
	return ok
end

-- Clears this player's pending trade ids once a save that contains them has really landed
-- (while the pending id exists, a later join could re-apply the trade after TradesApplied has
-- forgotten it, so never leave it behind longer than needed). Only for the given live profile;
-- if the player leaves first, the next join's recovery settles the ids.
local function clearWhenSaved(player: Player, data: any, ids: { string })
	if #ids == 0 then
		return
	end
	task.spawn(function()
		DataService.WaitFor(player, 60)
		for _ = 1, 10 do
			if DataService.Get(player) ~= data then
				return
			end
			if DataService.SaveNow(player) then
				-- the trade is in the saved profile now: keep retrying the cleanup (even after
				-- the player leaves) so a stale pending id can't outlive TradesApplied's memory
				local userId = player.UserId
				for _, id in ids do
					local wait = 5
					while not editPending(userId, id, false) do
						task.wait(wait)
						wait = math.min(wait * 2, 300)
					end
				end
				return
			end
			task.wait(30)
		end
	end)
end

-- Writes the committed record once. Returns true if the record is committed in the store
-- (also when an uncertain write is confirmed by reading it back).
local function writeRecord(rec: Record): boolean
	local s = store
	if not s then
		return true -- Studio without the store: nothing is saved anyway
	end
	local ds = s :: DataStore
	local key = "t_" .. rec.Id
	local ok = pcall(function()
		ds:UpdateAsync(key, function(old: any)
			if old ~= nil then
				return nil -- never overwrite (an "aborted" marker stays aborted)
			end
			return rec
		end)
	end)
	local okRead, cur = pcall(function()
		return ds:GetAsync(key)
	end)
	if okRead and type(cur) == "table" then
		return cur.State == "committed"
	end
	if not ok or not okRead then
		-- outcome unknown: make sure it can never become committed later
		pcall(function()
			ds:UpdateAsync(key, function(old: any)
				return if old == nil then { Id = rec.Id, State = "aborted" } else nil
			end)
		end)
		local ok2, cur2 = pcall(function()
			return ds:GetAsync(key)
		end)
		return ok2 and type(cur2) == "table" and cur2.State == "committed"
	end
	return false
end

local function commitInner(s: Session)
	s.Committing = true
	push(s)
	local a, b = s.A, s.B
	local errA = checkSide(a, s.Offer[a], #s.Offer[b])
	local errB = checkSide(b, s.Offer[b], #s.Offer[a])
	if errA or errB then
		s.Committing = false
		s.Confirmed = {}
		push(s)
		for _, p in { a, b } do
			Fx.Toast(p, errA or errB or "Trade failed", "Bad")
		end
		return
	end
	local dA = DataService.Get(a) :: DataService.Data
	local dB = DataService.Get(b) :: DataService.Data
	local function copyGive(d: DataService.Data, uids: { string }): { [string]: any }
		local out = {}
		for _, uid in uids do
			local h = d.Hunters[uid]
			out[uid] = { Id = h.Id, Tier = h.Tier }
		end
		return out
	end
	local rec: Record = {
		Id = s.Id,
		State = "committed",
		A = a.UserId,
		B = b.UserId,
		GiveA = copyGive(dA, s.Offer[a]),
		GiveB = copyGive(dB, s.Offer[b]),
		T = os.time(),
	}
	-- 1 + 2: durable intent, then the committed record
	if not editPending(a.UserId, s.Id, true) or not editPending(b.UserId, s.Id, true) then
		task.spawn(editPending, a.UserId, s.Id, false)
		task.spawn(editPending, b.UserId, s.Id, false)
		s.Committing = false
		close(s, "Couldn't reach the trade server. Nothing was traded.")
		return
	end
	local function abort(reason: string)
		local st = store
		if st then
			pcall(function()
				(st :: DataStore):UpdateAsync("t_" .. rec.Id, function(old: any)
					return if old == nil then { Id = rec.Id, State = "aborted" } else nil
				end)
			end)
		end
		task.spawn(editPending, a.UserId, s.Id, false)
		task.spawn(editPending, b.UserId, s.Id, false)
		s.Committing = false
		close(s, reason)
	end
	-- both profiles must still be saveable (e.g. no lost session lock) before anything commits
	if not DataService.SaveNow(a) or not DataService.SaveNow(b) then
		abort("Couldn't save your progress. Nothing was traded.")
		return
	end
	-- someone left (or started leaving) while the pending ids were written: their next join may
	-- already have read a pending list WITHOUT this id, so the trade must never commit now
	if DataService.Get(a) ~= dA or DataService.Get(b) ~= dB then
		abort("A player left. Nothing was traded.")
		return
	end
	if not writeRecord(rec) then
		task.spawn(editPending, a.UserId, s.Id, false)
		task.spawn(editPending, b.UserId, s.Id, false)
		s.Committing = false
		close(s, "Couldn't save the trade. Nothing was traded.")
		return
	end
	-- 3: both sides in one step (no yield between them)
	applySide(dA, rec, a.UserId)
	applySide(dB, rec, b.UserId)
	s.Done = true
	releaseBusy(s)
	for _, p in { a, b } do
		if p.Parent then
			HunterService.EnsureEquipped(p) -- traded away the whole crew: equip the best left
			HunterService.Refresh(p)
		end
	end
	close(s, nil)
	-- 4: save each side; clear a side's pending id as soon as THAT side's save really landed
	-- (each side recovers on its own, so one failed save must not leave the other id behind)
	clearWhenSaved(a, dA, { s.Id })
	clearWhenSaved(b, dB, { s.Id })
end

-- While a trade commits, both players' inventories are frozen (no crate opens, releases, merges,
-- locks or crew changes), so the checks done at the start still hold when the hunters move.
local function commit(s: Session)
	local why = "Finishing your trade..."
	HunterService.SetFrozen(s.A, why)
	HunterService.SetFrozen(s.B, why)
	local ok, err = pcall(function()
		commitInner(s)
	end)
	HunterService.SetFrozen(s.A, nil)
	HunterService.SetFrozen(s.B, nil)
	if not ok then
		warn("[Trade] commit error: " .. tostring(err))
	end
end

-- Join-time recovery: finish this player's side of any committed trade a crash interrupted.
local function recover(player: Player, d: any)
	local st = store
	if not st then
		return
	end
	local ds = st :: DataStore
	-- reads retry; if a trade's state stays unknown the player is sent back (no data is written):
	-- playing on with hunters they may already have traded away would let them be traded twice
	local function get(key: string): (boolean, any)
		for attempt = 1, 3 do
			local ok, v = pcall(function()
				return ds:GetAsync(key)
			end)
			if ok then
				return true, v
			end
			if attempt < 3 then
				task.wait(attempt)
			end
		end
		return false, nil
	end
	local unsettled = false
	local recovered: { string } = {}
	local ok, list = get("p_" .. player.UserId)
	if not ok then
		unsettled = true
		list = nil
	end
	for _, id in if type(list) == "table" then list else {} do
		if type(id) ~= "string" then
			continue
		end
		if table.find(d.TradesApplied, id) then
			task.spawn(editPending, player.UserId, id, false) -- already applied and saved
			continue
		end
		local okRec, rec = get("t_" .. id)
		if not okRec then
			unsettled = true
		elseif type(rec) == "table" and rec.State == "committed" and (rec.A == player.UserId or rec.B == player.UserId) then
			applySide(d, rec :: any, player.UserId)
			table.insert(recovered, id)
			warn("[Trade] recovered trade " .. id .. " for " .. player.UserId)
		elseif rec == nil then
			-- the record may still be on its way: settle it first. An "aborted" marker is only
			-- written into an EMPTY key, so the trade either committed (apply it) or never will.
			pcall(function()
				ds:UpdateAsync("t_" .. id, function(old: any)
					return if old == nil then { Id = id, State = "aborted" } else nil
				end)
			end)
			local ok2, cur = pcall(function()
				return ds:GetAsync("t_" .. id)
			end)
			if ok2 and type(cur) == "table" and cur.State == "committed" and (cur.A == player.UserId or cur.B == player.UserId) then
				applySide(d, cur :: any, player.UserId)
				table.insert(recovered, id)
			elseif ok2 and type(cur) == "table" and cur.State == "aborted" then
				task.spawn(editPending, player.UserId, id, false)
			else
				unsettled = true -- could still commit on the other server
			end
		elseif type(rec) == "table" and rec.State == "aborted" then
			task.spawn(editPending, player.UserId, id, false) -- never committed: nothing to do
		end
	end
	if unsettled then
		warn("[Trade] couldn't settle pending trades for " .. player.UserId .. "; asking the player to rejoin")
		player:Kick("Couldn't finish loading your trades. Please rejoin in a moment - your progress is safe.")
		return
	end
	-- the recovered ids stay pending until a save that contains them lands
	clearWhenSaved(player, d, recovered)
end

function TradeService.InTrade(player: Player): boolean
	return sessions[player] ~= nil
end

function TradeService.Init()
	if not IS_STUDIO then
		local ok, ds = pcall(function()
			return DataStoreService:GetDataStore(T.DataStoreName)
		end)
		store = if ok then ds else nil
	end
	DataService.AddLoadHook(recover)

	Remotes.Register("TradeRequest", "Default", function(player, targetId)
		if not T.Enabled then
			return Remotes.Fail("Trading is turned off for now")
		end
		local target = if type(targetId) == "number" then Players:GetPlayerByUserId(targetId) else nil
		if not target or target == player then
			return Remotes.Fail("That player isn't here")
		end
		if sessions[player] or sessions[target] then
			return Remotes.Fail("Already trading")
		end
		-- trading happens at the booth only: nobody gets requests while they're off playing
		if not Remotes.Near(player, Config.Layout.TradeBooth, T.BoothRadius) then
			return Remotes.Fail("Go to the TRADING booth in the lobby to trade")
		end
		if not Remotes.Near(target, Config.Layout.TradeBooth, T.BoothRadius) then
			return Remotes.Fail(target.DisplayName .. " isn't at the TRADING booth")
		end
		if not DataService.Get(player) or not DataService.Get(target) then
			return Remotes.Fail("Still loading...")
		end
		if player:GetAttribute("InTower") or target:GetAttribute("InTower") then
			return Remotes.Fail("Can't trade inside the Boss Tower")
		end
		local pending = requests[target]
		if pending and pending.From.Parent and os.clock() < pending.Expires then
			return Remotes.Fail("They already have a trade request")
		end
		requests[target] = { From = player, Expires = os.clock() + T.RequestSeconds }
		Fx.To(target, "TradeRequest", { From = player.DisplayName, FromId = player.UserId, Seconds = T.RequestSeconds })
		return { ok = true }
	end)

	Remotes.Register("TradeRespond", "Default", function(player, fromId, accept)
		if not T.Enabled then
			return Remotes.Fail("Trading is turned off for now")
		end
		if accept == true and not Remotes.Near(player, Config.Layout.TradeBooth, T.BoothRadius) then
			return Remotes.Fail("Go to the TRADING booth in the lobby to trade")
		end
		local req = requests[player]
		requests[player] = nil
		if not req or type(fromId) ~= "number" or req.From.UserId ~= fromId or os.clock() > req.Expires or not req.From.Parent then
			return Remotes.Fail("That request expired")
		end
		if accept ~= true then
			Fx.Toast(req.From, player.DisplayName .. " declined the trade", "Bad")
			return { ok = true }
		end
		if sessions[player] or sessions[req.From] then
			return Remotes.Fail("Already trading")
		end
		local s: Session = {
			Id = HttpService:GenerateGUID(false),
			A = req.From,
			B = player,
			Offer = { [req.From] = {}, [player] = {} },
			Confirmed = {},
			LastChange = os.clock(),
			Committing = false,
			Done = false,
		}
		sessions[req.From] = s
		sessions[player] = s
		push(s)
		return { ok = true }
	end)

	Remotes.Register("TradeOffer", "Inventory", function(player, uids)
		local s = sessions[player]
		if not s or s.Committing then
			return Remotes.Fail("No open trade")
		end
		local d = DataService.Get(player)
		if not d or type(uids) ~= "table" or #uids > T.MaxOffer then
			return Remotes.Fail(string.format("Up to %d hunters per side", T.MaxOffer))
		end
		local clean, seen = {}, {}
		for _, uid in uids do
			if type(uid) ~= "string" or seen[uid] then
				return Remotes.Fail("Bad offer")
			end
			seen[uid] = true
			local h = d.Hunters[uid]
			if not h then
				return Remotes.Fail("You don't own that hunter")
			end
			if h.Locked then
				return Remotes.Fail("Locked hunters can't be traded")
			end
			if (h :: any).Dev then
				return Remotes.Fail("Dev hunters can't be traded")
			end
			if HunterService.IsKnocked(d, uid) then
				return Remotes.Fail("That hunter is recovering")
			end
			local why = HunterService.BusyReason(player, uid)
			if why and not table.find(s.Offer[player], uid) then
				return Remotes.Fail(why)
			end
			table.insert(clean, uid)
		end
		if #clean > T.MaxOffer then
			return Remotes.Fail(string.format("Up to %d hunters per side", T.MaxOffer))
		end
		for _, uid in s.Offer[player] do
			HunterService.SetBusy(player, uid, nil)
		end
		for _, uid in clean do
			HunterService.SetBusy(player, uid, "In a trade")
		end
		s.Offer[player] = clean
		s.Confirmed = {} -- any change resets BOTH confirmations
		s.LastChange = os.clock()
		push(s)
		return { ok = true }
	end)

	Remotes.Register("TradeConfirm", "Default", function(player, tradeId)
		local s = sessions[player]
		if not s or s.Committing or s.Id ~= tradeId then
			return Remotes.Fail("No open trade")
		end
		if os.clock() - s.LastChange < T.ConfirmCooldown then
			return Remotes.Fail("The offer just changed - check it again")
		end
		if #s.Offer[s.A] == 0 and #s.Offer[s.B] == 0 then
			return Remotes.Fail("Add a hunter first")
		end
		s.Confirmed[player] = true
		push(s)
		if s.Confirmed[s.A] and s.Confirmed[s.B] then
			task.spawn(commit, s)
		end
		return { ok = true }
	end)

	Remotes.Register("TradeCancel", "Default", function(player)
		local s = sessions[player]
		if not s then
			return { ok = true }
		end
		if s.Committing then
			return Remotes.Fail("The trade is already finishing")
		end
		close(s, player.DisplayName .. " cancelled the trade")
		return { ok = true }
	end)
end

function TradeService.Start()
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
		local s = sessions[player]
		if s and not s.Committing then
			close(s, player.DisplayName .. " left the game")
		end
	end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Boundary</string>
            <string name="Source"><![CDATA[--!strict
-- Ground slabs (top at Y=0), lobby + themed outer walls, the two zone-separation walls and the
-- invisible collision walls up to Y=80 that keep players inside and in front of locked gates.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Boundary = {}

local C = Color3.fromRGB
local V = Vector3.new
local INVIS_TOP = 80
local HW = Config.Layout.HalfWidth -- 140
local END = Config.Zones[#Config.Zones].MaxZ -- far end of the map
local LOBBY = Config.Layout.Lobby

-- Zone-separation wall look per gate (wall / cap stone / cap ball / painted band).
type WallLook = { Wall: Color3, Cap: Color3, Ball: Color3, Band: Color3, Pumpkins: boolean }
local WALLS: { [string]: WallLook } = {
	Cemetery = { Wall = C(135, 115, 175), Cap = C(185, 170, 220), Ball = C(255, 160, 60), Band = C(150, 255, 120), Pumpkins = true },
	School = { Wall = C(215, 110, 95), Cap = C(250, 230, 210), Ball = C(200, 130, 255), Band = C(200, 120, 255), Pumpkins = true },
	Carnival = { Wall = C(230, 70, 80), Cap = C(255, 240, 215), Ball = C(255, 205, 60), Band = C(70, 140, 255), Pumpkins = false },
	Hospital = { Wall = C(225, 230, 238), Cap = C(150, 200, 235), Ball = C(140, 220, 180), Band = C(110, 190, 255), Pumpkins = false },
	Harbor = { Wall = C(120, 85, 55), Cap = C(70, 110, 150), Ball = C(220, 80, 70), Band = C(60, 200, 200), Pumpkins = false },
	Castle = { Wall = C(140, 140, 155), Cap = C(95, 95, 115), Ball = C(255, 200, 70), Band = C(150, 40, 70), Pumpkins = false },
	SpiritRealm = { Wall = C(60, 50, 95), Cap = C(90, 80, 140), Ball = C(110, 230, 255), Band = C(170, 100, 255), Pumpkins = false },
	Swamp = { Wall = C(90, 110, 70), Cap = C(120, 95, 65), Ball = C(170, 255, 120), Band = C(150, 230, 90), Pumpkins = false },
	Frost = { Wall = C(200, 225, 245), Cap = C(150, 190, 230), Ball = C(170, 240, 255), Band = C(110, 190, 255), Pumpkins = false },
	Tomb = { Wall = C(220, 185, 120), Cap = C(190, 150, 90), Ball = C(70, 200, 220), Band = C(255, 210, 90), Pumpkins = false },
	ToyFactory = { Wall = C(255, 150, 190), Cap = C(255, 225, 90), Ball = C(90, 180, 255), Band = C(150, 90, 230), Pumpkins = false },
	Sunken = { Wall = C(80, 140, 160), Cap = C(200, 190, 150), Ball = C(255, 220, 120), Band = C(90, 255, 230), Pumpkins = false },
	Clockwork = { Wall = C(150, 110, 75), Cap = C(200, 170, 110), Ball = C(230, 200, 120), Band = C(120, 90, 60), Pumpkins = false },
	Inferno = { Wall = C(80, 50, 50), Cap = C(110, 70, 60), Ball = C(255, 150, 60), Band = C(255, 110, 50), Pumpkins = false },
	Throne = { Wall = C(240, 235, 255), Cap = C(200, 180, 240), Ball = C(255, 215, 90), Band = C(150, 100, 230), Pumpkins = false },
}

local invisible: (Instance, Vector3, Vector3) -> ()
function invisible(parent: Instance, a: Vector3, b: Vector3)
	-- Roblox caps a part at 2048 studs per axis: split long walls along Z into pieces
	local lo, hi = a:Min(b), a:Max(b)
	if hi.Z - lo.Z > 1000 then
		local n = math.ceil((hi.Z - lo.Z) / 1000)
		local step = (hi.Z - lo.Z) / n
		for i = 0, n - 1 do
			invisible(parent, Vector3.new(lo.X, lo.Y, lo.Z + i * step), Vector3.new(hi.X, hi.Y, lo.Z + (i + 1) * step))
		end
		return
	end
	local p = Kit.Box(parent, a, b, C(255, 255, 255), { Transp = 1, Solid = true, Name = "InvisibleWall", Shadow = false })
	p.CanQuery = false -- never block taps / ground raycasts
end

local function hedgeRun(f: Instance, a: Vector3, b: Vector3)
	-- a/b: opposite corners of the hedge box (Y 0..14)
	Kit.Box(f, a, b, C(70, 160, 85), { Mat = Enum.Material.Grass, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / 16)
	local greens = { C(80, 175, 90), C(95, 190, 100), C(70, 150, 95) }
	for i = 0, n do
		local t = (i + 0.5) / (n + 1)
		local pos = if alongX
			then V(lo.X + (hi.X - lo.X) * t, hi.Y, (lo.Z + hi.Z) / 2)
			else V((lo.X + hi.X) / 2, hi.Y, lo.Z + (hi.Z - lo.Z) * t)
		Kit.Ball(f, 7.5, pos, Kit.Pick(greens), { Mat = Enum.Material.Grass })
	end
end

local function stoneRun(f: Instance, a: Vector3, b: Vector3, wall: Color3, cap: Color3, topBall: Color3, spacing: number)
	Kit.Box(f, a, b, wall, { Mat = Enum.Material.Cobblestone, Solid = true })
	local lo, hi = a:Min(b), a:Max(b)
	Kit.Box(f, V(lo.X - 0.5, hi.Y, lo.Z - 0.5), V(hi.X + 0.5, hi.Y + 1.2, hi.Z + 0.5), cap, { Mat = Enum.Material.Slate })
	local alongX = (hi.X - lo.X) > (hi.Z - lo.Z)
	local len = if alongX then hi.X - lo.X else hi.Z - lo.Z
	local n = math.floor(len / spacing)
	local ball = Kit.Vivid(topBall)
	for i = 0, n do
		local t = i / math.max(n, 1)
		local cx = if alongX then lo.X + (hi.X - lo.X) * t else (lo.X + hi.X) / 2
		local cz = if alongX then (lo.Z + hi.Z) / 2 else lo.Z + (hi.Z - lo.Z) * t
		local half = if alongX then V(2.5, 0, (hi.Z - lo.Z) / 2 + 1) else V((hi.X - lo.X) / 2 + 1, 0, 2.5)
		Kit.Box(f, V(cx, 0, cz) - half, V(cx, hi.Y + 3, cz) + half, cap, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Ball(f, 2.6, V(cx, hi.Y + 4.3, cz), ball) -- candy-coloured cap ball (solid, not glowing)
	end
end

local function brickRun(f: Instance, a: Vector3, b: Vector3, spacing: number)
	stoneRun(f, a, b, C(215, 110, 95), C(250, 230, 210), C(200, 130, 255), spacing)
end

function Boundary.Build(map: Instance)
	local f = Kit.Folder(map, "Boundary")
	local W = HW + 6 -- outer face of the visible walls

	-- Ground (top surface Y = 0), wider than the play area so the walls sit on grass.
	Kit.Box(f, V(-190, -4, -190), V(190, 0, 260), C(105, 195, 100), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Neighborhood" }) -- lobby too
	Kit.Box(f, V(-190, -4, 260), V(190, 0, 540), C(80, 160, 120), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Cemetery" })
	Kit.Box(f, V(-190, -4, 540), V(190, 0, 880), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_School" })

	-- Neighborhood: side hedges + the lobby's front hedge (open arch at X = 0, built in
	-- Neighborhood.luau, whose pillars fill |X| half..half+8)
	local front = LOBBY.FrontZ
	local eh = LOBBY.EntranceWidth / 2
	hedgeRun(f, V(-W, 0, front - 3), V(-HW, 14, 260))
	hedgeRun(f, V(HW, 0, front - 3), V(W, 14, 260))
	for _, s in { -1, 1 } do
		hedgeRun(f, V(s * (eh + 8), 0, front - 3), V(s * (HW - 0.01), 14, front + 3))
	end
	-- Lobby: hedges on both sides and behind HQ
	local LX1, LX2 = LOBBY.MinX, LOBBY.MaxX -- the left side is wider (Boss Tower entrance)
	hedgeRun(f, V(LX1 - 6, 0, LOBBY.BackZ - 6), V(LX1, 14, front - 3))
	hedgeRun(f, V(LX2, 0, LOBBY.BackZ - 6), V(LX2 + 6, 14, front - 3))
	hedgeRun(f, V(LX1 - 6, 0, LOBBY.BackZ - 6), V(LX2 + 6, 14, LOBBY.BackZ))
	-- Cemetery: mossy stone with mint cap balls
	stoneRun(f, V(-W, 0, 263), V(-HW, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	stoneRun(f, V(HW, 0, 263), V(W, 12, 537), C(120, 110, 150), C(170, 160, 200), C(110, 255, 170), 28)
	-- School: brick with purple tops (sides + far end)
	brickRun(f, V(-W, 0, 543), V(-HW, 14, 877), 30)
	brickRun(f, V(HW, 0, 543), V(W, 14, 877), 30)
	-- Zones 4-8 build their own ground, side walls and outside scenery (see their builders).

	-- Zone separation walls with the gate opening centred on X = 0.
	for id, gate in Kit.Gates(Config.Layout) do
		local z = gate.Z
		local half = gate.Width / 2
		local h = 18
		local look = WALLS[id] or WALLS.School
		for _, s in { -1, 1 } do
			stoneRun(f, V(s * (half + 8), 0, z - 3), V(s * W, h, z + 3), look.Wall, look.Cap, look.Ball, 24)
		end
		-- painted band along the wall faces
		local band = Kit.Vivid(look.Band)
		for _, s in { -1, 1 } do
			for _, fz in { -1, 1 } do
				Kit.Box(f, V(s * (half + 6), 3, z + fz * 3.05), V(s * (W - 1), 3.6, z + fz * 3.25), band)
			end
			invisible(f, V(s * half, 0, z - 3), V(s * W, INVIS_TOP, z + 3))
		end
		-- above the arch beam (beam fills Y 30..36 of the opening)
		invisible(f, V(-half, 36, z - 3), V(half, INVIS_TOP, z + 3))
		-- pumpkins along the wall top on the approach side (the spooky-town zones only)
		for i = 1, if look.Pumpkins then 4 else 0 do
			for _, s in { -1, 1 } do
				local x = s * (half + 12 + i * 26)
				Props.Pumpkin(f, V(x, h + 1.2, z - 1.5), 3.6, 0, -1)
			end
		end
	end

	-- Invisible outer walls (play area is |X| <= 140, Z front..END, plus the lobby)
	invisible(f, V(-W, 0, front - 3), V(-HW, INVIS_TOP, END + 6))
	invisible(f, V(HW, 0, front - 3), V(W, INVIS_TOP, END + 6))
	invisible(f, V(-W, 0, END), V(W, INVIS_TOP, END + 6))
	for _, s in { -1, 1 } do
		invisible(f, V(s * eh, 0, front - 3), V(s * W, INVIS_TOP, front + 3))
		local lx = if s < 0 then LX1 else LX2
		invisible(f, V(lx, 0, LOBBY.BackZ - 6), V(lx + s * 6, INVIS_TOP, front - 3))
	end
	invisible(f, V(-eh, 30, front - 3), V(eh, INVIS_TOP, front + 3)) -- above the arch beam
	invisible(f, V(LX1 - 6, 0, LOBBY.BackZ - 6), V(LX2 + 6, INVIS_TOP, LOBBY.BackZ))

	-- Outer scenery: soft purple hills and big trees just beyond the walls.
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i = 0, 9 do -- zones 1-3 (Z < 880)
		local z = -40 + i * 95
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 185, -12, z + s * 20), Kit.Pick(hill), { Mat = Enum.Material.Grass })
		end
	end
	for i = 0, 6 do
		local z = -30 + i * 140
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 156, 0, z), 22 + Kit.Rng:NextNumber(0, 10))
		end
	end
	-- outside the lobby hedges: a few big trees on the grass either side
	-- (fixed sizes: no Kit.Rng here, so the other zones' random props don't shift)
	-- (offsets are measured from each side's hedge, so the wider left side keeps them outside)
	for i, p in { { 28, -70 }, { 58, -112 }, { 20, -122 }, { 64, -62 } } do
		Props.Tree(f, V(LX2 + p[1], 0, p[2]), 18 + (i % 3) * 3)
		Props.Tree(f, V(LX1 - math.min(p[1], 40), 0, p[2]), 18 + (i % 3) * 3)
	end
end

return Boundary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GHOST HUNTER SIMULATOR: procedural world builder. Call Builder.Build() once at server start.

	Layout (studs, +Z forward; ground top is Y = 0 everywhere walkable; play area |X| <= 140):

	  LOBBY (Config.Layout.Lobby: X -96..64, Z -130..-37, hedges all round, no ghosts)
	  Z -130 ....... hedge wall behind the lobby
	  Z -130..-106   Ghost Hunter HQ building (behind spawn); Pet Hatchery (left) and the
	                 Merge + Trading kiosks (right) in the pockets between HQ and the plaza
	  X -96..-50     Boss Tower entrance (TowerEntrance.luau) left of the hatchery: tower,
	                 party pad at Config.Layout.TowerEntrance.Pad, "BOSS TOWER" arch
	  Z  -70         Spawn plaza (SpawnLocation at Config.Layout.Spawn, faces +Z); TOP GHOST
	                 HUNTERS + TOP POWER boards on its right
	  Z  -37         Lobby hedge wall with the free "THE NEIGHBORHOOD" arch (X -17..17)
	  Z   -6         Beginner crate station (X -28, beacon) | Upgrade booth (X +28)
	  Z -37..260     ZONE 1 NEIGHBORHOOD: main road X -10..10 up to the gate, cross street
	                 Z 110..124 across the zone (X -136..136); houses on a 30-stud grid
	                 wherever ghost areas / roads / stations leave room.
	  Z 260          Stone wall + Gate_Cemetery (34-wide opening at X = 0)
	  Z 260..540     ZONE 2 CEMETERY: cobble path X -8..8, Haunted station (X -28, Z 292),
	                 giant mausoleum (X -122..-78, Z 477..513, spire to Y ~66), crypts, graves.
	  Z 540          Brick wall + Gate_School
	  Z 540..600     School courtyard: Elite station (X -28, Z 572), ghost bus, flagpole.
	  Z 600..860     ZONE 3 SCHOOL building (open-topped, see School.luau), clock tower to Y ~104.
	  Z 880          Gate_Carnival
	  Z 880..1220    ZONE 4 ABANDONED CARNIVAL (Carnival.luau)
	  Z 1220..1560   ZONE 5 HAUNTED HOSPITAL (Hospital.luau)
	  Z 1560..1920   ZONE 6 GHOST SHIP HARBOR (Harbor.luau)
	  Z 1920..2280   ZONE 7 CURSED CASTLE (Castle.luau)
	  Z 2280..2680   ZONE 8 SPIRIT REALM (SpiritRealm.luau)
	  Z 2680..5560   ZONES 9-16, 360 each: Swamp, Frost, Tomb, ToyFactory, Sunken, Clockwork,
	                 Inferno, Throne (one file each); far wall at the last zone's MaxZ.
	  Every zone from the Cemetery on: gate wall at its MinZ (Boundary + Gates), crate station at
	  (-28, MinZ + 32), Fast Travel arrival pad at Config.Layout.ZoneSpawns (kept free), main path
	  along X = 0 to the next gate.

	Every ghost area circle from Config.Layout.GhostAreas is registered as a keep-out, so no
	prop taller than ~0.3 studs is placed inside one (flat road paint / cracks / rune lines only).
	Instance tree:
	  workspace.Map.{Boundary, Gates, Stations, TowerEntrance, Neighborhood, Cemetery, School, Carnival,
	                 Hospital, Harbor, Castle, SpiritRealm}
]]

local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Kit = require(script.Parent.Kit)
local LightingSetup = require(script.Parent.Lighting)
local Boundary = require(script.Parent.Boundary)
local Gates = require(script.Parent.Gates)
local Stations = require(script.Parent.Stations)
local Leaderboard = require(script.Parent.Leaderboard)
local TowerEntrance = require(script.Parent.TowerEntrance)
local Neighborhood = require(script.Parent.Neighborhood)
local Cemetery = require(script.Parent.Cemetery)
local School = require(script.Parent.School)
local Carnival = require(script.Parent.Carnival)
local Hospital = require(script.Parent.Hospital)
local Harbor = require(script.Parent.Harbor)
local Castle = require(script.Parent.Castle)
local SpiritRealm = require(script.Parent.SpiritRealm)
local Swamp = require(script.Parent.Swamp)
local Frost = require(script.Parent.Frost)
local Tomb = require(script.Parent.Tomb)
local ToyFactory = require(script.Parent.ToyFactory)
local Sunken = require(script.Parent.Sunken)
local Clockwork = require(script.Parent.Clockwork)
local Inferno = require(script.Parent.Inferno)
local Throne = require(script.Parent.Throne)
local Hatchery = require(script.Parent.Hatchery)

local Builder = {}

local function registerKeepOuts()
	for _, area in Config.Layout.GhostAreas do
		Kit.AddCircle(area.Center.X, area.Center.Z, area.Radius + 1)
	end
	local spawnPos = Config.Layout.Spawn
	Kit.AddCircle(spawnPos.X, spawnPos.Z, 27)
	for _, gate in Kit.Gates(Config.Layout) do
		Kit.AddRect(-30, gate.Z - 24, 30, gate.Z + 24)
	end
	-- Fast Travel arrival pads
	for _, p in Kit.ZoneSpawns(Config.Layout) do
		Kit.AddCircle(p.X, p.Z, 9)
	end
	-- main path along X = 0 through zones 4-8 (zones 1-3 register their own roads)
	Kit.AddRect(-10, 880, 10, Config.Zones[#Config.Zones].MaxZ, true)
	-- the whole lobby plus its front hedge wall: nothing random grows in there
	local lobby = Config.Layout.Lobby
	Kit.AddRect(lobby.MinX - 6, lobby.BackZ - 6, lobby.MaxX + 6, lobby.FrontZ + 3)
	Kit.AddRect(-146, lobby.FrontZ - 3, 146, lobby.FrontZ + 5)
	-- pockets behind the plaza: Pet Hatchery on the left (Hatchery.luau), the Merge + Trading
	-- kiosks on the right (Neighborhood.luau)
	local sz = spawnPos.Z
	Kit.AddRect(-40, sz - 38, -12, sz - 8)
	Kit.AddRect(14, sz - 36, 36, sz - 12)
end

-- Last resort when the build throws: a plain anchored floor under the whole main strip and a
-- SpawnLocation at Config.Layout.Spawn, so players never spawn into (or fall through) nothing.
local function emergencyGround()
	if Workspace:FindFirstChild("EmergencyGround") then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "EmergencyGround"
	local maxZ = 5600
	local okZones, lastZone = pcall(function()
		return Config.Zones[#Config.Zones].MaxZ
	end)
	if okZones and type(lastZone) == "number" then
		maxZ = lastZone + 40
	end
	-- parts are capped at 2048 studs per axis, so tile the strip along Z
	local z = -200
	while z < maxZ do
		local len = math.min(2000, maxZ - z)
		local plate = Instance.new("Part")
		plate.Name = "EmergencyFloor"
		plate.Anchored = true
		plate.CanCollide = true
		plate.Size = Vector3.new(320, 4, len)
		-- top at Y = -0.05: just under the normal ground top (no z-fighting if part of the map exists)
		plate.CFrame = CFrame.new(0, -2.05, z + len / 2)
		plate.Color = Color3.fromRGB(90, 140, 80)
		plate.Material = Enum.Material.Grass
		plate.TopSurface = Enum.SurfaceType.Smooth
		plate.BottomSurface = Enum.SurfaceType.Smooth
		plate.Parent = f
		z += len
	end
	local spawnPos = Config.Layout.Spawn
	local sp = Instance.new("SpawnLocation")
	sp.Name = "EmergencySpawn"
	sp.Anchored = true
	sp.Neutral = true
	sp.Duration = 0
	sp.Size = Vector3.new(14, 1, 14)
	sp.CFrame = CFrame.new(spawnPos.X, 0.5, spawnPos.Z) * CFrame.Angles(0, math.pi, 0)
	sp.Color = Color3.fromRGB(130, 70, 220)
	sp.TopSurface = Enum.SurfaceType.Smooth
	sp.Parent = f
	f.Parent = Workspace
	warn("[GH World] build failed: emergency ground + spawn created")
end

local function buildAll(map: Folder)
	Kit.Reset()
	registerKeepOuts()

	LightingSetup.Apply()
	Boundary.Build(map)
	Gates.Build(map)
	Stations.Build(map)
	Leaderboard.Build(map)
	TowerEntrance.Build(map)
	Neighborhood.Build(map)
	Cemetery.Build(map)
	School.Build(map)
	Carnival.Build(map)
	Hospital.Build(map)
	Harbor.Build(map)
	Castle.Build(map)
	SpiritRealm.Build(map)
	Swamp.Build(map)
	Frost.Build(map)
	Tomb.Build(map)
	ToyFactory.Build(map)
	Sunken.Build(map)
	Clockwork.Build(map)
	Inferno.Build(map)
	Throne.Build(map)
	Hatchery.Build(map) -- last: uses no Kit.Rng, so other zones' random props don't shift

	map.Parent = Workspace
	local s = Kit.Stats
	print(string.format("[GH World] built %d parts (%d neon), %d lights, %d emitters, %d floating, %d flicker", s.Parts, s.Neon, s.Lights, s.Emitters, s.Floating, s.Flicker))
end

function Builder.Build()
	local old = Workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local map: Folder = Instance.new("Folder")
	map.Name = "Map"
	local ok, err = pcall(function()
		buildAll(map)
	end)
	if not ok then
		-- keep whatever did get built, add a safety floor, then let Main log the error
		map.Parent = Workspace
		emergencyGround()
		error(err, 0)
	end
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Carnival</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 4: Abandoned Carnival (Z 880..1220). Bright, candy-striped and only a little spooky.
--   Ground + boardwalk midway along X = 0 (flat paint), painted sawdust rings on the ghost areas
--   ((0,965) r30, (-82,1000) r24, (75,1055) r26, (-62,1115) r24, boss ring (0,1165) r22).
--   Entrance arch at Z 926 (pillars X ±13..19, beam Y 30..38) with two ticket booths.
--   Game stalls along the east side (X 52, Z 948..1006) and one west (X -48, Z 1062),
--   popcorn cart, balloon cart, high striker, prize booth with giant plushies (X ~-96, Z 1058).
--   String lights over the midway between the first ghost area and the boss ring (Z 1005..1130).
--   Landmarks seen from the School: ferris wheel (100, 1182, top ~Y 82), big top (-100, 1180,
--   top ~Y 52) and the carousel (78, 1125).
--   Side walls: red/cream board fence along X ±140..146 with blue posts; outside: hills, a
--   wooden roller coaster and two far tents.
-- Glow is kept to a few bulbs (arch, wheel, carousel, string lights), two lanterns, the striker
-- bell and small purple ectoplasm puddles; everything else is painted wood, fabric and plastic.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Carnival = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.WoodPlanks
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal

local MIN_Z, MAX_Z = 880, 1220
local RED = C(225, 60, 70)
local CREAM = C(255, 240, 215)
local YELLOW = C(255, 205, 60)
local BLUE = C(70, 140, 235)
local PURPLE = C(165, 100, 235)
local PINK = C(255, 140, 190)
local MINT = C(120, 220, 150)
local DARK = C(60, 35, 90)
local ECTO = C(200, 130, 255)
local BULB = C(255, 225, 130)
local WOODC = C(190, 135, 90)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

-- Straight bar between two points in the X/Y plane (wheel rims, spokes, legs).
local function bar(parent: Instance, a: Vector3, b: Vector3, w: number, color: Color3, opts: Kit.Opts?): Part
	local mid = (a + b) / 2
	return Kit.Part(parent, V(w, w, (b - a).Magnitude), CFrame.lookAt(mid, b, V(0, 0, 1)), color, opts)
end

local function glowOpts(glow: boolean): Kit.Opts?
	return if glow then { Mat = NEON } else nil
end

--==================================================================
-- GROUND, WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	-- Same grass as the School slab, which also covers Z 880..920 (no colour flicker there).
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(115, 195, 110), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Carnival" })
	-- boardwalk midway with red edges (flat paint)
	Kit.Box(f, V(-9, 0, MIN_Z), V(9, 0.05, MAX_Z), C(220, 170, 120), { Mat = WOOD, Name = "Midway" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, MIN_Z), V(s * 10, 0.06, MAX_Z), Kit.Vivid(RED))
	end
	-- sawdust rings on the ghost areas (flat; ghosts float above them)
	local sawdust = C(240, 215, 165)
	Kit.Disc(f, 0, 965, 0.08, 63, 0.04, Kit.Vivid(YELLOW))
	Kit.Disc(f, 0, 965, 0.1, 58, 0.04, sawdust)
	Kit.Disc(f, -82, 1000, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -82, 1000, 0.1, 47, 0.04, sawdust)
	Kit.Disc(f, 75, 1055, 0.08, 55, 0.04, Kit.Vivid(PURPLE))
	Kit.Disc(f, 75, 1055, 0.1, 51, 0.04, sawdust)
	Kit.Disc(f, -62, 1115, 0.08, 51, 0.04, Kit.Vivid(BLUE))
	Kit.Disc(f, -62, 1115, 0.1, 47, 0.04, sawdust)
	-- boss: circus ring
	Kit.Disc(f, 0, 1165, 0.08, 47, 0.04, Kit.Vivid(RED))
	Kit.Disc(f, 0, 1165, 0.1, 42, 0.04, CREAM)
	Kit.Disc(f, 0, 1165, 0.12, 14, 0.04, Kit.Vivid(YELLOW))
	-- small purple ectoplasm puddles (flat neon accents)
	for _, p in { V(12, 0, 975), V(-75, 0, 1010), V(82, 0, 1046), V(-55, 0, 1122), V(-9, 0, 1172) } do
		Kit.Disc(f, p.X, p.Z, 0.16, 5, 0.04, ECTO, { Mat = NEON, Transp = 0.2 })
	end
end

local function sideWalls(f: Instance)
	-- red/cream board fence, leaving Z MinZ..MinZ+3 and MaxZ-3..MaxZ for the gate walls
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	local n = 16
	local step = (z1 - z0) / n
	local post = Kit.Vivid(BLUE)
	local ball = Kit.Vivid(YELLOW)
	for _, s in { -1, 1 } do
		for i = 0, n - 1 do
			local a = z0 + i * step
			Kit.Box(f, V(s * 140, 0, a), V(s * 146, 12, a + step), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = WOOD, Solid = true })
		end
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13, z1), ball, { Mat = WOOD })
		for i = 2, n - 2, 2 do
			local z = z0 + i * step
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), post, SOLID)
			Kit.Ball(f, 4, V(s * 143, 17, z), ball)
		end
	end
end

-- Round tent: fabric drum + stacked striped tiers + flag. Door faces the midway.
local function tent(f: Instance, x: number, z: number, d: number, c1: Color3, c2: Color3)
	local m = Kit.Model(f, "Tent")
	local fx = if x > 0 then -1 else 1
	Kit.Cyl(m, 8, d, CFrame.new(x, 4, z), c2, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Part(m, V(1.6, 7, d * 0.3), CFrame.new(x + fx * (d / 2 - 0.6), 3.5, z), DARK)
	local sizes = { 1.12, 0.86, 0.6, 0.34 }
	for i, k in sizes do
		Kit.Disc(m, x, z, 8 + i * 2.2, d * k, 2.2, if i % 2 == 1 then c1 else c2, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 3, 0.4, CFrame.new(x, 18.3, z), CREAM)
	Kit.Ball(m, 1.3, V(x, 20, z), Kit.Vivid(YELLOW))
	Kit.Box(m, V(x - 0.1, 18.4, z), V(x + 0.1, 19.8, z + 2.4), c1)
	Kit.AddCircle(x, z, d / 2 + 1.5)
end

local function outside(f: Instance)
	local hill = { C(120, 90, 190), C(100, 150, 120), C(150, 100, 200) }
	for i, z in { 935, 1050, 1165 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 188, -14, z + s * 12), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- wooden roller coaster beyond the east wall
	local heights = { 12, 26, 34, 22, 14, 28, 20, 12 }
	local prev: Vector3? = nil
	for i, h in heights do
		local z = 975 + (i - 1) * 22
		Kit.Box(f, V(171.4, 0, z - 0.6), V(172.6, h, z + 0.6), CREAM, { Mat = WOOD })
		local top = V(172, h + 0.4, z)
		if prev then
			Props.Beam(f, prev, top, 2.6, 0.8, Kit.Vivid(RED))
		end
		prev = top
	end
	-- far tents beyond the west wall
	tent(f, -170, 990, 22, Kit.Vivid(RED), CREAM)
	tent(f, -172, 1105, 20, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	for _, z in { 905, 1205 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 22 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
end

--==================================================================
-- ENTRANCE
--==================================================================
local function entranceArch(f: Instance)
	local m = Kit.Model(f, "CarnivalArch")
	local z = 926
	for _, s in { -1, 1 } do
		for i = 0, 5 do
			Kit.Box(m, V(s * 13, i * 6, z - 3), V(s * 19, i * 6 + 6, z + 3), if i % 2 == 0 then Kit.Vivid(RED) else CREAM, SOLID)
		end
		Kit.Box(m, V(s * 12.4, 0, z - 3.6), V(s * 19.6, 2.5, z + 3.6), Kit.Vivid(BLUE), SOLID)
		Kit.Cyl(m, 4, 8, CFrame.new(s * 16, 40, z), Kit.Vivid(YELLOW))
		Kit.Ball(m, 4.5, V(s * 16, 44, z), Kit.Vivid(RED))
		Kit.AddRect(s * 12, z - 4, s * 20.5, z + 4)
	end
	-- beam (bottom Y 30) + round crest
	Kit.Box(m, V(-22, 30, z - 3.5), V(22, 38, z + 3.5), Kit.Vivid(BLUE), SOLID)
	Kit.CylFlat(m, 3, 20, V(0, 40, z), "Z", Kit.Vivid(YELLOW))
	Kit.Ball(m, 4, V(0, 52, z), Kit.Vivid(RED))
	local sign = Kit.Part(m, V(38, 6, 0.4), CFrame.new(0, 34, z - 3.75), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎪 SPOOKY CARNIVAL 🎪", Kit.Vivid(YELLOW))
	local back = Kit.Part(m, V(30, 4.4, 0.4), CFrame.new(0, 34, z + 3.75) * CFrame.Angles(0, math.pi, 0), DARK)
	Kit.Sign(back, Enum.NormalId.Front, "COME BACK SOON... 👻", CREAM)
	-- bulbs under the beam (every other one glows)
	for i = 0, 8 do
		local glow = i % 2 == 0
		local b = Kit.Ball(m, 1.6, V(-18 + i * 4.5, 29.6, z - 3.6), if glow then BULB else Kit.Vivid(RED), glowOpts(glow))
		if i == 4 then
			Kit.Light(b, C(255, 210, 140), 26, 1.4)
		end
	end
	-- giant "ADMIT ONE" ticket by the gate
	local t = Kit.Part(m, V(12, 5, 0.6), CFrame.new(-62, 3.2, 905) * CFrame.Angles(0, 0.3, 0.1), Kit.Vivid(YELLOW))
	Kit.Sign(t, Enum.NormalId.Front, "ADMIT ONE\n👻 BOO 👻", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-62.5, 0, 904.5), V(-61.5, 1, 905.5), WOODC)
	Kit.AddCircle(-62, 905, 7)
end

local function ticketBooth(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TicketBooth")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	Kit.Part(m, V(7, 8, 6), base * CFrame.new(0, 4, 0), Kit.Vivid(RED), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(m, V(7.4, 1, 6.4), base * CFrame.new(0, 1.5, 0), CREAM)
	Kit.Part(m, V(4.4, 3, 0.3), base * CFrame.new(0, 5, -3.05), C(255, 235, 175))
	Kit.Part(m, V(5.6, 0.5, 1.4), base * CFrame.new(0, 3.3, -3.5), CREAM)
	local sign = Kit.Part(m, V(6.6, 1.5, 0.4), base * CFrame.new(0, 7.3, -3.15), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, "🎟️ TICKETS", Kit.Vivid(YELLOW))
	Kit.Part(m, V(8.4, 1, 7.4), base * CFrame.new(0, 8.5, 0), Kit.Vivid(YELLOW))
	Kit.Cyl(m, 1.6, 7, CFrame.new(x, 9.8, z), Kit.Vivid(RED))
	Kit.Cyl(m, 1.6, 5, CFrame.new(x, 11.4, z), CREAM)
	Kit.Cyl(m, 1.6, 3, CFrame.new(x, 13, z), Kit.Vivid(RED))
	Kit.Ball(m, 1.4, V(x, 14.4, z), Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 6)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ferrisWheel(f: Instance)
	local m = Kit.Model(f, "FerrisWheel")
	local cx, cy, cz = 100, 47, 1182
	local R, N = 34, 20
	Kit.Box(m, V(70, 0, 1170), V(130, 1, 1194), WOODC, { Mat = WOOD, Solid = true })
	local function rim(a: number, dz: number): Vector3
		return V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz + dz)
	end
	local rimCol = Kit.Vivid(RED)
	for _, dz in { -3, 3 } do
		for i = 0, N - 1 do
			bar(m, rim(i / N * math.pi * 2, dz), rim((i + 1) / N * math.pi * 2, dz), 1.2, rimCol, { Mat = METAL })
		end
		for i = 0, 4 do
			local a = i / 5 * math.pi
			bar(m, rim(a, dz), rim(a + math.pi, dz), 0.7, CREAM)
		end
	end
	local hub = Kit.CylFlat(m, 9, 5, V(cx, cy, cz), "Z", Kit.Vivid(YELLOW))
	Kit.CylFlat(m, 10, 2, V(cx, cy, cz), "Z", Kit.Vivid(PURPLE))
	Kit.Light(hub, C(255, 200, 150), 34, 1.3)
	-- A-frame legs + braces
	local leg = C(240, 240, 250)
	for _, dz in { -6, 6 } do
		for _, sx in { -1, 1 } do
			bar(m, V(cx + sx * 22, 1, cz + dz), V(cx, cy, cz + dz * 0.6), 1.6, leg, { Mat = METAL, Solid = true })
		end
		Kit.Box(m, V(cx - 15, 15.5, cz + dz * 0.87 - 0.5), V(cx + 15, 16.5, cz + dz * 0.87 + 0.5), Kit.Vivid(BLUE))
	end
	-- gondolas hang from the spoke ends
	local cabs = { Kit.Vivid(BLUE), Kit.Vivid(YELLOW), Kit.Vivid(MINT), Kit.Vivid(PURPLE), Kit.Vivid(PINK) }
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local p = V(cx + math.cos(a) * R, cy + math.sin(a) * R, cz)
		Kit.CylFlat(m, 6.4, 0.6, p, "Z", C(200, 200, 215))
		Kit.Box(m, p + V(-0.2, -3, -0.2), p + V(0.2, 0, 0.2), C(200, 200, 215))
		Kit.Box(m, p + V(-2.6, -7.2, -2.2), p + V(2.6, -3, 2.2), cabs[i % #cabs + 1], { Shadow = true })
		Kit.Disc(m, p.X, p.Z, p.Y - 2.2, 6.2, 0.8, CREAM)
	end
	-- bulbs between the gondolas on the front rim (half glow)
	for i = 0, 9 do
		local glow = i % 2 == 0
		Kit.Ball(m, 1.8, rim((i + 0.5) / 10 * math.pi * 2, -3.8), if glow then BULB else Kit.Vivid(YELLOW), glowOpts(glow))
	end
	Props.SignBoard(m, V(cx, 6, 1167.5), 16, 3, 0, -1, "🎡 BOO-RIS WHEEL", DARK, Kit.Vivid(YELLOW), RED)
	for _, sx in { -7, 7 } do
		Kit.Box(m, V(cx + sx - 0.4, 0, 1167.4), V(cx + sx + 0.4, 4.5, 1168.2), CREAM)
	end
	Kit.AddRect(66, 1163, 136, 1197)
end

local function carousel(f: Instance)
	local m = Kit.Model(f, "Carousel")
	local cx, cz = 78, 1125
	Kit.Disc(m, cx, cz, 0.6, 32, 0.6, Kit.Vivid(RED), { Solid = true })
	Kit.Disc(m, cx, cz, 1.2, 29, 0.6, CREAM, { Mat = WOOD, Solid = true })
	local column = Kit.Cyl(m, 13, 5, CFrame.new(cx, 7.7, cz), Kit.Vivid(YELLOW), SOLID)
	Kit.Light(column, C(255, 215, 150), 24, 1.2)
	local horses = { CREAM, Kit.Vivid(PINK), Kit.Vivid(C(150, 200, 255)), Kit.Vivid(MINT) }
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local px, pz = cx + math.cos(a) * 10, cz + math.sin(a) * 10
		Kit.Cyl(m, 13, 0.5, CFrame.new(px, 7.7, pz), C(255, 215, 120), { Mat = METAL })
		local base = faced(V(px, 5 + (i % 2) * 1.5, pz), -math.sin(a), math.cos(a))
		local col = horses[i % #horses + 1]
		Kit.Part(m, V(1.6, 1.8, 4.2), base, col)
		Kit.Part(m, V(1.3, 2.6, 1.5), base * CFrame.new(0, 1.6, -2) * CFrame.Angles(0.35, 0, 0), col)
		Kit.Part(m, V(1.2, 2.2, 3.4), base * CFrame.new(0, -1.9, 0), col:Lerp(C(0, 0, 0), 0.15))
	end
	-- striped roof: valance + 12 wedge panels
	Kit.Cyl(m, 2, 32, CFrame.new(cx, 15, cz), CREAM, { Mat = FABRIC })
	local L, h = 16, 7
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		local dx, dz = math.cos(a), math.sin(a)
		local cf = CFrame.new(cx + dx * L / 2, 16 + h / 2, cz + dz * L / 2) * CFrame.Angles(0, Kit.FaceYaw(dx, dz), 0)
		Kit.Wedge(m, V(8.8, h, L), cf, if i % 2 == 0 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 2, 3, CFrame.new(cx, 24, cz), Kit.Vivid(YELLOW))
	Kit.Ball(m, 2.6, V(cx, 26, cz), Kit.Vivid(BLUE))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local glow = i % 2 == 0
		Kit.Ball(m, 1.3, V(cx + math.cos(a) * 16.2, 15, cz + math.sin(a) * 16.2), if glow then BULB else Kit.Vivid(BLUE), glowOpts(glow))
	end
	Props.SignBoard(m, V(58.5, 7, cz), 12, 2.6, -1, 0, "🎠 MERRY-GO-BOO", DARK, Kit.Vivid(YELLOW), BLUE)
	for _, dz in { -5, 5 } do
		Kit.Box(m, V(58.2, 0, cz + dz - 0.4), V(59, 5.7, cz + dz + 0.4), CREAM)
	end
	Kit.AddCircle(cx, cz, 17)
	Kit.AddCircle(58.5, cz, 7)
end

local function bigTop(f: Instance)
	local m = Kit.Model(f, "BigTop")
	local cx, cz = -100, 1180
	Kit.Cyl(m, 16, 44, CFrame.new(cx, 8, cz), CREAM, { Mat = FABRIC, Solid = true, Shadow = true })
	Kit.Cyl(m, 2, 44.6, CFrame.new(cx, 2, cz), Kit.Vivid(RED), { Mat = FABRIC })
	for i, d in { 48, 40, 32, 24, 16, 8 } do
		Kit.Disc(m, cx, cz, 16 + i * 4, d, 4, if i % 2 == 1 then Kit.Vivid(RED) else CREAM, { Mat = FABRIC, Shadow = true })
	end
	Kit.Cyl(m, 10, 1, CFrame.new(cx, 45, cz), C(240, 240, 250))
	Kit.Ball(m, 2.2, V(cx, 50.6, cz), Kit.Vivid(YELLOW))
	local flag = Kit.Box(m, V(cx + 0.5, 44, cz - 0.1), V(cx + 8.5, 48.5, cz + 0.1), Kit.Vivid(PURPLE))
	Kit.Sign(flag, Enum.NormalId.Front, "BOO", CREAM)
	-- doorway toward the midway (+X)
	local door = Kit.Box(m, V(cx + 20.5, 0, cz - 6), V(cx + 22.4, 13, cz + 6), DARK)
	Kit.Light(door, ECTO, 22, 1.2)
	for _, dz in { -1, 1 } do
		Kit.Part(m, V(0.6, 13, 3.2), CFrame.new(cx + 22.7, 6.5, cz + dz * 5.4) * CFrame.Angles(0, 0, dz * 0.08), Kit.Vivid(RED), { Mat = FABRIC })
	end
	Props.SignBoard(m, V(cx + 23.2, 14.2, cz), 18, 3.5, 1, 0, "🎪 THE BIG TOP", DARK, Kit.Vivid(YELLOW), RED)
	Kit.AddCircle(cx, cz, 25)
	Props.Wisp(f, V(-68, 0, cz), ECTO, 10, true)
	Kit.AddCircle(-68, cz, 5)
end

--==================================================================
-- STALLS, BOOTHS, CARTS
--==================================================================
local function stall(f: Instance, x: number, z: number, color: Color3, title: string)
	local m = Kit.Model(f, "GameStall")
	local fx = if x > 0 then -1 else 1
	local base = faced(V(x, 0, z), fx, 0)
	local col = Kit.Vivid(color)
	-- back panel a hair larger than the side panels so their end faces don't share a plane
	Kit.Part(m, V(12.04, 10.04, 1.04), base * CFrame.new(0, 5, 3.5), col, { Mat = WOOD, Solid = true, Shadow = true })
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(1, 10, 8), base * CFrame.new(sx * 5.5, 5, 0), CREAM, { Mat = WOOD, Solid = true })
	end
	Kit.Part(m, V(10, 3.5, 1.6), base * CFrame.new(0, 1.75, -3.2), CREAM, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(10.2, 0.5, 2), base * CFrame.new(0, 3.75, -3.2), col)
	for i = 0, 3 do
		local cf = base * CFrame.new(-4.875 + i * 3.25, 11, -1) * CFrame.Angles(-0.25, 0, 0)
		Kit.Part(m, V(3.25, 0.5, 10), cf, if i % 2 == 0 then col else CREAM, { Mat = FABRIC })
	end
	Kit.Part(m, V(10, 0.5, 1.4), base * CFrame.new(0, 5.5, 2.4), CREAM)
	local prizes = { Kit.Vivid(PINK), Kit.Vivid(YELLOW), Kit.Vivid(MINT) }
	for i = 0, 2 do
		Kit.Ball(m, 1.9, (base * CFrame.new(-3 + i * 3, 6.7, 2.4)).Position, prizes[i + 1])
	end
	local sign = Kit.Part(m, V(10, 2.4, 0.5), base * CFrame.new(0, 13.6, 3.2), DARK)
	Kit.Sign(sign, Enum.NormalId.Front, title, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 8)
end

local function plushBear(parent: Instance, pos: Vector3, s: number, color: Color3, fx: number, fz: number)
	local base = faced(pos, fx, fz)
	Kit.Ball(parent, s, (base * CFrame.new(0, s * 0.45, 0)).Position, color, { Mat = FABRIC })
	local head = base * CFrame.new(0, s * 1.15, 0)
	Kit.Ball(parent, s * 0.75, head.Position, color, { Mat = FABRIC })
	for _, sx in { -1, 1 } do
		Kit.Ball(parent, s * 0.28, (head * CFrame.new(sx * s * 0.3, s * 0.3, 0)).Position, color, { Mat = FABRIC })
		Kit.Ball(parent, s * 0.1, (head * CFrame.new(sx * s * 0.14, s * 0.06, -s * 0.34)).Position, C(40, 30, 50))
	end
	Kit.Ball(parent, s * 0.28, (head * CFrame.new(0, -s * 0.1, -s * 0.3)).Position, CREAM)
	Kit.Part(parent, V(s * 0.5, s * 0.22, s * 0.15), base * CFrame.new(0, s * 0.85, -s * 0.38), Kit.Vivid(RED))
end

local function plushGhost(parent: Instance, pos: Vector3, s: number)
	Kit.Cyl(parent, s * 0.6, s, CFrame.new(pos + V(0, s * 0.3, 0)), CREAM, { Mat = FABRIC })
	Kit.Ball(parent, s, pos + V(0, s * 0.7, 0), CREAM, { Mat = FABRIC })
	for _, sz in { -1, 1 } do
		Kit.Ball(parent, s * 0.14, pos + V(s * 0.44, s * 0.8, sz * s * 0.16), C(40, 30, 50))
		Kit.Ball(parent, s * 0.12, pos + V(s * 0.42, s * 0.62, sz * s * 0.3), Kit.Vivid(PINK))
	end
end

local function prizeBooth(f: Instance)
	local m = Kit.Model(f, "PrizeBooth")
	Kit.Box(m, V(-106, 0, 1045), V(-86, 1, 1071), WOODC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(-108, 0, 1044), V(-106, 16, 1072), Kit.Vivid(BLUE), { Mat = WOOD, Solid = true })
	for _, z in { 1045, 1071 } do
		Kit.Box(m, V(-87, 1, z - 0.6), V(-85.8, 15, z + 0.6), Kit.Vivid(YELLOW), SOLID)
	end
	Kit.Box(m, V(-108, 15, 1044), V(-84, 17, 1072), Kit.Vivid(RED), { Mat = WOOD })
	local valance = Kit.Box(m, V(-84.4, 13, 1044), V(-84, 15, 1072), CREAM)
	Kit.Sign(valance, Enum.NormalId.Right, "🧸 PRIZES! 🧸", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.Box(m, V(-106, 1, 1047), V(-100, 4, 1069), CREAM, { Mat = WOOD, Solid = true })
	plushBear(m, V(-102.5, 4, 1058), 7, Kit.Vivid(PINK), 1, 0)
	plushBear(m, V(-95, 1, 1050), 5, Kit.Vivid(C(150, 200, 255)), 1, 0)
	plushGhost(m, V(-95, 1, 1066), 5)
	Kit.AddRect(-109, 1043, -83, 1073)
end

local function popcorn(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "PopcornCart")
	Kit.Box(m, V(x - 3, 1.2, z - 2.2), V(x + 3, 4.6, z + 2.2), Kit.Vivid(RED), { Solid = true })
	Kit.Box(m, V(x - 3.1, 3.2, z - 2.3), V(x + 3.1, 3.8, z + 2.3), CREAM)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.CylFlat(m, 0.5, 2.4, V(x + sx * 1.8, 1.2, z + sz * 2.4), "Z", DARK)
		end
	end
	local glass = Kit.Box(m, V(x - 2.8, 4.6, z - 2), V(x + 2.8, 8.6, z + 2), C(220, 240, 255), { Transp = 0.5, Refl = 0.1 })
	Kit.Light(glass, C(255, 220, 150), 20, 1.2)
	for i = 0, 2 do
		Kit.Ball(m, 2.4, V(x - 1.4 + i * 1.4, 5.8 + (i % 2) * 0.6, z), C(255, 240, 190))
	end
	Kit.Box(m, V(x - 3.4, 8.6, z - 2.6), V(x + 3.4, 9.2, z + 2.6), Kit.Vivid(RED))
	Kit.Cyl(m, 1.4, 4, CFrame.new(x, 9.9, z), CREAM)
	Kit.Box(m, V(x - 0.2, 10.6, z - 0.2), V(x + 0.2, 11.7, z + 0.2), CREAM)
	local sign = Kit.Part(m, V(6, 1.8, 0.4), faced(V(x + 0.2, 12.6, z), 1, 0), Kit.Vivid(YELLOW))
	Kit.Sign(sign, Enum.NormalId.Front, "🍿 POPCORN", Kit.Vivid(RED), { Stroke = CREAM })
	Kit.AddCircle(x, z, 5)
end

local function balloonCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "BalloonCart")
	Kit.Box(m, V(x - 2, 1, z - 1.5), V(x + 2, 4, z + 1.5), Kit.Vivid(BLUE), { Solid = true })
	Kit.Box(m, V(x - 2.2, 4, z - 1.7), V(x + 2.2, 4.4, z + 1.7), Kit.Vivid(YELLOW))
	for _, sz in { -1, 1 } do
		Kit.CylFlat(m, 0.4, 2.2, V(x, 1.1, z + sz * 1.7), "Z", DARK)
	end
	local cols = { RED, YELLOW, BLUE, PURPLE, PINK, MINT, CREAM }
	local top = V(x, 4.4, z)
	for i, col in cols do
		local a = i / #cols * math.pi * 2
		local p = V(x + math.cos(a) * 2.4, 11 + (i % 3) * 1.4, z + math.sin(a) * 2.4)
		Props.Beam(m, top, p - V(0, 1.4, 0), 0.1, 0.1, C(245, 245, 245))
		Kit.Ball(m, 2.8, p, Kit.Vivid(col), { Refl = 0.05 })
	end
	Kit.AddCircle(x, z, 5)
end

local function highStriker(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "HighStriker")
	Kit.Box(m, V(x - 3, 0, z - 3), V(x + 3, 1, z + 3), Kit.Vivid(RED), { Mat = WOOD, Solid = true })
	Kit.Box(m, V(x - 0.8, 1, z - 0.8), V(x + 0.8, 25, z + 0.8), CREAM, { Mat = WOOD, Solid = true })
	for i, col in { YELLOW, BLUE, RED } do
		local y = 2 + i * 6
		Kit.Box(m, V(x + 0.8, y, z - 1), V(x + 1, y + 3, z + 1), Kit.Vivid(col))
	end
	Kit.Ball(m, 2.6, V(x, 26.3, z), C(255, 230, 120), { Mat = NEON })
	Kit.Box(m, V(x + 0.8, 11, z - 0.5), V(x + 1.6, 12, z + 0.5), DARK)
	Kit.Box(m, V(x + 1, 1, z - 0.8), V(x + 2.8, 1.4, z + 0.8), Kit.Vivid(YELLOW))
	-- giant mallet leaning on the tower
	Props.Beam(m, V(x + 3.5, 0.2, z + 3), V(x + 1.5, 7, z + 3.6), 0.6, 0.6, WOODC)
	Kit.Part(m, V(3, 1.8, 1.8), CFrame.new(x + 1.4, 7.4, z + 3.6), Kit.Vivid(RED))
	Props.SignBoard(m, V(x + 1.2, 4.6, z), 5, 2.2, 1, 0, "BOO-O-METER", DARK, Kit.Vivid(YELLOW))
	Kit.AddCircle(x, z, 5)
end

--==================================================================
-- STREET FURNITURE + DECOR
--==================================================================
local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), WOODC, { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), WOODC, { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(RED))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function fence(f: Instance, a: Vector3, b: Vector3)
	local d = b - a
	local len = d.Magnitude
	local dir = d.Unit
	local yaw = Kit.FaceYaw(dir.X, dir.Z)
	for _, ry in { 1.2, 2.8 } do
		Kit.Part(f, V(0.3, 0.5, len), CFrame.new(a + d / 2 + V(0, ry, 0)) * CFrame.Angles(0, yaw, 0), Kit.Vivid(RED), { Mat = WOOD })
	end
	local n = math.max(1, math.floor(len / 4))
	for i = 0, n do
		local p = a + dir * (i * len / n)
		Kit.Box(f, p + V(-0.35, 0, -0.35), p + V(0.35, 3.8, 0.35), CREAM, { Mat = WOOD })
	end
	Kit.AddRect(math.min(a.X, b.X) - 1, math.min(a.Z, b.Z) - 1, math.max(a.X, b.X) + 1, math.max(a.Z, b.Z) + 1)
end

local function stringLights(f: Instance)
	local zs = { 1005, 1030, 1055, 1080, 1105, 1130 }
	local top = 17.5
	local cols = { Kit.Vivid(RED), Kit.Vivid(YELLOW), Kit.Vivid(BLUE), CREAM }
	for _, z in zs do
		for _, s in { -1, 1 } do
			Kit.Cyl(f, top + 0.5, 0.7, CFrame.new(s * 13, (top + 0.5) / 2, z), C(150, 100, 70), { Mat = WOOD })
			Kit.Ball(f, 1.4, V(s * 13, top + 0.9, z), Kit.Vivid(YELLOW))
			Kit.AddCircle(s * 13, z, 1.5)
		end
	end
	local nb = 0
	local lit = false
	local function wire(a: Vector3, b: Vector3)
		local mid = (a + b) / 2 - V(0, 2, 0)
		Props.Beam(f, a, mid, 0.15, 0.15, DARK)
		Props.Beam(f, mid, b, 0.15, 0.15, DARK)
		for k = 1, 4 do
			local t = k / 5
			local sag = 2 * (1 - math.abs(2 * t - 1))
			local p = a:Lerp(b, t) - V(0, sag + 0.5, 0)
			nb += 1
			local glow = nb % 4 == 0
			local bulb = Kit.Ball(f, 0.9, p, if glow then BULB else cols[nb % #cols + 1], glowOpts(glow))
			if glow and not lit then
				lit = true
				Kit.Light(bulb, C(255, 215, 150), 30, 1.1)
			end
		end
	end
	for i, z in zs do
		wire(V(-13, top, z), V(13, top, z))
		local nextZ = zs[i + 1]
		if nextZ then
			local s = if i % 2 == 1 then 1 else -1
			wire(V(-13 * s, top, z), V(13 * s, top, nextZ))
		end
	end
end

local function lollipop(f: Instance, x: number, z: number, color: Color3)
	Kit.Cyl(f, 12, 0.8, CFrame.new(x, 6, z), CREAM)
	Kit.CylFlat(f, 1.2, 7, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.CylFlat(f, 1.4, 4, V(x, 14, z), "Z", CREAM)
	Kit.CylFlat(f, 1.6, 1.6, V(x, 14, z), "Z", Kit.Vivid(color))
	Kit.AddCircle(x, z, 2)
end

local function circusBall(f: Instance, x: number, z: number, color: Color3, band: Color3)
	Kit.Ball(f, 6, V(x, 3, z), Kit.Vivid(color), { Solid = true })
	Kit.CylFlat(f, 1.4, 6.15, V(x, 3, z), "X", band)
	Kit.AddCircle(x, z, 3.5)
end

type BallSpot = { P: Vector3, Col: Color3, Band: Color3 }

local function decor(f: Instance)
	local rng = Kit.Rng
	-- benches between the string-light poles
	local benches = 0
	for _, z in { 1017, 1042, 1067, 1092, 1117 } do
		for _, s in { -1, 1 } do
			if benches < 7 and Kit.IsFree(s * 16.5, z, 3.5) then
				benches += 1
				bench(f, s * 16.5, z, -s, 0)
			end
		end
	end
	-- wooden fencing
	fence(f, V(68, 0, 1164), V(92, 0, 1164))
	fence(f, V(-124, 0, 1150), V(-78, 0, 1150))
	fence(f, V(128, 0, 1030), V(128, 0, 1078))
	-- lanterns flanking the boss ring (one flickers)
	Props.Lantern(f, V(-26, 0, 1142), C(200, 150, 255), true, true)
	Props.Lantern(f, V(26, 0, 1142), C(255, 220, 140), true, false)
	Kit.AddCircle(-26, 1142, 1.5)
	Kit.AddCircle(26, 1142, 1.5)
	-- oversized decorations
	local lolly = { RED, BLUE, PURPLE, PINK }
	for i, p in { V(-60, 0, 936), V(40, 0, 938), V(-125, 0, 1020), V(122, 0, 1092) } do
		if Kit.IsFree(p.X, p.Z, 2) then
			lollipop(f, p.X, p.Z, lolly[i])
		end
	end
	local balls: { BallSpot } = {
		{ P = V(34, 0, 1036), Col = RED, Band = CREAM },
		{ P = V(-30, 0, 1035), Col = BLUE, Band = Kit.Vivid(YELLOW) },
		{ P = V(112, 0, 1100), Col = PURPLE, Band = CREAM },
	}
	for _, b in balls do
		if Kit.IsFree(b.P.X, b.P.Z, 3.5) then
			circusBall(f, b.P.X, b.P.Z, b.Col, b.Band)
		end
	end
	-- floating balloons (single parts, client-animated)
	local fl = { RED, YELLOW, BLUE, PURPLE, PINK }
	for i, p in { V(36, 19, 1078), V(24, 22, 1090), V(-36, 18, 1040), V(60, 24, 940), V(-40, 22, 1150) } do
		local b = Kit.Ball(f, 3, p, Kit.Vivid(fl[i]), { Name = "FloatingBalloon" })
		Kit.Float(b, 1.2)
	end
	-- candy trees near the walls
	local trees = 0
	for _ = 1, 120 do
		if trees >= 6 then
			break
		end
		local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(100, 131)
		local z = rng:NextNumber(905, 1150)
		if Kit.IsFree(x, z, 5) then
			trees += 1
			Props.Tree(f, V(x, 0, z), rng:NextNumber(12, 17), Kit.Pick({ C(255, 140, 50), C(170, 90, 230), C(255, 110, 90) }))
		end
	end
	-- wooden crates and pumpkins scattered around the grounds
	local crates, pumpkins = 0, 0
	for _ = 1, 300 do
		if crates >= 7 and pumpkins >= 6 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(908, 1212)
		if Kit.IsFree(x, z, 3) then
			if crates < 7 then
				crates += 1
				local s = rng:NextNumber(2.6, 3.8)
				local cf = CFrame.new(x, s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
				Kit.Part(f, V(s, s, s), cf, Kit.Pick({ WOODC, C(170, 115, 75), C(205, 160, 110) }), { Mat = WOOD, Solid = true })
			else
				pumpkins += 1
				Props.Pumpkin(f, V(x, 0, z), rng:NextNumber(2.4, 3.4), -x, 0)
			end
			Kit.AddCircle(x, z, 3)
		end
	end
end

function Carnival.Build(map: Instance)
	local f = Kit.Folder(map, "Carnival")
	ground(f)
	sideWalls(f)
	outside(f)
	entranceArch(f)
	ticketBooth(f, -46, 930)
	ticketBooth(f, 46, 930)
	ferrisWheel(f)
	carousel(f)
	bigTop(f)
	prizeBooth(f)
	-- striped tents (door toward the midway)
	tent(f, -112, 936, 16, Kit.Vivid(RED), CREAM)
	tent(f, -80, 950, 13, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 118, 952, 16, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, 115, 1005, 14, Kit.Vivid(RED), CREAM)
	tent(f, -122, 1110, 14, Kit.Vivid(RED), CREAM)
	tent(f, 40, 1180, 12, Kit.Vivid(BLUE), Kit.Vivid(YELLOW))
	tent(f, -45, 1185, 12, Kit.Vivid(RED), CREAM)
	-- game stalls
	stall(f, 52, 948, BLUE, "RING TOSS")
	stall(f, 52, 977, PURPLE, "DUCK POND")
	stall(f, 52, 1006, RED, "BOO BALLOONS")
	stall(f, -48, 1062, YELLOW, "WHACK-A-GHOST")
	popcorn(f, -40, 958)
	balloonCart(f, 30, 1085)
	highStriker(f, -28, 1078)
	Props.Wisp(f, V(58, 0, 1158), ECTO, 10, true)
	Kit.AddCircle(58, 1158, 5)
	stringLights(f)
	decor(f)
end

return Carnival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Castle</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 7: Cursed Castle (Z 1920..2280).
--   Z 1926..1936  cosmetic moat (water over a solid floor at Y -0.5: a half-stud wade, no pit)
--                 crossed by a stone bridge on the path (X -12..12).
--   Z 1936..1962  outer bailey: Royal crate station (-28, 1952) and Fast Travel pad (26, 1952).
--   Z 1962..1975  gatehouse (archway X -16..16, clear to Y ~30, 26+ wide at Y 30) flanked by a
--                 crenellated curtain wall out to the side walls.
--   Z 1975..2186  open courtyard (no roofs): every non-boss ghost area, knight statues, a
--                 spectral fountain, braziers, sword in the stone, lawns.
--   Z 2186..2256  open-topped throne room (X -45..45) around the boss area (0, 2220); giant doors
--                 swung outward; the throne sits on a balcony over a 26-wide arch in the back
--                 wall that leads on to the Spirit Realm gate.
--   Library corner X 74..140, Z 2146..2254 (open front/top). Eight round towers with stepped cone
--   roofs (keep towers flank the throne room, tips ~117), cliffs beyond the side walls.
--   Glow: rune ring, cracks, tower windows (half the towers), torches, braziers, candles, the
--   fountain orb and the throne gem. Everything else is stone, wood, metal and fabric.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Castle = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SLATE = Enum.Material.Slate
local COBBLE = Enum.Material.Cobblestone
local WOOD = Enum.Material.Wood
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1920, 2280

local STONE = C(150, 150, 166)
local STONE_D = C(112, 114, 132)
local STONE_L = C(188, 188, 200)
local FLOOR = C(132, 130, 148)
local PATH = C(176, 170, 186)
local BLUE = C(55, 78, 150)
local ROOF = C(60, 75, 145)
local ROOF_P = C(100, 60, 150)
local ROYAL_RED = C(175, 40, 70)
local PURPLE = C(125, 65, 175)
local GOLD = C(255, 200, 70)
local SPECTRAL = C(120, 255, 170)
local GHOST_PURPLE = C(190, 120, 255)
local WARM = C(255, 185, 95)
local WOOD_C = C(112, 76, 52)
local IRON = C(60, 62, 78)
local SILVER = C(196, 200, 214)
local ROCKC = C(102, 106, 124)

local SOLID_SLATE: Kit.Opts = { Mat = SLATE, Solid = true, Shadow = true }

--==================================================================
-- HELPERS
--==================================================================
-- Stepped cone roof (stacked cylinders) from y up to y + h, with a gold finial.
local function cone(parent: Instance, x: number, z: number, y: number, d: number, h: number, color: Color3)
	local tiers = 5
	local th = h / tiers
	for i = 0, tiers - 1 do
		local di = d * (1 - i / tiers)
		local col = if i % 2 == 0 then color else color:Lerp(Color3.new(1, 1, 1), 0.12)
		Kit.Cyl(parent, th, di, CFrame.new(x, y + th * (i + 0.5), z), col, { Mat = SLATE, Shadow = true })
	end
	Kit.Ball(parent, math.max(1.2, d * 0.12), V(x, y + h + 0.4, z), Kit.Vivid(GOLD), { Mat = METAL })
end

-- Round tower with crenellated top, cone roof, flag and two windows facing the path.
local function tower(parent: Instance, x: number, z: number, d: number, h: number, roof: Color3, glow: Color3?)
	local m = Kit.Model(parent, "Tower")
	Kit.Cyl(m, 3, d + 3, CFrame.new(x, 1.5, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, h, d, CFrame.new(x, h / 2, z), STONE, SOLID_SLATE)
	Kit.Cyl(m, 1.2, d + 0.6, CFrame.new(x, h * 0.62, z), Kit.Vivid(BLUE), { Mat = SLATE })
	Kit.Cyl(m, 4, d + 3, CFrame.new(x, h + 2, z), STONE_L, { Mat = SLATE, Shadow = true })
	local r = (d + 3) / 2 - 1.3
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * r, z + math.sin(a) * r
		Kit.Box(m, V(px - 1.4, h + 4, pz - 1.4), V(px + 1.4, h + 7, pz + 1.4), STONE_L, { Mat = SLATE })
	end
	local coneH = (d - 1) * 1.75
	cone(m, x, z, h + 4, d - 1, coneH, roof)
	local tip = h + 4 + coneH
	Kit.Cyl(m, 6, 0.3, CFrame.new(x, tip + 3, z), IRON, { Mat = METAL })
	Kit.Part(m, V(0.3, 2.6, 4.5), CFrame.new(x, tip + 4.6, z - 2.4), Kit.Vivid(if roof == ROOF then ROYAL_RED else PURPLE), { Mat = FABRIC })
	local dir = if x > 0 then -1 else 1
	local winOpts: Kit.Opts = if glow then { Mat = NEON, Transp = 0.1 } else {}
	for _, wy in { h * 0.42, h * 0.8 } do
		Kit.Part(m, V(2.2, 5, 1), CFrame.new(x + dir * (d / 2 - 0.2), wy, z) * CFrame.Angles(0, Kit.FaceYaw(dir, 0), 0), glow or C(40, 50, 85), winOpts)
	end
	Kit.AddCircle(x, z, d / 2 + 2.5)
end

-- Hanging banner facing (fx, fz); pos = centre of the cloth.
local function banner(parent: Instance, pos: Vector3, w: number, h: number, fx: number, fz: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local gold = Kit.Vivid(GOLD)
	Kit.Part(parent, V(w, h, 0.3), cf, color, { Mat = FABRIC })
	local e = w * 0.42
	Kit.Part(parent, V(e, e, 0.2), cf * CFrame.new(0, h * 0.12, -0.22) * CFrame.Angles(0, 0, math.pi / 4), gold, { Mat = METAL })
	Kit.Part(parent, V(w + 1.2, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.2, 0), gold, { Mat = METAL })
	Kit.Part(parent, V(w, 0.6, 0.36), cf * CFrame.new(0, -h / 2 + 0.3, 0), gold, { Mat = FABRIC })
end

local function knightStatue(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "KnightStatue")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = C(178, 178, 190)
	local so: Kit.Opts = { Mat = Enum.Material.Concrete, Shadow = true }
	Kit.Part(m, V(6, 3, 6), base * CFrame.new(0, 1.5, 0), STONE_D, SOLID_SLATE)
	Kit.Part(m, V(3, 4, 1.8), base * CFrame.new(0, 5, 0), stone, so)
	Kit.Part(m, V(4.2, 4.6, 2.4), base * CFrame.new(0, 9.3, 0), stone, so)
	Kit.Ball(m, 2.8, (base * CFrame.new(0, 12.9, 0)).Position, stone, so)
	Kit.Wedge(m, V(0.6, 1.8, 2.6), base * CFrame.new(0, 14.6, 0.4), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Part(m, V(3.2, 4.2, 0.5), base * CFrame.new(-2.7, 8.6, -0.9), Kit.Vivid(ROYAL_RED), { Mat = METAL })
	Kit.Part(m, V(1.4, 1.4, 0.2), base * CFrame.new(-2.7, 8.8, -1.2) * CFrame.Angles(0, 0, math.pi / 4), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.5, 9, 0.3), base * CFrame.new(2.6, 9.5, -1.3), SILVER, { Mat = METAL })
	Kit.Part(m, V(2.4, 0.45, 0.45), base * CFrame.new(2.6, 7.2, -1.3), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.AddCircle(x, z, 4.5)
end

local function armor(parent: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(parent, "SuitOfArmor")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.15 }
	Kit.Part(m, V(3, 0.6, 3), base * CFrame.new(0, 0.3, 0), WOOD_C, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(1.9, 3.6, 1.2), base * CFrame.new(0, 2.4, 0), SILVER, mo)
	Kit.Part(m, V(2.8, 2.8, 1.6), base * CFrame.new(0, 5.6, 0), SILVER, mo)
	Kit.Part(m, V(3.4, 0.9, 1.8), base * CFrame.new(0, 6.9, 0), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(1.6, 1.9, 1.6), base * CFrame.new(0, 8.3, 0), SILVER, mo)
	Kit.Part(m, V(1.2, 0.25, 0.12), base * CFrame.new(0, 8.4, -0.82), C(25, 25, 35))
	Kit.Wedge(m, V(0.4, 1.2, 1.6), base * CFrame.new(0, 9.8, 0.2), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Part(m, V(0.3, 10, 0.3), base * CFrame.new(1.9, 5, -0.5), WOOD_C, { Mat = WOOD })
	Kit.Part(m, V(0.2, 1.8, 1.4), base * CFrame.new(1.9, 9.6, -0.9), SILVER, mo)
	Kit.AddCircle(x, z, 2.5)
end

local function candelabra(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "Candelabra")
	local gold = Kit.Vivid(GOLD)
	Kit.Disc(m, x, z, 0.5, 2.4, 0.5, gold, { Mat = METAL })
	Kit.Cyl(m, 6, 0.6, CFrame.new(x, 3.5, z), gold, { Mat = METAL })
	Kit.CylFlat(m, 4.2, 0.4, V(x, 6.5, z), "X", gold, { Mat = METAL })
	for i = -1, 1 do
		Kit.Cyl(m, 1.4, 0.55, CFrame.new(x + i * 1.9, 7.4, z), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x + i * 1.9, 8.4, z), WARM, { Mat = NEON })
		if light and i == 0 then
			Kit.Light(flame, WARM, 20, 1.3, true)
		end
	end
	Kit.AddCircle(x, z, 2.5)
end

local function brazier(parent: Instance, x: number, z: number)
	local m = Kit.Model(parent, "Brazier")
	Kit.Cyl(m, 4, 2.4, CFrame.new(x, 2, z), STONE_D, SOLID_SLATE)
	Kit.Cyl(m, 1.6, 4.4, CFrame.new(x, 4.8, z), IRON, { Mat = METAL })
	local flame = Kit.Ball(m, 2.6, V(x, 5.9, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(flame, SPECTRAL, 26, 1.6)
	Kit.AddCircle(x, z, 3)
end

local function crack(parent: Instance, p: Vector3, segs: number)
	local rng = Kit.Rng
	local a = rng:NextNumber(0, math.pi * 2)
	for _ = 1, segs do
		a += rng:NextNumber(-0.9, 0.9)
		local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(4, 7)
		Props.Beam(parent, p, q, 0.45, 0.06, if rng:NextNumber() < 0.5 then SPECTRAL else GHOST_PURPLE, { Mat = NEON })
		p = q
	end
end

--==================================================================
-- GROUND, MOAT, BRIDGE, PATH, WALLS, CLIFFS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, 1926), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	Kit.Box(f, V(-190, -4, 1926), V(190, -0.5, 1936), C(60, 72, 95), { Mat = SLATE, Solid = true, Name = "MoatFloor" })
	Kit.Box(f, V(-146, -0.5, 1926), V(146, -0.12, 1936), C(45, 85, 150), { Transp = 0.2, Refl = 0.25, Name = "MoatWater" })
	Kit.Box(f, V(-190, -4, 1936), V(190, 0, Z1), FLOOR, { Mat = COBBLE, Solid = true, Name = "Ground_Castle" })
	-- low stone curbs along the moat banks (steppable)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 13.6, -0.5, 1925.2), V(s * 140, 0.3, 1926), STONE_D, { Mat = SLATE, Solid = true })
		Kit.Box(f, V(s * 13.6, -0.5, 1936), V(s * 140, 0.3, 1936.8), STONE_D, { Mat = SLATE, Solid = true })
	end
	-- stone bridge over the moat
	Kit.Box(f, V(-12, -0.5, 1923.5), V(12, 0.06, 1938.5), PATH, { Mat = COBBLE, Solid = true, Name = "Bridge" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 12, 0, 1924.5), V(s * 13.6, 3.2, 1937.5), STONE, SOLID_SLATE)
		for _, z in { 1924.5, 1937.5 } do
			Kit.Box(f, V(s * 11.8, 0, z - 1.1), V(s * 14, 4.6, z + 1.1), STONE_L, SOLID_SLATE)
			Kit.Ball(f, 1.8, V(s * 12.9, 5.4, z), Kit.Vivid(GOLD), { Mat = METAL })
		end
	end
	-- main path with blue slate edging
	Kit.Box(f, V(-9, 0, 1938.5), V(9, 0.05, Z1), PATH, { Mat = COBBLE, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, 1938.5), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(BLUE), { Mat = SLATE })
	end
	-- flat lawns in the courtyard
	for _, l in { { 40, 1978, 136, 2062 }, { -136, 1978, -40, 2012 }, { -136, 2070, -92, 2130 }, { 28, 2130, 70, 2186 }, { -46, 2192, -136, 2250 } } do
		Kit.Box(f, V(l[1], 0, l[2]), V(l[3], 0.04, l[4]), C(100, 165, 105), { Mat = Enum.Material.Grass })
	end
end

local function sideWalls(f: Instance)
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, Z0 + 3), V(s * 146, 30, Z1 - 3), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 139.6, 30, Z0 + 3), V(s * 146.4, 31.2, Z1 - 3), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 139.7, 24, Z0 + 3), V(s * 140.05, 25.2, Z1 - 3), Kit.Vivid(BLUE), { Mat = SLATE }) -- sunk into the wall: no shared face with the pilasters
		for z = Z0 + 12, Z1 - 12, 16 do
			Kit.Box(f, V(s * 140, 31.2, z - 3), V(s * 146, 35, z + 3), STONE, { Mat = SLATE })
		end
		for _, z in { 2012, 2056, 2146, 2190 } do
			Kit.Box(f, V(s * 137.5, 0, z - 2.5), V(s * 140, 26, z + 2.5), STONE_D, SOLID_SLATE)
		end
		-- spectral crack climbing the wall
		local x = s * 139.75
		local z0 = if s < 0 then 2120 else 2040
		Props.Beam(f, V(x, 2, z0), V(x, 9, z0 + 5), 0.4, 0.4, SPECTRAL, { Mat = NEON })
		Props.Beam(f, V(x, 9, z0 + 5), V(x, 15, z0 + 1), 0.4, 0.4, SPECTRAL, { Mat = NEON })
	end
	-- royal banners on the inner wall faces
	for i, z in { 2034, 2078, 2130 } do
		for _, s in { -1, 1 } do
			banner(f, V(s * 139.5, 15, z), 7, 14, -s, 0, if (i + (if s > 0 then 1 else 0)) % 2 == 0 then ROYAL_RED else PURPLE)
		end
	end
end

local function cliffs(f: Instance)
	local rng = Kit.Rng
	local cols = { ROCKC, C(88, 92, 112), C(115, 118, 138) }
	for _, s in { -1, 1 } do
		for i = 0, 7 do
			local z = 1934 + i * 46
			local w = rng:NextNumber(26, 44)
			local h = rng:NextNumber(42, 66)
			local cf = CFrame.new(s * (149 + w / 2), h / 2 - 3, z) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), s * rng:NextNumber(0.02, 0.08))
			Kit.Part(f, V(w, h, rng:NextNumber(38, 52)), cf, Kit.Pick(cols), { Mat = ROCK })
			Kit.Ball(f, rng:NextNumber(40, 60), V(s * rng:NextNumber(185, 205), rng:NextNumber(4, 18), z + 20), Kit.Pick(cols), { Mat = ROCK })
		end
	end
end

--==================================================================
-- GATEHOUSE + CURTAIN WALL
--==================================================================
local function gatehouse(f: Instance)
	local m = Kit.Model(f, "Gatehouse")
	local zA, zB = 1962, 1975
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16, 0, zA), V(s * 34, 46, zB), STONE, SOLID_SLATE)
		Kit.Box(m, V(s * 15.6, 0, zA - 0.4), V(s * 34.4, 3, zB + 0.4), STONE_D, SOLID_SLATE)
		for _, mx in { 18.5, 31.5 } do
			for _, mz in { zA + 1.5, zB - 1.5 } do
				Kit.Box(m, V(s * (mx - 1.5), 46, mz - 1.5), V(s * (mx + 1.5), 50, mz + 1.5), STONE_L, { Mat = SLATE })
			end
		end
		-- little turret with a cone roof
		Kit.Cyl(m, 10, 7, CFrame.new(s * 25, 51, (zA + zB) / 2), STONE_L, { Mat = SLATE, Shadow = true })
		cone(m, s * 25, (zA + zB) / 2, 56, 8.5, 13, ROOF_P)
		-- banner and torch on the approach face
		banner(m, V(s * 25, 24, zA - 0.35), 8, 18, 0, -1, if s < 0 then ROYAL_RED else PURPLE)
		local tx = s * 18.2
		Kit.Box(m, V(tx - 0.4, 16.5, zA - 0.8), V(tx + 0.4, 19.5, zA), IRON, { Mat = METAL })
		local flame = Kit.Ball(m, 1.7, V(tx, 20.3, zA - 0.6), WARM, { Mat = NEON })
		Kit.Light(flame, WARM, 26, 1.6)
	end
	-- lintel over the archway (opening X -16..16, Y 0..32) + rounded arch corners
	Kit.Box(m, V(-16, 32, zA + 1), V(16, 46, zB - 1), STONE, SOLID_SLATE)
	Kit.Box(m, V(-16, 32, zA + 0.7), V(16, 33, zB - 0.7), Kit.Vivid(GOLD), { Mat = METAL })
	local mid = (zA + zB) / 2
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(-13.5, 29.5, mid), V(0, 0, -1), V(0, -1, 0)), STONE, { Mat = SLATE })
	Kit.Wedge(m, V(zB - zA - 2, 5, 5), CFrame.fromMatrix(V(13.5, 29.5, mid), V(0, 0, 1), V(0, -1, 0)), STONE, { Mat = SLATE })
	-- raised portcullis teeth
	Kit.Box(m, V(-15, 31, mid - 0.4), V(15, 31.6, mid + 0.4), IRON, { Mat = METAL })
	for x = -12, 12, 4 do
		Kit.Box(m, V(x - 0.35, 30.4, mid - 0.3), V(x + 0.35, 32, mid + 0.3), IRON, { Mat = METAL })
	end
	Props.SignBoard(m, V(0, 39.5, zA + 0.6), 26, 5, 0, -1, "CURSED CASTLE", C(45, 35, 80), Kit.Vivid(GOLD), GOLD)

	-- curtain wall from the gatehouse to the side walls
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 34, 0, 1964), V(s * 140, 24, 1972), STONE, SOLID_SLATE)
		Kit.Box(f, V(s * 34, 24, 1963.6), V(s * 140, 25, 1972.4), STONE_D, { Mat = SLATE })
		Kit.Box(f, V(s * 34, 18, 1963.7), V(s * 122, 19, 1964), Kit.Vivid(BLUE), { Mat = SLATE })
		for x = 40, 116, 9.5 do
			Kit.Box(f, V(s * (x - 2), 25, 1963.6), V(s * (x + 2), 28.5, 1966.6), STONE, { Mat = SLATE })
		end
		for i, x in { 58, 96 } do
			banner(f, V(s * x, 12, 1963.4), 7, 14, 0, -1, if i == 1 then ROYAL_RED else PURPLE)
		end
	end
	Kit.AddRect(-140, 1961, -15, 1976)
	Kit.AddRect(15, 1961, 140, 1976)
end

--==================================================================
-- THRONE ROOM
--==================================================================
local function throneRoom(f: Instance)
	local m = Kit.Model(f, "ThroneRoom")
	local wall = C(138, 134, 160)
	local gold = Kit.Vivid(GOLD)
	local H = 28
	-- walls (open top)
	Kit.Box(m, V(-45, 0, 2186), V(-15, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(15, 0, 2186), V(45, H, 2190), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2186), V(-42, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(42, 0, 2186), V(45, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-45, 0, 2248), V(-13, H, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(13, 0, 2248), V(45, H, 2256), wall, SOLID_SLATE)
	-- balcony over the back arch (opening X -13..13, Y 0..20) carries the throne
	Kit.Box(m, V(-13, 20, 2248), V(13, 24, 2256), wall, SOLID_SLATE)
	Kit.Box(m, V(-13, 20, 2247.7), V(13, 21, 2248), gold, { Mat = METAL })
	-- gold trim and merlons
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 22, 2185.7), V(s * 45, 23, 2186), gold, { Mat = METAL })
		for _, x in { 22, 32, 42 } do
			Kit.Box(m, V(s * (x - 2), H, 2186), V(s * (x + 2), H + 3.5, 2189), wall, { Mat = SLATE })
		end
		for _, z in { 2200, 2218, 2236 } do
			Kit.Box(m, V(s * 42, H, z - 2), V(s * 45, H + 3.5, z + 2), wall, { Mat = SLATE })
		end
	end
	-- lintel + name over the doorway (doorway X -15..15, Y 0..28)
	Kit.Box(m, V(-17, H, 2185.5), V(17, H + 6, 2190.5), STONE_L, SOLID_SLATE)
	Props.SignBoard(m, V(0, H + 3, 2185.1), 24, 4.5, 0, -1, "THRONE ROOM", C(80, 25, 50), gold, GOLD)
	Props.SignBoard(m, V(-24, 9, 2185.4), 9, 3, 0, -1, "BEWARE OF\nTHE KING", C(240, 232, 215), Kit.Vivid(ROYAL_RED))
	-- giant doors, swung outward
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 15, 0, 2171), V(s * 16.6, H, 2186), C(105, 68, 45), { Mat = Enum.Material.WoodPlanks, Solid = true, Shadow = true })
		for _, y in { 5, 14, 23 } do
			Kit.Box(m, V(s * 14.8, y, 2170.95), V(s * 16.8, y + 1, 2186.05), IRON, { Mat = METAL }) -- a hair past the door ends (z-fighting)
		end
		Kit.CylFlat(m, 0.4, 2.2, V(s * 14.7, 12, 2174), "X", gold, { Mat = METAL })
		Kit.AddRect(s * 14, 2170, s * 17.5, 2186)
	end
	-- royal carpet (flat) from the doors to the throne
	Kit.Box(m, V(-5, 0, 2166), V(5, 0.08, 2248), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5 - 0.4, 0, 2166), V(s * 5 + 0.4, 0.1, 2248), gold, { Mat = FABRIC })
	end
	-- columns
	for _, s in { -1, 1 } do
		for _, z in { 2200, 2222, 2244 } do
			Kit.Cyl(m, 24, 3.2, CFrame.new(s * 36, 12, z), STONE_L, SOLID_SLATE)
			Kit.Box(m, V(s * 36 - 2.2, 24, z - 2.2), V(s * 36 + 2.2, 25.2, z + 2.2), gold, { Mat = METAL })
		end
		banner(m, V(s * 41.8, 15, 2211), 6, 14, -s, 0, ROYAL_RED)
		banner(m, V(s * 41.8, 15, 2233), 6, 14, -s, 0, PURPLE)
	end
	candelabra(m, -30, 2195, true)
	candelabra(m, 30, 2195, false)

	-- the throne on the balcony
	Kit.Box(m, V(-8, 24, 2247.5), V(8, 25.2, 2256), gold, { Mat = METAL })
	Kit.Box(m, V(-5.5, 25.2, 2248), V(5.5, 28.6, 2254), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(-6.5, 25.2, 2253), V(6.5, 46, 2256), Kit.Vivid(ROYAL_RED), { Mat = FABRIC })
	Kit.Box(m, V(-7.6, 25.2, 2253.6), V(7.6, 47.6, 2256.3), gold, { Mat = METAL })
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 5.5, 25.2, 2248), V(s * 7.6, 30.6, 2254), gold, { Mat = METAL })
		Kit.Cyl(m, 3.4, 1.2, CFrame.new(s * 5, 49.3, 2255), gold, { Mat = METAL })
		Kit.Ball(m, 1.6, V(s * 5, 51.4, 2255), Kit.Vivid(ROYAL_RED), { Refl = 0.2 })
	end
	Kit.Cyl(m, 4.4, 1.4, CFrame.new(0, 49.8, 2255), gold, { Mat = METAL })
	local gem = Kit.Ball(m, 2.2, V(0, 52.6, 2255), GHOST_PURPLE, { Mat = NEON })
	Kit.Light(gem, GHOST_PURPLE, 40, 1.8)
	Props.Beam(m, V(-3, 28, 2252.9), V(1, 36, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	Props.Beam(m, V(1, 36, 2252.9), V(-1, 42, 2252.9), 0.35, 0.35, SPECTRAL, { Mat = NEON })
	local mist = Kit.Part(m, V(14, 0.2, 6), CFrame.new(0, 26, 2251), GHOST_PURPLE, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(mist, GHOST_PURPLE, 1.5, 6, 0.4)
	local crown = Kit.Cyl(m, 1.8, 3.4, CFrame.new(0, 58, 2252), gold, { Mat = METAL, Name = "FloatingCrown" })
	Kit.Float(crown, 1.2)

	-- boss area paint: royal disc, gold ring, spectral rune ring (flat)
	Kit.Disc(m, 0, 2220, 0.09, 52, 0.09, gold, { Mat = METAL })
	Kit.Disc(m, 0, 2220, 0.11, 48, 0.11, C(70, 40, 95), { Mat = SLATE })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.1
		local a2 = a1 + math.pi / 4 - 0.2
		Props.Beam(m, V(math.cos(a1) * 20, 0.15, 2220 + math.sin(a1) * 20), V(math.cos(a2) * 20, 0.15, 2220 + math.sin(a2) * 20), 0.5, 0.06, GHOST_PURPLE, { Mat = NEON })
	end
	Kit.AddRect(-46, 2185, 46, 2257)
end

--==================================================================
-- LIBRARY CORNER (+X back)
--==================================================================
local function library(f: Instance)
	local m = Kit.Model(f, "Library")
	local rng = Kit.Rng
	local shelfC = C(92, 60, 42)
	Kit.Box(m, V(74, 0, 2249), V(140, 22, 2253), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2205), V(76, 16, 2230), STONE, SOLID_SLATE)
	Kit.Box(m, V(74, 0, 2230), V(76, 11, 2249), STONE, SOLID_SLATE)
	Kit.Box(m, V(80, 0, 2160), V(134, 0.06, 2244), Kit.Vivid(PURPLE), { Mat = FABRIC })
	Kit.Box(m, V(84, 0, 2164), V(130, 0.08, 2240), C(95, 50, 135), { Mat = FABRIC })
	-- shelves along the back wall (facing -Z), two colours per row
	for _, x in { 84, 100, 116 } do
		Kit.Box(m, V(x - 7, 0, 2245), V(x + 7, 18, 2249), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			local split = rng:NextNumber(-2, 2)
			Kit.Box(m, V(x - 6.3, y, 2244.6), V(x + split, y + 3.6, 2245.1), Kit.Pick(Props.Colors.Book))
			Kit.Box(m, V(x + split, y, 2244.6), V(x + 6.3, y + 3.4, 2245.1), Kit.Pick(Props.Colors.Book))
		end
	end
	-- shelves along the side wall (facing -X)
	for _, z in { 2166, 2184, 2202, 2220 } do
		Kit.Box(m, V(135, 0, z - 7), V(139.5, 18, z + 7), shelfC, { Mat = WOOD, Solid = true })
		for row = 0, 2 do
			local y = 2.5 + row * 5
			Kit.Box(m, V(134.6, y, z - 6.3), V(135.1, y + 3.6, z + 6.3), Kit.Pick(Props.Colors.Book))
		end
	end
	-- ladder
	Props.Beam(m, V(91, 0, 2243.4), V(91.6, 17.5, 2244.6), 0.3, 0.3, shelfC)
	Props.Beam(m, V(93.4, 0, 2243.4), V(94, 17.5, 2244.6), 0.3, 0.3, shelfC)
	-- reading table with candles and a book pile
	Kit.Box(m, V(88, 3, 2190), V(100, 3.8, 2198), shelfC, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(89, 0, 2191), V(90, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(98, 0, 2191), V(99, 3, 2197), shelfC, { Mat = WOOD })
	Kit.Box(m, V(90.5, 3.8, 2192), V(93.5, 4.6, 2196), Kit.Vivid(ROYAL_RED))
	Kit.Box(m, V(90.8, 4.6, 2192.4), V(93.2, 5.3, 2195.6), Kit.Vivid(BLUE))
	for i, x in { 96, 98 } do
		Kit.Cyl(m, 1.6, 0.6, CFrame.new(x, 4.6, 2194), C(250, 240, 215))
		local flame = Kit.Ball(m, 0.6, V(x, 5.7, 2194), WARM, { Mat = NEON })
		if i == 1 then
			Kit.Light(flame, WARM, 24, 1.3, true)
		end
	end
	-- lectern with a giant open spell book
	Kit.Box(m, V(104, 0, 2214), V(107, 4.2, 2217), shelfC, { Mat = WOOD, Solid = true })
	Kit.Part(m, V(6, 0.5, 4.2), CFrame.new(105.5, 4.8, 2215.5) * CFrame.Angles(-0.35, 0, 0), C(250, 245, 230))
	Kit.Part(m, V(2.8, 0.1, 0.25), CFrame.new(105.5, 5.1, 2215.2) * CFrame.Angles(-0.35, 0, 0), SPECTRAL, { Mat = NEON })
	-- floating books and a candle
	Props.FloatingBook(m, V(96, 10, 2214))
	Props.FloatingBook(m, V(112, 12, 2228))
	Props.FloatingBook(m, V(120, 9, 2204))
	Props.FloatingCandle(m, V(106, 10, 2196))
	Props.SignBoard(m, V(100, 20.2, 2248.6), 26, 3.4, 0, -1, "ROYAL LIBRARY - SHHH!", C(50, 35, 80), Kit.Vivid(GOLD), GOLD)
	Kit.AddRect(72, 2146, 140, 2254)
end

--==================================================================
-- COURTYARD FEATURES
--==================================================================
local function fountain(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SpectralFountain")
	Kit.Disc(m, x, z, 2, 14, 2, STONE_L, SOLID_SLATE)
	Kit.Disc(m, x, z, 2.1, 12, 0.2, C(80, 200, 190), { Transp = 0.25, Refl = 0.2 })
	Kit.Cyl(m, 5, 2, CFrame.new(x, 4.5, z), STONE, { Mat = SLATE })
	Kit.Cyl(m, 1, 6, CFrame.new(x, 7.2, z), STONE_L, { Mat = SLATE })
	local orb = Kit.Ball(m, 2.4, V(x, 8.6, z), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	Kit.Light(orb, SPECTRAL, 24, 1.4)
	Kit.Emitter(orb, SPECTRAL, 2, 5, 0.8)
	Kit.AddCircle(x, z, 8)
end

local function swordInStone(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "SwordInStone")
	Kit.Ball(m, 8, V(x, -1, z), ROCKC, { Mat = ROCK, Solid = true })
	Kit.Part(m, V(0.8, 9, 0.3), CFrame.new(x, 6.5, z) * CFrame.Angles(0, 0.4, 0.06), SILVER, { Mat = METAL, Refl = 0.2 })
	Kit.Part(m, V(3.2, 0.6, 0.6), CFrame.new(x + 0.6, 10.6, z) * CFrame.Angles(0, 0.4, 0.06), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Part(m, V(0.6, 2.2, 0.6), CFrame.new(x + 0.66, 12, z) * CFrame.Angles(0, 0.4, 0.06), C(90, 50, 40), { Mat = FABRIC })
	Kit.Ball(m, 0.9, V(x + 0.72, 13.3, z), Kit.Vivid(GOLD), { Mat = METAL })
	Props.SignBoard(m, V(x - 4.5, 2.4, z - 3), 5, 2, -1, -1, "TUG ME?", C(240, 232, 215), Kit.Vivid(PURPLE))
	Kit.AddCircle(x, z, 6)
end

local function scatter(f: Instance)
	local rng = Kit.Rng
	local rubble, barrels, broken = 0, 0, 0
	for _ = 1, 400 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1942, 2272)
		if rubble < 10 and Kit.IsFree(x, z, 3) then
			rubble += 1
			Kit.Ball(f, rng:NextNumber(2.5, 4.5), V(x, -0.4, z), Kit.Pick({ ROCKC, STONE_D, STONE }), { Mat = ROCK, Solid = true })
			Kit.Ball(f, rng:NextNumber(1.4, 2.2), V(x + 2, -0.2, z + 1), STONE_D, { Mat = ROCK })
			Kit.AddCircle(x, z, 3)
		elseif barrels < 7 and Kit.IsFree(x, z, 2.5) then
			barrels += 1
			Kit.Cyl(f, 4, 2.8, CFrame.new(x, 2, z), C(140, 95, 60), { Mat = WOOD, Solid = true })
			Kit.Cyl(f, 0.4, 2.95, CFrame.new(x, 2.8, z), IRON, { Mat = METAL })
			Kit.AddCircle(x, z, 2.5)
		elseif broken < 5 and Kit.IsFree(x, z, 5) then
			broken += 1
			local h = rng:NextNumber(5, 11)
			Kit.Box(f, V(x - 2, 0, z - 2), V(x + 2, 1, z + 2), STONE_D, SOLID_SLATE)
			Kit.Cyl(f, h, 3, CFrame.new(x, 1 + h / 2, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.05, 0.05)), STONE_L, SOLID_SLATE)
			Kit.CylFlat(f, 7, 3, V(x + 1, 1.5, z + 3.5), "X", STONE_L, { Mat = SLATE })
			Kit.AddCircle(x, z, 5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Castle.Build(map: Instance)
	local f = Kit.Folder(map, "Castle")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	cliffs(f)
	gatehouse(f)

	-- ghost-area paint (flat rune circles; the boss circle is painted by the throne room)
	local areas = { { 0, 2005, 30 }, { -82, 2040, 24 }, { 75, 2100, 26 }, { -62, 2160, 24 } }
	for i, a in areas do
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2 + 4, 0.07, Kit.Vivid(if i % 2 == 0 then PURPLE else BLUE), { Mat = SLATE })
		Kit.Disc(f, a[1], a[2], 0.1, a[3] * 2, 0.1, STONE_L, { Mat = SLATE })
		crack(f, V(a[1] + rng:NextNumber(-8, 8), 0.13, a[2] + rng:NextNumber(-8, 8)), 2)
	end

	-- towers: front corners, side middles, back corners and the two keep towers by the throne
	tower(f, -131, 1968, 18, 56, ROOF)
	tower(f, 131, 1968, 18, 56, ROOF)
	tower(f, -128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, 128, 2100, 18, 66, ROOF_P, SPECTRAL)
	tower(f, -128, 2262, 18, 60, ROOF)
	tower(f, 128, 2262, 18, 60, ROOF)
	tower(f, -60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)
	tower(f, 60, 2238, 20, 80, ROOF_P, GHOST_PURPLE)

	throneRoom(f)
	library(f)

	-- courtyard
	for _, p in { { -22, 2062 }, { 22, 2062 }, { -22, 2122 }, { 22, 2122 } } do
		if Kit.IsFree(p[1], p[2], 4) then
			knightStatue(f, p[1], p[2], if p[1] < 0 then 1 else -1, 0)
		end
	end
	if Kit.IsFree(-31, 2092, 8) then
		fountain(f, -31, 2092)
	end
	if Kit.IsFree(32, 2090, 6) then
		swordInStone(f, 32, 2090)
	end
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 16, 2150, 2.5, true) then
			brazier(f, s * 16, 2150)
		end
	end
	for _, p in { { -30, 2181, 0, -1 }, { 30, 2181, 0, -1 }, { -50, 1980, 1, 0 }, { 50, 1980, -1, 0 }, { 68, 2150, -1, 0 }, { -70, 2206, 1, 0 } } do
		if Kit.IsFree(p[1], p[2], 2.5) then
			armor(f, p[1], p[2], p[3], p[4])
		end
	end
	scatter(f)
	for _ = 1, 4 do
		crack(f, V(rng:NextNumber(-120, 120), 0.13, rng:NextNumber(1980, 2180)), 1)
	end
end

return Castle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Cemetery</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 2: Cemetery (Z 260..540). Cobblestone path along X = 0 from gate to gate, a giant
-- mausoleum in the north-west corner (tall dome + glowing spire orb, visible from spawn),
-- small crypts, rows of oversized slate gravestones, twisted trees, lanterns, neon cracks,
-- candy mushrooms, iron fences and slow purple fog. Palette: dark green, stone gray, muted
-- purple, warm lantern orange, ectoplasm green. Glow is kept to the lanterns, candles, crypt
-- doorways, the spire orb and the small ectoplasm cracks.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Cemetery = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local STONES = { C(158, 156, 170), C(140, 146, 150), C(175, 170, 182), C(150, 145, 168), C(128, 136, 138) }
local EPITAPHS = { "RIP", "BRB", "BOO", "LOL", "GG", "AFK", "R.I.P.\nIN PEACE", "BE BACK\nSOON", "NOT\nHERE" }

-- Gable roof with the ridge along local X (slopes toward local ±Z), bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3)
	local half = depth / 2
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, { Solid = true, Shadow = true })
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, { Solid = true, Shadow = true })
end

local function mausoleum(f: Instance)
	local m = Kit.Model(f, "Mausoleum")
	local stone, light, roof = C(178, 174, 190), C(214, 210, 220), C(92, 74, 128)
	local glow = C(120, 255, 170)
	local mint = Kit.Vivid(glow) -- solid trims in the glow colour
	-- stepped platform
	Kit.Box(m, V(-122, 0, 477), V(-78, 1.2, 513), C(150, 140, 180), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Box(m, V(-120, 1.2, 479), V(-82, 2.4, 511), C(170, 160, 200), { Mat = Enum.Material.Slate, Solid = true })
	-- body (front faces +X toward the path)
	Kit.Box(m, V(-118, 2.4, 482), V(-90, 26, 508), stone, { Mat = Enum.Material.Slate, Solid = true, Name = "Body" })
	-- portico columns
	for i = 0, 4 do
		local z = 483.5 + i * 5.75
		Kit.Cyl(m, 22, 2.6, CFrame.new(-85.5, 13.4, z), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
		Kit.Box(m, V(-87, 2.4, z - 1.6), V(-84, 3.2, z + 1.6), light)
	end
	-- entablature + cornice
	Kit.Box(m, V(-119, 24.4, 480), V(-83, 27, 510), light, { Mat = Enum.Material.Marble, Solid = true })
	Kit.Box(m, V(-83.3, 25, 483), V(-82.9, 26.4, 507), mint)
	-- pediment roof (triangle face toward +X)
	gable(m, CFrame.new(-101, 27, 495), 37, 31, 9, roof)
	-- ectoplasm-filled doorway (solid mint, lit by its own green light)
	Kit.Box(m, V(-90.3, 2.4, 487.5), V(-89.9, 17.5, 502.5), light)
	local door = Kit.Box(m, V(-90.1, 2.4, 489), V(-89.6, 16, 501), mint, { Refl = 0.1 })
	Kit.Light(door, glow, 30, 2)
	-- name plate on the entablature, facing +X
	local plateCF = CFrame.new(-82.7, 25.7, 495) * CFrame.Angles(0, Kit.FaceYaw(1, 0), 0)
	local plate = Kit.Part(m, V(18, 2.4, 0.4), plateCF, C(60, 40, 100))
	Kit.Sign(plate, Enum.NormalId.Front, "REST IN PURPLE", C(150, 255, 170))
	-- drum + dome + spire (tall: visible from spawn)
	Kit.Cyl(m, 12, 15, CFrame.new(-104, 36, 495), light, { Mat = Enum.Material.Marble, Solid = true, Shadow = true })
	Kit.Cyl(m, 1, 16.5, CFrame.new(-104, 42.2, 495), mint)
	Kit.Ball(m, 15, V(-104, 42.5, 495), C(112, 92, 150), { Mat = Enum.Material.Slate, Shadow = true })
	Kit.Cyl(m, 14, 1.4, CFrame.new(-104, 56, 495), C(240, 220, 120))
	local orb = Kit.Ball(m, 4.5, V(-104, 64, 495), glow, { Mat = NEON })
	Kit.Light(orb, glow, 40, 1.5)
	Kit.Emitter(orb, glow, 2, 4, 0.8)
	-- corner obelisks
	for _, x in { -121, -79 } do
		for _, z in { 476, 514 } do
			Kit.Box(m, V(x - 1.2, 0, z - 1.2), V(x + 1.2, 12, z + 1.2), light, { Mat = Enum.Material.Slate, Solid = true })
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z - 0.6), light)
			Kit.Wedge(m, V(2.4, 2, 1.2), CFrame.new(x, 13, z + 0.6) * CFrame.Angles(0, math.pi, 0), light)
			Kit.Ball(m, 1.6, V(x, 14.6, z), mint)
		end
	end
	-- floating candles by the door
	for i = 0, 3 do
		Props.FloatingCandle(m, V(-80, 8 + (i % 2) * 2.5, 486 + i * 6))
	end
	Kit.AddRect(-124, 474, -76, 516)
end

local function crypt(f: Instance, cx: number, cz: number, fx: number, fz: number, flicker: boolean)
	local m = Kit.Model(f, "Crypt")
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local stone = Kit.Pick(STONES)
	Kit.Part(m, V(15, 1, 13), base * CFrame.new(0, 0.5, 0), C(120, 122, 130), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(12, 10, 10), base * CFrame.new(0, 6, 0), stone, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	-- roof ridge runs front-to-back (local Z) so the triangle faces the front
	gable(m, base * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.pi / 2, 0), 12, 14, 5, C(96, 78, 132))
	local glow = Kit.Pick({ C(120, 255, 170), C(200, 130, 255) })
	local door = Kit.Part(m, V(4.4, 7, 0.4), base * CFrame.new(0, 4.5, -5.1), glow, { Mat = NEON, Transp = 0.15 })
	local trim: Kit.Opts = { Mat = Enum.Material.Marble }
	Kit.Part(m, V(5.6, 8.2, 0.3), base * CFrame.new(0, 4.6, -5.05), C(214, 210, 220), trim)
	Kit.Part(m, V(1, 3.6, 0.6), base * CFrame.new(0, 13.5, -6.3), C(214, 210, 220), trim)
	Kit.Part(m, V(2.6, 1, 0.6), base * CFrame.new(0, 14.2, -6.3), C(214, 210, 220), trim)
	if flicker then
		Kit.Light(door, glow, 16, 1.4, true)
	end
	Props.FloatingCandle(m, (base * CFrame.new(-4, 7.5, -7.5)).Position)
	Kit.AddCircle(cx, cz, 10)
end

local function gravestone(f: Instance, x: number, z: number)
	local rng = Kit.Rng
	local w = rng:NextNumber(3.6, 5.2)
	local h = rng:NextNumber(3.5, 6)
	local yaw = rng:NextNumber(-0.25, 0.25)
	local tilt = rng:NextNumber(-0.08, 0.08)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt, 0, tilt * 0.5)
	local col = Kit.Pick(STONES)
	local kind = rng:NextInteger(1, 6)
	if kind == 6 then
		-- cross
		Kit.Part(f, V(1.4, h + 2, 1), base * CFrame.new(0, (h + 2) / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Part(f, V(w * 0.8, 1.2, 1), base * CFrame.new(0, h * 0.75 + 0.6, 0), col, { Mat = Enum.Material.Slate })
	else
		local slab = Kit.Part(f, V(w, h, 1.2), base * CFrame.new(0, h / 2, 0), col, { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
		Kit.Part(f, V(1.2, w, w), base * CFrame.new(0, h, 0) * CFrame.Angles(0, math.pi / 2, 0), col, { Mat = Enum.Material.Slate, Shape = Enum.PartType.Cylinder })
		if kind <= 2 then
			Kit.Sign(slab, Enum.NormalId.Front, Kit.Pick(EPITAPHS), C(90, 60, 130), { Stroke = C(235, 235, 240), Font = Enum.Font.GothamBlack })
		elseif kind == 3 then
			Kit.Part(f, V(w * 0.5, 0.3, 0.2), base * CFrame.new(0, h * 0.55, -0.65), Kit.Vivid(C(120, 255, 170)))
		end
	end
	-- little dirt mound in front
	Kit.Part(f, V(w + 0.6, 0.4, 3.4), base * CFrame.new(0, 0.1, -2.4), C(92, 78, 70), { Mat = Enum.Material.Ground })
	Kit.AddCircle(x, z, 2.5)
end

function Cemetery.Build(map: Instance)
	local f = Kit.Folder(map, "Cemetery")
	local rng = Kit.Rng

	-- main path + branch to the mausoleum
	Kit.Box(f, V(-8, -0.4, 260), V(8, 0.1, 540), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true, Name = "Path" })
	Kit.Box(f, V(-80, -0.4, 490), V(-8, 0.08, 500), C(150, 146, 158), { Mat = Enum.Material.Cobblestone, Solid = true })
	local edging = Kit.Vivid(C(120, 255, 170))
	for z = 270, 530, 20 do
		for _, s in { -1, 1 } do
			Kit.Box(f, V(s * 8, 0.1, z), V(s * 8.6, 0.25, z + 10), edging)
		end
	end
	Kit.AddRect(-9, 260, 9, 540, true)
	Kit.AddRect(-80, 489, -8, 501, true)

	mausoleum(f)
	crypt(f, 112, 300, -1, 0, true)
	crypt(f, -110, 345, 1, 0, true)
	crypt(f, 116, 500, -1, 0, false)
	crypt(f, -116, 392, 1, 0, false)

	-- lanterns along the path
	local lit = 0
	for z = 280, 530, 30 do
		for _, s in { -1, 1 } do
			local x = s * 10.5
			if Kit.IsFree(x, z, 1, true) then
				lit += 1
				-- warm orange lanterns on the left, ectoplasm green on the right
				Props.Lantern(f, V(x, 0, z), if s < 0 then C(255, 170, 80) else C(140, 255, 170), lit % 3 == 1 and lit <= 10)
				Kit.AddCircle(x, z, 1.5)
			end
		end
	end

	-- twisted trees (tall ones near the back so they show over the wall from spawn)
	local treeSpots = {
		{ -125, 280, 26 }, { 126, 285, 24 }, { -100, 300, 30 }, { 45, 292, 22 }, { -30, 380, 26 }, { 110, 410, 30 },
		{ 128, 430, 34 }, { -128, 455, 36 }, { 30, 470, 28 }, { 100, 470, 34 }, { -60, 522, 38 }, { 60, 525, 40 },
		{ -128, 525, 34 }, { 128, 525, 36 },
	}
	for _, t in treeSpots do
		if Kit.IsFree(t[1], t[2], 4) then
			Props.TwistedTree(f, V(t[1], 0, t[2]), t[3])
		end
	end

	-- gravestone field on a jittered grid
	for gx = -128, 128, 11 do
		for gz = 272, 532, 12 do
			local x = gx + rng:NextNumber(-2, 2)
			local z = gz + rng:NextNumber(-2, 2)
			if rng:NextNumber() < 0.45 and Kit.IsFree(x, z, 4.2) then -- the dirt mound reaches ~4 studs
				gravestone(f, x, z)
			end
		end
	end

	-- iron fences around the mausoleum yard and a few decorative runs
	Props.Fence(f, V(-126, 0, 472), V(-84, 0, 472), "iron")
	Props.Fence(f, V(-126, 0, 518), V(-84, 0, 518), "iron")
	Props.Fence(f, V(-133, 0, 300), V(-133, 0, 330), "iron")
	Props.Fence(f, V(133, 0, 330), V(133, 0, 360), "iron")

	-- neon ectoplasm cracks in the ground (flat, fine inside ghost areas)
	for _ = 1, 16 do
		local p = V(rng:NextNumber(-120, 120), 0.1, rng:NextNumber(275, 530))
		local a = rng:NextNumber(0, math.pi * 2)
		for _ = 1, 3 do
			a += rng:NextNumber(-1, 1)
			local q = p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(3, 6)
			Props.Beam(f, p, q, 0.5, 0.12, C(120, 255, 170), { Mat = NEON })
			p = q
		end
	end

	-- glowing mushrooms
	local shrooms = 0
	for _ = 1, 200 do
		if shrooms >= 14 then
			break
		end
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(270, 530)
		if Kit.IsFree(x, z, 2.5) then
			shrooms += 1
			Props.Mushrooms(f, V(x, 0, z))
			Kit.AddCircle(x, z, 2.5)
		end
	end

	-- slow purple fog
	for _, p in { V(-40, 0, 300), V(40, 0, 395), V(-95, 0, 470), V(95, 0, 330), V(30, 0, 520) } do
		Props.Wisp(f, p, C(170, 110, 255), 14, true)
	end
	for _, p in { V(-60, 0, 360), V(80, 0, 500), V(-20, 0, 460) } do
		Props.Wisp(f, p, C(120, 255, 170), 10, false)
	end
end

return Cemetery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Clockwork</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 14: Clockwork Tower (Z 4480..4840). A steampunk town square in brass, copper and wood.
--   Ground: cobblestone slab + brick lane along X = 0 with brass edging.
--   Ghost areas get flat gear-shaped plazas ((0,4565) r30, (-82,4600) r24, (75,4660) r26,
--   (-62,4720) r24); the boss area (0,4785) r26 is a giant clock face painted on the square.
--   Cogwheel bridges over the lane at Z 4625 and Z 4745 (deck bottom Y 30).
--   Landmark seen from the Sunken City: the clock tower at (64, 4808), spire tip ~Y 150.
--   Shops along the sides, brass lamp posts, a gear monument, a grandfather clock, giant
--   gears and steam pipes on the side walls (brick, X +-140..146), a chimney skyline and an
--   airship outside.
-- Glow: lamp globes, a couple of shop windows, the tower clock and the monument gem.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Clockwork = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local BRICK = Enum.Material.Brick
local COBBLE = Enum.Material.Cobblestone
local WOOD = Enum.Material.WoodPlanks

local Z0, Z1 = 4480, 4840

local BRASS = C(215, 170, 85)
local BRASS_D = C(170, 130, 70)
local COPPER = C(190, 110, 70)
local VERDI = C(90, 175, 160) -- teal verdigris accents
local BROWN = C(120, 80, 55)
local BRICKC = C(160, 95, 70)
local CREAM = C(240, 225, 190)
local COBBLEC = C(150, 132, 118)
local DARK = C(55, 40, 35)
local WARM = C(255, 210, 130)
local IRON = C(70, 62, 60)

local SOLID_BRICK: Kit.Opts = { Mat = BRICK, Solid = true, Shadow = true }
local BRASS_M: Kit.Opts = { Mat = METAL }

local AREAS = { { 0, Z0 + 85, 30 }, { -82, Z0 + 120, 24 }, { 75, Z0 + 180, 26 }, { -62, Z0 + 240, 24 } }
local BOSS_Z = Z0 + 305

--==================================================================
-- HELPERS
--==================================================================
-- Gear standing upright: axis "X" (faces +-X) or "Z" (faces +-Z). pos = centre.
local function gear(parent: Instance, pos: Vector3, d: number, axis: string, color: Color3, teeth: number, thick: number?)
	local t = thick or 1.2
	local R = d / 2
	local tooth = math.max(1, d * 0.12)
	Kit.CylFlat(parent, t, d, pos, axis, color, BRASS_M)
	Kit.CylFlat(parent, t + 0.3, d * 0.62, pos, axis, color:Lerp(Color3.new(0, 0, 0), 0.18), BRASS_M)
	Kit.CylFlat(parent, t + 0.8, d * 0.22, pos, axis, Kit.Vivid(COPPER), BRASS_M)
	for i = 0, teeth - 1 do
		local a = i * math.pi * 2 / teeth
		if axis == "X" then
			Kit.Part(parent, V(t, tooth, tooth * 1.1), CFrame.new(pos + V(0, math.sin(a), math.cos(a)) * (R + tooth * 0.35)) * CFrame.Angles(math.pi / 2 - a, 0, 0), color, BRASS_M)
		else
			Kit.Part(parent, V(tooth * 1.1, tooth, t), CFrame.new(pos + V(math.cos(a), math.sin(a), 0) * (R + tooth * 0.35)) * CFrame.Angles(0, 0, a - math.pi / 2), color, BRASS_M)
		end
	end
end

-- Clock face facing (nx, nz); pos = centre of the face.
local function clockFace(parent: Instance, pos: Vector3, d: number, nx: number, nz: number, glow: boolean)
	local cf = CFrame.new(pos) * CFrame.Angles(0, Kit.FaceYaw(nx, nz), 0)
	local axisZ = CFrame.Angles(0, math.pi / 2, 0)
	Kit.Part(parent, V(1, d + 2, d + 2), cf * axisZ, Kit.Vivid(BRASS), { Mat = METAL, Shape = Enum.PartType.Cylinder })
	local faceOpts: Kit.Opts = if glow then { Mat = NEON, Shape = Enum.PartType.Cylinder } else { Shape = Enum.PartType.Cylinder }
	local face = Kit.Part(parent, V(0.4, d, d), cf * CFrame.new(0, 0, -0.6) * axisZ, if glow then C(255, 240, 200) else CREAM, faceOpts)
	if d >= 8 then
		local panel = Kit.Part(parent, V(d * 0.9, d * 0.9, 0.05), cf * CFrame.new(0, 0, -0.85), CREAM, { Transp = 1, Name = "ClockNumerals" })
		local gui = Kit.Gui(panel, Enum.NormalId.Front, 20)
		local ink = C(70, 45, 30)
		local st = CREAM
		Kit.Label(gui, "XII", ink, { Pos = UDim2.fromScale(0.38, 0.02), Size = UDim2.fromScale(0.24, 0.15), Stroke = st })
		Kit.Label(gui, "III", ink, { Pos = UDim2.fromScale(0.8, 0.43), Size = UDim2.fromScale(0.18, 0.14), Stroke = st })
		Kit.Label(gui, "VI", ink, { Pos = UDim2.fromScale(0.4, 0.84), Size = UDim2.fromScale(0.2, 0.14), Stroke = st })
		Kit.Label(gui, "IX", ink, { Pos = UDim2.fromScale(0.02, 0.43), Size = UDim2.fromScale(0.18, 0.14), Stroke = st })
	end
	Kit.Part(parent, V(d * 0.05, d * 0.4, 0.15), cf * CFrame.new(0, d * 0.18, -1), DARK)
	Kit.Part(parent, V(d * 0.07, d * 0.28, 0.15), cf * CFrame.new(0, 0, -1.1) * CFrame.Angles(0, 0, 1.0) * CFrame.new(0, d * 0.12, 0), DARK)
	Kit.Ball(parent, d * 0.09, (cf * CFrame.new(0, 0, -1.1)).Position, Kit.Vivid(BRASS), BRASS_M)
	return face
end

local function lamp(parent: Instance, x: number, z: number, light: boolean)
	local m = Kit.Model(parent, "BrassLamp")
	Kit.Disc(m, x, z, 1, 2.6, 1, BRASS_D, BRASS_M)
	Kit.Cyl(m, 12, 0.7, CFrame.new(x, 7, z), IRON, BRASS_M)
	Kit.Cyl(m, 0.6, 2.8, CFrame.new(x, 13.2, z), Kit.Vivid(BRASS), BRASS_M)
	local globe = Kit.Ball(m, 2.4, V(x, 14.6, z), WARM, { Mat = NEON })
	Kit.Cyl(m, 0.8, 3, CFrame.new(x, 16.1, z), Kit.Vivid(COPPER), BRASS_M)
	Kit.Ball(m, 0.8, V(x, 16.9, z), Kit.Vivid(BRASS), BRASS_M)
	if light then
		Kit.Light(globe, WARM, 24, 1.5)
	end
	Kit.AddCircle(x, z, 2)
end

local function shop(f: Instance, x: number, z: number, w: number, d: number, h: number, wall: Color3, roof: Color3, name: string, glow: boolean)
	local m = Kit.Model(f, "Shop")
	local fx = if x > 0 then -1 else 1
	local front = x + fx * w / 2
	Kit.Box(m, V(x - w / 2, 0, z - d / 2), V(x + w / 2, h, z + d / 2), wall, SOLID_BRICK)
	Kit.Box(m, V(x - w / 2 - 0.4, 0, z - d / 2 - 0.4), V(x + w / 2 + 0.4, 1.6, z + d / 2 + 0.4), DARK, { Mat = Enum.Material.Slate })
	Kit.Box(m, V(x - w / 2 - 1, h, z - d / 2 - 1), V(x + w / 2 + 1, h + 1.2, z + d / 2 + 1), CREAM, { Mat = WOOD })
	-- gable roof (ridge along Z)
	local rh = w * 0.35
	for _, s in { -1, 1 } do
		local cf = CFrame.new(x + s * (w / 2 + 1) / 2, h + 1.2 + rh / 2, z) * CFrame.Angles(0, Kit.FaceYaw(s, 0), 0)
		Kit.Wedge(m, V(d + 2, rh, w / 2 + 1), cf, roof, { Mat = METAL, Shadow = true })
	end
	-- front: door, round window, two square windows, sign, gear
	local fcf = CFrame.new(front, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	Kit.Part(m, V(5, 8, 0.4), fcf * CFrame.new(0, 4, -0.2), BROWN, { Mat = WOOD })
	Kit.Part(m, V(6, 0.8, 0.6), fcf * CFrame.new(0, 8.4, -0.3), Kit.Vivid(BRASS), BRASS_M)
	local winOpts: Kit.Opts = if glow then { Mat = NEON } else { Refl = 0.2 }
	local winC = if glow then WARM else C(150, 205, 200)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(4.6, 5.6, 0.5), fcf * CFrame.new(s * d / 4, h * 0.42, -0.1), Kit.Vivid(BRASS), BRASS_M)
		Kit.Part(m, V(3.8, 4.8, 0.3), fcf * CFrame.new(s * d / 4, h * 0.42, -0.3), winC, winOpts)
	end
	Kit.Part(m, V(0.5, 6.6, 6.6), fcf * CFrame.new(0, h * 0.75, -0.1) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(BRASS), { Mat = METAL, Shape = Enum.PartType.Cylinder })
	Kit.Part(m, V(0.5, 5.4, 5.4), fcf * CFrame.new(0, h * 0.75, -0.3) * CFrame.Angles(0, math.pi / 2, 0), Kit.Vivid(VERDI), { Refl = 0.2, Shape = Enum.PartType.Cylinder })
	Props.SignBoard(m, (fcf * CFrame.new(0, 10.4, -0.5)).Position, math.min(d - 4, 16), 2.4, fx, 0, name, DARK, Kit.Vivid(BRASS))
	gear(m, V(front + fx * 0.4, h - 3.5, z - d / 2 + 4), 5, "X", Kit.Vivid(COPPER), 8, 0.6)
	-- chimney
	local cx, cz = x - fx * w / 4, z + d / 4
	Kit.Cyl(m, 12, 2.8, CFrame.new(cx, h + rh * 0.5 + 6, cz), BRICKC, { Mat = BRICK })
	local cap = Kit.Cyl(m, 1, 3.6, CFrame.new(cx, h + rh * 0.5 + 12.5, cz), Kit.Vivid(COPPER), BRASS_M)
	Kit.AddRect(x - w / 2 - 1, z - d / 2 - 1, x + w / 2 + 1, z + d / 2 + 1)
	return cap
end

--==================================================================
-- GROUND, PLAZAS, WALLS, OUTSIDE
--==================================================================
local function gearPlaza(f: Instance, x: number, z: number, r: number, rim: Color3)
	local n = math.floor(r * 0.5)
	for i = 0, n - 1 do
		local a = i * math.pi * 2 / n
		Kit.Part(f, V(5, 0.06, 6), CFrame.new(x + math.cos(a) * (r + 3.5), 0.03, z + math.sin(a) * (r + 3.5)) * CFrame.Angles(0, -a, 0), rim, BRASS_M)
	end
	Kit.Disc(f, x, z, 0.07, r * 2 + 4, 0.07, rim, BRASS_M)
	Kit.Disc(f, x, z, 0.1, r * 2 - 4, 0.1, CREAM, { Mat = COBBLE })
	Kit.Disc(f, x, z, 0.13, 14, 0.13, Kit.Vivid(COPPER), BRASS_M)
	Kit.Disc(f, x, z, 0.16, 6, 0.16, Kit.Vivid(VERDI), BRASS_M)
	for i = 0, 3 do
		local a = i * math.pi / 2 + 0.4
		Props.Beam(f, V(x + math.cos(a) * 7, 0.12, z + math.sin(a) * 7), V(x + math.cos(a) * (r - 2.5), 0.12, z + math.sin(a) * (r - 2.5)), 1.6, 0.04, rim, BRASS_M)
	end
end

local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), COBBLEC, { Mat = COBBLE, Solid = true, Name = "Ground_Clockwork" })
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), C(176, 110, 82), { Mat = BRICK, Solid = true, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9, 0, Z0), V(s * 10, 0.08, Z1), Kit.Vivid(BRASS), BRASS_M)
	end
	for i, a in AREAS do
		gearPlaza(f, a[1], a[2], a[3], Kit.Vivid(if i % 2 == 0 then COPPER else BRASS))
	end
	-- boss: a giant clock face painted on the square
	local gold = Kit.Vivid(BRASS)
	Kit.Disc(f, 0, BOSS_Z, 0.07, 58, 0.07, gold, BRASS_M)
	Kit.Disc(f, 0, BOSS_Z, 0.1, 54, 0.1, CREAM, { Mat = Enum.Material.Marble })
	for i = 0, 11 do
		local a = i * math.pi / 6
		local big = i % 3 == 0
		Kit.Part(f, V(if big then 2 else 1.2, 0.04, if big then 5 else 3), CFrame.new(math.cos(a) * 23, 0.12, BOSS_Z + math.sin(a) * 23) * CFrame.Angles(0, -a + math.pi / 2, 0), DARK)
	end
	Props.Beam(f, V(0, 0.14, BOSS_Z), V(0, 0.14, BOSS_Z - 20), 1.6, 0.04, DARK)
	Props.Beam(f, V(0, 0.15, BOSS_Z), V(-11, 0.15, BOSS_Z - 6), 2.2, 0.04, DARK)
	Kit.Disc(f, 0, BOSS_Z, 0.18, 5, 0.06, gold, BRASS_M)
end

local function sideWalls(f: Instance)
	local z0, z1 = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, -0.5, z0), V(s * 146, 30, z1), BRICKC, SOLID_BRICK)
		Kit.Box(f, V(s * 139.5, 30, z0), V(s * 146.5, 31.4, z1), Kit.Vivid(COPPER), BRASS_M)
		Kit.Box(f, V(s * 139.6, 0, z0), V(s * 140.05, 2.4, z1), DARK, { Mat = Enum.Material.Slate }) -- sunk into the wall (z-fighting with the pilasters)
		for z = Z0 + 40, Z1 - 20, 40 do
			Kit.Box(f, V(s * 137.6, 0, z - 2), V(s * 140, 32, z + 2), CREAM, { Mat = Enum.Material.Concrete, Solid = true })
		end
		-- steam pipe along the wall with flanges and a valve
		Kit.CylFlat(f, z1 - z0, 2.4, V(s * 138.4, 5, (z0 + z1) / 2), "Z", Kit.Vivid(COPPER), BRASS_M)
		for z = Z0 + 20, Z1 - 20, 40 do
			Kit.CylFlat(f, 0.8, 3.2, V(s * 138.4, 5, z), "Z", Kit.Vivid(BRASS), BRASS_M)
		end
		-- giant gears on the inner face
		for i, g in { { Z0 + 100, 26, 21 }, { Z0 + 220, 30, 19 }, { Z0 + 320, 24, 22 } } do
			gear(f, V(s * 139.2, g[3], g[1]), g[2], "X", Kit.Vivid(if (i + (if s > 0 then 1 else 0)) % 2 == 0 then COPPER else BRASS), 9)
		end
	end
	-- steam vent stack on the west wall
	Kit.Cyl(f, 26, 1.8, CFrame.new(-137.8, 18, Z0 + 170), Kit.Vivid(COPPER), BRASS_M)
	Kit.CylFlat(f, 0.5, 3.4, V(-136.6, 7, Z0 + 170), "X", Kit.Vivid(VERDI), BRASS_M)
	local vent = Kit.Cyl(f, 1, 2.6, CFrame.new(-137.8, 31.5, Z0 + 170), Kit.Vivid(BRASS), BRASS_M)
	local e = Kit.Emitter(vent, C(240, 240, 245), 4, 5, 2.5)
	if e then
		e.Acceleration = V(0, 2, 0)
	end
end

local function outside(f: Instance)
	local rng = Kit.Rng
	local walls = { C(150, 95, 70), C(130, 100, 80), C(170, 120, 85), C(120, 85, 70) }
	for i = 0, 4 do
		local z = Z0 + 30 + i * 75
		for _, s in { -1, 1 } do
			local w, h = rng:NextNumber(18, 26), rng:NextNumber(28, 48)
			local x = s * (150 + w / 2 + rng:NextNumber(0, 10))
			local col = Kit.Pick(walls)
			Kit.Box(f, V(x - w / 2, 0, z - 12), V(x + w / 2, h, z + 12), col, { Mat = BRICK })
			Kit.Wedge(f, V(w, 8, 12), CFrame.new(x, h + 4, z - 6), Kit.Vivid(if i % 2 == 0 then COPPER else VERDI), BRASS_M)
			Kit.Wedge(f, V(w, 8, 12), CFrame.new(x, h + 4, z + 6) * CFrame.Angles(0, math.pi, 0), Kit.Vivid(if i % 2 == 0 then COPPER else VERDI), BRASS_M)
			local ch = rng:NextNumber(14, 24)
			Kit.Cyl(f, ch, 3, CFrame.new(x + s * 4, h + ch / 2, z + 6), BRICKC, { Mat = BRICK })
		end
	end
	-- airship drifting over the east rooftops
	local a = V(196, 82, Z0 + 170)
	Kit.CylFlat(f, 44, 18, a, "Z", C(205, 90, 75), { Mat = Enum.Material.Fabric })
	Kit.Ball(f, 18, a + V(0, 0, -22), C(205, 90, 75), { Mat = Enum.Material.Fabric })
	Kit.Ball(f, 18, a + V(0, 0, 22), C(205, 90, 75), { Mat = Enum.Material.Fabric })
	for _, dz in { -12, 0, 12 } do
		Kit.CylFlat(f, 18.6, 1, a + V(0, 0, dz), "X", Kit.Vivid(BRASS), BRASS_M)
	end
	Kit.Box(f, a + V(-4, -15, -9), a + V(4, -10, 9), BROWN, { Mat = WOOD })
	Kit.Wedge(f, V(0.6, 10, 8), CFrame.new(a + V(0, 4, 30)), Kit.Vivid(VERDI))
	gear(f, a + V(0, -12.5, 10.5), 6, "Z", Kit.Vivid(BRASS), 8, 0.6)
end

--==================================================================
-- LANDMARKS
--==================================================================
local function clockTower(f: Instance)
	local m = Kit.Model(f, "ClockTower")
	local x, z = 64, Z0 + 328
	local gold = Kit.Vivid(BRASS)
	Kit.Box(m, V(x - 13, 0, z - 13), V(x + 13, 10, z + 13), C(130, 110, 100), { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 11, 10, z - 11), V(x + 11, 80, z + 11), BRICKC, SOLID_BRICK)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Box(m, V(x + sx * 11 - 1.6, 10, z + sz * 11 - 1.6), V(x + sx * 11 + 1.6, 80, z + sz * 11 + 1.6), CREAM, { Mat = Enum.Material.Concrete })
		end
	end
	for _, y in { 40, 79 } do
		Kit.Box(m, V(x - 12, y, z - 12), V(x + 12, y + 1.6, z + 12), Kit.Vivid(COPPER), BRASS_M)
	end
	-- clock stage with four faces
	Kit.Box(m, V(x - 13, 80.6, z - 13), V(x + 13, 102, z + 13), CREAM, { Mat = Enum.Material.Concrete, Shadow = true })
	local front = clockFace(m, V(x, 91, z - 13.6), 18, 0, -1, true)
	Kit.Light(front, WARM, 40, 1.5)
	clockFace(m, V(x - 13.6, 91, z), 18, -1, 0, false)
	clockFace(m, V(x + 13.6, 91, z), 18, 1, 0, false)
	clockFace(m, V(x, 91, z + 13.6), 18, 0, 1, false)
	-- belfry with a big brass bell
	Kit.Box(m, V(x - 13, 102, z - 13), V(x + 13, 103, z + 13), Kit.Vivid(COPPER), BRASS_M)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.Box(m, V(x + sx * 11.5 - 1.5, 103, z + sz * 11.5 - 1.5), V(x + sx * 11.5 + 1.5, 115, z + sz * 11.5 + 1.5), CREAM, { Mat = Enum.Material.Concrete })
		end
	end
	Kit.Ball(m, 9, V(x, 108, z), gold, BRASS_M)
	Kit.Cyl(m, 1.2, 10, CFrame.new(x, 104.4, z), gold, BRASS_M)
	-- stepped copper roof, spire and a gear weathervane
	local sizes = { 28, 22, 16, 10, 5 }
	for i, s in sizes do
		local y = 115 + (i - 1) * 4
		Kit.Box(m, V(x - s / 2, y, z - s / 2), V(x + s / 2, y + 4, z + s / 2), Kit.Vivid(if i % 2 == 1 then VERDI else COPPER), { Mat = METAL, Shadow = true })
	end
	Kit.Cyl(m, 12, 1, CFrame.new(x, 141, z), gold, BRASS_M)
	gear(m, V(x, 149, z), 6, "Z", gold, 8, 0.6)
	-- big gear on the front of the shaft, door and sign toward the lane
	gear(m, V(x, 58, z - 11.8), 16, "Z", Kit.Vivid(BRASS), 12)
	Kit.Box(m, V(x - 13.4, 0, z - 5), V(x - 13, 9, z + 5), BROWN, { Mat = WOOD })
	Kit.Box(m, V(x - 13.6, 9, z - 6), V(x - 13, 10, z + 6), gold, BRASS_M)
	Props.SignBoard(m, V(x - 13.7, 13, z), 18, 3, -1, 0, "TICK-TOCK TOWER", DARK, gold)
	Kit.AddRect(x - 14, z - 14, x + 14, z + 14)
end

local function cogBridge(f: Instance, z: number, title: string)
	local m = Kit.Model(f, "CogBridge")
	local gold = Kit.Vivid(BRASS)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(s * 16, 0, z - 4.5), V(s * 26, 34, z + 4.5), BRICKC, SOLID_BRICK)
		Kit.Box(m, V(s * 15.6, 0, z - 4.9), V(s * 26.4, 3, z + 4.9), DARK, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(m, V(s * 15.6, 34, z - 4.9), V(s * 26.4, 35.4, z + 4.9), Kit.Vivid(COPPER), BRASS_M)
		gear(m, V(s * 21, 18, z - 4.9), 8, "Z", gold, 8, 0.6)
		Kit.AddRect(s * 15.5, z - 5, s * 26.5, z + 5)
	end
	-- deck (bottom Y 30) with brass railings and a big cog standing on it
	Kit.Box(m, V(-16, 30, z - 3), V(16, 32.4, z + 3), BROWN, { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Box(m, V(-16, 29.6, z - 3.3), V(16, 30.2, z + 3.3), gold, BRASS_M)
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(-16, 34.6, z + sz * 2.8 - 0.25), V(16, 35.1, z + sz * 2.8 + 0.25), gold, BRASS_M)
		for x = -14, 14, 7 do
			Kit.Box(m, V(x - 0.2, 32.4, z + sz * 2.8 - 0.2), V(x + 0.2, 34.6, z + sz * 2.8 + 0.2), gold, BRASS_M)
		end
	end
	gear(m, V(0, 39, z), 12, "Z", Kit.Vivid(COPPER), 10, 1)
	Props.SignBoard(m, V(0, 31.2, z - 3.4), 18, 2.2, 0, -1, title, DARK, gold)
end

local function gearMonument(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GearMonument")
	Kit.Box(m, V(x - 7, 0, z - 3.5), V(x + 7, 3, z + 3.5), C(130, 110, 100), { Mat = Enum.Material.Slate, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1, 3, z - 1), V(x + 1, 11, z + 1), IRON, BRASS_M)
	gear(m, V(x - 1.5, 13, z), 16, "Z", Kit.Vivid(BRASS), 12)
	gear(m, V(x + 9.2, 6.8, z + 0.4), 8, "Z", Kit.Vivid(COPPER), 8)
	local gem = Kit.Ball(m, 2.2, V(x - 1.5, 13, z - 1.2), Kit.Vivid(VERDI), { Mat = NEON })
	Kit.Light(gem, C(150, 255, 230), 24, 1.2)
	Props.SignBoard(m, V(x, 1.6, z - 3.7), 9, 1.8, 0, -1, "THE GREAT COG", DARK, Kit.Vivid(BRASS))
	Kit.AddCircle(x, z, 10)
end

local function grandfatherClock(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "GrandfatherClock")
	Kit.Box(m, V(x - 3.4, 0, z - 2.4), V(x + 3.4, 2, z + 2.4), BROWN, { Mat = WOOD, Solid = true })
	Kit.Box(m, V(x - 2.6, 2, z - 1.8), V(x + 2.6, 17, z + 1.8), C(140, 90, 60), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Box(m, V(x - 1.6, 4, z - 1.95), V(x + 1.6, 14, z - 1.8), C(150, 205, 200), { Transp = 0.4, Refl = 0.2 })
	Kit.Box(m, V(x - 0.15, 8, z - 1.4), V(x + 0.15, 14, z - 1.2), Kit.Vivid(BRASS), BRASS_M)
	Kit.CylFlat(m, 0.3, 2.4, V(x, 7.6, z - 1.3), "Z", Kit.Vivid(BRASS), BRASS_M)
	Kit.Box(m, V(x - 3.4, 17, z - 2.4), V(x + 3.4, 24, z + 2.4), C(140, 90, 60), { Mat = WOOD, Shadow = true })
	clockFace(m, V(x, 20.5, z - 2.9), 5, 0, -1, false)
	Kit.Wedge(m, V(7.4, 2.6, 2.6), CFrame.new(x, 25.3, z - 1.3), BROWN, { Mat = WOOD })
	Kit.Wedge(m, V(7.4, 2.6, 2.6), CFrame.new(x, 25.3, z + 1.3) * CFrame.Angles(0, math.pi, 0), BROWN, { Mat = WOOD })
	Kit.Ball(m, 1.4, V(x, 27, z), Kit.Vivid(BRASS), BRASS_M)
	Kit.AddCircle(x, z, 4.5)
end

local function floaters(f: Instance)
	for _, p in { V(40, 22, Z0 + 120), V(-40, 26, Z0 + 200), V(110, 24, Z0 + 120), V(-112, 28, Z0 + 280), V(-22, 20, Z0 + 340), V(96, 30, Z0 + 296) } do
		local g = Kit.CylFlat(f, 0.6, 3.4, p, "Z", Kit.Vivid(Kit.Pick({ BRASS, COPPER, VERDI })), { Mat = METAL, Name = "FloatingCog" })
		Kit.Float(g, 1.4)
	end
end

local function decor(f: Instance)
	local rng = Kit.Rng
	local wallCols = { C(160, 95, 70), C(190, 150, 110), C(140, 110, 90), C(175, 120, 85) }
	local roofs = { Kit.Vivid(VERDI), Kit.Vivid(COPPER), C(110, 70, 60) }
	type ShopDef = { X: number, Z: number, W: number, D: number, H: number, Name: string, Glow: boolean }
	local shops: { ShopDef } = {
		{ X = 92, Z = Z0 + 60, W = 34, D = 28, H = 18, Name = "GEARS & CO.", Glow = false },
		{ X = -100, Z = Z0 + 55, W = 32, D = 26, H = 16, Name = "TEA & TICKS", Glow = true },
		{ X = 112, Z = Z0 + 250, W = 28, D = 32, H = 20, Name = "CHRONO CURIOS", Glow = false },
		{ X = -110, Z = Z0 + 180, W = 26, D = 30, H = 17, Name = "BOLT BAKERY", Glow = false },
		{ X = -104, Z = Z0 + 318, W = 32, D = 28, H = 19, Name = "STEAM WORKS", Glow = false },
	}
	local smokeCap: Part? = nil
	for i, s in shops do
		if Kit.IsFree(s.X, s.Z, math.max(s.W, s.D) / 2 + 1) then
			local cap = shop(f, s.X, s.Z, s.W, s.D, s.H, wallCols[(i - 1) % #wallCols + 1], roofs[(i - 1) % #roofs + 1], s.Name, s.Glow)
			if i == 5 then
				smokeCap = cap
			end
			if s.Glow then
				-- the glowing tea shop gets a cosy flickering light just inside its front
				local fx = if s.X > 0 then -1 else 1
				local win = Kit.Part(f, V(1, 1, 1), CFrame.new(s.X + fx * (s.W / 2 - 1), 7, s.Z), WARM, { Transp = 1, Name = "ShopGlow" })
				Kit.Light(win, WARM, 22, 1.3, true)
			end
		end
	end
	if smokeCap then
		local e = Kit.Emitter(smokeCap, C(230, 225, 220), 3, 5, 2)
		if e then
			e.Acceleration = V(0, 1.5, 0)
		end
	end
	-- lamp posts along the lane
	local lit = 0
	for _, z in { Z0 + 40, Z0 + 125, Z0 + 175, Z0 + 225 } do
		for _, sx in { -1, 1 } do
			local x = sx * 13.5
			if Kit.IsFree(x, z, 2.5) then
				local light = lit < 3 and ((z == Z0 + 40 and sx > 0) or (z == Z0 + 175 and sx < 0) or (z == Z0 + 225 and sx > 0))
				if light then
					lit += 1
				end
				lamp(f, x, z, light)
			end
		end
	end
	if Kit.IsFree(-30, Z0 + 180, 10) then
		gearMonument(f, -30, Z0 + 180)
	end
	if Kit.IsFree(32, Z0 + 225, 5) then
		grandfatherClock(f, 32, Z0 + 225)
	end
	-- crates, barrels and loose cogs
	local crates, barrels = 0, 0
	for _ = 1, 300 do
		local x, z = rng:NextNumber(-130, 130), rng:NextNumber(Z0 + 30, Z1 - 10)
		if crates < 8 and Kit.IsFree(x, z, 3) then
			crates += 1
			local s = rng:NextNumber(3, 4.5)
			Kit.Part(f, V(s, s, s), CFrame.new(x, s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), C(170, 125, 80), { Mat = WOOD, Solid = true })
			Kit.Part(f, V(s + 0.1, 0.4, s + 0.1), CFrame.new(x, s * 0.75, z), IRON, BRASS_M)
			Kit.AddCircle(x, z, 3)
		elseif barrels < 6 and Kit.IsFree(x, z, 2.5) then
			barrels += 1
			Kit.Cyl(f, 4, 3, CFrame.new(x, 2, z), Kit.Vivid(COPPER), { Mat = METAL, Solid = true })
			Kit.Cyl(f, 0.4, 3.15, CFrame.new(x, 2.8, z), Kit.Vivid(BRASS), BRASS_M)
			Kit.AddCircle(x, z, 2.5)
		end
	end
end

--==================================================================
-- BUILD
--==================================================================
function Clockwork.Build(map: Instance)
	local f = Kit.Folder(map, "Clockwork")
	ground(f)
	sideWalls(f)
	outside(f)
	clockTower(f)
	cogBridge(f, Z0 + 145, "TICK TOCK LANE")
	cogBridge(f, Z0 + 265, "COGWHEEL CROSSING")
	floaters(f)
	decor(f)
end

return Clockwork
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Frost</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 10: Frostbite Peaks (Z 3040..3400). A bright snowy valley under an aurora.
--   Ground: snow slab (top Y = 0). Main path along X = 0: pale ice-blue paving (X -8..8,
--   top 0.05, normal friction, NOT the slippery Ice material) with lilac edges.
--   Ghost areas hold flat paint only: a frozen pond with cracks on the path (0, 3125), snow
--   drift circles, a second frozen pond (75, 3220) and the Blizzard Queen's ice rink with a big
--   snowflake (0, 3345). Frozen surfaces are smooth plastic with reflectance (walkable, not slippery).
--   Landmark: the frozen castle with a ~98-stud ice spire at (95, 3330) in front of a snowy
--   mountain range (outside the +X wall, peaks up to ~150), visible from the Swamp.
--   Also: a ski lodge and a cabin (east), igloos, snowmen, a ski rack and sled, snowy pines,
--   ice crystal clusters, a skating pond (-35, 3210). Side walls: snowbank walls with ice blocks.
--   Sky: aurora curtains (big translucent coloured planes, not neon) high above the walls,
--   gentle snowfall (one emitter).
-- Glow: a few ice-crystal tips, the spire crystal and window, lodge/igloo windows, lanterns and
-- small glints on the boss rink.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Frost = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local SNOW = Enum.Material.Snow
local ICE = Enum.Material.Ice
local GLACIER = Enum.Material.Glacier
local WOOD = Enum.Material.Wood
local ROCK = Enum.Material.Rock
local FABRIC = Enum.Material.Fabric
local SLATE = Enum.Material.Slate

local Z0, Z1 = 3040, 3400

local WHITE = C(244, 248, 255)
local SNOWC = C(236, 243, 252)
local SNOW_SHADE = C(214, 226, 246)
local ICEC = C(170, 215, 245)
local LILAC = C(196, 170, 245)
local AURORA = C(120, 255, 190)
local PATH = C(196, 220, 244)
local PINE = { C(46, 112, 92), C(56, 126, 98), C(40, 100, 90) }
local BARK = C(110, 78, 58)
local LOG = C(156, 100, 64)
local WARM = C(255, 210, 130)
local MTN = C(150, 152, 190)
local MTN_DARK = C(124, 128, 170)

local function rz(n: number): number
	return Z0 + n
end

local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material, solid: boolean)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = solid, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Flat frozen pond (non-solid sheet on the solid ground) with a snow rim.
local function frozenPond(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.04, d + 5, 0.03, WHITE, { Mat = SNOW })
	Kit.Disc(parent, x, z, 0.08, d, 0.04, ICEC, { Refl = 0.3, Name = "FrozenPond" })
end

--==================================================================
-- PROPS
--==================================================================
local function pine(parent: Instance, pos: Vector3, h: number)
	local col = Kit.Pick(PINE)
	Kit.Cyl(parent, h * 0.3, 1.8, CFrame.new(pos + V(0, h * 0.15, 0)), BARK, { Mat = WOOD, Solid = true, Shadow = true })
	for k = 0, 2 do
		local d = h * 0.62 * (1 - k * 0.27)
		local th = h * 0.2
		local y = h * 0.22 + k * h * 0.22
		Kit.Cyl(parent, th, d, CFrame.new(pos + V(0, y + th / 2, 0)), col, { Mat = Enum.Material.Grass, Shadow = true })
		Kit.Cyl(parent, 0.7, d * 0.82, CFrame.new(pos + V(0, y + th + 0.35, 0)), WHITE, { Mat = SNOW })
	end
	Kit.Ball(parent, h * 0.12, pos + V(0, h * 0.88 + 0.4, 0), WHITE, { Mat = SNOW })
	Kit.AddCircle(pos.X, pos.Z, h * 0.31)
end

local function snowman(parent: Instance, x: number, z: number, fx: number, fz: number, scarf: Color3)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	local snow: Kit.Opts = { Mat = SNOW, Solid = true }
	Kit.Ball(parent, 5, (base * CFrame.new(0, 2.2, 0)).Position, WHITE, snow)
	Kit.Ball(parent, 3.7, (base * CFrame.new(0, 5.4, 0)).Position, WHITE, { Mat = SNOW })
	Kit.Ball(parent, 2.7, (base * CFrame.new(0, 8, 0)).Position, WHITE, { Mat = SNOW })
	for _, s in { -1, 1 } do
		Kit.Ball(parent, 0.42, (base * CFrame.new(s * 0.5, 8.35, -1.15)).Position, C(30, 30, 40))
		Props.Beam(parent, (base * CFrame.new(s * 1.6, 5.8, 0)).Position, (base * CFrame.new(s * 3.6, 7.4, -0.3)).Position, 0.3, 0.3, BARK, { Mat = WOOD })
	end
	Kit.Part(parent, V(0.35, 0.35, 1.3), base * CFrame.new(0, 7.9, -1.65), Kit.Vivid(C(255, 140, 40)))
	Kit.Cyl(parent, 0.6, 3.1, base * CFrame.new(0, 6.95, 0), Kit.Vivid(scarf), { Mat = FABRIC })
	Kit.Cyl(parent, 0.25, 2.9, base * CFrame.new(0, 9.2, 0), C(40, 40, 55))
	Kit.Cyl(parent, 1.6, 1.9, base * CFrame.new(0, 10.1, 0), C(40, 40, 55))
	Kit.AddCircle(x, z, 4)
end

local function iceCluster(parent: Instance, x: number, z: number, glow: boolean)
	local rng = Kit.Rng
	local cols = { ICEC, C(200, 190, 255), C(160, 235, 240) }
	for k = 0, 2 do
		local h = if k == 0 then rng:NextNumber(6, 9) else rng:NextNumber(3, 5)
		local w = if k == 0 then 2.2 else 1.5
		local a = k * 2.2
		local p = V(x + math.cos(a) * (if k == 0 then 0 else 1.8), 0, z + math.sin(a) * (if k == 0 then 0 else 1.8))
		local cf = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 3), rng:NextNumber(-0.25, 0.25))
		Kit.Part(parent, V(w, h, w), cf * CFrame.new(0, h / 2 - 0.5, 0), Kit.Pick(cols), { Mat = ICE, Transp = 0.15, Refl = 0.2 })
		if k == 0 then
			Kit.Part(parent, V(w * 0.7, w * 0.7, w * 0.7), cf * CFrame.new(0, h - 0.5, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), if glow then AURORA else C(225, 245, 255), if glow then { Mat = NEON } else { Mat = ICE, Transp = 0.1 })
		end
	end
	Kit.AddCircle(x, z, 3)
end

local function igloo(parent: Instance, x: number, z: number, fx: number, fz: number, lit: boolean)
	local m = Kit.Model(parent, "Igloo")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
	Kit.Ball(m, 16, V(x, 0, z), WHITE, { Mat = SNOW, Solid = true, Shadow = true })
	Kit.Cyl(m, 0.35, 15.4, CFrame.new(x, 2.6, z), SNOW_SHADE, { Mat = SNOW })
	Kit.Cyl(m, 0.35, 12.6, CFrame.new(x, 5, z), SNOW_SHADE, { Mat = SNOW })
	-- entrance tunnel (cylinder axis turned to point out of the dome) and the doorway
	local tunnel = base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi / 2, 0)
	Kit.Part(m, V(6, 6.4, 6.4), tunnel, WHITE, { Mat = SNOW, Shape = Enum.PartType.Cylinder, Solid = true })
	local door = Kit.Part(m, V(0.4, 4.2, 4.2), tunnel * CFrame.new(3.05, 0, 0), if lit then WARM else C(50, 60, 90), { Shape = Enum.PartType.Cylinder, Mat = if lit then NEON else Enum.Material.SmoothPlastic })
	if lit then
		Kit.Light(door, WARM, 18, 1.2)
	end
	Kit.AddCircle(x, z, 10)
end

-- Log cabin facing (fx, 0). length along the facade, depth into the cabin.
local function cabin(parent: Instance, x: number, z: number, fx: number, length: number, depth: number, wall: Color3, roof: Color3, sign: string?, lit: boolean, flicker: boolean)
	local m = Kit.Model(parent, "Cabin")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	local h = 11
	Kit.Part(m, V(length + 1, 1.2, depth + 1), base * CFrame.new(0, 0.6, 0), C(150, 150, 175), { Mat = SLATE, Solid = true })
	Kit.Part(m, V(length, h, depth), base * CFrame.new(0, 1.2 + h / 2, 0), wall, { Mat = WOOD, Solid = true, Shadow = true })
	-- log seams on the front
	for k = 1, 3 do
		Kit.Part(m, V(length + 0.2, 0.35, 0.3), base * CFrame.new(0, 1.2 + k * h / 4, -depth / 2 - 0.1), wall:Lerp(Color3.new(0, 0, 0), 0.25), { Mat = WOOD })
	end
	gable(m, base * CFrame.new(0, 1.2 + h, 0), length + 2, depth + 3, 7, roof, SLATE, true)
	gable(m, base * CFrame.new(0, 1.2 + h + 0.7, 0), length + 2.4, depth + 3.4, 7, WHITE, SNOW, false)
	-- chimney
	Kit.Part(m, V(3, 9, 3), base * CFrame.new(length / 2 - 3, 1.2 + h + 5, depth * 0.2), C(150, 140, 160), { Mat = Enum.Material.Cobblestone })
	Kit.Part(m, V(3.4, 0.8, 3.4), base * CFrame.new(length / 2 - 3, 1.2 + h + 9.8, depth * 0.2), WHITE, { Mat = SNOW })
	-- door and windows on the front (local -Z)
	Kit.Part(m, V(3.4, 6.5, 0.3), base * CFrame.new(0, 4.45, -depth / 2 - 0.2), C(110, 60, 50), { Mat = WOOD })
	local first: Part? = nil
	for _, s in { -1, 1 } do
		local win = Kit.Part(m, V(3.4, 3, 0.3), base * CFrame.new(s * length * 0.3, 6.5, -depth / 2 - 0.2), WARM, if lit then { Mat = NEON } else {})
		Kit.Part(m, V(4.2, 3.8, 0.2), base * CFrame.new(s * length * 0.3, 6.5, -depth / 2 - 0.08), Kit.Vivid(C(200, 70, 80)), { Mat = WOOD })
		first = first or win
	end
	if lit and first then
		Kit.Light(first, WARM, 22, 1.4, flicker)
	end
	if sign then
		Props.SignBoard(m, (base * CFrame.new(0, 1.2 + h + 2.2, -depth / 2 - 1.2)).Position, length * 0.55, 3.2, fx, 0, sign, C(70, 45, 40), C(255, 235, 190), C(200, 70, 80))
	end
	local r = math.max(length, depth) / 2 + 3
	Kit.AddCircle(x, z, r)
end

local function skiRack(parent: Instance, x: number, z: number)
	local wood: Kit.Opts = { Mat = WOOD }
	for _, s in { -1, 1 } do
		Kit.Box(parent, V(x + s * 3 - 0.3, 0, z - 0.3), V(x + s * 3 + 0.3, 4, z + 0.3), LOG, wood)
	end
	Kit.Box(parent, V(x - 3.5, 3.6, z - 0.4), V(x + 3.5, 4.2, z + 0.4), LOG, wood)
	local skis = { C(255, 90, 120), C(90, 180, 255), C(255, 210, 70), C(150, 110, 240) }
	for i, col in skis do
		local sx = x - 2.6 + (i - 1) * 1.7
		Kit.Part(parent, V(0.6, 6.5, 0.2), CFrame.new(sx, 3.2, z - 0.6) * CFrame.Angles(-0.12, 0, 0), Kit.Vivid(col))
	end
	-- sled
	local sz = z - 5
	for _, s in { -1, 1 } do
		Kit.Box(parent, V(x + s * 1.4 - 0.2, 0, sz - 2.5), V(x + s * 1.4 + 0.2, 0.4, sz + 2.5), C(70, 70, 90), { Mat = Enum.Material.Metal })
	end
	Kit.Box(parent, V(x - 1.8, 0.4, sz - 2), V(x + 1.8, 0.9, sz + 2.2), Kit.Vivid(C(220, 60, 70)), wood)
	Kit.AddCircle(x, z - 2, 6)
end

--==================================================================
-- GROUND, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, Z0), V(190, 0, Z1), SNOWC, { Mat = SNOW, Solid = true, Name = "Ground_Frost" })
	Kit.Box(f, V(-8, 0, Z0), V(8, 0.05, Z1), PATH, { Solid = true, Refl = 0.08, Name = "IcePath" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 8 - 0.5, 0.05, Z0), V(s * 8 + 0.5, 0.1, Z1), Kit.Vivid(LILAC))
	end
	for z = Z0 + 16, Z1 - 10, 30 do
		Kit.Part(f, V(1.6, 0.04, 1.6), CFrame.new(0, 0.07, z) * CFrame.Angles(0, math.pi / 4, 0), WHITE)
	end
	-- soft snow drifts (flat shading patches)
	local rng = Kit.Rng
	for _ = 1, 8 do
		local x = rng:NextNumber(-125, 125)
		local z = rng:NextNumber(Z0 + 30, Z1 - 30)
		if math.abs(x) > 22 then
			Kit.Part(f, V(rng:NextNumber(16, 28), 0.03, rng:NextNumber(12, 22)), CFrame.new(x, 0.015, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), SNOW_SHADE, { Mat = SNOW })
		end
	end
end

local function sideWalls(f: Instance)
	local zA, zB = Z0 + 3, Z1 - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, zA), V(s * 146, 10, zB), WHITE, { Mat = SNOW, Solid = true, Shadow = true })
		Kit.Box(f, V(s * 139.6, 10, zA), V(s * 146.4, 11, zB), ICEC, { Mat = GLACIER })
		Kit.Box(f, V(s * 139.85, 2.4, zA), V(s * 139.65, 3, zB), Kit.Vivid(LILAC))
		for z = zA + 14, zB - 6, 32 do
			Kit.Part(f, V(6, 6, 6), CFrame.new(s * 143, 13, z) * CFrame.Angles(0, 0.4, 0), if (z // 32) % 2 == 0 then ICEC else C(200, 190, 255), { Mat = ICE, Transp = 0.15, Solid = true })
			Kit.Ball(f, 7, V(s * 141, 10.5, z + 9), WHITE, { Mat = SNOW })
		end
	end
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function ghostPaint(f: Instance)
	-- frost spirits: frozen pond across the path with a few cracks
	local cz = rz(85)
	frozenPond(f, 0, cz, 60)
	local crack = C(110, 160, 215)
	for i = 0, 4 do
		local a = i * 1.3 + 0.4
		local p = V(math.cos(a) * 8, 0.1, cz + math.sin(a) * 8)
		Props.Beam(f, p, p + V(math.cos(a + 0.3) * 14, 0, math.sin(a + 0.3) * 14), 0.35, 0.04, crack)
	end
	-- snow drift circles with lilac rings
	for _, a in { { -82, rz(120), 24 }, { -62, rz(240), 24 } } do
		Kit.Disc(f, a[1], a[2], 0.04, a[3] * 2 + 3, 0.03, Kit.Vivid(LILAC))
		Kit.Disc(f, a[1], a[2], 0.07, a[3] * 2, 0.03, SNOW_SHADE, { Mat = SNOW })
		frozenPond(f, a[1] + 5, a[2] + 3, 12)
	end
	-- yeti phantoms: second frozen pond
	frozenPond(f, 75, rz(180), 46)
	Props.Beam(f, V(62, 0.1, rz(172)), V(84, 0.1, rz(188)), 0.35, 0.04, crack)
	-- boss: the Blizzard Queen's ice rink with a big snowflake
	local bz = rz(305)
	Kit.Disc(f, 0, bz, 0.04, 58, 0.03, Kit.Vivid(LILAC))
	Kit.Disc(f, 0, bz, 0.08, 54, 0.04, ICEC, { Refl = 0.3, Name = "IceRink" })
	for i = 0, 5 do
		local a = i * math.pi / 3
		local tip = V(math.cos(a) * 22, 0.12, bz + math.sin(a) * 22)
		Props.Beam(f, V(0, 0.12, bz), tip, 1.4, 0.04, WHITE)
		local mid = V(math.cos(a) * 13, 0.12, bz + math.sin(a) * 13)
		for _, d in { -0.7, 0.7 } do
			Props.Beam(f, mid, mid + V(math.cos(a + d) * 5, 0, math.sin(a + d) * 5), 0.8, 0.04, WHITE)
		end
		Kit.Part(f, V(1.6, 0.05, 1.6), CFrame.new(tip.X, 0.13, tip.Z) * CFrame.Angles(0, math.pi / 4, 0), AURORA, { Mat = NEON })
	end
	Kit.Disc(f, 0, bz, 0.14, 5, 0.04, Kit.Vivid(C(120, 200, 255)))
end

--==================================================================
-- LANDMARK: frozen castle + mountains
--==================================================================
local function castle(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "FrozenCastle")
	local ice: Kit.Opts = { Mat = GLACIER, Solid = true, Shadow = true }
	local iceCol = C(186, 222, 248)
	local roof = Kit.Vivid(LILAC)
	Kit.Disc(m, x, z, 1.2, 46, 1.2, C(170, 175, 205), { Mat = ROCK, Solid = true })
	Kit.Disc(m, x, z, 1.3, 42, 0.1, WHITE, { Mat = SNOW })
	-- curtain walls (front faces -X with a gate)
	local hw, wh, t = 14, 16, 3
	Kit.Box(m, V(x + hw - t, 1.2, z - hw), V(x + hw, wh, z + hw), iceCol, ice)
	Kit.Box(m, V(x - hw, 1.2, z - hw), V(x + hw, wh, z - hw + t), iceCol, ice)
	Kit.Box(m, V(x - hw, 1.2, z + hw - t), V(x + hw, wh, z + hw), iceCol, ice)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x - hw, 1.2, z + s * 4.5), V(x - hw + t, wh, z + s * hw), iceCol, ice)
	end
	Kit.Box(m, V(x - hw, 11, z - 4.5), V(x - hw + t, wh, z + 4.5), iceCol, ice)
	Kit.Box(m, V(x - hw + 0.4, 1.2, z - 4.5), V(x - hw + 0.8, 11, z + 4.5), C(80, 90, 150))
	-- crenellations on the front wall
	for k = -2, 2 do
		Kit.Box(m, V(x - hw - 0.2, wh, z + k * 5.5 - 1.5), V(x - hw + t + 0.2, wh + 2, z + k * 5.5 + 1.5), iceCol, { Mat = GLACIER })
	end
	-- corner towers with lilac cone roofs
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local tx, tz = x + sx * hw, z + sz * hw
			Kit.Cyl(m, 28, 8, CFrame.new(tx, 15.2, tz), C(200, 230, 252), ice)
			for k = 0, 2 do
				Kit.Cyl(m, 3, 9.5 - k * 3, CFrame.new(tx, 30.7 + k * 3, tz), roof)
			end
			Kit.Ball(m, 1.6, V(tx, 37.6, tz), Kit.Vivid(AURORA))
		end
	end
	-- central ice spire
	Kit.Cyl(m, 64, 14, CFrame.new(x, 33.2, z), C(160, 210, 245), { Mat = ICE, Transp = 0.08, Solid = true, Shadow = true })
	Kit.Cyl(m, 2, 16, CFrame.new(x, 42, z), roof)
	Kit.Cyl(m, 2, 15.4, CFrame.new(x, 24, z), roof)
	local stack = { { 12, 6 }, { 8.5, 6 }, { 5, 7 } }
	local y = 65.2
	for _, s in stack do
		Kit.Cyl(m, s[2], s[1], CFrame.new(x, y + s[2] / 2, z), if s[1] > 10 then C(200, 230, 252) else roof, { Mat = GLACIER })
		y += s[2]
	end
	local tip = Kit.Part(m, V(3.6, 3.6, 3.6), CFrame.new(x, y + 2, z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), AURORA, { Mat = NEON })
	Kit.Part(m, V(1.4, 10, 1.4), CFrame.new(x, y + 8.5, z), C(220, 245, 255), { Mat = ICE, Transp = 0.1 })
	Kit.Light(tip, AURORA, 40, 1.6)
	-- spire windows facing the valley (-X); the top one glows
	for k, wy in { 34, 50 } do
		Kit.Box(m, V(x - 7.2, wy, z - 1.4), V(x - 6.6, wy + 4, z + 1.4), if k == 2 then C(200, 240, 255) else C(70, 90, 160), if k == 2 then { Mat = NEON } else { Refl = 0.2 })
	end
	-- banners on the front towers
	for _, sz in { -1, 1 } do
		Kit.Box(m, V(x - hw - 4.3, 14, z + sz * hw - 1.6), V(x - hw - 4, 24, z + sz * hw + 1.6), Kit.Vivid(C(150, 110, 230)), { Mat = FABRIC })
	end
	-- ice shards around the base
	local rng = Kit.Rng
	for i = 0, 5 do
		local a = i * math.pi / 3 + 0.5
		local p = V(x + math.cos(a) * 20, 0, z + math.sin(a) * 20)
		local h = rng:NextNumber(6, 10)
		local cf = CFrame.new(p) * CFrame.Angles(math.sin(a) * 0.3, rng:NextNumber(0, 3), -math.cos(a) * 0.3)
		Kit.Part(m, V(2.4, h, 2.4), cf * CFrame.new(0, h / 2 - 0.5, 0), if i % 2 == 0 then ICEC else C(205, 195, 255), { Mat = ICE, Transp = 0.15 })
	end
	-- icy mist rolling off the castle
	local fog = Kit.Part(m, V(40, 0.2, 40), CFrame.new(x, 1.5, z), C(225, 240, 255), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(225, 240, 255), 1.4, 9, 0.3)
	Kit.AddCircle(x, z, 24)
end

-- A mountain peak: a diamond-turned block half buried, plus a snow cap. Runs along Z.
local function peak(parent: Instance, x: number, z: number, size: number, depth: number, col: Color3)
	local cf = CFrame.new(x, -size * 0.12, z) * CFrame.Angles(0, 0, math.pi / 4)
	Kit.Part(parent, V(size, size, depth), cf, col, { Mat = ROCK })
	local capS = size * 0.36
	local topY = -size * 0.12 + size * 0.7071
	Kit.Part(parent, V(capS, capS, depth * 0.9), CFrame.new(x, topY - capS * 0.7071 + 0.6, z) * CFrame.Angles(0, 0, math.pi / 4), WHITE, { Mat = SNOW })
end

--==================================================================
-- OUTSIDE: mountains, snowfield, pines, aurora
--==================================================================
local function outside(f: Instance)
	local rng = Kit.Rng
	local o = Kit.Folder(f, "Peaks")
	for _, s in { -1, 1 } do
		Kit.Box(o, V(s * 190, -3, Z0), V(s * 420, -0.2, Z1), SNOWC, { Mat = SNOW })
		-- pines on the outer snow
		for i = 0, 7 do
			local x = s * rng:NextNumber(152, 200)
			local z = Z0 + 20 + i * 44 + rng:NextNumber(-8, 8)
			local h = rng:NextNumber(22, 34)
			local col = Kit.Pick(PINE)
			Kit.Cyl(o, h * 0.3, 2, CFrame.new(x, h * 0.15, z), BARK, { Mat = WOOD })
			Kit.Cyl(o, h * 0.35, h * 0.55, CFrame.new(x, h * 0.42, z), col, { Mat = Enum.Material.Grass })
			Kit.Cyl(o, h * 0.3, h * 0.34, CFrame.new(x, h * 0.74, z), col, { Mat = Enum.Material.Grass })
			Kit.Cyl(o, 0.8, h * 0.3, CFrame.new(x, h * 0.9 + 0.4, z), WHITE, { Mat = SNOW })
		end
	end
	-- mountain ranges both sides, tallest behind the castle (+X, back)
	local ranges = {
		{ -260, rz(40), 150, 120 }, { -300, rz(160), 200, 130 }, { -250, rz(270), 160, 110 }, { -320, rz(340), 190, 120 },
		{ 270, rz(30), 140, 110 }, { 310, rz(140), 180, 130 }, { 250, rz(230), 150, 100 }, { 260, rz(320), 210, 120 },
	}
	for i, r in ranges do
		peak(o, r[1], r[2], r[3], r[4], if i % 2 == 0 then MTN else MTN_DARK)
	end
	-- aurora curtains: big translucent planes high above the side walls
	type Curtain = { s: number, z: number, col: Color3, t: number }
	local aur: { Curtain } = {
		{ s = -1, z = rz(110), col = AURORA, t = 0.62 },
		{ s = -1, z = rz(260), col = C(190, 150, 255), t = 0.66 },
		{ s = 1, z = rz(70), col = C(110, 220, 255), t = 0.66 },
		{ s = 1, z = rz(220), col = AURORA, t = 0.62 },
		{ s = 1, z = rz(330), col = C(190, 150, 255), t = 0.66 },
	}
	for i, a in aur do
		local s = a.s
		local cf = CFrame.new(s * (175 + (i % 2) * 20), 130 + (i % 3) * 12, a.z) * CFrame.Angles(0, (i % 2) * 0.15 - 0.07, s * 0.25)
		Kit.Part(o, V(1, 46, 190), cf, a.col, { Transp = a.t, Name = "Aurora" })
		Kit.Part(o, V(1, 14, 170), cf * CFrame.new(0, -26, 6), a.col, { Transp = 0.8, Name = "Aurora" })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Frost.Build(map: Instance)
	local f = Kit.Folder(map, "Frost")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	ghostPaint(f)
	castle(f, 95, rz(290))
	cabin(f, 98, rz(62), -1, 30, 18, LOG, C(170, 60, 70), "⛷ SKI LODGE ⛷", true, true)
	cabin(f, 112, rz(118), -1, 18, 14, C(140, 92, 62), C(70, 90, 150), nil, true, false)
	skiRack(f, 72, rz(80))
	igloo(f, 56, rz(122), -1, 0, true)
	igloo(f, -100, rz(46), 1, 0, false)
	igloo(f, -118, rz(196), 1, 0, false)
	igloo(f, 30, rz(214), -1, -1, false)
	frozenPond(f, -35, rz(170), 28)
	Kit.AddCircle(-35, rz(170), 17)
	snowman(f, 15, rz(52), 0, -1, C(230, 60, 80))

	-- welcome sign
	do
		local x, z = -62, rz(14)
		for _, s in { -1, 1 } do
			Kit.Cyl(f, 13, 1.4, CFrame.new(x + s * 10, 6.5, z), LOG, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 10, z), 20, 5.5, 0, -1, "❄ FROSTBITE PEAKS ❄", C(70, 90, 150), WHITE, LILAC)
		Kit.Box(f, V(x - 11, 12.8, z - 0.6), V(x + 11, 13.6, z + 0.6), WHITE, { Mat = SNOW })
		Kit.AddCircle(x, z, 12)
	end

	-- lanterns along the path (one lit)
	local lit = 0
	for z = Z0 + 46, Z1 - 30, 46 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 23 else 0)
			local x = s * 12.5
			if zz < Z1 - 26 and Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.Lantern(f, V(x, 0, zz), C(190, 235, 255), lit == 2, false)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- pines
	local trees = 0
	for _ = 1, 400 do
		if trees >= 18 then
			break
		end
		local x, z = rng:NextNumber(-132, 132), rng:NextNumber(Z0 + 30, Z1 - 30)
		local h = rng:NextNumber(18, 30)
		if Kit.IsFree(x, z, h * 0.31 + 1) then
			trees += 1
			pine(f, V(x, 0, z), h)
		end
	end

	-- ice crystals and snowmen
	local scarves = { C(230, 60, 80), C(90, 170, 255), C(150, 110, 240), C(80, 200, 140) }
	local crystals, men = 0, 0
	for _ = 1, 600 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(Z0 + 28, Z1 - 28)
		if crystals < 9 and Kit.IsFree(x, z, 3.5) then
			crystals += 1
			iceCluster(f, x, z, crystals <= 3)
		elseif men < 4 and Kit.IsFree(x, z, 4.5) then
			men += 1
			snowman(f, x, z, -x, -10, scarves[men])
		end
	end

	-- floating snowflake crystals near the castle and the lodge
	for _, p in { V(70, 9, rz(262)), V(118, 12, rz(250)), V(64, 7, rz(318)), V(78, 10, rz(140)), V(120, 8, rz(320)) } do
		local c = Kit.Part(f, V(1.6, 1.6, 1.6), CFrame.new(p) * CFrame.Angles(math.pi / 4, 0.3, math.pi / 4), C(220, 245, 255), { Mat = ICE, Transp = 0.1, Name = "FloatingCrystal" })
		Kit.Float(c, rng:NextNumber(0.6, 1.2))
	end

	-- gentle snowfall over the valley
	local sky = Kit.Part(f, V(260, 1, 340), CFrame.new(0, 48, rz(180)), WHITE, { Transp = 1, Name = "SnowSource" })
	local e = Kit.Emitter(sky, WHITE, 18, 0.5, 1)
	if e then
		e.LightEmission = 0.2
		e.Acceleration = V(0, -3, 0)
		e.Lifetime = NumberRange.new(7, 10)
		e.Size = NumberSequence.new(0.45)
		e.Transparency = NumberSequence.new(0.15)
		e.EmissionDirection = Enum.NormalId.Bottom
	end

	outside(f)
end

return Frost
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Gates</string>
            <string name="Source"><![CDATA[--!strict
-- Zone gates: workspace.Map.Gates.Gate_<ZoneId> with Barrier, Arch, PromptAnchor and Sign
-- (TextLabel "CostLabel" on the sign's Front face, which faces the approaching player at -Z).
-- The Barrier is a ForceField-material wall (shimmering, no neon blow-out); the client
-- (Ambience) toggles its collision, tweens its Color/Size/CFrame/Transparency on unlock.
-- Trims are painted (solid); only the hanging lanterns, pillar jack-o'-lanterns and the
-- skull's eyes glow.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Format = require(game:GetService("ReplicatedStorage").GH.Logic.Format)
local Kit = require(script.Parent.Kit)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)
local Props = require(script.Parent.Props)

local Gates = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

type Theme = { Stone: Color3, Trim: Color3, Barrier: Color3, Lamp: Color3 }

local THEMES: { [string]: Theme } = {
	Cemetery = { Stone = C(150, 125, 200), Trim = C(140, 255, 120), Barrier = C(180, 110, 255), Lamp = C(140, 255, 160) },
	School = { Stone = C(225, 120, 100), Trim = C(210, 120, 255), Barrier = C(100, 255, 190), Lamp = C(220, 150, 255) },
	Carnival = { Stone = C(235, 75, 85), Trim = C(255, 210, 70), Barrier = C(255, 120, 200), Lamp = C(255, 220, 120) },
	Hospital = { Stone = C(220, 228, 238), Trim = C(100, 180, 255), Barrier = C(120, 255, 200), Lamp = C(170, 230, 255) },
	Harbor = { Stone = C(125, 90, 60), Trim = C(70, 200, 200), Barrier = C(90, 255, 210), Lamp = C(255, 200, 110) },
	Castle = { Stone = C(150, 150, 165), Trim = C(255, 200, 70), Barrier = C(190, 110, 255), Lamp = C(255, 190, 100) },
	SpiritRealm = { Stone = C(70, 60, 110), Trim = C(110, 230, 255), Barrier = C(110, 240, 255), Lamp = C(150, 255, 230) },
	Swamp = { Stone = C(100, 120, 75), Trim = C(170, 255, 120), Barrier = C(150, 255, 120), Lamp = C(200, 255, 140) },
	Frost = { Stone = C(205, 225, 245), Trim = C(110, 190, 255), Barrier = C(170, 240, 255), Lamp = C(200, 245, 255) },
	Tomb = { Stone = C(225, 190, 125), Trim = C(70, 200, 220), Barrier = C(255, 210, 90), Lamp = C(255, 220, 140) },
	ToyFactory = { Stone = C(255, 150, 190), Trim = C(255, 225, 90), Barrier = C(255, 140, 220), Lamp = C(255, 230, 150) },
	Sunken = { Stone = C(90, 150, 170), Trim = C(255, 220, 120), Barrier = C(90, 255, 230), Lamp = C(150, 255, 240) },
	Clockwork = { Stone = C(160, 120, 80), Trim = C(230, 200, 120), Barrier = C(255, 190, 90), Lamp = C(255, 210, 130) },
	Inferno = { Stone = C(90, 55, 55), Trim = C(255, 150, 60), Barrier = C(255, 120, 60), Lamp = C(255, 170, 90) },
	Throne = { Stone = C(240, 235, 255), Trim = C(255, 215, 90), Barrier = C(255, 230, 140), Lamp = C(255, 240, 180) },
}

local function buildGate(folder: Instance, id: string, z: number, width: number)
	local zone = Config.ZoneById[id]
	local theme = THEMES[id] or THEMES.Cemetery
	local half = width / 2
	local m = Kit.Model(folder, "Gate_" .. id)
	local trim = Kit.Vivid(theme.Trim)

	-- Barrier: fills the opening. Other code toggles collision locally and tweens it.
	local barrier = Kit.Part(m, V(width, 30, 2), CFrame.new(0, 15, z), theme.Barrier, {
		Name = "Barrier",
		Mat = Enum.Material.ForceField,
		Transp = 0.4,
		Solid = true,
		Shadow = false,
	})
	barrier.CanQuery = false
	barrier.CanTouch = true

	-- Arch around the opening (never inside it).
	local arch = Kit.Model(m, "Arch")
	local pw = 8 -- pillar width
	for _, s in { -1, 1 } do
		local x1, x2 = s * half, s * (half + pw)
		Kit.Box(arch, V(x1, 0, z - 5), V(x2, 32, z + 5), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
		Kit.Box(arch, V(s * (half + 0.01), 0, z - 6), V(s * (half + pw + 1), 3, z + 6), theme.Stone:Lerp(Color3.new(0, 0, 0), 0.2), { Mat = Enum.Material.Slate, Solid = true })
		-- painted trims on the pillar fronts (both sides)
		for _, fz in { -1, 1 } do
			for _, ex in { 0.6, pw - 0.6 } do
				local x = s * (half + ex)
				Kit.Box(arch, V(x - 0.3, 3, z + fz * 5), V(x + 0.3, 30, z + fz * 5.3), trim)
			end
		end
		-- glowing jack-o'-lantern on top of each pillar
		Props.Pumpkin(arch, V(s * (half + pw / 2), 36, z), 6.5, 0, -1, true)
		-- hanging lantern on the approach side
		local lx = s * (half + pw / 2)
		Kit.Box(arch, V(lx - 0.3, 24, z - 5.8), V(lx + 0.3, 26, z - 5), C(50, 40, 70))
		local lamp = Kit.Box(arch, V(lx - 1.1, 21, z - 6.8), V(lx + 1.1, 24, z - 4.6), theme.Lamp, { Mat = NEON })
		Kit.Light(lamp, theme.Lamp, 22, 1.6)
	end
	-- top beam (Y 30..36) spanning the opening above the barrier
	Kit.Box(arch, V(-(half + pw + 1), 30, z - 4), V(half + pw + 1, 36, z + 4), theme.Stone, { Mat = Enum.Material.Slate, Solid = true })
	for _, fz in { -1, 1 } do
		Kit.Box(arch, V(-(half + pw + 1), 30, z + fz * 4), V(half + pw + 1, 30.6, z + fz * 4.3), trim)
	end
	-- crenellations
	for i = -2, 2 do
		local x = i * 9
		Kit.Box(arch, V(x - 2, 36, z - 3), V(x + 2, 38, z + 3), theme.Stone, { Mat = Enum.Material.Slate })
	end
	-- skull centrepiece on the approach face
	Props.Skull(arch, V(0, 33, z - 5), 4.5, 0, -1)
	-- low wisps either side of the opening
	Props.Wisp(arch, V(-(half + 5), 0, z - 9), theme.Barrier, 10, false)
	Props.Wisp(arch, V(half + 5, 0, z - 9), theme.Barrier, 10, false)

	-- Sign above the arch, Front face (-Z) toward players coming from the previous zone.
	local sign = Kit.Part(m, V(40, 10, 1), CFrame.new(0, 43, z - 3), C(45, 25, 80), { Name = "Sign" })
	Kit.Part(arch, V(42, 12, 0.6), CFrame.new(0, 43, z - 2.3), trim) -- frame
	local gui = Kit.Gui(sign, Enum.NormalId.Front, 30)
	Kit.Label(gui, zone.Name, zone.Accent, {
		Name = "ZoneLabel",
		Pos = UDim2.fromScale(0.03, 0.04),
		Size = UDim2.fromScale(0.94, 0.5),
	})
	-- cost row: the uploaded lock icon left of the price (Ambience hides it once unlocked;
	-- the canvas is 40 x 10 studs, so a 0.38-tall square is 0.095 of the width)
	local lockImage = Icons.Get("lock")
	if lockImage then
		local img = Kit.IconImage(gui, lockImage, 0.1, 0.56, 0.095, 0.38)
		img.Name = "CostIcon"
	end
	Kit.Label(gui, (if lockImage then "" else "🔒 ") .. Format.Short(zone.Cost) .. " ECTOPLASM", C(150, 255, 140), {
		Name = "CostLabel",
		Pos = if lockImage then UDim2.fromScale(0.2, 0.56) else UDim2.fromScale(0.08, 0.56),
		Size = if lockImage then UDim2.fromScale(0.7, 0.38) else UDim2.fromScale(0.84, 0.38),
	})

	-- Prompt anchor on the near side.
	Kit.Part(m, V(1, 1, 1), CFrame.new(0, 4, z - 6), C(255, 255, 255), { Name = "PromptAnchor", Transp = 1 })

	m.PrimaryPart = barrier
end

function Gates.Build(map: Instance)
	local folder = Kit.Folder(map, "Gates")
	for id, g in Kit.Gates(Config.Layout) do
		buildGate(folder, id, g.Z, g.Width)
	end
end

return Gates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Harbor</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 6: Ghost Ship Harbor (Z 1560..1920).
--   Cobblestone quay at Y = 0 with a WoodPlanks boardwalk along X = 0 (gate to gate) and
--   plank deck pads painted under every ghost area (flat, <= 0.17 tall).
--   -X side: muted-red brick harbour wall, three open-front warehouses (X -138..-112) and a row
--   of town houses behind the wall.
--   +X side: low quay curb + rope railing; the ocean (Y -1.5) beyond X = 146; a shallow
--   wading inlet (floor Y -0.5, no pit) at X 104..146, Z 1600..1650 with a pier and fishing hut.
--   Landmarks: the haunted ship "The Salty Specter" moored along +X (hull X 130..174,
--   Z 1672..1810, masts to Y ~102) and a red/white striped lighthouse at (116, 1866), ~94 tall.
--   Glow is limited to portholes, stern windows, a few rune lines, the figurehead heart, the
--   lighthouse lamp, lamp globes, a few ghostly windows and floating spectral lanterns.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Harbor = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local COBBLE = Enum.Material.Cobblestone
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local ROCK = Enum.Material.Rock

local Z0, Z1 = 1560, 1920

local SEA = C(28, 72, 128)
local SEA_TEAL = C(45, 135, 150)
local QUAY = C(118, 132, 150)
local PLANK = C(170, 125, 82)
local PLANK_DARK = C(112, 78, 55)
local HULL = C(92, 62, 48)
local MAST = C(110, 80, 58)
local RED = C(175, 72, 66)
local TEAL = C(60, 185, 185)
local SPECTRAL = C(120, 255, 170)
local PURPLE = C(160, 110, 230)
local SAIL = C(238, 232, 212)
local SAIL_TEAL = C(170, 222, 215)
local IRON = C(58, 60, 74)
local GOLD = C(255, 200, 60)
local ROPE = C(205, 178, 130)
local WARM = C(255, 205, 120)
local CRATES = { C(185, 135, 85), C(160, 110, 70), C(200, 150, 95), C(140, 100, 70) }

local SOLID_PLANKS: Kit.Opts = { Mat = PLANKS, Solid = true, Shadow = true }

-- Gable roof, ridge along local X, slopes toward local ±Z, bottom at local y = 0.
local function gable(parent: Instance, base: CFrame, length: number, depth: number, height: number, color: Color3, mat: Enum.Material)
	local half = depth / 2
	local o: Kit.Opts = { Mat = mat, Solid = true, Shadow = true }
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, -half / 2), color, o)
	Kit.Wedge(parent, V(length, height, half), base * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), color, o)
end

-- Plan-view triangle (Y y0..y1): right angle at (xEdge, zBase), point at (xEdge, zTip) with
-- zTip > zBase, widest at (xOuter, zBase). Two mirrored halves make the ship's bow.
local function bowHalf(parent: Instance, xEdge: number, xOuter: number, zBase: number, zTip: number, y0: number, y1: number, color: Color3, opts: Kit.Opts)
	local s = if xOuter > xEdge then 1 else -1
	local center = V((xEdge + xOuter) / 2, (y0 + y1) / 2, (zBase + zTip) / 2)
	local cf = CFrame.fromMatrix(center, V(0, s, 0), V(s, 0, 0))
	Kit.Wedge(parent, V(y1 - y0, math.abs(xOuter - xEdge), zTip - zBase), cf, color, opts)
end

local function crate(parent: Instance, pos: Vector3, s: number, yaw: number)
	local cf = CFrame.new(pos + V(0, s / 2, 0)) * CFrame.Angles(0, yaw, 0)
	Kit.Part(parent, V(s, s, s), cf, Kit.Pick(CRATES), { Mat = WOOD, Solid = true, Shadow = true })
	Kit.Part(parent, V(s + 0.12, s * 0.18, s + 0.12), cf, PLANK_DARK, { Mat = WOOD })
end

local function barrel(parent: Instance, pos: Vector3, h: number)
	Kit.Cyl(parent, h, 2.8, CFrame.new(pos + V(0, h / 2, 0)), C(150, 100, 62), { Mat = WOOD, Solid = true })
	for _, t in { 0.22, 0.78 } do
		Kit.Cyl(parent, 0.35, 2.95, CFrame.new(pos + V(0, h * t, 0)), IRON, { Mat = METAL })
	end
end

--==================================================================
-- GROUND, WATER, PATH, WALLS
--==================================================================
local function ground(f: Instance)
	local quay: Kit.Opts = { Mat = COBBLE, Solid = true }
	Kit.Box(f, V(-190, -4, Z0), V(104, 0, Z1), QUAY, { Mat = COBBLE, Solid = true, Name = "Ground_Harbor" })
	Kit.Box(f, V(104, -4, Z0), V(146, 0, 1600), QUAY, quay)
	Kit.Box(f, V(104, -4, 1650), V(146, 0, Z1), QUAY, quay)
	-- shallow wading inlet: solid floor at Y -0.5 (half-stud step, no pit) under clear water
	Kit.Box(f, V(104, -4, 1600), V(146, -0.5, 1650), C(80, 120, 125), { Mat = Enum.Material.Sand, Solid = true, Name = "InletFloor" })
	Kit.Box(f, V(104, -0.5, 1600), V(146, -0.15, 1650), SEA_TEAL, { Transp = 0.45, Refl = 0.2, Name = "InletWater" })
	-- timber edging around the inlet and a sea-gate beam hiding the step down to the ocean
	Kit.Box(f, V(102.8, -0.5, 1600), V(104, 0.3, 1650), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1598.8), V(140, 0.3, 1600), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(102.8, -0.5, 1650), V(140, 0.3, 1651.2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Box(f, V(144, -2, 1598.8), V(146, 0.4, 1651.2), PLANK_DARK, { Mat = WOOD })
	Kit.AddRect(102, 1598, 140, 1652)

	-- the ocean (outside the play area), moonlit streaks and a few rocks
	Kit.Box(f, V(146, -3, Z0), V(190, -1.5, Z1), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(190, -3, 1520), V(560, -1.5, 1960), SEA, { Refl = 0.2, Name = "Ocean" })
	Kit.Box(f, V(170, -1.5, 1700), V(540, -1.44, 1712), C(170, 225, 235), { Transp = 0.45 })
	Kit.Box(f, V(200, -1.5, 1726), V(540, -1.44, 1732), C(170, 225, 235), { Transp = 0.55 })
	Kit.Disc(f, 420, 1716, -1.42, 46, 0.06, C(250, 245, 215), { Transp = 0.35, Name = "MoonGlow" })
	for _, r in { { 232, 1612, 18 }, { 262, 1846, 24 }, { 205, 1900, 14 }, { 300, 1760, 12 } } do
		Kit.Ball(f, r[3], V(r[1], -4, r[2]), C(85, 95, 115), { Mat = ROCK })
	end

	-- boardwalk path along X = 0 with painted teal edges
	Kit.Box(f, V(-9, 0, Z0), V(9, 0.05, Z1), PLANK, { Mat = PLANKS, Solid = true, Name = "Boardwalk" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 9 - 0.4, 0.05, Z0), V(s * 9 + 0.4, 0.12, Z1), Kit.Vivid(TEAL))
	end
	-- plank dock patches on the quay (flat)
	for _, d in { { 30, 1598, 102, 1660 }, { -110, 1576, -40, 1610 }, { 30, 1790, 100, 1840 }, { -108, 1830, -30, 1890 } } do
		Kit.Box(f, V(d[1], 0, d[2]), V(d[3], 0.04, d[4]), PLANK, { Mat = PLANKS })
	end
end

local function sideWalls(f: Instance)
	-- -X: brick harbour wall with slate cap and wooden posts topped with buoys
	local brick = C(160, 86, 74)
	Kit.Box(f, V(-146, 0, Z0 + 3), V(-140, 14, Z1 - 3), brick, { Mat = Enum.Material.Brick, Solid = true })
	Kit.Box(f, V(-146.6, 14, Z0 + 3), V(-139.4, 15.2, Z1 - 3), C(70, 110, 150), { Mat = Enum.Material.Slate })
	Kit.Box(f, V(-139.95, 3, Z0 + 3), V(-139.7, 3.8, Z1 - 3), Kit.Vivid(TEAL))
	local n = 0
	for z = Z0 + 20, Z1 - 15, 30 do
		n += 1
		Kit.Box(f, V(-147, 0, z - 2), V(-139, 17, z + 2), PLANK_DARK, { Mat = WOOD, Solid = true })
		Kit.Ball(f, 3, V(-143, 18.2, z), Kit.Vivid(if n % 2 == 0 then RED else TEAL))
	end
	-- life rings on the wall facing the docks
	for _, z in { 1650, 1770, 1890 } do
		Kit.CylFlat(f, 0.5, 3.4, V(-139.5, 8, z), "X", Kit.Vivid(RED))
		Kit.CylFlat(f, 0.6, 1.6, V(-139.45, 8, z), "X", C(240, 240, 235))
	end
	-- town houses behind the wall (backdrop)
	local houses = { C(120, 80, 110), C(70, 110, 140), C(150, 90, 75), C(80, 125, 120), C(120, 95, 70), C(95, 85, 140) }
	for i, z in { 1584, 1640, 1700, 1760, 1820, 1882 } do
		local h = 22 + (i % 3) * 6
		Kit.Box(f, V(-186, 0, z - 13), V(-152, h, z + 13), houses[i], { Mat = if i % 2 == 0 then PLANKS else Enum.Material.Brick })
		gable(f, CFrame.new(-169, h, z) * CFrame.Angles(0, math.pi / 2, 0), 28, 38, 10, C(55, 70, 105), Enum.Material.Slate)
		local ghostly = i % 2 == 1
		Kit.Box(f, V(-152.3, h - 9, z - 3), V(-151.9, h - 4, z + 3), if ghostly then SPECTRAL else WARM, { Mat = if ghostly then NEON else Enum.Material.SmoothPlastic })
	end

	-- +X: low quay curb, rope railing on posts (gaps at the inlet and where the ship's hull is)
	local curb = C(100, 112, 130)
	Kit.Box(f, V(140, 0, Z0 + 3), V(146, 1, 1600), curb, { Mat = COBBLE, Solid = true })
	Kit.Box(f, V(140, 0, 1650), V(146, 1, Z1 - 3), curb, { Mat = COBBLE, Solid = true })
	for _, seg in { { 1566, 1598 }, { 1652, 1664 }, { 1818, 1914 } } do
		local a, b = seg[1], seg[2]
		local z = a
		while z <= b do
			Kit.Cyl(f, 5, 1.2, CFrame.new(143, 3, z), PLANK_DARK, { Mat = WOOD })
			z += 16
		end
		Kit.CylFlat(f, b - a, 0.4, V(143, 4, (a + b) / 2), "Z", ROPE, { Mat = FABRIC })
	end
	-- decorative pier out into the ocean (beyond the wall)
	Kit.Box(f, V(146, -0.8, 1578), V(190, -0.2, 1590), PLANK, { Mat = PLANKS })
	for x = 152, 186, 11 do
		for _, z in { 1577.5, 1590.5 } do
			Kit.Cyl(f, 5, 1.3, CFrame.new(x, -1.5, z), PLANK_DARK, { Mat = WOOD })
		end
	end
end

--==================================================================
-- LANDMARKS
--==================================================================
local function ship(f: Instance)
	local m = Kit.Model(f, "GhostShip")
	local cx = 152
	local x0, x1 = 130, 174
	local zs, ze, zt = 1672, 1778, 1810 -- stern, start of bow, bow tip
	local deckOpts: Kit.Opts = { Mat = PLANKS }

	-- hull + bow + deck
	Kit.Box(m, V(x0, -6, zs), V(x1, 17, ze), HULL, SOLID_PLANKS)
	bowHalf(m, cx, x0, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	bowHalf(m, cx, x1, ze, zt, -6, 17, HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 17, zs), V(x1 - 1, 18, ze), PLANK, deckOpts)
	bowHalf(m, cx, x0 + 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	bowHalf(m, cx, x1 - 1.5, ze, zt - 3, 17, 18, PLANK, deckOpts)
	-- bulwarks
	Kit.Box(m, V(x0, 17, zs), V(x0 + 1.2, 21, ze), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1.2, 17, zs), V(x1, 21, ze), HULL, deckOpts)
	Props.Beam(m, V(x0 + 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	Props.Beam(m, V(x1 - 0.6, 19, ze), V(cx, 19, zt), 1.2, 4, HULL, deckOpts)
	-- muted red wale, teal waterline and gold rail on the side players see (-X), plus the bow
	Kit.Box(m, V(x0 - 0.3, 9, zs), V(x0 + 0.2, 11.5, ze), Kit.Vivid(RED), { Mat = WOOD })
	Props.Beam(m, V(x0 - 0.2, 10.25, ze), V(cx, 10.25, zt + 0.3), 0.6, 2.5, Kit.Vivid(RED), { Mat = WOOD })
	Kit.Box(m, V(x0 - 0.25, -1.5, zs), V(x0 + 0.2, 0.3, ze), Kit.Vivid(TEAL))
	Kit.Box(m, V(x0 - 0.35, 20.6, zs), V(x0 + 1.3, 21.3, ze), Kit.Vivid(GOLD), { Mat = METAL })

	-- stern castle (faces players arriving from the gate)
	Kit.Box(m, V(x0, 17, zs), V(x1, 30, 1700), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 30, zs), V(x1 - 1, 31, 1700), PLANK, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x0 + 1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x1 - 1, 30, zs), V(x1, 33.5, 1700), HULL, deckOpts)
	Kit.Box(m, V(x0, 30, zs), V(x1, 33.5, zs + 1), HULL, deckOpts)
	Kit.Box(m, V(x0 - 0.3, 29, zs - 0.3), V(x1 + 0.3, 30, 1700), Kit.Vivid(RED), { Mat = WOOD })
	for i = -1, 1 do
		local x = cx + i * 12
		local win = Kit.Box(m, V(x - 2.6, 20, zs - 0.35), V(x + 2.6, 26.5, zs + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
		Kit.Box(m, V(x - 3.2, 19.4, zs - 0.2), V(x + 3.2, 27.1, zs + 0.1), Kit.Vivid(GOLD), { Mat = METAL })
		if i == 0 then
			Kit.Light(win, SPECTRAL, 30, 1.4)
		end
		Kit.Box(m, V(x - 2.4, 6, zs - 0.25), V(x + 2.4, 10.5, zs + 0.1), C(40, 60, 85))
	end
	-- forecastle
	Kit.Box(m, V(x0, 17, 1758), V(x1, 23, ze), HULL, SOLID_PLANKS)
	Kit.Box(m, V(x0 + 1, 23, 1758), V(x1 - 1, 23.6, ze), PLANK, deckOpts)

	-- masts, yards, tattered sails, crow's nest, ropes
	local masts = { { 1712, 80 }, { 1738, 102 }, { 1764, 88 } }
	local tops: { Vector3 } = {}
	for i, mst in masts do
		local z, top = mst[1], mst[2]
		Kit.Cyl(m, top - 17, 3, CFrame.new(cx, (17 + top) / 2, z), MAST, { Mat = WOOD, Shadow = true })
		local span = top - 17
		local yA = 17 + span * 0.55
		local yB = 17 + span * 0.88
		local lowW = 34 + i * 2
		Kit.CylFlat(m, lowW + 4, 1.2, V(cx, yA, z), "X", MAST, { Mat = WOOD })
		Kit.CylFlat(m, lowW - 4, 1.1, V(cx, yB, z), "X", MAST, { Mat = WOOD })
		local col = if i == 2 then SAIL_TEAL else SAIL
		local sailOpts: Kit.Opts = { Mat = FABRIC, Transp = 0.06 }
		-- lower sail torn into two ragged halves plus a dangling strip
		local h1 = (yA - 22) * 0.95
		local h2 = (yA - 22) * 0.7
		Kit.Part(m, V(lowW / 2 - 1, h1, 0.5), CFrame.new(cx - lowW / 4, yA - h1 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0), col, sailOpts)
		Kit.Part(m, V(lowW / 2 - 1, h2, 0.5), CFrame.new(cx + lowW / 4, yA - h2 / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.08, 0, 0.04), col, sailOpts)
		Kit.Part(m, V(3, h1 - h2 + 2, 0.4), CFrame.new(cx + lowW / 4 + 3, yA - h2 - (h1 - h2) / 2, z + 1.1) * CFrame.Angles(0, 0, 0.18), col, sailOpts)
		local hU = (yB - yA) - 3
		Kit.Part(m, V(lowW - 8, hU, 0.5), CFrame.new(cx, yB - hU / 2 - 0.6, z + 1.3) * CFrame.Angles(-0.06, 0, 0), if i == 2 then SAIL else SAIL_TEAL, sailOpts)
		table.insert(tops, V(cx, top - 3, z))
		-- shrouds: two to the -X bulwark (visible side), one to +X
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z - 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x0 + 0.6, 21, z + 9), 0.35, 0.35, ROPE)
		Props.Beam(m, V(cx, top - 4, z), V(x1 - 0.6, 21, z), 0.35, 0.35, ROPE)
	end
	Props.Beam(m, tops[1], tops[2], 0.35, 0.35, ROPE)
	Props.Beam(m, tops[2], tops[3], 0.35, 0.35, ROPE)
	Kit.Cyl(m, 3, 8, CFrame.new(cx, 86.5, 1738), PLANK_DARK, { Mat = WOOD })
	-- ghostly flag on the main mast
	local flag = Kit.Part(m, V(0.4, 7, 11), CFrame.new(cx, 97, 1738 - 6.5), C(40, 34, 55), { Mat = FABRIC })
	Kit.Sign(flag, Enum.NormalId.Left, "👻", C(240, 240, 240))
	-- bowsprit + forestay
	local sprTip = V(cx, 31, zt + 22)
	Props.Beam(m, V(cx, 20, zt - 6), sprTip, 1.6, 1.6, MAST, { Mat = WOOD })
	Props.Beam(m, tops[3], sprTip, 0.35, 0.35, ROPE)

	-- spectral figurehead
	Props.Beam(m, V(cx, 7, zt - 1), V(cx, 13.5, zt + 1.6), 3, 2.4, C(200, 240, 235), { Transp = 0.15 })
	Kit.Ball(m, 3.6, V(cx, 15.4, zt + 2), C(210, 245, 240), { Transp = 0.15 })
	Kit.Wedge(m, V(3.4, 4, 2), CFrame.new(cx, 14.5, zt + 0.6), C(150, 225, 220), { Transp = 0.15 })
	local heart = Kit.Ball(m, 1.6, V(cx, 11.6, zt + 2.2), SPECTRAL, { Mat = NEON })
	Kit.Light(heart, SPECTRAL, 28, 1.8)

	-- cannons and gun ports on the -X side
	for i = 0, 5 do
		local z = 1708 + i * 12
		Kit.Box(m, V(x0 - 0.25, 12.3, z - 1.6), V(x0 + 0.1, 15.3, z + 1.6), C(30, 25, 32))
		Kit.CylFlat(m, 6, 1.8, V(x0 - 2.6, 13.8, z), "X", IRON, { Mat = METAL })
	end
	-- glowing portholes with brass rims
	for i = 0, 7 do
		local z = 1680 + i * 12
		Kit.CylFlat(m, 0.3, 3.2, V(x0 - 0.15, 4.5, z), "X", Kit.Vivid(GOLD), { Mat = METAL })
		Kit.CylFlat(m, 0.2, 2.3, V(x0 - 0.38, 4.5, z), "X", SPECTRAL, { Mat = NEON })
	end
	-- spectral rune zigzag on the hull
	local runes = { V(x0 - 0.3, 0.8, 1690), V(x0 - 0.3, 7.6, 1700), V(x0 - 0.3, 1.2, 1712), V(x0 - 0.3, 7.2, 1724) }
	for i = 1, #runes - 1 do
		Props.Beam(m, runes[i], runes[i + 1], 0.35, 0.35, PURPLE, { Mat = NEON })
	end
	-- name board
	Props.SignBoard(m, V(x0 - 0.5, 13.8, 1690), 16, 3.2, -1, 0, "THE SALTY SPECTER", C(40, 30, 45), Kit.Vivid(GOLD), GOLD)

	-- green deck fog
	local fog = Kit.Part(m, V(30, 0.2, 70), CFrame.new(cx, 19, 1735), SPECTRAL, { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, SPECTRAL, 2, 10, 0.3)

	-- mooring bollards with ropes up to the hull
	for _, z in { 1690, 1770 } do
		Kit.Cyl(m, 2.4, 2, CFrame.new(121, 1.2, z), IRON, { Mat = METAL, Solid = true }).CanCollide = false -- small prop: tappable/queryable but walk-through (solid ones snag players)
		Kit.Cyl(m, 0.6, 2.8, CFrame.new(121, 2.5, z), IRON, { Mat = METAL })
		Props.Beam(m, V(121, 2.2, z), V(x0 - 0.2, 16, z + 4), 0.4, 0.4, ROPE)
		Kit.AddCircle(121, z, 2)
	end
	Kit.AddRect(124, zs - 6, 140, zt + 4)
end

local function lighthouse(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Lighthouse")
	local white, red = C(248, 245, 238), Kit.Vivid(C(205, 60, 60))
	local rock = C(105, 112, 125)
	Kit.Disc(m, x, z, 1.5, 24, 2, rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 9, V(x + 9, 0, z - 7), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 7, V(x - 7, 0, z + 9), rock, { Mat = ROCK, Solid = true })
	Kit.Ball(m, 6, V(x + 6, 0, z + 9), C(90, 100, 115), { Mat = ROCK })
	local seg = 12
	for i = 0, 5 do
		local d = 16 - i * 0.8
		Kit.Cyl(m, seg, d, CFrame.new(x, 1.5 + seg * i + seg / 2, z), if i % 2 == 0 then red else white, { Mat = Enum.Material.Plastic, Solid = true, Shadow = true })
	end
	-- door and windows on the side facing the boardwalk (-X)
	Kit.Box(m, V(x - 8.1, 1.5, z - 2.4), V(x - 7.4, 9, z + 2.4), PLANK_DARK, { Mat = WOOD })
	Kit.Box(m, V(x - 8.25, 8.6, z - 2.9), V(x - 7.4, 9.4, z + 2.9), Kit.Vivid(TEAL))
	for _, w in { { 1, 26 }, { 3, 50 } } do
		local r = (16 - w[1] * 0.8) / 2
		Kit.Box(m, V(x - r - 0.2, w[2] - 2, z - 1.2), V(x - r + 0.6, w[2] + 2, z + 1.2), C(55, 85, 120))
	end
	-- gallery + railing
	Kit.Disc(m, x, z, 75.5, 19, 1.5, IRON, { Mat = METAL })
	local posts: { Vector3 } = {}
	for i = 0, 5 do
		local a = i * math.pi / 3
		local p = V(x + math.cos(a) * 9, 75.5, z + math.sin(a) * 9)
		Kit.Box(m, p + V(-0.2, 0, -0.2), p + V(0.2, 3, 0.2), IRON, { Mat = METAL })
		table.insert(posts, p + V(0, 3, 0))
	end
	for i = 1, 6 do
		Props.Beam(m, posts[i], posts[(i % 6) + 1], 0.3, 0.3, red, { Mat = METAL })
	end
	-- lamp room: glass drum, warm lamp, frame
	Kit.Cyl(m, 8, 10, CFrame.new(x, 79.5, z), C(175, 230, 235), { Mat = Enum.Material.Glass, Transp = 0.5, Refl = 0.2 })
	local lamp = Kit.Ball(m, 4.5, V(x, 79.5, z), C(255, 225, 140), { Mat = NEON })
	Kit.Light(lamp, C(255, 215, 140), 60, 2.4)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local px, pz = x + math.cos(a) * 5, z + math.sin(a) * 5
		Kit.Box(m, V(px - 0.25, 75.5, pz - 0.25), V(px + 0.25, 83.6, pz + 0.25), IRON, { Mat = METAL })
	end
	-- roof
	Kit.Disc(m, x, z, 84.5, 12.5, 1, red)
	Kit.Cyl(m, 2, 9, CFrame.new(x, 85.5, z), red)
	Kit.Cyl(m, 2, 6, CFrame.new(x, 87.5, z), red)
	Kit.Cyl(m, 2, 3, CFrame.new(x, 89.5, z), red)
	Kit.Ball(m, 1.8, V(x, 91.2, z), Kit.Vivid(GOLD), { Mat = METAL })
	Kit.Cyl(m, 3, 0.3, CFrame.new(x, 93.5, z), IRON, { Mat = METAL })
	Kit.AddCircle(x, z, 14)
end

local function warehouse(f: Instance, z1: number, z2: number, wall: Color3, roof: Color3, text: string, flicker: boolean)
	local m = Kit.Model(f, "Warehouse")
	local xb, xf = -138, -112
	local h = 18
	local sol: Kit.Opts = { Mat = Enum.Material.Brick, Solid = true, Shadow = true }
	Kit.Box(m, V(xb, 0, z1), V(xb + 2, h, z2), wall, sol)
	Kit.Box(m, V(xb, 0, z1), V(xf, h, z1 + 2), wall, sol)
	Kit.Box(m, V(xb, 0, z2 - 2), V(xf, h, z2), wall, sol)
	for _, zz in { z1, z2 - 2 } do
		Kit.Box(m, V(xf - 0.6, 0, zz - 0.3), V(xf + 0.8, h + 0.4, zz + 2.3), PLANK_DARK, { Mat = WOOD, Solid = true })
	end
	local fascia = Kit.Box(m, V(xf - 1, h - 4, z1), V(xf + 0.6, h, z2), PLANK_DARK, { Mat = WOOD, Solid = true })
	Kit.Sign(fascia, Enum.NormalId.Right, text, Kit.Vivid(C(255, 225, 120)), { Stroke = C(30, 40, 60) })
	gable(m, CFrame.new((xb + xf) / 2, h, (z1 + z2) / 2) * CFrame.Angles(0, math.pi / 2, 0), z2 - z1 + 2, xf - xb + 4, 9, roof, Enum.Material.Slate)
	Kit.Box(m, V(xb + 2, 0, z1 + 2), V(xf, 0.06, z2 - 2), PLANK, { Mat = PLANKS })
	-- one ghostly window on the side wall that faces the gate
	Kit.Box(m, V(-130, 8, z1 - 0.25), V(-122, 12.5, z1 + 0.1), SPECTRAL, { Mat = NEON, Transp = 0.1 })
	-- stacked cargo inside
	local rng = Kit.Rng
	for zz = z1 + 6, z2 - 6, 7 do
		crate(m, V(-133.5, 0, zz), 5, rng:NextNumber(-0.1, 0.1))
		if rng:NextNumber() < 0.6 then
			crate(m, V(-133.5, 5, zz), 4.2, rng:NextNumber(-0.25, 0.25))
		end
	end
	barrel(m, V(-124, 0, z1 + 6), 4)
	barrel(m, V(-121, 0, z1 + 8.5), 4)
	-- hanging lantern at the front
	local lx, lz = xf + 1.6, (z1 + z2) / 2
	Kit.Box(m, V(lx - 0.15, h - 6, lz - 0.15), V(lx + 0.15, h - 4, lz + 0.15), IRON)
	local lamp = Kit.Box(m, V(lx - 0.8, h - 8, lz - 0.8), V(lx + 0.8, h - 6, lz + 0.8), WARM, if flicker then { Mat = NEON } else {})
	if flicker then
		Kit.Light(lamp, WARM, 22, 1.4, true)
	end
	Kit.AddRect(xb - 2, z1 - 1, xf + 3, z2 + 1)
end

local function hut(f: Instance, x: number, z: number, fx: number, col: Color3)
	local m = Kit.Model(f, "FishingHut")
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, Kit.FaceYaw(fx, 0), 0)
	Kit.Part(m, V(10, 9, 9), base * CFrame.new(0, 4.5, 0), col, { Mat = PLANKS, Solid = true, Shadow = true })
	Kit.Wedge(m, V(12, 3, 11), base * CFrame.new(0, 10.5, 0), C(60, 80, 115), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(m, V(3, 6, 0.3), base * CFrame.new(-2, 3, -4.6), PLANK_DARK, { Mat = WOOD })
	Kit.Part(m, V(2.6, 2.2, 0.3), base * CFrame.new(2.4, 5.2, -4.6), C(255, 215, 120))
	Kit.Part(m, V(0.2, 5, 6), base * CFrame.new(5.1, 4.8, 0), C(200, 190, 160), { Mat = FABRIC, Transp = 0.45 })
	Kit.CylFlat(m, 0.5, 2.6, (base * CFrame.new(2.4, 2.4, -4.8)).Position, "X", Kit.Vivid(RED))
	Props.Beam(m, (base * CFrame.new(-4.5, 1, -4.8)).Position, (base * CFrame.new(-6, 9, -9)).Position, 0.25, 0.25, PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function treasure(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "TreasurePile")
	local gold = Kit.Vivid(GOLD)
	local mo: Kit.Opts = { Mat = METAL, Refl = 0.2 }
	Kit.Ball(m, 9, V(x, -2.2, z), gold, mo)
	Kit.Ball(m, 6, V(x + 4, -1.6, z - 3.5), gold, mo)
	-- chest
	local wood = C(135, 82, 48)
	Kit.Box(m, V(x - 3, 0, z + 2), V(x + 2.4, 3.2, z + 5.6), wood, { Mat = WOOD, Solid = true })
	Kit.CylFlat(m, 5.4, 3.6, V(x - 0.3, 3.2, z + 3.8), "X", wood, { Mat = WOOD })
	for _, bx in { -2.2, 1.6 } do
		Kit.Box(m, V(x + bx - 0.3, 0, z + 1.9), V(x + bx + 0.3, 5.1, z + 5.7), gold, { Mat = METAL })
	end
	Kit.Box(m, V(x - 0.8, 2.2, z + 1.8), V(x + 0.2, 3.4, z + 2), gold, { Mat = METAL })
	-- spilled coins, gems, a crown
	for i = 0, 3 do
		local a = i * 1.7
		Kit.Disc(m, x + math.cos(a) * 6, z + math.sin(a) * 6, 0.25, 1.8, 0.2, gold, mo)
	end
	for i, g in { C(230, 60, 90), C(60, 200, 210), C(170, 90, 240) } do
		Kit.Ball(m, 1.3, V(x - 2 + i * 1.4, 2.3 - i * 0.3, z - 1 + i * 0.6), Kit.Vivid(g), { Refl = 0.3 })
	end
	Kit.Cyl(m, 1.2, 2.6, CFrame.new(x + 0.4, 2.6, z - 0.4) * CFrame.Angles(0.2, 0, 0.15), gold, mo)
	Props.SignBoard(m, V(x - 6.5, 3, z - 4), 6, 2.4, -1, 0, "DO NOT TOUCH\n(CURSED)", C(245, 238, 220), Kit.Vivid(RED))
	Kit.Box(m, V(x - 6.65, 0, z - 4.2), V(x - 6.35, 1.8, z - 3.8), PLANK_DARK)
	Kit.AddCircle(x, z, 8)
end

local function anchor(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Anchor")
	local col = C(70, 95, 110)
	Kit.Disc(m, x, z, 0.6, 9, 0.6, C(90, 100, 115), { Mat = COBBLE, Solid = true })
	Kit.Box(m, V(x - 1, 0, z - 1), V(x + 1, 15, z + 1), col, { Mat = METAL, Solid = true })
	Kit.Box(m, V(x - 5, 12, z - 0.8), V(x + 5, 13.6, z + 0.8), col, { Mat = METAL })
	Kit.Ball(m, 2.6, V(x, 16.4, z), Kit.Vivid(TEAL), { Mat = METAL })
	for _, s in { -1, 1 } do
		Props.Beam(m, V(x, 1.2, z), V(x + s * 6, 5.5, z), 1.6, 1.6, col, { Mat = METAL })
		Kit.Ball(m, 2.8, V(x + s * 6.2, 5.8, z), col, { Mat = METAL })
	end
	Kit.AddCircle(x, z, 7)
end

--==================================================================
-- GHOST AREA PAINT (flat only)
--==================================================================
local function deckPads(f: Instance)
	local pads = { { 0, 1645, 30 }, { -82, 1680, 24 }, { 75, 1740, 26 }, { -62, 1800, 24 }, { 0, 1860, 24 } }
	for i, p in pads do
		local ring = if i % 2 == 0 then Kit.Vivid(TEAL) else Kit.Vivid(C(110, 90, 170))
		Kit.Disc(f, p[1], p[2], 0.07, p[3] * 2 + 4, 0.07, ring)
		Kit.Disc(f, p[1], p[2], 0.1, p[3] * 2, 0.1, if i % 2 == 0 then PLANK else C(150, 108, 72), { Mat = PLANKS })
	end
	-- boss: compass rose + spectral rune ring
	local bx, bz = 0, 1860
	local gold = Kit.Vivid(GOLD)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Props.Beam(f, V(bx, 0.13, bz), V(bx + math.cos(a) * 18, 0.13, bz + math.sin(a) * 18), 2.6, 0.06, gold)
		local b = a + math.pi / 4
		Props.Beam(f, V(bx, 0.12, bz), V(bx + math.cos(b) * 11, 0.12, bz + math.sin(b) * 11), 1.8, 0.05, Kit.Vivid(TEAL))
	end
	Kit.Disc(f, bx, bz, 0.17, 5, 0.1, gold, { Mat = METAL })
	for i = 0, 7 do
		local a1 = i * math.pi / 4 + 0.12
		local a2 = a1 + math.pi / 4 - 0.24
		Props.Beam(f, V(bx + math.cos(a1) * 21, 0.14, bz + math.sin(a1) * 21), V(bx + math.cos(a2) * 21, 0.14, bz + math.sin(a2) * 21), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

--==================================================================
-- BUILD
--==================================================================
function Harbor.Build(map: Instance)
	local f = Kit.Folder(map, "Harbor")
	local rng = Kit.Rng

	ground(f)
	sideWalls(f)
	deckPads(f)
	ship(f)
	lighthouse(f, 116, 1866)
	warehouse(f, 1596, 1636, C(160, 82, 70), C(55, 95, 130), "FISH & SHIPS", false)
	warehouse(f, 1716, 1764, C(90, 110, 140), C(140, 60, 60), "CARGO", true)
	warehouse(f, 1836, 1880, C(130, 95, 75), C(60, 110, 120), "DOCK 13", false)

	-- pier across the inlet with a fishing hut at its end
	Kit.Box(f, V(104, -0.5, 1617), V(140, 0.06, 1631), PLANK, { Mat = PLANKS, Solid = true, Name = "Pier" })
	for _, x in { 107, 117, 127 } do
		for _, z in { 1616.6, 1631.4 } do
			Kit.Cyl(f, 3.5, 1.2, CFrame.new(x, 1.25, z), PLANK_DARK, { Mat = WOOD })
		end
	end
	hut(f, 133, 1624, -1, C(110, 140, 160))
	if Kit.IsFree(122, 1578, 7) then
		hut(f, 122, 1578, -1, C(170, 110, 90))
	end
	if Kit.IsFree(-64, 1600, 7) then
		hut(f, -64, 1600, 1, C(120, 150, 125))
	end
	if Kit.IsFree(70, 1830, 7) then
		hut(f, 70, 1830, -1, C(150, 120, 170))
	end

	-- floating spectral lanterns over the inlet and drifting bottles by the treasure
	for _, p in { V(110, 3.6, 1606), V(122, 4.2, 1644), V(136, 3.8, 1608), V(112, 4.4, 1641) } do
		local l = Kit.Part(f, V(1.2, 1.7, 1.2), CFrame.new(p), C(170, 255, 200), { Mat = NEON, Name = "FloatingLantern" })
		Kit.Float(l, rng:NextNumber(0.5, 1))
	end
	for _, p in { V(108, 3.5, 1712), V(124, 3.2, 1736) } do
		local b = Kit.Cyl(f, 1.8, 0.9, CFrame.new(p) * CFrame.Angles(0.5, 0, 0.3), C(120, 200, 170), { Mat = Enum.Material.Glass, Transp = 0.3, Name = "FloatingBottle" })
		Kit.Float(b, rng:NextNumber(0.5, 0.9))
	end
	-- pale fog rolling off the inlet
	local fog = Kit.Part(f, V(30, 0.2, 40), CFrame.new(122, 0.6, 1625), C(200, 235, 240), { Transp = 1, Name = "FogSource" })
	Kit.Emitter(fog, C(200, 235, 240), 1.5, 9, 0.3)

	treasure(f, 114, 1722)
	for _, s in { -1, 1 } do
		if Kit.IsFree(s * 40, 1872, 6) then
			anchor(f, s * 40, 1872)
		end
	end

	-- signs
	do
		local x, z = -60, 1578
		for _, s in { -1, 1 } do
			Kit.Cyl(f, 15, 1.4, CFrame.new(x + s * 11, 7.5, z), PLANK_DARK, { Mat = WOOD, Solid = true })
		end
		Props.SignBoard(f, V(x, 12, z), 22, 6, 0, -1, "⚓ HARBOR ⚓", C(40, 70, 110), C(255, 235, 170), TEAL)
		Kit.AddCircle(x, z, 13)
	end
	if Kit.IsFree(18, 1698, 4) then
		Kit.Box(f, V(17.6, 0, 1698.2), V(18.4, 5, 1698.8), PLANK_DARK, { Mat = WOOD })
		Props.SignBoard(f, V(18, 6.5, 1698), 12, 5, 0, -1, "NO GHOSTS ALLOWED\n...OOPS", C(245, 240, 225), Kit.Vivid(RED), RED)
		Kit.AddCircle(18, 1698, 6)
	end

	-- harbour lamps along the boardwalk
	local lit = 0
	for z = 1590, 1900, 34 do
		for _, s in { -1, 1 } do
			local zz = z + (if s > 0 then 17 else 0)
			local x = s * 12.5
			if Kit.IsFree(x, zz, 1.2, true) then
				lit += 1
				Props.StreetLamp(f, V(x, 0, zz), WARM, lit == 1 or lit == 4 or lit == 7)
				Kit.AddCircle(x, zz, 1.5)
			end
		end
	end

	-- cargo: crate stacks, barrel groups, rope coils, scattered on free quay
	local stacks, barrels, coils = 0, 0, 0
	for _ = 1, 500 do
		local x, z = rng:NextNumber(-134, 134), rng:NextNumber(1572, 1908)
		if stacks < 16 and Kit.IsFree(x + 2.3, z, 5.5) then
			stacks += 1
			local yaw = rng:NextNumber(-0.3, 0.3)
			crate(f, V(x, 0, z), 4.5, yaw)
			crate(f, V(x + 4.6, 0, z + rng:NextNumber(-0.5, 0.5)), 4.5, yaw)
			if rng:NextNumber() < 0.6 then
				crate(f, V(x + 2.3, 4.5, z), 4, yaw + 0.2)
			end
			Kit.AddCircle(x + 2.3, z, 5.5)
		elseif barrels < 12 and Kit.IsFree(x + 1.4, z, 4) then
			barrels += 1
			barrel(f, V(x, 0, z), 4.2)
			barrel(f, V(x + 2.9, 0, z + 1), 4.2)
			if rng:NextNumber() < 0.5 then
				Kit.CylFlat(f, 4.2, 2.8, V(x + 1.4, 1.4, z - 2.6), "X", C(150, 100, 62), { Mat = WOOD })
			end
			Kit.AddCircle(x + 1.4, z, 4)
		elseif coils < 6 and Kit.IsFree(x, z, 2) then
			coils += 1
			Kit.Disc(f, x, z, 0.6, 3.6, 0.6, ROPE, { Mat = FABRIC })
			Kit.Disc(f, x, z, 0.65, 1.4, 0.1, PLANK_DARK)
			Kit.AddCircle(x, z, 2)
		end
	end

	-- a few spectral cracks in the quay
	for _ = 1, 4 do
		local p = V(rng:NextNumber(-120, 95), 0.13, rng:NextNumber(1600, 1890))
		local a = rng:NextNumber(0, math.pi * 2)
		Props.Beam(f, p, p + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(5, 9), 0.45, 0.06, SPECTRAL, { Mat = NEON })
	end
end

return Harbor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Hatchery</string>
            <string name="Source"><![CDATA[--!strict
-- PET HATCHERY (workspace.Map.Hatchery): a small open pavilion in the left pocket behind the
-- spawn plaza (beside Ghost Hunter HQ), turned to face the plaza. Built in a local frame `base`
-- (origin CENTER = Config.Layout.Hatchery, local -Z = front, toward the spawn): footprint 21 x 13
-- studs, which lands at about X -39..-14, Z -106..-81 in the lobby (Builder reserves the pocket;
-- PetService's BuyEgg near check uses the same point).
--   One pedestal per egg (Config.EggOrder, left to right as seen from the plaza; four eggs are
--   built at PED_SCALE so they fit between the pillars), each with a big egg,
--   a price/unlock sign and an invisible PromptAnchor (attribute Egg = egg id) holding a "View"
--   ProximityPrompt. The client (Controllers/Hatchery) opens the egg panel from the prompt;
--   buying and rolling happen only on the server (PetService "BuyEgg").
-- Built last in Builder and without Kit.Rng, so it never shifts other zones' random props.

local Config = require(game:GetService("ReplicatedStorage").GH.Config)
local Format = require(game:GetService("ReplicatedStorage").GH.Logic.Format)
local Icons = require(game:GetService("ReplicatedStorage").GH.Icons)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Hatchery = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon

local CENTER: Vector3 = Config.Layout.Hatchery -- PetService BuyEgg near check uses this spot
local HW, HD = 10.5, 6.5 -- floor half width (local X) / half depth (local Z)
local PED_Z = 1.5 -- pedestal row (local Z, behind the middle)
local PED_GAP = 6 -- pedestal spacing at full size (up to three eggs)
local PED_GAP_4 = 5.1 -- four or more eggs: closer together...
local PED_SCALE_4 = 0.85 -- ...and slightly smaller (base 4.8 wide, sign 4.7 wide)
local PX, PZ = 9.5, 5.3 -- pillar offsets
local ROOF_Y = 12
local STONE = C(96, 84, 120)
local STONE_DARK = C(64, 54, 86)
local MOSS = C(70, 92, 70)
local SHARD = C(200, 160, 255)

-- Spirit Shard crystal (a diamond: a block turned 45 degrees), optionally floating.
local function crystal(parent: Instance, pos: Vector3, s: number, color: Color3, float: boolean)
	local p = Kit.Part(parent, V(s, s * 1.6, s), CFrame.new(pos) * CFrame.Angles(0, math.rad(45), math.rad(12)), color, { Mat = Enum.Material.Glass, Transp = 0.15, Refl = 0.2 })
	if float then
		Kit.Float(p, 0.6)
	end
	return p
end

-- `at` is the pedestal top centre; dz > 0 moves toward the front (local -Z).
local function off(at: CFrame, dx: number, dy: number, dz: number): CFrame
	return at * CFrame.new(dx, dy, -dz)
end

-- The egg: two stacked balls (wide bottom, narrower top) read as an egg shape.
local function eggShape(parent: Instance, at: CFrame, color: Color3, opts: Kit.Opts?): Part
	local low = Kit.Ball(parent, 4.2, off(at, 0, 2.1, 0).Position, color, opts)
	Kit.Ball(parent, 3.4, off(at, 0, 3.6, 0).Position, color, opts)
	return low
end

local function hauntedEgg(m: Instance, at: CFrame, egg: Config.EggDef)
	eggShape(m, at, Kit.Vivid(egg.Color))
	-- green ecto cracks across the front (thin neon strips: the egg's one glowing accent)
	local cracks = { { -0.9, 2.4, 25 }, { 0.2, 2.9, -35 }, { 0.9, 2.2, 40 }, { -0.2, 3.9, 60 } }
	for _, c in cracks do
		Kit.Part(m, V(0.18, 1.2, 0.2), off(at, c[1], c[2], 2.05) * CFrame.Angles(0, 0, math.rad(c[3])), egg.Accent, { Mat = NEON })
	end
	-- dark speckles
	for _, sp in { { -1.3, 1.6 }, { 1.2, 3.4 }, { 0.6, 1.2 } } do
		Kit.Ball(m, 0.6, off(at, sp[1], sp[2], 1.75).Position, C(70, 30, 120))
	end
end

local function phantomEgg(m: Instance, at: CFrame, egg: Config.EggDef)
	eggShape(m, at, egg.Color, { Mat = Enum.Material.Glass, Transp = 0.3, Refl = 0.1 })
	-- inner soft core
	Kit.Ball(m, 2.4, off(at, 0, 2.5, 0).Position, egg.Accent, { Transp = 0.4 })
	-- ghost face on the front
	local dark = C(30, 30, 60)
	Kit.Ball(m, 0.8, off(at, -0.7, 3.4, 1.55).Position, dark)
	Kit.Ball(m, 0.8, off(at, 0.7, 3.4, 1.55).Position, dark)
	Kit.Part(m, V(0.9, 0.6, 0.3), off(at, 0, 2.4, 2.0), dark)
end

local function moonlightEgg(m: Instance, at: CFrame, egg: Config.EggDef)
	eggShape(m, at, egg.Color, { Refl = 0.15 })
	-- crescent moon: a pale disc partly covered by an egg-coloured disc
	local spin = CFrame.Angles(0, math.pi / 2, 0)
	Kit.Part(m, V(0.2, 1.6, 1.6), off(at, -0.2, 3.0, 2.0) * spin, egg.Accent, { Shape = Enum.PartType.Cylinder })
	Kit.Part(m, V(0.2, 1.4, 1.4), off(at, 0.2, 3.15, 2.08) * spin, egg.Color, { Shape = Enum.PartType.Cylinder })
	-- stars
	for _, s in { { -1.2, 1.7 }, { 1.1, 2.0 }, { 0.8, 4.1 }, { -0.9, 4.0 }, { 0.1, 1.2 } } do
		Kit.Ball(m, 0.35, off(at, s[1], s[2], 1.85).Position, C(255, 245, 200), { Mat = NEON })
	end
end

local function cursedEgg(m: Instance, at: CFrame, egg: Config.EggDef)
	eggShape(m, at, egg.Color, { Refl = 0.08 })
	-- two slanted glowing eye slits and a jagged crack (the egg's few glowing accents)
	for _, s in { -1, 1 } do
		Kit.Part(m, V(0.9, 0.22, 0.2), off(at, 0.62 * s, 3.55, 1.6) * CFrame.Angles(0, 0, math.rad(-18 * s)), egg.Accent, { Mat = NEON })
	end
	local crack = { { -0.4, 2.3, 30 }, { 0.15, 1.8, -35 }, { 0.6, 1.35, 30 } }
	for _, c in crack do
		Kit.Part(m, V(0.16, 0.9, 0.2), off(at, c[1], c[2], 2.08) * CFrame.Angles(0, 0, math.rad(c[3])), egg.Accent, { Mat = NEON })
	end
	-- a band of dark thorns around the middle
	for i = 0, 5 do
		local a = math.rad(i * 60)
		Kit.Part(m, V(0.4, 0.9, 0.4), at * CFrame.Angles(0, a, 0) * CFrame.new(0, 2.7, -2.0) * CFrame.Angles(math.rad(-60), 0, 0), C(70, 20, 50))
	end
	-- floating curse wisps
	for _, w in { { -2.2, 4.6, 0.6 }, { 2.1, 2.2, 0.9 } } do
		local wisp = Kit.Ball(m, 0.55, off(at, w[1], w[2], w[3]).Position, C(150, 60, 190), { Transp = 0.3 })
		Kit.Float(wisp, 0.4)
	end
end

local EGG_LOOK: { [string]: (Instance, CFrame, Config.EggDef) -> () } = {
	HauntedEgg = hauntedEgg,
	PhantomEgg = phantomEgg,
	MoonlightEgg = moonlightEgg,
	CursedEgg = cursedEgg,
}

-- Shrinks a built pedestal model by k around its origin (sizes, offsets and light ranges).
local function scaleModel(m: Instance, origin: CFrame, k: number)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = origin:ToObjectSpace(d.CFrame)
			d.Size *= k
			d.CFrame = origin * CFrame.new(rel.Position * k) * rel.Rotation
		elseif d:IsA("PointLight") then
			d.Range *= k
		end
	end
end

local function pedestal(parent: Instance, base: CFrame, egg: Config.EggDef, x: number, scale: number)
	local m = Kit.Model(parent, "Pedestal_" .. egg.Id)
	local pcf = base * CFrame.new(x, 0, PED_Z)
	local function at(dx: number, dy: number, dz: number): CFrame
		return off(pcf, dx, dy, dz)
	end
	-- stepped stone pedestal
	local basePart = Kit.Cyl(m, 0.6, 5.6, at(0, 0.5, 0), STONE_DARK, { Mat = Enum.Material.Slate, Solid = true, Name = "Base" })
	Kit.Cyl(m, 2.2, 4, at(0, 1.9, 0), STONE, { Mat = Enum.Material.Slate, Solid = true })
	Kit.Cyl(m, 0.4, 4.8, at(0, 3.1, 0), Kit.Vivid(egg.Accent))
	local top = at(0, 3.3, 0)
	local look = EGG_LOOK[egg.Id]
	if look then
		look(m, top, egg)
	else
		eggShape(m, top, egg.Color)
	end
	-- soft glow under the egg (low brightness: no bloom spike)
	local glow = Kit.Part(m, V(1, 1, 1), at(0, 5, 2), egg.Accent, { Transp = 1, Name = "Glow" })
	Kit.Light(glow, egg.Accent, 12, 0.7)
	-- floating Spirit Shard crystals beside the egg
	crystal(m, at(-2.4, 7.4, 0).Position, 0.7, SHARD, true)
	crystal(m, at(2.4, 8, 0).Position, 0.6, SHARD, true)

	-- price / unlock sign in front of the pedestal, facing the plaza
	local signCF = at(0, 2.6, 4.2) * CFrame.Angles(math.rad(-12), 0, 0)
	local board = Kit.Part(m, V(5, 3, 0.4), signCF, C(35, 22, 60), { Name = "EggSign" })
	Kit.Part(m, V(5.5, 3.5, 0.3), signCF * CFrame.new(0, 0, 0.3), Kit.Vivid(egg.Accent))
	Kit.Part(m, V(0.5, 0.8, 0.5), at(0, 0.4, 3.9), STONE_DARK)
	local g = Kit.Gui(board, Enum.NormalId.Front)
	Kit.Label(g, string.upper(egg.Name), C(255, 255, 255), { Size = UDim2.fromScale(0.94, 0.34), Pos = UDim2.fromScale(0.03, 0.04) })
	-- price: the Spirit Shards icon image left of the number (emoji only without an image id);
	-- the icon is square at the row height (0.3 of the 3-stud board = 0.18 of its 5-stud width)
	local price = Format.Commas(egg.Price)
	local shards = Icons.Get("shards")
	if shards then
		local img = Instance.new("ImageLabel")
		img.Name = "ShardIcon"
		img.BackgroundTransparency = 1
		img.Image = shards
		img.ScaleType = Enum.ScaleType.Fit
		img.Position = UDim2.fromScale(0.14, 0.38)
		img.Size = UDim2.fromScale(0.18, 0.3)
		img.Parent = g
		local label = Kit.Label(g, price, SHARD, { Name = "Price", Size = UDim2.fromScale(0.52, 0.3), Pos = UDim2.fromScale(0.34, 0.38) })
		label.TextXAlignment = Enum.TextXAlignment.Left
	else
		Kit.Label(g, "🔮 " .. price, SHARD, { Name = "Price", Size = UDim2.fromScale(0.8, 0.3), Pos = UDim2.fromScale(0.1, 0.38) })
	end
	local unlock = if egg.Unlock > 0 then "Unlock: Tower checkpoint " .. egg.Unlock else "Open to everyone"
	Kit.Label(g, unlock, C(150, 255, 170), { Size = UDim2.fromScale(0.94, 0.22), Pos = UDim2.fromScale(0.03, 0.72) })

	-- invisible prompt anchor in front of the sign
	local anchor = Kit.Part(m, V(1, 1, 1), at(0, 3, 5.5), egg.Color, { Transp = 1, Name = "PromptAnchor" })
	anchor:SetAttribute("Egg", egg.Id)
	-- pcall: the headless world simulator (tools/worldsim) has no ProximityPrompt class
	pcall(function()
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EggPrompt"
		prompt.ActionText = "View"
		prompt.ObjectText = egg.Name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt:SetAttribute("Egg", egg.Id)
		prompt.Parent = anchor
	end)
	if scale ~= 1 then
		scaleModel(m, pcf, scale)
	end
	m.PrimaryPart = basePart
end

-- Small leaning tombstone (garden decoration), facing the plaza.
local function tomb(parent: Instance, cf: CFrame, tilt: number)
	local t = cf * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(tilt))
	Kit.Part(parent, V(2, 2.8, 0.6), t, C(150, 145, 165), { Mat = Enum.Material.Slate, Solid = true })
	Kit.Part(parent, V(0.6, 2, 2), t * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, math.pi / 2, 0), C(150, 145, 165), { Mat = Enum.Material.Slate, Shape = Enum.PartType.Cylinder })
	Kit.Part(parent, V(2.4, 0.3, 1), cf * CFrame.new(0, 0.15, 0), MOSS)
end

function Hatchery.Build(map: Instance)
	local m = Kit.Model(map, "Hatchery")
	local spawnPos = Config.Layout.Spawn
	local c = CENTER
	local base = CFrame.new(c) * CFrame.Angles(0, Kit.FaceYaw(spawnPos.X - c.X, spawnPos.Z - c.Z), 0)
	local function L(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end

	-- mossy flagstone floor (low: stepped onto, not a wall) with a cobble apron at the front
	local floor = Kit.Part(m, V(HW * 2, 0.6, HD * 2), L(0, -0.1, 0), C(80, 72, 100), { Mat = Enum.Material.Slate, Solid = true, Name = "Floor" })
	Kit.Part(m, V(HW * 2 - 2, 0.04, 4.6), L(0, 0.22, -HD + 3.3), C(105, 92, 135), { Mat = Enum.Material.Cobblestone, Solid = true })

	-- iron garden fence along the back and both sides (the front stays open)
	local function at(x: number, z: number): Vector3
		return L(x, 0.2, z).Position
	end
	Props.Fence(m, at(-HW, HD), at(HW, HD), "iron")
	Props.Fence(m, at(-HW, HD), at(-HW, -HD + 2), "iron")
	Props.Fence(m, at(HW, HD), at(HW, -HD + 2), "iron")

	-- open pavilion: four stone pillars and a slate roof over the pedestals
	for _, px in { -PX, PX } do
		for _, pz in { -PZ, PZ } do
			Kit.Part(m, V(1.6, ROOF_Y - 0.2, 1.6), L(px, 0.2 + (ROOF_Y - 0.2) / 2, pz), STONE, { Mat = Enum.Material.Slate, Solid = true })
			Kit.Part(m, V(2.4, 1, 2.4), L(px, 0.7, pz), STONE_DARK, { Mat = Enum.Material.Slate, Solid = true })
		end
	end
	local rw, rd = PX * 2 + 3, PZ * 2 + 3
	Kit.Part(m, V(rw, 1, rd), L(0, ROOF_Y + 0.5, 0), STONE_DARK, { Mat = Enum.Material.Slate, Shadow = true })
	local roofC = C(70, 40, 110)
	Kit.Wedge(m, V(rw, 3.5, rd / 2), L(0, ROOF_Y + 2.75, -rd / 4), roofC, { Mat = Enum.Material.Slate })
	Kit.Wedge(m, V(rw, 3.5, rd / 2), L(0, ROOF_Y + 2.75, rd / 4) * CFrame.Angles(0, math.pi, 0), roofC, { Mat = Enum.Material.Slate })
	-- back wall panel so the eggs read against a dark backdrop
	Kit.Part(m, V(PX * 2, 8.4, 0.8), L(0, 4.4, PZ), C(45, 30, 75), { Mat = Enum.Material.Slate, Solid = true })

	-- big sign over the front of the pavilion, facing the plaza
	local signCF = L(0, ROOF_Y - 1.5, -PZ - 1.1)
	local sign = Kit.Part(m, V(14, 3, 0.6), signCF, C(35, 22, 60), { Name = "HatcherySign" })
	Kit.Part(m, V(15, 3.8, 0.4), signCF * CFrame.new(0, 0, 0.4), Kit.Vivid(SHARD))
	Kit.Sign(sign, Enum.NormalId.Front, "🥚 PET HATCHERY 🥚", C(255, 240, 160))

	-- pedestals (Config.EggOrder, left to right as seen from the plaza)
	local n = #Config.EggOrder
	local gap, scale = PED_GAP, 1
	if n >= 4 then
		gap, scale = PED_GAP_4, PED_SCALE_4
	end
	for i, id in Config.EggOrder do
		local egg = Config.Eggs[id]
		if egg then
			pedestal(m, base, egg, (i - (n + 1) / 2) * gap, scale)
		end
	end

	-- graveyard garden outside the fence: tombstones, lanterns at the open front, a shard cluster
	-- (nothing stands between the visitor and the egg price signs)
	tomb(m, L(-HW - 1.8, 0.2, 1), 6)
	tomb(m, L(-HW - 1.8, 0.2, 4.5), -5)
	tomb(m, L(HW + 1.8, 0.2, 3), -7)
	Props.Lantern(m, L(-HW - 1, 0.2, -HD - 1).Position, SHARD, true, false)
	Props.Lantern(m, L(HW + 1, 0.2, -HD - 1).Position, SHARD, false, false)
	local cluster = L(HW + 2, 0.2, -1).Position
	crystal(m, cluster + V(0, 1.4, 0), 1.2, SHARD, false)
	crystal(m, cluster + V(-0.6, 0.9, 0.7), 0.8, C(170, 130, 255), false)
	crystal(m, cluster + V(0.6, 0.8, -0.6), 0.7, C(220, 190, 255), false)
	crystal(m, cluster + V(0, 4.2, 0), 0.6, SHARD, true)

	m.PrimaryPart = floor
end

return Hatchery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Hospital</string>
            <string name="Source"><![CDATA[--!strict
-- ZONE 5: Haunted Hospital (Z 1220..1560). Playful, pastel and a little supernatural (no gore).
--   Courtyard Z 1220..1268: path, Medical crate station (built by Stations), ambulance, sign,
--   planters, entrance canopy with the HOSPITAL facade and a red cross on a blue/white emblem.
--   Building X -113..113, Z 1269..1535, two-tone walls 16 tall, NO roof (parapet only) so the
--   camera and ghost taps work from above. Rooms (ghost areas in brackets):
--     Lobby / waiting room  X -51..49,  Z 1271..1351  [ (0,1305) r30 ]   reception desk, chairs
--     Ward B                X -111..-53, Z 1271..1397  [ (-82,1340) r24 ] beds in the corners
--     Patient rooms         X 51..111,   Z 1271..1351                    beds, curtains, monitors
--     X-Ray                 X 41..111,   Z 1353..1443  [ (75,1395) r26 ]  machine, lightbox
--     Atrium (hallway)      X -51..39,   Z 1353..1443                    elevators, carts
--     Paranormal lab        X -111..-33, Z 1399..1533  [ (-62,1455) r24 ] ecto tanks, spirit coil
--     Director's office     X -31..31,   Z 1445..1533  [ (0,1505) r22 boss ]
--     Pharmacy              X 33..111,   Z 1445..1533                    counter, shelves
--   Main path: front door (X -14..14) -> lobby -> atrium -> director's office -> back door
--   (X -14..14) -> back yard -> Harbor gate. Every doorway is a full-height opening >= 16 wide.
--   Landmark: the west wing tower (X -111..-85, Z 1507..1533, roof Y 72, antenna to ~Y 83).
-- Glow is kept to a few ghostly windows, ecto tanks, puddles, sconces and small lamps.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Hospital = {}

local C = Color3.fromRGB
local V = Vector3.new
local NEON = Enum.Material.Neon
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal
local CONCRETE = Enum.Material.Concrete
local WOOD = Enum.Material.WoodPlanks

local MIN_Z, MAX_Z = 1220, 1560
local H = 16
local FLOOR_Y = 0.13 -- top of the room floor paint
local WHITE = C(242, 244, 248)
local LBLUE = C(150, 205, 240)
local MGREEN = C(150, 200, 170)
local PURPLE = C(170, 120, 230)
local SPECT = C(130, 255, 190)
local DARK = C(45, 55, 85)
local REDX = C(235, 70, 80)
local GREY = C(190, 195, 210)
local SOLID: Kit.Opts = { Solid = true, Shadow = true }

local function faced(center: Vector3, fx: number, fz: number): CFrame
	return CFrame.new(center) * CFrame.Angles(0, Kit.FaceYaw(fx, fz), 0)
end

--==================================================================
-- WALL HELPERS (two-tone: mint wainscot below, off-white above)
--==================================================================
type Opening = { c: number, w: number }

local LOWER = C(170, 215, 195)
local UPPER = C(236, 240, 244)

local function seg(parent: Instance, lo: Vector3, hi: Vector3)
	Kit.Box(parent, V(lo.X, 0, lo.Z), V(hi.X, 4.5, hi.Z), LOWER, SOLID)
	Kit.Box(parent, V(lo.X, 4.5, lo.Z), V(hi.X, H, hi.Z), UPPER, SOLID)
end

local function byCentre(a: Opening, b: Opening): boolean
	return a.c < b.c
end

-- Wall along X at fixed z (thickness 2) with full-height openings.
local function wallX(parent: Instance, z: number, x1: number, x2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = x1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(cur, 0, z - 1), V(a, 0, z + 1))
		end
		cur = o.c + o.w / 2
	end
	if x2 > cur then
		seg(parent, V(cur, 0, z - 1), V(x2, 0, z + 1))
	end
end

-- Wall along Z at fixed x (thickness 2) with full-height openings.
local function wallZ(parent: Instance, x: number, z1: number, z2: number, openings: { Opening })
	table.sort(openings, byCentre)
	local cur = z1
	for _, o in openings do
		local a = o.c - o.w / 2
		if a > cur then
			seg(parent, V(x - 1, 0, cur), V(x + 1, 0, a))
		end
		cur = o.c + o.w / 2
	end
	if z2 > cur then
		seg(parent, V(x - 1, 0, cur), V(x + 1, 0, z2))
	end
end

-- Wall lamp; fx = direction the lamp faces (wall face is behind it).
local function sconce(parent: Instance, pos: Vector3, fx: number, color: Color3)
	local lamp = Kit.Part(parent, V(0.8, 1.8, 2.2), CFrame.new(pos), color, { Mat = NEON })
	Kit.Part(parent, V(0.5, 0.4, 2.8), CFrame.new(pos + V(-fx * 0.15, 1.1, 0)), DARK)
	Kit.Light(lamp, color, 24, 1.5, true)
end

local function puddle(parent: Instance, x: number, z: number, d: number)
	Kit.Disc(parent, x, z, 0.22, d, 0.08, SPECT, { Mat = NEON, Transp = 0.25 })
end

--==================================================================
-- FURNITURE
--==================================================================
-- Hospital bed; (hx, hz) points toward the head end.
local function bed(f: Instance, x: number, z: number, hx: number, hz: number)
	local m = Kit.Model(f, "Bed")
	local base = faced(V(x, FLOOR_Y, z), hx, hz)
	Kit.Part(m, V(5, 2.2, 9), base * CFrame.new(0, 1.1, 0), WHITE, { Solid = true })
	Kit.Part(m, V(4.6, 1, 8.6), base * CFrame.new(0, 2.7, 0), Kit.Vivid(LBLUE), { Mat = FABRIC })
	Kit.Part(m, V(3.6, 0.8, 1.8), base * CFrame.new(0, 3.5, -3.2), WHITE, { Mat = FABRIC })
	Kit.Part(m, V(5.4, 5, 0.6), base * CFrame.new(0, 2.5, -4.7), Kit.Vivid(MGREEN))
	Kit.Part(m, V(4.8, 0.4, 4.6), base * CFrame.new(0, 3.3, 1.9), PURPLE:Lerp(WHITE, 0.35), { Mat = FABRIC })
	Kit.AddCircle(x, z, 5)
end

local function ivStand(f: Instance, x: number, z: number)
	Kit.Cyl(f, 7, 0.3, CFrame.new(x, FLOOR_Y + 3.5, z), GREY, { Mat = METAL })
	Kit.Box(f, V(x - 0.4, 5.6, z - 0.2), V(x + 0.4, 7, z + 0.2), Kit.Vivid(MGREEN), { Transp = 0.3 })
end

local function wheelchair(f: Instance, x: number, z: number, fx: number, fz: number)
	local m = Kit.Model(f, "Wheelchair")
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	local frame = Kit.Vivid(PURPLE)
	Kit.Part(m, V(2.6, 0.5, 2.4), base * CFrame.new(0, 2.2, 0), Kit.Vivid(LBLUE))
	Kit.Part(m, V(2.6, 3, 0.4), base * CFrame.new(0, 3.6, 1.2), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.3, 3.4, 3.4), base * CFrame.new(sx * 1.55, 1.7, 0.3), frame, { Shape = Enum.PartType.Cylinder })
	end
	Kit.Part(m, V(2.2, 0.3, 1), base * CFrame.new(0, 0.8, -1.8), frame)
	Kit.AddCircle(x, z, 2.5)
end

local function medCart(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "MedCart")
	Kit.Box(m, V(x - 2, 3.2, z - 1.3), V(x + 2, 3.6, z + 1.3), WHITE)
	Kit.Box(m, V(x - 2, 1, z - 1.3), V(x + 2, 1.3, z + 1.3), WHITE)
	for _, s in { -1, 1 } do
		Kit.Box(m, V(x + s * 1.85, FLOOR_Y, z - 1.3), V(x + s * 2.05, 3.2, z + 1.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x - 1.4, 3.6, z - 0.6), V(x - 0.2, 4.4, z + 0.6), Kit.Vivid(C(255, 150, 190)))
	Kit.Cyl(m, 1.2, 0.7, CFrame.new(x + 1, 4.2, z), Kit.Vivid(MGREEN))
	Kit.AddCircle(x, z, 3)
end

-- Bedside monitor with a SurfaceGui screen facing fx (-1 = -X, 1 = +X).
local function monitor(f: Instance, x: number, z: number, fx: number)
	Kit.Box(f, V(x - 0.25, FLOOR_Y, z - 0.25), V(x + 0.25, 5, z + 0.25), GREY, { Mat = METAL })
	local scr = Kit.Part(f, V(0.4, 2.2, 3), CFrame.new(x, 6, z), DARK)
	Kit.Sign(scr, if fx < 0 then Enum.NormalId.Left else Enum.NormalId.Right, "♥ BOO ♥", SPECT)
end

-- Row of joined waiting-room chairs along Z (facing +X when fx = 1).
local function chairRow(f: Instance, x: number, z1: number, z2: number, fx: number, color: Color3)
	Kit.Box(f, V(x - 1.5, 1.8, z1), V(x + 1.5, 2.4, z2), color, { Solid = true })
	Kit.Box(f, V(x - fx * 1.5, 2.4, z1), V(x - fx * 1, 5, z2), color)
	for _, z in { z1 + 0.8, z2 - 0.8 } do
		Kit.Box(f, V(x - 1.2, FLOOR_Y, z - 0.35), V(x + 1.2, 1.8, z + 0.35), GREY, { Mat = METAL })
	end
	Kit.AddRect(x - 2, z1, x + 2, z2)
end

local function chair(f: Instance, x: number, z: number, fx: number, fz: number, color: Color3)
	local base = faced(V(x, FLOOR_Y, z), fx, fz)
	Kit.Part(f, V(2.4, 2, 2.4), base * CFrame.new(0, 1, 0), color, { Solid = true }).CanCollide = false -- small prop: tappable/queryable but walk-through (solid ones snag players)
	Kit.Part(f, V(2.4, 2.6, 0.5), base * CFrame.new(0, 3.3, 0.95), color)
end

local function plant(f: Instance, x: number, z: number)
	Kit.Cyl(f, 2.4, 2.4, CFrame.new(x, FLOOR_Y + 1.2, z), WHITE)
	Kit.Ball(f, 3.6, V(x, 4, z), C(110, 180, 120), { Mat = Enum.Material.Grass })
	Kit.AddCircle(x, z, 2)
end

local function bench(f: Instance, x: number, z: number, fx: number, fz: number)
	local base = faced(V(x, 0, z), fx, fz)
	Kit.Part(f, V(6, 0.6, 2.2), base * CFrame.new(0, 2, 0), C(190, 140, 100), { Mat = WOOD, Solid = true })
	Kit.Part(f, V(6, 2.4, 0.5), base * CFrame.new(0, 3.6, 1), C(190, 140, 100), { Mat = WOOD })
	for _, sx in { -1, 1 } do
		Kit.Part(f, V(0.5, 2, 2), base * CFrame.new(sx * 2.6, 1, 0), Kit.Vivid(LBLUE))
	end
	Kit.AddCircle(x, z, 3.5)
end

local function floater(f: Instance, size: Vector3, pos: Vector3, color: Color3, name: string, shape: Enum.PartType?)
	local rng = Kit.Rng
	local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
	local p = Kit.Part(f, size, cf, color, { Name = name, Shape = shape })
	Kit.Float(p, rng:NextNumber(0.6, 1.1))
end

--==================================================================
-- GROUND, SIDE WALLS, OUTSIDE
--==================================================================
local function ground(f: Instance)
	Kit.Box(f, V(-190, -4, MIN_Z), V(190, 0, MAX_Z), C(125, 190, 135), { Mat = Enum.Material.Grass, Solid = true, Name = "Ground_Hospital" })
	-- paved path to the front door and from the back door to the Harbor gate (flat)
	local pave = C(210, 215, 225)
	Kit.Box(f, V(-10, 0, MIN_Z), V(10, 0.05, 1269), pave, { Mat = CONCRETE, Name = "Path" })
	Kit.Box(f, V(-10, 0, 1535), V(10, 0.05, MAX_Z), pave, { Mat = CONCRETE, Name = "Path" })
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 10, 0, MIN_Z), V(s * 10.8, 0.06, 1269), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 10, 0, 1535), V(s * 10.8, 0.06, MAX_Z), Kit.Vivid(LBLUE))
	end
end

local function sideWalls(f: Instance)
	local z0, z1 = MIN_Z + 3, MAX_Z - 3
	for _, s in { -1, 1 } do
		Kit.Box(f, V(s * 140, 0, z0), V(s * 146, 12, z1), WHITE, { Mat = CONCRETE, Solid = true })
		Kit.Box(f, V(s * 139.5, 12, z0), V(s * 146.5, 13.2, z1), Kit.Vivid(LBLUE), { Mat = Enum.Material.Slate })
		Kit.Box(f, V(s * 139.8, 3, z0), V(s * 140, 4.2, z1), Kit.Vivid(MGREEN))
		for i = 1, 7 do
			local z = z0 + i * (z1 - z0) / 8
			Kit.Box(f, V(s * 139, 0, z - 2.5), V(s * 147, 15, z + 2.5), C(215, 225, 235), SOLID)
			Kit.Ball(f, 3.4, V(s * 143, 16.6, z), Kit.Vivid(C(140, 220, 180)))
		end
	end
end

local function outside(f: Instance)
	local hill = { C(110, 160, 140), C(140, 120, 200), C(120, 175, 150) }
	for i, z in { 1265, 1400, 1525 } do
		for _, s in { -1, 1 } do
			Kit.Ball(f, 70, V(s * 190, -14, z - s * 15), hill[(i + (if s > 0 then 1 else 0)) % #hill + 1], { Mat = Enum.Material.Grass })
		end
	end
	-- annex blocks beyond the walls
	for _, a in { V(-1, 0, 1330), V(1, 0, 1440) } do
		local s, z = a.X, a.Z
		Kit.Box(f, V(s * 156, 0, z - 22), V(s * 186, 30, z + 22), C(232, 236, 240), { Mat = CONCRETE })
		Kit.Box(f, V(s * 155.7, 18, z - 20), V(s * 155.9, 23, z + 20), Kit.Vivid(LBLUE))
		Kit.Box(f, V(s * 155.5, 30, z - 22.5), V(s * 186.5, 31.5, z + 22.5), Kit.Vivid(MGREEN))
	end
	for _, z in { 1240, 1545 } do
		for _, s in { -1, 1 } do
			Props.Tree(f, V(s * 158, 0, z), 20 + Kit.Rng:NextNumber(0, 8), Kit.Pick({ C(120, 190, 130), C(170, 120, 220), C(100, 170, 150) }))
		end
	end
end

--==================================================================
-- COURTYARD
--==================================================================
local function ambulance(f: Instance, x: number, z: number)
	local m = Kit.Model(f, "Ambulance")
	local base = faced(V(x, 0, z), -1, 0) -- front toward the path (-X)
	local cargo = Kit.Part(m, V(8, 7.5, 11), base * CFrame.new(0, 5.25, 2.5), WHITE, SOLID)
	cargo.Name = "Cargo"
	Kit.Part(m, V(7.6, 5.5, 5), base * CFrame.new(0, 4.25, -5.5), WHITE, SOLID)
	local glass = Kit.Vivid(C(170, 225, 255))
	Kit.Part(m, V(6.6, 2.4, 0.3), base * CFrame.new(0, 5.6, -8.05), glass, { Refl = 0.2 })
	Kit.Part(m, V(7.7, 2.2, 3), base * CFrame.new(0, 5.6, -5.4), glass, { Refl = 0.2 })
	Kit.Part(m, V(8.1, 1.2, 11.1), base * CFrame.new(0, 4.5, 2.5), REDX)
	Kit.Part(m, V(7.7, 0.8, 5.1), base * CFrame.new(0, 3.2, -5.5), Kit.Vivid(LBLUE))
	for _, sx in { -1, 1 } do
		Kit.Part(m, V(0.2, 3, 1), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		Kit.Part(m, V(0.2, 1, 3), base * CFrame.new(sx * 4.05, 7, 3), REDX)
		for _, sz in { -5, 5.5 } do
			Kit.Part(m, V(1.2, 3.4, 3.4), base * CFrame.new(sx * 3.8, 1.7, sz), DARK, { Shape = Enum.PartType.Cylinder })
		end
		Kit.Part(m, V(0.9, 0.8, 0.2), base * CFrame.new(sx * 2.7, 3, -8.05), C(255, 240, 170))
		Kit.Part(m, V(2.2, 0.9, 1.2), base * CFrame.new(sx * 1.2, 9.45, -1.5), if sx < 0 then REDX else C(90, 160, 255), { Mat = NEON })
	end
	Kit.Part(m, V(7.8, 0.8, 0.6), base * CFrame.new(0, 1.8, -8.3), GREY)
	local tag = Kit.Part(m, V(6, 1, 0.2), base * CFrame.new(0, 7.6, -8.1), WHITE)
	Kit.Sign(tag, Enum.NormalId.Front, "AMBULANCE 👻", REDX, { Stroke = WHITE })
	Kit.AddCircle(x, z, 11)
end

local function courtyard(f: Instance)
	ambulance(f, 72, 1250)
	for _, z in { 1242, 1258 } do
		Kit.Box(f, V(60, 0, z - 0.3), V(86, 0.05, z + 0.3), WHITE)
	end
	-- welcome sign
	Kit.Box(f, V(-74, 0, 1256.5), V(-50, 3, 1259.5), WHITE, { Mat = CONCRETE, Solid = true })
	Props.SignBoard(f, V(-62, 6.4, 1258), 22, 6, 0, -1, "HAUNTED HOSPITAL\nvisiting hours: forever", C(60, 110, 170), WHITE, MGREEN)
	Kit.AddRect(-75, 1255, -49, 1261)
	-- planters
	for _, x in { -96, -44, 44, 96 } do
		if Kit.IsFree(x, 1263, 3) then
			Kit.Box(f, V(x - 2.5, 0, 1260.5), V(x + 2.5, 2, 1265.5), WHITE, { Mat = CONCRETE, Solid = true })
			Kit.Ball(f, 5, V(x, 3, 1263), C(110, 180, 120), { Mat = Enum.Material.Grass })
			Kit.AddCircle(x, 1263, 3)
		end
	end
	Props.StreetLamp(f, V(-104, 0, 1245), C(190, 235, 255), true)
	Props.StreetLamp(f, V(108, 0, 1240), C(190, 235, 255), false)
	Kit.AddCircle(-104, 1245, 1.5)
	Kit.AddCircle(108, 1240, 1.5)
	bench(f, -88, 1232, 0, 1)
	bench(f, 100, 1228, 0, 1)
end

local function entrance(f: Instance)
	-- canopy over the front door
	Kit.Box(f, V(-16.5, 12, 1254), V(16.5, 13.2, 1268.9), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-16.7, 12.2, 1253.8), V(16.7, 13, 1254.1), WHITE)
	for _, s in { -1, 1 } do
		Kit.Cyl(f, 12, 1.4, CFrame.new(s * 14.5, 6, 1258), WHITE, SOLID)
	end
	local lamp = Kit.Box(f, V(-3, 11.6, 1258), V(3, 12, 1262), C(225, 255, 240), { Mat = NEON })
	Kit.Light(lamp, C(210, 255, 235), 24, 1.3)
	Kit.AddRect(-17, 1253, 17, 1269)
	-- facade block over the door (bottom Y 16) with the big sign and the cross emblem
	Kit.Box(f, V(-20, 16, 1266.5), V(20, 30, 1271.5), WHITE, SOLID)
	Kit.Box(f, V(-20.3, 16, 1266.2), V(20.3, 17, 1266.5), Kit.Vivid(LBLUE))
	Kit.Box(f, V(-20.5, 29.5, 1266), V(20.5, 31, 1272), Kit.Vivid(LBLUE))
	local sign = Kit.Part(f, V(30, 6.5, 0.4), CFrame.new(0, 23.4, 1266.2), C(60, 110, 170))
	Kit.Sign(sign, Enum.NormalId.Front, "HOSPITAL", WHITE, { Stroke = C(20, 40, 90) })
	Kit.CylFlat(f, 1, 13, V(0, 37.5, 1269.4), "Z", Kit.Vivid(LBLUE))
	Kit.CylFlat(f, 1, 11.4, V(0, 37.5, 1268.8), "Z", WHITE)
	Kit.Box(f, V(-1.3, 33.5, 1268), V(1.3, 41.5, 1268.4), REDX)
	Kit.Box(f, V(-4, 36.2, 1268), V(4, 38.8, 1268.4), REDX)
end

--==================================================================
-- BUILDING SHELL
--==================================================================
local function shell(f: Instance)
	Kit.Box(f, V(-113, -0.5, 1269), V(113, 0.1, 1535), C(215, 222, 230), { Solid = true, Name = "HospitalFloor" })
	-- room floors (flat paint, top Y 0.13)
	local function floor(x1: number, z1: number, x2: number, z2: number, color: Color3, mat: Enum.Material?)
		Kit.Box(f, V(x1, 0.1, z1), V(x2, FLOOR_Y, z2), color, { Mat = mat })
	end
	local tiles = { C(236, 241, 246), C(190, 222, 238) }
	for i = 0, 3 do
		for j = 0, 2 do
			local x0, z0 = -51 + i * 25, 1271 + j * (80 / 3)
			floor(x0, z0, x0 + 25, z0 + 80 / 3, tiles[((i + j) % 2) + 1])
		end
	end
	floor(-111, 1271, -53, 1397, C(205, 232, 214))
	floor(51, 1271, 111, 1351, C(228, 218, 242))
	floor(41, 1353, 111, 1443, C(205, 220, 242))
	floor(-51, 1353, 39, 1397, C(230, 236, 242))
	floor(-31, 1397, 39, 1443, C(230, 236, 242))
	floor(-111, 1399, -33, 1533, C(212, 236, 226))
	floor(-31, 1445, 31, 1533, C(185, 160, 215), FABRIC)
	floor(33, 1445, 111, 1533, C(242, 232, 214))
	-- light-blue runner along the main path + "follow the line" guides (flat)
	Kit.Box(f, V(-9, FLOOR_Y, 1271), V(9, 0.16, 1533), C(200, 228, 245), { Name = "Runner" })
	Kit.Box(f, V(-4.4, 0.16, 1271), V(-3.6, 0.19, 1533), Kit.Vivid(MGREEN))
	Kit.Box(f, V(3.6, 0.16, 1271), V(4.4, 0.19, 1533), Kit.Vivid(LBLUE))

	-- exterior walls (doors: front + back on the path, one side door each way)
	wallX(f, 1270, -113, 113, { { c = 0, w = 28 } })
	wallX(f, 1534, -113, 113, { { c = 0, w = 28 } })
	wallZ(f, -112, 1271, 1533, { { c = 1470, w = 16 } })
	wallZ(f, 112, 1271, 1533, { { c = 1460, w = 16 } })
	-- interior walls (all outside the ghost circles)
	wallZ(f, -52, 1271, 1398, { { c = 1310, w = 20 } }) -- lobby | ward
	wallZ(f, 50, 1271, 1351, { { c = 1315, w = 20 } }) -- lobby | patient rooms
	wallX(f, 1352, 39, 111, { { c = 80, w = 18 } }) -- patient rooms | x-ray
	wallX(f, 1352, -51, 39, { { c = -6, w = 60 } }) -- lobby | atrium (stubs)
	wallX(f, 1398, -111, -31, { { c = -80, w = 20 } }) -- ward | lab
	wallZ(f, 40, 1353, 1443, { { c = 1398, w = 24 } }) -- atrium | x-ray
	wallX(f, 1444, 31, 111, { { c = 75, w = 20 } }) -- x-ray | pharmacy
	wallZ(f, -32, 1399, 1533, { { c = 1422, w = 18 }, { c = 1505, w = 18 } }) -- lab | atrium, office
	wallZ(f, 32, 1445, 1533, { { c = 1490, w = 20 } }) -- office | pharmacy
	wallX(f, 1444, -31, 31, { { c = 0, w = 40 } }) -- atrium | office (stubs)

	-- parapet on the exterior walls (no roof over the rooms)
	local rim = Kit.Vivid(LBLUE)
	Kit.Box(f, V(-114, H, 1268), V(114, H + 1.6, 1272), rim, SOLID)
	Kit.Box(f, V(-114, H, 1532), V(114, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(-114, H, 1268), V(-110, H + 1.6, 1536), rim, SOLID)
	Kit.Box(f, V(110, H, 1268), V(114, H + 1.6, 1536), rim, SOLID)
	-- corner columns
	for _, x in { -113, 113 } do
		for _, z in { 1270, 1534 } do
			Kit.Cyl(f, 20, 6, CFrame.new(x, 10, z), WHITE, SOLID)
			Kit.Cyl(f, 1.4, 7, CFrame.new(x, 20.7, z), Kit.Vivid(MGREEN))
		end
	end

	-- windows: light-blue glass, a few ghostly ones glow
	local function window(lo: Vector3, hi: Vector3, glow: boolean)
		Kit.Box(f, lo, hi, if glow then SPECT else Kit.Vivid(C(175, 220, 245)), if glow then { Mat = NEON, Transp = 0.1 } else { Refl = 0.15 })
	end
	for _, x in { -100, -80, -55, -32, 32, 55, 80, 100 } do
		Kit.Box(f, V(x - 3.5, 5.5, 1268.7), V(x + 3.5, 12.5, 1268.95), WHITE)
		window(V(x - 2.8, 6, 1268.55), V(x + 2.8, 12, 1268.8), x == -55 or x == 80)
	end
	for _, s in { -1, 1 } do
		for _, z in { 1300, 1340, 1380, 1420, 1495 } do
			if not (s < 0 and z == 1495) then
				Kit.Box(f, V(s * 113, 5.5, z - 3.5), V(s * 113.25, 12.5, z + 3.5), WHITE)
				window(V(s * 113.15, 6, z - 2.8), V(s * 113.4, 12, z + 2.8), (s < 0 and z == 1340) or (s > 0 and z == 1420))
			end
		end
	end
	Kit.Box(f, V(-113.2, 14, 1268.7), V(113.2, 14.6, 1268.9), Kit.Vivid(MGREEN))
	Kit.AddRect(-116, 1266, 116, 1538)
end

--==================================================================
-- TOWER (landmark, back-west corner of the lab)
--==================================================================
local function tower(f: Instance)
	local m = Kit.Model(f, "HospitalTower")
	local x1, x2, z1, z2 = -111, -85, 1507, 1533
	Kit.Box(m, V(x1, 0, z1), V(x2, 64, z2), WHITE, { Solid = true, Shadow = true, Name = "Tower" })
	for _, y in { 16, 32, 48 } do
		Kit.Box(m, V(x1 - 0.3, y, z1 - 0.3), V(x2 + 0.3, y + 1, z2 + 0.3), Kit.Vivid(LBLUE))
	end
	Kit.Box(m, V(x1 - 0.5, 63.5, z1 - 0.5), V(x2 + 0.5, 65, z2 + 0.5), Kit.Vivid(PURPLE))
	Kit.Box(m, V(x1 + 3, 65, z1 + 3), V(x2 - 3, 72, z2 - 3), C(228, 236, 245), SOLID)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	Kit.Disc(m, cx, cz, 72.4, 16, 0.4, Kit.Vivid(MGREEN))
	local pad = Kit.Box(m, V(cx - 4, 72.4, cz - 4), V(cx + 4, 72.5, cz + 4), WHITE, { Transp = 1 })
	Kit.Sign(pad, Enum.NormalId.Top, "H", WHITE, { Stroke = C(60, 110, 170) })
	Kit.Cyl(m, 10, 0.6, CFrame.new(x2 - 5, 77, z2 - 5), GREY, { Mat = METAL })
	local beacon = Kit.Ball(m, 1.8, V(x2 - 5, 82.5, z2 - 5), C(255, 100, 120), { Mat = NEON })
	Kit.Light(beacon, C(255, 130, 140), 30, 1.2)
	-- windows on the -Z face (toward the Carnival) and the +X face (toward the lab)
	local glass = Kit.Vivid(C(175, 220, 245))
	for row = 0, 1 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local x = x1 + 5 + col * 8
			local glow = (row + col) % 3 == 1
			Kit.Box(m, V(x - 2.5, y - 3, z1 - 0.3), V(x + 2.5, y + 3, z1), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	for row = 0, 2 do
		local y = 24 + row * 16
		for col = 0, 2 do
			local z = z1 + 5 + col * 8
			local glow = (row + col) % 4 == 2
			Kit.Box(m, V(x2, y - 3, z - 2.5), V(x2 + 0.3, y + 3, z + 2.5), if glow then SPECT else glass, if glow then { Mat = NEON } else { Refl = 0.15 })
		end
	end
	-- red cross emblem near the top of the front face
	Kit.Box(m, V(-104, 51.5, z1 - 0.5), V(-92, 62.5, z1 - 0.1), Kit.Vivid(LBLUE))
	Kit.Box(m, V(-99.3, 53, z1 - 0.8), V(-96.7, 61, z1 - 0.4), REDX)
	Kit.Box(m, V(-102, 55.7, z1 - 0.8), V(-94, 58.3, z1 - 0.4), REDX)
	Kit.AddRect(x1 - 1, z1 - 1, x2 + 1, z2 + 1)
end

