			{ Vector3.new(-0.45, 0.95, 0.1), Vector3.new(0.5, 0.9, 0.3), Vector3.new(-1, 0.25, 0.4), Vector3.new(1, 0.2, 0.5), Vector3.new(0.25, -0.2, 1), Vector3.new(-0.2, -0.5, 0.95) },
