			local p = Vector3.new(math.cos(a) * 0.32, 0, math.sin(a) * 0.32)
			tpart(U.Block(Vector3.new(if i == 2 then 0.3 else 0.26, 0.24, 0.24), mc * CFrame.new(p) * CFrame.Angles(0, -a + math.pi / 2, 0), tc, model))
		end
		for _, s in { -1, 1 } do
