--==================================================================
-- CRATES (Weights don't need to sum to 100; odds are shown as %)
--==================================================================
export type CrateDef = {
	Id: string,
	Name: string,
	Zone: string,
	Price: number,
	Color: Color3,
	Trim: Color3,
	Pool: { { Hunter: string, Weight: number } },
}

Config.Crates = {
