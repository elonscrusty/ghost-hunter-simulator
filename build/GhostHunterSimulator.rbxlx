	-- top tier; fractional chances are exact in binary (multiples of 0.25) so the total is exactly 100
	CursedEgg = {
		Id = "CursedEgg", Name = "Cursed Egg", Price = 20000, Unlock = 50,
		Odds = {
			{ Pet = "GhostPhoenix", Chance = 35 }, { Pet = "CrystalSkull", Chance = 35 },
